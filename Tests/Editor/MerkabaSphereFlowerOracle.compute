#pragma kernel SphereFlowerOracle
#pragma kernel SphereFlowerSkinAddressOracle
#pragma target 5.0
#pragma use_dxc vulkan

#include "../../Runtime/Shaders/MerkabaFlowerGeometry.hlsl"

// The production classifier now publishes the q and aa enclosures its only
// caller needs, so these proofs keep asking the same question through one
// local forwarder rather than restating the extra outputs at five sites.
uint M8FlowerProbeClassifyRoot(M8FlowerInterval3 abc)
{
    M8FlowerInterval q, aa;
    return M8FlowerClassifyRoot(abc, q, aa);
}

struct SphereFlowerOracleCase
{
    int4 Control;
    float4 A;
    float4 B;
    float4 C;
};

StructuredBuffer<SphereFlowerOracleCase> _SphereFlowerOracleCases;
RWStructuredBuffer<SphereFlowerOracleCase> _SphereFlowerOracleResults;
uint _SphereFlowerOracleCaseCount;

[numthreads(64, 1, 1)]
void SphereFlowerOracle(uint3 dispatchId : SV_DispatchThreadID)
{
    uint id = dispatchId.x;
    if (id >= _SphereFlowerOracleCaseCount)
        return;

    SphereFlowerOracleCase input = _SphereFlowerOracleCases[id];
    SphereFlowerOracleCase result = (SphereFlowerOracleCase)0;
    int operation = input.Control.x;
    uint index = (uint)input.Control.y;

    if (operation == 0)
    {
        int3 d = M8FlowerLineDirectionAt(index);
        uint3 meta = M8FlowerLineMetaAt(index);
        result.Control = int4(d, (int)meta.x);
        result.A = float4(M8FlowerLineUnitAt(index), (float)meta.y);
        result.B = float4(M8FlowerLineE1At(index), (float)meta.z);
        result.C = float4(M8FlowerLineE2At(index), 0.0);
    }
    else if (operation == 1)
    {
        result.Control = M8FlowerDirectionAt(index);
        result.A.xy = (float2)M8FlowerDirectionMetaAt(index);
    }
    else if (operation == 2)
    {
        result.Control = M8FlowerNodeAt(index);
    }
    else if (operation == 3)
    {
        result.Control = (int4)M8FlowerStrandAt(index);
    }
    else if (operation == 4)
    {
        result.Control = (int4)M8FlowerPetalNodesAt(index);
        result.A.xyz = (float3)M8FlowerPetalStrandsAt(index);
        result.B.xyz = (float3)M8FlowerPetalStrandSignAt(index);
    }
    else if (operation == 5)
    {
        result.Control.xyz = (int3)M8FlowerChildPetalAt(index);
    }
    else if (operation == 6)
    {
        float4 bounds = M8FlowerSectorBoundsAt(index);
        result.A = float4(M8FlowerSectorUnitAt(index), bounds.xy);
        result.B.xy = bounds.zw;
    }
    else if (operation == 7)
    {
        result.Control = M8FlowerTetraLineAt(index);
        result.A = (float4)M8FlowerTetraEtaAt(index);
        result.B.x = (float)M8FlowerTetraChiralityAt(index);
    }
    else if (operation == 8)
    {
        int3 junction = M8FlowerJunction(input.Control.yzw,
            (int3)input.A.xyz);
        result.Control = int4(junction,
            (int)M8FlowerJunctionParity(junction));
        result.A.x = M8FlowerLevelStep((uint)input.B.x);
        int3 first;
        int3 second;
        bool pair = M8FlowerEndpointPair(junction, (uint)input.A.w,
            first, second);
        result.B = float4((float3)first, pair ? 1.0 : 0.0);
        result.C.xyz = (float3)second;
    }
    else if (operation == 9)
    {
        float2 root;
        bool valid = M8FlowerRoot(input.A.xyz, input.Control.y != 0, root);
        M8FlowerInterval3 abc;
        abc.x = M8FlowerI(input.A.x, input.A.x);
        abc.y = M8FlowerI(input.A.y, input.A.y);
        abc.z = M8FlowerI(input.A.z, input.A.z);
        result.Control.x = valid ? 1 : 0;
        result.Control.y = (int)M8FlowerProbeClassifyRoot(abc);
        result.A.xy = root;
    }
    else if (operation == 10)
    {
        float turn;
        bool valid = M8FlowerTau(input.A.xy, input.A.zw, turn);
        result.Control.x = valid ? 1 : 0;
        result.A.x = turn;
        result.B.xy = valid ? M8FlowerRotate(input.A.xy, turn) : 0.0.xx;
    }
    else if (operation == 11)
    {
        result.A = M8FlowerTetraForward(input.A);
        result.B = M8FlowerTetraInverse(result.A.x, result.A.yzw);
    }
    else if (operation == 12)
    {
        int4 rule = M8FlowerSkinChamberAt(index);
        uint packed = asuint(rule.w);
        result.Control = int4(rule.xyz, (int)(packed & 0xffu));
        result.A.xyz = float3((packed >> 8) & 0xffu,
            (packed >> 16) & 0xffu,
            ((packed >> 24) & 1u) != 0u ? 1.0 : -1.0);
    }
    else if (operation == 13)
    {
        result.Control.xy = int2(M8FlowerSkinCanonicalToThreadAt(index),
            M8FlowerSkinThreadToCanonicalAt(index));
    }
    else if (operation == 14)
    {
        M8FlowerInterval3 abc;
        abc.x = M8FlowerI(input.A.x, input.A.y);
        abc.y = M8FlowerI(input.A.z, input.A.w);
        abc.z = M8FlowerI(input.B.x, input.B.y);
        result.Control.x = (int)M8FlowerProbeClassifyRoot(abc);
    }
    else if (operation == 15)
    {
        result.Control.x = (int)M8_FLOWER_TABLE_HASH;
    }
    else if (operation == 16)
    {
        result.Control.xy = int2(M8FlowerSkinCanonicalL5ToThreadAt(index),
            M8FlowerSkinL5ChildRankAt(index));
    }
    else if (operation == 17)
    {
        result.Control.xy = int2(M8FlowerSkinL3ChildRankAt(index),
            M8FlowerSkinL3StateAt(index));
    }
    else if (operation == 18)
    {
        result.Control.xyz = int3(M8FlowerSkinL4ParentThreadAt(index),
            M8FlowerSkinL4ChildRankAt(index), M8FlowerSkinL4StateAt(index));
    }
    else if (operation == 19)
    {
        float3 child;
        uint4 meta = M8FlowerSkinDescend(input.A.xyz, index, child);
        result.Control = (int4)meta;
        result.B.xyz = child;
    }
    else if (operation == 20)
    {
        result.A.x = (float)M8FlowerRank7(asuint(input.A.x),
            (uint)input.Control.z);
        result.A.y = (float)M8FlowerRank49(
            uint2(asuint(input.A.y), asuint(input.A.z)), index);
    }
    else if (operation == 21)
    {
        float3 amplitude = asfloat(input.Control.yzw);
        result.A = float4(M8FlowerSkinBubble(input.A.xyz),
            M8FlowerSkinBubble(input.B.xyz),
            M8FlowerSkinBubble(input.C.xyz),
            M8FlowerNestedV(input.A.xyz, input.B.xyz, input.C.xyz,
                amplitude));
    }
    else if (operation == 22)
    {
        uint splitL2 = (uint)input.Control.y;
        uint splitL3 = (uint)input.Control.z;
        uint2 splitL4 = uint2(asuint(input.A.x), asuint(input.A.y));
        bool valid = M8FlowerSkinSplitClosure(splitL2, splitL3, splitL4);
        result.Control.x = valid ? 1 : 0;
        result.A.x = (float)M8FlowerCompactSkinValueCount(
            splitL2, splitL3, splitL4);
    }
    else if (operation == 23)
    {
        float2 scalar[7];
        float2 rgb[21];
        [unroll]
        for (uint i = 0u; i < 7u; i++) scalar[i] = float2(0.0, 1.0);
        [unroll]
        for (uint i = 0u; i < 21u; i++) rgb[i] = float2(0.0, 1.0);
        uint certainMask = index == 2u ? 0x3fu : 0x7fu;
        if (index == 1u)
        {
            scalar[6] = float2(2.0, 3.0);
            rgb[18] = scalar[6];
        }
        else if (index == 3u)
        {
            rgb[19] = float2(2.0, 3.0);
        }
        result.Control.x = (int)M8FlowerClassifyScalarSkinSplit(
            scalar, certainMask);
        result.Control.y = (int)M8FlowerClassifyRgbSkinSplit(rgb, certainMask);
    }
    else if (operation == 25)
    {
        float2 scalar[7];
        float2 rgb[21];
        [unroll]
        for (uint i = 0u; i < 7u; i++)
        {
            float lower = index == 0u ? (i == 6u ? 2.0 : 0.0) : 2.0 * i;
            scalar[i] = float2(lower, lower + 1.0);
            [unroll]
            for (uint channel = 0u; channel < 3u; channel++)
                rgb[3u * i + channel] = scalar[i];
        }
        uint certainMask = (uint)input.Control.z;
        uint supportMask = (uint)input.Control.w;
        result.Control.x = (int)M8FlowerClassifyScalarSkinSplit(
            scalar, certainMask, supportMask);
        result.Control.y = (int)M8FlowerClassifyRgbSkinSplit(
            rgb, certainMask, supportMask);
    }
    else if (operation == 26)
    {
        uint tablePetal=0xffffffffu,sector=0xffffffffu,rootPetal=0xffffffffu;
        bool tableValid=M8FlowerR1SectorFlag(index,(uint)input.Control.z,tablePetal);
        M8FlowerInterval2 root;
        root.x=M8FlowerI(input.A.x,input.A.y);
        root.y=M8FlowerI(input.A.z,input.A.w);
        bool certain=false;
        if(index<6u)
            certain=M8FlowerRootSector((uint)M8FlowerNodeAt(index).w,root,sector);
        bool admitted=false;
        if(certain)admitted=M8FlowerR1SectorFlag(index,sector,rootPetal);
        result.Control=int4(tableValid?(int)tablePetal:-1,certain?(int)sector:-1,
            admitted?(int)rootPetal:-1,admitted?1:0);
    }
    else if(operation==27)
    {
        M8FlowerR1FlagRoots candidates;
        M8FlowerPhaseRootEvidence uniqueRoot;
        uint status;
        if(index==0u)
            status=M8FlowerSelectR1FlagRoots(asint(input.A.xyz),(uint)input.Control.w,
                (uint)input.Control.z,input.B.x,input.B.y,candidates,uniqueRoot);
        else
            status=M8FlowerSelectR1FlagRelation(asint(input.A.xyz),(uint)input.Control.w,
                asuint(input.A.w),(uint)input.Control.z,input.B.x,input.B.y,candidates,uniqueRoot);
        result.Control=int4((int)candidates.CandidateMask,(int)candidates.UnresolvedMask,
            (int)status,asint(candidates.Minus.Tag|(candidates.Plus.Tag<<16u)));
        result.A=float4(candidates.Minus.Root.x.lo,candidates.Minus.Root.x.hi,
            candidates.Minus.Root.y.lo,candidates.Minus.Root.y.hi);
        result.B=float4(candidates.Plus.Root.x.lo,candidates.Plus.Root.x.hi,
            candidates.Plus.Root.y.lo,candidates.Plus.Root.y.hi);
        result.C=asfloat(uint4(asuint(uniqueRoot.Junction),uniqueRoot.Tag));
    }
    else if(operation==28)
    {
        // Diagnostic of the production helpers, not another root solver.
        // Stage 2 injects the CPU-decoded plane solely to distinguish plane
        // decoding from downstream interval arithmetic in a failed parity case.
        uint lineClass=(uint)input.Control.z;
        float3 normal;float offset;
        M8FlowerUnpackPlane((uint)input.Control.w,normal,offset);
        precise float3 relative=(0.5*M8FlowerLevelStep(0u))*float3(asint(input.A.xyz));
        float radius=M8FlowerGeometryLoopRadiusAt(lineClass);
        if(index==0u)
        {
            result.Control=asint(float4(M8FlowerLineE2At(lineClass),0.0));
            result.A=float4(normal,offset);
            result.B=float4(relative,radius);
            result.C=float4(M8FlowerLineE1At(lineClass),0.0);
        }
        else
        {
            if(index==2u){normal=input.B.xyz;offset=input.B.w;}
            M8FlowerInterval3 abc;
            bool valid=M8FlowerPlaneIntervals(normal,offset,relative,radius,lineClass,
                input.A.w,input.C.x,abc);
            M8FlowerInterval q=M8FlowerIAdd(M8FlowerISquare(abc.y),M8FlowerISquare(abc.z));
            M8FlowerInterval delta=M8FlowerISub(q,M8FlowerISquare(abc.x));
            M8FlowerInterval turn;
            bool sqrtValid=M8FlowerISqrt(delta,turn);
            result.Control=int4(valid?1:0,sqrtValid?1:0,(int)M8FlowerProbeClassifyRoot(abc),0);
            result.A=float4(abc.x.lo,abc.x.hi,abc.y.lo,abc.y.hi);
            result.B=float4(abc.z.lo,abc.z.hi,q.lo,q.hi);
            result.C=float4(delta.lo,delta.hi,turn.lo,turn.hi);
        }
    }
    else if(operation==29)
    {
        uint tag=(uint)input.Control.z;
        uint2 owner=uint2(0u,0u),references=uint2(0u,0u);
        bool ownerValid=M8FlowerAnchorRootFlags(index,tag,owner);
        bool referenceValid=M8FlowerAnchorRootReferences(index,tag,references);
        M8FlowerPhaseRootEvidence root=(M8FlowerPhaseRootEvidence)0;
        root.Classification=1u;root.Tag=tag;
        root.Junction=int3(-514,-66,-18)+M8FlowerNodeAt(index).xyz;
        root.Root.x=M8FlowerI(input.A.x,input.A.y);
        root.Root.y=M8FlowerI(input.A.z,input.A.w);
        uint sector;
        bool sectorValid=M8FlowerPhaseRootSector(root,sector);
        result.Control=int4(ownerValid?1:0,referenceValid?1:0,sectorValid?1:0,sectorValid?(int)sector:-1);
        result.A=asfloat(uint4(owner,references));
        result.B=float4(root.Root.x.lo,root.Root.x.hi,root.Root.y.lo,root.Root.y.hi);
        result.C=asfloat(uint4(asuint(root.Junction),root.Tag));
    }
    else if(operation==30)
    {
        uint4 ancestry=M8FlowerL2CarrierBranchMasksAt(index);
        uint pattern=(uint)input.Control.z;
        uint eligible=(ancestry[pattern>>5u]>>(pattern&31u))&1u;
        result.Control=int4((int)index,(int)pattern,(int)eligible,0);
        result.A=asfloat(ancestry);
    }
    else if(operation==31)
    {
        uint certain[6],uncertain[6];
        uint4 a=asuint(input.A),b=asuint(input.B),c=asuint(input.C);
        certain[0]=a.x;certain[1]=a.y;certain[2]=a.z;certain[3]=a.w;
        certain[4]=b.x;certain[5]=b.y;
        uncertain[0]=b.z;uncertain[1]=b.w;uncertain[2]=c.x;
        uncertain[3]=c.y;uncertain[4]=c.z;uncertain[5]=c.w;
        uint signs,active,unresolved;
        uint4 ancestry=M8FlowerL2CarrierBranchMasksAt(index);
        uint status=M8FlowerCombineCarrierCandidates(certain,uncertain,ancestry,signs,active,unresolved);
        result.Control=int4((int)status,(int)signs,(int)active,(int)unresolved);
        result.A=asfloat(ancestry);
    }
    _SphereFlowerOracleResults[id] = result;
}

[numthreads(64, 1, 1)]
void SphereFlowerSkinAddressOracle(uint3 dispatchId : SV_DispatchThreadID)
{
    uint id = dispatchId.x;
    if (id >= _SphereFlowerOracleCaseCount)
        return;

    SphereFlowerOracleCase input = _SphereFlowerOracleCases[id];
    SphereFlowerOracleCase result = (SphereFlowerOracleCase)0;
    uint groupIndex;
    uint childStitchRank;
    bool valid = M8FlowerSkinCompactChildAddress(
        asuint(input.A.y), asuint(input.A.z), asuint(input.A.w),
        (uint)input.Control.y, (uint)input.Control.z,
        (uint)input.Control.w, asuint(input.A.x), groupIndex,
        childStitchRank);
    result.Control = int4(valid ? 1 : 0, (int)groupIndex,
        (int)childStitchRank, 0);
    _SphereFlowerOracleResults[id] = result;
}
