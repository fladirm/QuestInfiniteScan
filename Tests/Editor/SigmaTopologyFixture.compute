#pragma kernel BuildFixtureTransition
#pragma kernel ScanFixtureCatalog
#pragma kernel FinalizeFixture
#pragma target 5.0

#include "../../Runtime/Resources/SigmaPrism/SigmaTopologyMath.hlsl"

StructuredBuffer<uint2> _FixtureStates;
RWStructuredBuffer<uint2> _FixtureTau;
RWStructuredBuffer<uint4> _FixtureResult;

uint _SingularShift;
uint _AssociatorShift;
uint _FixtureDiscontinuity;
uint _FixtureLeftKey;
uint _FixtureRightKey;

groupshared uint2 FixtureSharedTau[16];
groupshared uint4 FixtureSharedError[256];
groupshared uint FixtureSharedId[256];

[numthreads(1, 1, 1)]
void BuildFixtureTransition(uint3 id : SV_DispatchThreadID)
{
    uint2 left[16];
    uint2 right[16];
    uint valid = 1u;
    [unroll]
    for (uint fixtureBuildIndex = 0u; fixtureBuildIndex < 16u;
        ++fixtureBuildIndex)
    {
        left[fixtureBuildIndex] = _FixtureStates[fixtureBuildIndex];
        right[fixtureBuildIndex] = _FixtureStates[16u + fixtureBuildIndex];
    }
    uint2 transition[16];
    SigmaTransitionPlan(left, right, transition, valid);
    [unroll]
    for (uint fixtureStoreIndex = 0u; fixtureStoreIndex < 16u;
        ++fixtureStoreIndex)
        _FixtureTau[fixtureStoreIndex] = transition[fixtureStoreIndex];
    _FixtureResult[1] = valid != 0u
        ? SigmaS16L1(transition, valid) : SIGMA_U128_MAX;
}

[numthreads(256, 1, 1)]
void ScanFixtureCatalog(uint3 groupThreadId : SV_GroupThreadID)
{
    uint lane = groupThreadId.x;
    if (lane < 16u)
        FixtureSharedTau[lane] = _FixtureTau[lane];
    GroupMemoryBarrierWithGroupSync();

    uint valid = 1u;
    uint4 error = SIGMA_U128_MAX;
    if (lane < SIGMA_ANNIHILATOR_ACTION_COUNT)
        error = SigmaRightDyadL1(FixtureSharedTau,
            SIGMA_ANNIHILATOR_ACTIONS[lane], valid);
    FixtureSharedError[lane] = valid != 0u ? error : SIGMA_U128_MAX;
    FixtureSharedId[lane] = lane;
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint offset = 128u; offset > 0u; offset >>= 1u)
    {
        if (lane < offset)
        {
            uint otherId = FixtureSharedId[lane + offset];
            uint4 otherError = FixtureSharedError[lane + offset];
            uint ownId = FixtureSharedId[lane];
            uint4 ownError = FixtureSharedError[lane];
            bool takeOther = SigmaU128Less(otherError, ownError) ||
                (SigmaU128Equal(otherError, ownError) && otherId < ownId);
            if (takeOther)
            {
                FixtureSharedError[lane] = otherError;
                FixtureSharedId[lane] = otherId;
            }
        }
        GroupMemoryBarrierWithGroupSync();
    }
    if (lane == 0u)
    {
        _FixtureResult[0] = uint4(0u, FixtureSharedId[0], 0u, 0u);
        _FixtureResult[2] = FixtureSharedError[0];
    }
}

[numthreads(1, 1, 1)]
void FinalizeFixture(uint3 id : SV_DispatchThreadID)
{
    uint2 center[16];
    uint2 right[16];
    uint2 down[16];
    uint valid = 1u;
    [unroll]
    for (uint fixtureLoadIndex = 0u; fixtureLoadIndex < 16u;
        ++fixtureLoadIndex)
    {
        center[fixtureLoadIndex] = _FixtureStates[fixtureLoadIndex];
        right[fixtureLoadIndex] = _FixtureStates[16u + fixtureLoadIndex];
        down[fixtureLoadIndex] = _FixtureStates[32u + fixtureLoadIndex];
    }
    uint2 deltaU[16];
    uint2 deltaV[16];
    [unroll]
    for (uint fixtureDeltaIndex = 0u; fixtureDeltaIndex < 16u;
        ++fixtureDeltaIndex)
    {
        deltaU[fixtureDeltaIndex] = SigmaQ48SubChecked(
            right[fixtureDeltaIndex], center[fixtureDeltaIndex], valid);
        deltaV[fixtureDeltaIndex] = SigmaQ48SubChecked(
            down[fixtureDeltaIndex], center[fixtureDeltaIndex], valid);
    }
    uint2 associator[16];
    SigmaAssociatorPlan(center, deltaU, deltaV, associator, valid);
    uint4 assocError = SigmaS16L1(associator, valid);
    uint4 assocScale = SigmaS16L1(center, valid);
    assocScale = SigmaU128Add(assocScale, SigmaS16L1(deltaU, valid), valid);
    assocScale = SigmaU128Add(assocScale, SigmaS16L1(deltaV, valid), valid);
    if (SigmaU128Equal(assocScale, SIGMA_U128_ZERO))
        assocScale = SIGMA_U128_ONE;

    uint4 priorResult = _FixtureResult[0];
    uint bestId = priorResult.y;
    uint4 bestError = _FixtureResult[2];
    uint4 transitionScale = _FixtureResult[1];
    bool near = SigmaRelativeNearGate(bestError, transitionScale,
        _SingularShift);
    bool exact = SigmaU128Equal(bestError, SIGMA_U128_ZERO);
    bool assocStrong = valid != 0u && SigmaRelativeAssociatorGate(assocError,
        assocScale, _AssociatorShift);
    uint centerReadoutValid;
    uint rightReadoutValid;
    bool centerContact = SigmaStateHasContact(center, centerReadoutValid);
    bool rightContact = SigmaStateHasContact(right, rightReadoutValid);
    bool contactNull = centerReadoutValid != 0u && rightReadoutValid != 0u &&
        centerContact != rightContact;
    bool independent = _FixtureLeftKey != 0u && _FixtureRightKey != 0u &&
        _FixtureLeftKey != _FixtureRightKey;
    uint classification = near && independent &&
        (contactNull || assocStrong || _FixtureDiscontinuity != 0u)
        ? SIGMA_TOPOLOGY_SINGULAR
        : (near || contactNull || assocStrong || _FixtureDiscontinuity != 0u)
            ? SIGMA_TOPOLOGY_UNRESOLVED
            : SIGMA_TOPOLOGY_REGULAR;
    uint flags = near ? SIGMA_TOPOLOGY_NEAR_ANNIHILATOR : 0u;
    flags |= exact ? SIGMA_TOPOLOGY_EXACT_ANNIHILATOR : 0u;
    flags |= contactNull ? SIGMA_TOPOLOGY_CONTACT_NULL : 0u;
    flags |= assocStrong ? SIGMA_TOPOLOGY_ASSOCIATOR : 0u;
    flags |= _FixtureDiscontinuity != 0u
        ? SIGMA_TOPOLOGY_DISCONTINUITY_EVIDENCE : 0u;
    _FixtureResult[0] = uint4(SigmaTopologyPack(classification, bestId,
        flags), _FixtureLeftKey, _FixtureRightKey, valid);
    _FixtureResult[3] = transitionScale;
    _FixtureResult[4] = assocError;
    _FixtureResult[5] = assocScale;
}
