#pragma kernel CountBinsProbe
#pragma kernel EmitBinsProbe
#pragma kernel ReduceBinsProbe
#pragma kernel CountOwnersProbe
#pragma kernel EmitOwnersProbe
#pragma kernel RootIntervalsProbe
#pragma kernel RootIntervalStagesProbe
#pragma kernel PlaneIntervalsProbe
#pragma kernel DivisionBoundsProbe
#pragma kernel CanonicalSqrtProbe
#pragma use_dxc vulkan

#include "../../Runtime/Shaders/MerkabaObservationBins.hlsl"
#include "../../Runtime/Shaders/MerkabaObservationReduction.hlsl"
#include "../../Runtime/Shaders/MerkabaObservationOwners.hlsl"

// The production classifier now publishes the q and aa enclosures its only
// caller needs, so these proofs keep asking the same question through one
// local forwarder rather than restating the extra outputs at five sites.
uint M8FlowerProbeClassifyRoot(M8FlowerInterval3 abc)
{
    M8FlowerInterval q, aa;
    return M8FlowerClassifyRoot(abc, q, aa);
}

StructuredBuffer<uint4> _ProbeRecords;
StructuredBuffer<int2> _ProbeIntervals;
RWStructuredBuffer<uint4> _ProbeReduced;
uint _ProbeRecordCount;
StructuredBuffer<float4> _ProbeCoefficients;
RWStructuredBuffer<float4> _ProbeRootIntervals;

[numthreads(64, 1, 1)]
void CanonicalSqrtProbe(uint id : SV_DispatchThreadID)
{
    if (id < _ProbeRecordCount)
        _ProbeReduced[id] = uint4(asuint(M8FlowerRoundSqrt(asfloat(_ProbeRecords[id].x))),0u,0u,0u);
}

[numthreads(64, 1, 1)]
void DivisionBoundsProbe(uint id : SV_DispatchThreadID)
{
    if (id >= _ProbeRecordCount) return;
    float4 values = asfloat(_ProbeRecords[id]);
    M8FlowerInterval scalar, interval;
    bool scalarValid = M8FlowerDivideEnclosed(values.x, values.z, scalar);
    bool intervalValid = M8FlowerIDivPositive(M8FlowerI(values.x, values.y),
        M8FlowerI(values.z, values.w), interval);
    _ProbeReduced[2u * id] = uint4(scalarValid ? 1u : 0u,
        intervalValid ? 1u : 0u, 0u, 0u);
    _ProbeReduced[2u * id + 1u] = asuint(float4(scalar.lo, scalar.hi,
        interval.lo, interval.hi));
}

[numthreads(64, 1, 1)]
void PlaneIntervalsProbe(uint id : SV_DispatchThreadID)
{
    if (id >= _ProbeRecordCount) return;
    float4 plane = _ProbeCoefficients[3u * id];
    float4 loop = _ProbeCoefficients[3u * id + 1u];
    float4 bounds = _ProbeCoefficients[3u * id + 2u];
    M8FlowerInterval3 abc;
    bool certain = M8FlowerPlaneIntervals(plane.xyz, plane.w, loop.xyz, loop.w,
        (uint)bounds.z, bounds.x, bounds.y, abc);
    _ProbeReduced[id] = uint4(certain ? 1u : 0u, 0u, 0u, 0u);
    _ProbeRootIntervals[2u * id] = float4(abc.x.lo, abc.x.hi, abc.y.lo, abc.y.hi);
    _ProbeRootIntervals[2u * id + 1u] = float4(abc.z.lo, abc.z.hi, 0.0, 0.0);
}

[numthreads(64, 1, 1)]
void RootIntervalsProbe(uint id : SV_DispatchThreadID)
{
    if (id >= _ProbeRecordCount) return;
    float4 a = _ProbeCoefficients[2u * id];
    float4 b = _ProbeCoefficients[2u * id + 1u];
    M8FlowerInterval3 abc;
    abc.x = M8FlowerI(a.x, a.y);
    abc.y = M8FlowerI(a.z, a.w);
    abc.z = M8FlowerI(b.x, b.y);
    M8FlowerInterval2 root;
    uint classification = M8FlowerRootInterval(abc, b.z != 0.0, root);
    uint sector = 0xffffffffu;
    bool certain = false;
    if (classification == M8_FLOWER_ROOT_CERTAIN_SECANT ||
        classification == M8_FLOWER_ROOT_CERTAIN_TANGENT)
        certain = M8FlowerRootSector((uint)b.w, root, sector);
    _ProbeReduced[id] = uint4(classification, sector, certain ? 1u : 0u,
        M8FlowerProbeClassifyRoot(abc));
    _ProbeRootIntervals[id] = float4(root.x.lo, root.x.hi, root.y.lo, root.y.hi);
}

// Failure diagnostics for the exact production interval operators. This
// never admits a root: tests still require the real RootInterval result.
[numthreads(1, 1, 1)]
void RootIntervalStagesProbe(uint id : SV_DispatchThreadID)
{
    float4 a = _ProbeCoefficients[0], b = _ProbeCoefficients[1];
    M8FlowerInterval3 abc;
    abc.x = M8FlowerI(a.x, a.y);
    abc.y = M8FlowerI(a.z, a.w);
    abc.z = M8FlowerI(b.x, b.y);
    M8FlowerInterval q = M8FlowerIAdd(M8FlowerISquare(abc.y), M8FlowerISquare(abc.z));
    M8FlowerInterval delta = M8FlowerISub(q, M8FlowerISquare(abc.x));
    M8FlowerInterval turn;
    bool sqrtValid = M8FlowerISqrt(delta, turn);
    if (b.z == 0.0) turn = M8FlowerI(-turn.hi, -turn.lo);
    M8FlowerInterval minusA = M8FlowerI(-abc.x.hi, -abc.x.lo);
    M8FlowerInterval x = M8FlowerIAdd(M8FlowerIMul(minusA, abc.y),
        M8FlowerIMul(turn, M8FlowerI(-abc.z.hi, -abc.z.lo)));
    M8FlowerInterval y = M8FlowerIAdd(M8FlowerIMul(minusA, abc.z),
        M8FlowerIMul(turn, abc.y));
    M8FlowerInterval rootX, rootY;
    bool xValid = M8FlowerIDivPositive(x, q, rootX);
    bool yValid = M8FlowerIDivPositive(y, q, rootY);
    _ProbeReduced[0] = uint4(M8FlowerProbeClassifyRoot(abc),
        sqrtValid ? 1u : 0u, xValid ? 1u : 0u, yValid ? 1u : 0u);
    _ProbeRootIntervals[0] = float4(q.lo, q.hi, delta.lo, delta.hi);
    _ProbeRootIntervals[1] = float4(turn.lo, turn.hi, x.lo, x.hi);
    _ProbeRootIntervals[2] = float4(y.lo, y.hi, rootX.lo, rootX.hi);
    _ProbeRootIntervals[3] = float4(rootY.lo, rootY.hi, 0.0, 0.0);
}

[numthreads(64, 1, 1)]
void CountOwnersProbe(uint id : SV_DispatchThreadID)
{
    if (id < _ProbeRecordCount)
        M8FlowerCountObservationOwners(asint(_ProbeRecords[id].xyz));
}

[numthreads(64, 1, 1)]
void EmitOwnersProbe(uint id : SV_DispatchThreadID)
{
    if (id < _ProbeRecordCount)
        M8FlowerEmitObservationOwners(asint(_ProbeRecords[id].xyz),
            _ProbeRecords[id].w, 0x150u, 0x80000000u | _ProbeRecords[id].w);
}

[numthreads(64, 1, 1)]
void CountBinsProbe(uint id : SV_DispatchThreadID)
{
    if (id < _ProbeRecordCount)
        M8FlowerCountObservationOwner(_ProbeRecords[id].x >> 9u);
}

[numthreads(64, 1, 1)]
void EmitBinsProbe(uint id : SV_DispatchThreadID)
{
    if (id >= _ProbeRecordCount) return;
    uint4 item = _ProbeRecords[id];
    M8FlowerEmitObservationOwner(item.x >> 9u, item.x & 511u,
        item.y, item.z, item.w);
}

[numthreads(128, 1, 1)]
void ReduceBinsProbe(uint lane : SV_GroupIndex)
{
    for (uint initOwner = lane; initOwner < 512u; initOwner += 128u)
        M8FlowerResetObservationBucket(initOwner);
    GroupMemoryBarrierWithGroupSync();
    for (uint intersectId = lane; intersectId < _ProbeRecordCount; intersectId += 128u)
    {
        uint4 item = _ProbeRecords[intersectId];
        int2 interval = _ProbeIntervals[intersectId];
        M8FlowerIntersectObservation(item.x & 511u, item.z,
            interval.x, interval.y);
    }
    GroupMemoryBarrierWithGroupSync();
    for (uint selectId = lane; selectId < _ProbeRecordCount; selectId += 128u)
    {
        uint4 item = _ProbeRecords[selectId];
        M8FlowerSelectObservationRepresentative(item.x & 511u, item.w);
    }
    GroupMemoryBarrierWithGroupSync();
    for (uint owner = lane; owner < 512u; owner += 128u)
    {
        uint identity, pixel;
        int lower, upper;
        bool certain = M8FlowerReadObservationBucket(owner, identity,
            lower, upper, pixel);
        _ProbeReduced[owner] = certain ?
            uint4(identity, asuint(lower), asuint(upper), pixel) :
            0xffffffffu.xxxx;
    }
}
