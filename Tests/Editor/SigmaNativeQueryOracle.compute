bool SigmaNativeKeyLess(uint2 left, uint2 right)
{
    return left.y != right.y ? left.y < right.y : left.x < right.x;
}

bool SigmaNativeKeyEqual(uint2 left, uint2 right)
{
    return all(left == right);
}

#if defined(SIGMA_NATIVE_ORACLE_REDUCE_ONLY)
#define SIGMA_NATIVE_REDUCE_WIDTH 128u
#define SIGMA_NATIVE_REDUCED_RECORD_STRIDE 6u
#define SIGMA_NATIVE_REDUCE_COLD_CONTINUATION_REQUIRED 1u

groupshared uint4 SigmaNativeReduceHeaders[SIGMA_NATIVE_REDUCE_WIDTH];
groupshared uint4 SigmaNativeReduceOrderMeasures[SIGMA_NATIVE_REDUCE_WIDTH];
groupshared uint2 SigmaNativeReduceOptical[
    SIGMA_NATIVE_REDUCE_WIDTH * SIGMA_NATIVE_OPTICAL_CHANNELS];
groupshared uint SigmaNativeReduceSources[SIGMA_NATIVE_REDUCE_WIDTH];
groupshared uint SigmaNativeReducePrefix[SIGMA_NATIVE_REDUCE_WIDTH];
groupshared uint SigmaNativeReduceFirst[SIGMA_NATIVE_REDUCE_WIDTH];
groupshared uint SigmaNativeReduceValid[SIGMA_NATIVE_REDUCE_WIDTH];
groupshared uint SigmaNativeReduceRelations[SIGMA_NATIVE_REDUCE_WIDTH];
groupshared uint2 SigmaNativeReduceGroupKeys[SIGMA_NATIVE_REDUCE_WIDTH];
groupshared uint4 SigmaNativeReduceGroupOrders[SIGMA_NATIVE_REDUCE_WIDTH];
groupshared uint SigmaNativeReduceRelationCount;
groupshared uint2 SigmaNativeReduceGroupOptical[
    SIGMA_NATIVE_REDUCE_WIDTH * SIGMA_NATIVE_OPTICAL_CHANNELS * 2u];

bool SigmaNativeReduceItemLess(uint4 leftHeader, uint leftSource,
    uint4 rightHeader, uint rightSource)
{
    bool leftActive = leftHeader.w != 0u;
    bool rightActive = rightHeader.w != 0u;
    bool less = false;
    if (leftActive != rightActive)
        less = leftActive;
    else if (!leftActive)
        less = leftSource < rightSource;
    else if (!SigmaNativeKeyEqual(leftHeader.xy, rightHeader.xy))
        less = SigmaNativeKeyLess(leftHeader.xy, rightHeader.xy);
    else
        less = leftSource < rightSource;
    return less;
}

uint2 SigmaNativeShiftRightInitialized(uint2 value, uint count)
{
    uint2 result = uint2(0u, 0u);
    if (count == 0u)
        result = value;
    else if (count < 32u)
        result = uint2((value.x >> count) | (value.y << (32u - count)),
            value.y >> count);
    else if (count < 64u)
        result = uint2(value.y >> (count - 32u), 0u);
    return result;
}

uint2 SigmaNativeShiftLeftInitialized(uint2 value, uint count)
{
    uint2 result = uint2(0u, 0u);
    if (count == 0u)
        result = value;
    else if (count < 32u)
        result = uint2(value.x << count,
            (value.y << count) | (value.x >> (32u - count)));
    else if (count < 64u)
        result = uint2(0u, value.x << (count - 32u));
    return result;
}
#endif

#if defined(SIGMA_NATIVE_STITCH_PAIR)
#define SIGMA_NATIVE_STITCH_PAIR_STRIDE 3u
#define SIGMA_NATIVE_STITCH_CONTACT_OFFSET_MASK 0x000fffffu

groupshared uint SigmaNativeStitchContact;
groupshared uint SigmaNativeStitchFactorClass[4];
groupshared uint SigmaNativeStitchFactorKernel[4];
groupshared uint SigmaNativeStitchFactorHash[4];

void SigmaNativeStitchLoadEndpointAssociator(uint stateOffset,
    uint sectorAddress, uint contextOffset, uint threadIndex,
    bool retainAsLeft)
{
    if (threadIndex < 16u)
    {
        SigmaNativeGroupLeft[threadIndex] =
            _NativeStates[stateOffset + threadIndex];
        SigmaNativeGroupRight[threadIndex] = threadIndex == sectorAddress
            ? uint2(0u, 0x00010000u) : uint2(0u, 0u);
        SigmaNativeGroupContext[threadIndex] =
            _NativeStates[contextOffset + threadIndex];
    }
    GroupMemoryBarrierWithGroupSync();
    SigmaNativeGroupProduct(SIGMA_NATIVE_PRODUCT_LEFT_RIGHT, threadIndex);
    SigmaNativeGroupProduct(SIGMA_NATIVE_PRODUCT_RIGHT_CONTEXT, threadIndex);
    SigmaNativeGroupProduct(SIGMA_NATIVE_PRODUCT_AB_CONTEXT, threadIndex);
    SigmaNativeGroupProduct(SIGMA_NATIVE_PRODUCT_LEFT_BC, threadIndex);
    if (threadIndex < 16u)
    {
        uint laneValid = 1u;
        uint2 endpointAssociator = SigmaQ48SubChecked(
            SigmaNativeGroupLeftBracket[threadIndex],
            SigmaNativeGroupRightBracket[threadIndex], laneValid);
        if (retainAsLeft)
            SigmaNativeGroupTransition[threadIndex] = endpointAssociator;
        else
            SigmaNativeGroupAssociator[threadIndex] = SigmaQ48SubChecked(
                endpointAssociator,
                SigmaNativeGroupTransition[threadIndex], laneValid);
        SigmaNativeGroupLaneValid[threadIndex] = laneValid;
    }
    GroupMemoryBarrierWithGroupSync();
    if (threadIndex == 0u)
    {
        [unroll]
        for (uint lane = 0u; lane < 16u; ++lane)
            SigmaNativeGroupAllValid &= SigmaNativeGroupLaneValid[lane];
    }
    GroupMemoryBarrierWithGroupSync();
}

void SigmaNativeStitchClassifyCurrentFactor(uint factorIndex,
    uint receiptIndex, uint threadIndex)
{
    SigmaNativeGroupClassifyFactor(factorIndex, threadIndex);
    if (threadIndex == 0u)
    {
        SigmaNativeStitchFactorClass[receiptIndex] =
            SigmaNativeGroupFactorClass[factorIndex];
        SigmaNativeStitchFactorKernel[receiptIndex] =
            SigmaNativeGroupFactorKernel[factorIndex];
        SigmaNativeStitchFactorHash[receiptIndex] =
            SigmaNativeHashGroupFactor(factorIndex);
    }
    GroupMemoryBarrierWithGroupSync();
}

// One 256-thread workgroup owns one actual sector-pair relation.  The dispatch
// grid is pair cardinality; no pair/lane/factor becomes a submission and no
// caller-supplied relation/factor class enters this computation.
[numthreads(256, 1, 1)]
void EvaluateNativeStitchPairs(uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint pairWork = groupId.x;
    if (pairWork >= _NativeStitchPairCount)
        return;
    uint edgeIndex = pairWork >> 4u;
    uint pair = pairWork & 15u;
    uint leftSector = pair >> 2u;
    uint rightSector = pair & 3u;
    uint4 edge = _NativeStitchEdges[edgeIndex];
    uint4 leftNode = _NativeStitchNodeHeaders[edge.x];
    uint4 rightNode = _NativeStitchNodeHeaders[edge.y];
    uint leftAddress = SigmaMerkabaNativeBoundarySectorAddress(leftSector);
    uint rightAddress = SigmaMerkabaNativeBoundarySectorAddress(rightSector);
    uint transportAddress = leftAddress ^ rightAddress;
    int forwardSign = SigmaMerkabaBasisSign(leftAddress, transportAddress);
    int reverseSign = SigmaMerkabaBasisSign(rightAddress, transportAddress);
    uint threadIndex = groupThreadId.x;

    if (threadIndex == 0u)
    {
        uint contactOffset = edge.w & SIGMA_NATIVE_STITCH_CONTACT_OFFSET_MASK;
        uint leftClaim = (edge.w >> 20u) & 3u;
        uint rightClaim = (edge.w >> 22u) & 3u;
        uint2 leftLower[3];
        uint2 leftUpper[3];
        uint2 rightLower[3];
        uint2 rightUpper[3];
        [unroll]
        for (uint axis = 0u; axis < 3u; ++axis)
        {
            leftLower[axis] = _NativeStitchContacts[contactOffset + axis * 2u];
            leftUpper[axis] = _NativeStitchContacts[
                contactOffset + axis * 2u + 1u];
            rightLower[axis] = _NativeStitchContacts[
                contactOffset + 6u + axis * 2u];
            rightUpper[axis] = _NativeStitchContacts[
                contactOffset + 6u + axis * 2u + 1u];
        }
        SigmaNativeStitchContact = SigmaMerkabaBoundaryEnvelopesContact(
            leftClaim, rightClaim, leftLower, leftUpper,
            rightLower, rightUpper) ? 1u : 0u;
        SigmaNativeGroupAllValid = 1u;
    }
    GroupMemoryBarrierWithGroupSync();

    // Explicitly bracketed endpoint associators are evaluated separately and
    // differenced.  Nonassociativity is retained as a factor, never a tear enum.
    SigmaNativeStitchLoadEndpointAssociator(leftNode.x, leftAddress,
        edge.z, threadIndex, true);
    SigmaNativeStitchLoadEndpointAssociator(rightNode.x, rightAddress,
        edge.z, threadIndex, false);

    if (threadIndex < 16u)
    {
        uint laneValid = 1u;
        uint source = transportAddress ^ threadIndex;
        uint2 forwardValue = _NativeStates[leftNode.x + source];
        int forwardBasisSign = SigmaMulBasisSign(source, transportAddress) *
            forwardSign;
        if (forwardBasisSign < 0)
            forwardValue = SigmaQ48NegateChecked(forwardValue, laneValid);
        uint2 reverseValue = _NativeStates[rightNode.x + source];
        int reverseBasisSign = SigmaMulBasisSign(source, transportAddress) *
            reverseSign;
        if (reverseBasisSign < 0)
            reverseValue = SigmaQ48NegateChecked(reverseValue, laneValid);
        SigmaNativeGroupLink[threadIndex] = SigmaQ48SubChecked(
            _NativeStates[rightNode.x + threadIndex], forwardValue, laneValid);
        // Keep the reverse link in an otherwise dead bracket scratch array until
        // its own complete G classification phase.
        SigmaNativeGroupLeftBracket[threadIndex] = SigmaQ48SubChecked(
            _NativeStates[leftNode.x + threadIndex], reverseValue, laneValid);
        SigmaNativeGroupLaneValid[threadIndex] = laneValid;
    }
    GroupMemoryBarrierWithGroupSync();
    if (threadIndex == 0u)
    {
        [unroll]
        for (uint lane = 0u; lane < 16u; ++lane)
            SigmaNativeGroupAllValid &= SigmaNativeGroupLaneValid[lane];
    }
    GroupMemoryBarrierWithGroupSync();

    SigmaNativeStitchClassifyCurrentFactor(0u, 0u, threadIndex);
    if (threadIndex < 16u)
        SigmaNativeGroupLink[threadIndex] =
            SigmaNativeGroupLeftBracket[threadIndex];
    GroupMemoryBarrierWithGroupSync();
    SigmaNativeStitchClassifyCurrentFactor(0u, 1u, threadIndex);
    SigmaNativeStitchClassifyCurrentFactor(1u, 2u, threadIndex);
    if (threadIndex < 16u)
    {
        uint laneValid = 1u;
        SigmaNativeGroupAssociator[threadIndex] = SigmaQ48NegateChecked(
            SigmaNativeGroupAssociator[threadIndex], laneValid);
        SigmaNativeGroupLaneValid[threadIndex] = laneValid;
    }
    GroupMemoryBarrierWithGroupSync();
    SigmaNativeStitchClassifyCurrentFactor(1u, 3u, threadIndex);

    if (threadIndex == 0u)
    {
        uint closureClass = SigmaNativeStitchContact == 0u
            ? SIGMA_NATIVE_FACTOR_INCOMPATIBLE
            : SigmaNativeAggregateFactorClass(
                SigmaNativeStitchFactorClass[0],
                SigmaNativeStitchFactorClass[1],
                SigmaNativeAggregateFactorClass(
                    SigmaNativeStitchFactorClass[2],
                    SigmaNativeStitchFactorClass[3],
                    SIGMA_NATIVE_FACTOR_EXACT_CLOSED));
        uint signBits = (forwardSign < 0 ? 1u : 0u) |
            (reverseSign < 0 ? 2u : 0u) |
            (SigmaNativeGroupAllValid != 0u ? 4u : 0u);
        uint output = pairWork * SIGMA_NATIVE_STITCH_PAIR_STRIDE;
        _NativeStitchPairResults[output] = uint4(closureClass,
            leftSector | (rightSector << 16u), transportAddress, signBits);
        _NativeStitchPairResults[output + 1u] = uint4(
            SigmaNativeStitchFactorHash[0],
            SigmaNativeStitchFactorHash[1],
            SigmaNativeStitchFactorHash[2],
            SigmaNativeStitchFactorHash[3]);
        _NativeStitchPairResults[output + 2u] = uint4(
            SigmaNativeStitchFactorClass[0] |
                (SigmaNativeStitchFactorClass[1] << 4u) |
                (SigmaNativeStitchFactorClass[2] << 8u) |
                (SigmaNativeStitchFactorClass[3] << 12u),
            SigmaNativeStitchFactorKernel[0] |
                (SigmaNativeStitchFactorKernel[1] << 1u) |
                (SigmaNativeStitchFactorKernel[2] << 2u) |
                (SigmaNativeStitchFactorKernel[3] << 3u),
            SigmaNativeGroupAllValid, SigmaNativeStitchContact);
    }
}
#endif

#if defined(SIGMA_NATIVE_STITCH_CLOSE)
#define SIGMA_NATIVE_STITCH_MAX_NODES 8u
#define SIGMA_NATIVE_STITCH_MAX_EDGES 12u
#define SIGMA_NATIVE_STITCH_ASSIGNMENT_COUNT 24u
#define SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES 192u
#define SIGMA_NATIVE_STITCH_CANDIDATE_OFFSET 1u
#define SIGMA_NATIVE_STITCH_COMPONENT_RECEIPT_OFFSET 193u
#define SIGMA_NATIVE_STITCH_CASE_STRIDE 201u
#define SIGMA_NATIVE_STITCH_PAIR_STRIDE 3u
#define SIGMA_NATIVE_STITCH_EDGE_UNKNOWN_CONTINUATION (1u << 24u)

groupshared uint4 SigmaNativeStitchCloseEdges[SIGMA_NATIVE_STITCH_MAX_EDGES];
groupshared uint SigmaNativeStitchLabels[SIGMA_NATIVE_STITCH_MAX_NODES];
groupshared uint SigmaNativeStitchNextLabels[SIGMA_NATIVE_STITCH_MAX_NODES];
groupshared int2 SigmaNativeStitchPositions[
    SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES];
groupshared int2 SigmaNativeStitchNextPositions[
    SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES];
groupshared int SigmaNativeStitchFrames[
    SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES];
groupshared int SigmaNativeStitchNextFrames[
    SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES];
groupshared uint SigmaNativeStitchAssigned[
    SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES];
groupshared uint SigmaNativeStitchNextAssigned[
    SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES];
groupshared uint SigmaNativeStitchCanonicalD4[
    SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES];
groupshared int2 SigmaNativeStitchCanonicalTranslation[
    SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES];
groupshared uint SigmaNativeStitchCloseConflict[
    SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES];
groupshared uint SigmaNativeStitchComponentMembers[
    SIGMA_NATIVE_STITCH_MAX_NODES];
groupshared uint SigmaNativeStitchComponentValidAssignments[
    SIGMA_NATIVE_STITCH_MAX_NODES];
// One bit for the lowest assignment index representing each distinct complete
// component embedding modulo generated D4.  At most three bits survive, but the
// 24-bit representation makes the receipt independently auditable.
groupshared uint SigmaNativeStitchComponentOrbitRepresentatives[
    SIGMA_NATIVE_STITCH_MAX_NODES];
groupshared uint SigmaNativeStitchRawOrbitMembers[
    SIGMA_NATIVE_STITCH_ASSIGNMENT_COUNT];
groupshared uint SigmaNativeStitchRawOrbitRepresentatives;
groupshared uint SigmaNativeStitchCloseOpen;
groupshared uint SigmaNativeStitchComponentCount;
groupshared uint SigmaNativeStitchComponentRootMask;
groupshared uint SigmaNativeStitchWholeUnresolved;
groupshared uint SigmaNativeStitchLevelOverflow;

int2 SigmaNativeStitchAssignmentDirection(uint assignmentIndex, uint sector,
    inout uint valid)
{
    valid &= assignmentIndex < SIGMA_NATIVE_STITCH_ASSIGNMENT_COUNT &&
        sector < 4u ? 1u : 0u;
    uint4 assignment = SIGMA_STITCH_NATIVE_SECTOR_CHART_ASSIGNMENTS[
        min(assignmentIndex, SIGMA_NATIVE_STITCH_ASSIGNMENT_COUNT - 1u)];
    uint direction = assignment[min(sector, 3u)];
    int2 result = int2(0, 0);
    if (direction == 0u) result = int2(1, 0);
    else if (direction == 1u) result = int2(0, 1);
    else if (direction == 2u) result = int2(-1, 0);
    else if (direction == 3u) result = int2(0, -1);
    else valid = 0u;
    return result;
}

int2 SigmaNativeStitchChartDirection(uint assignmentIndex, uint frameIndex,
    uint sector, inout uint valid)
{
    valid &= frameIndex < 8u ? 1u : 0u;
    int2 source = SigmaNativeStitchAssignmentDirection(assignmentIndex,
        sector, valid);
    int4 frame = SIGMA_STITCH_CHART_D4[min(frameIndex, 7u)];
    return int2(frame.x * source.x + frame.y * source.y,
        frame.z * source.x + frame.w * source.y);
}

int SigmaNativeStitchFrameDeterminant(uint frameIndex)
{
    int4 frame = SIGMA_STITCH_CHART_D4[min(frameIndex, 7u)];
    return frame.x * frame.w - frame.y * frame.z;
}

bool SigmaNativeStitchResolveFrame(uint assignmentIndex, uint currentFrame,
    uint currentSector, uint nextSector, int orientationParity,
    out int nextFrame)
{
    uint valid = 1u;
    int2 direction = SigmaNativeStitchChartDirection(assignmentIndex,
        currentFrame, currentSector, valid);
    int requiredDeterminant = SigmaNativeStitchFrameDeterminant(currentFrame) *
        orientationParity;
    nextFrame = 0;
    uint matchCount = 0u;
    [unroll]
    for (uint candidate = 0u; candidate < 8u; ++candidate)
    {
        uint candidateValid = valid;
        int2 candidateDirection = SigmaNativeStitchChartDirection(
            assignmentIndex, candidate, nextSector, candidateValid);
        bool match = candidateValid != 0u &&
            all(candidateDirection == -direction) &&
            SigmaNativeStitchFrameDeterminant(candidate) == requiredDeterminant;
        if (!match)
            continue;
        nextFrame = (int)candidate;
        ++matchCount;
    }
    return matchCount == 1u;
}

int SigmaNativeStitchFloorDyadic(int value, uint level)
{
    return value >> min(level, 30u);
}

int SigmaNativeStitchCompareDyadicLower(int2 left, uint leftLevel,
    int2 right, uint rightLevel)
{
    uint common = max(leftLevel, rightLevel);
    int2 leftCommon = left << (common - leftLevel);
    int2 rightCommon = right << (common - rightLevel);
    int result = 0;
    if (leftCommon.x != rightCommon.x)
        result = leftCommon.x < rightCommon.x ? -1 : 1;
    else if (leftCommon.y != rightCommon.y)
        result = leftCommon.y < rightCommon.y ? -1 : 1;
    return result;
}

bool SigmaNativeStitchCellsOverlap(int2 left, uint leftLevel,
    int2 right, uint rightLevel)
{
    uint common = max(leftLevel, rightLevel);
    int leftShift = (int)(common - leftLevel);
    int rightShift = (int)(common - rightLevel);
    int2 left0 = left << leftShift;
    int2 left1 = (left + 1) << leftShift;
    int2 right0 = right << rightShift;
    int2 right1 = (right + 1) << rightShift;
    return left0.x < right1.x && right0.x < left1.x &&
        left0.y < right1.y && right0.y < left1.y;
}

bool SigmaNativeStitchBaseTranslation(int2 transformedRoot, uint rootLevel,
    out int2 translation)
{
    uint rootScale = 1u << rootLevel;
    uint rootMask = rootScale - 1u;
    int2 delta = -transformedRoot;
    bool divisible = (asuint(delta.x) & rootMask) == 0u &&
        (asuint(delta.y) & rootMask) == 0u;
    translation = delta >> rootLevel;
    return divisible;
}

uint SigmaNativeStitchRawAssignmentOrbit(uint assignmentIndex)
{
    uint4 assignment = SIGMA_STITCH_NATIVE_SECTOR_CHART_ASSIGNMENTS[
        min(assignmentIndex, SIGMA_NATIVE_STITCH_ASSIGNMENT_COUNT - 1u)];
    uint oppositeDirection = (assignment.x + 2u) & 3u;
    uint matchY = assignment.y == oppositeDirection ? 1u : 0u;
    uint matchZ = assignment.z == oppositeDirection ? 1u : 0u;
    uint matchW = assignment.w == oppositeDirection ? 1u : 0u;
    uint orbit = matchZ + (matchW << 1u);
    return matchY + matchZ + matchW == 1u ? orbit : 0xffffffffu;
}

// The second and only global synchronization boundary of the N2 stitch oracle.
// One workgroup closes one bounded case.  Lanes [0,192) cover the complete
// 24-assignment x 8-locality product, so no fixed sector chart convention and no
// one-thread graph interpreter is hidden inside this dispatch.
[numthreads(256, 1, 1)]
void CloseNativeStitchCases(uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint caseIndex = groupId.x;
    if (caseIndex >= _NativeStitchCaseCount)
        return;
    uint threadIndex = groupThreadId.x;
    uint4 header = _NativeStitchCaseHeaders[caseIndex];
    uint nodeOffset = header.x;
    uint nodeCount = min(header.y, SIGMA_NATIVE_STITCH_MAX_NODES);
    uint edgeOffset = header.z;
    uint edgeCount = min(header.w, SIGMA_NATIVE_STITCH_MAX_EDGES);

    if (threadIndex < SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES)
        SigmaNativeStitchCloseConflict[threadIndex] =
            header.y > SIGMA_NATIVE_STITCH_MAX_NODES ||
            header.w > SIGMA_NATIVE_STITCH_MAX_EDGES ? 1u : 0u;
    if (threadIndex < SIGMA_NATIVE_STITCH_MAX_NODES)
    {
        SigmaNativeStitchComponentMembers[threadIndex] = 0u;
        SigmaNativeStitchComponentValidAssignments[threadIndex] = 0u;
        SigmaNativeStitchComponentOrbitRepresentatives[threadIndex] = 0u;
    }
    if (threadIndex == 0u)
    {
        SigmaNativeStitchCloseOpen = 0u;
        SigmaNativeStitchComponentCount = 0u;
        SigmaNativeStitchComponentRootMask = 0u;
        SigmaNativeStitchWholeUnresolved = 0u;
        SigmaNativeStitchLevelOverflow = 0u;
        SigmaNativeStitchRawOrbitRepresentatives = 0u;
    }
    GroupMemoryBarrierWithGroupSync();

    // D4 preserves and is transitive on a square's opposition relation.  Thus a
    // generated 4! assignment's raw orbit is determined exactly by which native
    // sector lies opposite sector zero.  This derives the three 8-image orbits
    // directly from the generated assignment table without a caller-owned map.
    if (threadIndex < SIGMA_NATIVE_STITCH_ASSIGNMENT_COUNT)
    {
        uint orbit = SigmaNativeStitchRawAssignmentOrbit(threadIndex);
        uint members = 0u;
        [loop]
        for (uint candidate = 0u;
             candidate < SIGMA_NATIVE_STITCH_ASSIGNMENT_COUNT; ++candidate)
        {
            uint candidateOrbit = SigmaNativeStitchRawAssignmentOrbit(candidate);
            if (orbit < 3u && candidateOrbit == orbit)
                members |= 1u << candidate;
        }
        SigmaNativeStitchRawOrbitMembers[threadIndex] = members;
        uint priorMask = threadIndex == 0u ? 0u : (1u << threadIndex) - 1u;
        if ((members & priorMask) == 0u)
            InterlockedOr(SigmaNativeStitchRawOrbitRepresentatives,
                1u << threadIndex);
        if (orbit >= 3u || countbits(members) != 8u)
            InterlockedOr(SigmaNativeStitchWholeUnresolved, 1u);
    }
    GroupMemoryBarrierWithGroupSync();

    // This bounded oracle uses signed 32-bit chart scratch.  Do not silently
    // clamp an admitted dyadic level into that domain: retain the whole case as
    // unresolved instead.  Production chart width remains an N4 lowering
    // decision and is not constrained by this test-only fixture bound.
    if (threadIndex < nodeCount &&
        _NativeStitchNodeHeaders[nodeOffset + threadIndex].y > 30u)
        InterlockedOr(SigmaNativeStitchLevelOverflow, 1u);
    GroupMemoryBarrierWithGroupSync();
    if (threadIndex < SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES &&
        SigmaNativeStitchLevelOverflow != 0u)
        SigmaNativeStitchCloseConflict[threadIndex] = 1u;
    GroupMemoryBarrierWithGroupSync();

    if (threadIndex < edgeCount)
    {
        uint edgeIndex = edgeOffset + threadIndex;
        uint closedCount = 0u;
        uint resolvedPair = 0u;
        uint unresolved = 0u;
        [unroll]
        for (uint pair = 0u; pair < 16u; ++pair)
        {
            uint pairRecord = ((edgeIndex << 4u) + pair) *
                SIGMA_NATIVE_STITCH_PAIR_STRIDE;
            uint factorClass = _NativeStitchPairResults[pairRecord].x;
            unresolved |= factorClass == SIGMA_EXACT_FACTOR_UNRESOLVED
                ? 1u : 0u;
            if (factorClass == SIGMA_EXACT_FACTOR_PROVEN_CLOSED)
            {
                ++closedCount;
                resolvedPair = pair;
            }
        }
        uint4 edgeInput = _NativeStitchEdges[edgeIndex];
        unresolved |= (edgeInput.w &
            SIGMA_NATIVE_STITCH_EDGE_UNKNOWN_CONTINUATION) != 0u ? 1u : 0u;
        uint resolution = unresolved != 0u || closedCount > 1u
            ? SIGMA_STITCH_UNRESOLVED
            : closedCount == 0u ? SIGMA_STITCH_NO_STITCH :
                SIGMA_STITCH_RESOLVED;
        uint pairRecord = ((edgeIndex << 4u) + resolvedPair) *
            SIGMA_NATIVE_STITCH_PAIR_STRIDE;
        uint4 pairReceipt = _NativeStitchPairResults[pairRecord];
        uint4 edgeReceipt = uint4(resolution, pairReceipt.y,
            pairReceipt.z, pairReceipt.w);
        SigmaNativeStitchCloseEdges[threadIndex] = edgeReceipt;
        _NativeStitchEdgeResults[edgeIndex] = edgeReceipt;
        if (resolution == SIGMA_STITCH_UNRESOLVED)
            InterlockedOr(SigmaNativeStitchCloseOpen, 1u);
    }
    GroupMemoryBarrierWithGroupSync();

    if (threadIndex < nodeCount)
        SigmaNativeStitchLabels[threadIndex] = threadIndex;
    GroupMemoryBarrierWithGroupSync();

    // Parallel connected-label contraction.  Eight fixed rounds are the
    // complete bounded oracle schedule, independent of edge enumeration.
    [loop]
    for (uint labelRound = 0u;
         labelRound < SIGMA_NATIVE_STITCH_MAX_NODES; ++labelRound)
    {
        if (threadIndex < nodeCount)
        {
            uint label = SigmaNativeStitchLabels[threadIndex];
            uint globalNode = nodeOffset + threadIndex;
            [unroll]
            for (uint localEdge = 0u;
                 localEdge < SIGMA_NATIVE_STITCH_MAX_EDGES; ++localEdge)
            {
                if (localEdge >= edgeCount ||
                    SigmaNativeStitchCloseEdges[localEdge].x !=
                        SIGMA_STITCH_RESOLVED)
                    continue;
                uint4 edge = _NativeStitchEdges[edgeOffset + localEdge];
                uint neighbour = edge.x == globalNode ? edge.y :
                    (edge.y == globalNode ? edge.x : 0xffffffffu);
                if (neighbour >= nodeOffset &&
                    neighbour < nodeOffset + nodeCount)
                    label = min(label,
                        SigmaNativeStitchLabels[neighbour - nodeOffset]);
            }
            SigmaNativeStitchNextLabels[threadIndex] = label;
        }
        GroupMemoryBarrierWithGroupSync();
        if (threadIndex < nodeCount)
            SigmaNativeStitchLabels[threadIndex] =
                SigmaNativeStitchNextLabels[threadIndex];
        GroupMemoryBarrierWithGroupSync();
    }

    if (threadIndex < nodeCount)
    {
        uint root = SigmaNativeStitchLabels[threadIndex];
        InterlockedOr(SigmaNativeStitchComponentMembers[root],
            1u << threadIndex);
        if (root == threadIndex)
            InterlockedOr(SigmaNativeStitchComponentRootMask, 1u << root);
    }
    GroupMemoryBarrierWithGroupSync();

    if (threadIndex < SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES)
    {
        uint assignmentIndex = threadIndex / SIGMA_NATIVE_STITCH_MAX_NODES;
        uint nodeIndex = threadIndex % SIGMA_NATIVE_STITCH_MAX_NODES;
        bool active = nodeIndex < nodeCount;
        bool seed = active &&
            SigmaNativeStitchLabels[nodeIndex] == nodeIndex;
        SigmaNativeStitchAssigned[threadIndex] = seed ? 1u : 0u;
        SigmaNativeStitchPositions[threadIndex] = int2(0, 0);
        SigmaNativeStitchFrames[threadIndex] = 0;
        if (assignmentIndex == 0u && seed)
            InterlockedAdd(SigmaNativeStitchComponentCount, 1u);
    }
    GroupMemoryBarrierWithGroupSync();

    // Parallel potential propagation and redundant-path verification.  Each
    // locality lane examines a fixed bounded edge tile; no single lane walks the
    // complete problem and no data-dependent dispatch/recursion exists.
    [loop]
    for (uint propagationRound = 0u;
         propagationRound < SIGMA_NATIVE_STITCH_MAX_NODES;
         ++propagationRound)
    {
        if (threadIndex < SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES)
        {
            uint assignmentIndex = threadIndex /
                SIGMA_NATIVE_STITCH_MAX_NODES;
            uint nodeIndex = threadIndex % SIGMA_NATIVE_STITCH_MAX_NODES;
            if (nodeIndex >= nodeCount)
            {
                SigmaNativeStitchNextAssigned[threadIndex] = 0u;
                SigmaNativeStitchNextPositions[threadIndex] = int2(0, 0);
                SigmaNativeStitchNextFrames[threadIndex] = 0;
            }
            else
            {
            uint globalNode = nodeOffset + nodeIndex;
            uint assigned = SigmaNativeStitchAssigned[threadIndex];
            int2 selectedPosition = SigmaNativeStitchPositions[threadIndex];
            int selectedFrame = SigmaNativeStitchFrames[threadIndex];
            uint selectedNeighbour = 0xffffffffu;
            uint proposalCount = 0u;
            [unroll]
            for (uint localEdge = 0u;
                 localEdge < SIGMA_NATIVE_STITCH_MAX_EDGES; ++localEdge)
            {
                if (localEdge >= edgeCount ||
                    SigmaNativeStitchCloseEdges[localEdge].x !=
                        SIGMA_STITCH_RESOLVED)
                    continue;
                uint4 edge = _NativeStitchEdges[edgeOffset + localEdge];
                bool currentIsLeft = edge.x == globalNode;
                bool currentIsRight = edge.y == globalNode;
                if (!currentIsLeft && !currentIsRight)
                    continue;
                uint neighbourGlobal = currentIsLeft ? edge.y : edge.x;
                if (neighbourGlobal < nodeOffset ||
                    neighbourGlobal >= nodeOffset + nodeCount)
                    continue;
                uint neighbour = neighbourGlobal - nodeOffset;
                uint neighbourLane = assignmentIndex *
                    SIGMA_NATIVE_STITCH_MAX_NODES + neighbour;
                if (SigmaNativeStitchAssigned[neighbourLane] == 0u)
                    continue;
                uint4 receipt = SigmaNativeStitchCloseEdges[localEdge];
                uint leftSector = receipt.y & 0xffffu;
                uint rightSector = receipt.y >> 16u;
                bool forward = currentIsRight;
                uint currentSector = forward ? leftSector : rightSector;
                uint nextSector = forward ? rightSector : leftSector;
                int forwardSign = (receipt.w & 1u) != 0u ? -1 : 1;
                int reverseSign = (receipt.w & 2u) != 0u ? -1 : 1;
                int orientationParity = forwardSign * reverseSign;
                uint directionValid = 1u;
                int neighbourFrame = SigmaNativeStitchFrames[neighbourLane];
                int2 direction = SigmaNativeStitchChartDirection(
                    assignmentIndex, (uint)neighbourFrame, currentSector,
                    directionValid);
                int proposedFrame = 0;
                bool frameValid = directionValid != 0u &&
                    SigmaNativeStitchResolveFrame(assignmentIndex,
                        (uint)neighbourFrame, currentSector, nextSector,
                        orientationParity, proposedFrame);
                int2 proposedPosition =
                    SigmaNativeStitchPositions[neighbourLane] + direction;
                if (!frameValid)
                {
                    uint component = SigmaNativeStitchLabels[nodeIndex];
                    InterlockedOr(
                        SigmaNativeStitchCloseConflict[assignmentIndex *
                            SIGMA_NATIVE_STITCH_MAX_NODES + component], 1u);
                    continue;
                }
                if (assigned != 0u)
                {
                    if (any(proposedPosition != selectedPosition) ||
                        proposedFrame != selectedFrame)
                    {
                        uint component = SigmaNativeStitchLabels[nodeIndex];
                        InterlockedOr(
                            SigmaNativeStitchCloseConflict[assignmentIndex *
                                SIGMA_NATIVE_STITCH_MAX_NODES + component], 1u);
                    }
                }
                else
                {
                    ++proposalCount;
                    if (neighbour < selectedNeighbour)
                    {
                        selectedNeighbour = neighbour;
                        selectedPosition = proposedPosition;
                        selectedFrame = proposedFrame;
                    }
                }
            }
            SigmaNativeStitchNextAssigned[threadIndex] =
                assigned != 0u || proposalCount != 0u ? 1u : 0u;
            SigmaNativeStitchNextPositions[threadIndex] = selectedPosition;
            SigmaNativeStitchNextFrames[threadIndex] = selectedFrame;
            }
        }
        GroupMemoryBarrierWithGroupSync();
        if (threadIndex < SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES)
        {
            SigmaNativeStitchAssigned[threadIndex] =
                SigmaNativeStitchNextAssigned[threadIndex];
            SigmaNativeStitchPositions[threadIndex] =
                SigmaNativeStitchNextPositions[threadIndex];
            SigmaNativeStitchFrames[threadIndex] =
                SigmaNativeStitchNextFrames[threadIndex];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if (threadIndex < SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES)
    {
        uint assignmentIndex = threadIndex / SIGMA_NATIVE_STITCH_MAX_NODES;
        uint nodeIndex = threadIndex % SIGMA_NATIVE_STITCH_MAX_NODES;
        if (nodeIndex < nodeCount)
        {
        uint component = SigmaNativeStitchLabels[nodeIndex];
        uint conflictIndex = assignmentIndex * SIGMA_NATIVE_STITCH_MAX_NODES +
            component;
        if (SigmaNativeStitchAssigned[threadIndex] == 0u)
            InterlockedOr(SigmaNativeStitchCloseConflict[conflictIndex], 1u);
        [unroll]
        for (uint peer = 0u; peer < SIGMA_NATIVE_STITCH_MAX_NODES; ++peer)
        {
            if (peer <= nodeIndex || peer >= nodeCount ||
                SigmaNativeStitchLabels[peer] !=
                    SigmaNativeStitchLabels[nodeIndex])
                continue;
            uint peerLane = assignmentIndex *
                SIGMA_NATIVE_STITCH_MAX_NODES + peer;
            uint4 leftNode = _NativeStitchNodeHeaders[nodeOffset + nodeIndex];
            uint4 rightNode = _NativeStitchNodeHeaders[nodeOffset + peer];
            if (SigmaNativeStitchCellsOverlap(
                    SigmaNativeStitchPositions[threadIndex], leftNode.y,
                    SigmaNativeStitchPositions[peerLane], rightNode.y))
                InterlockedOr(
                    SigmaNativeStitchCloseConflict[conflictIndex], 1u);
        }
        }
    }
    GroupMemoryBarrierWithGroupSync();

    // Feasibility belongs to each transient stitch-connected component.  One
    // assignment may fail in component A and remain exact in disconnected B.
    if (threadIndex < SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES)
    {
        uint assignmentIndex = threadIndex / SIGMA_NATIVE_STITCH_MAX_NODES;
        uint nodeIndex = threadIndex % SIGMA_NATIVE_STITCH_MAX_NODES;
        if (nodeIndex < nodeCount &&
            SigmaNativeStitchLabels[nodeIndex] == nodeIndex &&
            SigmaNativeStitchCloseConflict[threadIndex] == 0u)
            InterlockedOr(SigmaNativeStitchComponentValidAssignments[nodeIndex],
                1u << assignmentIndex);
    }
    GroupMemoryBarrierWithGroupSync();

    // Canonicalize each component/assignment once under all eight generated D4
    // images.  Root lanes choose a transform; all locality lanes then apply it
    // concurrently.  The next arrays are dead propagation scratch at this point
    // and are deliberately reused rather than allocating another graph buffer.
    if (threadIndex < SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES)
    {
        uint assignmentIndex = threadIndex / SIGMA_NATIVE_STITCH_MAX_NODES;
        uint componentRoot = threadIndex % SIGMA_NATIVE_STITCH_MAX_NODES;
        uint validMask = componentRoot < nodeCount &&
                SigmaNativeStitchLabels[componentRoot] == componentRoot
            ? SigmaNativeStitchComponentValidAssignments[componentRoot] : 0u;
        bool root = componentRoot < nodeCount &&
            SigmaNativeStitchLabels[componentRoot] == componentRoot;
        bool haveBest = false;
        uint bestD4 = 0u;
        int2 bestTranslation = int2(0, 0);
        if (root && (validMask & (1u << assignmentIndex)) != 0u)
        {
            uint rootLane = assignmentIndex * SIGMA_NATIVE_STITCH_MAX_NODES +
                componentRoot;
            uint rootLevel = _NativeStitchNodeHeaders[
                nodeOffset + componentRoot].y;
            [unroll]
            for (uint d4 = 0u; d4 < 8u; ++d4)
            {
                uint transformValid = 1u;
                int2 transformedRoot = SigmaMerkabaTransformChartCellLower(
                    SigmaNativeStitchPositions[rootLane], d4, transformValid);
                int2 candidateTranslation;
                bool candidateValid = transformValid != 0u &&
                    SigmaNativeStitchBaseTranslation(transformedRoot, rootLevel,
                        candidateTranslation);
                bool candidateLess = !haveBest;
                bool decided = !haveBest;
                [unroll]
                for (uint node = 0u; node < SIGMA_NATIVE_STITCH_MAX_NODES; ++node)
                {
                    if (!candidateValid || decided || node >= nodeCount ||
                        SigmaNativeStitchLabels[node] != componentRoot)
                        continue;
                    uint lane = assignmentIndex *
                        SIGMA_NATIVE_STITCH_MAX_NODES + node;
                    uint level = _NativeStitchNodeHeaders[nodeOffset + node].y;
                    uint leftValid = 1u;
                    uint rightValid = 1u;
                    int2 candidate = SigmaMerkabaTransformChartCellLower(
                            SigmaNativeStitchPositions[lane], d4, leftValid) +
                        (candidateTranslation << level);
                    int2 best = SigmaMerkabaTransformChartCellLower(
                            SigmaNativeStitchPositions[lane], bestD4,
                            rightValid) + (bestTranslation << level);
                    candidateValid = candidateValid && leftValid != 0u &&
                        rightValid != 0u;
                    if (candidate.x != best.x)
                    {
                        candidateLess = candidate.x < best.x;
                        decided = true;
                    }
                    else if (candidate.y != best.y)
                    {
                        candidateLess = candidate.y < best.y;
                        decided = true;
                    }
                }
                if (candidateValid && candidateLess)
                {
                    haveBest = true;
                    bestD4 = d4;
                    bestTranslation = candidateTranslation;
                }
            }
        }
        SigmaNativeStitchCanonicalD4[threadIndex] = bestD4;
        SigmaNativeStitchCanonicalTranslation[threadIndex] = bestTranslation;
        if (root && (validMask & (1u << assignmentIndex)) != 0u && !haveBest)
            InterlockedOr(SigmaNativeStitchWholeUnresolved, 1u);
    }
    GroupMemoryBarrierWithGroupSync();

    if (threadIndex < SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES)
    {
        uint assignmentIndex = threadIndex / SIGMA_NATIVE_STITCH_MAX_NODES;
        uint nodeIndex = threadIndex % SIGMA_NATIVE_STITCH_MAX_NODES;
        if (nodeIndex < nodeCount)
        {
            uint componentRoot = SigmaNativeStitchLabels[nodeIndex];
            uint rootLane = assignmentIndex * SIGMA_NATIVE_STITCH_MAX_NODES +
                componentRoot;
            uint transformValid = 1u;
            uint level = _NativeStitchNodeHeaders[nodeOffset + nodeIndex].y;
            SigmaNativeStitchNextPositions[threadIndex] =
                SigmaMerkabaTransformChartCellLower(
                    SigmaNativeStitchPositions[threadIndex],
                    SigmaNativeStitchCanonicalD4[rootLane], transformValid) +
                (SigmaNativeStitchCanonicalTranslation[rootLane] << level);
            if (transformValid == 0u)
                InterlockedOr(SigmaNativeStitchWholeUnresolved, 1u);
        }
    }
    GroupMemoryBarrierWithGroupSync();

    // One root lane per transient component compares only the three generated
    // raw-orbit representatives.  Components execute concurrently; there is no
    // cross-component atomic election, host repair or component dispatch loop.
    if (threadIndex < nodeCount &&
        SigmaNativeStitchLabels[threadIndex] == threadIndex)
    {
        uint componentRoot = threadIndex;
        uint validMask = SigmaNativeStitchComponentValidAssignments[componentRoot];
        uint componentOrbitMask = 0u;
        [loop]
        for (uint assignmentIndex = 0u;
             assignmentIndex < SIGMA_NATIVE_STITCH_ASSIGNMENT_COUNT;
             ++assignmentIndex)
        {
            if ((SigmaNativeStitchRawOrbitRepresentatives &
                    (1u << assignmentIndex)) == 0u)
                continue;
            uint rawMembers = SigmaNativeStitchRawOrbitMembers[assignmentIndex];
            uint survivingMembers = validMask & rawMembers;
            if (survivingMembers != 0u && survivingMembers != rawMembers)
            {
                InterlockedOr(SigmaNativeStitchWholeUnresolved, 1u);
                continue;
            }
            if (survivingMembers == 0u)
                continue;
            bool representative = true;
            [loop]
            for (uint prior = 0u;
                 prior < SIGMA_NATIVE_STITCH_ASSIGNMENT_COUNT; ++prior)
            {
                if (!representative || prior >= assignmentIndex ||
                (SigmaNativeStitchRawOrbitRepresentatives &
                    (1u << prior)) == 0u)
                    continue;
                uint priorMembers = SigmaNativeStitchRawOrbitMembers[prior];
                if ((validMask & priorMembers) != priorMembers)
                    continue;
                bool equal = true;
                [unroll]
                for (uint node = 0u; node < SIGMA_NATIVE_STITCH_MAX_NODES;
                     ++node)
                {
                    if (node >= nodeCount ||
                        SigmaNativeStitchLabels[node] != componentRoot)
                        continue;
                    uint priorLane = prior * SIGMA_NATIVE_STITCH_MAX_NODES + node;
                    uint currentLane = assignmentIndex *
                        SIGMA_NATIVE_STITCH_MAX_NODES + node;
                    equal = equal && all(
                        SigmaNativeStitchNextPositions[priorLane] ==
                        SigmaNativeStitchNextPositions[currentLane]);
                }
                if (equal)
                    representative = false;
            }
            if (representative)
                componentOrbitMask |= 1u << assignmentIndex;
        }
        SigmaNativeStitchComponentOrbitRepresentatives[componentRoot] =
            componentOrbitMask;
    }
    GroupMemoryBarrierWithGroupSync();

    if (threadIndex < nodeCount &&
        SigmaNativeStitchLabels[threadIndex] == threadIndex)
    {
        uint validMask = SigmaNativeStitchComponentValidAssignments[threadIndex];
        uint orbitMask =
            SigmaNativeStitchComponentOrbitRepresentatives[threadIndex];
        if (validMask == 0u || countbits(orbitMask) != 1u)
            InterlockedOr(SigmaNativeStitchWholeUnresolved, 1u);
    }
    if (threadIndex == 0u && SigmaNativeStitchCloseOpen != 0u)
        SigmaNativeStitchWholeUnresolved = 1u;
    GroupMemoryBarrierWithGroupSync();

    uint resolution = SigmaNativeStitchWholeUnresolved != 0u
        ? SIGMA_STITCH_UNRESOLVED : SIGMA_STITCH_RESOLVED;
    uint caseOutput = caseIndex * SIGMA_NATIVE_STITCH_CASE_STRIDE;
    if (threadIndex == 0u)
        _NativeStitchCaseResults[caseOutput] = uint4(resolution,
            SigmaNativeStitchComponentCount, nodeCount,
            SigmaNativeStitchComponentRootMask);

    if (threadIndex < SIGMA_NATIVE_STITCH_MAX_NODES)
    {
        bool root = threadIndex < nodeCount &&
            SigmaNativeStitchLabels[threadIndex] == threadIndex;
        _NativeStitchCaseResults[caseOutput +
            SIGMA_NATIVE_STITCH_COMPONENT_RECEIPT_OFFSET + threadIndex] = root
            ? uint4(threadIndex,
                SigmaNativeStitchComponentMembers[threadIndex],
                SigmaNativeStitchComponentValidAssignments[threadIndex],
                SigmaNativeStitchComponentOrbitRepresentatives[threadIndex])
            : uint4(0xffffffffu, 0u, 0u, 0u);
    }

    // Emit every one of the 24 candidate assignments after component translation
    // normalization.  The harness groups the eight D4 images of each orbit and
    // must retain multiple non-gauge orbit byte classes as unresolved.
    if (threadIndex < SIGMA_NATIVE_STITCH_ASSIGNMENT_LANES)
    {
        uint assignmentIndex = threadIndex / SIGMA_NATIVE_STITCH_MAX_NODES;
        uint nodeIndex = threadIndex % SIGMA_NATIVE_STITCH_MAX_NODES;
        if (nodeIndex < nodeCount)
        {
            uint component = SigmaNativeStitchLabels[nodeIndex];
            uint valid = (SigmaNativeStitchComponentValidAssignments[component] &
                (1u << assignmentIndex)) != 0u ? 1u : 0u;
            uint anchor = nodeIndex;
            [unroll]
            for (uint peer = 0u; peer < SIGMA_NATIVE_STITCH_MAX_NODES; ++peer)
            {
                if (peer >= nodeCount || SigmaNativeStitchLabels[peer] !=
                        SigmaNativeStitchLabels[nodeIndex])
                    continue;
                uint peerLane = assignmentIndex *
                    SIGMA_NATIVE_STITCH_MAX_NODES + peer;
                uint anchorLevel = _NativeStitchNodeHeaders[
                    nodeOffset + anchor].y;
                uint peerLevel = _NativeStitchNodeHeaders[
                    nodeOffset + peer].y;
                uint anchorLane = assignmentIndex *
                    SIGMA_NATIVE_STITCH_MAX_NODES + anchor;
                if (SigmaNativeStitchCompareDyadicLower(
                        SigmaNativeStitchPositions[peerLane], peerLevel,
                        SigmaNativeStitchPositions[anchorLane],
                        anchorLevel) < 0)
                    anchor = peer;
            }
            uint level = _NativeStitchNodeHeaders[nodeOffset + nodeIndex].y;
            uint anchorLevel = _NativeStitchNodeHeaders[nodeOffset + anchor].y;
            uint anchorLane = assignmentIndex *
                SIGMA_NATIVE_STITCH_MAX_NODES + anchor;
            int2 translation = int2(
                SigmaNativeStitchFloorDyadic(
                    SigmaNativeStitchPositions[anchorLane].x, anchorLevel),
                SigmaNativeStitchFloorDyadic(
                    SigmaNativeStitchPositions[anchorLane].y, anchorLevel));
            int2 normalized = SigmaNativeStitchPositions[threadIndex] -
                (translation << level);
            uint tag = _NativeStitchNodeHeaders[nodeOffset + nodeIndex].z;
            _NativeStitchCaseResults[caseOutput +
                SIGMA_NATIVE_STITCH_CANDIDATE_OFFSET +
                assignmentIndex * SIGMA_NATIVE_STITCH_MAX_NODES + nodeIndex] =
                uint4(asuint(normalized.x), asuint(normalized.y), level,
                    valid != 0u ? tag : 0xffffffffu);
        }
    }
}
#endif

#if defined(SIGMA_NATIVE_ORACLE_REDUCE_ONLY)
uint2 SigmaNativeDivideExactDyadicMeasure(uint2 numerator, uint2 denominator,
    inout uint valid)
{
    bool positive = (denominator.y & 0x80000000u) == 0u &&
        any(denominator != 0u);
    bool oneBit = countbits(denominator.x) + countbits(denominator.y) == 1u;
    uint exponent = denominator.x != 0u
        ? (uint)firstbitlow(denominator.x)
        : 32u + (uint)firstbitlow(denominator.y);
    bool boundedMeasure = positive && oneBit && exponent <= 48u;
    valid &= boundedMeasure ? 1u : 0u;
    uint shift = boundedMeasure ? 48u - exponent : 0u;
    bool negative = (numerator.y & 0x80000000u) != 0u;
    uint2 magnitude = SigmaU64AbsSigned(numerator);
    uint2 signedLimit = negative ? uint2(0u, 0x80000000u) :
        uint2(0xffffffffu, 0x7fffffffu);
    uint2 permitted = SigmaNativeShiftRightInitialized(signedLimit, shift);
    valid &= !SigmaU64Less(permitted, magnitude) ? 1u : 0u;
    uint2 shifted = SigmaNativeShiftLeftInitialized(magnitude, shift);
    return negative ? SigmaU64NegateRaw(shifted) : shifted;
}
#endif
#if defined(SIGMA_NATIVE_ORACLE_SUPPORT_ONLY)
[numthreads(64, 1, 1)]
void SelectNativeQuerySupport(uint3 id : SV_DispatchThreadID)
{
    uint summaryIndex = id.x;
    if (summaryIndex >= _NativeSummaryCount)
        return;
    uint4 summary = _NativeSummaries[summaryIndex];
    uint flags = summary.y;
    bool allDefault = (flags & SIGMA_NATIVE_SUMMARY_ALL_DEFAULT) != 0u;
    bool boundaryClosed =
        (flags & SIGMA_NATIVE_SUMMARY_BOUNDARY_CLOSED) != 0u;
    bool fingerprintsMatch =
        (flags & (SIGMA_NATIVE_SUMMARY_PROGRAM_MATCH |
                  SIGMA_NATIVE_SUMMARY_GAUGE_MATCH)) ==
        (SIGMA_NATIVE_SUMMARY_PROGRAM_MATCH |
         SIGMA_NATIVE_SUMMARY_GAUGE_MATCH) &&
        (flags & SIGMA_NATIVE_SUMMARY_STALE) == 0u;
    bool omit = SigmaMerkabaCanOmitQueryRegion(allDefault, boundaryClosed,
        fingerprintsMatch);
    if (!omit)
    {
        uint outputIndex;
        InterlockedAdd(_NativeCounters[0], 1u, outputIndex);
        _NativeWorklist[outputIndex] = summary.x;
        if ((flags & SIGMA_NATIVE_SUMMARY_NONRESIDENT) != 0u)
            InterlockedAdd(_NativeCounters[1], 1u);
    }
}
#endif

#if defined(SIGMA_NATIVE_ORACLE_QUERY_MATH)
[numthreads(64, 1, 1)]
void EvaluateNativeQuery(uint3 id : SV_DispatchThreadID)
{
    uint localIndex = id.x;
    uint queryIndex = id.y;
    if (localIndex >= _NativeWorkCount || queryIndex >= _NativeQueryCount)
        return;
    uint workIndex = _NativeWorkOffset + localIndex;
    uint outputIndex = queryIndex * _NativeContributionStride + workIndex;
    uint sampleIndex = _NativeWorklist[workIndex];
    uint4 sample = _NativeSamples[sampleIndex];
    bool entryValid = _NativeEntryPointIndex < SIGMA_MERKABA_ENTRY_POINT_COUNT &&
        SIGMA_MERKABA_IR_ENTRY_POINTS[_NativeEntryPointIndex].x == 7;
    uint valid = entryValid ? 1u : 0u;
    uint2 order;
    uint2 optical[3];
    SigmaNativeEvaluateStateAtRows(sample.w, queryIndex * 16u, order, optical,
        valid);
    uint2 measure = _NativeMeasures[sampleIndex];
    bool active = valid != 0u && !SigmaNativeStateIsZero(sample.w) &&
        sample.z == _NativeQueryFootprints[queryIndex];
    _NativeContributionHeadersWrite[outputIndex] = uint4(sample.xy, sample.z,
        active ? 1u : 0u);
    _NativeContributionOrderMeasuresWrite[outputIndex] = uint4(order, measure);
    uint reducer = entryValid
        ? (uint)SIGMA_MERKABA_IR_ENTRY_POINTS[_NativeEntryPointIndex].z
        : 0xffffffffu;
    uint relationClass = (reducer == 0u || reducer == 4u) &&
            _NativeRelationResults[sampleIndex].w != 0u
        ? _NativeRelationResults[sampleIndex].x
        : SIGMA_MERKABA_RELATION_UNRESOLVED;
    _NativeContributionRelationsWrite[outputIndex] = relationClass;
    [unroll]
    for (uint channel = 0u; channel < SIGMA_NATIVE_OPTICAL_CHANNELS; ++channel)
    {
        uint2 weighted = SigmaQ48MulNearestEven(optical[channel], measure, valid);
        _NativeContributionOpticalWrite[outputIndex *
            SIGMA_NATIVE_OPTICAL_CHANNELS + channel] = weighted;
    }
    if (valid == 0u)
        _NativeContributionHeadersWrite[outputIndex].w = 0u;
}
#endif

#if defined(SIGMA_NATIVE_ORACLE_REDUCE_ONLY)
[numthreads(128, 1, 1)]
void ReduceNativeQuery(uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint threadIndex = groupThreadId.x;
    uint queryIndex = groupId.y;
    if (queryIndex >= _NativeQueryCount)
        return;
    uint reducer = _NativeEntryPointIndex < SIGMA_MERKABA_ENTRY_POINT_COUNT
        ? (uint)SIGMA_MERKABA_IR_ENTRY_POINTS[_NativeEntryPointIndex].z
        : 0xffffffffu;
    bool reducerValid = reducer == 1u || reducer == 4u ||
        (reducer == 0u && _NativeDebugRequest == 1u);
    uint recordOffset = queryIndex * SIGMA_NATIVE_REDUCED_RECORD_STRIDE;
    bool overflow = _NativeContributionCount > SIGMA_NATIVE_REDUCE_WIDTH;
    if (overflow)
    {
        if (threadIndex == 0u)
        {
            _NativeReduceOverflowRecords[queryIndex] = uint4(
                _NativeContributionCount, SIGMA_NATIVE_REDUCE_WIDTH,
                SIGMA_NATIVE_REDUCE_COLD_CONTINUATION_REQUIRED, 1u);
            _NativeReducedRecords[recordOffset] = uint4(0u, 0u, 0u,
                2u | (reducer << 8u));
            _NativeReducedRecords[recordOffset + 5u] = uint4(0u, 1u,
                SIGMA_NATIVE_REDUCE_COLD_CONTINUATION_REQUIRED, 0u);
        }
        return;
    }
    if (threadIndex == 0u)
        _NativeReduceOverflowRecords[queryIndex] = uint4(0u, 0u, 0u, 0u);
    uint inputBase = queryIndex * _NativeContributionStride;
    uint supportBase = queryIndex * _NativeContributionStride * 2u;
    uint relationBase = queryIndex * _NativeContributionStride;
    uint footprint = _NativeQueryFootprints[queryIndex];
    bool present = threadIndex < _NativeContributionCount;
    uint inputIndex = inputBase + threadIndex;
    uint4 header = present ? _NativeContributionHeaders[inputIndex]
        : uint4(0xffffffffu, 0xffffffffu, 0xffffffffu, 0u);
    bool active = present && header.w != 0u && header.z == footprint;
    header.w = active ? 1u : 0u;
    SigmaNativeReduceHeaders[threadIndex] = header;
    SigmaNativeReduceOrderMeasures[threadIndex] = present
        ? _NativeContributionOrderMeasures[inputIndex]
        : uint4(0u, 0u, 0u, 0u);
    SigmaNativeReduceRelations[threadIndex] = present
        ? _NativeContributionRelations[inputIndex]
        : SIGMA_MERKABA_RELATION_UNRESOLVED;
    [unroll]
    for (uint loadChannel = 0u;
        loadChannel < SIGMA_NATIVE_OPTICAL_CHANNELS; ++loadChannel)
    {
        SigmaNativeReduceOptical[threadIndex * SIGMA_NATIVE_OPTICAL_CHANNELS +
            loadChannel] = present
            ? _NativeContributionOptical[inputIndex *
                SIGMA_NATIVE_OPTICAL_CHANNELS + loadChannel]
            : uint2(0u, 0u);
    }
    SigmaNativeReduceSources[threadIndex] = threadIndex;
    GroupMemoryBarrierWithGroupSync();

    // One fixed bitonic network groups the complete 64-bit support identity.
    // Support cardinality changes data inside this workgroup, never dispatch count.
    [unroll]
    for (uint span = 2u; span <= SIGMA_NATIVE_REDUCE_WIDTH; span <<= 1u)
    {
        [unroll]
        for (uint stride = span >> 1u; stride != 0u; stride >>= 1u)
        {
            uint partner = threadIndex ^ stride;
            uint4 selfHeader = SigmaNativeReduceHeaders[threadIndex];
            uint4 partnerHeader = SigmaNativeReduceHeaders[partner];
            uint selfSource = SigmaNativeReduceSources[threadIndex];
            uint partnerSource = SigmaNativeReduceSources[partner];
            bool ascending = (threadIndex & span) == 0u;
            bool lowerLane = threadIndex < partner;
            bool wantMinimum = ascending == lowerLane;
            bool partnerLess = SigmaNativeReduceItemLess(
                partnerHeader, partnerSource, selfHeader, selfSource);
            bool selfLess = SigmaNativeReduceItemLess(
                selfHeader, selfSource, partnerHeader, partnerSource);
            bool takePartner = wantMinimum ? partnerLess : selfLess;
            uint4 selectedHeader = takePartner ? partnerHeader : selfHeader;
            uint4 selectedOrder = takePartner
                ? SigmaNativeReduceOrderMeasures[partner]
                : SigmaNativeReduceOrderMeasures[threadIndex];
            uint selectedSource = takePartner ? partnerSource : selfSource;
            uint selectedRelation = takePartner
                ? SigmaNativeReduceRelations[partner]
                : SigmaNativeReduceRelations[threadIndex];
            uint2 selectedOptical[3];
            [unroll]
            for (uint sortChannel = 0u;
                sortChannel < SIGMA_NATIVE_OPTICAL_CHANNELS; ++sortChannel)
                selectedOptical[sortChannel] = SigmaNativeReduceOptical[
                    (takePartner ? partner : threadIndex) *
                        SIGMA_NATIVE_OPTICAL_CHANNELS + sortChannel];
            GroupMemoryBarrierWithGroupSync();
            SigmaNativeReduceHeaders[threadIndex] = selectedHeader;
            SigmaNativeReduceOrderMeasures[threadIndex] = selectedOrder;
            SigmaNativeReduceSources[threadIndex] = selectedSource;
            SigmaNativeReduceRelations[threadIndex] = selectedRelation;
            [unroll]
            for (uint storeChannel = 0u;
                storeChannel < SIGMA_NATIVE_OPTICAL_CHANNELS; ++storeChannel)
                SigmaNativeReduceOptical[threadIndex *
                    SIGMA_NATIVE_OPTICAL_CHANNELS + storeChannel] =
                    selectedOptical[storeChannel];
            GroupMemoryBarrierWithGroupSync();
        }
    }

    bool sortedActive = SigmaNativeReduceHeaders[threadIndex].w != 0u;
    uint4 sourceOrderMeasure = SigmaNativeReduceOrderMeasures[threadIndex];
    SigmaNativeReduceGroupOrders[threadIndex] = sortedActive
        ? uint4(sourceOrderMeasure.xy, sourceOrderMeasure.xy)
        : uint4(0xffffffffu, 0x7fffffffu, 0u, 0x80000000u);
    SigmaNativeReduceValid[threadIndex] = 1u;
    GroupMemoryBarrierWithGroupSync();

    // Inclusive segmented scans aggregate every refined child in parallel.
    // No support lane serially traverses the contribution universe.
    [unroll]
    for (uint segmentStride = 1u;
        segmentStride < SIGMA_NATIVE_REDUCE_WIDTH; segmentStride <<= 1u)
    {
        uint4 combinedOrder = SigmaNativeReduceGroupOrders[threadIndex];
        uint2 combinedMeasure = SigmaNativeReduceOrderMeasures[threadIndex].zw;
        uint combinedValid = SigmaNativeReduceValid[threadIndex];
        uint combinedRelation = SigmaNativeReduceRelations[threadIndex];
        uint2 combinedOptical[3];
        [unroll]
        for (uint copyChannel = 0u;
            copyChannel < SIGMA_NATIVE_OPTICAL_CHANNELS; ++copyChannel)
            combinedOptical[copyChannel] = SigmaNativeReduceOptical[threadIndex *
                SIGMA_NATIVE_OPTICAL_CHANNELS + copyChannel];

        bool combine = threadIndex >= segmentStride && sortedActive &&
            SigmaNativeReduceHeaders[threadIndex - segmentStride].w != 0u &&
            SigmaNativeKeyEqual(SigmaNativeReduceHeaders[threadIndex].xy,
                SigmaNativeReduceHeaders[threadIndex - segmentStride].xy);
        if (combine)
        {
            uint partner = threadIndex - segmentStride;
            uint4 partnerOrder = SigmaNativeReduceGroupOrders[partner];
            combinedOrder.xy = SigmaQ48Min(combinedOrder.xy, partnerOrder.xy);
            combinedOrder.zw = SigmaQ48Max(combinedOrder.zw, partnerOrder.zw);
            combinedMeasure = SigmaQ48AddChecked(combinedMeasure,
                SigmaNativeReduceOrderMeasures[partner].zw, combinedValid);
            combinedValid &= SigmaNativeReduceValid[partner];
            if (combinedRelation != SigmaNativeReduceRelations[partner])
                combinedRelation = SIGMA_MERKABA_RELATION_UNRESOLVED;
            [unroll]
            for (uint segmentChannel = 0u;
                segmentChannel < SIGMA_NATIVE_OPTICAL_CHANNELS; ++segmentChannel)
                combinedOptical[segmentChannel] = SigmaQ48AddChecked(
                    combinedOptical[segmentChannel], SigmaNativeReduceOptical[
                        partner * SIGMA_NATIVE_OPTICAL_CHANNELS + segmentChannel],
                    combinedValid);
        }
        GroupMemoryBarrierWithGroupSync();
        SigmaNativeReduceGroupOrders[threadIndex] = combinedOrder;
        SigmaNativeReduceOrderMeasures[threadIndex].zw = combinedMeasure;
        SigmaNativeReduceValid[threadIndex] = combinedValid;
        SigmaNativeReduceRelations[threadIndex] = combinedRelation;
        [unroll]
        for (uint writeChannel = 0u;
            writeChannel < SIGMA_NATIVE_OPTICAL_CHANNELS; ++writeChannel)
            SigmaNativeReduceOptical[threadIndex * SIGMA_NATIVE_OPTICAL_CHANNELS +
                writeChannel] = combinedOptical[writeChannel];
        GroupMemoryBarrierWithGroupSync();
    }

    bool nextDiffers = true;
    if (threadIndex + 1u < SIGMA_NATIVE_REDUCE_WIDTH)
        nextDiffers = SigmaNativeReduceHeaders[threadIndex + 1u].w == 0u ||
            !SigmaNativeKeyEqual(SigmaNativeReduceHeaders[threadIndex].xy,
                SigmaNativeReduceHeaders[threadIndex + 1u].xy);
    bool groupEnd = sortedActive && nextDiffers;
    SigmaNativeReducePrefix[threadIndex] = groupEnd ? 1u : 0u;
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint prefixStride = 1u; prefixStride < SIGMA_NATIVE_REDUCE_WIDTH;
        prefixStride <<= 1u)
    {
        uint add = threadIndex >= prefixStride
            ? SigmaNativeReducePrefix[threadIndex - prefixStride] : 0u;
        GroupMemoryBarrierWithGroupSync();
        SigmaNativeReducePrefix[threadIndex] += add;
        GroupMemoryBarrierWithGroupSync();
    }
    uint groupCount = SigmaNativeReducePrefix[SIGMA_NATIVE_REDUCE_WIDTH - 1u];
    uint groupIndex = groupEnd ? SigmaNativeReducePrefix[threadIndex] - 1u : 0u;
    uint2 completedKey = SigmaNativeReduceHeaders[threadIndex].xy;
    uint4 completedOrder = SigmaNativeReduceGroupOrders[threadIndex];
    uint2 completedMeasure = SigmaNativeReduceOrderMeasures[threadIndex].zw;
    uint completedValid = SigmaNativeReduceValid[threadIndex];
    uint completedRelation = SigmaNativeReduceRelations[threadIndex];
    uint2 completedOptical[3];
    [unroll]
    for (uint captureChannel = 0u;
        captureChannel < SIGMA_NATIVE_OPTICAL_CHANNELS; ++captureChannel)
        completedOptical[captureChannel] = SigmaNativeReduceOptical[threadIndex *
            SIGMA_NATIVE_OPTICAL_CHANNELS + captureChannel];
    GroupMemoryBarrierWithGroupSync();

    if (groupEnd)
    {
        SigmaNativeReduceGroupKeys[groupIndex] = completedKey;
        SigmaNativeReduceGroupOrders[groupIndex] = completedOrder;
        SigmaNativeReduceRelations[groupIndex] = completedRelation;
        [unroll]
        for (uint reduceChannel = 0u;
            reduceChannel < SIGMA_NATIVE_OPTICAL_CHANNELS; ++reduceChannel)
        {
            uint2 lower = SigmaNativeDivideExactDyadicMeasure(
                completedOptical[reduceChannel], completedMeasure, completedValid);
            uint offset = (groupIndex * SIGMA_NATIVE_OPTICAL_CHANNELS +
                reduceChannel) * 2u;
            SigmaNativeReduceGroupOptical[offset] = lower;
            SigmaNativeReduceGroupOptical[offset + 1u] = lower;
        }
        SigmaNativeReduceValid[groupIndex] = completedValid;
    }
    GroupMemoryBarrierWithGroupSync();

    // Reducer 1 first-hit is equivalent to comparing every support lower bound
    // against the global minimum support upper bound. Compute that bound once in
    // a fixed parallel tree instead of an O(supports^2) serial scan.
    SigmaNativeReduceOrderMeasures[threadIndex] = threadIndex < groupCount
        ? uint4(SigmaNativeReduceGroupOrders[threadIndex].zw, 0u, 0u)
        : uint4(0xffffffffu, 0x7fffffffu, 0u, 0u);
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint minimumStride = SIGMA_NATIVE_REDUCE_WIDTH >> 1u;
        minimumStride != 0u; minimumStride >>= 1u)
    {
        if (threadIndex < minimumStride)
            SigmaNativeReduceOrderMeasures[threadIndex].xy = SigmaQ48Min(
                SigmaNativeReduceOrderMeasures[threadIndex].xy,
                SigmaNativeReduceOrderMeasures[threadIndex + minimumStride].xy);
        GroupMemoryBarrierWithGroupSync();
    }
    uint2 minimumUpper = SigmaNativeReduceOrderMeasures[0].xy;
    bool first = threadIndex < groupCount &&
        (reducer == 4u || (reducer == 1u &&
            !SigmaI64Less(minimumUpper,
                SigmaNativeReduceGroupOrders[threadIndex].xy)));
    SigmaNativeReduceFirst[threadIndex] = first ? 1u : 0u;
    SigmaNativeReducePrefix[threadIndex] = first ? 1u : 0u;
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint firstStride = 1u; firstStride < SIGMA_NATIVE_REDUCE_WIDTH;
        firstStride <<= 1u)
    {
        uint add = threadIndex >= firstStride
            ? SigmaNativeReducePrefix[threadIndex - firstStride] : 0u;
        GroupMemoryBarrierWithGroupSync();
        SigmaNativeReducePrefix[threadIndex] += add;
        GroupMemoryBarrierWithGroupSync();
    }
    uint firstCount = SigmaNativeReducePrefix[SIGMA_NATIVE_REDUCE_WIDTH - 1u];
    uint behindCount = reducer == 1u ? groupCount - firstCount : 0u;
    if (threadIndex < groupCount)
    {
        uint firstBefore = threadIndex == 0u
            ? 0u : SigmaNativeReducePrefix[threadIndex - 1u];
        if (first)
            _NativeReducedSupports[supportBase + firstBefore] =
                SigmaNativeReduceGroupKeys[threadIndex];
        else if (reducer == 1u)
            _NativeReducedSupports[supportBase + _NativeContributionStride +
                threadIndex - firstBefore] =
                SigmaNativeReduceGroupKeys[threadIndex];
    }

    uint relationClass = threadIndex < groupCount
        ? SigmaNativeReduceRelations[threadIndex]
        : SIGMA_MERKABA_RELATION_UNRESOLVED;
    bool permitsRelation = relationClass == SIGMA_MERKABA_RELATION_DEFAULT_SAT ||
        relationClass == SIGMA_MERKABA_RELATION_REGULAR ||
        relationClass == SIGMA_MERKABA_RELATION_EXACT_ZD ||
        relationClass == SIGMA_MERKABA_RELATION_NEAR_SINGULAR_Q48;
    bool relationSelected = threadIndex < groupCount &&
        (reducer == 0u || (reducer == 4u && permitsRelation));
    SigmaNativeReducePrefix[threadIndex] = relationSelected ? 1u : 0u;
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint relationStride = 1u;
        relationStride < SIGMA_NATIVE_REDUCE_WIDTH; relationStride <<= 1u)
    {
        uint add = threadIndex >= relationStride
            ? SigmaNativeReducePrefix[threadIndex - relationStride] : 0u;
        GroupMemoryBarrierWithGroupSync();
        SigmaNativeReducePrefix[threadIndex] += add;
        GroupMemoryBarrierWithGroupSync();
    }
    if (threadIndex == 0u)
        SigmaNativeReduceRelationCount = SigmaNativeReducePrefix[
            SIGMA_NATIVE_REDUCE_WIDTH - 1u];
    GroupMemoryBarrierWithGroupSync();
    uint relationCount = SigmaNativeReduceRelationCount;
    if (relationSelected)
    {
        uint relationIndex = SigmaNativeReducePrefix[threadIndex] - 1u;
        _NativeReducedRelationSupports[relationBase + relationIndex] =
            SigmaNativeReduceGroupKeys[threadIndex];
        _NativeReducedRelationClasses[relationBase + relationIndex] =
            relationClass;
    }

    uint4 groupOrder = threadIndex < groupCount && first
        ? SigmaNativeReduceGroupOrders[threadIndex]
        : uint4(0xffffffffu, 0x7fffffffu, 0u, 0x80000000u);
    SigmaNativeReduceGroupOrders[threadIndex] = groupOrder;
    [unroll]
    for (uint resultChannel = 0u;
        resultChannel < SIGMA_NATIVE_OPTICAL_CHANNELS; ++resultChannel)
    {
        uint sourceOffset = (threadIndex * SIGMA_NATIVE_OPTICAL_CHANNELS +
            resultChannel) * 2u;
        SigmaNativeReduceGroupOptical[sourceOffset] =
            threadIndex < groupCount && first
                ? SigmaNativeReduceGroupOptical[sourceOffset]
                : uint2(0xffffffffu, 0x7fffffffu);
        SigmaNativeReduceGroupOptical[sourceOffset + 1u] =
            threadIndex < groupCount && first
                ? SigmaNativeReduceGroupOptical[sourceOffset + 1u]
                : uint2(0u, 0x80000000u);
    }
    SigmaNativeReduceValid[threadIndex] = threadIndex < groupCount
        ? SigmaNativeReduceValid[threadIndex] : 1u;
    SigmaNativeReducePrefix[threadIndex] = sortedActive ? 1u : 0u;
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint reduceStride = SIGMA_NATIVE_REDUCE_WIDTH >> 1u;
        reduceStride != 0u; reduceStride >>= 1u)
    {
        if (threadIndex < reduceStride)
        {
            uint partner = threadIndex + reduceStride;
            SigmaNativeReduceGroupOrders[threadIndex].xy = SigmaQ48Min(
                SigmaNativeReduceGroupOrders[threadIndex].xy,
                SigmaNativeReduceGroupOrders[partner].xy);
            SigmaNativeReduceGroupOrders[threadIndex].zw = SigmaQ48Max(
                SigmaNativeReduceGroupOrders[threadIndex].zw,
                SigmaNativeReduceGroupOrders[partner].zw);
            [unroll]
            for (uint hullChannel = 0u;
                hullChannel < SIGMA_NATIVE_OPTICAL_CHANNELS; ++hullChannel)
            {
                uint destination = (threadIndex *
                    SIGMA_NATIVE_OPTICAL_CHANNELS + hullChannel) * 2u;
                uint source = (partner * SIGMA_NATIVE_OPTICAL_CHANNELS +
                    hullChannel) * 2u;
                SigmaNativeReduceGroupOptical[destination] = SigmaQ48Min(
                    SigmaNativeReduceGroupOptical[destination],
                    SigmaNativeReduceGroupOptical[source]);
                SigmaNativeReduceGroupOptical[destination + 1u] = SigmaQ48Max(
                    SigmaNativeReduceGroupOptical[destination + 1u],
                    SigmaNativeReduceGroupOptical[source + 1u]);
            }
            SigmaNativeReduceValid[threadIndex] &=
                SigmaNativeReduceValid[partner];
            SigmaNativeReducePrefix[threadIndex] +=
                SigmaNativeReducePrefix[partner];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if (threadIndex == 0u)
    {
        uint activeContributionCount = SigmaNativeReducePrefix[0];
        bool validResult = reducerValid && groupCount != 0u &&
            SigmaNativeReduceValid[0] != 0u;
        _NativeReducedRecords[recordOffset] = uint4(firstCount, behindCount,
            groupCount,
            (validResult ? 1u : 0u) | (reducer << 8u) |
            (activeContributionCount << 16u));
        _NativeReducedRecords[recordOffset + 1u] = validResult && reducer != 0u
            ? SigmaNativeReduceGroupOrders[0]
            : uint4(1u, 0u, 0u, 0u);
        [unroll]
        for (uint outputChannel = 0u;
            outputChannel < SIGMA_NATIVE_OPTICAL_CHANNELS; ++outputChannel)
        {
            uint offset = outputChannel * 2u;
            _NativeReducedRecords[recordOffset + 2u + outputChannel] =
                validResult && reducer != 0u
                ? uint4(SigmaNativeReduceGroupOptical[offset],
                    SigmaNativeReduceGroupOptical[offset + 1u])
                : uint4(1u, 0u, 0u, 0u);
        }
        _NativeReducedRecords[recordOffset + 5u] = uint4(relationCount, 0u,
            0u, queryIndex);
    }
}
#endif

#if defined(SIGMA_NATIVE_ORACLE_RELATION_MATH)
[numthreads(256, 1, 1)]
void EvaluateNativeRelation(uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint index = groupId.x;
    if (index >= _NativeRelationCount)
        return;
    bool entryValid = _NativeEntryPointIndex < SIGMA_MERKABA_ENTRY_POINT_COUNT &&
        SIGMA_MERKABA_IR_ENTRY_POINTS[_NativeEntryPointIndex].x == 3 &&
        SIGMA_MERKABA_IR_ENTRY_POINTS[_NativeEntryPointIndex].z == 3;
    SigmaNativeEvaluateRelationGroup(index, groupThreadId.x, entryValid);
}
#endif
