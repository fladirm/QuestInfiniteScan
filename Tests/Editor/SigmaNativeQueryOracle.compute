// Disposable N2 whole-query oracle. Live player builds retain only the\n// hyperdimensional native-relation kernel.\n// N3R live native query lowering. It owns no canonical field or publication path.
#pragma kernel SelectNativeQuerySupport SIGMA_NATIVE_ORACLE_SUPPORT_ONLY
#pragma kernel EvaluateNativeQuery SIGMA_NATIVE_ORACLE_QUERY_MATH
#pragma kernel ReduceNativeQuery SIGMA_NATIVE_ORACLE_REDUCE_ONLY
#pragma kernel EvaluateNativeRelation SIGMA_NATIVE_ORACLE_RELATION_MATH
#pragma kernel EvaluateNativeStitchPairs SIGMA_NATIVE_ORACLE_RELATION_MATH SIGMA_NATIVE_STITCH_PAIR
#pragma kernel CloseNativeStitchCases SIGMA_NATIVE_STITCH_CLOSE
#pragma target 5.0

#include "Generated/SigmaGeneratedMerkabaProgram.hlsl"

