#pragma kernel ValidateFrameAbi
#pragma target 5.0

#include "../../Runtime/Resources/SigmaPrism/SigmaFrameAbi.hlsl"

RWStructuredBuffer<SigmaOwnedFrameGpu> _OwnedFrames;
RWStructuredBuffer<SigmaFrameCandidateGpu> _Candidates;
RWStructuredBuffer<SigmaFrameOutcomeGpu> _Outcomes;
RWStructuredBuffer<SigmaPendingGaugeGpu> _PendingGauges;
RWStructuredBuffer<SigmaFrameDeltaGpu> _Deltas;
RWStructuredBuffer<SigmaDirtyEdgeGpu> _DirtyEdges;
RWStructuredBuffer<SigmaFrameRevisionGpu> _Revisions;
RWStructuredBuffer<uint4> _Result;

[numthreads(1, 1, 1)]
void ValidateFrameAbi(uint3 id : SV_DispatchThreadID)
{
    SigmaOwnedFrameGpu frame;
    frame.Identity = uint4(1u, 2u, 3u, 4u);
    frame.Keys = uint4(5u, 6u, 7u, 8u);
    frame.PoseSource = uint4(9u, 10u, SIGMA_OWNED_FRAME_STATE_SEALED, 12u);
    _OwnedFrames[0] = frame;

    SigmaFrameCandidateGpu candidate;
    candidate.Identity = uint4(13u, SIGMA_FRAME_PROPOSAL_KIND_NOVEL,
        SIGMA_FRAME_TARGET_KIND_PENDING, 16u);
    candidate.Handle = uint4(17u, 18u, 19u, 20u);
    candidate.Coordinate = uint4(21u, 22u, 23u, 24u);
    _Candidates[0] = candidate;

    SigmaFrameOutcomeGpu outcome;
    outcome.Classification = uint4(SIGMA_FRAME_OUTCOME_ACCEPTED, 26u, 27u, 28u);
    outcome.Evidence = uint4(29u, 30u, 31u, 32u);
    _Outcomes[0] = outcome;

    SigmaPendingGaugeGpu pending;
    pending.Identity = uint4(33u, 34u, SIGMA_PENDING_GAUGE_STATE_OPEN, 36u);
    pending.Provenance = uint4(37u, 38u, 39u, 40u);
    pending.LocalExtent = uint4(41u, 42u, 43u, 44u);
    _PendingGauges[0] = pending;

    SigmaFrameDeltaGpu delta;
    delta.Coordinate = uint4(45u, 46u, 47u, 48u);
    delta.Candidate = uint4(49u, 50u, 51u, 52u);
    delta.Evidence = uint4(53u, 54u, 55u, 56u);
    _Deltas[0] = delta;

    SigmaDirtyEdgeGpu edge;
    edge.Left = uint4(57u, 58u, 59u, 60u);
    edge.Right = uint4(61u, 62u, 63u, 64u);
    edge.Closure = uint4(65u, 66u, SIGMA_FRAME_CLAIM_KIND_CONTACT, 68u);
    _DirtyEdges[0] = edge;

    SigmaFrameRevisionGpu revision;
    revision.Identity = uint4(69u, 70u, SIGMA_FRAME_REVISION_STATE_BUILDING, 72u);
    revision.ChangedPages = uint4(73u, 74u, 75u, 76u);
    revision.WitnessJournal = uint4(77u, 78u, 79u, 80u);
    _Revisions[0] = revision;

    _Result[0] = uint4(frame.Identity.x, candidate.Coordinate.w,
        edge.Closure.z, revision.WitnessJournal.w);
}
