#pragma kernel VerifySphereFlowerDataAbi

#include "../../Runtime/Shaders/MerkabaSphereFlower.generated.hlsl"

StructuredBuffer<M8DualBlockMeta> _DualBlock;
StructuredBuffer<M8DualBlockChildren> _DualChildren;
StructuredBuffer<M8DualChunkPayload> _DualChunk;
StructuredBuffer<M8DualLeaf> _DualLeaf;
StructuredBuffer<M8FlowerOwnerEpoch> _OwnerEpoch;
StructuredBuffer<M8FlowerDetailRecord> _FlowerDetail;
StructuredBuffer<M8FlowerSkinMetricRun> _MetricRun;
StructuredBuffer<M8FlowerVGroup> _VGroup;
StructuredBuffer<M8ThreadRun> _ThreadRun;
StructuredBuffer<M8ThreadColorGroup> _ColorGroup;
StructuredBuffer<M8ThreadProgramRecord> _ThreadProgram;
StructuredBuffer<M8FlowerSymbolKey> _FlowerSymbol;
StructuredBuffer<M8ObservationRecord> _Observation;
RWStructuredBuffer<uint> _DataAbiOutput;

[numthreads(1, 1, 1)]
void VerifySphereFlowerDataAbi(uint3 id : SV_DispatchThreadID)
{
    M8DualBlockMeta block = _DualBlock[0];
    _DataAbiOutput[0] = block.StateAndGeneration;
    _DataAbiOutput[1] = block.PayloadIndex;
    _DataAbiOutput[2] = _DualChildren[0].Word00;
    _DataAbiOutput[3] = _DualChildren[0].Word31;
    M8DualChunkPayload chunk = _DualChunk[0];
    _DataAbiOutput[4] = chunk.NonFullMaskLo;
    _DataAbiOutput[5] = chunk.NonFullMaskHi;
    _DataAbiOutput[6] = chunk.MixedMaskLo;
    _DataAbiOutput[7] = chunk.MixedMaskHi;
    _DataAbiOutput[8] = chunk.LeafRefBase;
    _DataAbiOutput[9] = chunk.Generation;
    _DataAbiOutput[10] = _DualLeaf[0].Word00;
    _DataAbiOutput[11] = _DualLeaf[0].Word15;
    _DataAbiOutput[12] = _OwnerEpoch[0].KernelLocal;
    _DataAbiOutput[13] = _OwnerEpoch[0].Epoch;
    M8FlowerDetailRecord detail = _FlowerDetail[0];
    _DataAbiOutput[14] = detail.Key;
    _DataAbiOutput[15] = asuint(detail.Lower);
    _DataAbiOutput[16] = asuint(detail.Upper);
    _DataAbiOutput[17] = detail.ParentEpoch;

    M8FlowerSkinMetricRun metric = _MetricRun[0];
    _DataAbiOutput[18] = metric.FlowerKey;
    _DataAbiOutput[19] = metric.GroupBase;
    _DataAbiOutput[20] = metric.SplitBitsLo;
    _DataAbiOutput[21] = metric.SplitBitsHi;
    _DataAbiOutput[22] = metric.ParentEpoch;
    _DataAbiOutput[23] = metric.Reserved;
    M8FlowerVGroup vg = _VGroup[0];
    _DataAbiOutput[24] = asuint(vg.Child[0].Lower);
    _DataAbiOutput[25] = asuint(vg.Child[0].Upper);
    _DataAbiOutput[26] = asuint(vg.Child[6].Lower);
    _DataAbiOutput[27] = asuint(vg.Child[6].Upper);

    M8ThreadRun run = _ThreadRun[0];
    _DataAbiOutput[28] = run.FlowerKey;
    _DataAbiOutput[29] = run.ProgramRef;
    _DataAbiOutput[30] = run.GroupBase;
    _DataAbiOutput[31] = run.SplitBitsLo;
    _DataAbiOutput[32] = run.SplitBitsHi;
    _DataAbiOutput[33] = run.ParentEpoch;
    M8ThreadColorGroup cg = _ColorGroup[0];
    _DataAbiOutput[34] = cg.Child[0].LowerLinearRgba.x;
    _DataAbiOutput[35] = cg.Child[0].LowerLinearRgba.y;
    _DataAbiOutput[36] = cg.Child[0].UpperLinearRgba.x;
    _DataAbiOutput[37] = cg.Child[0].UpperLinearRgba.y;
    _DataAbiOutput[38] = cg.Child[6].LowerLinearRgba.x;
    _DataAbiOutput[39] = cg.Child[6].LowerLinearRgba.y;
    _DataAbiOutput[40] = cg.Child[6].UpperLinearRgba.x;
    _DataAbiOutput[41] = cg.Child[6].UpperLinearRgba.y;

    M8ThreadProgramRecord program = _ThreadProgram[0];
    _DataAbiOutput[42] = program.Flags;
    _DataAbiOutput[43] = program.Reserved0;
    _DataAbiOutput[44] = program.Reserved1;
    _DataAbiOutput[45] = program.Reserved2;
    _DataAbiOutput[46] = program.OpticalLower.x;
    _DataAbiOutput[47] = program.OpticalUpper.y;
    _DataAbiOutput[48] = program.CaptureViewLower.x;
    _DataAbiOutput[49] = program.CaptureViewUpper.y;

    M8FlowerSymbolKey symbol = _FlowerSymbol[0];
    _DataAbiOutput[50] = asuint(symbol.Junction.x);
    _DataAbiOutput[51] = asuint(symbol.Junction.z);
    _DataAbiOutput[52] = symbol.Tag;
    _DataAbiOutput[53] = _Observation[0].PrecisionKey;
    _DataAbiOutput[54] = M8FlowerPackDetailKey(2u, 15u, 47u, 12u,
        2u, true, 1u);
    _DataAbiOutput[55] = M8FlowerPackL2Key(15u, 47u, true, 31u);
    _DataAbiOutput[56] = M8FlowerPackSymbolTag(5u, 12u, true, 1u, true,
        7u, 5u, 0xabcu);
    _DataAbiOutput[57] = M8_FLOWER_SKIN_SPLIT_HIGH_MASK;
}
