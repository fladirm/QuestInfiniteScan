#version 450
// FinalScan C01 overlap probe kernel: one bounded parallel transformation over a 1M-uint SSBO.
// Bounded loop (iterations clamped to 8192), no shared memory, no dynamic vector indexing.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) buffer Data { uint values[]; };
layout(push_constant) uniform Params { uint count; uint iterations; uint seed; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= count) return;
    uint iters = min(iterations, 8192u);
    uint x = values[i] ^ seed ^ i;
    for (uint k = 0u; k < iters; ++k) {
        x = x * 1664525u + 1013904223u;
        x ^= x >> 13;
    }
    values[i] = x;
}
