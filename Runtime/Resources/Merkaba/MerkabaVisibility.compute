#pragma kernel CullRenderTiles
#pragma kernel PrepareVisibleIndices
#pragma kernel EmitVisibleIndices

// Draw-only FRONT visibility. The native readout producer deliberately does
// not contain these kernels: the Android player may strip or renumber this
// asset independently without touching the fifteen-plus-two native stages
// ("Kernel at index 15/16/17 is invalid" can no longer name a producer).
#include "../../Shaders/MerkabaWorld.hlsl"

#define MERKABA_LATTICE_STEP 0.025
#define MERKABA_HALF_SUPPORT 0.025
#define M8_CULL_GROUP_THREADS 128u
#define M8_EMIT_GROUP_THREADS 64u

StructuredBuffer<uint> _M8RenderIndexFrontRead;
RWStructuredBuffer<uint> _M8RenderPageQueues;
StructuredBuffer<uint> _M8RenderIndicesRead;
RWStructuredBuffer<uint4> _M8VisiblePages;
StructuredBuffer<uint4> _M8VisiblePagesRead;
RWStructuredBuffer<uint> _M8CullControl;
StructuredBuffer<uint> _M8CullControlRead;
RWStructuredBuffer<uint> _M8RenderDrawArgs;
RWByteAddressBuffer _M8VisibleIndices;

float3 _M8CameraGridMeters;
float3 _M8GridMetricDiagonal;
float3 _M8GridMetricCross;
float _M8RenderDistance;
float4 _M8CullGridPlanes[12];

uint M8FrontTileCount()
{
    return min(_M8RenderIndexFrontRead[0],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
}

uint M8FrontListBase()
{
    return M8_RENDER_TILE_LIST_BASE +
        (_M8RenderIndexFrontRead[M8_RENDER_HEADER_LIST_REGION] & 1u) *
        M8_RENDER_TILE_LIST_REGION_WORDS;
}

uint M8RecordBase(uint physicalSlot)
{
    return M8_RENDER_INDEX_HEADER + physicalSlot * M8_RENDER_RECORD_WORDS;
}

bool M8AabbIntersectsDistance(int3 globalMin, int span, float distance)
{
    return MerkabaM8GridAabbIntersectsDistance(globalMin, span, distance,
        _M8CameraGridMeters, _M8GridMetricDiagonal, _M8GridMetricCross,
        MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
}

bool M8SphereOutsideFrustum(float3 center, float radius, uint planeBase)
{
    float4 center4 = float4(center, 1.0);
    return dot(_M8CullGridPlanes[planeBase + 0u], center4) < -radius ||
        dot(_M8CullGridPlanes[planeBase + 1u], center4) < -radius ||
        dot(_M8CullGridPlanes[planeBase + 2u], center4) < -radius ||
        dot(_M8CullGridPlanes[planeBase + 3u], center4) < -radius ||
        dot(_M8CullGridPlanes[planeBase + 4u], center4) < -radius ||
        dot(_M8CullGridPlanes[planeBase + 5u], center4) < -radius;
}

groupshared uint gM8CullPages[M8_CULL_GROUP_THREADS];
groupshared uint gM8CullPrefix[M8_CULL_GROUP_THREADS];
groupshared uint gM8CullBase;

// Cull control while culling: 0 visible pages, 1 exact index count,
// 2 overflow flag. PrepareVisibleIndices turns it into the emit dispatch.
[numthreads(128, 1, 1)]
void CullRenderTiles(uint3 groupId : SV_GroupID,
    uint lane : SV_GroupIndex)
{
    uint listIndex = groupId.x * M8_CULL_GROUP_THREADS + lane;
    uint base = 0u;
    uint indexCount = 0u;
    uint pages = 0u;
    if (listIndex < M8FrontTileCount())
    {
        uint slot = _M8RenderIndexFrontRead[M8FrontListBase() + listIndex];
        base = M8RecordBase(slot);
        int3 origin = int3(asint(_M8RenderIndexFrontRead[base + 3u]),
            asint(_M8RenderIndexFrontRead[base + 4u]),
            asint(_M8RenderIndexFrontRead[base + 5u]));
        // Patches of a tile stay within its kernels plus one lattice step.
        float3 minimum = ((float3)origin - 1.0) * MERKABA_LATTICE_STEP;
        float3 center = minimum + 5.0 * MERKABA_LATTICE_STEP;
        float radius = sqrt(3.0) * 5.0 * MERKABA_LATTICE_STEP;
        bool visible = M8AabbIntersectsDistance(origin - 1, 10,
                _M8RenderDistance) &&
            (!M8SphereOutsideFrustum(center, radius, 0u) ||
             !M8SphereOutsideFrustum(center, radius, 6u));
        if (visible)
        {
            indexCount = _M8RenderIndexFrontRead[base + 0u];
            // The record's page count is max(vertexPages, indexPages);
            // visibility walks only the prefix that stores indices.
            pages = (indexCount + M8_RENDER_PAGE_INDICES - 1u) >>
                M8_RENDER_PAGE_INDEX_SHIFT;
        }
    }

    gM8CullPages[lane] = pages;
    GroupMemoryBarrierWithGroupSync();

    if (lane == 0u)
    {
        uint total = 0u;
        [unroll]
        for (uint entry = 0u; entry < M8_CULL_GROUP_THREADS; entry++)
        {
            gM8CullPrefix[entry] = total;
            total += gM8CullPages[entry];
        }
        InterlockedAdd(_M8CullControl[0], total, gM8CullBase);
        if (gM8CullBase + total > M8_RENDER_PAGE_CAPACITY)
            _M8CullControl[2] = 1u;
    }
    GroupMemoryBarrierWithGroupSync();

    if (pages == 0u || indexCount == 0u) return;
    uint outputPage = gM8CullBase + gM8CullPrefix[lane];
    if (outputPage + pages > M8_RENDER_PAGE_CAPACITY) return;

    // One contiguous primitive stream per visible tile: storage pages are
    // never primitive boundaries, so no page tail can join unrelated
    // triangle vertices.
    uint tileOutputBase;
    InterlockedAdd(_M8CullControl[1], indexCount, tileOutputBase);
    if (tileOutputBase + indexCount >
        M8_RENDER_PAGE_CAPACITY * M8_RENDER_PAGE_INDICES)
    {
        _M8CullControl[2] = 1u;
        return;
    }

    uint pageId = _M8RenderIndexFrontRead[
        base + M8_RENDER_RECORD_FIRST_PAGE];
    [loop]
    for (uint page = 0u; page < pages; page++)
    {
        if (pageId >= M8_RENDER_PAGE_CAPACITY)
        {
            _M8CullControl[2] = 1u;
            return;
        }
        uint consumed = page * M8_RENDER_PAGE_INDICES;
        uint used = min(indexCount - consumed, M8_RENDER_PAGE_INDICES);
        _M8VisiblePages[outputPage + page] = uint4(pageId, used,
            tileOutputBase + consumed, 0u);
        pageId = _M8RenderPageQueues[M8_RENDER_LINK_BASE + pageId];
    }
}

[numthreads(1, 1, 1)]
void PrepareVisibleIndices(uint id : SV_DispatchThreadID)
{
    uint pages = min(_M8CullControl[0], M8_RENDER_PAGE_CAPACITY);
    uint totalIndices = _M8CullControl[1];
    // Exactly the published indices of the visible tiles are drawn. A stream
    // that is not whole triangles is publication corruption: draw nothing.
    bool valid = _M8CullControl[2] == 0u &&
        totalIndices <= M8_RENDER_PAGE_CAPACITY * M8_RENDER_PAGE_INDICES &&
        (totalIndices % 3u) == 0u;

    _M8RenderDrawArgs[0] = valid ? totalIndices : 0u;
    _M8RenderDrawArgs[1] = 2u;
    _M8RenderDrawArgs[2] = 0u;
    _M8RenderDrawArgs[3] = 0u;
    _M8RenderDrawArgs[4] = 0u;

    // Words 1..3 become the indirect emit dispatch once the exact index
    // count has been copied to the draw arguments.
    _M8CullControl[0] = valid ? pages : 0u;
    _M8CullControl[1] = valid
        ? (pages + M8_EMIT_GROUP_THREADS - 1u) >> 6u : 0u;
    _M8CullControl[2] = 1u;
    _M8CullControl[3] = 1u;
}

[numthreads(64, 1, 1)]
void EmitVisibleIndices(uint id : SV_DispatchThreadID)
{
    if (id >= min(_M8CullControlRead[0], M8_RENDER_PAGE_CAPACITY)) return;
    uint4 entry = _M8VisiblePagesRead[id];
    uint page = entry.x;
    uint used = entry.y;
    uint output = entry.z;
    if (page >= M8_RENDER_PAGE_CAPACITY || used == 0u ||
        used > M8_RENDER_PAGE_INDICES)
        return;
    uint source = page * M8_RENDER_PAGE_INDICES;
    // Exactly the live indices of this page at the tile's stream position.
    [loop]
    for (uint slot = 0u; slot < used; slot++)
        _M8VisibleIndices.Store((output + slot) * 4u,
            _M8RenderIndicesRead[source + slot]);
}
