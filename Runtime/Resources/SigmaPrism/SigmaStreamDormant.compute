#pragma kernel PrepareDormantParking
#pragma kernel ParkDormantSources
#pragma kernel ParkDormantSegments
#pragma kernel ReleaseDormantPage
#pragma kernel FinalizeDormantParking
#pragma kernel RecheckDormantProbations
#pragma target 5.0

#include "SigmaInverseWorkAbi.hlsl"

// Dormancy is a scheduling state, never rejection. Proof closure has already
// transferred every irreducible raw residue into the constraint ledger. These
// bounded passes retain the candidate/proof anchor and reclaim only transient
// bundle, association, calibration and source-segment residency.

StructuredBuffer<uint> _StreamWorkCounts;
StructuredBuffer<SigmaStreamWorkItemGpu> _StreamWorkItems;
StructuredBuffer<SigmaTransactionGpu> _StreamTransactionsRead;
StructuredBuffer<SigmaSealedSourceBundleGpu> _StreamBundlesRead;
StructuredBuffer<SigmaProbationGpu> _StreamProbationRead;
StructuredBuffer<SigmaSourceHandleSegmentGpu> _StreamSourceSegmentsRead;
StructuredBuffer<SigmaProofClosureGpu> _StreamProofClosuresRead;
StructuredBuffer<SigmaCarrierPageMetaGpu> _PageMetadataRead;
StructuredBuffer<uint> _CurrentFlagsRead;
StructuredBuffer<uint> _DirtyFlagsRead;

RWStructuredBuffer<SigmaTransactionGpu> _StreamTransactions;
RWStructuredBuffer<SigmaSealedSourceBundleGpu> _StreamBundles;
RWStructuredBuffer<SigmaProbationGpu> _StreamProbation;
RWStructuredBuffer<SigmaSourceHandleSegmentGpu> _StreamSourceSegments;
RWStructuredBuffer<uint4> _StreamAssociationOwners;
RWStructuredBuffer<SigmaProofClosureGpu> _StreamProofClosures;
RWStructuredBuffer<SigmaCarrierPageMetaGpu> _PageMetadata;
RWStructuredBuffer<uint> _CurrentFlags;
RWStructuredBuffer<uint> _DirtyFlags;
RWStructuredBuffer<uint> _ReadoutDirtyFlags;
RWStructuredBuffer<uint> _RawLiveWords;
RWStructuredBuffer<uint> _StreamSchedulerControl;
RWStructuredBuffer<SigmaStreamDiagnosticGpu> _StreamDiagnostics;

uint _PageCapacity;
uint _RawTileCapacity;
uint _StreamSourceSegmentCapacity;

#define SIGMA_DORMANT_PARK_READY 0x5041524bu

uint SigmaDormantFindFreeProbation()
{
    [loop]
    for (uint slot = 0u; slot < SIGMA_STREAM_BUNDLE_CAPACITY; ++slot)
        if (_StreamProbationRead[slot].identity.x ==
                SIGMA_STREAM_PROBATION_FREE)
            return slot;
    return SIGMA_STREAM_INVALID;
}

bool SigmaDormantLoadWork(uint workIndex, out uint transactionSlot,
    out SigmaTransactionGpu transaction)
{
    transactionSlot = SIGMA_STREAM_INVALID;
    transaction = (SigmaTransactionGpu)0;
    uint count = _StreamWorkCounts[SIGMA_STREAM_OPCODE_DORMANT_RECHECK];
    if (workIndex >= count)
        return false;
    SigmaStreamWorkItemGpu work = _StreamWorkItems[SigmaStreamWorkAddress(
        SIGMA_STREAM_OPCODE_DORMANT_RECHECK, workIndex)];
    transactionSlot = work.identity.y;
    if (transactionSlot >= SIGMA_STREAM_TRANSACTION_CAPACITY)
        return false;
    transaction = _StreamTransactionsRead[transactionSlot];
    return work.identity.x == SIGMA_STREAM_OPCODE_DORMANT_RECHECK &&
        SigmaStreamTransactionGeneration(transaction) == work.identity.z &&
        SigmaStreamTransactionState(transaction) ==
            SIGMA_STREAM_TRANSACTION_DORMANT;
}

bool SigmaDormantLoadMutableWork(uint workIndex, out uint transactionSlot,
    out SigmaTransactionGpu transaction)
{
    transactionSlot = SIGMA_STREAM_INVALID;
    transaction = (SigmaTransactionGpu)0;
    uint count = _StreamWorkCounts[SIGMA_STREAM_OPCODE_DORMANT_RECHECK];
    if (workIndex >= count)
        return false;
    SigmaStreamWorkItemGpu work = _StreamWorkItems[SigmaStreamWorkAddress(
        SIGMA_STREAM_OPCODE_DORMANT_RECHECK, workIndex)];
    transactionSlot = work.identity.y;
    if (transactionSlot >= SIGMA_STREAM_TRANSACTION_CAPACITY)
        return false;
    transaction = _StreamTransactions[transactionSlot];
    return work.identity.x == SIGMA_STREAM_OPCODE_DORMANT_RECHECK &&
        SigmaStreamTransactionGeneration(transaction) == work.identity.z &&
        SigmaStreamTransactionState(transaction) ==
            SIGMA_STREAM_TRANSACTION_DORMANT;
}

bool SigmaDormantSourceAt(SigmaTransactionGpu transaction, uint ordinal,
    out uint2 handle)
{
    handle = uint2(SIGMA_STREAM_INVALID, 0u);
    if (ordinal >= transaction.source.z)
        return false;
    uint segmentSlot = transaction.source.x;
    uint segmentGeneration = transaction.source.y;
    uint remaining = ordinal;
    [loop]
    for (uint visited = 0u; visited < _StreamSourceSegmentCapacity; ++visited)
    {
        if (!SigmaStreamHandleValid(segmentSlot, segmentGeneration,
                _StreamSourceSegmentCapacity))
            return false;
        SigmaSourceHandleSegmentGpu segment =
            _StreamSourceSegmentsRead[segmentSlot];
        if (!SigmaStreamSourceSegmentValid(segment, segmentGeneration) ||
            segment.identity.x != SIGMA_STREAM_SOURCE_SEGMENT_SEALED)
            return false;
        if (remaining < segment.identity.z)
        {
            handle = SigmaStreamSourceHandle(segment, remaining);
            return SigmaStreamHandleValid(handle.x, handle.y,
                SIGMA_STREAM_BUNDLE_CAPACITY);
        }
        remaining -= segment.identity.z;
        segmentSlot = segment.link.x;
        segmentGeneration = segment.link.y;
    }
    return false;
}

bool SigmaDormantValidateStream(SigmaTransactionGpu transaction,
    out uint2 firstHandle, out uint tailSlot, out uint tailGeneration)
{
    firstHandle = uint2(SIGMA_STREAM_INVALID, 0u);
    tailSlot = SIGMA_STREAM_INVALID;
    tailGeneration = 0u;
    uint segmentSlot = transaction.source.x;
    uint segmentGeneration = transaction.source.y;
    uint remaining = transaction.source.z;
    uint observed = 0u;
    [loop]
    for (uint visited = 0u; visited < _StreamSourceSegmentCapacity &&
        remaining > 0u; ++visited)
    {
        if (!SigmaStreamHandleValid(segmentSlot, segmentGeneration,
                _StreamSourceSegmentCapacity))
            return false;
        SigmaSourceHandleSegmentGpu segment =
            _StreamSourceSegmentsRead[segmentSlot];
        if (!SigmaStreamSourceSegmentValid(segment, segmentGeneration) ||
            segment.identity.x != SIGMA_STREAM_SOURCE_SEGMENT_SEALED)
            return false;
        uint count = min(remaining, segment.identity.z);
        [loop]
        for (uint offset = 0u; offset < count; ++offset)
        {
            uint2 handle = SigmaStreamSourceHandle(segment, offset);
            if (!SigmaStreamHandleValid(handle.x, handle.y,
                    SIGMA_STREAM_BUNDLE_CAPACITY))
                return false;
            SigmaSealedSourceBundleGpu bundle = _StreamBundlesRead[handle.x];
            if (SigmaStreamBundleGeneration(bundle) != handle.y ||
                SigmaStreamBundleState(bundle) != SIGMA_STREAM_BUNDLE_ACTIVE)
                return false;
            if (observed == 0u)
                firstHandle = handle;
            observed++;
        }
        remaining -= count;
        tailSlot = segmentSlot;
        tailGeneration = segmentGeneration;
        segmentSlot = segment.link.x;
        segmentGeneration = segment.link.y;
    }
    return remaining == 0u && observed == transaction.source.z &&
        SigmaStreamHandleValid(firstHandle.x, firstHandle.y,
            SIGMA_STREAM_BUNDLE_CAPACITY);
}

[numthreads(1, 1, 1)]
void PrepareDormantParking(uint3 groupId : SV_GroupID)
{
    // The work list is ticket ordered. Parking one transaction per round avoids
    // competing claims on the bounded probation table without adding another
    // allocator or changing canonical order.
    if (groupId.x != 0u)
        return;
    uint transactionSlot;
    SigmaTransactionGpu transaction;
    if (!SigmaDormantLoadWork(groupId.x, transactionSlot, transaction))
        return;
    uint2 firstHandle;
    uint tailSlot;
    uint tailGeneration;
    uint target = transaction.page0.state.y;
    if (!SigmaDormantValidateStream(transaction, firstHandle, tailSlot,
            tailGeneration) || target >= _PageCapacity ||
        _CurrentFlagsRead[target] != 0u || _DirtyFlagsRead[target] != 0u)
    {
        InterlockedAdd(_StreamDiagnostics[0u].lifetime.w, 1u);
        return;
    }
    uint probationSlot = SigmaDormantFindFreeProbation();
    if (probationSlot == SIGMA_STREAM_INVALID)
        return;
    SigmaProbationGpu previous = _StreamProbationRead[probationSlot];
    uint probationGeneration = previous.identity.y + 1u;
    if (probationGeneration == 0u)
        return;

    SigmaProofClosureGpu scratch = (SigmaProofClosureGpu)0;
    SigmaSealedSourceBundleGpu first = _StreamBundlesRead[firstHandle.x];
    SigmaCarrierPageMetaGpu metadata = _PageMetadataRead[target];
    scratch.identity = uint4(SIGMA_DORMANT_PARK_READY,
        SigmaStreamTransactionGeneration(transaction), probationSlot,
        probationGeneration);
    scratch.sourceCursor = uint4(transaction.source.x,
        transaction.source.y, tailSlot, tailGeneration);
    scratch.journal = uint4(transaction.source.z, target, transactionSlot, 0u);
    scratch.ordering = transaction.ticket;
    scratch.coalesce = transaction.dependency0;
    scratch.redundancy = uint4(first.calibration.w, first.raw.w,
        metadata.generation, metadata.revision);
    _StreamProofClosures[transactionSlot] = scratch;
}

void SigmaDormantReleaseAssociation(uint bundleSlot,
    inout SigmaSealedSourceBundleGpu bundle)
{
    uint association = bundle.raw.z;
    if (association < SIGMA_STREAM_TRANSACTION_CAPACITY)
    {
        uint4 owner = _StreamAssociationOwners[association];
        if (owner.x == bundleSlot &&
            owner.y == SigmaStreamBundleGeneration(bundle))
            _StreamAssociationOwners[association] =
                uint4(SIGMA_STREAM_INVALID, 0u, 0u, 0u);
    }
    bundle.raw.z = SIGMA_STREAM_INVALID;
    bundle.identity.w &= ~SIGMA_STREAM_BUNDLE_FLAG_HAS_ASSOCIATION;
    bundle.identity.w |= SIGMA_STREAM_BUNDLE_FLAG_NEEDS_REVALIDATION;
}

[numthreads(64, 1, 1)]
void ParkDormantSources(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    if (groupId.x != 0u)
        return;
    uint transactionSlot;
    SigmaTransactionGpu transaction;
    if (!SigmaDormantLoadWork(groupId.x, transactionSlot, transaction))
        return;
    SigmaProofClosureGpu scratch =
        _StreamProofClosuresRead[transactionSlot];
    uint ordinal = threadId.x;
    if (scratch.identity.x != SIGMA_DORMANT_PARK_READY ||
        scratch.identity.y != SigmaStreamTransactionGeneration(transaction) ||
        ordinal >= transaction.source.z)
        return;
    uint2 handle;
    if (!SigmaDormantSourceAt(transaction, ordinal, handle))
        return;
    SigmaSealedSourceBundleGpu bundle = _StreamBundles[handle.x];
    if (SigmaStreamBundleGeneration(bundle) != handle.y)
        return;
    SigmaDormantReleaseAssociation(handle.x, bundle);
    uint liveWord = bundle.raw.x >> 5u;
    if (liveWord + 1u < (_RawTileCapacity + 31u) / 32u)
    {
        _RawLiveWords[liveWord] = 0u;
        _RawLiveWords[liveWord + 1u] = 0u;
    }
    uint generation = bundle.identity.y;
    bundle = (SigmaSealedSourceBundleGpu)0;
    bundle.identity.y = generation;
    _StreamBundles[handle.x] = bundle;
}

[numthreads(1, 1, 1)]
void ParkDormantSegments(uint3 groupId : SV_GroupID)
{
    if (groupId.x != 0u)
        return;
    uint transactionSlot;
    SigmaTransactionGpu transaction;
    if (!SigmaDormantLoadWork(groupId.x, transactionSlot, transaction))
        return;
    SigmaProofClosureGpu scratch =
        _StreamProofClosuresRead[transactionSlot];
    if (scratch.identity.x != SIGMA_DORMANT_PARK_READY ||
        scratch.identity.y != SigmaStreamTransactionGeneration(transaction))
        return;
    uint segmentSlot = transaction.source.x;
    uint segmentGeneration = transaction.source.y;
    uint remaining = transaction.source.z;
    [loop]
    for (uint visited = 0u; visited < _StreamSourceSegmentCapacity &&
        remaining > 0u; ++visited)
    {
        if (!SigmaStreamHandleValid(segmentSlot, segmentGeneration,
                _StreamSourceSegmentCapacity))
            return;
        SigmaSourceHandleSegmentGpu segment =
            _StreamSourceSegments[segmentSlot];
        if (!SigmaStreamSourceSegmentValid(segment, segmentGeneration) ||
            segment.identity.x != SIGMA_STREAM_SOURCE_SEGMENT_SEALED)
            return;
        uint count = min(remaining, segment.identity.z);
        uint nextSlot = segment.link.x;
        uint nextGeneration = segment.link.y;
        SigmaSourceHandleSegmentGpu cleared =
            (SigmaSourceHandleSegmentGpu)0;
        cleared.identity.y = segment.identity.y;
        cleared.link.x = SIGMA_STREAM_INVALID;
        _StreamSourceSegments[segmentSlot] = cleared;
        remaining -= count;
        segmentSlot = nextSlot;
        segmentGeneration = nextGeneration;
    }
}

[numthreads(1, 1, 1)]
void ReleaseDormantPage(uint3 groupId : SV_GroupID)
{
    if (groupId.x != 0u)
        return;
    uint transactionSlot;
    SigmaTransactionGpu transaction;
    if (!SigmaDormantLoadWork(groupId.x, transactionSlot, transaction))
        return;
    SigmaProofClosureGpu scratch =
        _StreamProofClosuresRead[transactionSlot];
    if (scratch.identity.x != SIGMA_DORMANT_PARK_READY ||
        scratch.identity.y != SigmaStreamTransactionGeneration(transaction))
        return;
    uint target = scratch.journal.y;
    SigmaCarrierPageMetaGpu metadata = _PageMetadata[target];
    metadata.flags = SIGMA_PAGE_ALLOCATED;
    _PageMetadata[target] = metadata;
    _CurrentFlags[target] = 0u;
    _DirtyFlags[target] = 0u;
    _ReadoutDirtyFlags[target] = 0u;
}

[numthreads(1, 1, 1)]
void FinalizeDormantParking(uint3 groupId : SV_GroupID)
{
    if (groupId.x != 0u)
        return;
    uint transactionSlot;
    SigmaTransactionGpu transaction;
    if (!SigmaDormantLoadMutableWork(groupId.x, transactionSlot,
            transaction))
        return;
    SigmaProofClosureGpu scratch =
        _StreamProofClosures[transactionSlot];
    if (scratch.identity.x != SIGMA_DORMANT_PARK_READY ||
        scratch.identity.y != SigmaStreamTransactionGeneration(transaction))
        return;

    SigmaProbationGpu dormant = (SigmaProbationGpu)0;
    dormant.identity = uint4(SIGMA_STREAM_PROBATION_SEALED,
        scratch.identity.w, scratch.identity.z, 1u);
    dormant.bundleHandles = uint4(scratch.journal.y,
        scratch.redundancy.z, scratch.journal.y, scratch.redundancy.y);
    dormant.support = uint4(scratch.ordering.xy, scratch.redundancy.x,
        scratch.redundancy.w);
    dormant.dependency = scratch.coalesce;
    _StreamProbation[scratch.identity.z] = dormant;

    uint generation = SigmaStreamTransactionGeneration(transaction);
    transaction = (SigmaTransactionGpu)0;
    transaction.identity.y = generation;
    _StreamTransactions[transactionSlot] = transaction;
    _StreamProofClosures[transactionSlot] = (SigmaProofClosureGpu)0;
    if (_StreamSchedulerControl[SIGMA_STREAM_CONTROL_PROOF_OWNER] ==
            transactionSlot)
        _StreamSchedulerControl[SIGMA_STREAM_CONTROL_PROOF_OWNER] =
            SIGMA_STREAM_INVALID;
    if (_StreamSchedulerControl[SIGMA_STREAM_CONTROL_REVALIDATE_OWNER] ==
            transactionSlot)
        _StreamSchedulerControl[SIGMA_STREAM_CONTROL_REVALIDATE_OWNER] =
            SIGMA_STREAM_INVALID;
    InterlockedAdd(_StreamDiagnostics[0u].lifetime.z, 1u);
}

[numthreads(64, 1, 1)]
void RecheckDormantProbations(uint3 threadId : SV_GroupThreadID)
{
    uint probationSlot = threadId.x;
    SigmaProbationGpu probation = _StreamProbationRead[probationSlot];
    if (probation.identity.x != SIGMA_STREAM_PROBATION_SEALED ||
        probation.identity.z != probationSlot || probation.identity.w == 0u)
        return;
    uint target = probation.bundleHandles.x;
    if (target >= _PageCapacity || _CurrentFlagsRead[target] != 0u)
        return;
    SigmaCarrierPageMetaGpu targetMetadata = _PageMetadataRead[target];
    if (targetMetadata.generation != probation.bundleHandles.y ||
        targetMetadata.flags == 0u)
        return;
    // New sealed evidence reopens this anchor through the normal admission
    // proposal. Canonical dependency changes alone never discard or publish it.
}
