#pragma kernel CollectSigmaForensics
#pragma target 5.0

#include "SigmaConstraintLedgerAbi.hlsl"
#include "SigmaInverseWorkAbi.hlsl"

// Disposable observation only. This shader reads live execution state after a
// bounded canonical quantum and writes a compact diagnostic snapshot. Its
// output is never consumed by scheduling, proof, publication, or canonical Psi.

#define SIGMA_FORENSIC_COUNTER_COUNT 128u
#define SIGMA_FORENSIC_SLOT_BASE 80u
#define SIGMA_FORENSIC_SLOT_STRIDE 6u

StructuredBuffer<SigmaTransactionGpu> _StreamTransactionsRead;
StructuredBuffer<SigmaProofClosureGpu> _StreamProofClosuresRead;
StructuredBuffer<SigmaSealedSourceBundleGpu> _StreamBundlesRead;
StructuredBuffer<uint4> _StreamSampleMetaRead;
StructuredBuffer<uint> _StreamSampleOutcomesRead;
RWStructuredBuffer<uint> _ForensicCounters;

uint _ForensicEpoch;

groupshared uint ForensicGroup[SIGMA_FORENSIC_COUNTER_COUNT];

void SigmaForensicAdd(uint counter, uint value)
{
    if (value != 0u)
        InterlockedAdd(ForensicGroup[counter], value);
}

uint SigmaForensicCompletedBlockCount(SigmaTransactionGpu transaction)
{
    uint state = SigmaStreamTransactionState(transaction);
    if (state == SIGMA_STREAM_TRANSACTION_EVALUATING)
        return min(transaction.progress.y, SIGMA_STREAM_PROOF_BLOCKS_PER_PAGE);
    if (state == SIGMA_STREAM_TRANSACTION_PROOF_PENDING)
        return min(transaction.progress.y + 1u,
            SIGMA_STREAM_PROOF_BLOCKS_PER_PAGE);

    bool completeCandidate =
        state == SIGMA_STREAM_TRANSACTION_TRANSITION_PENDING ||
        state == SIGMA_STREAM_TRANSACTION_PUBLISHABLE ||
        state == SIGMA_STREAM_TRANSACTION_PUBLISHED ||
        state == SIGMA_STREAM_TRANSACTION_DORMANT;
    bool transitionStarted = any(transaction.transition != 0u);
    if (completeCandidate ||
        ((state == SIGMA_STREAM_TRANSACTION_REVALIDATE_PENDING ||
          state == SIGMA_STREAM_TRANSACTION_FAILED) && transitionStarted))
        return SIGMA_STREAM_PROOF_BLOCKS_PER_PAGE;

    return min(transaction.progress.y, SIGMA_STREAM_PROOF_BLOCKS_PER_PAGE);
}

void SigmaForensicCountSample(uint transactionSlot,
    SigmaTransactionGpu transaction, uint sample,
    inout uint currentCount, inout uint acceptedCount,
    inout uint changedCount, inout uint promotionCount,
    inout uint existingCount, inout uint conflictCount)
{
    uint address = transactionSlot * SIGMA_PAGE_SAMPLE_COUNT + sample;
    uint4 metadata = _StreamSampleMetaRead[address];
    uint outcome = _StreamSampleOutcomesRead[address];
    uint expectedSource = transaction.source.z == 0u
        ? SIGMA_STREAM_INVALID : transaction.source.z - 1u;

    SigmaForensicAdd(30u, 1u);
    if (expectedSource == SIGMA_STREAM_INVALID ||
        metadata.w != expectedSource)
    {
        SigmaForensicAdd(28u, 1u);
        return;
    }

    uint status = metadata.y;
    uint accepted = (status & SIGMA_PROPOSAL_ACCEPTED) != 0u ? 1u : 0u;
    uint changed = (status & SIGMA_PROPOSAL_CHANGED) != 0u ? 1u : 0u;
    uint hitLeft = (status & SIGMA_PROPOSAL_HIT_LEFT) != 0u ? 1u : 0u;
    uint hitRight = (status & SIGMA_PROPOSAL_HIT_RIGHT) != 0u ? 1u : 0u;
    uint rgbLeft = (status & SIGMA_PROPOSAL_RGB_LEFT) != 0u ? 1u : 0u;
    uint rgbRight = (status & SIGMA_PROPOSAL_RGB_RIGHT) != 0u ? 1u : 0u;
    uint candidateOutcome = outcome == SIGMA_STREAM_OUTCOME_EXISTING_UPDATE ||
        outcome == SIGMA_STREAM_OUTCOME_NULL_PROMOTION ? 1u : 0u;

    currentCount++;
    acceptedCount += accepted;
    changedCount += changed;
    promotionCount += outcome == SIGMA_STREAM_OUTCOME_NULL_PROMOTION ? 1u : 0u;
    existingCount += outcome == SIGMA_STREAM_OUTCOME_EXISTING_UPDATE ? 1u : 0u;
    conflictCount += (status & SIGMA_PROPOSAL_CONFLICT) != 0u ? 1u : 0u;

    SigmaForensicAdd(0u, 1u);
    SigmaForensicAdd(1u, outcome == SIGMA_STREAM_OUTCOME_NO_EVIDENCE ? 1u : 0u);
    SigmaForensicAdd(2u, outcome == SIGMA_STREAM_OUTCOME_EXISTING_UPDATE ? 1u : 0u);
    SigmaForensicAdd(3u, outcome == SIGMA_STREAM_OUTCOME_NULL_PROMOTION ? 1u : 0u);
    SigmaForensicAdd(4u, outcome == SIGMA_STREAM_OUTCOME_EMPTY_EXACT ? 1u : 0u);
    SigmaForensicAdd(5u,
        outcome == SIGMA_STREAM_OUTCOME_TRANSITION_UNRESOLVED ? 1u : 0u);
    SigmaForensicAdd(6u,
        outcome > SIGMA_STREAM_OUTCOME_TRANSITION_UNRESOLVED ? 1u : 0u);
    SigmaForensicAdd(7u, accepted);
    SigmaForensicAdd(8u, changed);
    SigmaForensicAdd(9u, hitLeft);
    SigmaForensicAdd(10u, hitRight);
    SigmaForensicAdd(11u, hitLeft & hitRight);
    SigmaForensicAdd(12u, hitLeft ^ hitRight);
    SigmaForensicAdd(13u, (hitLeft | hitRight) == 0u ? 1u : 0u);
    SigmaForensicAdd(14u,
        (status & SIGMA_PROPOSAL_CONFLICT) != 0u ? 1u : 0u);
    SigmaForensicAdd(15u,
        (status & SIGMA_PROPOSAL_EXCLUSION) != 0u ? 1u : 0u);
    SigmaForensicAdd(16u,
        (status & SIGMA_PROPOSAL_INVALID) != 0u ? 1u : 0u);
    SigmaForensicAdd(17u, rgbLeft);
    SigmaForensicAdd(18u, rgbRight);
    SigmaForensicAdd(19u, rgbLeft & rgbRight);
    SigmaForensicAdd(20u,
        (status & SIGMA_PROPOSAL_RGB_UNOBSERVABLE) != 0u ? 1u : 0u);
    SigmaForensicAdd(21u, metadata.x != 0u ? 1u : 0u);
    SigmaForensicAdd(22u, accepted & changed);
    SigmaForensicAdd(23u, accepted & (1u - changed));
    SigmaForensicAdd(24u, accepted & hitLeft & hitRight);
    SigmaForensicAdd(25u, accepted & (hitLeft ^ hitRight));
    SigmaForensicAdd(26u, candidateOutcome);
    SigmaForensicAdd(27u, candidateOutcome & (1u - accepted));
}

[numthreads(256, 1, 1)]
void CollectSigmaForensics(uint3 threadId : SV_GroupThreadID)
{
    uint lane = threadId.x;
    if (lane < SIGMA_FORENSIC_COUNTER_COUNT)
        ForensicGroup[lane] = 0u;
    GroupMemoryBarrierWithGroupSync();

    if (lane < SIGMA_STREAM_BUNDLE_CAPACITY)
    {
        SigmaSealedSourceBundleGpu bundle = _StreamBundlesRead[lane];
        uint state = SigmaStreamBundleState(bundle);
        SigmaForensicAdd(32u + min(state, 7u), 1u);
        uint flags = bundle.identity.w;
        SigmaForensicAdd(40u,
            (flags & SIGMA_STREAM_BUNDLE_FLAG_MATCHED) != 0u ? 1u : 0u);
        SigmaForensicAdd(41u,
            (flags & SIGMA_STREAM_BUNDLE_FLAG_GAUGE) != 0u ? 1u : 0u);
        SigmaForensicAdd(42u,
            (flags & SIGMA_STREAM_BUNDLE_FLAG_HAS_ASSOCIATION) != 0u ? 1u : 0u);
        SigmaForensicAdd(43u,
            (flags & SIGMA_STREAM_BUNDLE_FLAG_NEEDS_REVALIDATION) != 0u ? 1u : 0u);
        SigmaForensicAdd(44u,
            (flags & SIGMA_STREAM_BUNDLE_FLAG_DUAL_DEPTH) != 0u ? 1u : 0u);
        SigmaForensicAdd(45u,
            (flags & SIGMA_STREAM_BUNDLE_FLAG_DEPTH_RGB) != 0u ? 1u : 0u);
        SigmaForensicAdd(46u,
            (flags & SIGMA_STREAM_BUNDLE_FLAG_TEMPORAL_DEPTH) != 0u ? 1u : 0u);
        SigmaForensicAdd(47u,
            (flags & SIGMA_STREAM_BUNDLE_FLAG_STREAMED) != 0u ? 1u : 0u);
        SigmaForensicAdd(48u,
            (flags & SIGMA_STREAM_BUNDLE_FLAG_DORMANT_PROPOSAL) != 0u ? 1u : 0u);
    }

    [unroll]
    for (uint transactionSlot = 0u;
        transactionSlot < SIGMA_STREAM_TRANSACTION_CAPACITY;
        ++transactionSlot)
    {
        SigmaTransactionGpu transaction =
            _StreamTransactionsRead[transactionSlot];
        uint blockCount = SigmaForensicCompletedBlockCount(transaction);
        uint currentCount = 0u;
        uint acceptedCount = 0u;
        uint changedCount = 0u;
        uint promotionCount = 0u;
        uint existingCount = 0u;
        uint conflictCount = 0u;

        for (uint local = lane; local < SIGMA_PAGE_SAMPLE_COUNT;
            local += 256u)
        {
            if (SigmaProofBlockForPageSample(local) >= blockCount)
                continue;
            SigmaForensicCountSample(transactionSlot, transaction, local,
                currentCount, acceptedCount, changedCount, promotionCount,
                existingCount, conflictCount);
        }

        uint slotBase = SIGMA_FORENSIC_SLOT_BASE +
            transactionSlot * SIGMA_FORENSIC_SLOT_STRIDE;
        SigmaForensicAdd(slotBase + 0u, currentCount);
        SigmaForensicAdd(slotBase + 1u, acceptedCount);
        SigmaForensicAdd(slotBase + 2u, changedCount);
        SigmaForensicAdd(slotBase + 3u, promotionCount);
        SigmaForensicAdd(slotBase + 4u, existingCount);
        SigmaForensicAdd(slotBase + 5u, conflictCount);

        if (lane == transactionSlot)
        {
            uint state = SigmaStreamTransactionState(transaction);
            SigmaForensicAdd(49u + min(state, 9u), 1u);
            SigmaForensicAdd(59u, state != SIGMA_STREAM_TRANSACTION_FREE
                ? 1u : 0u);
            SigmaProofClosureGpu closure =
                _StreamProofClosuresRead[transactionSlot];
            uint phase = closure.identity.x;
            if (phase <= SIGMA_STREAM_PROOF_CLOSED)
                SigmaForensicAdd(60u + phase, 1u);
            else
                SigmaForensicAdd(70u, 1u);
            bool closureOwned = phase != SIGMA_STREAM_PROOF_IDLE;
            bool closureCurrent = closure.identity.y == transaction.identity.y &&
                closure.identity.z == transaction.progress.y;
            SigmaForensicAdd(71u, closureOwned && !closureCurrent ? 1u : 0u);
            SigmaForensicAdd(72u,
                blockCount != 0u && transaction.source.z == 0u ? 1u : 0u);
            SigmaForensicAdd(73u,
                (transaction.execution.w & SIGMA_STREAM_EXECUTION_FAULT) != 0u
                    ? 1u : 0u);
            SigmaForensicAdd(31u, blockCount != 0u ? 1u : 0u);
        }
    }

    GroupMemoryBarrierWithGroupSync();
    if (lane < SIGMA_FORENSIC_COUNTER_COUNT)
        _ForensicCounters[lane] = ForensicGroup[lane];
    if (lane == 0u)
        _ForensicCounters[79u] = _ForensicEpoch;
}
