#pragma kernel ValidateCandidateTransitionChunk
#pragma kernel ValidateCandidateAssociatorChunk
#pragma target 5.0

#include "SigmaTopologyMath.hlsl"
#include "SigmaConstraintLedgerAbi.hlsl"
#include "SigmaInverseWorkAbi.hlsl"
#include "SigmaManifestVisibility.hlsl"

// Canonical candidate-transition closure. Candidate Psi is evaluated directly
// in bounded windows; the disposable topology cache is never an authority.

StructuredBuffer<SigmaStreamWorkItemGpu> _StreamWorkItems;
StructuredBuffer<uint> _StreamWorkCounts;
StructuredBuffer<uint2> _CarrierState;
StructuredBuffer<uint2> _TargetCarrierState;
StructuredBuffer<SigmaCarrierPageMetaGpu> _PageMetadata;
StructuredBuffer<SigmaPublicationManifestGpu> _StreamManifests;
StructuredBuffer<SigmaPageVisibilityGpu> _StreamPageVisibility;
StructuredBuffer<uint4> _StreamSampleMeta;
StructuredBuffer<uint> _StreamSampleOutcomes;
StructuredBuffer<SigmaSealedSourceBundleGpu> _StreamBundles;
StructuredBuffer<SigmaSourceHandleSegmentGpu> _StreamSourceSegments;

RWStructuredBuffer<SigmaTransactionGpu> _StreamTransactions;
RWStructuredBuffer<uint4> _StreamCandidateTransitions;
RWStructuredBuffer<uint4> _StreamCandidateNeighbours;
RWStructuredBuffer<SigmaStreamDiagnosticGpu> _StreamDiagnostics;

uint _PageCapacity;
uint _TargetPageCapacity;
uint _StreamManifestCapacity;
uint _StreamSourceSegmentCapacity;
uint _SingularShift;
uint _AssociatorShift;

#define SIGMA_CANDIDATE_EDGE_CHUNK 64u
#define SIGMA_CANDIDATE_EDGE_CHUNKS \
    (SIGMA_TRANSITIONS_PER_PAGE / SIGMA_CANDIDATE_EDGE_CHUNK)
#define SIGMA_CANDIDATE_CELL_CHUNKS \
    (SIGMA_PAGE_SAMPLE_COUNT / SIGMA_CANDIDATE_EDGE_CHUNK)

#define SIGMA_CANDIDATE_CHANGED (1u << 0u)
#define SIGMA_CANDIDATE_VALID (1u << 1u)
#define SIGMA_CANDIDATE_INDEPENDENT (1u << 2u)
#define SIGMA_CANDIDATE_DISCONTINUITY (1u << 3u)
#define SIGMA_CANDIDATE_BOTH_NULL (1u << 4u)
#define SIGMA_CANDIDATE_CLOSED (1u << 5u)
#define SIGMA_CANDIDATE_FAILED (1u << 6u)
#define SIGMA_CANDIDATE_NO_CLAIM (1u << 7u)
#define SIGMA_CANDIDATE_EXPLICIT_NULL (1u << 8u)
#define SIGMA_CANDIDATE_EVIDENCE_FAULT (1u << 9u)

#define SIGMA_CANDIDATE_ENDPOINT_UNOBSERVED 0u
#define SIGMA_CANDIDATE_ENDPOINT_CURRENT 1u
#define SIGMA_CANDIDATE_ENDPOINT_SHADOW 2u
#define SIGMA_CANDIDATE_ENDPOINT_PUBLISHED 3u

groupshared uint2 CandidateTau[SIGMA_CANDIDATE_EDGE_CHUNK * 16u];
groupshared uint4 CandidateBestError[256];
groupshared uint CandidateBestId[256];
groupshared uint CandidateEdgeInfo[SIGMA_CANDIDATE_EDGE_CHUNK];
groupshared uint CandidateChunkFailure[SIGMA_CANDIDATE_EDGE_CHUNK];
groupshared uint CandidateRightSlot;
groupshared uint CandidateDownSlot;
groupshared uint CandidateRightPublishedSlot;
groupshared uint CandidateDownPublishedSlot;
groupshared uint CandidateRightOwner;
groupshared uint CandidateDownOwner;
groupshared uint CandidateGroupActive;
groupshared uint CandidateGroupTransactionSlot;
groupshared uint CandidateGroupChunk;
groupshared SigmaTransactionGpu CandidateGroupTransaction;

uint SigmaCandidateRecordAddress(uint transactionSlot, uint transition)
{
    return transactionSlot * SIGMA_TRANSITIONS_PER_PAGE + transition;
}

uint SigmaCandidateSampleAddress(uint transactionSlot, uint sample)
{
    return transactionSlot * SIGMA_PAGE_SAMPLE_COUNT + sample;
}

bool SigmaCandidateI64Equal(uint2 left, uint2 right)
{
    return all(left == right);
}

bool SigmaCandidateIncrementI64(uint2 value, out uint2 incremented)
{
    incremented = value;
    if (value.x == 0xffffffffu && value.y == 0x7fffffffu)
        return false;
    incremented.x = value.x + 1u;
    incremented.y = value.y + (incremented.x == 0u ? 1u : 0u);
    return true;
}

bool SigmaCandidatePageVisible(uint slot)
{
    if (slot >= _PageCapacity)
        return false;
    SigmaPageVisibilityGpu visibility = _StreamPageVisibility[slot];
    uint2 bornHandle = visibility.bornRetired.xy;
    uint2 retiredHandle = visibility.bornRetired.zw;
    if (!SigmaManifestHandleValid(bornHandle, _StreamManifestCapacity))
        return false;
    SigmaPublicationManifestGpu born = _StreamManifests[bornHandle.x];
    SigmaPublicationManifestGpu retired = (SigmaPublicationManifestGpu)0;
    if (SigmaManifestHandleValid(retiredHandle, _StreamManifestCapacity))
        retired = _StreamManifests[retiredHandle.x];
    return SigmaManifestPageVisible(visibility, born, retired);
}

SigmaStreamPageReferenceGpu SigmaCandidatePageReference(
    SigmaTransactionGpu transaction, uint index)
{
    if (index == 0u) return transaction.page0;
    if (index == 1u) return transaction.page1;
    if (index == 2u) return transaction.page2;
    return transaction.page3;
}

bool SigmaCandidateTransactionPage(SigmaTransactionGpu transaction,
    uint4 coordinate, out uint slot)
{
    slot = SIGMA_STREAM_INVALID;
    [unroll]
    for (uint pageIndex = 0u; pageIndex < SIGMA_STREAM_MAX_PAGES;
        ++pageIndex)
    {
        SigmaStreamPageReferenceGpu page = SigmaCandidatePageReference(
            transaction, pageIndex);
        if (page.state.y < _TargetPageCapacity && page.state.w != 0u &&
            all(page.coordinate == coordinate))
        {
            slot = page.state.y;
            return true;
        }
    }
    return false;
}

bool SigmaCandidateWorksetReady(SigmaTransactionGpu transaction)
{
    uint state = SigmaStreamTransactionState(transaction);
    return state >= SIGMA_STREAM_TRANSACTION_TRANSITION_PENDING &&
        state <= SIGMA_STREAM_TRANSACTION_PUBLISHED &&
        transaction.page0.state.y < _TargetPageCapacity &&
        transaction.page0.state.w != 0u;
}

bool SigmaCandidateSameWorkset(SigmaTransactionGpu left,
    SigmaTransactionGpu right)
{
    return left.ticket.z == right.ticket.z &&
        left.ticket.w == right.ticket.w &&
        left.dependency0.w == right.dependency0.w;
}

uint2 SigmaCandidateNullLane(uint lane)
{
    if (lane == (uint)SIGMA_Z_NULL_DYAD.x)
        return SIGMA_Z_NULL_DYAD.y < 0
            ? uint2(0u, 0xffff0000u) : uint2(0u, 0x00010000u);
    if (lane == (uint)SIGMA_Z_NULL_DYAD.z)
        return SIGMA_Z_NULL_DYAD.w < 0
            ? uint2(0u, 0xffff0000u) : uint2(0u, 0x00010000u);
    return uint2(0u, 0u);
}

void SigmaCandidatePrepareGroup(uint opcode, uint workIndex,
    uint requiredPhase, uint chunkLimit)
{
    CandidateGroupActive = 0u;
    CandidateGroupTransactionSlot = SIGMA_STREAM_INVALID;
    CandidateGroupChunk = 0u;
    CandidateGroupTransaction = (SigmaTransactionGpu)0;
    if (!SigmaCanonicalMutationEnabled() ||
        workIndex >= _StreamWorkCounts[opcode])
        return;
    SigmaStreamWorkItemGpu work = _StreamWorkItems[
        SigmaStreamWorkAddress(opcode, workIndex)];
    uint transactionSlot = work.identity.y;
    if (work.identity.x != opcode ||
        transactionSlot >= SIGMA_STREAM_TRANSACTION_CAPACITY)
        return;
    SigmaTransactionGpu transaction = _StreamTransactions[transactionSlot];
    if (SigmaStreamTransactionGeneration(transaction) != work.identity.z ||
        SigmaStreamTransactionState(transaction) !=
            SIGMA_STREAM_TRANSACTION_TRANSITION_PENDING ||
        transaction.transition.z != requiredPhase)
        return;
    uint chunk = requiredPhase == 0u
        ? transaction.transition.x : transaction.transition.y;
    if (chunk >= chunkLimit)
        return;
    CandidateGroupTransactionSlot = transactionSlot;
    CandidateGroupChunk = chunk;
    CandidateGroupTransaction = transaction;
    CandidateGroupActive = 1u;
}

void SigmaCandidateResolveNeighbours(uint lane, uint transactionSlot,
    SigmaTransactionGpu transaction, bool resolve)
{
    if (lane == 0u && resolve)
    {
        CandidateRightSlot = SIGMA_STREAM_INVALID;
        CandidateDownSlot = SIGMA_STREAM_INVALID;
        CandidateRightPublishedSlot = SIGMA_STREAM_INVALID;
        CandidateDownPublishedSlot = SIGMA_STREAM_INVALID;
        CandidateRightOwner = SIGMA_STREAM_INVALID;
        CandidateDownOwner = SIGMA_STREAM_INVALID;
    }
    GroupMemoryBarrierWithGroupSync();

    if (resolve)
    {
        uint2 targetX = transaction.page0.coordinate.xy;
        uint2 targetY = transaction.page0.coordinate.zw;
        uint2 nextX;
        uint2 nextY;
        bool hasNextX = SigmaCandidateIncrementI64(targetX, nextX);
        bool hasNextY = SigmaCandidateIncrementI64(targetY, nextY);
        uint4 rightCoordinate = uint4(nextX, targetY);
        uint4 downCoordinate = uint4(targetX, nextY);

        if (lane < SIGMA_STREAM_TRANSACTION_CAPACITY &&
            lane != transactionSlot)
        {
            SigmaTransactionGpu other = _StreamTransactions[lane];
            if (SigmaCandidateWorksetReady(other) &&
                SigmaCandidateSameWorkset(transaction, other))
            {
                uint shadowSlot;
                if (hasNextX && SigmaCandidateTransactionPage(other,
                        rightCoordinate, shadowSlot))
                    InterlockedMin(CandidateRightOwner, lane);
                if (hasNextY && SigmaCandidateTransactionPage(other,
                        downCoordinate, shadowSlot))
                    InterlockedMin(CandidateDownOwner, lane);
            }
        }
        for (uint candidate = lane; candidate < _PageCapacity;
            candidate += 256u)
        {
            if (!SigmaCandidatePageVisible(candidate))
                continue;
            SigmaCarrierPageMetaGpu metadata = _PageMetadata[candidate];
            uint2 x = uint2(metadata.pageXLo, metadata.pageXHi);
            uint2 y = uint2(metadata.pageYLo, metadata.pageYHi);
            if (hasNextX && SigmaCandidateI64Equal(x, nextX) &&
                SigmaCandidateI64Equal(y, targetY))
                InterlockedMin(CandidateRightPublishedSlot, candidate);
            if (hasNextY && SigmaCandidateI64Equal(x, targetX) &&
                SigmaCandidateI64Equal(y, nextY))
                InterlockedMin(CandidateDownPublishedSlot, candidate);
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (lane == 0u && resolve)
    {
        if (CandidateRightOwner < SIGMA_STREAM_TRANSACTION_CAPACITY)
        {
            SigmaTransactionGpu owner =
                _StreamTransactions[CandidateRightOwner];
            uint2 nextX;
            if (SigmaCandidateIncrementI64(transaction.page0.coordinate.xy,
                    nextX))
                SigmaCandidateTransactionPage(owner, uint4(nextX,
                    transaction.page0.coordinate.zw), CandidateRightSlot);
        }
        else
            CandidateRightSlot = CandidateRightPublishedSlot;
        if (CandidateDownOwner < SIGMA_STREAM_TRANSACTION_CAPACITY)
        {
            SigmaTransactionGpu owner =
                _StreamTransactions[CandidateDownOwner];
            uint2 nextY;
            if (SigmaCandidateIncrementI64(transaction.page0.coordinate.zw,
                    nextY))
                SigmaCandidateTransactionPage(owner, uint4(
                    transaction.page0.coordinate.xy, nextY), CandidateDownSlot);
        }
        else
            CandidateDownSlot = CandidateDownPublishedSlot;
        uint packedOwners = (min(CandidateRightOwner, 255u) & 255u) |
            ((min(CandidateDownOwner, 255u) & 255u) << 8u);
        _StreamCandidateNeighbours[transactionSlot] = uint4(
            SigmaStreamTransactionGeneration(transaction),
            CandidateRightSlot, CandidateDownSlot, packedOwners);
    }
    DeviceMemoryBarrierWithGroupSync();
}

uint SigmaCandidateOutsideSlot(uint transactionSlot, uint direction)
{
    uint4 neighbours = _StreamCandidateNeighbours[transactionSlot];
    return direction == 0u ? neighbours.y : neighbours.z;
}

uint SigmaCandidateOutsideOwner(uint transactionSlot, uint direction)
{
    uint packed = _StreamCandidateNeighbours[transactionSlot].w;
    uint owner = direction == 0u ? packed & 255u : (packed >> 8u) & 255u;
    return owner < SIGMA_STREAM_TRANSACTION_CAPACITY
        ? owner : SIGMA_STREAM_INVALID;
}

void SigmaCandidateResolveEndpoint(SigmaTransactionGpu transaction,
    uint transactionSlot, uint transition, bool rightEndpoint,
    out uint source, out uint slot, out uint sample, out uint owner)
{
    uint direction = transition / SIGMA_PAGE_SAMPLE_COUNT;
    sample = transition & (SIGMA_PAGE_SAMPLE_COUNT - 1u);
    uint x = sample & 63u;
    uint y = sample >> 6u;
    slot = transaction.page0.state.y;
    owner = transactionSlot;
    source = SIGMA_CANDIDATE_ENDPOINT_CURRENT;
    if (!rightEndpoint)
        return;
    if (direction == 0u && x < 63u)
    {
        sample++;
        return;
    }
    if (direction != 0u && y < 63u)
    {
        sample += 64u;
        return;
    }

    uint4 neighbourCoordinate = transaction.page0.coordinate;
    if (direction == 0u)
    {
        uint2 incremented;
        if (!SigmaCandidateIncrementI64(neighbourCoordinate.xy, incremented))
        {
            source = SIGMA_CANDIDATE_ENDPOINT_UNOBSERVED;
            slot = SIGMA_STREAM_INVALID;
            owner = SIGMA_STREAM_INVALID;
            return;
        }
        neighbourCoordinate.xy = incremented;
        sample = y * 64u;
    }
    else
    {
        uint2 incremented;
        if (!SigmaCandidateIncrementI64(neighbourCoordinate.zw, incremented))
        {
            source = SIGMA_CANDIDATE_ENDPOINT_UNOBSERVED;
            slot = SIGMA_STREAM_INVALID;
            owner = SIGMA_STREAM_INVALID;
            return;
        }
        neighbourCoordinate.zw = incremented;
        sample = x;
    }
    if (SigmaCandidateTransactionPage(transaction, neighbourCoordinate,
            slot))
    {
        source = SIGMA_CANDIDATE_ENDPOINT_SHADOW;
        return;
    }
    slot = SigmaCandidateOutsideSlot(transactionSlot, direction);
    owner = SigmaCandidateOutsideOwner(transactionSlot, direction);
    if (slot < _TargetPageCapacity &&
        owner < SIGMA_STREAM_TRANSACTION_CAPACITY)
    {
        source = SIGMA_CANDIDATE_ENDPOINT_SHADOW;
        return;
    }
    if (slot < _PageCapacity && SigmaCandidatePageVisible(slot))
    {
        source = SIGMA_CANDIDATE_ENDPOINT_PUBLISHED;
        owner = SIGMA_STREAM_INVALID;
        return;
    }
    source = SIGMA_CANDIDATE_ENDPOINT_UNOBSERVED;
    slot = SIGMA_STREAM_INVALID;
    owner = SIGMA_STREAM_INVALID;
}

uint2 SigmaCandidateEndpointLane(SigmaTransactionGpu transaction,
    uint transactionSlot, uint transition, bool rightEndpoint, uint lane)
{
    uint source;
    uint slot;
    uint sample;
    uint owner;
    SigmaCandidateResolveEndpoint(transaction, transactionSlot, transition,
        rightEndpoint, source, slot, sample, owner);
    if (source == SIGMA_CANDIDATE_ENDPOINT_CURRENT ||
        source == SIGMA_CANDIDATE_ENDPOINT_SHADOW)
        return _TargetCarrierState[slot * SIGMA_PAGE_LANE_COUNT +
            sample * 16u + lane];
    if (source == SIGMA_CANDIDATE_ENDPOINT_PUBLISHED)
        return _CarrierState[slot * SIGMA_PAGE_LANE_COUNT +
            sample * 16u + lane];
    return SigmaCandidateNullLane(lane);
}

uint SigmaCandidateEndpointStatus(SigmaTransactionGpu transaction,
    uint transactionSlot, uint transition, bool rightEndpoint,
    out uint source)
{
    uint slot;
    uint sample;
    uint owner;
    SigmaCandidateResolveEndpoint(transaction, transactionSlot, transition,
        rightEndpoint, source, slot, sample, owner);
    if ((source == SIGMA_CANDIDATE_ENDPOINT_CURRENT ||
            source == SIGMA_CANDIDATE_ENDPOINT_SHADOW) &&
        owner < SIGMA_STREAM_TRANSACTION_CAPACITY)
        return _StreamSampleMeta[SigmaCandidateSampleAddress(owner,
            sample)].y;
    return 0u;
}

uint2 SigmaCandidateTransitionLane(SigmaTransactionGpu transaction,
    uint transactionSlot, uint transition, uint outputLane, inout uint valid)
{
    uint2 sum = uint2(0u, 0u);
    [loop]
    for (uint leftLane = 0u; leftLane < 16u; ++leftLane)
    {
        uint rightLane = leftLane ^ outputLane;
        uint2 left = SigmaCandidateEndpointLane(transaction,
            transactionSlot, transition, false, leftLane);
        uint2 right = SigmaCandidateEndpointLane(transaction,
            transactionSlot, transition, true, rightLane);
        if (leftLane != 0u)
            left = SigmaQ48NegateChecked(left, valid);
        uint2 term = SigmaQ48MulNearestEven(left, right, valid);
        if (SigmaMulBasisSign(leftLane, rightLane) < 0)
            term = SigmaQ48NegateChecked(term, valid);
        sum = SigmaQ48AddChecked(sum, term, valid);
    }
    return sum;
}

uint4 SigmaCandidateDyadL1(uint tauBase, int4 dyad, inout uint valid)
{
    uint4 error = SIGMA_U128_ZERO;
    [unroll]
    for (uint outputLane = 0u; outputLane < 16u; ++outputLane)
    {
        uint firstSource = (uint)dyad.x ^ outputLane;
        uint secondSource = (uint)dyad.z ^ outputLane;
        uint2 first = CandidateTau[tauBase + firstSource];
        uint2 second = CandidateTau[tauBase + secondSource];
        int firstSign = SigmaMulBasisSign(firstSource,
            (uint)dyad.x) * dyad.y;
        int secondSign = SigmaMulBasisSign(secondSource,
            (uint)dyad.z) * dyad.w;
        if (firstSign < 0)
            first = SigmaQ48NegateChecked(first, valid);
        if (secondSign < 0)
            second = SigmaQ48NegateChecked(second, valid);
        uint2 residual = SigmaQ48AddChecked(first, second, valid);
        error = SigmaU128Add64(error, SigmaU64AbsSigned(residual), valid);
    }
    return error;
}

uint4 SigmaCandidateTauL1(uint tauBase, inout uint valid)
{
    uint4 scale = SIGMA_U128_ZERO;
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
        scale = SigmaU128Add64(scale,
            SigmaU64AbsSigned(CandidateTau[tauBase + lane]), valid);
    return SigmaU128Equal(scale, SIGMA_U128_ZERO)
        ? SIGMA_U128_ONE : scale;
}

[numthreads(256, 1, 1)]
void ValidateCandidateTransitionChunk(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint lane = threadId.x;
    if (lane == 0u)
    {
        SigmaCandidatePrepareGroup(
            SIGMA_STREAM_OPCODE_TRANSITION_ANNIHILATOR, groupId.x, 0u,
            SIGMA_CANDIDATE_EDGE_CHUNKS);
    }
    GroupMemoryBarrierWithGroupSync();
    if (CandidateGroupActive == 0u)
        return;

    uint transactionSlot = CandidateGroupTransactionSlot;
    uint chunk = CandidateGroupChunk;
    SigmaTransactionGpu transaction = CandidateGroupTransaction;
    SigmaCandidateResolveNeighbours(lane, transactionSlot, transaction,
        chunk == 0u);

    uint edgeLocal = lane >> 2u;
    uint witnessLane = lane & 3u;
    uint transition = chunk * SIGMA_CANDIDATE_EDGE_CHUNK + edgeLocal;
    uint tauBase = edgeLocal * 16u;
    uint sourceLeft;
    uint sourceRight;
    uint statusLeft = SigmaCandidateEndpointStatus(transaction,
        transactionSlot, transition, false, sourceLeft);
    uint statusRight = SigmaCandidateEndpointStatus(transaction,
        transactionSlot, transition, true, sourceRight);
    uint evidenceStatus = statusLeft | statusRight;
    bool changed = (evidenceStatus & SIGMA_PROPOSAL_CHANGED) != 0u;

    if (witnessLane == 0u)
    {
        uint2 left[16];
        uint2 right[16];
        [unroll]
        for (uint coordinate = 0u; coordinate < 16u; ++coordinate)
        {
            left[coordinate] = SigmaCandidateEndpointLane(transaction,
                transactionSlot, transition, false, coordinate);
            right[coordinate] = SigmaCandidateEndpointLane(transaction,
                transactionSlot, transition, true, coordinate);
        }
        uint leftValid;
        uint rightValid;
        bool leftContact = SigmaStateHasContact(left, leftValid);
        bool rightContact = SigmaStateHasContact(right, rightValid);
        bool stereoContactEvidence = (evidenceStatus &
            (SIGMA_PROPOSAL_HIT_LEFT | SIGMA_PROPOSAL_HIT_RIGHT)) ==
            (SIGMA_PROPOSAL_HIT_LEFT | SIGMA_PROPOSAL_HIT_RIGHT);
        bool contactNull = leftContact != rightContact;
        bool leftExplicitNull = !leftContact &&
            (statusLeft & SIGMA_PROPOSAL_EXCLUSION) != 0u;
        bool rightExplicitNull = !rightContact &&
            (statusRight & SIGMA_PROPOSAL_EXCLUSION) != 0u;
        bool explicitNull = contactNull &&
            (leftExplicitNull || rightExplicitNull);
        bool noClaim = contactNull && !explicitNull;
        bool evidenceFault = (evidenceStatus &
            (SIGMA_PROPOSAL_INVALID | SIGMA_PROPOSAL_CONFLICT)) != 0u;
        // Current S4-08 evidence has no two-sided pass-through bit. Stereo hits
        // on the contact endpoint therefore cannot prove the null endpoint.
        bool independent = !contactNull && stereoContactEvidence;
        bool discontinuity = explicitNull ||
            (evidenceStatus & (SIGMA_PROPOSAL_CONFLICT |
                SIGMA_PROPOSAL_EXCLUSION)) != 0u;
        uint info = changed ? SIGMA_CANDIDATE_CHANGED : 0u;
        info |= leftValid != 0u && rightValid != 0u
            ? SIGMA_CANDIDATE_VALID : 0u;
        info |= independent ? SIGMA_CANDIDATE_INDEPENDENT : 0u;
        info |= discontinuity ? SIGMA_CANDIDATE_DISCONTINUITY : 0u;
        info |= noClaim ? SIGMA_CANDIDATE_NO_CLAIM : 0u;
        info |= explicitNull ? SIGMA_CANDIDATE_EXPLICIT_NULL : 0u;
        info |= evidenceFault ? SIGMA_CANDIDATE_EVIDENCE_FAULT : 0u;
        info |= !leftContact && !rightContact
            ? SIGMA_CANDIDATE_BOTH_NULL : 0u;
        info |= leftContact ? (1u << 16u) : 0u;
        info |= rightContact ? (1u << 17u) : 0u;
        CandidateEdgeInfo[edgeLocal] = info;
    }

    uint valid = 1u;
    [unroll]
    for (uint outputLane = witnessLane; outputLane < 16u;
        outputLane += 4u)
    {
        CandidateTau[tauBase + outputLane] =
            SigmaCandidateTransitionLane(transaction, transactionSlot,
                transition, outputLane, valid);
    }
    CandidateBestError[lane] = SIGMA_U128_MAX;
    CandidateBestId[lane] = SIGMA_ANNIHILATOR_ACTION_COUNT + witnessLane;
    GroupMemoryBarrierWithGroupSync();

    uint edgeInfo = CandidateEdgeInfo[edgeLocal];
    bool evaluate = (edgeInfo & (SIGMA_CANDIDATE_CHANGED |
        SIGMA_CANDIDATE_VALID)) ==
        (SIGMA_CANDIDATE_CHANGED | SIGMA_CANDIDATE_VALID) &&
        (edgeInfo & (SIGMA_CANDIDATE_BOTH_NULL |
            SIGMA_CANDIDATE_NO_CLAIM |
            SIGMA_CANDIDATE_EVIDENCE_FAULT)) == 0u;
    uint4 bestError = SIGMA_U128_MAX;
    uint bestId = SIGMA_ANNIHILATOR_ACTION_COUNT + witnessLane;
    if (evaluate && valid != 0u)
    {
        [loop]
        for (uint action = witnessLane; action <
            SIGMA_ANNIHILATOR_ACTION_COUNT; action += 4u)
        {
            uint actionValid = valid;
            uint4 error = SigmaCandidateDyadL1(tauBase,
                SIGMA_ANNIHILATOR_ACTIONS[action], actionValid);
            if (actionValid != 0u &&
                (SigmaU128Less(error, bestError) ||
                 (SigmaU128Equal(error, bestError) && action < bestId)))
            {
                bestError = error;
                bestId = action;
            }
        }
    }
    CandidateBestError[lane] = bestError;
    CandidateBestId[lane] = bestId;
    GroupMemoryBarrierWithGroupSync();

    if (witnessLane == 0u)
    {
        [unroll]
        for (uint other = 1u; other < 4u; ++other)
        {
            uint otherLane = lane + other;
            uint4 otherError = CandidateBestError[otherLane];
            uint otherId = CandidateBestId[otherLane];
            if (SigmaU128Less(otherError, bestError) ||
                (SigmaU128Equal(otherError, bestError) && otherId < bestId))
            {
                bestError = otherError;
                bestId = otherId;
            }
        }

        uint classification = SIGMA_TOPOLOGY_REGULAR;
        uint topologyFlags = 0u;
        bool edgeValid = (edgeInfo & SIGMA_CANDIDATE_VALID) != 0u;
        bool bothNull = (edgeInfo & SIGMA_CANDIDATE_BOTH_NULL) != 0u;
        bool noClaim = (edgeInfo & SIGMA_CANDIDATE_NO_CLAIM) != 0u;
        bool evidenceFault = (edgeInfo &
            SIGMA_CANDIDATE_EVIDENCE_FAULT) != 0u;
        bool leftContact = (edgeInfo & (1u << 16u)) != 0u;
        bool rightContact = (edgeInfo & (1u << 17u)) != 0u;
        bool validTransition = evaluate && bestId <
            SIGMA_ANNIHILATOR_ACTION_COUNT &&
            !SigmaU128Equal(bestError, SIGMA_U128_MAX);
        uint scaleValid = validTransition ? 1u : 0u;
        uint4 scale = validTransition
            ? SigmaCandidateTauL1(tauBase, scaleValid)
            : SIGMA_U128_ONE;
        validTransition = validTransition && scaleValid != 0u;
        bool near = validTransition && SigmaRelativeNearGate(bestError,
            scale, _SingularShift);
        bool exact = validTransition && SigmaU128Equal(bestError,
            SIGMA_U128_ZERO);
        bool contactNull = edgeValid && !noClaim &&
            leftContact != rightContact;
        if (!edgeValid || evidenceFault || (evaluate && !validTransition))
        {
            classification = SIGMA_TOPOLOGY_UNRESOLVED;
            topologyFlags |= SIGMA_TOPOLOGY_INVALID;
        }
        else if (bothNull || noClaim)
            classification = SIGMA_TOPOLOGY_UNSUPPORTED;
        else if (near || contactNull)
            classification = SIGMA_TOPOLOGY_UNRESOLVED;
        if (near) topologyFlags |= SIGMA_TOPOLOGY_NEAR_ANNIHILATOR;
        if (exact) topologyFlags |= SIGMA_TOPOLOGY_EXACT_ANNIHILATOR;
        if (contactNull) topologyFlags |= SIGMA_TOPOLOGY_CONTACT_NULL;
        if (leftContact) topologyFlags |= SIGMA_TOPOLOGY_LEFT_CONTACT;
        if (rightContact) topologyFlags |= SIGMA_TOPOLOGY_RIGHT_CONTACT;
        if ((edgeInfo & SIGMA_CANDIDATE_DISCONTINUITY) != 0u)
            topologyFlags |= SIGMA_TOPOLOGY_DISCONTINUITY_EVIDENCE;
        _StreamCandidateTransitions[SigmaCandidateRecordAddress(
            transactionSlot, transition)] = uint4(SigmaTopologyPack(
                classification, validTransition ? bestId : 255u,
                topologyFlags), edgeInfo, evidenceStatus, bestError.x);
    }

    DeviceMemoryBarrierWithGroupSync();
    if (lane == 0u)
    {
        SigmaTransactionGpu current = _StreamTransactions[transactionSlot];
        bool currentWork = SigmaStreamTransactionGeneration(current) ==
                SigmaStreamTransactionGeneration(transaction) &&
            current.transition.z == 0u &&
            current.transition.x == chunk;
        if (currentWork)
        {
            current.transition.x++;
            if (current.transition.x == SIGMA_CANDIDATE_EDGE_CHUNKS)
            {
                current.transition.y = 0u;
                current.transition.z = 1u;
            }
            _StreamTransactions[transactionSlot] = current;
            InterlockedAdd(_StreamDiagnostics[0u].transition.x,
                SIGMA_CANDIDATE_EDGE_CHUNK);
            InterlockedAdd(_StreamDiagnostics[0u].transition.y,
                SIGMA_CANDIDATE_EDGE_CHUNK *
                    SIGMA_ANNIHILATOR_ACTION_COUNT);
        }
    }
}

void SigmaCandidateLoadCell(SigmaTransactionGpu transaction,
    uint transactionSlot, uint sample, out uint2 center[16],
    out uint2 right[16], out uint2 down[16])
{
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
    {
        center[lane] = SigmaCandidateEndpointLane(transaction,
            transactionSlot, sample, false, lane);
        right[lane] = SigmaCandidateEndpointLane(transaction,
            transactionSlot, sample, true, lane);
        down[lane] = SigmaCandidateEndpointLane(transaction,
            transactionSlot, SIGMA_PAGE_SAMPLE_COUNT + sample, true, lane);
    }
}

bool SigmaCandidateCloseRecord(inout uint4 record, bool associatorStrong)
{
    uint info = record.y;
    if ((info & SIGMA_CANDIDATE_CHANGED) == 0u)
    {
        record.y |= SIGMA_CANDIDATE_CLOSED;
        return true;
    }
    uint classification = SigmaTopologyClass(record.x);
    bool invalid = (record.x & SIGMA_TOPOLOGY_INVALID) != 0u;
    bool near = (record.x & SIGMA_TOPOLOGY_NEAR_ANNIHILATOR) != 0u;
    bool contactNull = (record.x & SIGMA_TOPOLOGY_CONTACT_NULL) != 0u;
    bool discontinuity = (record.x &
        SIGMA_TOPOLOGY_DISCONTINUITY_EVIDENCE) != 0u;
    bool independent = (info & SIGMA_CANDIDATE_INDEPENDENT) != 0u;
    if (classification == SIGMA_TOPOLOGY_UNSUPPORTED)
        classification = SIGMA_TOPOLOGY_UNSUPPORTED;
    else if (invalid)
        classification = SIGMA_TOPOLOGY_UNRESOLVED;
    else if (near && independent &&
        (contactNull || associatorStrong || discontinuity))
        classification = SIGMA_TOPOLOGY_SINGULAR;
    else if (near || contactNull || associatorStrong || discontinuity)
        classification = SIGMA_TOPOLOGY_UNRESOLVED;
    else
        classification = SIGMA_TOPOLOGY_REGULAR;
    record.x = (record.x & ~(SIGMA_TOPOLOGY_CLASS_MASK |
        SIGMA_TOPOLOGY_ASSOCIATOR)) | classification;
    if (associatorStrong)
        record.x |= SIGMA_TOPOLOGY_ASSOCIATOR;
    bool closed = classification == SIGMA_TOPOLOGY_REGULAR ||
        classification == SIGMA_TOPOLOGY_SINGULAR ||
        classification == SIGMA_TOPOLOGY_UNSUPPORTED;
    record.y |= closed ? SIGMA_CANDIDATE_CLOSED : SIGMA_CANDIDATE_FAILED;
    return closed;
}

[numthreads(64, 1, 1)]
void ValidateCandidateAssociatorChunk(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint lane = threadId.x;
    if (lane == 0u)
    {
        SigmaCandidatePrepareGroup(
            SIGMA_STREAM_OPCODE_TRANSITION_ASSOCIATOR, groupId.x, 1u,
            SIGMA_CANDIDATE_CELL_CHUNKS);
    }
    GroupMemoryBarrierWithGroupSync();
    if (CandidateGroupActive == 0u)
        return;

    uint transactionSlot = CandidateGroupTransactionSlot;
    uint chunk = CandidateGroupChunk;
    SigmaTransactionGpu transaction = CandidateGroupTransaction;
    uint sample = chunk * SIGMA_CANDIDATE_EDGE_CHUNK + lane;
    uint horizontalAddress = SigmaCandidateRecordAddress(transactionSlot,
        sample);
    uint verticalAddress = SigmaCandidateRecordAddress(transactionSlot,
        SIGMA_PAGE_SAMPLE_COUNT + sample);
    uint4 horizontal = _StreamCandidateTransitions[horizontalAddress];
    uint4 vertical = _StreamCandidateTransitions[verticalAddress];
    bool needsAssociator = (((horizontal.x | vertical.x) &
        SIGMA_TOPOLOGY_NEAR_ANNIHILATOR) != 0u) &&
        (((horizontal.y | vertical.y) & SIGMA_CANDIDATE_CHANGED) != 0u);

    bool associatorStrong = false;
    if (needsAssociator)
    {
        uint2 center[16];
        uint2 right[16];
        uint2 down[16];
        SigmaCandidateLoadCell(transaction, transactionSlot, sample,
            center, right, down);
        uint centerValid;
        uint rightValid;
        uint downValid;
        bool allContact = SigmaStateHasContact(center, centerValid) &&
            SigmaStateHasContact(right, rightValid) &&
            SigmaStateHasContact(down, downValid) &&
            centerValid != 0u && rightValid != 0u && downValid != 0u;
        if (allContact)
        {
            uint valid = 1u;
            uint2 deltaU[16];
            uint2 deltaV[16];
            [unroll]
            for (uint coordinate = 0u; coordinate < 16u; ++coordinate)
            {
                deltaU[coordinate] = SigmaQ48SubChecked(right[coordinate],
                    center[coordinate], valid);
                deltaV[coordinate] = SigmaQ48SubChecked(down[coordinate],
                    center[coordinate], valid);
            }
            uint2 associator[16];
            SigmaAssociatorPlan(center, deltaU, deltaV, associator, valid);
            uint4 error = SigmaS16L1(associator, valid);
            uint4 scale = SigmaS16L1(center, valid);
            scale = SigmaU128Add(scale, SigmaS16L1(deltaU, valid), valid);
            scale = SigmaU128Add(scale, SigmaS16L1(deltaV, valid), valid);
            if (SigmaU128Equal(scale, SIGMA_U128_ZERO))
                scale = SIGMA_U128_ONE;
            associatorStrong = valid != 0u &&
                SigmaRelativeAssociatorGate(error, scale,
                    _AssociatorShift);
        }
    }

    bool horizontalClosed = SigmaCandidateCloseRecord(horizontal,
        associatorStrong);
    bool verticalClosed = SigmaCandidateCloseRecord(vertical,
        associatorStrong);
    _StreamCandidateTransitions[horizontalAddress] = horizontal;
    _StreamCandidateTransitions[verticalAddress] = vertical;
    CandidateChunkFailure[lane] = horizontalClosed && verticalClosed
        ? 0u : 1u;
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint offset = 32u; offset > 0u; offset >>= 1u)
    {
        if (lane < offset)
            CandidateChunkFailure[lane] |=
                CandidateChunkFailure[lane + offset];
        GroupMemoryBarrierWithGroupSync();
    }
    if (lane == 0u)
    {
        SigmaTransactionGpu current = _StreamTransactions[transactionSlot];
        bool currentWork = SigmaStreamTransactionGeneration(current) ==
                SigmaStreamTransactionGeneration(transaction) &&
            current.transition.z == 1u &&
            current.transition.y == chunk;
        if (currentWork)
        {
            current.transition.w |= CandidateChunkFailure[0u];
            current.transition.y++;
            if (current.transition.y == SIGMA_CANDIDATE_CELL_CHUNKS)
            {
                current.transition.z = 2u;
                current.identity.x = current.transition.w == 0u
                    ? SIGMA_STREAM_TRANSACTION_REVALIDATE_PENDING
                    : SIGMA_STREAM_TRANSACTION_DORMANT;
                if (current.transition.w != 0u)
                    InterlockedAdd(_StreamDiagnostics[0u].transition.w, 1u);
            }
            _StreamTransactions[transactionSlot] = current;
            InterlockedAdd(_StreamDiagnostics[0u].transition.z,
                needsAssociator ? 1u : 0u);
        }
    }
}
