#pragma kernel BuildGaugeBlockFacts
#pragma kernel SelectGaugeRequest
#pragma kernel ClearGaugeTransaction
#pragma kernel TransformGaugeState
#pragma kernel CloneGaugeRawTiles
#pragma kernel FinalizeGaugeRawChains
#pragma kernel TransformGaugeProof
#pragma kernel ValidateGaugeTransform
#pragma kernel ClearGaugeTopologyPrior
#pragma kernel TransportGaugeTopologyPrior
#pragma kernel ValidateGaugeTopology
#pragma target 5.0

#include "Generated/SigmaGeneratedLayout.hlsl"
#include "Generated/SigmaGeneratedTables.hlsl"
#include "Sedenion16.hlsl"
#include "SigmaExactCompare.hlsl"
#include "SigmaGaugeAbi.hlsl"

StructuredBuffer<uint2> _SourceCarrierState;
StructuredBuffer<uint4> _SourceTopologyTransitions;
RWStructuredBuffer<uint4> _TargetTopologyTransitions;
StructuredBuffer<SigmaGaugeDemandGpu> _GaugeDemand;
StructuredBuffer<SigmaConstraintCertificateGpu> _GaugeSourceCertificates;
StructuredBuffer<SigmaQ48Bounds> _GaugeSourceBounds;
StructuredBuffer<SigmaConstraintBlockGpu> _GaugeSourceBlocks;
StructuredBuffer<SigmaGaugeRawCloneGpu> _GaugeRawClonePlan;

RWStructuredBuffer<uint2> _TargetCarrierState;
RWStructuredBuffer<SigmaConstraintCertificateGpu> _GaugeTargetCertificates;
RWStructuredBuffer<SigmaQ48Bounds> _GaugeTargetBounds;
RWStructuredBuffer<SigmaConstraintBlockGpu> _GaugeTargetBlocks;
RWStructuredBuffer<SigmaRawObservationTileGpu> _GaugeRawTiles;
RWStructuredBuffer<uint4> _GaugeRawWords;
RWStructuredBuffer<uint4> _GaugeBlockFacts;
RWStructuredBuffer<SigmaGaugeRequestGpu> _GaugeRequests;
RWStructuredBuffer<SigmaGaugeDemandGpu> _GaugeTargetDemand;
RWStructuredBuffer<uint4> _GaugeRawCloneStatus;
RWStructuredBuffer<uint> _GaugeTargetRawHeads;
RWStructuredBuffer<uint4> _GaugeStatus;

uint _SourceCarrierPageSlot;
uint _SourceCarrierPageCapacity;
uint _TargetCarrierPageSlot;
uint _TargetCarrierPageCapacity;
uint _SourceTopologyPageSlot;
uint _SourceTopologyPageCapacity;
uint _TargetTopologyPageSlot;
uint _TargetTopologyPageCapacity;
uint _GaugeSourceProofSlot;
uint _GaugeTargetProofSlot;
uint _GaugeProofCapacity;
uint _GaugeRequestIndex;
uint _GaugeRequestCapacity;
uint _GaugeSourceGeneration;
uint _GaugeTargetRevision;
uint _GaugeRawCloneCount;
uint _GaugeRawTileCapacity;

SigmaGaugeRequestGpu SigmaGaugeActiveRequest()
{
    return _GaugeRequests[_GaugeRequestIndex];
}

groupshared uint GaugeAllNull;
groupshared uint GaugeAllTopologySafe;
groupshared uint4 GaugeCandidateControl[64u];
groupshared uint4 GaugeCandidateRegion[64u];
groupshared uint4 GaugeCandidateMetric[64u];
groupshared uint4 GaugeCandidateEvidence[64u];

uint SigmaGaugeStateAddress(uint pageSlot, uint sample, uint lane)
{
    return pageSlot * SIGMA_PAGE_LANE_COUNT + sample * 16u + lane;
}

void SigmaGaugeLoadNull(out uint2 state[16])
{
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
    {
        if (lane == (uint)SIGMA_Z_NULL_DYAD.x)
            state[lane] = SIGMA_Z_NULL_DYAD.y < 0
                ? uint2(0u, 0xffff0000u) : uint2(0u, 0x00010000u);
        else if (lane == (uint)SIGMA_Z_NULL_DYAD.z)
            state[lane] = SIGMA_Z_NULL_DYAD.w < 0
                ? uint2(0u, 0xffff0000u) : uint2(0u, 0x00010000u);
        else
            state[lane] = 0u;
    }
}

bool SigmaGaugeStateIsNull(uint pageSlot, uint sample)
{
    uint2 nullState[16];
    SigmaGaugeLoadNull(nullState);
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
        if (!SigmaU64Equal(_SourceCarrierState[
                SigmaGaugeStateAddress(pageSlot, sample, lane)], nullState[lane]))
            return false;
    return true;
}

bool SigmaGaugeTargetTransitionAffected(uint transition,
    SigmaGaugeRequestGpu request)
{
    uint axis = transition / SIGMA_PAGE_SAMPLE_COUNT;
    uint sample = transition & (SIGMA_PAGE_SAMPLE_COUNT - 1u);
    uint x = sample & 63u;
    uint y = sample >> 6u;
    uint coordinate = request.control.z == SIGMA_GAUGE_AXIS_X ? x : y;
    int oriented = SigmaGaugeOrientedCoordinate((int)coordinate, request);
    bool affected = oriented >= 0 &&
        oriented < (int)request.region.x * 8;
    if (!affected && axis == request.control.z && coordinate < 63u)
    {
        int neighbour = SigmaGaugeOrientedCoordinate((int)coordinate + 1,
            request);
        affected = neighbour >= 0 &&
            neighbour < (int)request.region.x * 8;
    }
    return affected;
}

uint2 SigmaGaugeMidpoint(uint2 a, uint2 b, inout uint valid)
{
    uint2 lo = SigmaQ48Min(a, b);
    uint2 hi = SigmaQ48Max(a, b);
    uint2 delta = SigmaQ48SubChecked(hi, lo, valid);
    uint2 half = SigmaQ48ShiftRightNearestEven(delta, 1u, valid);
    return SigmaQ48AddChecked(lo, half, valid);
}

bool SigmaGaugeBandIsFree(uint axis, uint axisBlock)
{
    [unroll]
    for (uint transverse = 0u; transverse < 8u; ++transverse)
    {
        uint block = axis == SIGMA_GAUGE_AXIS_X
            ? SigmaGaugeBlock(axisBlock, transverse)
            : SigmaGaugeBlock(transverse, axisBlock);
        uint4 fact = _GaugeBlockFacts[block];
        if (fact.x == 0u || fact.y == 0u)
            return false;
    }
    return true;
}

bool SigmaGaugeBandIsTopologySafe(uint axis, uint axisBlock)
{
    [unroll]
    for (uint transverse = 0u; transverse < 8u; ++transverse)
    {
        uint block = axis == SIGMA_GAUGE_AXIS_X
            ? SigmaGaugeBlock(axisBlock, transverse)
            : SigmaGaugeBlock(transverse, axisBlock);
        if (_GaugeBlockFacts[block].z == 0u)
            return false;
    }
    return true;
}

uint SigmaGaugeFindSpan(uint sourceAxisBlock, uint axis, uint direction)
{
    uint maximum = direction == SIGMA_GAUGE_POSITIVE
        ? 8u - sourceAxisBlock : sourceAxisBlock + 1u;
    [unroll]
    for (uint span = 3u; span <= 8u; ++span)
    {
        if (span > maximum)
            break;
        int sign = direction == SIGMA_GAUGE_NEGATIVE ? -1 : 1;
        uint terminal0 = (uint)((int)sourceAxisBlock + sign * (int)(span - 2u));
        uint terminal1 = (uint)((int)sourceAxisBlock + sign * (int)(span - 1u));
        bool safe = true;
        [unroll]
        for (uint localBand = 0u; localBand < 8u; ++localBand)
        {
            if (localBand >= span)
                break;
            uint band = (uint)((int)sourceAxisBlock + sign * (int)localBand);
            safe = safe && SigmaGaugeBandIsTopologySafe(axis, band);
        }
        if (safe && SigmaGaugeBandIsFree(axis, terminal0) &&
            SigmaGaugeBandIsFree(axis, terminal1))
            return span;
    }
    return 0u;
}

[numthreads(64, 1, 1)]
void BuildGaugeBlockFacts(uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint block = groupId.x;
    uint local = groupThreadId.x;
    if (block >= 64u)
        return;
    if (local == 0u)
    {
        GaugeAllNull = 1u;
        GaugeAllTopologySafe = 1u;
    }
    GroupMemoryBarrierWithGroupSync();
    if (_SourceCarrierPageSlot >= _SourceCarrierPageCapacity ||
        !SigmaGaugeStateIsNull(_SourceCarrierPageSlot,
            SigmaProofPageSample(block, local)))
        InterlockedAnd(GaugeAllNull, 0u);
    if (_SourceTopologyPageSlot >= _SourceTopologyPageCapacity)
        InterlockedAnd(GaugeAllTopologySafe, 0u);
    else
    {
        uint sample = SigmaProofPageSample(block, local);
        [unroll]
        for (uint axis = 0u; axis < 2u; ++axis)
        {
            uint coordinate = axis == 0u ? (sample & 63u) : (sample >> 6u);
            if (coordinate == 63u)
                continue;
            uint transition = axis * SIGMA_PAGE_SAMPLE_COUNT + sample;
            uint4 topology = _SourceTopologyTransitions[
                _SourceTopologyPageSlot * SIGMA_TRANSITIONS_PER_PAGE +
                transition];
            uint classification = SigmaTopologyClass(topology.x);
            if (classification == SIGMA_TOPOLOGY_UNRESOLVED)
                InterlockedAnd(GaugeAllTopologySafe, 0u);
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (local == 0u)
    {
        SigmaConstraintBlockGpu proof = _GaugeSourceBlocks[
            SigmaConstraintBlockAddress(_GaugeSourceProofSlot, block)];
        bool proofEmpty = proof.counts.x == 0u && proof.counts.y == 0u &&
            proof.counts.z == SIGMA_INVALID_RAW_TILE;
        _GaugeBlockFacts[block] = uint4(GaugeAllNull,
            proofEmpty ? 1u : 0u, GaugeAllTopologySafe, 0u);
    }
}

[numthreads(64, 1, 1)]
void SelectGaugeRequest(uint3 groupThreadId : SV_GroupThreadID)
{
    uint block = groupThreadId.x;
    GaugeCandidateControl[block] = 0u;
    GaugeCandidateRegion[block] = 0u;
    GaugeCandidateMetric[block] = 0u;
    GaugeCandidateEvidence[block] = 0u;
    if (_GaugeRequestIndex < _GaugeRequestCapacity)
    {
        SigmaGaugeDemandGpu demand = _GaugeDemand[
            SigmaConstraintBlockAddress(_GaugeSourceProofSlot, block)];
        if (demand.trigger.x != 0u &&
            demand.evidence.w == _GaugeTargetRevision)
        {
            uint axis = demand.trigger.w;
            uint sourceAxisBlock = axis == SIGMA_GAUGE_AXIS_X
                ? SigmaGaugeBlockX(block) : SigmaGaugeBlockY(block);
            uint positive = SigmaGaugeFindSpan(sourceAxisBlock, axis,
                SIGMA_GAUGE_POSITIVE);
            uint negative = SigmaGaugeFindSpan(sourceAxisBlock, axis,
                SIGMA_GAUGE_NEGATIVE);
            uint direction = positive != 0u &&
                (negative == 0u || positive <= negative)
                ? SIGMA_GAUGE_POSITIVE : SIGMA_GAUGE_NEGATIVE;
            uint span = direction == SIGMA_GAUGE_POSITIVE ? positive : negative;
            if (span != 0u)
            {
                GaugeCandidateControl[block] = uint4(1u, block, axis, direction);
                GaugeCandidateRegion[block] = uint4(span,
                    _GaugeSourceProofSlot, _GaugeSourceGeneration,
                    _GaugeTargetRevision);
                GaugeCandidateMetric[block] = demand.metric;
                GaugeCandidateEvidence[block] = demand.evidence;
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (block != 0u || _GaugeRequestIndex >= _GaugeRequestCapacity)
        return;
    uint best = 0xffffffffu;
    [unroll]
    for (uint candidate = 0u; candidate < 64u; ++candidate)
    {
        if (GaugeCandidateControl[candidate].x == 0u)
            continue;
        if (best == 0xffffffffu || SigmaQ48Less(
                GaugeCandidateMetric[best].xy,
                GaugeCandidateMetric[candidate].xy) ||
            (SigmaU64Equal(GaugeCandidateMetric[best].xy,
                GaugeCandidateMetric[candidate].xy) && candidate < best))
            best = candidate;
    }
    SigmaGaugeRequestGpu request = (SigmaGaugeRequestGpu)0;
    if (best != 0xffffffffu)
    {
        request.control = GaugeCandidateControl[best];
        request.region = GaugeCandidateRegion[best];
        request.metric = GaugeCandidateMetric[best];
        request.evidence = GaugeCandidateEvidence[best];
    }
    _GaugeRequests[_GaugeRequestIndex] = request;
}

[numthreads(64, 1, 1)]
void ClearGaugeTransaction(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index < SIGMA_CERTIFICATES_PER_PAGE)
        _GaugeTargetCertificates[_GaugeTargetProofSlot *
            SIGMA_CERTIFICATES_PER_PAGE + index] =
            (SigmaConstraintCertificateGpu)0;
    if (index < SIGMA_CERTIFICATE_BOUNDS_PER_PAGE)
        _GaugeTargetBounds[_GaugeTargetProofSlot *
            SIGMA_CERTIFICATE_BOUNDS_PER_PAGE + index] = (SigmaQ48Bounds)0;
    if (index < 64u)
    {
        _GaugeTargetBlocks[SigmaConstraintBlockAddress(
            _GaugeTargetProofSlot, index)] = (SigmaConstraintBlockGpu)0;
        _GaugeTargetDemand[SigmaConstraintBlockAddress(
            _GaugeTargetProofSlot, index)] = (SigmaGaugeDemandGpu)0;
        _GaugeTargetRawHeads[index] = SIGMA_INVALID_RAW_TILE;
    }
    if (index < SIGMA_GAUGE_STATUS_WORD4)
        _GaugeStatus[index] = 0u;
}

void SigmaGaugeLoadSource(uint sample, out uint2 state[16])
{
    uint baseAddress = SigmaGaugeStateAddress(_SourceCarrierPageSlot, sample, 0u);
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
        state[lane] = _SourceCarrierState[baseAddress + lane];
}

void SigmaGaugeStoreTarget(uint sample, uint2 state[16])
{
    uint baseAddress = SigmaGaugeStateAddress(_TargetCarrierPageSlot, sample, 0u);
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
        _TargetCarrierState[baseAddress + lane] = state[lane];
}

[numthreads(64, 1, 1)]
void TransformGaugeState(uint3 id : SV_DispatchThreadID)
{
    uint targetSample = id.x;
    if (targetSample >= SIGMA_PAGE_SAMPLE_COUNT ||
        _SourceCarrierPageSlot >= _SourceCarrierPageCapacity ||
        _TargetCarrierPageSlot >= _TargetCarrierPageCapacity)
        return;
    uint x = targetSample & 63u;
    uint y = targetSample >> 6u;
    SigmaGaugeRequestGpu request = SigmaGaugeActiveRequest();
    if (request.control.x == 0u)
        return;
    int targetAxis = request.control.z == SIGMA_GAUGE_AXIS_X
        ? (int)x : (int)y;
    int orientedTarget = SigmaGaugeOrientedCoordinate(targetAxis, request);
    int regionLength = (int)request.region.x * 8;
    if (orientedTarget < 0 || orientedTarget >= regionLength)
        return; // BeginNextGeneration already cloned identity outside chi support.

    // chi^-1 is continuous at both ends of the bounded support: the requested
    // band expands 2x, while the two proven-null bands contract into one.  The
    // outer endpoint therefore remains fixed instead of deleting a null interval.
    int retainedLength = regionLength -
        (int)SIGMA_GAUGE_REQUIRED_NULL_BANDS * 8;
    int compressionStart = retainedLength + 8;
    int orientedOldTimesTwo;
    if (orientedTarget < 16)
        orientedOldTimesTwo = orientedTarget;
    else if (orientedTarget < compressionStart)
        orientedOldTimesTwo = (orientedTarget - 8) * 2;
    else
        orientedOldTimesTwo = retainedLength * 2 +
            (orientedTarget - compressionStart) * 4;
    int sourceStart = (int)SigmaGaugeSourceAxisBlock(request) * 8;
    int oldAxisTimesTwo = request.control.w == SIGMA_GAUGE_NEGATIVE
        ? (sourceStart + 7) * 2 - orientedOldTimesTwo
        : sourceStart * 2 + orientedOldTimesTwo;
    int oldAxis = oldAxisTimesTwo >> 1;
    uint sourceX = request.control.z == SIGMA_GAUGE_AXIS_X
        ? (uint)oldAxis : x;
    uint sourceY = request.control.z == SIGMA_GAUGE_AXIS_Y
        ? (uint)oldAxis : y;
    uint sourceSample = sourceY * 64u + sourceX;
    uint2 state[16];
    SigmaGaugeLoadSource(sourceSample, state);
    if ((oldAxisTimesTwo & 1) != 0)
    {
        uint transition = request.control.z * SIGMA_PAGE_SAMPLE_COUNT +
            sourceSample;
        uint4 topology = _SourceTopologyTransitions[
            _SourceTopologyPageSlot * SIGMA_TRANSITIONS_PER_PAGE + transition];
        uint classification = SigmaTopologyClass(topology.x);
        if (classification == SIGMA_TOPOLOGY_UNRESOLVED)
        {
            InterlockedOr(_GaugeStatus[0].w, SIGMA_GAUGE_FAILED);
            InterlockedAdd(_GaugeStatus[1].x, 1u);
            return;
        }
        if (classification == SIGMA_TOPOLOGY_REGULAR ||
            classification == SIGMA_TOPOLOGY_UNSUPPORTED)
        {
            uint neighbourSample = request.control.z == SIGMA_GAUGE_AXIS_X
                ? sourceSample + 1u : sourceSample + 64u;
            uint2 neighbour[16];
            SigmaGaugeLoadSource(neighbourSample, neighbour);
            uint valid = 1u;
            [unroll]
            for (uint lane = 0u; lane < 16u; ++lane)
                state[lane] = SigmaGaugeMidpoint(state[lane], neighbour[lane],
                    valid);
            if (valid == 0u)
            {
                InterlockedOr(_GaugeStatus[0].w, SIGMA_GAUGE_FAILED);
                InterlockedAdd(_GaugeStatus[1].y, 1u);
                return;
            }
        }
        // A stable singular sample takes the floor-side value; the exact
        // transition is thereby moved to the following sub-edge, never averaged.
    }
    SigmaGaugeStoreTarget(targetSample, state);
    InterlockedAdd(_GaugeStatus[0].x, 1u);
}

[numthreads(64, 1, 1)]
void CloneGaugeRawTiles(uint3 id : SV_DispatchThreadID)
{
    uint planIndex = id.x;
    if (planIndex >= _GaugeRawCloneCount)
        return;
    SigmaGaugeRawCloneGpu plan = _GaugeRawClonePlan[planIndex];
    uint sourceRaw = plan.transfer.x;
    uint targetRaw = plan.transfer.y;
    uint targetBlock = plan.transfer.z;
    uint sourceBlock = plan.transfer.w;
    if (sourceRaw >= _GaugeRawTileCapacity || targetRaw >= _GaugeRawTileCapacity)
    {
        _GaugeRawCloneStatus[planIndex] = uint4(0u, targetRaw, targetBlock,
            SIGMA_INVALID_RAW_TILE);
        InterlockedOr(_GaugeStatus[0].w, SIGMA_GAUGE_FAILED);
        return;
    }
    SigmaRawObservationTileGpu source = _GaugeRawTiles[sourceRaw];
    SigmaGaugeRequestGpu request = SigmaGaugeActiveRequest();
    SigmaRawObservationTileGpu target = source;
    target.identity.x = SIGMA_INVALID_RAW_TILE;
    target.identity.z = (_GaugeTargetProofSlot << 6u) | targetBlock;
    target.identity.w = _GaugeTargetRevision;
    uint2 sourceMask = source.provenance.zw;
    uint2 targetMask = 0u;
    [loop]
    for (uint targetLocal = 0u; targetLocal < 64u; ++targetLocal)
    [unroll]
    for (uint word = 0u; word < SIGMA_RAW_WORD4_PER_SAMPLE; ++word)
        _GaugeRawWords[targetRaw * SIGMA_RAW_WORD4_PER_TILE +
            targetLocal * SIGMA_RAW_WORD4_PER_SAMPLE + word] = 0u;
    [loop]
    for (uint sourceLocal = 0u; sourceLocal < 64u; ++sourceLocal)
    {
        bool selected = sourceLocal < 32u
            ? (sourceMask.x & (1u << sourceLocal)) != 0u
            : (sourceMask.y & (1u << (sourceLocal - 32u))) != 0u;
        if (!selected)
            continue;
        uint sourcePageSample = SigmaProofPageSample(sourceBlock, sourceLocal);
        uint targetPageSample;
        if (SigmaGaugeMapSourceSample(sourcePageSample, request,
                targetPageSample) == 0u ||
            SigmaProofBlockForPageSample(targetPageSample) != targetBlock)
            continue;
        uint targetLocal = SigmaProofLocalForPageSample(targetPageSample);
        if (targetLocal < 32u)
            targetMask.x |= 1u << targetLocal;
        else
            targetMask.y |= 1u << (targetLocal - 32u);
        [unroll]
        for (uint word = 0u; word < SIGMA_RAW_WORD4_PER_SAMPLE; ++word)
            _GaugeRawWords[targetRaw * SIGMA_RAW_WORD4_PER_TILE +
                targetLocal * SIGMA_RAW_WORD4_PER_SAMPLE + word] =
                _GaugeRawWords[sourceRaw * SIGMA_RAW_WORD4_PER_TILE +
                    sourceLocal * SIGMA_RAW_WORD4_PER_SAMPLE + word];
    }
    target.provenance.zw = targetMask;
    bool used = any(targetMask != 0u);
    if (used)
        _GaugeRawTiles[targetRaw] = target;
    _GaugeRawCloneStatus[planIndex] = uint4(used ? 1u : 0u, targetRaw,
        targetBlock, SIGMA_INVALID_RAW_TILE);
}

[numthreads(64, 1, 1)]
void FinalizeGaugeRawChains(uint3 id : SV_DispatchThreadID)
{
    uint block = id.x;
    if (block >= 64u)
        return;
    uint head = SIGMA_INVALID_RAW_TILE;
    for (int planIndex = (int)_GaugeRawCloneCount - 1; planIndex >= 0;
        --planIndex)
    {
        uint4 status = _GaugeRawCloneStatus[planIndex];
        if (status.x == 0u || status.z != block)
            continue;
        SigmaRawObservationTileGpu raw = _GaugeRawTiles[status.y];
        raw.identity.x = head;
        _GaugeRawTiles[status.y] = raw;
        status.w = head;
        _GaugeRawCloneStatus[planIndex] = status;
        head = status.y;
        InterlockedAdd(_GaugeStatus[0].z, 1u);
    }
    _GaugeTargetRawHeads[block] = head;
}

bool SigmaGaugeMaskBit(uint2 mask, uint bit)
{
    return bit < 32u ? (mask.x & (1u << bit)) != 0u
        : (mask.y & (1u << (bit - 32u))) != 0u;
}

void SigmaGaugeSetMaskBit(inout uint2 mask, uint bit)
{
    if (bit < 32u) mask.x |= 1u << bit;
    else mask.y |= 1u << (bit - 32u);
}

[numthreads(1, 1, 1)]
void TransformGaugeProof(uint3 groupId : SV_GroupID)
{
    uint targetBlock = groupId.x;
    if (targetBlock >= 64u)
        return;
    uint targetBlockX = SigmaGaugeBlockX(targetBlock);
    uint targetBlockY = SigmaGaugeBlockY(targetBlock);
    SigmaGaugeRequestGpu request = SigmaGaugeActiveRequest();
    if (request.control.x == 0u)
        return;
    uint targetAxisBlock = request.control.z == SIGMA_GAUGE_AXIS_X
        ? targetBlockX : targetBlockY;
    int orientedTargetBlock = SigmaGaugeOrientedCoordinate(
        (int)targetAxisBlock * 8, request) / 8;
    int sourceAxisBlock = (int)targetAxisBlock;
    if (orientedTargetBlock >= 0 &&
        orientedTargetBlock < (int)request.region.x)
    {
        int orientedSourceBlock = orientedTargetBlock < 2
            ? 0 : orientedTargetBlock - 1;
        sourceAxisBlock = SigmaGaugePageCoordinate(orientedSourceBlock * 8,
            request) / 8;
    }
    uint sourceBlockX = request.control.z == SIGMA_GAUGE_AXIS_X
        ? (uint)sourceAxisBlock : targetBlockX;
    uint sourceBlockY = request.control.z == SIGMA_GAUGE_AXIS_Y
        ? (uint)sourceAxisBlock : targetBlockY;
    uint sourceBlock = SigmaGaugeBlock(sourceBlockX, sourceBlockY);
    SigmaConstraintBlockGpu sourceMeta = _GaugeSourceBlocks[
        SigmaConstraintBlockAddress(_GaugeSourceProofSlot, sourceBlock)];
    uint outputCount = 0u;
    uint outputBound = 0u;
    uint meetMask = 0u;
    uint roleMask = 0u;
    uint independentMask = 0u;
    SigmaConstraintCertificateGpu output[4];
    [unroll]
    for (uint clear = 0u; clear < 4u; ++clear)
        output[clear] = (SigmaConstraintCertificateGpu)0;
    [loop]
    for (uint sourceCertificate = 0u;
        sourceCertificate < min(sourceMeta.counts.x, 4u); ++sourceCertificate)
    {
        SigmaConstraintCertificateGpu certificate = _GaugeSourceCertificates[
            SigmaCertificateAddress(_GaugeSourceProofSlot, sourceBlock,
                sourceCertificate)];
        uint2 mappedMask = 0u;
        [loop]
        for (uint sourceLocal = 0u; sourceLocal < 64u; ++sourceLocal)
        {
            if (!SigmaGaugeMaskBit(certificate.sampleMask, sourceLocal))
                continue;
            uint sourceSample = SigmaProofPageSample(sourceBlock, sourceLocal);
            uint targetSample;
            if (SigmaGaugeMapSourceSample(sourceSample, request,
                    targetSample) != 0u &&
                SigmaProofBlockForPageSample(targetSample) == targetBlock)
                SigmaGaugeSetMaskBit(mappedMask,
                    SigmaProofLocalForPageSample(targetSample));
        }
        if (!any(mappedMask != 0u) || outputCount >= 4u)
            continue;
        certificate.sampleMask = mappedMask;
        certificate.range.y = outputBound;
        uint sourceBoundCursor = certificate.range.y;
        // Source range.y was replaced above; recover it from storage again.
        SigmaConstraintCertificateGpu original = _GaugeSourceCertificates[
            SigmaCertificateAddress(_GaugeSourceProofSlot, sourceBlock,
                sourceCertificate)];
        sourceBoundCursor = original.range.y;
        uint laneCursor = 0u;
        [loop]
        for (uint lane = 0u; lane < 16u; ++lane)
        {
            if ((certificate.identity.x & (1u << lane)) == 0u)
                continue;
            _GaugeTargetBounds[SigmaCertificateBoundAddress(
                _GaugeTargetProofSlot, targetBlock, outputBound++)] =
                _GaugeSourceBounds[SigmaCertificateBoundAddress(
                    _GaugeSourceProofSlot, sourceBlock,
                    sourceBoundCursor + laneCursor++)];
        }
        output[outputCount++] = certificate;
        meetMask |= certificate.identity.x;
        roleMask |= certificate.range.x;
    }
    [loop]
    for (uint lane = 0u; lane < 16u; ++lane)
    [loop]
    for (uint first = 0u; first < outputCount; ++first)
    [loop]
    for (uint second = first + 1u; second < outputCount; ++second)
    {
        uint laneBit = 1u << lane;
        if ((output[first].identity.x & laneBit) == 0u ||
            (output[second].identity.x & laneBit) == 0u ||
            output[first].identity.z == 0u ||
            output[first].identity.z == output[second].identity.z ||
            !any((output[first].sampleMask & output[second].sampleMask) != 0u))
            continue;
        independentMask |= laneBit;
    }
    [unroll]
    for (uint destination = 0u; destination < 4u; ++destination)
        _GaugeTargetCertificates[SigmaCertificateAddress(_GaugeTargetProofSlot,
            targetBlock, destination)] = output[destination];
    uint rawHead = _GaugeTargetRawHeads[targetBlock];
    SigmaConstraintBlockGpu targetMeta;
    targetMeta.counts = uint4(outputCount, outputBound, rawHead,
        rawHead != SIGMA_INVALID_RAW_TILE ? 1u : 0u);
    targetMeta.proof = uint4(meetMask, roleMask, independentMask,
        _GaugeTargetRevision);
    _GaugeTargetBlocks[SigmaConstraintBlockAddress(_GaugeTargetProofSlot,
        targetBlock)] = targetMeta;
    InterlockedAdd(_GaugeStatus[0].y, 1u);
}

[numthreads(64, 1, 1)]
void ValidateGaugeTransform(uint3 id : SV_DispatchThreadID)
{
    uint sourceSample = id.x;
    if (sourceSample >= SIGMA_PAGE_SAMPLE_COUNT)
        return;
    uint targetSample;
    SigmaGaugeRequestGpu request = SigmaGaugeActiveRequest();
    if (request.control.x == 0u)
        return;
    bool retained = SigmaGaugeMapSourceSample(sourceSample, request,
        targetSample) != 0u;
    if (!retained)
    {
        if (!SigmaGaugeStateIsNull(_SourceCarrierPageSlot, sourceSample))
        {
            InterlockedOr(_GaugeStatus[0].w, SIGMA_GAUGE_FAILED);
            InterlockedAdd(_GaugeStatus[1].z, 1u);
        }
        return;
    }
    uint sourceBase = SigmaGaugeStateAddress(_SourceCarrierPageSlot,
        sourceSample, 0u);
    uint targetBase = SigmaGaugeStateAddress(_TargetCarrierPageSlot,
        targetSample, 0u);
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
    {
        if (!SigmaU64Equal(_SourceCarrierState[sourceBase + lane],
                _TargetCarrierState[targetBase + lane]))
        {
            InterlockedOr(_GaugeStatus[0].w, SIGMA_GAUGE_FAILED);
            InterlockedAdd(_GaugeStatus[1].w, 1u);
            return;
        }
    }
    InterlockedAdd(_GaugeStatus[2].x, 1u);
}

[numthreads(64, 1, 1)]
void ClearGaugeTopologyPrior(uint3 id : SV_DispatchThreadID)
{
    uint transition = id.x;
    if (transition >= SIGMA_TRANSITIONS_PER_PAGE ||
        _TargetTopologyPageSlot >= _TargetTopologyPageCapacity)
        return;
    SigmaGaugeRequestGpu request = SigmaGaugeActiveRequest();
    if (!SigmaGaugeTargetTransitionAffected(transition, request))
        return;
    _TargetTopologyTransitions[_TargetTopologyPageSlot *
        SIGMA_TRANSITIONS_PER_PAGE + transition] = uint4(SigmaTopologyPack(
            SIGMA_TOPOLOGY_UNRESOLVED, 255u, SIGMA_TOPOLOGY_INVALID),
            0u, 0u, 0u);
}

[numthreads(64, 1, 1)]
void TransportGaugeTopologyPrior(uint3 id : SV_DispatchThreadID)
{
    uint sourceTransition = id.x;
    if (sourceTransition >= SIGMA_TRANSITIONS_PER_PAGE ||
        _SourceTopologyPageSlot >= _SourceTopologyPageCapacity ||
        _TargetTopologyPageSlot >= _TargetTopologyPageCapacity)
        return;
    uint axis = sourceTransition / SIGMA_PAGE_SAMPLE_COUNT;
    uint sourceSample = sourceTransition & (SIGMA_PAGE_SAMPLE_COUNT - 1u);
    uint x = sourceSample & 63u;
    uint y = sourceSample >> 6u;
    uint coordinate = axis == SIGMA_GAUGE_AXIS_X ? x : y;
    if (coordinate == 63u)
        return; // Cross-page transitions are unchanged or fail at page locality.
    uint neighbourSample = axis == SIGMA_GAUGE_AXIS_X
        ? sourceSample + 1u : sourceSample + 64u;
    SigmaGaugeRequestGpu request = SigmaGaugeActiveRequest();
    uint targetA;
    uint targetB;
    if (SigmaGaugeMapSourceSample(sourceSample, request, targetA) == 0u ||
        SigmaGaugeMapSourceSample(neighbourSample, request, targetB) == 0u)
        return;
    uint targetCoordinateA = axis == SIGMA_GAUGE_AXIS_X
        ? (targetA & 63u) : (targetA >> 6u);
    uint targetCoordinateB = axis == SIGMA_GAUGE_AXIS_X
        ? (targetB & 63u) : (targetB >> 6u);
    if (targetCoordinateB <= targetCoordinateA ||
        targetCoordinateB - targetCoordinateA > 2u)
        return;
    uint4 source = _SourceTopologyTransitions[_SourceTopologyPageSlot *
        SIGMA_TRANSITIONS_PER_PAGE + sourceTransition];
    uint classification = SigmaTopologyClass(source.x);
    if (classification == SIGMA_TOPOLOGY_UNRESOLVED)
    {
        InterlockedOr(_GaugeStatus[0].w, SIGMA_GAUGE_FAILED);
        InterlockedAdd(_GaugeStatus[3].w, 1u);
        return;
    }
    uint targetTransition = axis * SIGMA_PAGE_SAMPLE_COUNT + targetA;
    if (targetCoordinateB - targetCoordinateA == 2u &&
        classification == SIGMA_TOPOLOGY_SINGULAR)
        targetTransition += axis == SIGMA_GAUGE_AXIS_X ? 1u : 64u;
    _TargetTopologyTransitions[_TargetTopologyPageSlot *
        SIGMA_TRANSITIONS_PER_PAGE + targetTransition] = source;
    if (targetCoordinateB - targetCoordinateA == 2u &&
        classification != SIGMA_TOPOLOGY_SINGULAR)
    {
        uint second = targetTransition +
            (axis == SIGMA_GAUGE_AXIS_X ? 1u : 64u);
        _TargetTopologyTransitions[_TargetTopologyPageSlot *
            SIGMA_TRANSITIONS_PER_PAGE + second] = source;
    }
}

[numthreads(64, 1, 1)]
void ValidateGaugeTopology(uint3 id : SV_DispatchThreadID)
{
    uint transition = id.x;
    if (transition >= SIGMA_TRANSITIONS_PER_PAGE ||
        _TargetTopologyPageSlot >= _TargetTopologyPageCapacity)
        return;
    SigmaGaugeRequestGpu request = SigmaGaugeActiveRequest();
    bool affected = SigmaGaugeTargetTransitionAffected(transition, request);
    if (affected)
    {
        uint4 topology = _TargetTopologyTransitions[
            _TargetTopologyPageSlot * SIGMA_TRANSITIONS_PER_PAGE + transition];
        uint classification = SigmaTopologyClass(topology.x);
        if (classification == SIGMA_TOPOLOGY_UNRESOLVED)
        {
            InterlockedOr(_GaugeStatus[0].w, SIGMA_GAUGE_FAILED);
            InterlockedAdd(_GaugeStatus[3].x, 1u);
        }
        if (classification == SIGMA_TOPOLOGY_SINGULAR)
            InterlockedAdd(_GaugeStatus[3].y, 1u);
    }

    uint axis = transition / SIGMA_PAGE_SAMPLE_COUNT;
    uint sourceSample = transition & (SIGMA_PAGE_SAMPLE_COUNT - 1u);
    uint sourceCoordinate = axis == SIGMA_GAUGE_AXIS_X
        ? (sourceSample & 63u) : (sourceSample >> 6u);
    if (sourceCoordinate < 63u)
    {
        uint4 sourceTopology = _SourceTopologyTransitions[
            _SourceTopologyPageSlot * SIGMA_TRANSITIONS_PER_PAGE + transition];
        if (SigmaTopologyClass(sourceTopology.x) ==
            SIGMA_TOPOLOGY_SINGULAR)
        {
            uint neighbourSample = axis == SIGMA_GAUGE_AXIS_X
                ? sourceSample + 1u : sourceSample + 64u;
            uint targetA;
            uint targetB;
            if (SigmaGaugeMapSourceSample(sourceSample, request, targetA) != 0u &&
                SigmaGaugeMapSourceSample(neighbourSample, request, targetB) != 0u &&
                (targetA != sourceSample || targetB != neighbourSample))
            {
                uint targetCoordinateA = axis == SIGMA_GAUGE_AXIS_X
                    ? (targetA & 63u) : (targetA >> 6u);
                uint targetCoordinateB = axis == SIGMA_GAUGE_AXIS_X
                    ? (targetB & 63u) : (targetB >> 6u);
                uint expectedTransition = axis * SIGMA_PAGE_SAMPLE_COUNT +
                    targetA;
                if (targetCoordinateB - targetCoordinateA == 2u)
                    expectedTransition += axis == SIGMA_GAUGE_AXIS_X ? 1u : 64u;
                uint4 targetTopology = _TargetTopologyTransitions[
                    _TargetTopologyPageSlot * SIGMA_TRANSITIONS_PER_PAGE +
                    expectedTransition];
                bool identityPreserved = SigmaTopologyClass(targetTopology.x) ==
                        SIGMA_TOPOLOGY_SINGULAR &&
                    SigmaTopologyAnnihilatorId(targetTopology.x) ==
                        SigmaTopologyAnnihilatorId(sourceTopology.x) &&
                    targetTopology.y == sourceTopology.y &&
                    targetTopology.z == sourceTopology.z;
                if (!identityPreserved)
                {
                    InterlockedOr(_GaugeStatus[0].w, SIGMA_GAUGE_FAILED);
                    InterlockedAdd(_GaugeStatus[3].x, 1u);
                }
                InterlockedAdd(_GaugeStatus[3].z, 1u);
            }
        }
    }
    InterlockedAdd(_GaugeStatus[2].y, 1u);
}
