#pragma kernel BuildCarrierReadout
#pragma kernel CompactCurrentPages
#pragma kernel ResolveCarrierHalos
#pragma target 5.0

#include "SigmaCarrierAbi.hlsl"
#include "SigmaGeometryReadout.hlsl"
#include "SigmaStableScan.hlsl"

StructuredBuffer<uint2> _CarrierState;
StructuredBuffer<SigmaCarrierPageMetaGpu> _PageMetadata;
StructuredBuffer<uint> _CurrentFlags;
RWStructuredBuffer<uint> _ReadoutDirtyFlags;
RWStructuredBuffer<float4> _ReadoutVertices;

RWStructuredBuffer<uint> _CurrentPageSlots;
RWStructuredBuffer<uint> _ReadoutDrawArguments;
RWStructuredBuffer<uint> _ReadoutDirtyPageSlots;
RWStructuredBuffer<uint> _ReadoutBuildArguments;
RWStructuredBuffer<uint> _ReadoutHaloArguments;

uint _PageCapacity;

#define SIGMA_READOUT_EXTENT 65u
#define SIGMA_READOUT_SAMPLES 4225u
#define SIGMA_READOUT_VERTICES_PER_PAGE 24576u
#define SIGMA_INVALID_PAGE_SLOT 0xffffffffu

groupshared uint SigmaHaloRightSlot;
groupshared uint SigmaHaloDownSlot;
groupshared uint SigmaHaloDiagonalSlot;
groupshared uint SigmaHaloTargetSlot;

uint SigmaReadoutIndex(uint pageSlot, uint x, uint y)
{
    return pageSlot * SIGMA_READOUT_SAMPLES + y * SIGMA_READOUT_EXTENT + x;
}

bool SigmaReadoutPageVisible(uint pageSlot)
{
    if (pageSlot >= _PageCapacity || _CurrentFlags[pageSlot] == 0u)
        return false;
    SigmaCarrierPageMetaGpu metadata = _PageMetadata[pageSlot];
    return (metadata.flags & SIGMA_PAGE_PUBLISHED) != 0u;
}

[numthreads(64, 1, 1)]
void BuildCarrierReadout(uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint dirtyPageIndex = groupId.y;
    uint pageSlot = _ReadoutDirtyPageSlots[dirtyPageIndex];
    uint sample = groupId.x * 64u + groupThreadId.x;
    if (pageSlot >= _PageCapacity || sample >= SIGMA_PAGE_SAMPLE_COUNT)
        return;

    uint x = sample & 63u;
    uint y = sample >> 6u;
    uint outputIndex = SigmaReadoutIndex(pageSlot, x, y);
    if (!SigmaReadoutPageVisible(pageSlot) ||
        !SigmaCanonicalMutationEnabled())
    {
        _ReadoutVertices[outputIndex] = 0.0;
        return;
    }

    uint2 state[16];
    uint stateBase = pageSlot * SIGMA_PAGE_LANE_COUNT +
        sample * SIGMA_LANE_COUNT;
    [unroll]
    for (uint lane = 0u; lane < SIGMA_LANE_COUNT; ++lane)
        state[lane] = _CarrierState[stateBase + lane];

    float3 position;
    float informationMass;
    bool supported = SigmaGeometryReadoutPlan(state, position, informationMass);
    _ReadoutVertices[outputIndex] = supported
        ? float4(position, informationMass)
        : 0.0;
    if (sample == 0u)
        _ReadoutDirtyFlags[pageSlot] = 0u;
}

// The immutable current-generation mask is the only publication visibility
// authority. Stable scans choose execution order and have no physical meaning.
[numthreads(256, 1, 1)]
void CompactCurrentPages(uint3 groupThreadId : SV_GroupThreadID)
{
    uint lane = groupThreadId.x;
    uint active = lane < _PageCapacity && SigmaReadoutPageVisible(lane)
        ? 1u : 0u;
    uint dirty = active != 0u && _ReadoutDirtyFlags[lane] != 0u ? 1u : 0u;

    uint currentPrefix;
    uint dirtyPrefix;
    uint currentCount;
    uint dirtyCount;
    SigmaStableExclusiveScan256Dual(lane, active, dirty,
        currentPrefix, dirtyPrefix, currentCount, dirtyCount);

    if (active != 0u)
        _CurrentPageSlots[currentPrefix] = lane;
    if (dirty != 0u)
        _ReadoutDirtyPageSlots[dirtyPrefix] = lane;

    if (lane == 0u)
    {
        _ReadoutDrawArguments[0] = currentCount *
            SIGMA_READOUT_VERTICES_PER_PAGE;
        _ReadoutDrawArguments[1] = 1u;
        _ReadoutDrawArguments[2] = 0u;
        _ReadoutDrawArguments[3] = 0u;
        _ReadoutBuildArguments[0] = 64u;
        _ReadoutBuildArguments[1] = dirtyCount;
        _ReadoutBuildArguments[2] = 1u;
        _ReadoutHaloArguments[0] = 1u;
        _ReadoutHaloArguments[1] = currentCount;
        _ReadoutHaloArguments[2] = 1u;
    }
}

bool SigmaReadoutI64Equal(uint2 a, uint2 b)
{
    return all(a == b);
}

bool SigmaReadoutIncrementI64(uint2 value, out uint2 incremented)
{
    incremented = value;
    if (value.x == 0xffffffffu && value.y == 0x7fffffffu)
        return false;
    incremented.x = value.x + 1u;
    incremented.y = value.y + (incremented.x == 0u ? 1u : 0u);
    return true;
}

// Logical adjacency comes only from exact signed-64 Sigma_2 coordinates.
[numthreads(64, 1, 1)]
void ResolveCarrierHalos(uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint lane = groupThreadId.x;
    uint currentIndex = groupId.y;

    if (lane == 0u)
    {
        SigmaHaloTargetSlot = _CurrentPageSlots[currentIndex];
        SigmaHaloRightSlot = SIGMA_INVALID_PAGE_SLOT;
        SigmaHaloDownSlot = SIGMA_INVALID_PAGE_SLOT;
        SigmaHaloDiagonalSlot = SIGMA_INVALID_PAGE_SLOT;
    }
    GroupMemoryBarrierWithGroupSync();

    uint targetSlot = SigmaHaloTargetSlot;
    SigmaCarrierPageMetaGpu target = _PageMetadata[targetSlot];
    uint2 targetX = uint2(target.pageXLo, target.pageXHi);
    uint2 targetY = uint2(target.pageYLo, target.pageYHi);
    uint2 nextX;
    uint2 nextY;
    bool hasNextX = SigmaReadoutIncrementI64(targetX, nextX);
    bool hasNextY = SigmaReadoutIncrementI64(targetY, nextY);

    for (uint candidate = lane; candidate < _PageCapacity; candidate += 64u)
    {
        if (!SigmaReadoutPageVisible(candidate))
            continue;
        SigmaCarrierPageMetaGpu neighbour = _PageMetadata[candidate];
        uint2 x = uint2(neighbour.pageXLo, neighbour.pageXHi);
        uint2 y = uint2(neighbour.pageYLo, neighbour.pageYHi);
        if (hasNextX && SigmaReadoutI64Equal(x, nextX) &&
            SigmaReadoutI64Equal(y, targetY))
            InterlockedMin(SigmaHaloRightSlot, candidate);
        if (hasNextY && SigmaReadoutI64Equal(x, targetX) &&
            SigmaReadoutI64Equal(y, nextY))
            InterlockedMin(SigmaHaloDownSlot, candidate);
        if (hasNextX && hasNextY && SigmaReadoutI64Equal(x, nextX) &&
            SigmaReadoutI64Equal(y, nextY))
            InterlockedMin(SigmaHaloDiagonalSlot, candidate);
    }
    GroupMemoryBarrierWithGroupSync();

    float4 right = 0.0;
    float4 down = 0.0;
    if (SigmaHaloRightSlot != SIGMA_INVALID_PAGE_SLOT)
        right = _ReadoutVertices[SigmaReadoutIndex(
            SigmaHaloRightSlot, 0u, lane)];
    if (SigmaHaloDownSlot != SIGMA_INVALID_PAGE_SLOT)
        down = _ReadoutVertices[SigmaReadoutIndex(
            SigmaHaloDownSlot, lane, 0u)];
    _ReadoutVertices[SigmaReadoutIndex(targetSlot, 64u, lane)] = right;
    _ReadoutVertices[SigmaReadoutIndex(targetSlot, lane, 64u)] = down;

    if (lane == 0u)
    {
        float4 diagonal = 0.0;
        if (SigmaHaloDiagonalSlot != SIGMA_INVALID_PAGE_SLOT)
            diagonal = _ReadoutVertices[SigmaReadoutIndex(
                SigmaHaloDiagonalSlot, 0u, 0u)];
        _ReadoutVertices[SigmaReadoutIndex(targetSlot, 64u, 64u)] = diagonal;
    }
}
