#define SIGMA_N4_FOOTPRINT_HEADER 0u
#define SIGMA_N4_FOOTPRINT_INSTRUMENT 2u
#define SIGMA_N4_FOOTPRINT_ROOM_RAYS 4u
#define SIGMA_N4_FOOTPRINT_CODE_LEAVES 10u
#define SIGMA_N4_FOOTPRINT_BOUNDARY_ENVELOPES 26u
#define SIGMA_N4_FOOTPRINT_SUPPORT 50u
#define SIGMA_N4_FOOTPRINT_EVIDENCE_WORDS 52u
#define SIGMA_N4_FOOTPRINT_LEVEL_MASK 0x0000003fu
#define SIGMA_N4_FOOTPRINT_STATIC_EXCLUSION 0x00000100u
#define SIGMA_N4_SAMPLE_SIDE_LEFT 0u
#define SIGMA_N4_SAMPLE_SIDE_RIGHT 1u
#define SIGMA_N4_SAMPLE_SIDE_UP 2u
#define SIGMA_N4_SAMPLE_SIDE_DOWN 3u
#define SIGMA_N4_TILE_FOOTPRINT_CAPACITY 256u
#define SIGMA_N4_TILE_HEADER_WORDS 2u
#define SIGMA_N4_TILE_FOOTPRINT_RECEIPT_WORDS 8u
#define SIGMA_N4_TILE_COMPONENT_SUMMARY_WORDS 2u
#define SIGMA_N4_TILE_BORDER_COMPONENT_CAPACITY 60u
#define SIGMA_N4_BOUNDARY_RECEIPT_WORDS 6u
#define SIGMA_N4_COMPONENT_WORDS 10u
#define SIGMA_N4_COMPONENT_LIST_IMAGE 8u
#define SIGMA_N4_COMPONENT_SCAN_IMAGE 9u
#define SIGMA_N4_RADIX_WORK_IMAGE 0u
#define SIGMA_N4_RADIX_TEMP_IMAGE 1u
#define SIGMA_N4_RADIX_U_IMAGE 2u
#define SIGMA_N4_RADIX_V_IMAGE 3u
#define SIGMA_N4_RADIX_MORTON_LO_IMAGE 4u
#define SIGMA_N4_RADIX_MORTON_HI_IMAGE 5u
#define SIGMA_N4_RADIX_META_IMAGE 6u
#define SIGMA_N4_PAGE_PLAN_WORDS 4u
#define SIGMA_N4_PAGE_PLAN_TOUCHED 1u
#define SIGMA_N4_PAGE_PLAN_GAUGE_CHANGED 2u
#define SIGMA_N4_PAGE_PLAN_CERTIFICATE_CHANGED 4u
#define SIGMA_N4_PAGE_PLAN_STATE_CHANGED 8u
#define SIGMA_N4_INVALID 0xffffffffu

