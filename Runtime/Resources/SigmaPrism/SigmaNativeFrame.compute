#define SIGMA_N4_REFINEMENT_PROVED 1u
#define SIGMA_N4_REFINEMENT_UNRESOLVED 2u
#define SIGMA_N4_REFINEMENT_STATUS_MASK 3u
#define SIGMA_N4_REFINEMENT_CHILD_SHIFT 2u
#define SIGMA_N4_REFINEMENT_STATE_DIFFERENCE 0x80000000u
#define SIGMA_N4_REFINEMENT_STRUCTURAL_INVALID 0x40000000u
#define SIGMA_N4_CERTIFICATE_SOURCE_CARRIER 0x80000000u
#define SIGMA_N4_CANONICAL_IMAGE_MAX_LOG2 17u
#define SIGMA_N4_LOGICAL_CAPACITY_MAX_LOG2 19u
