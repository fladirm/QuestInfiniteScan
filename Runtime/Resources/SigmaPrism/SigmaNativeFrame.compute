#define SIGMA_NATIVE_RGB_CAL_STRIDE 8u
#define SIGMA_NATIVE_RGB_CAL_BASE_WIDTH 3u
#define SIGMA_NATIVE_RGB_CAL_POSE_WIDTH 5u
#define SIGMA_NATIVE_RGB_CAL_FOOTPRINT_WIDTH 6u

StructuredBuffer<uint2> _RgbCalibrationQ48;

uint SigmaNativeCompletionAddress(uint word)
{
    return _NativeCompletionRecordIndex * SIGMA_COMPLETION_WORD_COUNT + word;
}

void SigmaNativeWriteCompletion4(uint word, uint4 value)
{
    uint address = SigmaNativeCompletionAddress(word);
    _NativeCompletionJournal[address] = value.xy;
    _NativeCompletionJournal[address + 1u] = value.zw;
}

void SigmaNativeWriteCompletionFrame(SigmaNativeFrameGpu frame,
    uint publishedRoot)
{
    SigmaNativeWriteCompletion4(SIGMA_COMPLETION_FRAME, frame.Identity);
    SigmaNativeWriteCompletion4(SIGMA_COMPLETION_FRAME + 2u,
        frame.Disposition);
    SigmaNativeWriteCompletion4(SIGMA_COMPLETION_FRAME + 4u,
        frame.Evidence);
    SigmaNativeWriteCompletion4(SIGMA_COMPLETION_FRAME + 6u,
        frame.Publication);
    SigmaNativeWriteCompletion4(SIGMA_COMPLETION_ROOT,
        uint4(publishedRoot, frame.Identity.x, frame.Disposition.x,
            frame.Identity.w));
}

uint2 SigmaNativeQ48FromFloat(float value, inout uint valid)
{
    return SigmaQ48FromFloatNearestEven(value, valid);
}

uint2 SigmaNativeRgbCalibrationValue(uint eye, uint field)
{
    return _RgbCalibrationQ48[eye * SIGMA_NATIVE_RGB_CAL_STRIDE + field];
}

float4 SigmaNativeDepthRayCenter(uint eye, uint2 pixel)
{
    return eye == 0u ? _NativeDepthRayCenterLeft[pixel] :
        _NativeDepthRayCenterRight[pixel];
}

float4 SigmaNativeDepthRayDx(uint eye, uint2 pixel)
{
    return eye == 0u ? _NativeDepthRayDifferentialXLeft[pixel] :
        _NativeDepthRayDifferentialXRight[pixel];
}

float4 SigmaNativeDepthRayDy(uint eye, uint2 pixel)
{
    return eye == 0u ? _NativeDepthRayDifferentialYLeft[pixel] :
        _NativeDepthRayDifferentialYRight[pixel];
}

float4 SigmaNativeDepthSlopeBounds(uint eye, uint2 pixel)
{
    return eye == 0u ? _NativeDepthSlopeBoundsLeft[pixel] :
        _NativeDepthSlopeBoundsRight[pixel];
}

float3 SigmaNativeSampleBoundaryCorner(float4 slopes, uint corner)
{
    float x = (corner & 1u) == 0u ? slopes.x : slopes.y;
    float y = (corner & 2u) == 0u ? slopes.z : slopes.w;
    return normalize(float3(x, y, 1.0));
}

uint2 SigmaNativeRoomRayComponent(uint eye, uint row, float3 localRay,
    inout uint valid)
{
    uint2 result = SIGMA_Q48_ZERO;
    [loop]
    for (uint column = 0u; column < 3u; ++column)
    {
        uint2 local = SigmaNativeQ48FromFloat(localRay[column], valid);
        uint2 rotation = SigmaCalibrationValue(eye,
            SIGMA_CAL_R00 + row * 3u + column);
        result = SigmaQ48AddChecked(result,
            SigmaQ48MulNearestEven(rotation, local, valid), valid);
    }
    return result;
}

bool SigmaNativeProjectionDepthBounds(uint eye, float rawDepth,
    float metricRange, float localRayZ, out uint2 lower, out uint2 upper,
    inout uint valid)
{
    uint2 rawPoint = SigmaNativeQ48FromFloat(rawDepth, valid);
    uint2 range = SigmaNativeQ48FromFloat(metricRange, valid);
    uint2 rayZ = SigmaNativeQ48FromFloat(localRayZ, valid);
    uint2 width = SigmaDepthHalfWidth(eye, range, valid);
    uint2 rangeLower = SigmaQ48Max(SIGMA_Q48_ZERO,
        SigmaQ48SubChecked(range, width, valid));
    uint2 rangeUpper = SigmaQ48AddChecked(range, width, valid);
    uint2 nearValue = SigmaCalibrationValue(eye, SIGMA_CAL_NEAR);
    uint2 farValue = SigmaCalibrationValue(eye, SIGMA_CAL_FAR);
    uint2 farMinusNear = SigmaQ48SubChecked(farValue, nearValue, valid);
    uint2 viewLower = SigmaQ48MulLower(rangeLower, rayZ, valid);
    uint2 viewUpper = SigmaQ48MulUpper(rangeUpper, rayZ, valid);
    viewLower = SigmaQ48Max(viewLower, nearValue);
    viewUpper = SigmaQ48Max(viewUpper, viewLower);

    uint2 lowerNumerator = SigmaQ48MulLower(farValue,
        SigmaQ48SubChecked(viewLower, nearValue, valid), valid);
    uint2 lowerDenominator = SigmaQ48MulUpper(viewLower,
        farMinusNear, valid);
    uint2 upperNumerator = SigmaQ48MulUpper(farValue,
        SigmaQ48SubChecked(viewUpper, nearValue, valid), valid);
    uint2 upperDenominator = SigmaQ48MulLower(viewUpper,
        farMinusNear, valid);
    lower = SigmaQ48DivLower(lowerNumerator, lowerDenominator, valid);
    upper = SigmaQ48DivUpper(upperNumerator, upperDenominator, valid);
    lower = SigmaQ48Max(SIGMA_Q48_ZERO, SigmaQ48Min(lower, rawPoint));
    upper = SigmaQ48Min(SIGMA_Q48_ONE, SigmaQ48Max(upper, rawPoint));
    valid &= !SigmaQ48Less(upper, lower) ? 1u : 0u;
    return valid != 0u;
}

bool SigmaNativeProjectRgb(uint eye, float3 roomPoint, out float2 pixel)
{
    pixel = 0.0;
    float4x4 rgbFromRoom = eye == 0u ? _NativeRgbFromRoomLeft :
        _NativeRgbFromRoomRight;
    float4 intrinsics = eye == 0u ? _NativeRgbIntrinsicsLeft :
        _NativeRgbIntrinsicsRight;
    uint2 resolution = eye == 0u ? _NativeRgbLeftResolution :
        _NativeRgbRightResolution;
    float3 optical = mul(rgbFromRoom, float4(roomPoint, 1.0)).xyz;
    bool projected = all(isfinite(optical)) && optical.z > 1e-6;
    if (projected)
    {
        pixel = optical.xy / optical.z * intrinsics.xy + intrinsics.zw;
        projected = all(pixel >= 0.5) &&
            all(pixel <= (float2)resolution - 1.5);
    }
    return projected;
}

float4 SigmaNativeRgbLoad(uint eye, int2 pixel)
{
    return eye == 0u ? _NativeRgbLeft.Load(int3(pixel, 0)) :
        _NativeRgbRight.Load(int3(pixel, 0));
}

bool SigmaNativeOpticalBoundsFromSamples(uint eye, float2 phase,
    float4 c00, float4 c10, float4 c01, float4 c11, uint channel,
    out uint2 lower, out uint2 upper, inout uint valid)
{
    lower = SIGMA_Q48_ZERO;
    upper = SIGMA_Q48_ZERO;
    if (!all(isfinite(c00)) || !all(isfinite(c10)) ||
        !all(isfinite(c01)) || !all(isfinite(c11)))
    {
        valid = 0u;
        return false;
    }
    float4 centre = lerp(lerp(c00, c10, phase.x),
        lerp(c01, c11, phase.x), phase.y);
    float4 minimum = min(min(c00, c10), min(c01, c11));
    float4 maximum = max(max(c00, c10), max(c01, c11));
    uint2 centreQ = SigmaNativeQ48FromFloat(saturate(centre[channel]), valid);
    float hullRadius = max(abs(centre[channel] - minimum[channel]),
        abs(maximum[channel] - centre[channel]));
    uint2 hullQ = SigmaNativeQ48FromFloat(hullRadius, valid);
    uint2 width = SigmaQ48AddChecked(
        SigmaNativeRgbCalibrationValue(eye,
            SIGMA_NATIVE_RGB_CAL_BASE_WIDTH),
        SigmaNativeRgbCalibrationValue(eye,
            SIGMA_NATIVE_RGB_CAL_POSE_WIDTH), valid);
    width = SigmaQ48AddChecked(width,
        SigmaNativeRgbCalibrationValue(eye,
            SIGMA_NATIVE_RGB_CAL_FOOTPRINT_WIDTH), valid);
    width = SigmaQ48AddChecked(width, hullQ, valid);
    width = SigmaQ48AddChecked(width, uint2(1u, 0u), valid);
    lower = SigmaQ48Max(SIGMA_Q48_ZERO,
        SigmaQ48SubChecked(centreQ, width, valid));
    upper = SigmaQ48Min(SIGMA_Q48_ONE,
        SigmaQ48AddChecked(centreQ, width, valid));
    return valid != 0u;
}

bool SigmaNativeCurrentPrediction(uint2 pixel, out uint slot,
    out uint sample, out uint generation, out uint revision,
    out uint level, out uint4 coordinate)
{
    uint4 leftKey = _NativePredStateKey[uint3(pixel, 0u)];
    uint4 rightKey = _NativePredStateKey[uint3(pixel, 1u)];
    uint4 leftCoordinate = _NativePredCarrierPage[uint3(pixel, 0u)];
    uint4 rightCoordinate = _NativePredCarrierPage[uint3(pixel, 1u)];
    int2 leftLocal = int2(round(
        _NativePredCarrierUvNormal[uint3(pixel, 0u)].xy));
    int2 rightLocal = int2(round(
        _NativePredCarrierUvNormal[uint3(pixel, 1u)].xy));
    bool valid = all(leftKey == rightKey) &&
        all(leftCoordinate == rightCoordinate) &&
        all(leftLocal == rightLocal) && all(leftLocal >= 0) &&
        all(leftLocal < (int2)SIGMA_PAGE_SIZE) &&
        leftKey.x != 0u && leftKey.y != 0u &&
        leftKey.z == _NativeTargetSegmentIndex &&
        leftKey.w < _NativeTargetPageCapacity;
    slot = valid ? leftKey.w : SIGMA_FRAME_INVALID;
    sample = valid ? (uint)leftLocal.y * SIGMA_PAGE_SIZE +
        (uint)leftLocal.x : 0u;
    generation = valid ? leftKey.x : 0u;
    revision = valid ? leftKey.y : 0u;
    level = 0u;
    coordinate = valid ? leftCoordinate : uint4(0u, 0u, 0u, 0u);
    if (valid)
    {
        uint root = _NativeSourcePublicationRoot[0u];
        SigmaCarrierPageMetaGpu page = _NativeSourcePageMetadata[slot];
        uint siblingSlot = slot ^ 1u;
        bool hasSibling = siblingSlot < _NativeTargetPageCapacity;
        SigmaCarrierPageMetaGpu sibling = (SigmaCarrierPageMetaGpu)0;
        if (hasSibling)
            sibling = _NativeSourcePageMetadata[siblingSlot];
        valid = root != 0u && page.generation == generation &&
            page.revision == revision &&
            page.representationFingerprint ==
                (SIGMA_CHI_FINGERPRINT[0u] ^ SIGMA_KAPPA_FINGERPRINT[0u] ^
                    SIGMA_CERTIFICATE_FINGERPRINT[0u]) &&
            SigmaCarrierVisibleAtRoot(page, sibling, hasSibling, root);
        if (valid)
        {
            uint gaugeAddress = SigmaCarrierRepresentationAddress(slot,
                sample, SIGMA_REPRESENTATION_GAUGE_COORDINATE);
            uint4 gaugeCoordinate =
                _NativeSourceCarrierRepresentation[gaugeAddress];
            uint4 gaugePlan = _NativeSourceCarrierRepresentation[
                gaugeAddress + 1u];
            valid = (gaugePlan.y & SIGMA_NATIVE_GAUGE_CELL_FLAGS_ACTIVE) != 0u;
            level = valid ? gaugePlan.x : 0u;
            coordinate = valid ? gaugeCoordinate : uint4(0u, 0u, 0u, 0u);
        }
    }
    return valid;
}

uint SigmaNativeFootprintEvidenceAddress(uint footprint, uint word)
{
    return footprint * SIGMA_N4_FOOTPRINT_EVIDENCE_WORDS + word;
}

void SigmaNativeStoreFootprintEvidence(uint footprint, uint word,
    uint2 value)
{
    _NativeCloseScratch[
        SigmaNativeFootprintEvidenceAddress(footprint, word)] = value;
}

uint SigmaNativeObservationProvenance()
{
    uint provenance = _NativeIndependenceKeys.x ^
        (_NativeIndependenceKeys.y * 16777619u) ^
        (_NativeIndependenceKeys.z * 2166136261u) ^
        _NativeIndependenceKeys.w;
    return provenance == 0u ? 1u : provenance;
}

// CUT A/Q2: one isolated eight-lane team owns one disposable coherent sampling
// footprint. Thirty-two teams share one 256-lane Adreno workgroup; every
// groupshared address is explicitly team-partitioned and no reduction crosses a
// footprint. Room-ray components and all eight stereo leaves execute across
// lanes rather than in a per-pixel serial loop. Sampling indices remain
// execution-only and never become Sigma2 addresses.
void SigmaNativeBuildFullFrameFootprints(uint groupIndex, uint threadIndex)
{
    uint team = threadIndex / SIGMA_N4_OBSERVATION_TEAM_LANES;
    uint teamLane = threadIndex & (SIGMA_N4_OBSERVATION_TEAM_LANES - 1u);
    uint footprint = groupIndex * SIGMA_N4_OBSERVATION_TEAMS_PER_GROUP + team;
    uint footprintCount = _NativeResolution.x * _NativeResolution.y;
    bool active = footprint < footprintCount;
    uint2 pixel = active ? uint2(footprint % _NativeResolution.x,
        footprint / _NativeResolution.x) : 0u;
    if (teamLane == 0u)
    {
        uint slot = SIGMA_FRAME_INVALID;
        uint sample = 0u;
        uint generation = 0u;
        uint revision = 0u;
        uint level = 0u;
        uint4 coordinate = 0u;
        bool hasSupport = active && SigmaNativeCurrentPrediction(pixel, slot,
            sample, generation, revision, level, coordinate);
        SigmaN4FootprintSupport[team] = uint4(slot, sample, generation,
            revision);
        SigmaN4FootprintCoordinate[team] = coordinate;
        SigmaN4FootprintHasSupport[team] = hasSupport ? 1u : 0u;
        SigmaN4FootprintLevel[team] = hasSupport ? level : 0u;
    }

    uint eye = teamLane >> 2u;
    uint leaf = teamLane & 3u;
    uint eyeIndex = team * 2u + eye;
    if (teamLane == 0u || teamLane == 4u)
    {
        float4 ray = active ? SigmaNativeDepthRayCenter(eye, pixel) : 0.0;
        float4 rayDx = active ? SigmaNativeDepthRayDx(eye, pixel) : 0.0;
        float4 rayDy = active ? SigmaNativeDepthRayDy(eye, pixel) : 0.0;
        uint rayValid = active && _SigmaExactBackendGate[0] != 0u &&
            all(isfinite(ray)) && all(isfinite(rayDx)) &&
            all(isfinite(rayDy)) && ray.z > 0.0 && ray.w > 0.0 &&
            rayDx.w > 0.0 && rayDy.w > 0.0 ? 1u : 0u;
        float rawDepth = active ? _NativeRawDepth[uint3(pixel, eye)] : 0.0;
        float2 depth = active ? _NativeMetricDepth[uint3(pixel, eye)] : 0.0;
        uint depthValid = rayValid != 0u &&
            (_NativeDepthFlags[uint3(pixel, eye)] & 1u) != 0u &&
            isfinite(rawDepth) && rawDepth > 0.0 && rawDepth < 1.0 &&
            all(isfinite(depth)) && depth.x > 0.0 ? 1u : 0u;
        float2 rgbPixel = 0.0;
        uint projected = 0u;
        float2 phase = 0.0;
        float4 c00 = 0.0;
        float4 c10 = 0.0;
        float4 c01 = 0.0;
        float4 c11 = 0.0;
        if (depthValid != 0u)
        {
            float4x4 roomFromDepth = eye == 0u
                ? _NativeRoomFromDepthLeft : _NativeRoomFromDepthRight;
            float3 roomPoint = mul(roomFromDepth,
                float4(ray.xyz * depth.x, 1.0)).xyz;
            roomPoint = SigmaPoseApplyWorld(roomPoint);
            projected = SigmaNativeProjectRgb(eye, roomPoint, rgbPixel)
                ? 1u : 0u;
            if (projected != 0u)
            {
                int2 p00 = int2(floor(rgbPixel - 0.5));
                phase = frac(rgbPixel - 0.5);
                c00 = SigmaNativeRgbLoad(eye, p00);
                c10 = SigmaNativeRgbLoad(eye, p00 + int2(1, 0));
                c01 = SigmaNativeRgbLoad(eye, p00 + int2(0, 1));
                c11 = SigmaNativeRgbLoad(eye, p00 + int2(1, 1));
            }
        }
        SigmaN4FootprintRay[eyeIndex] = ray;
        SigmaN4FootprintRawDepth[eyeIndex] = rawDepth;
        SigmaN4FootprintMetricDepth[eyeIndex] = depth;
        SigmaN4FootprintRayValid[eyeIndex] = rayValid;
        SigmaN4FootprintDepthValid[eyeIndex] = depthValid;
        SigmaN4FootprintRgbPhase[eyeIndex] = phase;
        SigmaN4FootprintRgbProjected[eyeIndex] = projected;
        SigmaN4FootprintRgb00[eyeIndex] = c00;
        SigmaN4FootprintRgb10[eyeIndex] = c10;
        SigmaN4FootprintRgb01[eyeIndex] = c01;
        SigmaN4FootprintRgb11[eyeIndex] = c11;
    }
    GroupMemoryBarrierWithGroupSync();

    float4 ray = SigmaN4FootprintRay[eyeIndex];
    uint valid = active ? SigmaN4FootprintDepthValid[eyeIndex] : 0u;

    if (active && teamLane < 6u)
    {
        uint rayEye = teamLane / 3u;
        uint component = teamLane - rayEye * 3u;
        uint componentIndex = team * 2u + rayEye;
        float4 componentRay = SigmaN4FootprintRay[componentIndex];
        uint componentValid = SigmaN4FootprintRayValid[componentIndex];
        uint2 roomRay = SigmaNativeRoomRayComponent(rayEye, component,
            componentRay.xyz, componentValid);
        SigmaNativeStoreFootprintEvidence(footprint,
            SIGMA_N4_FOOTPRINT_ROOM_RAYS + teamLane, roomRay);
        valid &= componentValid;
    }

    if (active)
    {
        float rawDepth = SigmaN4FootprintRawDepth[eyeIndex];
        float2 depth = SigmaN4FootprintMetricDepth[eyeIndex];
        uint2 lower = SIGMA_Q48_ZERO;
        uint2 upper = SIGMA_Q48_ZERO;
        if (leaf == SIGMA_NATIVE_LEAF_KIND_ORDER)
        {
            SigmaNativeProjectionDepthBounds(eye, rawDepth, depth.x, ray.z,
                lower, upper, valid);
        }
        else
        {
            uint channel = leaf - 1u;
            valid &= _NativeOpticalTransfers[eye] <= 1u ? 1u : 0u;
            valid &= SigmaN4FootprintRgbProjected[eyeIndex];
            if (SigmaN4FootprintRgbProjected[eyeIndex] != 0u)
                SigmaNativeOpticalBoundsFromSamples(eye,
                    SigmaN4FootprintRgbPhase[eyeIndex],
                    SigmaN4FootprintRgb00[eyeIndex],
                    SigmaN4FootprintRgb10[eyeIndex],
                    SigmaN4FootprintRgb01[eyeIndex],
                    SigmaN4FootprintRgb11[eyeIndex], channel, lower, upper,
                    valid);
        }
        uint evidenceWord = SIGMA_N4_FOOTPRINT_CODE_LEAVES + teamLane * 2u;
        SigmaNativeStoreFootprintEvidence(footprint, evidenceWord,
            valid != 0u ? lower : uint2(0xffffffffu, 0x7fffffffu));
        SigmaNativeStoreFootprintEvidence(footprint, evidenceWord + 1u,
            valid != 0u ? upper : uint2(0u, 0x80000000u));
    }

    // RGB sample scratch is dead after the leaves. Reuse it for the one exact
    // boundary context per eye rather than increasing the already-sensitive
    // Quest groupshared footprint.
    GroupMemoryBarrierWithGroupSync();
    if (teamLane == 0u || teamLane == 4u)
    {
        uint boundaryContextValid = active ?
            SigmaN4FootprintDepthValid[eyeIndex] : 0u;
        uint2 range = SigmaNativeQ48FromFloat(
            SigmaN4FootprintMetricDepth[eyeIndex].x, boundaryContextValid);
        uint2 width = SigmaDepthHalfWidth(eye, range, boundaryContextValid);
        uint2 rangeLower = SigmaQ48Max(SIGMA_Q48_ZERO,
            SigmaQ48SubChecked(range, width, boundaryContextValid));
        uint2 rangeUpper = SigmaQ48AddChecked(range, width,
            boundaryContextValid);
        uint2 poseWidth = SigmaCalibrationValue(eye, SIGMA_CAL_POSE_WIDTH);
        float4 slopes = active ? SigmaNativeDepthSlopeBounds(eye, pixel) : 0.0;
        boundaryContextValid &=
            active && all(isfinite(slopes)) ? 1u : 0u;
        SigmaN4FootprintRgb00[eyeIndex] = float4(asfloat(rangeLower),
            asfloat(rangeUpper));
        SigmaN4FootprintRgb10[eyeIndex] = float4(asfloat(poseWidth), 0.0, 0.0);
        SigmaN4FootprintRgb01[eyeIndex] = slopes;
        SigmaN4FootprintRgbProjected[eyeIndex] = boundaryContextValid;
    }
    GroupMemoryBarrierWithGroupSync();

    uint cornerEye = teamLane >> 2u;
    uint corner = teamLane & 3u;
    uint cornerEyeIndex = team * 2u + cornerEye;
    uint cornerValid = SigmaN4FootprintRgbProjected[cornerEyeIndex];
    float3 cornerRay = SigmaNativeSampleBoundaryCorner(
        SigmaN4FootprintRgb01[cornerEyeIndex], corner);
    cornerValid &= all(isfinite(cornerRay)) && cornerRay.z > 0.0 ? 1u : 0u;
    uint boundaryLane = team * 8u + teamLane;
    [unroll]
    for (uint boundaryAxis = 0u; boundaryAxis < 3u; ++boundaryAxis)
    {
        uint sharedAddress = boundaryLane * 3u + boundaryAxis;
        uint2 direction = SigmaNativeRoomRayComponent(cornerEye,
            boundaryAxis, cornerRay, cornerValid);
        uint2 atLowerLo;
        uint2 atLowerHi;
        uint2 atUpperLo;
        uint2 atUpperHi;
        SigmaQ48MulBounds(direction,
            asuint(SigmaN4FootprintRgb00[cornerEyeIndex].xy),
            atLowerLo, atLowerHi,
            cornerValid);
        SigmaQ48MulBounds(direction,
            asuint(SigmaN4FootprintRgb00[cornerEyeIndex].zw),
            atUpperLo, atUpperHi,
            cornerValid);
        uint2 origin = SigmaCalibrationValue(cornerEye,
            SIGMA_CAL_TX + boundaryAxis);
        uint2 pointLower = SigmaQ48SubChecked(SigmaQ48AddChecked(origin,
            SigmaQ48Min(atLowerLo, atUpperLo), cornerValid),
            asuint(SigmaN4FootprintRgb10[cornerEyeIndex].xy), cornerValid);
        uint2 pointUpper = SigmaQ48AddChecked(SigmaQ48AddChecked(origin,
            SigmaQ48Max(atLowerHi, atUpperHi), cornerValid),
            asuint(SigmaN4FootprintRgb10[cornerEyeIndex].xy), cornerValid);
        SigmaN4BoundaryLower[sharedAddress] = cornerValid != 0u
            ? pointLower : uint2(0xffffffffu, 0x7fffffffu);
        SigmaN4BoundaryUpper[sharedAddress] = cornerValid != 0u
            ? pointUpper : uint2(0u, 0x80000000u);
    }
    SigmaNativeObservationValid[boundaryLane] = active ? cornerValid : 0u;
    GroupMemoryBarrierWithGroupSync();

    // Construct each side as the exact union of its two already-materialized
    // corner intervals, then meet the two independently calibrated eyes.
    if (active && teamLane < 4u)
    {
        uint firstCorner = teamLane == SIGMA_N4_SAMPLE_SIDE_LEFT ? 0u :
            teamLane == SIGMA_N4_SAMPLE_SIDE_RIGHT ? 1u :
            teamLane == SIGMA_N4_SAMPLE_SIDE_UP ? 0u : 2u;
        uint secondCorner = teamLane == SIGMA_N4_SAMPLE_SIDE_LEFT ? 2u :
            teamLane == SIGMA_N4_SAMPLE_SIDE_RIGHT ? 3u :
            teamLane == SIGMA_N4_SAMPLE_SIDE_UP ? 1u : 3u;
        uint leftFirstLane = team * 8u + firstCorner;
        uint leftSecondLane = team * 8u + secondCorner;
        uint rightFirstLane = leftFirstLane + 4u;
        uint rightSecondLane = leftSecondLane + 4u;
        uint sideValid = SigmaNativeObservationValid[leftFirstLane] &
            SigmaNativeObservationValid[leftSecondLane] &
            SigmaNativeObservationValid[rightFirstLane] &
            SigmaNativeObservationValid[rightSecondLane];
        [unroll]
        for (uint boundaryAxis = 0u; boundaryAxis < 3u; ++boundaryAxis)
        {
            uint leftFirst = leftFirstLane * 3u + boundaryAxis;
            uint leftSecond = leftSecondLane * 3u + boundaryAxis;
            uint rightFirst = rightFirstLane * 3u + boundaryAxis;
            uint rightSecond = rightSecondLane * 3u + boundaryAxis;
            uint2 leftLower = SigmaQ48Min(
                SigmaN4BoundaryLower[leftFirst],
                SigmaN4BoundaryLower[leftSecond]);
            uint2 leftUpper = SigmaQ48Max(
                SigmaN4BoundaryUpper[leftFirst],
                SigmaN4BoundaryUpper[leftSecond]);
            uint2 rightLower = SigmaQ48Min(
                SigmaN4BoundaryLower[rightFirst],
                SigmaN4BoundaryLower[rightSecond]);
            uint2 rightUpper = SigmaQ48Max(
                SigmaN4BoundaryUpper[rightFirst],
                SigmaN4BoundaryUpper[rightSecond]);
            uint2 lower = SigmaQ48Max(leftLower, rightLower);
            uint2 upper = SigmaQ48Min(leftUpper, rightUpper);
            sideValid &= !SigmaI64Less(upper, lower) ? 1u : 0u;
            uint word = SIGMA_N4_FOOTPRINT_BOUNDARY_ENVELOPES +
                teamLane * 6u + boundaryAxis * 2u;
            SigmaNativeStoreFootprintEvidence(footprint, word,
                sideValid != 0u ? lower : uint2(0xffffffffu, 0x7fffffffu));
            SigmaNativeStoreFootprintEvidence(footprint, word + 1u,
                sideValid != 0u ? upper : uint2(0u, 0x80000000u));
        }
    }

    GroupMemoryBarrierWithGroupSync();
    SigmaNativeObservationValid[threadIndex] = active ? valid : 0u;
    GroupMemoryBarrierWithGroupSync();
    if (teamLane == 0u)
    {
        uint teamValid = 1u;
        [unroll]
        for (uint member = 0u; member < 8u; ++member)
            teamValid &= SigmaNativeObservationValid[
                team * SIGMA_N4_OBSERVATION_TEAM_LANES + member];
        SigmaNativeObservationValid[
            team * SIGMA_N4_OBSERVATION_TEAM_LANES] = teamValid;
    }
    GroupMemoryBarrierWithGroupSync();
    if (active && teamLane == 0u)
    {
        uint4 support = SigmaN4FootprintSupport[team];
        SigmaNativeStoreFootprintEvidence(footprint,
            SIGMA_N4_FOOTPRINT_SUPPORT, support.xy);
        SigmaNativeStoreFootprintEvidence(footprint,
            SIGMA_N4_FOOTPRINT_SUPPORT + 1u,
            uint2(support.z, SigmaN4FootprintLevel[team]));
        uint flags = SIGMA_NATIVE_OBSERVATION_COHERENT |
            SIGMA_NATIVE_OBSERVATION_LEFT_FIRST_HIT |
            SIGMA_NATIVE_OBSERVATION_RIGHT_FIRST_HIT;
        if (SigmaN4FootprintHasSupport[team] != 0u)
            flags |= SIGMA_NATIVE_OBSERVATION_PRIOR_SUPPORT;
        if (SigmaNativeObservationValid[threadIndex] != 0u)
            flags |= SIGMA_NATIVE_OBSERVATION_LEFT_EVIDENCE |
                SIGMA_NATIVE_OBSERVATION_RIGHT_EVIDENCE |
                SIGMA_NATIVE_OBSERVATION_OPTICAL_CLAIM;
        uint provenance = SigmaNativeObservationProvenance();
        SigmaNativeStoreFootprintEvidence(footprint,
            SIGMA_N4_FOOTPRINT_HEADER, uint2(flags, _NativeRevision));
        SigmaNativeStoreFootprintEvidence(footprint,
            SIGMA_N4_FOOTPRINT_HEADER + 1u,
            uint2(_NativeCalibrationEpoch, provenance));
        SigmaNativeStoreFootprintEvidence(footprint,
            SIGMA_N4_FOOTPRINT_INSTRUMENT, _NativeOpticalTransfers);
        SigmaNativeStoreFootprintEvidence(footprint,
            SIGMA_N4_FOOTPRINT_INSTRUMENT + 1u,
            uint2(_NativeCalibrationEpoch,
                SIGMA_MERKABA_PROGRAM_FINGERPRINT[0u]));
        SigmaNativeObservationGpu observation;
        observation.Identity = uint4(_NativeRevision,
            _NativeCalibrationEpoch, provenance, flags);
        observation.Footprint = SigmaN4FootprintHasSupport[team] != 0u
            ? SigmaN4FootprintCoordinate[team] : uint4(0u, 0u, 0u, 0u);
        observation.Evidence = _NativeIndependenceKeys;
        observation.Query = uint4(pixel,
            SIGMA_NATIVE_FIRST_HIT_ROLE_FIRST_HIT_MOULD,
            SIGMA_NATIVE_FIRST_HIT_ROLE_FIRST_HIT_MOULD);
        _NativeObservations[footprint + 1u] = observation;
    }
    GroupMemoryBarrierWithGroupSync();
}

[numthreads(256, 1, 1)]
void BuildNativeObservation(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    // The frame slot is recycled execution storage. Initialize every field at
    // the production ingress boundary so no prior slot contents can become a
    // revision/publication receipt. The following dispatch is the global
    // synchronization boundary for consumers of this record.
    if (groupId.x == 0u && threadId.x == 0u)
    {
        SigmaNativeFrameGpu frame;
        frame.Identity = uint4(_NativeRevision, _NativeCalibrationEpoch,
            SigmaNativeObservationProvenance(),
            SIGMA_NATIVE_COLD_REASON_NONE);
        frame.Disposition = uint4(
            SIGMA_NATIVE_FRAME_DISPOSITION_GPU_OWNED, 0u, 0u, 0u);
        frame.Evidence = uint4(_NativeProvenanceReceipt[0],
            _NativeProvenanceReceipt[1], _NativeProvenanceReceipt[2],
            _NativeProvenanceReceipt[3]);
        frame.Publication = uint4(_NativeSourcePublicationRoot[0u],
            0u, 0u, 0u);
        _NativeFrames[0u] = frame;
        // Fixed graph indirect receipts. BOUNDARY starts at group zero for
        // the retained legacy relation and atomically appends exact contact
        // candidate ids from ContractNativeQuery.
        _NativeCounters[0u] = 0u;
        _NativeCounters[1u] = 0u;
        _NativeCounters[2u] = uint4(1u, 1u, 1u, 0u);
        _NativeCounters[3u] = uint4(1u, 1u, 1u, 0u);
        _NativeCloseScratch[_NativeGlobalHeaderScratchOffset] = 0u;
        _NativeCloseScratch[_NativeGlobalHeaderScratchOffset + 1u] = 0u;
        _NativeCloseScratch[_NativeGlobalHeaderScratchOffset + 2u] = 0u;
        _NativeCloseScratch[_NativeGlobalHeaderScratchOffset + 3u] = 0u;
    }
    SigmaNativeBuildFullFrameFootprints(groupId.x, threadId.x);
}

uint SigmaN4PublishTileHeaderAddress(uint tile, uint word)
{
    return _NativeTileHeaderScratchOffset +
        tile * SIGMA_N4_TILE_HEADER_WORDS + word;
}

uint SigmaN4PublishTileFootprintAddress(uint footprint, uint word)
{
    return _NativeTileFootprintScratchOffset +
        footprint * SIGMA_N4_TILE_FOOTPRINT_RECEIPT_WORDS + word;
}

uint SigmaN4PublishTileComponentAddress(uint tile, uint slot, uint word)
{
    return _NativeTileComponentSummaryScratchOffset +
        (tile * SIGMA_N4_TILE_FOOTPRINT_CAPACITY + slot) *
            SIGMA_N4_TILE_COMPONENT_SUMMARY_WORDS + word;
}

uint SigmaN4PublishComponentAddress(uint component, uint word)
{
    return _NativeCanonicalComponentScratchOffset +
        component * SIGMA_N4_COMPONENT_WORDS + word;
}

uint SigmaN4PublishImageAddress(uint image, uint index)
{
    return _NativeCanonicalImageScratchOffset +
        image * _NativeCanonicalImageStride + index;
}

uint SigmaN4PublishPlanAddress(uint page, uint word)
{
    return _NativePagePlanScratchOffset +
        page * SIGMA_N4_PAGE_PLAN_WORDS + word;
}

int2 SigmaN4PublishD4Vector(uint frame, int2 value)
{
    int4 transform = SIGMA_STITCH_CHART_D4[min(frame, 7u)];
    return int2(transform.x * value.x + transform.y * value.y,
        transform.z * value.x + transform.w * value.y);
}

uint SigmaN4PublishD4Compose(uint outer, uint inner, inout uint valid)
{
    return SigmaMerkabaComposeChartD4(outer, inner, valid);
}

uint4 SigmaN4PublishAffineCompose(uint4 outer, uint4 inner)
{
    uint valid = outer.y & inner.y;
    uint frame = SigmaN4PublishD4Compose(outer.x, inner.x, valid);
    int2 offset = SigmaN4PublishD4Vector(outer.x,
        int2(asint(inner.z), asint(inner.w))) +
        int2(asint(outer.z), asint(outer.w));
    return uint4(frame, valid, asuint(offset.x), asuint(offset.y));
}

uint4 SigmaN4PublishLoadGlobalTransform(uint orbit, uint node)
{
    uint address = _NativeGlobalTransformScratchOffset +
        (orbit * _NativeGlobalBorderComponentCapacity + node) * 2u;
    return uint4(_NativeCloseScratch[address],
        _NativeCloseScratch[address + 1u]);
}

uint SigmaN4PublishFindRoot(uint node, uint orbit, out uint4 transform)
{
    transform = uint4(0u, 1u, 0u, 0u);
    uint current = node;
    [loop]
    for (uint step = 0u; step < 16u; ++step)
    {
        uint parent = _NativeCloseScratch[
            _NativeGlobalParentScratchOffset + current].x;
        if (parent == current || parent == SIGMA_N4_INVALID)
            return parent;
        transform = SigmaN4PublishAffineCompose(
            SigmaN4PublishLoadGlobalTransform(orbit, current), transform);
        current = parent;
    }
    transform.y = 0u;
    return SIGMA_N4_INVALID;
}

bool SigmaN4PublishFootprintValid(uint footprint)
{
    uint required = SIGMA_NATIVE_OBSERVATION_LEFT_EVIDENCE |
        SIGMA_NATIVE_OBSERVATION_RIGHT_EVIDENCE |
        SIGMA_NATIVE_OBSERVATION_LEFT_FIRST_HIT |
        SIGMA_NATIVE_OBSERVATION_RIGHT_FIRST_HIT;
    uint flags = _NativePrepareObservations[footprint + 1u].Identity.w;
    uint certificate = _NativeLocalityCertificateWords[
        _NativeFootprintCertificateOffset +
        footprint * SIGMA_CERTIFICATE_WORD_COUNT +
        SIGMA_CERTIFICATE_IDENTITY].x;
    uint certificateRequired = SIGMA_NATIVE_CERTIFICATE_FLAGS_VALID |
        SIGMA_NATIVE_CERTIFICATE_FLAGS_DIRECTIONAL |
        SIGMA_NATIVE_CERTIFICATE_FLAGS_MINIMIZED;
    return (flags & required) == required &&
        (flags & SIGMA_NATIVE_OBSERVATION_FAULT) == 0u &&
        (certificate & certificateRequired) == certificateRequired;
}

uint SigmaN4PublishSupportLocator(uint footprint)
{
    uint locator = SIGMA_N4_INVALID;
    uint flags = _NativePrepareObservations[footprint + 1u].Identity.w;
    if ((flags & SIGMA_NATIVE_OBSERVATION_PRIOR_SUPPORT) != 0u)
    {
        uint2 support = _NativeCloseScratch[
            footprint * SIGMA_N4_FOOTPRINT_EVIDENCE_WORDS +
            SIGMA_N4_FOOTPRINT_SUPPORT];
        if (support.x < _NativeTargetPageCapacity &&
            support.y < SIGMA_PAGE_SAMPLE_COUNT)
            locator = support.x * SIGMA_PAGE_SAMPLE_COUNT + support.y;
    }
    return locator;
}

bool SigmaN4PublishSourceSampleInRange(uint sourceSlot, uint sourceSample)
{
    if (sourceSlot >= _NativeTargetPageCapacity ||
        sourceSample >= SIGMA_PAGE_SAMPLE_COUNT)
        return false;
    return sourceSample <
        _NativeSourcePageMetadata[sourceSlot].activeSampleCount;
}

bool SigmaN4PublishChartCore(uint footprint, bool representativeOnly,
    out uint component, out uint orbit, out uint4 chart, out uint level,
    out uint support)
{
    component = SIGMA_N4_INVALID;
    orbit = 0u;
    chart = 0u;
    level = 0u;
    support = SIGMA_N4_INVALID;
    if (footprint >= _NativeFootprintCount ||
        !SigmaN4PublishFootprintValid(footprint))
        return false;

    uint2 pixel = uint2(footprint % _NativeResolution.x,
        footprint / _NativeResolution.x);
    uint tile = (pixel.y >> 4u) * _NativeTileCount.x + (pixel.x >> 4u);
    uint2 footprintReceipt = _NativeCloseScratch[
        SigmaN4PublishTileFootprintAddress(footprint, 0u)];
    uint slot = footprintReceipt.x;
    uint borderCount = _NativeCloseScratch[
        SigmaN4PublishTileHeaderAddress(tile, 1u)].x;
    uint2 summary0 = _NativeCloseScratch[
        SigmaN4PublishTileComponentAddress(tile, slot, 0u)];
    uint2 summary1 = _NativeCloseScratch[
        SigmaN4PublishTileComponentAddress(tile, slot, 1u)];
    uint mask = summary0.y & 7u;
    bool oneClass = (summary1.y & (1u << 17u)) != 0u;
    uint node = SIGMA_N4_INVALID;
    uint4 rootTransform = uint4(0u, 1u, 0u, 0u);
    if (slot < borderCount)
    {
        node = tile * SIGMA_N4_TILE_BORDER_COMPONENT_CAPACITY + slot;
        uint probe = node;
        [loop]
        for (uint step = 0u; step < 16u; ++step)
        {
            uint2 parent = _NativeCloseScratch[
                _NativeGlobalParentScratchOffset + probe];
            if (parent.x == probe || parent.x == SIGMA_N4_INVALID)
            {
                mask = parent.y & 7u;
                uint members = parent.y >> 3u;
                oneClass = countbits(mask) == 1u ||
                    (members == 1u && oneClass);
                component = parent.x;
                break;
            }
            probe = parent.x;
        }
    }
    else
        component = _NativeGlobalBorderComponentCapacity +
            tile * SIGMA_N4_TILE_FOOTPRINT_CAPACITY + slot;

    if (component == SIGMA_N4_INVALID || !oneClass || mask == 0u ||
        component >= _NativeCanonicalComponentCapacity)
        return false;
    orbit = firstbitlow(mask);
    uint stateAddress = SigmaN4PublishTileFootprintAddress(footprint,
        2u + orbit * 2u);
    chart = uint4(_NativeCloseScratch[stateAddress],
        _NativeCloseScratch[stateAddress + 1u]);
    if ((chart.z & 8u) == 0u)
        return false;
    chart = uint4(chart.z & 7u, 1u, chart.x, chart.y);
    if (node != SIGMA_N4_INVALID)
    {
        uint root = SigmaN4PublishFindRoot(node, orbit, rootTransform);
        if (root != component || rootTransform.y == 0u)
            return false;
        chart = SigmaN4PublishAffineCompose(rootTransform, chart);
    }
    level = _NativeCloseScratch[
        footprint * SIGMA_N4_FOOTPRINT_EVIDENCE_WORDS +
        SIGMA_N4_FOOTPRINT_EVIDENCE_WORDS - 1u].y &
        SIGMA_N4_FOOTPRINT_LEVEL_MASK;
    support = SigmaN4PublishSupportLocator(footprint);
    if (representativeOnly && support != SIGMA_N4_INVALID)
    {
        uint leader = _NativeCloseScratch[
            _NativeActiveSupportMarkerScratchOffset + support].y;
        if (leader != footprint)
            return false;
    }
    return chart.y != 0u && level < 63u;
}

bool SigmaN4PublishChart(uint footprint, out uint component, out uint orbit,
    out uint4 chart, out uint level, out uint support)
{
    return SigmaN4PublishChartCore(footprint, true, component, orbit, chart,
        level, support);
}

bool SigmaN4PublishStaticExclusion(uint footprint)
{
    return (_NativeCloseScratch[
        footprint * SIGMA_N4_FOOTPRINT_EVIDENCE_WORDS +
        SIGMA_N4_FOOTPRINT_EVIDENCE_WORDS - 1u].y &
        SIGMA_N4_FOOTPRINT_STATIC_EXCLUSION) != 0u;
}

uint SigmaN4PublishActiveSupportListOffset()
{
    // FrameResources owns this existing disposable range immediately before
    // GlobalParent.  Deriving the address avoids another scalar/buffer ABI.
    return _NativeGlobalParentScratchOffset - _NativeFootprintCount * 2u;
}

uint SigmaN4PublishActiveSupportAddress(uint activeIndex, uint word)
{
    return SigmaN4PublishActiveSupportListOffset() + activeIndex * 2u + word;
}

uint SigmaN4PublishRefinementScratchAddress(uint activeIndex);
bool SigmaN4PublishRefinementScratchValid(uint activeIndex);

uint SigmaN4PublishRefinementRepresentative(uint activeIndex, uint child)
{
    if (activeIndex >= _NativeCounters[3u].w || child >= 4u)
        return SIGMA_N4_INVALID;
    uint detail = SigmaN4PublishActiveSupportAddress(activeIndex, 1u);
    uint2 receipt = _NativeCloseScratch[detail];
    if ((receipt.y & SIGMA_N4_REFINEMENT_STATUS_MASK) !=
        SIGMA_N4_REFINEMENT_PROVED)
        return SIGMA_N4_INVALID;
    uint4 representatives = _NativeStateDeltas[
        SigmaN4PublishRefinementScratchAddress(activeIndex)].State01;
    return child == 0u ? representatives.x :
        (child == 1u ? representatives.y :
        (child == 2u ? representatives.z : representatives.w));
}

bool SigmaN4PublishStateEqual(uint left, uint right)
{
    bool equal = true;
    [loop]
    for (uint lane = 0u; lane < 16u; ++lane)
        equal = equal && all(_NativePrepareStates[
            _NativeFootprintStateOffset + left * 16u + lane] ==
            _NativePrepareStates[
                _NativeFootprintStateOffset + right * 16u + lane]);
    return equal;
}


bool SigmaN4PublishCertificateEqual(uint left, uint right)
{
    bool equal = true;
    [loop]
    for (uint word = 0u; word < SIGMA_CERTIFICATE_WORD_COUNT; ++word)
        equal = equal && all(_NativeLocalityCertificateWords[
            _NativeFootprintCertificateOffset +
                left * SIGMA_CERTIFICATE_WORD_COUNT + word] ==
            _NativeLocalityCertificateWords[
                _NativeFootprintCertificateOffset +
                    right * SIGMA_CERTIFICATE_WORD_COUNT + word]);
    return equal;
}

uint SigmaN4PublishSignedOrderKey(int value)
{
    return asuint(value) ^ 0x80000000u;
}

int SigmaN4PublishSignedOrderValue(uint value)
{
    return asint(value ^ 0x80000000u);
}

uint SigmaN4PublishPackedActiveIndex(uint packed)
{
    return packed & SIGMA_N4_ACTIVE_INDEX_MASK;
}


bool SigmaN4PublishStructuralCertificateCompatible(uint left, uint right)
{
    bool compatible = true;
    [unroll]
    for (uint index = 0u; index < 5u; ++index)
    {
        uint word = index == 0u ? SIGMA_CERTIFICATE_CONTEXT :
            (index == 1u ? SIGMA_CERTIFICATE_RELATION :
            (index == 2u ? SIGMA_CERTIFICATE_RECEIPTS0 :
            (index == 3u ? SIGMA_CERTIFICATE_RECEIPTS0 + 1u :
                SIGMA_CERTIFICATE_RECEIPTS0 + 3u)));
        compatible = compatible && all(_NativeLocalityCertificateWords[
            _NativeFootprintCertificateOffset +
                left * SIGMA_CERTIFICATE_WORD_COUNT + word] ==
            _NativeLocalityCertificateWords[
                _NativeFootprintCertificateOffset +
                    right * SIGMA_CERTIFICATE_WORD_COUNT + word]);
    }
    uint4 leftIdentity = _NativeLocalityCertificateWords[
        _NativeFootprintCertificateOffset +
            left * SIGMA_CERTIFICATE_WORD_COUNT + SIGMA_CERTIFICATE_IDENTITY];
    uint4 rightIdentity = _NativeLocalityCertificateWords[
        _NativeFootprintCertificateOffset +
            right * SIGMA_CERTIFICATE_WORD_COUNT + SIGMA_CERTIFICATE_IDENTITY];
    return compatible && leftIdentity.y == rightIdentity.y &&
        ((leftIdentity.x ^ rightIdentity.x) &
            SIGMA_NATIVE_CERTIFICATE_FLAGS_COUPLED) == 0u;
}

bool SigmaN4PublishMeetParentCertificateCore(uint footprint, uint sourceSlot,
    uint sourceSample, bool apply)
{
    if (!SigmaN4PublishSourceSampleInRange(sourceSlot, sourceSample))
        return false;
    uint parent = SigmaCarrierRepresentationAddress(sourceSlot, sourceSample,
        SIGMA_REPRESENTATION_CERTIFICATE);
    uint fresh = _NativeFootprintCertificateOffset +
        footprint * SIGMA_CERTIFICATE_WORD_COUNT;
    uint required = SIGMA_NATIVE_CERTIFICATE_FLAGS_VALID |
        SIGMA_NATIVE_CERTIFICATE_FLAGS_DIRECTIONAL |
        SIGMA_NATIVE_CERTIFICATE_FLAGS_MINIMIZED;
    uint4 parentIdentity = _NativeSourceCarrierRepresentation[parent];
    uint4 freshIdentity = _NativeLocalityCertificateWords[fresh];
    bool compatible = (parentIdentity.x & required) == required &&
        (freshIdentity.x & required) == required &&
        parentIdentity.y == freshIdentity.y &&
        ((parentIdentity.x ^ freshIdentity.x) &
            SIGMA_NATIVE_CERTIFICATE_FLAGS_COUPLED) == 0u;
    [unroll]
    for (uint structuralIndex = 0u; structuralIndex < 5u;
         ++structuralIndex)
    {
        uint word = structuralIndex == 0u ? SIGMA_CERTIFICATE_CONTEXT :
            (structuralIndex == 1u ? SIGMA_CERTIFICATE_RELATION :
            (structuralIndex == 2u ? SIGMA_CERTIFICATE_RECEIPTS0 :
            (structuralIndex == 3u ? SIGMA_CERTIFICATE_RECEIPTS0 + 1u :
                SIGMA_CERTIFICATE_RECEIPTS0 + 3u)));
        compatible = compatible && all(
            _NativeSourceCarrierRepresentation[parent + word] ==
            _NativeLocalityCertificateWords[fresh + word]);
    }
    if (!compatible) return false;

    uint valid = 1u;
    [loop]
    for (uint word = 0u; word < SIGMA_CERTIFICATE_WORD_COUNT; ++word)
    {
        uint4 left = _NativeSourceCarrierRepresentation[parent + word];
        uint4 right = _NativeLocalityCertificateWords[fresh + word];
        uint4 merged = left;
        if (word == SIGMA_CERTIFICATE_IDENTITY)
            merged = uint4(left.x | right.x, left.y, 1u, 0u);
        else if (word == SIGMA_CERTIFICATE_INDEPENDENCE)
            merged = 0u;
        else if (word >= SIGMA_CERTIFICATE_AXIS0 &&
            word < SIGMA_CERTIFICATE_INFORMATION0)
        {
            merged = uint4(SigmaQ48Max(left.xy, right.xy),
                SigmaQ48Min(left.zw, right.zw));
            valid &= !SigmaI64Less(merged.zw, merged.xy) ? 1u : 0u;
        }
        else if (word >= SIGMA_CERTIFICATE_INFORMATION0 &&
            word < SIGMA_CERTIFICATE_RECEIPTS0)
        {
            uint axis = word - SIGMA_CERTIFICATE_INFORMATION0;
            uint4 interval = uint4(SigmaQ48Max(
                    _NativeSourceCarrierRepresentation[
                        parent + SIGMA_CERTIFICATE_AXIS0 + axis].xy,
                    _NativeLocalityCertificateWords[
                        fresh + SIGMA_CERTIFICATE_AXIS0 + axis].xy),
                SigmaQ48Min(_NativeSourceCarrierRepresentation[
                        parent + SIGMA_CERTIFICATE_AXIS0 + axis].zw,
                    _NativeLocalityCertificateWords[
                        fresh + SIGMA_CERTIFICATE_AXIS0 + axis].zw));
            uint widthValid = valid;
            uint2 width = SigmaQ48SubChecked(interval.zw, interval.xy,
                widthValid);
            valid &= widthValid;
            merged = valid != 0u ? uint4(width, axis, 3u) : 0u;
        }
        else if (word == SIGMA_CERTIFICATE_RECEIPTS0 + 2u)
            merged = left | right;
        if (apply)
            _NativeLocalityCertificateWords[fresh + word] = merged;
    }
    return valid != 0u;
}

bool SigmaN4PublishValidateParentCertificateMeet(uint footprint,
    uint sourceSlot, uint sourceSample)
{
    return SigmaN4PublishMeetParentCertificateCore(footprint, sourceSlot,
        sourceSample, false);
}


uint4 SigmaN4PublishParentCertificateMeetWord(uint parent, uint fresh,
    uint word, out uint valid)
{
    valid = 1u;
    uint4 left = _NativeLocalityCertificateWords[fresh + word];
    uint4 right = _NativeSourceCarrierRepresentation[parent + word];
    uint4 merged = left;
    if (word == SIGMA_CERTIFICATE_IDENTITY)
        merged = uint4(left.x | right.x, left.y, 1u, 0u);
    else if (word == SIGMA_CERTIFICATE_INDEPENDENCE)
        merged = 0u;
    else if (word >= SIGMA_CERTIFICATE_AXIS0 &&
        word < SIGMA_CERTIFICATE_INFORMATION0)
    {
        merged = uint4(SigmaQ48Max(left.xy, right.xy),
            SigmaQ48Min(left.zw, right.zw));
        valid &= !SigmaI64Less(merged.zw, merged.xy) ? 1u : 0u;
    }
    else if (word >= SIGMA_CERTIFICATE_INFORMATION0 &&
        word < SIGMA_CERTIFICATE_RECEIPTS0)
    {
        uint axis = word - SIGMA_CERTIFICATE_INFORMATION0;
        uint4 interval = uint4(SigmaQ48Max(
                _NativeSourceCarrierRepresentation[
                    parent + SIGMA_CERTIFICATE_AXIS0 + axis].xy,
                _NativeLocalityCertificateWords[
                    fresh + SIGMA_CERTIFICATE_AXIS0 + axis].xy),
            SigmaQ48Min(_NativeSourceCarrierRepresentation[
                    parent + SIGMA_CERTIFICATE_AXIS0 + axis].zw,
                _NativeLocalityCertificateWords[
                    fresh + SIGMA_CERTIFICATE_AXIS0 + axis].zw));
        uint widthValid = valid;
        uint2 width = SigmaQ48SubChecked(interval.zw, interval.xy,
            widthValid);
        valid &= widthValid;
        merged = valid != 0u ? uint4(width, axis, 3u) : 0u;
    }
    else if (word == SIGMA_CERTIFICATE_RECEIPTS0 + 2u)
        merged = left | right;
    return merged;
}



// N4.1R refinement is lowered across the already-existing canonical graph
// boundaries.  The upper mutation-arena tail is dead after canonical key
// generation and is large enough for one execution-only record per active
// published support.  It is never a persistent support/component object.
uint SigmaN4PublishRefinementScratchAddress(uint activeIndex)
{
    return _NativeCanonicalComponentCapacity +
        _NativeFootprintCount * 2u + activeIndex;
}

// CanonicalRankScratch holds the seed footprint stream only through canonical
// run construction.  Once D4 selection has completed, selected local ranks are
// not consumed by any later CUT-E stage.  Reuse that dead lifetime for the
// compact refinement-group -> active-support locator so publication mutations
// cannot overwrite the scheduler receipt in StateDelta.
uint SigmaN4PublishRefinementGroupAddress(uint group)
{
    return _NativeCanonicalRankScratchOffset + group;
}

// Canonical cells deliberately collapse repeated observations of the same
// published support.  Refinement must not: every admitted observation remains
// a member of the exact 2x2 proof.  Pack that execution-only member stream four
// ids per record in the already-owned mutation-arena tail.  The stream is dead
// before publication mutations are appended and its atomic order is never
// serialized or used as a canonical tie.
uint SigmaN4PublishRefinementMemberRecordBase()
{
    return _NativeCanonicalComponentCapacity + _NativeFootprintCount * 3u;
}

bool SigmaN4PublishRefinementMemberStorageValid()
{
    return SigmaN4PublishRefinementMemberRecordBase() +
        (_NativeFootprintCount + 3u) / 4u <= _NativeMutationCapacity;
}

void SigmaN4PublishStoreRefinementMember(uint index, uint footprint)
{
    if (index >= _NativeFootprintCount ||
        !SigmaN4PublishRefinementMemberStorageValid())
    {
        uint ignored;
        InterlockedOr(_NativeCounters[0u].z,
            SIGMA_N4_FAULT_LOGICAL_EXTENT, ignored);
        return;
    }
    uint address = SigmaN4PublishRefinementMemberRecordBase() + (index >> 2u);
    uint lane = index & 3u;
    uint ignored;
    if (lane == 0u)
        InterlockedExchange(_NativeStateDeltas[address].Coordinate.x,
            footprint, ignored);
    else if (lane == 1u)
        InterlockedExchange(_NativeStateDeltas[address].Coordinate.y,
            footprint, ignored);
    else if (lane == 2u)
        InterlockedExchange(_NativeStateDeltas[address].Coordinate.z,
            footprint, ignored);
    else
        InterlockedExchange(_NativeStateDeltas[address].Coordinate.w,
            footprint, ignored);
}

uint SigmaN4PublishLoadRefinementMember(uint index)
{
    if (index >= _NativeCounters[1u].w ||
        !SigmaN4PublishRefinementMemberStorageValid())
        return SIGMA_N4_INVALID;
    uint4 members = _NativeStateDeltas[
        SigmaN4PublishRefinementMemberRecordBase() + (index >> 2u)].Coordinate;
    uint lane = index & 3u;
    return lane == 0u ? members.x :
        (lane == 1u ? members.y : (lane == 2u ? members.z : members.w));
}

void SigmaN4PublishAppendRefinementMember(uint footprint)
{
    uint index;
    InterlockedAdd(_NativeCounters[1u].w, 1u, index);
    SigmaN4PublishStoreRefinementMember(index, footprint);
}

bool SigmaN4PublishSameRefinementCoordinate(uint left, uint right)
{
    uint leftComponent;
    uint leftOrbit;
    uint4 leftChart;
    uint leftLevel;
    uint leftSupport;
    bool leftValid = SigmaN4PublishChartCore(left, false, leftComponent,
        leftOrbit, leftChart, leftLevel, leftSupport);
    uint rightComponent;
    uint rightOrbit;
    uint4 rightChart;
    uint rightLevel;
    uint rightSupport;
    bool rightValid = SigmaN4PublishChartCore(right, false, rightComponent,
        rightOrbit, rightChart, rightLevel, rightSupport);
    return leftValid && rightValid && leftComponent == rightComponent &&
        leftLevel == rightLevel && all(leftChart.zw == rightChart.zw);
}

uint SigmaN4PublishRefinementCoordinateSlot(uint activeIndex,
    uint footprint)
{
    if (!SigmaN4PublishRefinementScratchValid(activeIndex))
        return SIGMA_N4_INVALID;
    uint address = SigmaN4PublishRefinementScratchAddress(activeIndex);
    [unroll]
    for (uint slot = 0u; slot < 4u; ++slot)
    {
        uint observed;
        if (slot == 0u)
            InterlockedCompareExchange(_NativeStateDeltas[address].Witness.x,
                SIGMA_N4_INVALID, footprint, observed);
        else if (slot == 1u)
            InterlockedCompareExchange(_NativeStateDeltas[address].Witness.y,
                SIGMA_N4_INVALID, footprint, observed);
        else if (slot == 2u)
            InterlockedCompareExchange(_NativeStateDeltas[address].Witness.z,
                SIGMA_N4_INVALID, footprint, observed);
        else
            InterlockedCompareExchange(_NativeStateDeltas[address].Witness.w,
                SIGMA_N4_INVALID, footprint, observed);
        uint representative = observed == SIGMA_N4_INVALID
            ? footprint : observed;
        if (SigmaN4PublishSameRefinementCoordinate(representative,
                footprint))
        {
            uint ignored;
            if (slot == 0u)
                InterlockedMin(_NativeStateDeltas[address].Witness.x,
                    footprint, ignored);
            else if (slot == 1u)
                InterlockedMin(_NativeStateDeltas[address].Witness.y,
                    footprint, ignored);
            else if (slot == 2u)
                InterlockedMin(_NativeStateDeltas[address].Witness.z,
                    footprint, ignored);
            else
                InterlockedMin(_NativeStateDeltas[address].Witness.w,
                    footprint, ignored);
            return slot;
        }
    }
    return SIGMA_N4_INVALID;
}

uint SigmaN4PublishRefinementCoordinateRepresentative(uint activeIndex,
    uint footprint)
{
    if (!SigmaN4PublishRefinementScratchValid(activeIndex))
        return SIGMA_N4_INVALID;
    uint4 representatives = _NativeStateDeltas[
        SigmaN4PublishRefinementScratchAddress(activeIndex)].Witness;
    [unroll]
    for (uint slot = 0u; slot < 4u; ++slot)
    {
        uint representative = slot == 0u ? representatives.x :
            (slot == 1u ? representatives.y :
            (slot == 2u ? representatives.z : representatives.w));
        if (representative != SIGMA_N4_INVALID &&
            SigmaN4PublishSameRefinementCoordinate(representative,
                footprint))
            return representative;
    }
    return SIGMA_N4_INVALID;
}

bool SigmaN4PublishRefinementScratchValid(uint activeIndex)
{
    return activeIndex < _NativeFootprintCount &&
        SigmaN4PublishRefinementScratchAddress(activeIndex) <
            _NativeMutationCapacity;
}

uint2 SigmaN4PublishLoadFinalImage(uint image, uint index)
{
    return _NativeCloseScratch[SigmaN4PublishImageAddress(image, index)];
}

void SigmaN4PublishInitializeRefinementLeader(uint2 entry)
{
    if (entry.x == SIGMA_N4_INVALID) return;
    uint footprint = entry.x;
    uint support = SigmaN4PublishSupportLocator(footprint);
    if (support == SIGMA_N4_INVALID) return;
    uint marker = _NativeActiveSupportMarkerScratchOffset + support;
    uint leader = _NativeCloseScratch[marker].y;
    if (leader != footprint) return;

    uint activeIndex;
    InterlockedAdd(_NativeCounters[3u].w, 1u, activeIndex);
    if (!SigmaN4PublishRefinementScratchValid(activeIndex))
    {
        InterlockedOr(_NativeCounters[0u].z,
            SIGMA_N4_FAULT_LOGICAL_EXTENT);
        return;
    }
    _NativeCloseScratch[marker].x = activeIndex;
    uint active = SigmaN4PublishActiveSupportAddress(activeIndex, 0u);
    _NativeCloseScratch[active] = uint2(support, leader);
    _NativeCloseScratch[active + 1u] =
        uint2(SIGMA_N4_INVALID, SIGMA_N4_REFINEMENT_NONE);

    SigmaNativeStateDeltaGpu scratch = (SigmaNativeStateDeltaGpu)0;
    scratch.Coordinate = uint4(support, leader, 0u, 0u);
    scratch.Generation = uint4(0xffffffffu, 0u, 0xffffffffu, 0u);
    scratch.Witness = 0xffffffffu;
    scratch.State01 = 0xffffffffu;
    _NativeStateDeltas[
        SigmaN4PublishRefinementScratchAddress(activeIndex)] = scratch;
}

void SigmaN4PublishReduceRefinementMember(uint footprint)
{
    if (footprint == SIGMA_N4_INVALID || footprint >= _NativeFootprintCount)
        return;
    uint support = SigmaN4PublishSupportLocator(footprint);
    if (support == SIGMA_N4_INVALID) return;
    uint marker = _NativeActiveSupportMarkerScratchOffset + support;
    uint activeIndex = _NativeCloseScratch[marker].x;
    if (!SigmaN4PublishRefinementScratchValid(activeIndex))
    {
        InterlockedOr(_NativeCounters[0u].z,
            SIGMA_N4_FAULT_SOURCE_LOCATOR);
        return;
    }

    uint scratchAddress = SigmaN4PublishRefinementScratchAddress(activeIndex);
    uint leader = _NativeStateDeltas[scratchAddress].Coordinate.y;
    uint flags =
        (!SigmaN4PublishStateEqual(leader, footprint)
            ? SIGMA_N4_REFINEMENT_STATE_DIFFERENCE : 0u) |
        (!SigmaN4PublishStructuralCertificateCompatible(leader, footprint)
            ? SIGMA_N4_REFINEMENT_STRUCTURAL_INVALID : 0u);

    uint component;
    uint orbit;
    uint4 chart;
    uint level;
    uint ignoredSupport;
    bool chartValid = SigmaN4PublishChartCore(footprint, false, component,
        orbit, chart, level, ignoredSupport);
    uint leaderComponent;
    uint leaderOrbit;
    uint4 leaderChart;
    uint leaderLevel;
    bool leaderValid = SigmaN4PublishChartCore(leader, false,
        leaderComponent, leaderOrbit, leaderChart, leaderLevel,
        ignoredSupport);
    uint transformValid = chartValid && leaderValid ? 1u : 0u;
    int2 position0 = SigmaMerkabaTransformChartCellLower(
        int2(asint(chart.z), asint(chart.w)), 0u, transformValid);
    if (transformValid == 0u || component != leaderComponent ||
        level != leaderLevel)
        flags |= SIGMA_N4_REFINEMENT_STRUCTURAL_INVALID;
    if (transformValid != 0u && component == leaderComponent &&
        level == leaderLevel &&
        SigmaN4PublishRefinementCoordinateSlot(activeIndex, footprint) ==
            SIGMA_N4_INVALID)
        flags |= SIGMA_N4_REFINEMENT_STRUCTURAL_INVALID;

    uint ignored;
    InterlockedAdd(_NativeStateDeltas[scratchAddress].Coordinate.z, 1u,
        ignored);
    if (flags != 0u)
        InterlockedOr(_NativeStateDeltas[scratchAddress].Coordinate.w,
            flags, ignored);
    if (transformValid != 0u)
    {
        uint u = SigmaN4PublishSignedOrderKey(position0.x);
        uint v = SigmaN4PublishSignedOrderKey(position0.y);
        InterlockedMin(_NativeStateDeltas[scratchAddress].Generation.x, u,
            ignored);
        InterlockedMax(_NativeStateDeltas[scratchAddress].Generation.y, u,
            ignored);
        InterlockedMin(_NativeStateDeltas[scratchAddress].Generation.z, v,
            ignored);
        InterlockedMax(_NativeStateDeltas[scratchAddress].Generation.w, v,
            ignored);
    }
}

uint SigmaN4PublishRefinementPreStatus(uint activeIndex,
    out uint component, out uint level)
{
    component = SIGMA_N4_INVALID;
    level = SIGMA_N4_INVALID;
    if (!SigmaN4PublishRefinementScratchValid(activeIndex))
        return SIGMA_N4_REFINEMENT_UNRESOLVED;
    SigmaNativeStateDeltaGpu scratch = _NativeStateDeltas[
        SigmaN4PublishRefinementScratchAddress(activeIndex)];
    uint flags = scratch.Coordinate.w;
    bool commonState =
        (flags & SIGMA_N4_REFINEMENT_STATE_DIFFERENCE) == 0u;
    bool structural = scratch.Coordinate.z >= 2u &&
        (flags & SIGMA_N4_REFINEMENT_STRUCTURAL_INVALID) == 0u;
    int minimumU = SigmaN4PublishSignedOrderValue(scratch.Generation.x);
    int maximumU = SigmaN4PublishSignedOrderValue(scratch.Generation.y);
    int minimumV = SigmaN4PublishSignedOrderValue(scratch.Generation.z);
    int maximumV = SigmaN4PublishSignedOrderValue(scratch.Generation.w);
    structural = structural && scratch.Generation.x != 0xffffffffu &&
        scratch.Generation.z != 0xffffffffu && maximumU >= minimumU &&
        maximumV >= minimumV && maximumU - minimumU <= 1 &&
        maximumV - minimumV <= 1;

    uint support = scratch.Coordinate.x;
    uint sourceSlot = support / SIGMA_PAGE_SAMPLE_COUNT;
    uint sourceSample = support - sourceSlot * SIGMA_PAGE_SAMPLE_COUNT;
    bool sourceValid = SigmaN4PublishSourceSampleInRange(sourceSlot,
        sourceSample);
    uint4 sourcePlan = 0u;
    if (sourceValid)
        sourcePlan = _NativeSourceCarrierRepresentation[
            SigmaCarrierRepresentationAddress(sourceSlot, sourceSample,
                SIGMA_REPRESENTATION_GAUGE_PLAN)];

    uint orbit;
    uint4 chart;
    uint supportIgnored;
    bool chartValid = SigmaN4PublishChartCore(scratch.Coordinate.y, false,
        component, orbit, chart, level, supportIgnored);
    structural = structural && sourceValid && chartValid &&
        (sourcePlan.y & SIGMA_NATIVE_GAUGE_CELL_FLAGS_ACTIVE) != 0u &&
        sourcePlan.x < 62u && component < _NativeCanonicalComponentCapacity;
    if (commonState) return SIGMA_N4_REFINEMENT_NONE;
    return structural ? SIGMA_N4_REFINEMENT_PROVED :
        SIGMA_N4_REFINEMENT_UNRESOLVED;
}

bool SigmaN4PublishSelectedBounds(uint activeIndex, uint image,
    out int2 minimum, out int2 maximum)
{
    minimum = int2(0x7fffffff, 0x7fffffff);
    maximum = int2(-2147483647, -2147483647);
    if (!SigmaN4PublishRefinementScratchValid(activeIndex)) return false;
    uint4 bounds = _NativeStateDeltas[
        SigmaN4PublishRefinementScratchAddress(activeIndex)].Generation;
    if (bounds.x == 0xffffffffu || bounds.z == 0xffffffffu) return false;
    int2 low = int2(SigmaN4PublishSignedOrderValue(bounds.x),
        SigmaN4PublishSignedOrderValue(bounds.z));
    int2 high = int2(SigmaN4PublishSignedOrderValue(bounds.y),
        SigmaN4PublishSignedOrderValue(bounds.w));
    uint valid = 1u;
    [unroll]
    for (uint corner = 0u; corner < 4u; ++corner)
    {
        int2 cell = int2((corner & 1u) == 0u ? low.x : high.x,
            (corner & 2u) == 0u ? low.y : high.y);
        int2 transformed = SigmaMerkabaTransformChartCellLower(cell, image,
            valid);
        minimum = min(minimum, transformed);
        maximum = max(maximum, transformed);
    }
    return valid != 0u && all(maximum >= minimum) &&
        all(maximum - minimum <= 1);
}

int SigmaN4PublishComparePreparedCoordinateKey(uint left, uint leftImage,
    uint right, uint rightImage, out uint valid);

uint SigmaN4PublishFindCoordinateRepresentative(uint component, uint image,
    uint footprint)
{
    uint2 meta = _NativeCloseScratch[
        SigmaN4PublishComponentAddress(component, 0u)];
    uint low = meta.y;
    uint high = meta.y + meta.x;
    [loop]
    while (low < high)
    {
        uint middle = low + ((high - low) >> 1u);
        uint2 candidate = SigmaN4PublishLoadFinalImage(image, middle);
        uint valid;
        int comparison = candidate.x == SIGMA_N4_INVALID ? 1 :
            SigmaN4PublishComparePreparedCoordinateKey(candidate.x, image,
                footprint, image, valid);
        if (candidate.x != SIGMA_N4_INVALID && valid == 0u)
            return SIGMA_N4_INVALID;
        if (comparison < 0) low = middle + 1u;
        else high = middle;
    }
    if (low >= meta.y + meta.x) return SIGMA_N4_INVALID;
    uint2 result = SigmaN4PublishLoadFinalImage(image, low);
    uint valid;
    return result.x != SIGMA_N4_INVALID && result.y == component &&
        SigmaN4PublishComparePreparedCoordinateKey(result.x, image,
            footprint, image, valid) == 0 && valid != 0u
        ? result.x : SIGMA_N4_INVALID;
}

bool SigmaN4PublishRefinementChildKey(uint activeIndex, uint child,
    out uint4 coordinate, out uint level);

void SigmaN4PublishFinishRefinementMember(uint footprint)
{
    if (footprint == SIGMA_N4_INVALID || footprint >= _NativeFootprintCount)
        return;
    uint support = SigmaN4PublishSupportLocator(footprint);
    if (support == SIGMA_N4_INVALID) return;
    uint marker = _NativeActiveSupportMarkerScratchOffset + support;
    uint activeIndex = _NativeCloseScratch[marker].x;
    if (!SigmaN4PublishRefinementScratchValid(activeIndex)) return;
    uint scratchAddress = SigmaN4PublishRefinementScratchAddress(activeIndex);
    uint component;
    uint level;
    uint status = SigmaN4PublishRefinementPreStatus(activeIndex, component,
        level);
    uint child = 0u;
    uint representative = SIGMA_N4_INVALID;
    bool exact = status != SIGMA_N4_REFINEMENT_PROVED;
    if (status == SIGMA_N4_REFINEMENT_PROVED)
    {
        uint image = _NativeCloseScratch[
            SigmaN4PublishComponentAddress(component, 1u)].x;
        int2 minimum;
        int2 maximum;
        bool boundsValid = image < 8u &&
            SigmaN4PublishSelectedBounds(activeIndex, image, minimum,
                maximum);
        uint memberComponent;
        uint orbit;
        uint4 chart;
        uint memberLevel;
        uint ignoredSupport;
        bool chartValid = SigmaN4PublishChartCore(footprint, false,
            memberComponent, orbit, chart, memberLevel, ignoredSupport);
        uint transformValid = chartValid && boundsValid ? 1u : 0u;
        int2 selected = SigmaMerkabaTransformChartCellLower(
            int2(asint(chart.z), asint(chart.w)), image, transformValid);
        int2 relative = selected - minimum;
        bool inChild = transformValid != 0u && memberComponent == component &&
            memberLevel == level && all(relative >= 0) &&
            all(relative <= 1);
        if (inChild)
        {
            child = (uint)relative.x + ((uint)relative.y << 1u);
            representative =
                SigmaN4PublishRefinementCoordinateRepresentative(activeIndex,
                    footprint);
            uint sourceSlot = support / SIGMA_PAGE_SAMPLE_COUNT;
            uint sourceSample = support - sourceSlot * SIGMA_PAGE_SAMPLE_COUNT;
            exact = representative != SIGMA_N4_INVALID &&
                SigmaN4PublishStateEqual(representative, footprint) &&
                SigmaN4PublishCertificateEqual(representative, footprint) &&
                SigmaN4PublishValidateParentCertificateMeet(representative,
                    sourceSlot, sourceSample);
        }
        if (exact)
        {
            uint ignored;
            InterlockedOr(_NativeStateDeltas[scratchAddress].Changed.x,
                1u << child, ignored);
            // HLSL atomics require a statically addressable scalar on the
            // Quest Vulkan path.  The child is semantic payload only; select
            // the corresponding scalar without a dynamic vector l-value.
            if (child == 0u)
                InterlockedMin(
                    _NativeStateDeltas[scratchAddress].State01.x,
                    representative, ignored);
            else if (child == 1u)
                InterlockedMin(
                    _NativeStateDeltas[scratchAddress].State01.y,
                    representative, ignored);
            else if (child == 2u)
                InterlockedMin(
                    _NativeStateDeltas[scratchAddress].State01.z,
                    representative, ignored);
            else
                InterlockedMin(
                    _NativeStateDeltas[scratchAddress].State01.w,
                    representative, ignored);
        }
        else
        {
            uint ignored;
            InterlockedOr(_NativeStateDeltas[scratchAddress].Coordinate.w,
                SIGMA_N4_REFINEMENT_STRUCTURAL_INVALID, ignored);
        }
    }
    DeviceMemoryBarrier();
    uint previous;
    InterlockedAdd(_NativeStateDeltas[scratchAddress].Changed.y, 1u,
        previous);
    uint memberCount = _NativeStateDeltas[scratchAddress].Coordinate.z;
    if (previous + 1u != memberCount) return;

    DeviceMemoryBarrier();
    uint finalComponent;
    uint finalLevel;
    status = SigmaN4PublishRefinementPreStatus(activeIndex, finalComponent,
        finalLevel);
    uint occupied = _NativeStateDeltas[scratchAddress].Changed.x;
    if (status == SIGMA_N4_REFINEMENT_PROVED && countbits(occupied) < 2u)
        status = SIGMA_N4_REFINEMENT_UNRESOLVED;
    uint group = SIGMA_N4_INVALID;
    if (status == SIGMA_N4_REFINEMENT_PROVED)
    {
        [unroll]
        for (uint outputChild = 0u; outputChild < 4u; ++outputChild)
        {
            uint4 coordinate;
            uint childLevel;
            if (!SigmaN4PublishRefinementChildKey(activeIndex, outputChild,
                    coordinate, childLevel))
                status = SIGMA_N4_REFINEMENT_UNRESOLVED;
        }
        if (status == SIGMA_N4_REFINEMENT_PROVED)
        {
            InterlockedAdd(_NativeCounters[1u].z, 1u, group);
            if (group >= _NativeCanonicalComponentCapacity)
                status = SIGMA_N4_REFINEMENT_UNRESOLVED;
            else
            {
                _NativeCloseScratch[
                    SigmaN4PublishRefinementGroupAddress(group)] =
                        uint2(activeIndex, finalComponent);
                uint ignored;
                InterlockedAdd(_NativeCloseScratch[
                    SigmaN4PublishComponentAddress(finalComponent, 3u)].x,
                    3u, ignored);
            }
        }
    }
    if (status == SIGMA_N4_REFINEMENT_UNRESOLVED)
    {
        uint ignored;
        InterlockedOr(_NativeCounters[0u].w, 1u, ignored);
        group = SIGMA_N4_INVALID;
    }
    uint active = SigmaN4PublishActiveSupportAddress(activeIndex, 0u);
    _NativeCloseScratch[active + 1u] = uint2(group, status);
}


uint2 SigmaN4PublishSigned64(int value)
{
    return uint2(asuint(value), value < 0 ? 0xffffffffu : 0u);
}

uint4 SigmaN4PublishTransformedCoordinate(uint footprint, uint image,
    out uint component, out uint level, inout uint valid)
{
    component = SIGMA_N4_INVALID;
    level = 0u;
    uint orbit = 0u;
    uint4 chart = 0u;
    uint support = SIGMA_N4_INVALID;
    bool chartValid = SigmaN4PublishChart(footprint, component, orbit, chart,
        level, support);
    valid = valid != 0u && chartValid ? 1u : 0u;
    int2 transformed = int2(0, 0);
    if (valid != 0u)
        transformed = SigmaMerkabaTransformChartCellLower(
            int2(asint(chart.z), asint(chart.w)), image, valid);
    return uint4(SigmaN4PublishSigned64(transformed.x),
        SigmaN4PublishSigned64(transformed.y));
}

uint4 SigmaN4PublishCoordinate(uint footprint, uint image, out uint level,
    inout uint valid)
{
    level = 0u;
    uint component = SIGMA_N4_INVALID;
    uint4 transformed = SigmaN4PublishTransformedCoordinate(footprint, image,
        component, level, valid);
    if (valid == 0u || component >= _NativeCanonicalComponentCapacity)
    {
        valid = 0u;
        return 0u;
    }
    uint anchor = _NativeCloseScratch[
        SigmaN4PublishComponentAddress(component, 2u + image)].x;
    if (anchor >= _NativeFootprintCount)
    {
        valid = 0u;
        return 0u;
    }
    uint anchorComponent = SIGMA_N4_INVALID;
    uint anchorLevel = 0u;
    uint4 anchorCoordinate = SigmaN4PublishTransformedCoordinate(anchor,
        image, anchorComponent, anchorLevel, valid);
    valid = valid != 0u && anchorComponent == component ? 1u : 0u;

    // Arithmetic right shift is exact floor division for signed two's-
    // complement integers. The one accepted dyadic-lower anchor therefore
    // supplies one common base translation for both U and V at every level.
    uint2 translationU = SigmaI64ShiftRightRaw(anchorCoordinate.xy,
        anchorLevel);
    uint2 translationV = SigmaI64ShiftRightRaw(anchorCoordinate.zw,
        anchorLevel);
    translationU = SigmaQ48ShiftLeftChecked(translationU, level, valid);
    translationV = SigmaQ48ShiftLeftChecked(translationV, level, valid);
    return uint4(SigmaQ48SubChecked(transformed.xy, translationU, valid),
        SigmaQ48SubChecked(transformed.zw, translationV, valid));
}

uint4 SigmaN4PublishSelectedCoordinate(uint footprint, out uint level,
    inout uint valid)
{
    uint component;
    uint orbit;
    uint4 chart;
    uint support;
    valid &= SigmaN4PublishChartCore(footprint, false, component, orbit, chart,
        level, support) ? 1u : 0u;
    uint image = valid != 0u ? _NativeCloseScratch[
        SigmaN4PublishComponentAddress(component, 1u)].x : 0u;
    uint anchor = valid != 0u ? _NativeCloseScratch[
        SigmaN4PublishComponentAddress(component, 9u)].x : SIGMA_N4_INVALID;
    valid &= image < 8u && anchor != SIGMA_N4_INVALID ? 1u : 0u;
    int2 transformedCell = SigmaMerkabaTransformChartCellLower(
        int2(asint(chart.z), asint(chart.w)), image, valid);
    uint4 transformed = uint4(SigmaN4PublishSigned64(transformedCell.x),
        SigmaN4PublishSigned64(transformedCell.y));

    uint anchorComponent;
    uint anchorOrbit;
    uint4 anchorChart;
    uint anchorLevel;
    uint anchorSupport;
    valid &= SigmaN4PublishChartCore(anchor, false, anchorComponent,
        anchorOrbit, anchorChart, anchorLevel, anchorSupport) ? 1u : 0u;
    valid &= anchorComponent == component ? 1u : 0u;
    int2 anchorCell = SigmaMerkabaTransformChartCellLower(
        int2(asint(anchorChart.z), asint(anchorChart.w)), image, valid);
    uint4 anchorCoordinate = uint4(SigmaN4PublishSigned64(anchorCell.x),
        SigmaN4PublishSigned64(anchorCell.y));
    uint2 translationU = SigmaI64ShiftRightRaw(anchorCoordinate.xy,
        anchorLevel);
    uint2 translationV = SigmaI64ShiftRightRaw(anchorCoordinate.zw,
        anchorLevel);
    translationU = SigmaQ48ShiftLeftChecked(translationU, level, valid);
    translationV = SigmaQ48ShiftLeftChecked(translationV, level, valid);
    return uint4(SigmaQ48SubChecked(transformed.xy, translationU, valid),
        SigmaQ48SubChecked(transformed.zw, translationV, valid));
}

uint SigmaN4PublishCanonicalKeyAddress(uint footprint)
{
    // Canonical key records occupy the otherwise-dead upper half of the
    // already-owned mutation arena. They are execution scratch only and are
    // overwritten after D4 selection, before mutation publication begins.
    return _NativeCanonicalComponentCapacity + footprint * 2u;
}


void SigmaN4PublishStoreCanonicalKeyImage(uint footprint, uint component,
    uint expectedLevel, uint image)
{
    uint address = SigmaN4PublishCanonicalKeyAddress(footprint);
    if (image >= 8u || address + 1u >= _NativeMutationCapacity)
    {
        uint ignored;
        InterlockedOr(_NativeCounters[0u].z,
            SIGMA_N4_FAULT_CANONICAL_COORDINATE, ignored);
        return;
    }
    uint valid = 1u;
    uint level;
    uint4 coordinate = SigmaN4PublishCoordinate(footprint, image, level,
        valid);
    valid &= level == expectedLevel ? 1u : 0u;
    uint4 morton = SigmaMerkabaGaugeSignedMorton(coordinate.xy,
        coordinate.zw, valid);
    if (valid == 0u)
    {
        uint ignored;
        InterlockedOr(_NativeCounters[0u].z,
            SIGMA_N4_FAULT_CANONICAL_COORDINATE, ignored);
        return;
    }

    if (image == 0u)
    {
        _NativeStateDeltas[address].Coordinate = coordinate;
        _NativeStateDeltas[address].Generation = morton;
    }
    else if (image == 1u)
    {
        _NativeStateDeltas[address].Changed = coordinate;
        _NativeStateDeltas[address].Witness = morton;
    }
    else if (image == 2u)
    {
        _NativeStateDeltas[address].Receipts = coordinate;
        _NativeStateDeltas[address].State01 = morton;
    }
    else if (image == 3u)
    {
        _NativeStateDeltas[address].State23 = coordinate;
        _NativeStateDeltas[address].State45 = morton;
    }
    else if (image == 4u)
    {
        _NativeStateDeltas[address].State67 = coordinate;
        _NativeStateDeltas[address].State89 = morton;
    }
    else if (image == 5u)
    {
        _NativeStateDeltas[address].State1011 = coordinate;
        _NativeStateDeltas[address].State1213 = morton;
    }
    else if (image == 6u)
    {
        _NativeStateDeltas[address].State1415 = coordinate;
        _NativeStateDeltas[address + 1u].Coordinate = morton;
    }
    else
    {
        _NativeStateDeltas[address + 1u].Generation = coordinate;
        _NativeStateDeltas[address + 1u].Changed = morton;
    }
    uint ignored;
    InterlockedOr(_NativeStateDeltas[address + 1u].Witness.x,
        1u << image, ignored);
    InterlockedExchange(_NativeStateDeltas[address + 1u].Witness.y,
        expectedLevel, ignored);
    InterlockedExchange(_NativeStateDeltas[address + 1u].Witness.z,
        component, ignored);
    InterlockedExchange(_NativeStateDeltas[address + 1u].Witness.w,
        footprint, ignored);
}

bool SigmaN4PublishLoadCanonicalKey(uint footprint, uint image,
    out uint4 coordinate, out uint4 morton, out uint level)
{
    coordinate = 0u;
    morton = 0u;
    level = 0u;
    uint address = SigmaN4PublishCanonicalKeyAddress(footprint);
    if (image >= 8u || address + 1u >= _NativeMutationCapacity)
        return false;
    SigmaNativeStateDeltaGpu first = (SigmaNativeStateDeltaGpu)0;
    SigmaNativeStateDeltaGpu second = (SigmaNativeStateDeltaGpu)0;
    first = _NativeStateDeltas[address];
    second = _NativeStateDeltas[address + 1u];
    if (image == 0u)
    {
        coordinate = first.Coordinate;
        morton = first.Generation;
    }
    else if (image == 1u)
    {
        coordinate = first.Changed;
        morton = first.Witness;
    }
    else if (image == 2u)
    {
        coordinate = first.Receipts;
        morton = first.State01;
    }
    else if (image == 3u)
    {
        coordinate = first.State23;
        morton = first.State45;
    }
    else if (image == 4u)
    {
        coordinate = first.State67;
        morton = first.State89;
    }
    else if (image == 5u)
    {
        coordinate = first.State1011;
        morton = first.State1213;
    }
    else if (image == 6u)
    {
        coordinate = first.State1415;
        morton = second.Coordinate;
    }
    else
    {
        coordinate = second.Generation;
        morton = second.Changed;
    }
    level = second.Witness.y;
    return (second.Witness.x & (1u << image)) != 0u &&
        second.Witness.z < _NativeCanonicalComponentCapacity &&
        second.Witness.w == footprint;
}

int SigmaN4PublishComparePreparedCoordinateKey(uint left, uint leftImage,
    uint right, uint rightImage, out uint valid)
{
    uint4 leftCoordinate = 0u;
    uint4 rightCoordinate = 0u;
    uint4 leftMorton = 0u;
    uint4 rightMorton = 0u;
    uint leftLevel = 0u;
    uint rightLevel = 0u;
    valid = SigmaN4PublishLoadCanonicalKey(left, leftImage, leftCoordinate,
        leftMorton, leftLevel) &&
        SigmaN4PublishLoadCanonicalKey(right, rightImage, rightCoordinate,
            rightMorton, rightLevel) ? 1u : 0u;
    if (valid == 0u)
    {
        uint ignored;
        InterlockedOr(SigmaN4PublishFault,
            SIGMA_N4_FAULT_CANONICAL_COORDINATE, ignored);
        return 0;
    }
    if (leftLevel != rightLevel)
        return leftLevel < rightLevel ? -1 : 1;
    if (any(leftMorton != rightMorton))
        return SigmaMerkabaGaugeMortonLess(leftMorton, rightMorton) ? -1 : 1;
    int comparison = SigmaMerkabaCanonicalCompareHex64(leftCoordinate.xy,
        rightCoordinate.xy);
    if (comparison != 0) return comparison;
    return SigmaMerkabaCanonicalCompareHex64(leftCoordinate.zw,
        rightCoordinate.zw);
}



int SigmaN4PublishCompareReceipt128(uint4 left, uint4 right)
{
    if (left.x != right.x) return left.x < right.x ? -1 : 1;
    if (left.y != right.y) return left.y < right.y ? -1 : 1;
    if (left.z != right.z) return left.z < right.z ? -1 : 1;
    if (left.w != right.w) return left.w < right.w ? -1 : 1;
    return 0;
}

int SigmaN4PublishCompareCell(uint left, uint leftImage, uint right,
    uint rightImage)
{
    uint valid;
    int comparison = SigmaN4PublishComparePreparedCoordinateKey(left,
        leftImage, right, rightImage, valid);
    if (comparison != 0 || valid == 0u) return comparison;
    [loop]
    for (uint lane = 0u; lane < 16u; ++lane)
    {
        if (comparison == 0)
            comparison = SigmaMerkabaCanonicalCompareHex64(
                _NativePrepareStates[_NativeFootprintStateOffset +
                    left * 16u + lane],
                _NativePrepareStates[_NativeFootprintStateOffset +
                    right * 16u + lane]);
    }
    [loop]
    for (uint word = 0u; word < SIGMA_CERTIFICATE_WORD_COUNT; ++word)
    {
        if (comparison == 0)
        {
            uint4 a = _NativeLocalityCertificateWords[
                _NativeFootprintCertificateOffset +
                left * SIGMA_CERTIFICATE_WORD_COUNT + word];
            uint4 b = _NativeLocalityCertificateWords[
                _NativeFootprintCertificateOffset +
                right * SIGMA_CERTIFICATE_WORD_COUNT + word];
            comparison = SigmaN4PublishCompareReceipt128(a, b);
        }
    }
    return comparison;
}



uint SigmaN4PublishBoundaryIndex(uint footprint, uint neighbour)
{
    uint horizontal = (_NativeResolution.x - 1u) * _NativeResolution.y;
    uint low = min(footprint, neighbour);
    uint difference = max(footprint, neighbour) - low;
    if (difference == 1u)
    {
        uint y = low / _NativeResolution.x;
        uint x = low - y * _NativeResolution.x;
        return y * (_NativeResolution.x - 1u) + x;
    }
    uint y = low / _NativeResolution.x;
    uint x = low - y * _NativeResolution.x;
    return horizontal + y * _NativeResolution.x + x;
}

uint SigmaN4PublishNeighbour(uint footprint, uint direction)
{
    uint x = footprint % _NativeResolution.x;
    uint y = footprint / _NativeResolution.x;
    if (direction == 0u && x != 0u) return footprint - 1u;
    if (direction == 1u && x + 1u < _NativeResolution.x)
        return footprint + 1u;
    if (direction == 2u && y != 0u) return footprint - _NativeResolution.x;
    if (direction == 3u && y + 1u < _NativeResolution.y)
        return footprint + _NativeResolution.x;
    return SIGMA_N4_INVALID;
}

int SigmaN4PublishCompareBoundary(uint leftBoundary, uint leftForward,
    uint rightBoundary, uint rightForward)
{
    uint leftAddress = _NativeBoundaryScratchOffset +
        leftBoundary * SIGMA_N4_BOUNDARY_RECEIPT_WORDS;
    uint rightAddress = _NativeBoundaryScratchOffset +
        rightBoundary * SIGMA_N4_BOUNDARY_RECEIPT_WORDS;
    uint2 leftHeader0 = _NativeCloseScratch[leftAddress];
    uint2 leftHeader1 = _NativeCloseScratch[leftAddress + 1u];
    uint2 rightHeader0 = _NativeCloseScratch[rightAddress];
    uint2 rightHeader1 = _NativeCloseScratch[rightAddress + 1u];
    uint2 leftClassesAndCache = _NativeCloseScratch[leftAddress + 3u];
    uint2 rightClassesAndCache = _NativeCloseScratch[rightAddress + 3u];
    uint leftFrom = leftForward != 0u ? leftHeader0.y : leftHeader1.x;
    uint leftTo = leftForward != 0u ? leftHeader1.x : leftHeader0.y;
    uint rightFrom = rightForward != 0u ? rightHeader0.y : rightHeader1.x;
    uint rightTo = rightForward != 0u ? rightHeader1.x : rightHeader0.y;
    uint leftClasses = leftClassesAndCache.x;
    uint rightClasses = rightClassesAndCache.x;
    bool leftDirection = leftForward != 0u;
    bool rightDirection = rightForward != 0u;
    uint leftLinkClass = SigmaMerkabaCanonicalDirectionalClass(leftClasses,
        leftDirection, false);
    uint rightLinkClass = SigmaMerkabaCanonicalDirectionalClass(rightClasses,
        rightDirection, false);
    uint leftAssociatorClass = SigmaMerkabaCanonicalDirectionalClass(
        leftClasses, leftDirection, true);
    uint rightAssociatorClass = SigmaMerkabaCanonicalDirectionalClass(
        rightClasses, rightDirection, true);
    uint leftSignBits = _NativeCloseScratch[leftAddress + 5u].x;
    uint rightSignBits = _NativeCloseScratch[rightAddress + 5u].x;
    int leftSign = ((leftSignBits >> (leftDirection ? 0u : 1u)) & 1u) != 0u
        ? -1 : 1;
    int rightSign = ((rightSignBits >> (rightDirection ? 0u : 1u)) & 1u) != 0u
        ? -1 : 1;
    int comparison = SigmaMerkabaCanonicalCompareDirectedPrefix(
        leftFrom, leftTo, leftHeader1.y, leftSign, leftLinkClass,
        rightFrom, rightTo, rightHeader1.y, rightSign, rightLinkClass);
    if (comparison != 0) return comparison;

    // The raw link and complete intrinsic associator profile are total
    // generated functions of the already-compared endpoint payload and sector
    // pair.  The compact profile hash is only a consistency cache and is never
    // an ordering key.  Finish with the generated exact class/program/
    // provenance token order.
    uint4 provenance0 = uint4(_NativeProvenanceReceipt[0],
        _NativeProvenanceReceipt[1], _NativeProvenanceReceipt[2],
        _NativeProvenanceReceipt[3]);
    uint4 provenance1 = uint4(_NativeProvenanceReceipt[4],
        _NativeProvenanceReceipt[5], _NativeProvenanceReceipt[6],
        _NativeProvenanceReceipt[7]);
    uint leftClosure = SigmaMerkabaCanonicalClosureClass(leftClasses);
    uint rightClosure = SigmaMerkabaCanonicalClosureClass(rightClasses);
    comparison = SigmaMerkabaCanonicalCompareHex64(
        _NativeCloseScratch[leftAddress + 4u],
        _NativeCloseScratch[rightAddress + 4u]);
    if (comparison != 0) return comparison;
    comparison = SigmaMerkabaCanonicalCompareU32(
        _NativeCloseScratch[leftAddress + 5u].y,
        _NativeCloseScratch[rightAddress + 5u].y);
    if (comparison != 0) return comparison;
    return SigmaMerkabaCanonicalCompareDirectedSuffix(leftAssociatorClass,
        leftClosure, SigmaMerkabaCanonicalRelationClass(leftClasses, -1),
        provenance0, provenance1, rightAssociatorClass, rightClosure,
        SigmaMerkabaCanonicalRelationClass(rightClasses, -1), provenance0,
        provenance1);
}





int SigmaN4PublishCompareEdgeStreams(uint4 leftEdges, uint leftCount,
    uint4 rightEdges, uint rightCount)
{
    int comparison = 0;
    uint common = min(leftCount, rightCount);
    [loop]
    for (uint edge = 0u; edge < 4u; ++edge)
    {
        if (comparison == 0 && edge < common)
        {
            uint left = leftEdges[edge];
            uint right = rightEdges[edge];
            comparison = SigmaN4PublishCompareBoundary(
                left & 0x7fffffffu, left >> 31u,
                right & 0x7fffffffu, right >> 31u);
        }
    }
    if (comparison == 0 && leftCount != rightCount)
        comparison = leftCount < rightCount ? -1 : 1;
    return comparison;
}

uint SigmaN4PublishParallelRank(uint footprint, uint image);
uint2 SigmaN4PublishLoadParallelImage(uint image, uint index);
void SigmaN4PublishMinD4PairReceipt(uint component, uint pair, uint receipt);

uint SigmaN4PublishParallelEdgeTargetRank(uint encodedEdge, uint image)
{
    uint boundary = encodedEdge & 0x7fffffffu;
    uint horizontal = (_NativeResolution.x - 1u) * _NativeResolution.y;
    uint left;
    uint right;
    if (boundary < horizontal)
    {
        uint y = boundary / (_NativeResolution.x - 1u);
        uint x = boundary - y * (_NativeResolution.x - 1u);
        left = y * _NativeResolution.x + x;
        right = left + 1u;
    }
    else
    {
        uint local = boundary - horizontal;
        left = local;
        right = left + _NativeResolution.x;
    }
    uint target = (encodedEdge >> 31u) != 0u ? right : left;
    return SigmaN4PublishParallelRank(target, image);
}

int SigmaN4PublishCompareParallelEncodedEdge(uint left, uint right,
    uint image)
{
    if (left == right) return 0;
    if (left == SIGMA_N4_INVALID) return 1;
    if (right == SIGMA_N4_INVALID) return -1;
    uint leftRank = SigmaN4PublishParallelEdgeTargetRank(left, image);
    uint rightRank = SigmaN4PublishParallelEdgeTargetRank(right, image);
    if (leftRank != rightRank) return leftRank < rightRank ? -1 : 1;
    return SigmaN4PublishCompareBoundary(left & 0x7fffffffu, left >> 31u,
        right & 0x7fffffffu, right >> 31u);
}

uint SigmaN4PublishCollectParallelEdges(uint component, uint footprint,
    uint rank, uint image, out uint4 edges)
{
    uint ordered[4];
    [loop]
    for (uint direction = 0u; direction < 4u; ++direction)
    {
        uint neighbour = SigmaN4PublishNeighbour(footprint, direction);
        uint encoded = SIGMA_N4_INVALID;
        if (neighbour != SIGMA_N4_INVALID)
        {
            uint neighbourRank = SigmaN4PublishParallelRank(neighbour, image);
            uint2 neighbourMeta = _NativeCloseScratch[
                SigmaN4PublishImageAddress(SIGMA_N4_RADIX_META_IMAGE,
                    neighbour)];
            if (neighbourMeta.y == component && neighbourRank > rank)
            {
                uint boundary = SigmaN4PublishBoundaryIndex(footprint,
                    neighbour);
                uint receipt = _NativeBoundaryScratchOffset +
                    boundary * SIGMA_N4_BOUNDARY_RECEIPT_WORDS;
                if (_NativeCloseScratch[receipt].x == SIGMA_STITCH_RESOLVED)
                    encoded = boundary |
                        ((footprint < neighbour ? 1u : 0u) << 31u);
            }
        }
        ordered[direction] = encoded;
    }
    [loop]
    for (uint item = 1u; item < 4u; ++item)
    {
        uint key = ordered[item];
        uint destination = item;
        [loop]
        for (uint shift = 0u; shift < 3u; ++shift)
        {
            if (destination != 0u &&
                SigmaN4PublishCompareParallelEncodedEdge(key,
                    ordered[destination - 1u], image) < 0)
            {
                ordered[destination] = ordered[destination - 1u];
                --destination;
            }
        }
        ordered[destination] = key;
    }
    edges = uint4(ordered[0], ordered[1], ordered[2], ordered[3]);
    return (ordered[0] != SIGMA_N4_INVALID ? 1u : 0u) +
        (ordered[1] != SIGMA_N4_INVALID ? 1u : 0u) +
        (ordered[2] != SIGMA_N4_INVALID ? 1u : 0u) +
        (ordered[3] != SIGMA_N4_INVALID ? 1u : 0u);
}

uint2 SigmaN4PublishD4PairImages(uint pair)
{
    uint2 images = uint2(0u, 1u);
    uint begin = 0u;
    [loop]
    for (uint left = 0u; left < 7u; ++left)
    {
        uint count = 7u - left;
        if (pair >= begin && pair < begin + count)
            images = uint2(left, left + 1u + pair - begin);
        begin += count;
    }
    return images;
}

uint SigmaN4PublishCompareParallelD4PairAt(uint position, uint pair)
{
    // CanonicalSelect has already completed the global rank.  D4 comparison
    // must consume that final stream, never the preceding merge-run image.
    uint2 first = SigmaN4PublishLoadFinalImage(0u, position);
    if (first.x == SIGMA_N4_INVALID) return SIGMA_N4_INVALID;
    uint component = first.y;
    uint2 meta = _NativeCloseScratch[
        SigmaN4PublishComponentAddress(component, 0u)];
    uint localRank = position - meta.y;
    uint2 images = SigmaN4PublishD4PairImages(pair);
    uint leftImage = images.x;
    uint rightImage = images.y;
    uint2 left = SigmaN4PublishLoadFinalImage(leftImage, position);
    uint2 right = SigmaN4PublishLoadFinalImage(rightImage, position);
    int comparison = SigmaN4PublishCompareCell(left.x, leftImage,
        right.x, rightImage);
    if (comparison == 0)
    {
        uint4 leftEdges;
        uint4 rightEdges;
        uint leftCount = SigmaN4PublishCollectParallelEdges(component,
            left.x, position, leftImage, leftEdges);
        uint rightCount = SigmaN4PublishCollectParallelEdges(component,
            right.x, position, rightImage, rightEdges);
        comparison = SigmaN4PublishCompareEdgeStreams(leftEdges,
            leftCount, rightEdges, rightCount);
    }
    if (comparison != 0)
        SigmaN4PublishMinD4PairReceipt(component, pair,
            (localRank << 1u) | (comparison < 0 ? 0u : 1u));
    return component;
}

int SigmaN4PublishCompareComponentCellStreams(uint leftComponent,
    uint rightComponent)
{
    uint2 leftMeta = _NativeCloseScratch[
        SigmaN4PublishComponentAddress(leftComponent, 0u)];
    uint2 rightMeta = _NativeCloseScratch[
        SigmaN4PublishComponentAddress(rightComponent, 0u)];
    uint common = min(leftMeta.x, rightMeta.x);
    uint leftImage = _NativeCloseScratch[
        SigmaN4PublishComponentAddress(leftComponent, 1u)].x;
    uint rightImage = _NativeCloseScratch[
        SigmaN4PublishComponentAddress(rightComponent, 1u)].x;
    if (leftImage >= 8u || rightImage >= 8u)
    {
        uint ignored;
        InterlockedOr(SigmaN4PublishFault,
            SIGMA_N4_FAULT_CANONICAL_WITNESS, ignored);
        return 0;
    }
    int comparison = 0;
    [loop]
    for (uint cellItem = 0u; cellItem < common; ++cellItem)
    {
        if (comparison == 0)
        {
            uint left = SigmaN4PublishLoadFinalImage(leftImage,
                leftMeta.y + cellItem).x;
            uint right = SigmaN4PublishLoadFinalImage(rightImage,
                rightMeta.y + cellItem).x;
            comparison = SigmaN4PublishCompareCell(left, leftImage, right,
                rightImage);
        }
    }
    if (comparison != 0) return comparison;
    if (leftMeta.x != rightMeta.x)
        return leftMeta.x < rightMeta.x ? -1 : 1;

    return 0;
}

int SigmaN4PublishCompareComponentEdgeStreams(uint leftComponent,
    uint rightComponent)
{
    uint2 leftMeta = _NativeCloseScratch[
        SigmaN4PublishComponentAddress(leftComponent, 0u)];
    uint2 rightMeta = _NativeCloseScratch[
        SigmaN4PublishComponentAddress(rightComponent, 0u)];
    uint common = min(leftMeta.x, rightMeta.x);
    uint leftImage = _NativeCloseScratch[
        SigmaN4PublishComponentAddress(leftComponent, 1u)].x;
    uint rightImage = _NativeCloseScratch[
        SigmaN4PublishComponentAddress(rightComponent, 1u)].x;
    if (leftImage >= 8u || rightImage >= 8u)
    {
        uint ignored;
        InterlockedOr(SigmaN4PublishFault,
            SIGMA_N4_FAULT_CANONICAL_WITNESS, ignored);
        return 0;
    }

    int comparison = 0;
    [loop]
    for (uint edgeItem = 0u; edgeItem < common; ++edgeItem)
    {
        if (comparison == 0)
        {
            uint left = SigmaN4PublishLoadFinalImage(leftImage,
                leftMeta.y + edgeItem).x;
            uint right = SigmaN4PublishLoadFinalImage(rightImage,
                rightMeta.y + edgeItem).x;
            uint4 leftEdges;
            uint4 rightEdges;
            uint leftCount = SigmaN4PublishCollectParallelEdges(leftComponent,
                left, leftMeta.y + edgeItem, leftImage, leftEdges);
            uint rightCount = SigmaN4PublishCollectParallelEdges(
                rightComponent, right, rightMeta.y + edgeItem, rightImage,
                rightEdges);
            comparison = SigmaN4PublishCompareEdgeStreams(leftEdges,
                leftCount, rightEdges, rightCount);
        }
    }
    if (comparison == 0 && leftMeta.x != rightMeta.x)
        comparison = leftMeta.x < rightMeta.x ? -1 : 1;
    return comparison;
}

int SigmaN4PublishCompareComponentCellEntries(uint2 left, uint2 right,
    bool executionTie)
{
    bool leftValid = left.x != SIGMA_N4_INVALID;
    bool rightValid = right.x != SIGMA_N4_INVALID;
    if (leftValid != rightValid) return leftValid ? -1 : 1;
    if (!leftValid)
    {
        if (!executionTie || left.y == right.y) return 0;
        return left.y < right.y ? -1 : 1;
    }
    int comparison = SigmaN4PublishCompareComponentCellStreams(left.x,
        right.x);
    if (comparison != 0 || !executionTie || left.x == right.x)
        return comparison;
    // Scratch component identity makes the transient scatter total only after
    // complete canonical component streams compare equal.  Swapping such
    // records cannot change any canonical or publication byte.
    return left.x < right.x ? -1 : 1;
}

uint SigmaN4PublishComponentRunCount()
{
    return max(1u, (_NativeCounters[1u].x +
        SIGMA_N4_COMPONENT_RUN_CAPACITY - 1u) /
        SIGMA_N4_COMPONENT_RUN_CAPACITY);
}

uint2 SigmaN4PublishLoadComponentMergeEntry(bool scanSource,
    uint position)
{
    return _NativeCloseScratch[SigmaN4PublishImageAddress(
        scanSource ? SIGMA_N4_COMPONENT_SCAN_IMAGE :
            SIGMA_N4_COMPONENT_LIST_IMAGE, position)];
}

void SigmaN4PublishStoreComponentMergeEntry(bool scanTarget,
    uint position, uint2 entry)
{
    _NativeCloseScratch[SigmaN4PublishImageAddress(
        scanTarget ? SIGMA_N4_COMPONENT_SCAN_IMAGE :
            SIGMA_N4_COMPONENT_LIST_IMAGE, position)] = entry;
}

uint SigmaN4PublishComponentMergeLowerBound(bool scanSource, uint begin,
    uint end, uint2 key)
{
    uint low = begin;
    uint high = end;
    [loop]
    while (low < high)
    {
        uint middle = low + ((high - low) >> 1u);
        uint2 candidate = SigmaN4PublishLoadComponentMergeEntry(scanSource,
            middle);
        if (SigmaN4PublishCompareComponentCellEntries(candidate, key,
                true) < 0)
            low = middle + 1u;
        else
            high = middle;
    }
    return low - begin;
}

void SigmaN4PublishSortComponentRun(uint run, uint threadIndex)
{
    uint begin = run * SIGMA_N4_COMPONENT_RUN_CAPACITY;
    uint componentCount = _NativeCounters[1u].x;
    [loop]
    for (uint local = threadIndex; local < SIGMA_N4_COMPONENT_RUN_CAPACITY;
         local += 256u)
    {
        uint position = begin + local;
        uint2 entry = uint2(SIGMA_N4_INVALID, position);
        if (position < componentCount)
            entry = _NativeCloseScratch[SigmaN4PublishImageAddress(
                SIGMA_N4_COMPONENT_LIST_IMAGE, position)];
        _NativeCloseScratch[SigmaN4PublishImageAddress(
            SIGMA_N4_COMPONENT_LIST_IMAGE, position)] = entry;
    }
    DeviceMemoryBarrierWithGroupSync();

    // Ten deterministic merge stages replace the old 55-barrier 1024-item
    // bitonic network. Every lane owns concrete entries and binary partitions;
    // no workgroup interprets a component or world-sized stream.
    bool scanSource = false;
    [loop]
    for (uint width = 1u; width < SIGMA_N4_COMPONENT_RUN_CAPACITY;
         width <<= 1u)
    {
        [loop]
        for (uint local = threadIndex; local <
                SIGMA_N4_COMPONENT_RUN_CAPACITY; local += 256u)
        {
            uint pairWidth = width << 1u;
            uint pairBegin = (local / pairWidth) * pairWidth;
            uint middle = min(pairBegin + width,
                SIGMA_N4_COMPONENT_RUN_CAPACITY);
            uint pairEnd = min(pairBegin + pairWidth,
                SIGMA_N4_COMPONENT_RUN_CAPACITY);
            uint source = begin + local;
            uint2 entry = SigmaN4PublishLoadComponentMergeEntry(scanSource,
                source);
            uint destination;
            if (local < middle)
            {
                uint otherRank = SigmaN4PublishComponentMergeLowerBound(
                    scanSource, begin + middle, begin + pairEnd, entry);
                destination = pairBegin + (local - pairBegin) + otherRank;
            }
            else
            {
                uint otherRank = SigmaN4PublishComponentMergeLowerBound(
                    scanSource, begin + pairBegin, begin + middle, entry);
                destination = pairBegin + (local - middle) + otherRank;
            }
            SigmaN4PublishStoreComponentMergeEntry(!scanSource,
                begin + destination, entry);
        }
        DeviceMemoryBarrierWithGroupSync();
        scanSource = !scanSource;
    }
}

uint SigmaN4PublishComponentCellRunBound(uint run, uint2 key, bool upper)
{
    uint begin = run * SIGMA_N4_COMPONENT_RUN_CAPACITY;
    uint low = begin;
    uint high = min(begin + SIGMA_N4_COMPONENT_RUN_CAPACITY,
        _NativeCanonicalImageStride);
    [loop]
    while (low < high)
    {
        uint middle = low + ((high - low) >> 1u);
        uint2 candidate = _NativeCloseScratch[SigmaN4PublishImageAddress(
            SIGMA_N4_COMPONENT_LIST_IMAGE, middle)];
        int comparison = SigmaN4PublishCompareComponentCellEntries(candidate,
            key, false);
        if (comparison < 0 || (upper && comparison == 0))
            low = middle + 1u;
        else
            high = middle;
    }
    return low - begin;
}

void SigmaN4PublishRankComponentAt(uint position)
{
    uint componentCount = _NativeCounters[1u].x;
    if (position >= SigmaN4PublishComponentRunCount() *
            SIGMA_N4_COMPONENT_RUN_CAPACITY)
        return;
    uint run = position / SIGMA_N4_COMPONENT_RUN_CAPACITY;
    uint2 entry = _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_COMPONENT_LIST_IMAGE, position)];
    if (entry.x == SIGMA_N4_INVALID) return;
    uint lessCells = 0u;
    uint edgeRank = 0u;
    uint runCount = SigmaN4PublishComponentRunCount();
    [loop]
    for (uint other = 0u; other < runCount; ++other)
    {
        uint runBegin = other * SIGMA_N4_COMPONENT_RUN_CAPACITY;
        uint low = SigmaN4PublishComponentCellRunBound(other, entry, false);
        uint high = SigmaN4PublishComponentCellRunBound(other, entry, true);
        lessCells += low;
        [loop]
        for (uint equal = low; equal < high; ++equal)
        {
            uint2 candidate = _NativeCloseScratch[
                SigmaN4PublishImageAddress(SIGMA_N4_COMPONENT_LIST_IMAGE,
                    runBegin + equal)];
            if (candidate.x == SIGMA_N4_INVALID) continue;
            int comparison = SigmaN4PublishCompareComponentEdgeStreams(
                candidate.x, entry.x);
            if (comparison < 0 ||
                (comparison == 0 && candidate.x < entry.x))
                ++edgeRank;
        }
    }
    uint rank = lessCells + edgeRank;
    if (rank < componentCount)
        _NativeCloseScratch[SigmaN4PublishImageAddress(
            SIGMA_N4_COMPONENT_SCAN_IMAGE, rank)] = entry;
    else
        InterlockedOr(_NativeCounters[0u].z,
            SIGMA_N4_FAULT_CANONICAL_WITNESS);
}

int SigmaN4PublishCompareSignedDyadic(int left, uint leftLevel,
    int right, uint rightLevel)
{
    if (left == right && leftLevel == rightLevel) return 0;
    bool leftNegative = left < 0;
    bool rightNegative = right < 0;
    if (leftNegative != rightNegative) return leftNegative ? -1 : 1;
    uint leftMagnitude = leftNegative ? (~asuint(left) + 1u) : asuint(left);
    uint rightMagnitude = rightNegative
        ? (~asuint(right) + 1u) : asuint(right);
    if (leftMagnitude == 0u || rightMagnitude == 0u)
    {
        if (leftMagnitude == rightMagnitude) return 0;
        return leftMagnitude == 0u
            ? (rightNegative ? 1 : -1)
            : (leftNegative ? -1 : 1);
    }
    uint leftBits = firstbithigh(leftMagnitude) + 1u;
    uint rightBits = firstbithigh(rightMagnitude) + 1u;
    int leftExponent = (int)leftBits - (int)leftLevel;
    int rightExponent = (int)rightBits - (int)rightLevel;
    int comparison = 0;
    if (leftExponent != rightExponent)
        comparison = leftExponent < rightExponent ? -1 : 1;
    else
    {
        uint leftNormalized = leftMagnitude << (32u - leftBits);
        uint rightNormalized = rightMagnitude << (32u - rightBits);
        if (leftNormalized != rightNormalized)
            comparison = leftNormalized < rightNormalized ? -1 : 1;
    }
    return leftNegative ? -comparison : comparison;
}

bool SigmaN4PublishAnchorKeyLess(int2 candidateCell, uint candidateLevel,
    uint candidateFootprint, int2 currentCell, uint currentLevel,
    uint currentFootprint)
{
    if (candidateFootprint == SIGMA_N4_INVALID) return false;
    if (currentFootprint == SIGMA_N4_INVALID) return true;
    int comparison = SigmaN4PublishCompareSignedDyadic(candidateCell.x,
        candidateLevel, currentCell.x, currentLevel);
    if (comparison == 0)
        comparison = SigmaN4PublishCompareSignedDyadic(candidateCell.y,
            candidateLevel, currentCell.y, currentLevel);
    return comparison < 0 ||
        (comparison == 0 && candidateFootprint < currentFootprint);
}


uint SigmaN4PublishRootOfNode(uint node)
{
    uint root = node;
    [loop]
    for (uint step = 0u; step < 16u; ++step)
    {
        uint next = _NativeCloseScratch[
            _NativeGlobalParentScratchOffset + root].x;
        if (next == root || next == SIGMA_N4_INVALID) return next;
        root = next;
    }
    return SIGMA_N4_INVALID;
}

void SigmaN4PublishInitializeD4Pairs(uint component);
bool SigmaN4PublishCandidateAnchorLess(int2 candidateCell,
    uint candidateLevel, uint candidate, uint current, uint image);

uint SigmaN4PublishTileGlobalFootprint(uint tile, uint local)
{
    uint2 tileCoordinate = uint2(tile % _NativeTileCount.x,
        tile / _NativeTileCount.x);
    uint2 localCoordinate = uint2(local & 15u, local >> 4u);
    uint2 pixel = tileCoordinate * 16u + localCoordinate;
    return pixel.y * _NativeResolution.x + pixel.x;
}

uint SigmaN4PublishAnchorAt(uint4 anchorsLow, uint4 anchorsHigh, uint image)
{
    if (image == 0u) return anchorsLow.x;
    if (image == 1u) return anchorsLow.y;
    if (image == 2u) return anchorsLow.z;
    if (image == 3u) return anchorsLow.w;
    if (image == 4u) return anchorsHigh.x;
    if (image == 5u) return anchorsHigh.y;
    if (image == 6u) return anchorsHigh.z;
    return anchorsHigh.w;
}

void SigmaN4PublishSetAnchor(inout uint4 anchorsLow,
    inout uint4 anchorsHigh, uint image, uint anchor)
{
    if (image == 0u) anchorsLow.x = anchor;
    else if (image == 1u) anchorsLow.y = anchor;
    else if (image == 2u) anchorsLow.z = anchor;
    else if (image == 3u) anchorsLow.w = anchor;
    else if (image == 4u) anchorsHigh.x = anchor;
    else if (image == 5u) anchorsHigh.y = anchor;
    else if (image == 6u) anchorsHigh.z = anchor;
    else anchorsHigh.w = anchor;
}

void SigmaN4PublishStoreSeedComponent(uint component, uint count,
    uint maximumLevel, uint4 anchorsLow, uint4 anchorsHigh)
{
    if (count == 0u || component >= _NativeCanonicalComponentCapacity)
        return;
    _NativeCloseScratch[SigmaN4PublishComponentAddress(component, 0u)] =
        uint2(count, SIGMA_N4_INVALID);
    _NativeCloseScratch[SigmaN4PublishComponentAddress(component, 1u)] =
        uint2(SIGMA_N4_INVALID, maximumLevel);
    _NativeCloseScratch[SigmaN4PublishComponentAddress(component, 2u)] =
        uint2(anchorsLow.x, 0u);
    _NativeCloseScratch[SigmaN4PublishComponentAddress(component, 3u)] =
        uint2(anchorsLow.y, 0u);
    _NativeCloseScratch[SigmaN4PublishComponentAddress(component, 4u)] =
        uint2(anchorsLow.z, 0u);
    _NativeCloseScratch[SigmaN4PublishComponentAddress(component, 5u)] =
        uint2(anchorsLow.w, 0u);
    _NativeCloseScratch[SigmaN4PublishComponentAddress(component, 6u)] =
        uint2(anchorsHigh.x, 0u);
    _NativeCloseScratch[SigmaN4PublishComponentAddress(component, 7u)] =
        uint2(anchorsHigh.y, 0u);
    _NativeCloseScratch[SigmaN4PublishComponentAddress(component, 8u)] =
        uint2(anchorsHigh.z, 0u);
    _NativeCloseScratch[SigmaN4PublishComponentAddress(component, 9u)] =
        uint2(anchorsHigh.w, 0u);
    SigmaN4PublishInitializeD4Pairs(component);
}

void SigmaN4PublishSeedTile(uint tile, uint threadIndex)
{
    uint2 activeReceipt = _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_COMPONENT_LIST_IMAGE, tile)];
    if (threadIndex < activeReceipt.x)
    {
        uint footprint = _NativeCloseScratch[SigmaN4PublishImageAddress(
            SIGMA_N4_COMPONENT_SCAN_IMAGE,
            tile * SIGMA_N4_TILE_FOOTPRINT_CAPACITY + threadIndex)].x;
        uint component;
        uint orbit;
        uint4 chart;
        uint level;
        uint support;
        bool chartValid = SigmaN4PublishChartCore(footprint, false,
            component, orbit, chart, level, support);
        if (chartValid && support != SIGMA_N4_INVALID)
            SigmaN4PublishAppendRefinementMember(footprint);
        bool representative = chartValid &&
            (support == SIGMA_N4_INVALID || _NativeCloseScratch[
                _NativeActiveSupportMarkerScratchOffset + support].y ==
                    footprint);
        if (representative)
        {
            uint activeIndex;
            InterlockedAdd(_NativeCounters[2u].w, 1u, activeIndex);
            if (activeIndex < _NativeFootprintCount)
                _NativeCloseScratch[_NativeCanonicalRankScratchOffset +
                    activeIndex] = uint2(footprint, 0u);
            else
                InterlockedOr(_NativeCounters[0u].z,
                    SIGMA_N4_FAULT_LOGICAL_EXTENT);
        }
    }

    uint borderCount = _NativeCloseScratch[
        SigmaN4PublishTileHeaderAddress(tile, 1u)].x;
    uint componentCount = _NativeCloseScratch[
        SigmaN4PublishTileHeaderAddress(tile, 0u)].y;
    uint slot = threadIndex;
    bool interiorActive = slot >= borderCount && slot < componentCount;
    if (interiorActive)
    {
        uint component = _NativeGlobalBorderComponentCapacity +
            tile * SIGMA_N4_TILE_FOOTPRINT_CAPACITY + slot;
        uint4 anchorsLow = SIGMA_N4_INVALID;
        uint4 anchorsHigh = SIGMA_N4_INVALID;
        uint count = 0u;
        uint maximumLevel = 0u;
        [loop]
        for (uint local = 0u; local < SIGMA_N4_TILE_FOOTPRINT_CAPACITY;
             ++local)
        {
            uint footprint = SigmaN4PublishTileGlobalFootprint(tile, local);
            if (footprint >= _NativeFootprintCount ||
                _NativeCloseScratch[SigmaN4PublishTileFootprintAddress(
                    footprint, 0u)].x != slot)
                continue;
            uint memberComponent;
            uint orbit;
            uint4 chart;
            uint level;
            uint support;
            if (!SigmaN4PublishChart(footprint, memberComponent, orbit, chart,
                    level, support) || memberComponent != component)
                continue;
            ++count;
            maximumLevel = max(maximumLevel, level);
            [loop]
            for (uint image = 0u; image < 8u; ++image)
            {
                uint transformValid = 1u;
                int2 cell = SigmaMerkabaTransformChartCellLower(
                    int2(asint(chart.z), asint(chart.w)), image,
                    transformValid);
                uint current = SigmaN4PublishAnchorAt(anchorsLow,
                    anchorsHigh, image);
                if (transformValid != 0u &&
                    SigmaN4PublishCandidateAnchorLess(cell, level,
                        footprint, current, image))
                {
                    SigmaN4PublishSetAnchor(anchorsLow, anchorsHigh, image,
                        footprint);
                }
            }
        }
        SigmaN4PublishStoreSeedComponent(component, count, maximumLevel,
            anchorsLow, anchorsHigh);
    }
}

void SigmaN4PublishStoreBorderPartial(uint partial, uint count,
    uint maximumLevel, uint4 anchorsLow, uint4 anchorsHigh)
{
    _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_RADIX_U_IMAGE, partial)] = uint2(count, maximumLevel);
    _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_RADIX_V_IMAGE, partial)] = anchorsLow.xy;
    _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_RADIX_MORTON_LO_IMAGE, partial)] =
            anchorsLow.zw;
    _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_RADIX_MORTON_HI_IMAGE, partial)] =
            anchorsHigh.xy;
    _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_RADIX_META_IMAGE, partial)] = anchorsHigh.zw;
}

void SigmaN4PublishLoadBorderPartial(uint partial, out uint count,
    out uint maximumLevel, out uint4 anchorsLow, out uint4 anchorsHigh)
{
    uint2 meta = _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_RADIX_U_IMAGE, partial)];
    uint2 anchors01 = _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_RADIX_V_IMAGE, partial)];
    uint2 anchors23 = _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_RADIX_MORTON_LO_IMAGE, partial)];
    uint2 anchors45 = _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_RADIX_MORTON_HI_IMAGE, partial)];
    uint2 anchors67 = _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_RADIX_META_IMAGE, partial)];
    count = meta.x;
    maximumLevel = meta.y;
    anchorsLow = uint4(anchors01, anchors23);
    anchorsHigh = uint4(anchors45, anchors67);
}

bool SigmaN4PublishAnchorFootprintLess(uint candidate, uint current,
    uint image)
{
    if (candidate == current) return false;
    if (candidate == SIGMA_N4_INVALID) return false;
    if (current == SIGMA_N4_INVALID) return true;
    uint candidateComponent;
    uint candidateOrbit;
    uint4 candidateChart;
    uint candidateLevel;
    uint candidateSupport;
    bool candidateValid = SigmaN4PublishChart(candidate,
        candidateComponent, candidateOrbit, candidateChart, candidateLevel,
        candidateSupport);
    if (!candidateValid) return false;
    uint transformValid = 1u;
    int2 candidateCell = SigmaMerkabaTransformChartCellLower(
        int2(asint(candidateChart.z), asint(candidateChart.w)), image,
        transformValid);
    return transformValid != 0u && SigmaN4PublishCandidateAnchorLess(
        candidateCell, candidateLevel, candidate, current, image);
}

bool SigmaN4PublishCandidateAnchorLess(int2 candidateCell,
    uint candidateLevel, uint candidate, uint current, uint image)
{
    if (candidate == current) return false;
    if (candidate == SIGMA_N4_INVALID) return false;
    if (current == SIGMA_N4_INVALID) return true;
    uint currentComponent;
    uint currentOrbit;
    uint4 currentChart;
    uint currentLevel;
    uint currentSupport;
    if (!SigmaN4PublishChart(current, currentComponent, currentOrbit,
            currentChart, currentLevel, currentSupport))
        return candidate < current;
    uint transformValid = 1u;
    int2 currentCell = SigmaMerkabaTransformChartCellLower(
        int2(asint(currentChart.z), asint(currentChart.w)), image,
        transformValid);
    return transformValid != 0u && SigmaN4PublishAnchorKeyLess(candidateCell,
        candidateLevel, candidate, currentCell, currentLevel, current);
}

void SigmaN4PublishMergeBorderPartial(uint partial, inout uint count,
    inout uint maximumLevel, inout uint4 anchorsLow,
    inout uint4 anchorsHigh)
{
    uint candidateCount;
    uint candidateMaximumLevel;
    uint4 candidateAnchorsLow;
    uint4 candidateAnchorsHigh;
    SigmaN4PublishLoadBorderPartial(partial, candidateCount,
        candidateMaximumLevel, candidateAnchorsLow, candidateAnchorsHigh);
    count += candidateCount;
    maximumLevel = max(maximumLevel, candidateMaximumLevel);
    [loop]
    for (uint image = 0u; image < 8u; ++image)
    {
        uint candidate = SigmaN4PublishAnchorAt(candidateAnchorsLow,
            candidateAnchorsHigh, image);
        uint current = SigmaN4PublishAnchorAt(anchorsLow, anchorsHigh,
            image);
        if (SigmaN4PublishAnchorFootprintLess(candidate, current, image))
            SigmaN4PublishSetAnchor(anchorsLow, anchorsHigh, image,
                candidate);
    }
}

void SigmaN4PublishSeedBorderBlock(uint block, uint threadIndex,
    bool blockActive)
{
    uint activeNodeCount = _NativeCounters[1u].z;
    uint workIndex = block * 256u + threadIndex;
    bool active = blockActive && workIndex < activeNodeCount;
    uint2 work = active ? _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_RADIX_TEMP_IMAGE, workIndex)] :
        uint2(SIGMA_N4_INVALID, SIGMA_N4_INVALID);
    uint root = work.x;
    uint node = work.y;
    active = active && root < _NativeGlobalBorderComponentCapacity &&
        node < _NativeGlobalBorderComponentCapacity;

    uint count = 0u;
    uint maximumLevel = 0u;
    uint4 anchorsLow = SIGMA_N4_INVALID;
    uint4 anchorsHigh = SIGMA_N4_INVALID;
    if (active)
    {
        uint tile = node / SIGMA_N4_TILE_BORDER_COMPONENT_CAPACITY;
        uint slot = node - tile * SIGMA_N4_TILE_BORDER_COMPONENT_CAPACITY;
        [loop]
        for (uint local = 0u; local < SIGMA_N4_TILE_FOOTPRINT_CAPACITY;
             ++local)
        {
            uint footprint = SigmaN4PublishTileGlobalFootprint(tile, local);
            if (footprint >= _NativeFootprintCount ||
                _NativeCloseScratch[SigmaN4PublishTileFootprintAddress(
                    footprint, 0u)].x != slot)
                continue;
            uint component;
            uint orbit;
            uint4 chart;
            uint level;
            uint support;
            if (!SigmaN4PublishChart(footprint, component, orbit, chart,
                    level, support) || component != root)
                continue;
            ++count;
            maximumLevel = max(maximumLevel, level);
            [loop]
            for (uint image = 0u; image < 8u; ++image)
            {
                uint transformValid = 1u;
                int2 cell = SigmaMerkabaTransformChartCellLower(
                    int2(asint(chart.z), asint(chart.w)), image,
                    transformValid);
                uint current = SigmaN4PublishAnchorAt(anchorsLow,
                    anchorsHigh, image);
                if (transformValid != 0u &&
                    SigmaN4PublishCandidateAnchorLess(cell, level,
                        footprint, current, image))
                {
                    SigmaN4PublishSetAnchor(anchorsLow, anchorsHigh, image,
                        footprint);
                }
            }
        }
        SigmaN4PublishStoreBorderPartial(workIndex, count, maximumLevel,
            anchorsLow, anchorsHigh);
    }
    DeviceMemoryBarrierWithGroupSync();

    // Stable rank only the at-most-256 compact node receipts in this block.
    // The node id is an execution tie after the exact root key and is never
    // serialized.  This avoids another bitonic/barrier mill.
    uint rank = 0u;
    if (active)
    {
        [loop]
        for (uint otherLane = 0u; otherLane < 256u; ++otherLane)
        {
            uint otherIndex = block * 256u + otherLane;
            if (otherIndex >= activeNodeCount) continue;
            uint2 other = _NativeCloseScratch[SigmaN4PublishImageAddress(
                SIGMA_N4_RADIX_TEMP_IMAGE, otherIndex)];
            if (other.x < root || (other.x == root && other.y < node))
                ++rank;
        }
        SigmaN4PublishRadixCounts[rank] = workIndex;
    }
    GroupMemoryBarrierWithGroupSync();

    uint blockCount = min(256u,
        activeNodeCount > block * 256u ? activeNodeCount - block * 256u : 0u);
    if (threadIndex >= blockCount) return;
    uint sortedPartial = SigmaN4PublishRadixCounts[threadIndex];
    uint2 sortedWork = _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_RADIX_TEMP_IMAGE, sortedPartial)];
    uint sortedRoot = sortedWork.x;
    bool segmentStart = threadIndex == 0u;
    if (!segmentStart)
    {
        uint previousPartial = SigmaN4PublishRadixCounts[threadIndex - 1u];
        uint previousRoot = _NativeCloseScratch[SigmaN4PublishImageAddress(
            SIGMA_N4_RADIX_TEMP_IMAGE, previousPartial)].x;
        segmentStart = previousRoot != sortedRoot;
    }
    if (!segmentStart) return;

    uint segmentEnd = threadIndex + 1u;
    [loop]
    while (segmentEnd < blockCount)
    {
        uint candidatePartial = SigmaN4PublishRadixCounts[segmentEnd];
        uint candidateRoot = _NativeCloseScratch[
            SigmaN4PublishImageAddress(SIGMA_N4_RADIX_TEMP_IMAGE,
                candidatePartial)].x;
        if (candidateRoot != sortedRoot) break;
        ++segmentEnd;
    }

    uint aggregateCount = 0u;
    uint aggregateMaximumLevel = 0u;
    uint4 aggregateAnchorsLow = SIGMA_N4_INVALID;
    uint4 aggregateAnchorsHigh = SIGMA_N4_INVALID;
    [loop]
    for (uint position = threadIndex; position < segmentEnd; ++position)
        SigmaN4PublishMergeBorderPartial(
            SigmaN4PublishRadixCounts[position], aggregateCount,
            aggregateMaximumLevel, aggregateAnchorsLow,
            aggregateAnchorsHigh);
    SigmaN4PublishStoreBorderPartial(sortedPartial, aggregateCount,
        aggregateMaximumLevel, aggregateAnchorsLow, aggregateAnchorsHigh);
    DeviceMemoryBarrier();

    uint partialHeadAddress = SigmaN4PublishComponentAddress(sortedRoot, 9u);
    uint previousPartial;
    InterlockedExchange(_NativeCloseScratch[partialHeadAddress].x,
        sortedPartial, previousPartial);
    _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_FRESH_PREFIX_IMAGE, sortedPartial)] =
            uint2(previousPartial, 0u);
    DeviceMemoryBarrier();

    uint previousMembers;
    uint segmentMembers = segmentEnd - threadIndex;
    InterlockedAdd(_NativeCloseScratch[partialHeadAddress].y,
        segmentMembers, previousMembers);
    uint expectedMembers = _NativeCloseScratch[
        _NativeGlobalParentScratchOffset + sortedRoot].y >> 3u;
    if (previousMembers + segmentMembers != expectedMembers) return;

    // At most one partial exists per compact 256-node block.  The final
    // segment leader therefore merges no more than ceil(24000/256)=94 exact
    // summaries, never footprints or frame capacity.
    DeviceMemoryBarrier();
    aggregateCount = 0u;
    aggregateMaximumLevel = 0u;
    aggregateAnchorsLow = SIGMA_N4_INVALID;
    aggregateAnchorsHigh = SIGMA_N4_INVALID;
    uint partial = _NativeCloseScratch[partialHeadAddress].x;
    uint maximumPartials =
        (_NativeGlobalBorderComponentCapacity + 255u) / 256u;
    [loop]
    for (uint item = 0u; item < maximumPartials; ++item)
    {
        if (partial == SIGMA_N4_INVALID) break;
        SigmaN4PublishMergeBorderPartial(partial, aggregateCount,
            aggregateMaximumLevel, aggregateAnchorsLow,
            aggregateAnchorsHigh);
        partial = _NativeCloseScratch[SigmaN4PublishImageAddress(
            SIGMA_N4_FRESH_PREFIX_IMAGE, partial)].x;
    }
    if (partial != SIGMA_N4_INVALID ||
        (expectedMembers != 0u && aggregateCount == 0u))
    {
        InterlockedOr(_NativeCounters[0u].z,
            SIGMA_N4_FAULT_COMPONENT_ANCHOR);
        return;
    }
    SigmaN4PublishStoreSeedComponent(sortedRoot, aggregateCount,
        aggregateMaximumLevel, aggregateAnchorsLow, aggregateAnchorsHigh);
}

















uint SigmaN4PublishNextPowerOfTwo(uint value)
{
    if (value <= 1u) return 1u;
    return 1u << (firstbithigh(value - 1u) + 1u);
}








uint SigmaN4PublishComponentBlockCount(uint componentCount)
{
    return (componentCount + 255u) / 256u;
}

uint SigmaN4PublishFinalizeComponentPrefixes(uint threadIndex,
    uint componentCount)
{
    uint blockCount = SigmaN4PublishComponentBlockCount(componentCount);
    [loop]
    for (uint block = threadIndex; block < blockCount; block += 256u)
    {
        uint begin = block * 256u;
        uint end = min(begin + 256u, componentCount);
        uint fresh = 0u;
        uint2 pack = 0u;
        uint valid = 1u;
        [loop]
        for (uint index = begin; index < end; ++index)
        {
            uint component = _NativeCloseScratch[
                SigmaN4PublishImageAddress(
                    SIGMA_N4_COMPONENT_SCAN_IMAGE, index)].x;
            _NativeCloseScratch[SigmaN4PublishComponentAddress(component,
                7u)] = pack;
            _NativeCloseScratch[SigmaN4PublishComponentAddress(component,
                8u)] = uint2(fresh, 0u);
            fresh += _NativeCloseScratch[
                SigmaN4PublishComponentAddress(component, 3u)].x;
            pack = SigmaQ48AddChecked(pack, _NativeCloseScratch[
                SigmaN4PublishComponentAddress(component, 2u)], valid);
        }
        _NativeCloseScratch[SigmaN4PublishImageAddress(
            SIGMA_N4_COMPONENT_LIST_IMAGE, block)] = uint2(fresh, pack.x);
        _NativeCloseScratch[SigmaN4PublishImageAddress(
            SIGMA_N4_RADIX_TEMP_IMAGE, block)] = uint2(pack.y, valid);
    }
    DeviceMemoryBarrierWithGroupSync();
    if (threadIndex == 0u)
    {
        uint runningFresh = 0u;
        uint2 runningPack = 0u;
        uint valid = 1u;
        [loop]
        for (uint block = 0u; block < blockCount; ++block)
        {
            uint listAddress = SigmaN4PublishImageAddress(
                SIGMA_N4_COMPONENT_LIST_IMAGE, block);
            uint tempAddress = SigmaN4PublishImageAddress(
                SIGMA_N4_RADIX_TEMP_IMAGE, block);
            uint2 blockFreshPack = _NativeCloseScratch[listAddress];
            uint2 blockPackHighValid = _NativeCloseScratch[tempAddress];
            _NativeCloseScratch[listAddress] =
                uint2(runningFresh, runningPack.x);
            _NativeCloseScratch[tempAddress] =
                uint2(runningPack.y, valid & blockPackHighValid.y);
            runningFresh += blockFreshPack.x;
            runningPack = SigmaQ48AddChecked(runningPack,
                uint2(blockFreshPack.y, blockPackHighValid.x), valid);
            valid &= blockPackHighValid.y;
        }
        _NativeCloseScratch[SigmaN4PublishImageAddress(
            SIGMA_N4_COMPONENT_LIST_IMAGE, blockCount)] =
                uint2(runningFresh, runningPack.x);
        _NativeCloseScratch[SigmaN4PublishImageAddress(
            SIGMA_N4_RADIX_TEMP_IMAGE, blockCount)] =
                uint2(runningPack.y, valid);
    }
    DeviceMemoryBarrierWithGroupSync();
    [loop]
    for (uint block = threadIndex; block < blockCount; block += 256u)
    {
        uint2 blockFreshPack = _NativeCloseScratch[
            SigmaN4PublishImageAddress(SIGMA_N4_COMPONENT_LIST_IMAGE,
                block)];
        uint2 blockPackHighValid = _NativeCloseScratch[
            SigmaN4PublishImageAddress(SIGMA_N4_RADIX_TEMP_IMAGE, block)];
        uint2 blockPack = uint2(blockFreshPack.y,
            blockPackHighValid.x);
        uint begin = block * 256u;
        uint end = min(begin + 256u, componentCount);
        [loop]
        for (uint index = begin; index < end; ++index)
        {
            uint component = _NativeCloseScratch[
                SigmaN4PublishImageAddress(
                    SIGMA_N4_COMPONENT_SCAN_IMAGE, index)].x;
            uint valid = blockPackHighValid.y;
            _NativeCloseScratch[SigmaN4PublishComponentAddress(component,
                7u)] = SigmaQ48AddChecked(blockPack, _NativeCloseScratch[
                    SigmaN4PublishComponentAddress(component, 7u)], valid);
            _NativeCloseScratch[SigmaN4PublishComponentAddress(component,
                8u)].x += blockFreshPack.x;
            if (valid == 0u)
                InterlockedOr(SigmaN4PublishFault,
                    SIGMA_N4_FAULT_COMPONENT_PACK);
        }
    }
    DeviceMemoryBarrierWithGroupSync();
    uint2 total = _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_COMPONENT_LIST_IMAGE, blockCount)];
    return total.x;
}

uint SigmaN4PublishVisibleSlot(uint logicalPage)
{
    uint first = logicalPage * 2u;
    if (first >= _NativeTargetPageCapacity) return SIGMA_N4_INVALID;
    uint second = first + 1u;
    uint root = _NativeSourcePublicationRoot[0u];
    SigmaCarrierPageMetaGpu a = _NativeSourcePageMetadata[first];
    SigmaCarrierPageMetaGpu b = (SigmaCarrierPageMetaGpu)0;
    if (second < _NativeTargetPageCapacity)
        b = _NativeSourcePageMetadata[second];
    bool aVisible = SigmaCarrierVisibleAtRoot(a, b,
        second < _NativeTargetPageCapacity, root);
    bool bVisible = second < _NativeTargetPageCapacity &&
        SigmaCarrierVisibleAtRoot(b, a, true, root);
    return aVisible ? first : (bVisible ? second : SIGMA_N4_INVALID);
}

SigmaNativeStateDeltaGpu SigmaN4PublishBuildDelta(uint footprint,
    uint4 coordinate, uint4 generation, uint flags, uint certificateOffset,
    bool exactZEmpty)
{
    SigmaNativeStateDeltaGpu delta;
    delta.Coordinate = coordinate;
    delta.Generation = generation;
    delta.Changed = uint4(flags, _NativeRevision, 0u, 1u);
    delta.Witness = uint4(SIGMA_MERKABA_PROGRAM_FINGERPRINT[0u],
        SIGMA_MERKABA_PROGRAM_FINGERPRINT[1u],
        SIGMA_STITCH_GENERATED_BRACKET_FINGERPRINT.x,
        SIGMA_STITCH_GENERATED_BRACKET_FINGERPRINT.y);
    delta.Receipts = uint4(certificateOffset, footprint,
        _NativeProvenanceReceipt[0], _NativeProvenanceReceipt[1]);
    uint source = _NativeFootprintStateOffset + footprint * 16u;
    uint4 zero = uint4(0u, 0u, 0u, 0u);
    delta.State01 = exactZEmpty ? zero : uint4(_NativePrepareStates[source],
        _NativePrepareStates[source + 1u]);
    delta.State23 = exactZEmpty ? zero : uint4(_NativePrepareStates[source + 2u],
        _NativePrepareStates[source + 3u]);
    delta.State45 = exactZEmpty ? zero : uint4(_NativePrepareStates[source + 4u],
        _NativePrepareStates[source + 5u]);
    delta.State67 = exactZEmpty ? zero : uint4(_NativePrepareStates[source + 6u],
        _NativePrepareStates[source + 7u]);
    delta.State89 = exactZEmpty ? zero : uint4(_NativePrepareStates[source + 8u],
        _NativePrepareStates[source + 9u]);
    delta.State1011 = exactZEmpty ? zero : uint4(
        _NativePrepareStates[source + 10u],
        _NativePrepareStates[source + 11u]);
    delta.State1213 = exactZEmpty ? zero : uint4(
        _NativePrepareStates[source + 12u],
        _NativePrepareStates[source + 13u]);
    delta.State1415 = exactZEmpty ? zero : uint4(
        _NativePrepareStates[source + 14u],
        _NativePrepareStates[source + 15u]);
    return delta;
}

SigmaNativeStateDeltaGpu SigmaN4PublishBuildRefinementDelta(
    uint stateFootprint, bool occupied, uint sourceSlot, uint sourceSample,
    uint4 coordinate, uint4 generation, uint certificateSource)
{
    uint flags = SIGMA_NATIVE_DELTA_RESOLVED |
        SIGMA_NATIVE_DELTA_COMMON |
        SIGMA_NATIVE_DELTA_EVIDENCE_RETAINED |
        SIGMA_NATIVE_DELTA_STATE_CHANGED |
        SIGMA_NATIVE_DELTA_GAUGE_CHANGED;
    SigmaNativeStateDeltaGpu delta = SigmaN4PublishBuildDelta(stateFootprint,
        coordinate, generation, flags, certificateSource, false);
    if (!occupied)
    {
        uint source = sourceSlot * SIGMA_PAGE_LANE_COUNT +
            sourceSample * SIGMA_FRAME_LANE_COUNT;
        delta.State01 = uint4(_NativeSourceCarrierState[source],
            _NativeSourceCarrierState[source + 1u]);
        delta.State23 = uint4(_NativeSourceCarrierState[source + 2u],
            _NativeSourceCarrierState[source + 3u]);
        delta.State45 = uint4(_NativeSourceCarrierState[source + 4u],
            _NativeSourceCarrierState[source + 5u]);
        delta.State67 = uint4(_NativeSourceCarrierState[source + 6u],
            _NativeSourceCarrierState[source + 7u]);
        delta.State89 = uint4(_NativeSourceCarrierState[source + 8u],
            _NativeSourceCarrierState[source + 9u]);
        delta.State1011 = uint4(_NativeSourceCarrierState[source + 10u],
            _NativeSourceCarrierState[source + 11u]);
        delta.State1213 = uint4(_NativeSourceCarrierState[source + 12u],
            _NativeSourceCarrierState[source + 13u]);
        delta.State1415 = uint4(_NativeSourceCarrierState[source + 14u],
            _NativeSourceCarrierState[source + 15u]);
    }
    delta.Receipts.x = certificateSource;
    return delta;
}

bool SigmaN4PublishCurrentEqual(uint footprint, uint sourceSlot, uint sample,
    uint4 coordinate, uint level, bool exactZEmpty, out bool stateEqual,
    out bool gaugeEqual, out bool certificateEqual)
{
    stateEqual = true;
    gaugeEqual = true;
    certificateEqual = true;
    if (!SigmaN4PublishSourceSampleInRange(sourceSlot, sample))
    {
        stateEqual = false;
        gaugeEqual = false;
        certificateEqual = false;
        return false;
    }
    [loop]
    for (uint lane = 0u; lane < 16u; ++lane)
    {
        uint2 desired = exactZEmpty ? 0u : _NativePrepareStates[
            _NativeFootprintStateOffset + footprint * 16u + lane];
        stateEqual = stateEqual && all(_NativeSourceCarrierState[
            sourceSlot * SIGMA_PAGE_LANE_COUNT + sample * 16u + lane] ==
            desired);
    }
    uint address = SigmaCarrierRepresentationAddress(sourceSlot, sample, 0u);
    uint4 currentCoordinate = _NativeSourceCarrierRepresentation[address];
    uint4 currentPlan = _NativeSourceCarrierRepresentation[address + 1u];
    gaugeEqual = all(currentCoordinate == coordinate) &&
        currentPlan.x == level &&
        (currentPlan.y & SIGMA_NATIVE_GAUGE_CELL_FLAGS_ACTIVE) != 0u;
    [loop]
    for (uint word = 0u; word < 16u; ++word)
        certificateEqual = certificateEqual && all(
            _NativeSourceCarrierRepresentation[address +
                SIGMA_REPRESENTATION_CERTIFICATE + word] ==
            _NativeLocalityCertificateWords[
                _NativeFootprintCertificateOffset +
                footprint * 16u + word]);
    return stateEqual && gaugeEqual && certificateEqual;
}

uint SigmaN4PublishResidentPagePlanCapacity();
uint SigmaN4PublishScratchLogicalCapacity();
uint SigmaN4PublishLogicalCapacity();

bool SigmaN4PublishAppendRefinementChild(uint activeIndex, uint child,
    uint logical, uint component)
{
    uint active = SigmaN4PublishActiveSupportAddress(activeIndex, 0u);
    uint2 supportRecord = _NativeCloseScratch[active];
    uint support = supportRecord.x;
    uint sourceSlot = support / SIGMA_PAGE_SAMPLE_COUNT;
    uint sourceSample = support - sourceSlot * SIGMA_PAGE_SAMPLE_COUNT;
    if (!SigmaN4PublishSourceSampleInRange(sourceSlot, sourceSample))
        return false;
    uint parentRepresentation = SigmaCarrierRepresentationAddress(sourceSlot,
        sourceSample, 0u);
    uint4 parentCoordinate = _NativeSourceCarrierRepresentation[
        parentRepresentation + SIGMA_REPRESENTATION_GAUGE_COORDINATE];
    uint4 parentPlan = _NativeSourceCarrierRepresentation[
        parentRepresentation + SIGMA_REPRESENTATION_GAUGE_PLAN];
    uint4 childCoordinate;
    uint childLevel;
    if (!SigmaMerkabaSplitDyadicGauge(parentCoordinate, parentPlan.x, child,
            childCoordinate, childLevel))
        return false;

    uint stateFootprint = SigmaN4PublishRefinementRepresentative(
        activeIndex, child);
    bool occupied = stateFootprint != SIGMA_N4_INVALID;
    if (!occupied) stateFootprint = supportRecord.y;

    uint page = logical / SIGMA_PAGE_SAMPLE_COUNT;
    uint sample = logical - page * SIGMA_PAGE_SAMPLE_COUNT;
    if (page >= SigmaN4PublishResidentPagePlanCapacity()) return false;
    uint plan = SigmaN4PublishPlanAddress(page, 0u);
    uint2 planSource = _NativeCloseScratch[plan];
    uint2 planTarget = _NativeCloseScratch[plan + 1u];
    uint certificateSource = occupied
        ? SIGMA_N4_CERTIFICATE_SOURCE_MEET |
            (_NativeFootprintCertificateOffset +
                stateFootprint * SIGMA_CERTIFICATE_WORD_COUNT)
        : SIGMA_N4_CERTIFICATE_SOURCE_CARRIER |
            (parentRepresentation + SIGMA_REPRESENTATION_CERTIFICATE);
    uint mutation;
    InterlockedAdd(_NativeCounters[0u].y, 1u, mutation);
    if (mutation >= _NativeMutationCapacity) return false;

    SigmaNativeStateDeltaGpu delta = SigmaN4PublishBuildRefinementDelta(
        stateFootprint, occupied, sourceSlot, sourceSample, childCoordinate,
        uint4(planTarget.x, sample, planTarget.y, planSource.y),
        certificateSource);
    if (occupied)
        delta.Witness.w = parentRepresentation +
            SIGMA_REPRESENTATION_CERTIFICATE;
    _NativeStateDeltas[mutation] = delta;
    SigmaNativeGaugeDeltaGpu gauge;
    gauge.Coordinate = childCoordinate;
    gauge.Prior = child == 0u ? parentPlan : 0u;
    gauge.Next = uint4(childLevel,
        SIGMA_NATIVE_GAUGE_CELL_FLAGS_ACTIVE |
        SIGMA_NATIVE_GAUGE_CELL_FLAGS_NORMALIZED |
        SIGMA_NATIVE_GAUGE_CELL_FLAGS_REFINED,
        SIGMA_CHI_FINGERPRINT[0u], SIGMA_KAPPA_FINGERPRINT[0u]);
    gauge.Witness = uint4(child, component,
        _NativeProvenanceReceipt[0], _NativeProvenanceReceipt[1]);
    _NativeGaugeDeltas[mutation] = gauge;

    uint ignored;
    InterlockedAdd(_NativeCounters[0u].x, 1u, ignored);
    InterlockedAdd(_NativeCounters[3u].y, 1u, ignored);
    InterlockedAdd(_NativeCounters[3u].x, 1u, ignored);
    InterlockedMax(_NativeCounters[3u].z,
        SIGMA_NATIVE_COLD_REASON_REPRESENTATION_REFINEMENT, ignored);
    InterlockedMax(_NativeCloseScratch[plan + 2u].x, sample + 1u, ignored);
    InterlockedOr(_NativeCloseScratch[plan + 2u].y,
        SIGMA_N4_PAGE_PLAN_TOUCHED |
        SIGMA_N4_PAGE_PLAN_STATE_CHANGED |
        SIGMA_N4_PAGE_PLAN_GAUGE_CHANGED |
        SIGMA_N4_PAGE_PLAN_CERTIFICATE_CHANGED, ignored);
    InterlockedMin(_NativeCloseScratch[plan + 3u].x, mutation, ignored);
    InterlockedMax(_NativeCloseScratch[plan + 3u].y, mutation + 1u, ignored);
    return true;
}

bool SigmaN4PublishActiveSupport(uint support, out uint activeIndex,
    out uint refinement)
{
    activeIndex = SIGMA_N4_INVALID;
    refinement = SIGMA_N4_REFINEMENT_NONE;
    if (support == SIGMA_N4_INVALID) return false;
    uint marker = _NativeActiveSupportMarkerScratchOffset + support;
    activeIndex = _NativeCloseScratch[marker].x;
    if (activeIndex >= _NativeCounters[3u].w) return false;
    uint active = SigmaN4PublishActiveSupportAddress(activeIndex, 0u);
    if (_NativeCloseScratch[active].x != support) return false;
    refinement = _NativeCloseScratch[active + 1u].y &
        SIGMA_N4_REFINEMENT_STATUS_MASK;
    return true;
}

bool SigmaN4PublishAppendRelocation(uint sourceSlot, uint sourceSample,
    uint logical)
{
    uint page = logical / SIGMA_PAGE_SAMPLE_COUNT;
    uint sample = logical - page * SIGMA_PAGE_SAMPLE_COUNT;
    if (page >= SigmaN4PublishResidentPagePlanCapacity() ||
        !SigmaN4PublishSourceSampleInRange(sourceSlot, sourceSample))
        return false;
    uint plan = SigmaN4PublishPlanAddress(page, 0u);
    uint2 planSource = _NativeCloseScratch[plan];
    uint2 planTarget = _NativeCloseScratch[plan + 1u];
    uint sourceRepresentation = SigmaCarrierRepresentationAddress(sourceSlot,
        sourceSample, 0u);
    uint4 coordinate = _NativeSourceCarrierRepresentation[
        sourceRepresentation + SIGMA_REPRESENTATION_GAUGE_COORDINATE];
    uint4 sourcePlan = _NativeSourceCarrierRepresentation[
        sourceRepresentation + SIGMA_REPRESENTATION_GAUGE_PLAN];
    uint certificate = SIGMA_N4_CERTIFICATE_SOURCE_CARRIER |
        (sourceRepresentation + SIGMA_REPRESENTATION_CERTIFICATE);
    uint mutation;
    InterlockedAdd(_NativeCounters[0u].y, 1u, mutation);
    if (mutation >= _NativeMutationCapacity) return false;
    _NativeStateDeltas[mutation] = SigmaN4PublishBuildRefinementDelta(0u,
        false, sourceSlot, sourceSample, coordinate,
        uint4(planTarget.x, sample, planTarget.y, planSource.y), certificate);
    SigmaNativeGaugeDeltaGpu gauge;
    gauge.Coordinate = coordinate;
    gauge.Prior = sourcePlan;
    gauge.Next = sourcePlan;
    gauge.Witness = uint4(0u, 0u,
        _NativeProvenanceReceipt[0], _NativeProvenanceReceipt[1]);
    _NativeGaugeDeltas[mutation] = gauge;
    uint ignored;
    InterlockedMax(_NativeCloseScratch[plan + 2u].x, sample + 1u, ignored);
    InterlockedOr(_NativeCloseScratch[plan + 2u].y,
        SIGMA_N4_PAGE_PLAN_TOUCHED |
        SIGMA_N4_PAGE_PLAN_STATE_CHANGED |
        SIGMA_N4_PAGE_PLAN_GAUGE_CHANGED |
        SIGMA_N4_PAGE_PLAN_CERTIFICATE_CHANGED, ignored);
    InterlockedMin(_NativeCloseScratch[plan + 3u].x, mutation, ignored);
    InterlockedMax(_NativeCloseScratch[plan + 3u].y, mutation + 1u, ignored);
    return true;
}

uint SigmaN4PublishResidentPagePlanCapacity()
{
    // PagePlanCapacity is bounded scratch.  Resident current/shadow pairs are
    // the only legal N4 publication targets; N5 will replace this capacity
    // fault with asynchronous cold residency work.
    return min(_NativePagePlanCapacity, _NativeTargetPageCapacity / 2u);
}


uint SigmaN4PublishLogicalCapacity()
{
    return SigmaN4PublishResidentPagePlanCapacity() *
        SIGMA_PAGE_SAMPLE_COUNT;
}

// Dispatch 12 is the sole producer of this immutable refinement schedule.
// Dispatch 13 may only write terminal StateDelta/GaugeDelta records; it reads
// refinement execution receipts from these disjoint CloseScratch regions.
uint SigmaN4PublishRefinementArenaLogicalCapacity()
{
    return _NativePagePlanCapacity * SIGMA_PAGE_SAMPLE_COUNT;
}

uint SigmaN4PublishRefinedBitsetWordCount()
{
    return (SigmaN4PublishRefinementArenaLogicalCapacity() + 63u) / 64u;
}

uint SigmaN4PublishRefinedBitsetAddress(uint word)
{
    return _NativeCanonicalRankScratchOffset + _NativeCanonicalImageStride +
        word;
}

uint SigmaN4PublishRefinedBlockPrefixAddress(uint block)
{
    return SigmaN4PublishRefinedBitsetAddress(
        SigmaN4PublishRefinedBitsetWordCount()) + block;
}

uint SigmaN4PublishRefinementChildOrderAddress(uint index)
{
    uint blockCapacity =
        (SigmaN4PublishRefinementArenaLogicalCapacity() + 255u) / 256u;
    return SigmaN4PublishRefinedBlockPrefixAddress(blockCapacity) + index;
}



uint SigmaN4PublishChildOrderLoad(uint index)
{
    return _NativeCloseScratch[
        SigmaN4PublishRefinementChildOrderAddress(index)].x;
}

void SigmaN4PublishChildOrderStore(uint index, uint candidate)
{
    _NativeCloseScratch[
        SigmaN4PublishRefinementChildOrderAddress(index)] =
            uint2(candidate, 0u);
}

uint SigmaN4PublishFreshBitsetWordCount()
{
    // D4 image seven is dead after parallel image selection. Tile-footprint
    // A-D receipts are still required by PrepareNativeRevision to reconstruct
    // the selected chart and therefore must remain immutable through CUT E.
    return (_NativeFootprintCount + 63u) / 64u;
}

uint SigmaN4PublishFreshBitsetAddress(uint word)
{
    return SigmaN4PublishImageAddress(SIGMA_N4_FRESH_PREFIX_IMAGE, word);
}

uint SigmaN4PublishFreshBlockAddress(uint block)
{
    return SigmaN4PublishImageAddress(SIGMA_N4_FRESH_PREFIX_IMAGE,
        SigmaN4PublishFreshBitsetWordCount() + block);
}

bool SigmaN4PublishSourceLogical(uint logical, out uint sourceSlot,
    out uint sourceSample, out uint4 coordinate, out uint level)
{
    uint page = logical / SIGMA_PAGE_SAMPLE_COUNT;
    sourceSample = logical - page * SIGMA_PAGE_SAMPLE_COUNT;
    sourceSlot = SIGMA_N4_INVALID;
    coordinate = 0u;
    level = 0u;
    if (page >= SigmaN4PublishResidentPagePlanCapacity()) return false;
    sourceSlot = _NativeCloseScratch[SigmaN4PublishPlanAddress(page, 0u)].y;
    if (!SigmaN4PublishSourceSampleInRange(sourceSlot, sourceSample))
        return false;
    uint representation = SigmaCarrierRepresentationAddress(sourceSlot,
        sourceSample, 0u);
    coordinate = _NativeSourceCarrierRepresentation[representation];
    uint4 plan = _NativeSourceCarrierRepresentation[representation + 1u];
    level = plan.x;
    return (plan.y & SIGMA_NATIVE_GAUGE_CELL_FLAGS_ACTIVE) != 0u;
}

bool SigmaN4PublishRefinementChildKey(uint activeIndex, uint child,
    out uint4 coordinate, out uint level)
{
    coordinate = 0u;
    level = 0u;
    if (activeIndex >= _NativeCounters[3u].w || child >= 4u) return false;
    uint support = _NativeCloseScratch[
        SigmaN4PublishActiveSupportAddress(activeIndex, 0u)].x;
    uint sourceSlot = support / SIGMA_PAGE_SAMPLE_COUNT;
    uint sourceSample = support - sourceSlot * SIGMA_PAGE_SAMPLE_COUNT;
    if (!SigmaN4PublishSourceSampleInRange(sourceSlot, sourceSample))
        return false;
    uint representation = SigmaCarrierRepresentationAddress(sourceSlot,
        sourceSample, 0u);
    uint4 parentCoordinate = _NativeSourceCarrierRepresentation[
        representation];
    uint4 parentPlan = _NativeSourceCarrierRepresentation[
        representation + 1u];
    return SigmaMerkabaSplitDyadicGauge(parentCoordinate, parentPlan.x,
        child, coordinate, level);
}

bool SigmaN4PublishGaugeEqual(uint4 leftCoordinate, uint leftLevel,
    uint4 rightCoordinate, uint rightLevel)
{
    return leftLevel == rightLevel && all(leftCoordinate == rightCoordinate);
}




uint SigmaN4PublishSourceLowerBound(uint4 coordinate, uint level,
    uint oldExtent, inout uint valid)
{
    uint low = 0u;
    uint high = oldExtent;
    [loop]
    while (low < high)
    {
        uint middle = low + ((high - low) >> 1u);
        uint sourceSlot;
        uint sourceSample;
        uint4 sourceCoordinate;
        uint sourceLevel;
        bool sourceValid = SigmaN4PublishSourceLogical(middle, sourceSlot,
            sourceSample, sourceCoordinate, sourceLevel);
        valid &= sourceValid ? 1u : 0u;
        bool less = sourceValid && SigmaMerkabaGaugeLess(sourceCoordinate,
            sourceLevel, coordinate, level, valid);
        if (less) low = middle + 1u;
        else high = middle;
    }
    return low;
}

uint SigmaN4PublishCompleteRefinementTargetPlan(uint threadIndex,
    uniform uint oldExtent, uniform uint childCount);



uint SigmaN4PublishPrepareRefinementCandidates(uint threadIndex,
    out uint oldExtent)
{
    uint localExtent = 0u;
    uint pageRounds = (_NativePagePlanCapacity + 255u) / 256u;
    uint residentPagePlanCapacity = SigmaN4PublishResidentPagePlanCapacity();
    [loop]
    for (uint pageRound = 0u; pageRound < pageRounds; ++pageRound)
    {
        uint page = pageRound * 256u + threadIndex;
        if (page < residentPagePlanCapacity)
        {
            uint source = _NativeCloseScratch[
                SigmaN4PublishPlanAddress(page, 0u)].y;
            if (source < _NativeTargetPageCapacity)
                localExtent = max(localExtent,
                    page * SIGMA_PAGE_SAMPLE_COUNT +
                    _NativeSourcePageMetadata[source].activeSampleCount);
            else if (source != SIGMA_N4_INVALID)
            {
                uint ignored;
                InterlockedOr(SigmaN4PublishFault,
                    SIGMA_N4_FAULT_SOURCE_LOCATOR, ignored);
            }
        }
    }
    SigmaN4PublishWide[threadIndex] = uint2(localExtent, 0u);
    GroupMemoryBarrierWithGroupSync();
    [loop]
    for (uint stride = 128u; stride != 0u; stride >>= 1u)
    {
        if (threadIndex < stride)
            SigmaN4PublishWide[threadIndex].x = max(
                SigmaN4PublishWide[threadIndex].x,
                SigmaN4PublishWide[threadIndex + stride].x);
        GroupMemoryBarrierWithGroupSync();
    }
    oldExtent = SigmaN4PublishWide[0u].x;

    // The active canonical stages have already proved each support group and
    // appended its four physical child keys.  This last global workgroup owns
    // only certificate handoff and indirect-argument preparation; it must not
    // rediscover the full footprint domain a seventh time.
    uint childCount = _NativeCounters[1u].z * 4u;
    if (threadIndex == 0u)
    {
        uint logicalBlocks = (oldExtent + 255u) / 256u;
        uint footprintBlocks = (_NativeCounters[2u].w + 255u) / 256u;
        uint childRuns = (childCount + SIGMA_N4_REFINEMENT_RUN_CAPACITY - 1u) /
            SIGMA_N4_REFINEMENT_RUN_CAPACITY;
        uint scanGroups = max(1u, max(footprintBlocks,
            childCount == 0u ? 0u : max(logicalBlocks, childRuns)));
        _NativeCounters[1u].y = oldExtent;
        _NativeCounters[1u].z = childCount >> 2u;
        _NativeCounters[1u].w = childCount;
        _NativeCounters[2u] = uint4(scanGroups, 1u, 1u, 0u);
    }
    return childCount;
}

bool SigmaN4PublishRefinementCandidateKey(uint candidate,
    uint childCount, out uint activeIndex, out uint child,
    out uint4 coordinate, out uint level)
{
    activeIndex = SIGMA_N4_INVALID;
    child = candidate & 3u;
    coordinate = 0u;
    level = 0u;
    if (candidate >= childCount) return false;
    uint group = candidate >> 2u;
    if (group >= _NativeCounters[1u].z ||
        group >= _NativeCanonicalComponentCapacity)
        return false;
    activeIndex = _NativeCloseScratch[
        SigmaN4PublishRefinementGroupAddress(group)].x;
    return SigmaN4PublishRefinementChildKey(activeIndex, child, coordinate,
        level);
}

int SigmaN4PublishCompareRefinementCandidates(uint left, uint right,
    uint childCount, bool executionTie)
{
    uint leftActive;
    uint leftChild;
    uint4 leftCoordinate;
    uint leftLevel;
    bool leftValid = SigmaN4PublishRefinementCandidateKey(left, childCount,
        leftActive, leftChild, leftCoordinate, leftLevel);
    uint rightActive;
    uint rightChild;
    uint4 rightCoordinate;
    uint rightLevel;
    bool rightValid = SigmaN4PublishRefinementCandidateKey(right, childCount,
        rightActive, rightChild, rightCoordinate, rightLevel);
    if (leftValid != rightValid) return leftValid ? -1 : 1;
    if (!leftValid)
    {
        if (!executionTie || left == right) return 0;
        return left < right ? -1 : 1;
    }
    uint valid = 1u;
    bool leftLess = SigmaMerkabaGaugeLess(leftCoordinate, leftLevel,
        rightCoordinate, rightLevel, valid);
    bool rightLess = SigmaMerkabaGaugeLess(rightCoordinate, rightLevel,
        leftCoordinate, leftLevel, valid);
    if (valid == 0u)
    {
        InterlockedOr(_NativeCounters[0u].z,
            SIGMA_N4_FAULT_REFINEMENT_KEY);
        return 0;
    }
    if (leftLess != rightLess) return leftLess ? -1 : 1;
    if (!executionTie || left == right) return 0;
    return left < right ? -1 : 1;
}

void SigmaN4PublishSortRefinementRun(uint run, uint threadIndex)
{
    // Carry is written once by lane zero and broadcast through a whole-group
    // barrier at the kernel boundary.  Unity can therefore prove this phase
    // predicate dynamically uniform instead of conservatively treating the
    // scalar UAV load as lane-varying.
    if (SigmaN4PublishCarry.y == 0u)
        return;
    uint childCount = SigmaN4PublishCarry.x;
    uint begin = run * SIGMA_N4_REFINEMENT_RUN_CAPACITY;
    uint activeCount = begin < childCount
        ? min(SIGMA_N4_REFINEMENT_RUN_CAPACITY, childCount - begin)
        : 0u;
    uint activePadded = SigmaN4PublishNextPowerOfTwo(max(activeCount, 1u));
    [loop]
    for (uint local = threadIndex; local < SIGMA_N4_REFINEMENT_RUN_CAPACITY;
         local += 256u)
    {
        if (local < activePadded)
        {
            uint candidate = begin + local;
            SigmaN4PublishChildOrderStore(candidate,
                local < activeCount ? candidate : SIGMA_N4_INVALID);
        }
    }
    DeviceMemoryBarrierWithGroupSync();
    [loop]
    for (uint width = 2u; width <= SIGMA_N4_REFINEMENT_RUN_CAPACITY;
         width <<= 1u)
    {
        [loop]
        for (uint stride = width >> 1u; stride != 0u; stride >>= 1u)
        {
            uint pairCount = width <= activePadded
                ? activePadded >> 1u : 0u;
            [loop]
            for (uint pair = threadIndex; pair < pairCount; pair += 256u)
            {
                uint lowLocal = (pair / stride) * (stride << 1u) +
                    pair % stride;
                uint highLocal = lowLocal + stride;
                uint lowAddress = begin + lowLocal;
                uint highAddress = begin + highLocal;
                uint left = SigmaN4PublishChildOrderLoad(lowAddress);
                uint right = SigmaN4PublishChildOrderLoad(highAddress);
                int comparison = SigmaN4PublishCompareRefinementCandidates(
                    left, right, childCount, true);
                bool ascending = (lowLocal & width) == 0u;
                if ((ascending && comparison > 0) ||
                    (!ascending && comparison < 0))
                {
                    SigmaN4PublishChildOrderStore(lowAddress, right);
                    SigmaN4PublishChildOrderStore(highAddress, left);
                }
            }
            DeviceMemoryBarrierWithGroupSync();
        }
    }
}

void SigmaN4PublishScanRefinementBlock(uint block, uint oldExtent,
    uint childCount, uint threadIndex, bool blockActive)
{
    uint logical = block * 256u + threadIndex;
    uint canonicalCount = _NativeCounters[3u].x;
    uint logicalBlocks = (oldExtent + 255u) / 256u;
    uint footprintBlocks = (canonicalCount + 255u) / 256u;
    uint refined = 0u;
    if (blockActive && childCount != 0u && logical < oldExtent)
    {
        uint sourceSlot;
        uint sourceSample;
        uint4 coordinate;
        uint level;
        bool sourceValid = SigmaN4PublishSourceLogical(logical, sourceSlot,
            sourceSample, coordinate, level);
        uint activeIndex = SIGMA_N4_INVALID;
        uint refinement = SIGMA_N4_REFINEMENT_NONE;
        bool observed = sourceValid && SigmaN4PublishActiveSupport(
            sourceSlot * SIGMA_PAGE_SAMPLE_COUNT + sourceSample, activeIndex,
            refinement);
        refined = observed && refinement == SIGMA_N4_REFINEMENT_PROVED
            ? 1u : 0u;
        if (!sourceValid)
            InterlockedOr(_NativeCounters[0u].z,
                SIGMA_N4_FAULT_SOURCE_LOCATOR);
    }
    uint fresh = 0u;
    if (blockActive && logical < canonicalCount)
    {
        uint2 entry = _NativeCloseScratch[SigmaN4PublishImageAddress(
            SIGMA_N4_RADIX_WORK_IMAGE, logical)];
        fresh = entry.x != SIGMA_N4_INVALID &&
            SigmaN4PublishSupportLocator(entry.x) == SIGMA_N4_INVALID
            ? 1u : 0u;
    }
    SigmaN4PublishWide[threadIndex] = uint2(refined, fresh);
    GroupMemoryBarrierWithGroupSync();
    if (blockActive && threadIndex < 4u)
    {
        uint2 refinedBits = 0u;
        uint2 freshBits = 0u;
        uint laneBase = threadIndex * 64u;
        [loop]
        for (uint bit = 0u; bit < 32u; ++bit)
        {
            refinedBits.x |= (SigmaN4PublishWide[laneBase + bit].x & 1u)
                << bit;
            refinedBits.y |=
                (SigmaN4PublishWide[laneBase + 32u + bit].x & 1u) << bit;
            freshBits.x |= (SigmaN4PublishWide[laneBase + bit].y & 1u)
                << bit;
            freshBits.y |=
                (SigmaN4PublishWide[laneBase + 32u + bit].y & 1u) << bit;
        }
        if (childCount != 0u && block < logicalBlocks)
            _NativeCloseScratch[SigmaN4PublishRefinedBitsetAddress(
                block * 4u + threadIndex)] = refinedBits;
        if (block < footprintBlocks)
            _NativeCloseScratch[SigmaN4PublishFreshBitsetAddress(
                block * 4u + threadIndex)] = freshBits;
    }
    DeviceMemoryBarrierWithGroupSync();
    if (blockActive && threadIndex == 0u)
    {
        if (childCount != 0u && block < logicalBlocks)
        {
            uint count = 0u;
            [unroll]
            for (uint word = 0u; word < 4u; ++word)
            {
                uint2 bits = _NativeCloseScratch[
                    SigmaN4PublishRefinedBitsetAddress(block * 4u + word)];
                count += countbits(bits.x) + countbits(bits.y);
            }
            _NativeCloseScratch[
                SigmaN4PublishRefinedBlockPrefixAddress(block)] =
                    uint2(count, 0u);
        }
        if (block < footprintBlocks)
        {
            uint count = 0u;
            [unroll]
            for (uint word = 0u; word < 4u; ++word)
            {
                uint2 bits = _NativeCloseScratch[
                    SigmaN4PublishFreshBitsetAddress(block * 4u + word)];
                count += countbits(bits.x) + countbits(bits.y);
            }
            _NativeCloseScratch[SigmaN4PublishFreshBlockAddress(block)] =
                uint2(count, 0u);
        }
    }
}

void SigmaN4PublishFinishRefinementBlockScan(uint oldExtent, uint childCount,
    uint threadIndex)
{
    uint logicalBlocks = (oldExtent + 255u) / 256u;
    uint footprintBlocks = (_NativeCounters[3u].x + 255u) / 256u;
    uint refinementBlocks = childCount == 0u ? 0u : logicalBlocks;
    uint activeBlocks = max(refinementBlocks, footprintBlocks);
    uint chunk = (max(activeBlocks, 1u) + 255u) / 256u;
    uint begin = threadIndex * chunk;
    uint2 localTotal = 0u;
    [loop]
    for (uint blockLocal = 0u; blockLocal < chunk; ++blockLocal)
    {
        uint block = begin + blockLocal;
        if (block < refinementBlocks)
            localTotal.x += _NativeCloseScratch[
                SigmaN4PublishRefinedBlockPrefixAddress(block)].x;
        if (block < footprintBlocks)
            localTotal.y += _NativeCloseScratch[
                SigmaN4PublishFreshBlockAddress(block)].x;
    }
    SigmaN4PublishFlags[threadIndex] = localTotal.x;
    SigmaN4PublishFlagsHigh[threadIndex] = localTotal.y;
    GroupMemoryBarrierWithGroupSync();
    [loop]
    for (uint stride = 1u; stride < 256u; stride <<= 1u)
    {
        uint2 value = uint2(SigmaN4PublishFlags[threadIndex],
            SigmaN4PublishFlagsHigh[threadIndex]);
        if (threadIndex >= stride)
            value += uint2(SigmaN4PublishFlags[threadIndex - stride],
                SigmaN4PublishFlagsHigh[threadIndex - stride]);
        SigmaN4PublishWide[threadIndex] = value;
        GroupMemoryBarrierWithGroupSync();
        SigmaN4PublishFlags[threadIndex] =
            SigmaN4PublishWide[threadIndex].x;
        SigmaN4PublishFlagsHigh[threadIndex] =
            SigmaN4PublishWide[threadIndex].y;
        GroupMemoryBarrierWithGroupSync();
    }
    uint2 running = threadIndex == 0u ? 0u : uint2(
        SigmaN4PublishFlags[threadIndex - 1u],
        SigmaN4PublishFlagsHigh[threadIndex - 1u]);
    [loop]
    for (uint local = 0u; local < chunk; ++local)
    {
        uint block = begin + local;
        if (block < activeBlocks)
        {
            uint refinedCount = block < refinementBlocks
                ? _NativeCloseScratch[
                    SigmaN4PublishRefinedBlockPrefixAddress(block)].x
                : 0u;
            if (block < refinementBlocks)
                _NativeCloseScratch[
                    SigmaN4PublishRefinedBlockPrefixAddress(block)] =
                        uint2(refinedCount, running.x);
            if (block < footprintBlocks)
            {
                uint freshCount = _NativeCloseScratch[
                    SigmaN4PublishFreshBlockAddress(block)].x;
                _NativeCloseScratch[
                    SigmaN4PublishFreshBlockAddress(block)].y = running.y;
                running.y += freshCount;
            }
            running.x += refinedCount;
        }
    }
    DeviceMemoryBarrierWithGroupSync();
}

uint SigmaN4PublishRefinedInclusive(uint logical)
{
    uint block = logical >> 8u;
    uint wordInBlock = (logical & 255u) >> 6u;
    uint bitInWord = logical & 63u;
    uint localCount = 0u;
    [unroll]
    for (uint word = 0u; word < 4u; ++word)
    {
        uint2 bits = _NativeCloseScratch[SigmaN4PublishRefinedBitsetAddress(
            block * 4u + word)];
        if (word < wordInBlock)
            localCount += countbits(bits.x) + countbits(bits.y);
        else if (word == wordInBlock)
        {
            if (bitInWord < 32u)
            {
                uint mask = bitInWord == 31u
                    ? 0xffffffffu : (1u << (bitInWord + 1u)) - 1u;
                localCount += countbits(bits.x & mask);
            }
            else
            {
                uint highBit = bitInWord - 32u;
                uint mask = highBit == 31u
                    ? 0xffffffffu : (1u << (highBit + 1u)) - 1u;
                localCount += countbits(bits.x) + countbits(bits.y & mask);
            }
        }
    }
    return _NativeCloseScratch[
        SigmaN4PublishRefinedBlockPrefixAddress(block)].y + localCount;
}

uint SigmaN4PublishFreshInclusive(uint position)
{
    uint block = position >> 8u;
    uint wordInBlock = (position & 255u) >> 6u;
    uint bitInWord = position & 63u;
    uint localCount = 0u;
    [unroll]
    for (uint word = 0u; word < 4u; ++word)
    {
        uint2 bits = _NativeCloseScratch[SigmaN4PublishFreshBitsetAddress(
            block * 4u + word)];
        if (word < wordInBlock)
            localCount += countbits(bits.x) + countbits(bits.y);
        else if (word == wordInBlock)
        {
            if (bitInWord < 32u)
            {
                uint mask = bitInWord == 31u ? 0xffffffffu :
                    (1u << (bitInWord + 1u)) - 1u;
                localCount += countbits(bits.x & mask);
            }
            else
            {
                uint highBit = bitInWord - 32u;
                uint mask = highBit == 31u ? 0xffffffffu :
                    (1u << (highBit + 1u)) - 1u;
                localCount += countbits(bits.x) + countbits(bits.y & mask);
            }
        }
    }
    return _NativeCloseScratch[SigmaN4PublishFreshBlockAddress(block)].y +
        localCount;
}

uint SigmaN4PublishRefinementRunLowerBound(uint run, uint childCount,
    uint4 coordinate, uint level, bool upper, inout uint valid)
{
    uint begin = run * SIGMA_N4_REFINEMENT_RUN_CAPACITY;
    uint low = begin;
    uint high = min(begin + SIGMA_N4_REFINEMENT_RUN_CAPACITY, childCount);
    [loop]
    while (low < high)
    {
        uint middle = low + ((high - low) >> 1u);
        uint candidate = SigmaN4PublishChildOrderLoad(middle);
        uint activeIndex;
        uint child;
        uint4 keyCoordinate;
        uint keyLevel;
        bool keyValid = SigmaN4PublishRefinementCandidateKey(candidate,
            childCount, activeIndex, child, keyCoordinate, keyLevel);
        valid &= keyValid ? 1u : 0u;
        bool keyLess = keyValid && SigmaMerkabaGaugeLess(keyCoordinate,
            keyLevel, coordinate, level, valid);
        bool queryLess = keyValid && SigmaMerkabaGaugeLess(coordinate, level,
            keyCoordinate, keyLevel, valid);
        bool advance = upper ? !queryLess : keyLess;
        if (advance) low = middle + 1u;
        else high = middle;
    }
    return low - begin;
}

uint SigmaN4PublishParallelChildBound(uint4 coordinate, uint level,
    uint childCount, bool upper, inout uint valid)
{
    uint runCount = (childCount + SIGMA_N4_REFINEMENT_RUN_CAPACITY - 1u) /
        SIGMA_N4_REFINEMENT_RUN_CAPACITY;
    uint rank = 0u;
    [loop]
    for (uint run = 0u; run < runCount; ++run)
        rank += SigmaN4PublishRefinementRunLowerBound(run, childCount,
            coordinate, level, upper, valid);
    return rank;
}



bool SigmaN4PublishComputeOldTarget(uint logical, uint oldExtent,
    uint childCount, out uint target, out bool observed, out bool refined)
{
    target = logical;
    observed = false;
    refined = false;
    if (logical >= oldExtent) return false;
    uint sourceSlot;
    uint sourceSample;
    uint4 coordinate;
    uint level;
    uint valid = SigmaN4PublishSourceLogical(logical, sourceSlot,
        sourceSample, coordinate, level) ? 1u : 0u;
    uint prefix = SigmaN4PublishRefinedInclusive(logical);
    uint activeIndex;
    uint refinement;
    observed = valid != 0u && SigmaN4PublishActiveSupport(
        sourceSlot * SIGMA_PAGE_SAMPLE_COUNT + sourceSample, activeIndex,
        refinement);
    refined = observed && refinement == SIGMA_N4_REFINEMENT_PROVED;
    uint childBefore = SigmaN4PublishParallelChildBound(coordinate, level,
        childCount, false, valid);
    uint refinedBefore = prefix - (refined ? 1u : 0u);
    target = logical - refinedBefore + childBefore;
    return valid != 0u;
}

bool SigmaN4PublishComputeRefinementChildTarget(uint activeIndex, uint child,
    uint oldExtent, uint childCount, out uint target)
{
    target = 0u;
    uint4 coordinate;
    uint level;
    uint valid = SigmaN4PublishRefinementChildKey(activeIndex, child,
        coordinate, level) ? 1u : 0u;
    uint lower = SigmaN4PublishParallelChildBound(coordinate, level,
        childCount, false, valid);
    uint upper = SigmaN4PublishParallelChildBound(coordinate, level,
        childCount, true, valid);
    if (upper - lower != 1u)
        InterlockedOr(_NativeCounters[0u].w, 1u);
    uint oldBefore = SigmaN4PublishSourceLowerBound(coordinate, level,
        oldExtent, valid);
    uint refinedBefore = oldBefore == 0u ? 0u :
        SigmaN4PublishRefinedInclusive(oldBefore - 1u);
    if (oldBefore < oldExtent)
    {
        uint sourceSlot;
        uint sourceSample;
        uint4 sourceCoordinate;
        uint sourceLevel;
        bool sourceValid = SigmaN4PublishSourceLogical(oldBefore, sourceSlot,
            sourceSample, sourceCoordinate, sourceLevel);
        valid &= sourceValid ? 1u : 0u;
        uint activeIndex;
        uint refinement;
        bool observed = sourceValid && SigmaN4PublishActiveSupport(
            sourceSlot * SIGMA_PAGE_SAMPLE_COUNT + sourceSample, activeIndex,
            refinement);
        bool retained = !observed ||
            refinement != SIGMA_N4_REFINEMENT_PROVED;
        if (retained && SigmaN4PublishGaugeEqual(sourceCoordinate,
                sourceLevel, coordinate, level))
            InterlockedOr(_NativeCounters[0u].w, 1u);
    }
    target = lower + oldBefore - refinedBefore;
    return valid != 0u;
}

// CUT-E crosses real global synchronization boundaries through a fixed dispatch
// graph.  These receipts are execution-only and are overwritten by the existing
// page/scatter indirect arguments before publication:
//   Counters[0].z/w = accumulated fault/unresolved flags,
//   Counters[1].x/y/z = component count / old extent / refinement count.
void SigmaN4PublishLoadStageState(uint threadIndex)
{
    if (threadIndex == 0u)
    {
        SigmaN4PublishCount = 0u;
        SigmaN4PublishFault = _NativeCounters[0u].z;
        SigmaN4PublishUnresolved = _NativeCounters[0u].w;
    }
    GroupMemoryBarrierWithGroupSync();
}

void SigmaN4PublishStoreStageState(uint threadIndex)
{
    DeviceMemoryBarrierWithGroupSync();
    if (threadIndex == 0u)
    {
        _NativeCounters[0u].z = SigmaN4PublishFault;
        _NativeCounters[0u].w = SigmaN4PublishUnresolved;
    }
}

void SigmaN4PublishBeginWideStage(uint threadIndex)
{
    if (threadIndex == 0u)
    {
        SigmaN4PublishFault = 0u;
        SigmaN4PublishUnresolved = 0u;
    }
    GroupMemoryBarrierWithGroupSync();
}

void SigmaN4PublishFlushWideStage(uint threadIndex)
{
    DeviceMemoryBarrierWithGroupSync();
    if (threadIndex == 0u)
    {
        uint ignored;
        InterlockedOr(_NativeCounters[0u].z, SigmaN4PublishFault, ignored);
        InterlockedOr(_NativeCounters[0u].w, SigmaN4PublishUnresolved,
            ignored);
    }
    DeviceMemoryBarrierWithGroupSync();
}

uint SigmaN4PublishCanonicalRunSize()
{
    uint active = min(SIGMA_N4_CANONICAL_RUN_CAPACITY,
        max(_NativeFootprintCount, 1u));
    return active <= 1u ? 1u :
        1u << (firstbithigh(active - 1u) + 1u);
}

uint SigmaN4PublishCanonicalRunCount()
{
    uint runSize = SigmaN4PublishCanonicalRunSize();
    uint activeCount = _NativeCounters[2u].w;
    return max(1u, (activeCount + runSize - 1u) / runSize);
}

uint2 SigmaN4PublishLoadParallelImage(uint image, uint index)
{
    SigmaNativeGaugeDeltaGpu streams = _NativeGaugeDeltas[index];
    if (image == 0u) return streams.Coordinate.xy;
    if (image == 1u) return streams.Coordinate.zw;
    if (image == 2u) return streams.Prior.xy;
    if (image == 3u) return streams.Prior.zw;
    if (image == 4u) return streams.Next.xy;
    if (image == 5u) return streams.Next.zw;
    if (image == 6u) return streams.Witness.xy;
    return streams.Witness.zw;
}

void SigmaN4PublishStoreParallelRank(uint footprint, uint image, uint rank)
{
    uint ignored;
    if (image == 0u)
        InterlockedExchange(_NativeStateDeltas[footprint].Coordinate.x, rank,
            ignored);
    else if (image == 1u)
        InterlockedExchange(_NativeStateDeltas[footprint].Coordinate.y, rank,
            ignored);
    else if (image == 2u)
        InterlockedExchange(_NativeStateDeltas[footprint].Coordinate.z, rank,
            ignored);
    else if (image == 3u)
        InterlockedExchange(_NativeStateDeltas[footprint].Coordinate.w, rank,
            ignored);
    else if (image == 4u)
        InterlockedExchange(_NativeStateDeltas[footprint].Generation.x, rank,
            ignored);
    else if (image == 5u)
        InterlockedExchange(_NativeStateDeltas[footprint].Generation.y, rank,
            ignored);
    else if (image == 6u)
        InterlockedExchange(_NativeStateDeltas[footprint].Generation.z, rank,
            ignored);
    else
        InterlockedExchange(_NativeStateDeltas[footprint].Generation.w, rank,
            ignored);
}

uint SigmaN4PublishParallelRank(uint footprint, uint image)
{
    SigmaNativeStateDeltaGpu ranks = _NativeStateDeltas[footprint];
    if (image == 0u) return ranks.Coordinate.x;
    if (image == 1u) return ranks.Coordinate.y;
    if (image == 2u) return ranks.Coordinate.z;
    if (image == 3u) return ranks.Coordinate.w;
    if (image == 4u) return ranks.Generation.x;
    if (image == 5u) return ranks.Generation.y;
    if (image == 6u) return ranks.Generation.z;
    return ranks.Generation.w;
}

uint SigmaN4PublishD4PairIndex(uint lowImage, uint highImage)
{
    uint index = lowImage * (15u - lowImage) / 2u;
    return index + highImage - lowImage - 1u;
}

void SigmaN4PublishInitializeD4Pairs(uint component)
{
    _NativeStateDeltas[component].Changed = 0xffffffffu;
    _NativeStateDeltas[component].Witness = 0xffffffffu;
    _NativeStateDeltas[component].Receipts = 0xffffffffu;
    _NativeStateDeltas[component].State01 = 0xffffffffu;
    _NativeStateDeltas[component].State23 = 0xffffffffu;
    _NativeStateDeltas[component].State45 = 0xffffffffu;
    _NativeStateDeltas[component].State67 = 0xffffffffu;
}

uint SigmaN4PublishD4PairReceipt(uint component, uint pair)
{
    SigmaNativeStateDeltaGpu receipts = _NativeStateDeltas[component];
    if (pair < 4u) return receipts.Changed[pair];
    if (pair < 8u) return receipts.Witness[pair - 4u];
    if (pair < 12u) return receipts.Receipts[pair - 8u];
    if (pair < 16u) return receipts.State01[pair - 12u];
    if (pair < 20u) return receipts.State23[pair - 16u];
    if (pair < 24u) return receipts.State45[pair - 20u];
    return receipts.State67[pair - 24u];
}

void SigmaN4PublishMinD4PairReceipt(uint component, uint pair, uint receipt)
{
    uint ignored;
    if (pair < 4u)
        InterlockedMin(_NativeStateDeltas[component].Changed[pair], receipt,
            ignored);
    else if (pair < 8u)
        InterlockedMin(_NativeStateDeltas[component].Witness[pair - 4u],
            receipt, ignored);
    else if (pair < 12u)
        InterlockedMin(_NativeStateDeltas[component].Receipts[pair - 8u],
            receipt, ignored);
    else if (pair < 16u)
        InterlockedMin(_NativeStateDeltas[component].State01[pair - 12u],
            receipt, ignored);
    else if (pair < 20u)
        InterlockedMin(_NativeStateDeltas[component].State23[pair - 16u],
            receipt, ignored);
    else if (pair < 24u)
        InterlockedMin(_NativeStateDeltas[component].State45[pair - 20u],
            receipt, ignored);
    else
        InterlockedMin(_NativeStateDeltas[component].State67[pair - 24u],
            receipt, ignored);
}

int SigmaN4PublishCompareD4Images(uint component, uint leftImage,
    uint rightImage)
{
    if (leftImage == rightImage) return 0;
    uint lowImage = min(leftImage, rightImage);
    uint highImage = max(leftImage, rightImage);
    uint receipt = SigmaN4PublishD4PairReceipt(component,
        SigmaN4PublishD4PairIndex(lowImage, highImage));
    if (receipt == SIGMA_N4_INVALID) return 0;
    int lowToHigh = (receipt & 1u) == 0u ? -1 : 1;
    return leftImage == lowImage ? lowToHigh : -lowToHigh;
}

void SigmaN4PublishStoreParallelImage(uint image, uint index, uint2 value)
{
    uint ignored;
    // Images share one already-owned gauge-delta record. Scalar atomics keep
    // concurrent D4 workgroups on disjoint words without a struct RMW race.
    if (image == 0u)
    {
        InterlockedExchange(_NativeGaugeDeltas[index].Coordinate.x, value.x,
            ignored);
        InterlockedExchange(_NativeGaugeDeltas[index].Coordinate.y, value.y,
            ignored);
    }
    else if (image == 1u)
    {
        InterlockedExchange(_NativeGaugeDeltas[index].Coordinate.z, value.x,
            ignored);
        InterlockedExchange(_NativeGaugeDeltas[index].Coordinate.w, value.y,
            ignored);
    }
    else if (image == 2u)
    {
        InterlockedExchange(_NativeGaugeDeltas[index].Prior.x, value.x,
            ignored);
        InterlockedExchange(_NativeGaugeDeltas[index].Prior.y, value.y,
            ignored);
    }
    else if (image == 3u)
    {
        InterlockedExchange(_NativeGaugeDeltas[index].Prior.z, value.x,
            ignored);
        InterlockedExchange(_NativeGaugeDeltas[index].Prior.w, value.y,
            ignored);
    }
    else if (image == 4u)
    {
        InterlockedExchange(_NativeGaugeDeltas[index].Next.x, value.x,
            ignored);
        InterlockedExchange(_NativeGaugeDeltas[index].Next.y, value.y,
            ignored);
    }
    else if (image == 5u)
    {
        InterlockedExchange(_NativeGaugeDeltas[index].Next.z, value.x,
            ignored);
        InterlockedExchange(_NativeGaugeDeltas[index].Next.w, value.y,
            ignored);
    }
    else if (image == 6u)
    {
        InterlockedExchange(_NativeGaugeDeltas[index].Witness.x, value.x,
            ignored);
        InterlockedExchange(_NativeGaugeDeltas[index].Witness.y, value.y,
            ignored);
    }
    else
    {
        InterlockedExchange(_NativeGaugeDeltas[index].Witness.z, value.x,
            ignored);
        InterlockedExchange(_NativeGaugeDeltas[index].Witness.w, value.y,
            ignored);
    }
}

int SigmaN4PublishCompareCanonicalEntries(uint2 left, uint2 right,
    uint image, bool executionTie)
{
    bool leftValid = left.x != SIGMA_N4_INVALID;
    bool rightValid = right.x != SIGMA_N4_INVALID;
    if (leftValid != rightValid) return leftValid ? -1 : 1;
    if (!leftValid)
    {
        if (!executionTie || left.y == right.y) return 0;
        return left.y < right.y ? -1 : 1;
    }
    if (left.y != right.y) return left.y < right.y ? -1 : 1;
    uint valid = 1u;
    int comparison = SigmaN4PublishComparePreparedCoordinateKey(left.x,
        image, right.x, image, valid);
    if (valid == 0u) return 0;
    if (comparison != 0 || !executionTie) return comparison;
    // Exact-equal keys have identical canonical position. The index is only a
    // collision-free routing tie for the transient scatter and is never
    // serialized or used to choose between distinct canonical payloads.
    if (left.x == right.x) return 0;
    return left.x < right.x ? -1 : 1;
}

void SigmaN4PublishSortCanonicalRun(uint run, uint image, uint threadIndex)
{
    uint runSize = SigmaN4PublishCanonicalRunSize();
    uint begin = run * runSize;
    uint activeCount = _NativeCounters[2u].w;
    [loop]
    for (uint local = threadIndex; local < runSize; local += 256u)
    {
        uint position = begin + local;
        uint2 entry = uint2(SIGMA_N4_INVALID, position);
        if (position < activeCount)
        {
            uint footprint = _NativeCloseScratch[
                _NativeCanonicalRankScratchOffset + position].x;
            uint component;
            uint orbit;
            uint4 chart;
            uint level;
            uint support;
            if (SigmaN4PublishChart(footprint, component, orbit, chart, level,
                    support))
            {
                SigmaN4PublishStoreCanonicalKeyImage(footprint, component,
                    level, image);
                entry = uint2(footprint, component);
            }
        }
        _NativeCloseScratch[SigmaN4PublishImageAddress(image,
            begin + local)] = entry;
    }
    DeviceMemoryBarrierWithGroupSync();

    [loop]
    for (uint width = 2u; width <= runSize; width <<= 1u)
    {
        [loop]
        for (uint stride = width >> 1u; stride != 0u; stride >>= 1u)
        {
            uint pairCount = runSize >> 1u;
            [loop]
            for (uint pair = threadIndex; pair < pairCount; pair += 256u)
            {
                uint lowLocal = (pair / stride) * (stride << 1u) +
                    (pair % stride);
                uint highLocal = lowLocal + stride;
                uint lowAddress = SigmaN4PublishImageAddress(image,
                    begin + lowLocal);
                uint highAddress = SigmaN4PublishImageAddress(image,
                    begin + highLocal);
                uint2 low = _NativeCloseScratch[lowAddress];
                uint2 high = _NativeCloseScratch[highAddress];
                int comparison = SigmaN4PublishCompareCanonicalEntries(low,
                    high, image, true);
                bool ascending = (lowLocal & width) == 0u;
                if ((ascending && comparison > 0) ||
                    (!ascending && comparison < 0))
                {
                    _NativeCloseScratch[lowAddress] = high;
                    _NativeCloseScratch[highAddress] = low;
                }
            }
            DeviceMemoryBarrierWithGroupSync();
        }
    }
}

uint SigmaN4PublishCanonicalRunLowerBound(uint image, uint run,
    uint2 key)
{
    uint runSize = SigmaN4PublishCanonicalRunSize();
    uint begin = run * runSize;
    uint end = min(begin + runSize, _NativeCounters[2u].w);
    uint low = begin;
    uint high = end;
    [loop]
    while (low < high)
    {
        uint middle = low + ((high - low) >> 1u);
        uint2 candidate = _NativeCloseScratch[
            SigmaN4PublishImageAddress(image, middle)];
        if (SigmaN4PublishCompareCanonicalEntries(candidate, key, image,
                true) < 0)
            low = middle + 1u;
        else
            high = middle;
    }
    return low - begin;
}

uint SigmaN4PublishCanonicalMergeRunSize()
{
    return SigmaN4PublishCanonicalRunSize() *
        SIGMA_N4_CANONICAL_MERGE_FANIN;
}

uint SigmaN4PublishCanonicalMergeRunCount()
{
    uint runSize = SigmaN4PublishCanonicalMergeRunSize();
    return max(1u, (_NativeCounters[2u].w + runSize - 1u) / runSize);
}

uint SigmaN4PublishCanonicalMergedRunLowerBound(uint image, uint run,
    uint2 key)
{
    uint runSize = SigmaN4PublishCanonicalMergeRunSize();
    uint begin = run * runSize;
    uint low = begin;
    uint high = min(begin + runSize, _NativeCounters[2u].w);
    [loop]
    while (low < high)
    {
        uint middle = low + ((high - low) >> 1u);
        uint2 candidate = SigmaN4PublishLoadParallelImage(image, middle);
        if (SigmaN4PublishCompareCanonicalEntries(candidate, key, image,
                true) < 0)
            low = middle + 1u;
        else
            high = middle;
    }
    return low - begin;
}

void SigmaN4PublishMergeCanonicalRunsAt(uint image, uint position)
{
    uint activeCount = _NativeCounters[2u].w;
    if (image >= 8u || position >= activeCount) return;
    uint runSize = SigmaN4PublishCanonicalRunSize();
    uint runCount = SigmaN4PublishCanonicalRunCount();
    uint ownRun = position / runSize;
    uint mergeFirst = (ownRun / SIGMA_N4_CANONICAL_MERGE_FANIN) *
        SIGMA_N4_CANONICAL_MERGE_FANIN;
    uint mergeEnd = min(mergeFirst + SIGMA_N4_CANONICAL_MERGE_FANIN,
        runCount);
    uint2 entry = _NativeCloseScratch[
        SigmaN4PublishImageAddress(image, position)];
    uint rank = position - ownRun * runSize;
    [loop]
    for (uint run = mergeFirst; run < mergeEnd; ++run)
        if (run != ownRun)
            rank += SigmaN4PublishCanonicalRunLowerBound(image, run, entry);
    uint output = mergeFirst * runSize + rank;
    if (output < activeCount)
        SigmaN4PublishStoreParallelImage(image, output, entry);
    else
        InterlockedOr(_NativeCounters[0u].z,
            SIGMA_N4_FAULT_CANONICAL_COORDINATE);
}


void SigmaN4PublishSelectComponentD4(uint component)
{
    if (component < _NativeCanonicalComponentCapacity &&
        _NativeCloseScratch[SigmaN4PublishComponentAddress(component,
            0u)].x != 0u)
    {
        uint selected = 0u;
        [loop]
        for (uint candidate = 1u; candidate < 8u; ++candidate)
            if (SigmaN4PublishCompareD4Images(component, candidate,
                    selected) < 0)
                selected = candidate;
        uint selectedAnchor = _NativeCloseScratch[
            SigmaN4PublishComponentAddress(component, 2u + selected)].x;
        _NativeCloseScratch[SigmaN4PublishComponentAddress(component,
            1u)].x = selected;
        _NativeCloseScratch[SigmaN4PublishComponentAddress(component, 2u)] =
            0u;
        _NativeCloseScratch[SigmaN4PublishComponentAddress(component, 3u)] =
            0u;
        _NativeCloseScratch[SigmaN4PublishComponentAddress(component, 4u)] =
            0u;
        _NativeCloseScratch[SigmaN4PublishComponentAddress(component, 5u)] =
            0u;
        _NativeCloseScratch[SigmaN4PublishComponentAddress(component, 6u)] =
            0u;
        _NativeCloseScratch[SigmaN4PublishComponentAddress(component, 7u)] =
            0u;
        _NativeCloseScratch[SigmaN4PublishComponentAddress(component, 9u)] =
            uint2(selectedAnchor, 0u);
        uint compactIndex;
        InterlockedAdd(_NativeCounters[1u].x, 1u, compactIndex);
        if (compactIndex < _NativeCanonicalComponentCapacity)
            _NativeCloseScratch[SigmaN4PublishImageAddress(
                SIGMA_N4_COMPONENT_LIST_IMAGE, compactIndex)] =
                    uint2(component, _NativeCloseScratch[
                        SigmaN4PublishComponentAddress(component, 0u)].x);
        else
            InterlockedOr(SigmaN4PublishFault,
                SIGMA_N4_FAULT_CANONICAL_WITNESS);
    }
}

void SigmaN4PublishMaterializeSelected(uint position)
{
    uint2 first = SigmaN4PublishLoadFinalImage(0u, position);
    uint2 selected = uint2(SIGMA_N4_INVALID, SIGMA_N4_INVALID);
    if (first.x != SIGMA_N4_INVALID)
    {
        uint component = first.y;
        uint image = _NativeCloseScratch[
            SigmaN4PublishComponentAddress(component, 1u)].x;
        if (image >= 8u)
        {
            InterlockedOr(_NativeCounters[0u].z,
                SIGMA_N4_FAULT_CANONICAL_WITNESS);
            _NativeCloseScratch[SigmaN4PublishImageAddress(
                SIGMA_N4_RADIX_WORK_IMAGE, position)] = selected;
            return;
        }
        selected = SigmaN4PublishLoadFinalImage(image, position);

        uint4 coordinate;
        uint4 morton;
        uint level;
        uint valid = SigmaN4PublishLoadCanonicalKey(selected.x, image,
            coordinate, morton, level) ? 1u : 0u;
        _NativeCloseScratch[SigmaN4PublishImageAddress(
            SIGMA_N4_RADIX_MORTON_LO_IMAGE, selected.x)] = coordinate.xy;
        _NativeCloseScratch[SigmaN4PublishImageAddress(
            SIGMA_N4_RADIX_MORTON_HI_IMAGE, selected.x)] = coordinate.zw;
        _NativeCloseScratch[SigmaN4PublishImageAddress(
            SIGMA_N4_RADIX_META_IMAGE, selected.x)] = valid != 0u
            ? uint2(level, component)
            : uint2(SIGMA_N4_INVALID, SIGMA_N4_INVALID);
        if (valid == 0u)
            InterlockedOr(_NativeCounters[0u].z,
                SIGMA_N4_FAULT_CANONICAL_COORDINATE);
    }
    _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_RADIX_WORK_IMAGE, position)] = selected;
}

void SigmaN4PublishAccumulateComponentFresh(uint position)
{
    uint2 entry = _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_RADIX_WORK_IMAGE, position)];
    if (entry.x == SIGMA_N4_INVALID) return;
    uint support = SigmaN4PublishSupportLocator(entry.x);
    uint ignored;
    if (support == SIGMA_N4_INVALID)
        InterlockedAdd(_NativeCloseScratch[
            SigmaN4PublishComponentAddress(entry.y, 3u)].x, 1u, ignored);
    else
        InterlockedOr(_NativeCloseScratch[
            SigmaN4PublishComponentAddress(entry.y, 3u)].y, 1u, ignored);
}

void SigmaN4PublishBuildComponentBlockSummaries(uint run,
    uint threadIndex)
{
    uint begin = run * SIGMA_N4_COMPONENT_RUN_CAPACITY;
    uint activeCount = _NativeCounters[2u].w;
    [loop]
    for (uint block = 0u; block <
            SIGMA_N4_COMPONENT_RUN_CAPACITY / 256u; ++block)
    {
        uint position = begin + block * 256u + threadIndex;
        uint4 partial = 0u;
        if (position < activeCount)
        {
            uint2 entry = _NativeCloseScratch[SigmaN4PublishImageAddress(
                SIGMA_N4_RADIX_WORK_IMAGE, position)];
            if (entry.x != SIGMA_N4_INVALID)
            {
                uint component = entry.y;
                uint blockEnd = begin + (block + 1u) * 256u;
                uint nextComponent = position + 1u < activeCount &&
                    position + 1u < blockEnd
                    ? _NativeCloseScratch[SigmaN4PublishImageAddress(
                        SIGMA_N4_RADIX_WORK_IMAGE, position + 1u)].y
                    : SIGMA_N4_INVALID;
                if (component != nextComponent)
                {
                    uint2 maximum = 0u;
                    uint valid = 1u;
                    uint blockBegin = begin + block * 256u;
                    uint cursor = position + 1u;
                    // Only the end lane of each contiguous component segment
                    // walks that segment.  The total work per 256-cell block
                    // is exactly its realized population; no barrier-prefix
                    // mill or full-capacity scan remains.
                    [loop]
                    while (cursor > blockBegin)
                    {
                        --cursor;
                        uint2 member = _NativeCloseScratch[
                            SigmaN4PublishImageAddress(
                                SIGMA_N4_RADIX_WORK_IMAGE, cursor)];
                        if (member.x == SIGMA_N4_INVALID ||
                            member.y != component)
                            break;
                        uint2 memberMeta = _NativeCloseScratch[
                            SigmaN4PublishImageAddress(
                                SIGMA_N4_RADIX_META_IMAGE, member.x)];
                        uint maximumLevel = _NativeCloseScratch[
                            SigmaN4PublishComponentAddress(component,
                                1u)].y;
                        uint2 memberMaximum = _NativeCloseScratch[
                            SigmaN4PublishImageAddress(
                                SIGMA_N4_RADIX_MORTON_LO_IMAGE,
                                member.x)];
                        valid &= memberMeta.x <= maximumLevel ? 1u : 0u;
                        if (valid != 0u)
                            memberMaximum = SigmaQ48ShiftLeftChecked(
                                memberMaximum,
                                maximumLevel - memberMeta.x, valid);
                        valid &= !SigmaI64Less(memberMaximum,
                            uint2(0u, 0u)) ? 1u : 0u;
                        maximum = SigmaQ48Max(maximum, memberMaximum);
                    }
                    partial = uint4(component, valid, maximum);
                }
            }
        }
        if (position < _NativeFootprintCount)
            _NativeStateDeltas[
                SigmaN4PublishCanonicalKeyAddress(position) + 1u].Receipts =
                    partial;
    }
}

void SigmaN4PublishFinalizeComponentSummary(uint component)
{
    uint2 meta = _NativeCloseScratch[
        SigmaN4PublishComponentAddress(component, 0u)];
    uint end = meta.y + meta.x;
    uint position = meta.y;
    uint2 maximum = 0u;
    uint valid = 1u;
    [loop]
    while (position < end)
    {
        uint blockEnd = min(((position >> 8u) + 1u) << 8u, end);
        uint4 partial = _NativeStateDeltas[
            SigmaN4PublishCanonicalKeyAddress(blockEnd - 1u) + 1u].Receipts;
        valid &= partial.x == component && partial.y != 0u ? 1u : 0u;
        maximum = SigmaQ48Max(maximum, partial.zw);
        position = blockEnd;
    }
    uint2 freshState = _NativeCloseScratch[
        SigmaN4PublishComponentAddress(component, 3u)];
    uint2 width = 0u;
    if (freshState.y == 0u && valid != 0u)
        width = SigmaQ48AddChecked(maximum, uint2(2u, 0u), valid);
    _NativeCloseScratch[SigmaN4PublishComponentAddress(component, 2u)] =
        width;
    if (valid == 0u)
        InterlockedOr(_NativeCounters[0u].z,
            SIGMA_N4_FAULT_COMPONENT_PACK);
}

[numthreads(256, 1, 1)]
void PrepareNativeCanonicalSeed(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint groupIndex = groupId.x;
    uint threadIndex = threadId.x;
    uint tileCount = _NativeTileCount.x * _NativeTileCount.y;
    uint borderBlockCount =
        (_NativeCounters[1u].z + 255u) / 256u;

    if (groupIndex == 0u)
    {
        uint pageRounds = (_NativePagePlanCapacity + 255u) / 256u;
        uint residentPagePlanCapacity =
            SigmaN4PublishResidentPagePlanCapacity();
        [loop]
        for (uint pageRound = 0u; pageRound < pageRounds; ++pageRound)
        {
            uint page = pageRound * 256u + threadIndex;
            if (page < _NativePagePlanCapacity)
            {
                bool resident = page < residentPagePlanCapacity;
                uint source = resident
                    ? SigmaN4PublishVisibleSlot(page) : SIGMA_N4_INVALID;
                uint target = !resident ? SIGMA_N4_INVALID :
                    (source == SIGMA_N4_INVALID ? page * 2u : (source ^ 1u));
                uint generation = !resident ? 0u :
                    (source == SIGMA_N4_INVALID ? 1u :
                        _NativeSourcePageMetadata[source].generation + 1u);
                _NativeCloseScratch[SigmaN4PublishPlanAddress(page, 0u)] =
                    uint2(page, source);
                _NativeCloseScratch[SigmaN4PublishPlanAddress(page, 1u)] =
                    uint2(target, generation);
                _NativeCloseScratch[SigmaN4PublishPlanAddress(page, 2u)] = 0u;
                _NativeCloseScratch[SigmaN4PublishPlanAddress(page, 3u)] =
                    uint2(SIGMA_N4_INVALID, 0u);
            }
        }
        // BuildNativeObservation owns the frame-wide member-count zero.  This
        // dispatch appends from every tile; resetting it here would race the
        // other seed workgroups.
    }

    if (groupIndex < tileCount)
        SigmaN4PublishSeedTile(groupIndex, threadIndex);
    SigmaN4PublishSeedBorderBlock(groupIndex, threadIndex,
        groupIndex < borderBlockCount);

    DeviceMemoryBarrierWithGroupSync();
    if (threadIndex == 0u)
    {
        uint previous;
        InterlockedAdd(_NativeCounters[3u].z, 1u, previous);
        uint groupCount = _NativeCounters[2u].x;
        if (previous + 1u == groupCount)
        {
            uint activeCount = _NativeCounters[2u].w;
            uint runCount = activeCount == 0u ? 0u :
                (activeCount + SigmaN4PublishCanonicalRunSize() - 1u) /
                    SigmaN4PublishCanonicalRunSize();
            _NativeCounters[2u] = uint4(max(1u, runCount * 8u), 1u, 1u,
                activeCount);
            _NativeCounters[3u].z = 0u;
        }
    }
}

[numthreads(256, 1, 1)]
void PrepareNativeCanonicalRuns(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint threadIndex = threadId.x;
    SigmaN4PublishBeginWideStage(threadIndex);
    uint activeCount = _NativeCounters[2u].w;
    uint activeRunCount = SigmaN4PublishCanonicalRunCount();
    uint image = groupId.x / activeRunCount;
    uint run = groupId.x - image * activeRunCount;
    SigmaN4PublishSortCanonicalRun(run, image, threadIndex);
    SigmaN4PublishFlushWideStage(threadIndex);
    if (threadIndex == 0u)
    {
        uint previous;
        InterlockedAdd(_NativeCounters[3u].z, 1u, previous);
        uint groupCount = _NativeCounters[2u].x;
        if (previous + 1u == groupCount)
        {
            _NativeCounters[2u] = uint4(max(1u,
                (activeCount * 8u + 255u) / 256u), 1u, 1u, activeCount);
            _NativeCounters[3u].z = 0u;
        }
    }
}

// Each thread ranks one already locally-sorted entry against the other bounded
// runs of the same D4 image. The last completed workgroup performs only the
// deterministic eight-stream reduction; it never sorts the full frame.
[numthreads(256, 1, 1)]
void PrepareNativeCanonicalSelect(uint3 groupId : SV_GroupID,
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint3 threadId : SV_GroupThreadID)
{
    uint threadIndex = threadId.x;
    SigmaN4PublishBeginWideStage(threadIndex);
    uint linearIndex = dispatchThreadId.x;
    uint activeCount = _NativeCounters[2u].w;
    uint activeStride = max(activeCount, 1u);
    uint image = linearIndex / activeStride;
    uint position = linearIndex - image * activeStride;
    uint runSize = SigmaN4PublishCanonicalMergeRunSize();
    uint runCount = SigmaN4PublishCanonicalMergeRunCount();
    if (image < 8u && position < activeCount)
    {
        uint2 entry = SigmaN4PublishLoadParallelImage(image, position);
        uint ownRun = position / runSize;
        uint rank = position - ownRun * runSize;
        [loop]
        for (uint run = 0u; run < runCount; ++run)
            if (run != ownRun)
                rank += SigmaN4PublishCanonicalMergedRunLowerBound(image,
                    run, entry);
        if (rank < activeCount)
        {
            _NativeCloseScratch[SigmaN4PublishImageAddress(image, rank)] =
                entry;
            if (image == 0u)
                SigmaN4PublishInitializeRefinementLeader(entry);
            if (entry.x != SIGMA_N4_INVALID)
            {
                SigmaN4PublishStoreParallelRank(entry.x, image, rank);
                uint ignored;
                InterlockedMin(_NativeCloseScratch[
                    SigmaN4PublishComponentAddress(entry.y, 0u)].y, rank,
                    ignored);
            }
        }
        else
            InterlockedOr(_NativeCounters[0u].w, 0x00001000u);
    }
    SigmaN4PublishFlushWideStage(threadIndex);

    if (threadIndex == 0u)
    {
        uint previous;
        InterlockedAdd(_NativeCounters[3u].z, 1u, previous);
        uint groupCount = _NativeCounters[2u].x;
        SigmaN4PublishLastGroup = previous + 1u == groupCount ? 1u : 0u;
    }
    GroupMemoryBarrierWithGroupSync();
    if (SigmaN4PublishLastGroup == 0u) return;

    DeviceMemoryBarrierWithGroupSync();
    if (threadIndex == 0u)
    {
        uint memberCount = _NativeCounters[1u].w;
        uint taskCount = max(activeCount * 28u, memberCount);
        _NativeCounters[2u] = uint4(max(1u,
            (taskCount + 255u) / 256u), 1u, 1u, activeCount);
        _NativeCounters[3u].z = 0u;
        // Stage 10 appends one execution-only record when the last exact D4
        // pair task closes a realized component.  Later ordering consumes
        // this compact list; discovery order cannot reach canonical bytes.
        _NativeCounters[1u].x = 0u;
        _NativeCounters[1u].z = 0u;
    }
}

[numthreads(256, 1, 1)]
void PrepareNativeRefinementProof(uint3 dispatchThreadId : SV_DispatchThreadID,
    uint3 threadId : SV_GroupThreadID)
{
    uint threadIndex = threadId.x;
    SigmaN4PublishBeginWideStage(threadIndex);
    uint activeCount = _NativeCounters[2u].w;
    uint memberCount = _NativeCounters[1u].w;
    uint linearIndex = dispatchThreadId.x;
    if (linearIndex < memberCount)
        SigmaN4PublishReduceRefinementMember(
            SigmaN4PublishLoadRefinementMember(linearIndex));
    uint position = linearIndex / 28u;
    uint pair = linearIndex - position * 28u;
    if (position < activeCount)
    {
        uint component = SigmaN4PublishCompareParallelD4PairAt(position,
            pair);
        if (component != SIGMA_N4_INVALID)
        {
            // The pair receipt is an atomic exact minimum.  Completion is
            // component-local: the last of count*28 tasks selects D4 without
            // a frame-sized interpreter or another dispatch.
            DeviceMemoryBarrier();
            uint completionAddress = SigmaN4PublishComponentAddress(
                component, 9u);
            uint previousPair;
            InterlockedAdd(_NativeCloseScratch[completionAddress].y, 1u,
                previousPair);
            uint expectedPairs = _NativeCloseScratch[
                SigmaN4PublishComponentAddress(component, 0u)].x * 28u;
            if (previousPair + 1u == expectedPairs)
                SigmaN4PublishSelectComponentD4(component);
            else if (previousPair + 1u > expectedPairs)
                InterlockedOr(SigmaN4PublishFault,
                    SIGMA_N4_FAULT_CANONICAL_WITNESS);
        }
    }
    SigmaN4PublishFlushWideStage(threadIndex);
    if (threadIndex == 0u)
    {
        uint previous;
        InterlockedAdd(_NativeCounters[3u].z, 1u, previous);
        uint groupCount = _NativeCounters[2u].x;
        SigmaN4PublishLastGroup = previous + 1u == groupCount ? 1u : 0u;
    }
    GroupMemoryBarrierWithGroupSync();
    if (SigmaN4PublishLastGroup == 0u) return;

    DeviceMemoryBarrierWithGroupSync();
    SigmaN4PublishLoadStageState(threadIndex);
    if (threadIndex == 0u)
    {
        uint activeBlocks = max(1u,
            (max(activeCount, memberCount) + 255u) / 256u);
        _NativeCounters[2u] = uint4(activeBlocks, 1u, 1u, activeCount);
        _NativeCounters[3u].z = 0u;
    }
    SigmaN4PublishStoreStageState(threadIndex);
}

[numthreads(256, 1, 1)]
void PrepareNativeComponentOrder(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint threadIndex = threadId.x;
    uint run = groupId.x;
    uint begin = run * SIGMA_N4_COMPONENT_RUN_CAPACITY;
    SigmaN4PublishBeginWideStage(threadIndex);
    uint memberPosition = begin + threadIndex;
    if (memberPosition < _NativeCounters[1u].w)
        SigmaN4PublishFinishRefinementMember(
            SigmaN4PublishLoadRefinementMember(memberPosition));
    [loop]
    for (uint local = threadIndex; local < SIGMA_N4_COMPONENT_RUN_CAPACITY;
         local += 256u)
    {
        uint position = begin + local;
        if (position < _NativeCounters[2u].w)
        {
            SigmaN4PublishMaterializeSelected(position);
            SigmaN4PublishAccumulateComponentFresh(position);
        }
    }
    DeviceMemoryBarrierWithGroupSync();
    SigmaN4PublishBuildComponentBlockSummaries(run, threadIndex);
    SigmaN4PublishSortComponentRun(run, threadIndex);
    SigmaN4PublishFlushWideStage(threadIndex);
    if (threadIndex == 0u)
    {
        uint previous;
        InterlockedAdd(_NativeCounters[3u].z, 1u, previous);
        uint groupCount = _NativeCounters[2u].x;
        SigmaN4PublishLastGroup = previous + 1u == groupCount ? 1u : 0u;
    }
    GroupMemoryBarrierWithGroupSync();
    if (SigmaN4PublishLastGroup == 0u) return;

    DeviceMemoryBarrierWithGroupSync();
    SigmaN4PublishLoadStageState(threadIndex);
    uint canonicalCount = _NativeCounters[2u].w;
    uint componentCount = _NativeCounters[1u].x;
    uint oldExtent;
    SigmaN4PublishPrepareRefinementCandidates(threadIndex, oldExtent);
    if (threadIndex == 0u)
    {
        _NativeCounters[3u].x = canonicalCount;
        _NativeCounters[3u].z = 0u;
        _NativeCounters[1u].x = componentCount;
    }
    SigmaN4PublishStoreStageState(threadIndex);
}

[numthreads(256, 1, 1)]
void PrepareNativeRefinementScan(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint threadIndex = threadId.x;
    SigmaN4PublishBeginWideStage(threadIndex);
    uint oldExtent = _NativeCounters[1u].y;
    if (threadIndex == 0u)
    {
        uint broadcastChildCount = _NativeCounters[1u].w;
        uint childRuns = (broadcastChildCount +
            SIGMA_N4_REFINEMENT_RUN_CAPACITY - 1u) /
            SIGMA_N4_REFINEMENT_RUN_CAPACITY;
        SigmaN4PublishCarry = uint2(broadcastChildCount,
            groupId.x < childRuns ? 1u : 0u);
    }
    GroupMemoryBarrierWithGroupSync();
    uint childCount = SigmaN4PublishCarry.x;
    uint logicalBlocks = (oldExtent + 255u) / 256u;
    uint footprintBlocks = (_NativeCounters[3u].x + 255u) / 256u;
    bool scanBlockActive = groupId.x < max(footprintBlocks,
        childCount == 0u ? 0u : logicalBlocks);
    uint componentPosition = groupId.x * 256u + threadIndex;
    SigmaN4PublishRankComponentAt(componentPosition);
    if (componentPosition < _NativeFootprintCount)
    {
        uint2 componentEntry = _NativeCloseScratch[
            SigmaN4PublishImageAddress(SIGMA_N4_COMPONENT_LIST_IMAGE,
                componentPosition)];
        if (componentEntry.x != SIGMA_N4_INVALID)
            SigmaN4PublishFinalizeComponentSummary(componentEntry.x);
    }
    SigmaN4PublishSortRefinementRun(groupId.x, threadIndex);
    SigmaN4PublishScanRefinementBlock(groupId.x, oldExtent, childCount,
        threadIndex, scanBlockActive);
    SigmaN4PublishFlushWideStage(threadIndex);
    if (threadIndex == 0u)
    {
        uint previous;
        // Counters[2].w carries canonicalCount until this stage closes and is
        // consumed below when the next indirect arguments are built.  The
        // preceding ComponentOrder boundary resets Counters[3].z expressly as
        // this dispatch's completion cursor.
        InterlockedAdd(_NativeCounters[3u].z, 1u, previous);
        SigmaN4PublishLastGroup = previous + 1u == _NativeCounters[2u].x
            ? 1u : 0u;
    }
    GroupMemoryBarrierWithGroupSync();
    if (SigmaN4PublishLastGroup == 0u) return;

    DeviceMemoryBarrierWithGroupSync();
    SigmaN4PublishLoadStageState(threadIndex);
    uint componentCount = _NativeCounters[1u].x;
    SigmaN4PublishFinalizeComponentPrefixes(threadIndex, componentCount);
    SigmaN4PublishFinishRefinementBlockScan(oldExtent, childCount,
        threadIndex);
    if (threadIndex == 0u)
    {
        uint canonicalCount = _NativeCounters[3u].x;
        uint planItems = max(canonicalCount,
            childCount == 0u ? 1u : max(oldExtent, childCount));
        uint planGroups = max(1u, (planItems + 255u) / 256u);
        _NativeCounters[2u] = uint4(planGroups, 1u, 1u, canonicalCount);
        _NativeCounters[3u].x = 0u;
        _NativeCounters[3u].z = 0u;
    }
    SigmaN4PublishStoreStageState(threadIndex);
}

[numthreads(256, 1, 1)]
void PrepareNativeRefinementPlan(
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint3 threadId : SV_GroupThreadID)
{
    uint threadIndex = threadId.x;
    SigmaN4PublishBeginWideStage(threadIndex);
    uint linearIndex = dispatchThreadId.x;
    uint activeCount = _NativeCounters[2u].w;
    uint activeStride = max(activeCount, 1u);
    uint image = linearIndex / activeStride;
    uint position = linearIndex - image * activeStride;
    if (activeCount != 0u)
        SigmaN4PublishMergeCanonicalRunsAt(image, position);
    SigmaN4PublishFlushWideStage(threadIndex);
    if (threadIndex == 0u)
    {
        uint previous;
        InterlockedAdd(_NativeCounters[3u].z, 1u, previous);
        if (previous + 1u == _NativeCounters[2u].x)
        {
            _NativeCounters[3u].z = 0u;
            // The A-D active-support count described the old list. Stage 9
            // rebuilds an exact compact support table for the selected field.
            _NativeCounters[3u].w = 0u;
        }
    }
}

[numthreads(256, 1, 1)]
void PrepareNativeRevision(uint3 dispatchThreadId : SV_DispatchThreadID,
    uint3 threadId : SV_GroupThreadID)
{
    uint threadIndex = threadId.x;
    if (threadIndex == 0u)
    {
        SigmaN4PublishFault = _NativeTargetPageCapacity < 2u ||
            (_NativeTargetPageCapacity & 1u) != 0u
                ? SIGMA_N4_FAULT_PAGE_VALIDATION
                : 0u;
        SigmaN4PublishUnresolved = 0u;
    }
    GroupMemoryBarrierWithGroupSync();
    uint pageRounds = (_NativePagePlanCapacity + 255u) / 256u;
    uint residentPagePlanCapacity = SigmaN4PublishResidentPagePlanCapacity();
    uint componentCount = _NativeCounters[1u].x;
    uint oldExtent = _NativeCounters[1u].y;
    uint refinementCount = _NativeCounters[1u].z;
    uint childCount = _NativeCounters[1u].w;

    uint logical = dispatchThreadId.x;
    if (refinementCount != 0u && logical < oldExtent)
    {
        uint target;
        bool observed;
        bool refined;
        if (!SigmaN4PublishComputeOldTarget(logical, oldExtent, childCount,
                target, observed, refined))
        {
            uint ignored;
            InterlockedOr(SigmaN4PublishFault,
                SIGMA_N4_FAULT_SOURCE_LOCATOR, ignored);
        }
        else if (!observed && !refined && target != logical)
        {
            uint sourceSlot;
            uint sourceSample;
            uint4 sourceCoordinate;
            uint sourceLevel;
            if (!SigmaN4PublishSourceLogical(logical, sourceSlot,
                    sourceSample, sourceCoordinate, sourceLevel) ||
                !SigmaN4PublishAppendRelocation(sourceSlot, sourceSample,
                    target))
            {
                uint ignored;
                InterlockedOr(SigmaN4PublishFault,
                    SIGMA_N4_FAULT_RELOCATION, ignored);
            }
        }
    }

    uint position = dispatchThreadId.x;
    if (position < _NativeCounters[2u].w)
    {
        uint2 entry = _NativeCloseScratch[SigmaN4PublishImageAddress(
            SIGMA_N4_RADIX_WORK_IMAGE, position)];
        if (entry.x != SIGMA_N4_INVALID)
        {
        uint component = entry.y;
        uint2 detail = _NativeCloseScratch[
            SigmaN4PublishComponentAddress(component, 1u)];
        uint2 packCursor = _NativeCloseScratch[
            SigmaN4PublishComponentAddress(component, 7u)];
        // Keep one lexical iteration so fail-closed `continue` exits only this
        // canonical item; workgroup synchronization remains outside the loop.
        [loop]
        for (uint item = 0u; item < 1u; ++item)
        {
            uint footprint = entry.x;
            uint support = SigmaN4PublishSupportLocator(footprint);
            if (support != SIGMA_N4_INVALID)
            {
                uint activeIndex = _NativeCloseScratch[
                    _NativeActiveSupportMarkerScratchOffset + support].x;
                uint activeAddress = SigmaN4PublishActiveSupportAddress(
                    activeIndex, 0u);
                uint2 activeRecord = activeIndex < _NativeCounters[3u].w
                    ? _NativeCloseScratch[activeAddress]
                    : uint2(SIGMA_N4_INVALID, SIGMA_N4_INVALID);
                uint leader = activeRecord.y;
                uint refinement = activeIndex < _NativeCounters[3u].w
                    ? _NativeCloseScratch[activeAddress + 1u].y &
                        SIGMA_N4_REFINEMENT_STATUS_MASK
                    : SIGMA_N4_REFINEMENT_NONE;
                if (refinement == SIGMA_N4_REFINEMENT_UNRESOLVED)
                    continue;
                if (refinement == SIGMA_N4_REFINEMENT_PROVED)
                {
                    if (footprint != leader) continue;
                    bool emitted = true;
                    [loop]
                    for (uint child = 0u; child < 4u; ++child)
                    {
                        uint childTarget;
                        bool targetValid =
                            SigmaN4PublishComputeRefinementChildTarget(
                                activeIndex, child, oldExtent, childCount,
                                childTarget);
                        emitted = targetValid &&
                            SigmaN4PublishAppendRefinementChild(activeIndex,
                                child, childTarget, component) && emitted;
                    }
                    if (!emitted)
                    {
                        uint ignored;
                        InterlockedOr(SigmaN4PublishFault,
                            SIGMA_N4_FAULT_REFINEMENT_APPEND, ignored);
                    }
                    continue;
                }
            }
            uint logical = support == SIGMA_N4_INVALID ? SIGMA_N4_INVALID :
                (support / SIGMA_PAGE_SAMPLE_COUNT / 2u) *
                    SIGMA_PAGE_SAMPLE_COUNT +
                support % SIGMA_PAGE_SAMPLE_COUNT;
            if (support != SIGMA_N4_INVALID && refinementCount != 0u)
            {
                uint target;
                bool observed;
                bool refined;
                if (!SigmaN4PublishComputeOldTarget(logical, oldExtent,
                        childCount, target, observed, refined))
                {
                    InterlockedOr(SigmaN4PublishFault,
                        SIGMA_N4_FAULT_REFINEMENT_MAPPING);
                    continue;
                }
                logical = target;
            }
            if (support == SIGMA_N4_INVALID)
            {
                uint2 componentMeta = _NativeCloseScratch[
                    SigmaN4PublishComponentAddress(component, 0u)];
                uint priorStreamFresh = componentMeta.y == 0u ? 0u :
                    SigmaN4PublishFreshInclusive(componentMeta.y - 1u);
                uint localFresh = SigmaN4PublishFreshInclusive(position) -
                    priorStreamFresh;
                uint componentFresh = _NativeCloseScratch[
                    SigmaN4PublishComponentAddress(component, 8u)].x;
                logical = oldExtent + componentFresh + localFresh - 1u;
            }
            uint page = logical / SIGMA_PAGE_SAMPLE_COUNT;
            uint sample = logical - page * SIGMA_PAGE_SAMPLE_COUNT;
            if (page >= residentPagePlanCapacity) {
                InterlockedOr(SigmaN4PublishFault,
                    SIGMA_N4_FAULT_LOGICAL_PAGE);
                continue;
            }
            uint valid = 1u;
            uint ignored;
            uint level;
            uint4 coordinate = SigmaN4PublishSelectedCoordinate(footprint,
                level, valid);
            bool exactZEmpty = SigmaN4PublishStaticExclusion(footprint);
            if (exactZEmpty)
                InterlockedMax(_NativeCounters[3u].z,
                    SIGMA_NATIVE_COLD_REASON_STATIC_EXCLUSION, ignored);
            if (exactZEmpty && support != SIGMA_N4_INVALID)
            {
                uint supportSlot = support / SIGMA_PAGE_SAMPLE_COUNT;
                uint supportSample = support -
                    supportSlot * SIGMA_PAGE_SAMPLE_COUNT;
                if (!SigmaN4PublishSourceSampleInRange(supportSlot,
                        supportSample))
                    valid = 0u;
                else
                {
                    uint representation = SigmaCarrierRepresentationAddress(
                        supportSlot, supportSample, 0u);
                    uint4 sourcePlan = _NativeSourceCarrierRepresentation[
                        representation + SIGMA_REPRESENTATION_GAUGE_PLAN];
                    coordinate = _NativeSourceCarrierRepresentation[
                        representation +
                            SIGMA_REPRESENTATION_GAUGE_COORDINATE];
                    level = sourcePlan.x;
                    valid &= (sourcePlan.y &
                        SIGMA_NATIVE_GAUGE_CELL_FLAGS_ACTIVE) != 0u ? 1u : 0u;
                }
            }
            if (support == SIGMA_N4_INVALID)
                coordinate.xy = SigmaQ48AddChecked(coordinate.xy,
                    packCursor, valid);
            if (valid == 0u) {
                InterlockedOr(SigmaN4PublishFault,
                    SIGMA_N4_FAULT_SELECTED_COORDINATE);
                continue;
            }
            uint plan = SigmaN4PublishPlanAddress(page, 0u);
            uint2 planSource = _NativeCloseScratch[plan];
            uint2 planTarget = _NativeCloseScratch[plan + 1u];
            bool stateEqual = false;
            bool gaugeEqual = false;
            bool certificateEqual = false;
            if (support != SIGMA_N4_INVALID)
            {
                uint supportSlot = support / SIGMA_PAGE_SAMPLE_COUNT;
                uint supportSample = support -
                    supportSlot * SIGMA_PAGE_SAMPLE_COUNT;
                if (SigmaN4PublishSourceSampleInRange(supportSlot,
                        supportSample))
                    SigmaN4PublishCurrentEqual(footprint, supportSlot,
                        supportSample, coordinate, level, exactZEmpty,
                        stateEqual, gaugeEqual, certificateEqual);
                else
                    InterlockedOr(SigmaN4PublishFault,
                        SIGMA_N4_FAULT_SOURCE_LOCATOR);
            }
            if (stateEqual && gaugeEqual && certificateEqual)
                continue;
            uint flags = SIGMA_NATIVE_DELTA_RESOLVED |
                SIGMA_NATIVE_DELTA_COMMON |
                SIGMA_NATIVE_DELTA_EVIDENCE_RETAINED |
                (!stateEqual ? SIGMA_NATIVE_DELTA_STATE_CHANGED : 0u) |
                (!gaugeEqual ? SIGMA_NATIVE_DELTA_GAUGE_CHANGED : 0u);
            uint certificateOffset = _NativeFootprintCertificateOffset +
                footprint * SIGMA_CERTIFICATE_WORD_COUNT;
            uint mutation;
            InterlockedAdd(_NativeCounters[0u].y, 1u, mutation);
            if (mutation >= _NativeMutationCapacity)
            {
                InterlockedOr(SigmaN4PublishFault,
                    SIGMA_N4_FAULT_MUTATION_CAPACITY);
                continue;
            }
            _NativeStateDeltas[mutation] = SigmaN4PublishBuildDelta(footprint,
                coordinate, uint4(planTarget.x, sample, planTarget.y,
                    planSource.y), flags, certificateOffset, exactZEmpty);
            SigmaNativeGaugeDeltaGpu gauge;
            gauge.Coordinate = coordinate;
            gauge.Prior = 0u;
            if (support != SIGMA_N4_INVALID)
            {
                uint supportSlot = support / SIGMA_PAGE_SAMPLE_COUNT;
                uint supportSample = support -
                    supportSlot * SIGMA_PAGE_SAMPLE_COUNT;
                if (SigmaN4PublishSourceSampleInRange(supportSlot,
                        supportSample))
                    gauge.Prior = _NativeSourceCarrierRepresentation[
                        SigmaCarrierRepresentationAddress(supportSlot,
                            supportSample,
                            SIGMA_REPRESENTATION_GAUGE_PLAN)];
            }
            gauge.Next = uint4(level,
                SIGMA_NATIVE_GAUGE_CELL_FLAGS_ACTIVE |
                SIGMA_NATIVE_GAUGE_CELL_FLAGS_NORMALIZED,
                SIGMA_CHI_FINGERPRINT[0u], SIGMA_KAPPA_FINGERPRINT[0u]);
            gauge.Witness = uint4(detail.x, component,
                _NativeProvenanceReceipt[0], _NativeProvenanceReceipt[1]);
            _NativeGaugeDeltas[mutation] = gauge;
            if (!stateEqual)
                InterlockedAdd(_NativeCounters[0u].x, 1u, ignored);
            if (!gaugeEqual)
                InterlockedAdd(_NativeCounters[3u].y, 1u, ignored);
            if (!certificateEqual)
                InterlockedAdd(_NativeCounters[3u].x, 1u, ignored);
            InterlockedMax(_NativeCloseScratch[plan + 2u].x,
                sample + 1u, ignored);
            uint planFlags = SIGMA_N4_PAGE_PLAN_TOUCHED |
                (!stateEqual ? SIGMA_N4_PAGE_PLAN_STATE_CHANGED : 0u) |
                (!gaugeEqual ? SIGMA_N4_PAGE_PLAN_GAUGE_CHANGED : 0u) |
                (!certificateEqual
                    ? SIGMA_N4_PAGE_PLAN_CERTIFICATE_CHANGED : 0u);
            InterlockedOr(_NativeCloseScratch[plan + 2u].y, planFlags,
                ignored);
            InterlockedMin(_NativeCloseScratch[plan + 3u].x,
                mutation, ignored);
            InterlockedMax(_NativeCloseScratch[plan + 3u].y,
                mutation + 1u, ignored);
        }
        }
    }
    DeviceMemoryBarrier();
    GroupMemoryBarrierWithGroupSync();
    if (threadIndex == 0u)
    {
        uint ignored;
        InterlockedOr(_NativeCounters[0u].z, SigmaN4PublishFault, ignored);
        InterlockedOr(_NativeCounters[0u].w, SigmaN4PublishUnresolved,
            ignored);
        uint previous;
        // Indirect y is 1 on entry and is dead once this dispatch launches.
        // Keep .w immutable as canonicalCount; aliasing it as the completion
        // cursor made every non-empty revision miss its last-group finalizer.
        InterlockedAdd(_NativeCounters[2u].y, 1u, previous);
        SigmaN4PublishLastGroup = previous == _NativeCounters[2u].x
            ? 1u : 0u;
    }
    GroupMemoryBarrierWithGroupSync();
    if (SigmaN4PublishLastGroup == 0u) return;

    DeviceMemoryBarrierWithGroupSync();
    SigmaN4PublishLoadStageState(threadIndex);

    uint componentBlocks = SigmaN4PublishComponentBlockCount(componentCount);
    uint totalFresh = _NativeCloseScratch[SigmaN4PublishImageAddress(
        SIGMA_N4_COMPONENT_LIST_IMAGE, componentBlocks)].x;
    uint targetExtent = oldExtent + totalFresh;
    if (targetExtent < oldExtent)
        InterlockedOr(SigmaN4PublishFault,
            SIGMA_N4_FAULT_LOGICAL_EXTENT);
    [loop]
    for (uint targetPageRound = 0u; targetPageRound < pageRounds;
         ++targetPageRound)
    {
        uint page = targetPageRound * 256u + threadIndex;
        if (page < residentPagePlanCapacity)
        {
            uint plan = SigmaN4PublishPlanAddress(page, 0u);
            uint2 plan2 = _NativeCloseScratch[plan + 2u];
            if (plan2.y != 0u)
            {
                uint pageBegin = page * SIGMA_PAGE_SAMPLE_COUNT;
                plan2.x = targetExtent <= pageBegin ? 0u :
                    min(SIGMA_PAGE_SAMPLE_COUNT, targetExtent - pageBegin);
                _NativeCloseScratch[plan + 2u] = plan2;
            }
        }
    }
    DeviceMemoryBarrierWithGroupSync();

    uint touched = threadIndex < residentPagePlanCapacity &&
        _NativeCloseScratch[SigmaN4PublishPlanAddress(threadIndex, 2u)].y !=
            0u ? 1u : 0u;
    SigmaN4PublishWide[threadIndex] = uint2(touched, touched);
    GroupMemoryBarrierWithGroupSync();
    [loop]
    for (uint touchedScanStride = 1u; touchedScanStride < 256u;
         touchedScanStride <<= 1u)
    {
        uint value = SigmaN4PublishWide[threadIndex].x;
        if (threadIndex >= touchedScanStride)
            value += SigmaN4PublishWide[threadIndex - touchedScanStride].x;
        SigmaN4PublishFlags[threadIndex] = value;
        GroupMemoryBarrierWithGroupSync();
        SigmaN4PublishWide[threadIndex].x =
            SigmaN4PublishFlags[threadIndex];
        GroupMemoryBarrierWithGroupSync();
    }
    uint touchedCount = residentPagePlanCapacity == 0u ? 0u :
        SigmaN4PublishWide[min(residentPagePlanCapacity, 256u) - 1u].x;
    uint2 plan0 = 0u;
    uint2 plan1 = 0u;
    uint2 plan2 = 0u;
    uint2 plan3 = 0u;
    if (threadIndex < residentPagePlanCapacity)
    {
        uint address = SigmaN4PublishPlanAddress(threadIndex, 0u);
        plan0 = _NativeCloseScratch[address];
        plan1 = _NativeCloseScratch[address + 1u];
        plan2 = _NativeCloseScratch[address + 2u];
        plan3 = _NativeCloseScratch[address + 3u];
    }
    GroupMemoryBarrierWithGroupSync();
    if (threadIndex < residentPagePlanCapacity && touched != 0u)
    {
        uint output = SigmaN4PublishWide[threadIndex].x - 1u;
        uint address = SigmaN4PublishPlanAddress(output, 0u);
        _NativeCloseScratch[address] = plan0;
        _NativeCloseScratch[address + 1u] = plan1;
        _NativeCloseScratch[address + 2u] = plan2;
        _NativeCloseScratch[address + 3u] = plan3;
    }
    DeviceMemoryBarrierWithGroupSync();

    if (threadIndex == 0u)
    {
        SigmaNativeFrameGpu frame = _NativeFrames[0u];
        uint extent = targetExtent;
        uint mutationCount = _NativeCounters[0u].y;
        frame.Identity.w = _NativeCounters[3u].z;
        if (SigmaN4PublishUnresolved != 0u)
        {
            frame.Disposition = uint4(
                SIGMA_NATIVE_FRAME_DISPOSITION_UNRESOLVED, 0u, 0u, 0u);
            mutationCount = 0u;
            touchedCount = 0u;
        }
        else if (SigmaN4PublishFault != 0u ||
            extent > SigmaN4PublishLogicalCapacity() ||
            mutationCount > _NativeMutationCapacity)
        {
            uint faultReceipt = SigmaN4PublishFault;
            if (extent > SigmaN4PublishLogicalCapacity())
                faultReceipt |= SIGMA_N4_FAULT_LOGICAL_EXTENT;
            if (mutationCount > _NativeMutationCapacity)
                faultReceipt |= SIGMA_N4_FAULT_MUTATION_CAPACITY;
            frame.Identity.w = SIGMA_NATIVE_COLD_REASON_PAGE_FAULT;
            frame.Disposition = uint4(
                SIGMA_NATIVE_FRAME_DISPOSITION_FAULTED, faultReceipt, 0u,
                SIGMA_NATIVE_COLD_REASON_PAGE_FAULT);
            _NativeCounters[0u].w = 1u;
            _NativeCounters[0u].z = faultReceipt;
            mutationCount = 0u;
            touchedCount = 0u;
        }
        else if (mutationCount == 0u)
        {
            frame.Disposition = uint4(
                SIGMA_NATIVE_FRAME_DISPOSITION_NO_CHANGE, 0u, 0u, 0u);
            _NativeCounters[0u].z = 1u;
            touchedCount = 0u;
        }
        else
            frame.Disposition = uint4(
                SIGMA_NATIVE_FRAME_DISPOSITION_RESOLVED,
                _NativeCounters[0u].x, _NativeCounters[3u].y,
                _NativeCounters[3u].x);
        frame.Publication = uint4(_NativeSourcePublicationRoot[0u],
            touchedCount, extent, mutationCount);
        _NativeFrames[0u] = frame;
        uint copyGroups = max(SIGMA_PAGE_LANE_COUNT,
            SIGMA_PAGE_SAMPLE_COUNT *
                SIGMA_REPRESENTATION_WORDS_PER_SAMPLE) / 256u;
        _NativeCounters[1u] = uint4(copyGroups, touchedCount, 1u,
            touchedCount);
        uint scatterGroups = mutationCount == 0u ? 0u :
            (mutationCount * SIGMA_REPRESENTATION_WORDS_PER_SAMPLE + 255u) /
                256u;
        _NativeCounters[2u] = uint4(scatterGroups,
            scatterGroups == 0u ? 0u : 1u,
            scatterGroups == 0u ? 0u : 1u, mutationCount);
        if (touchedCount == 0u)
            SigmaNativeWriteCompletionFrame(frame,
                _NativeSourcePublicationRoot[0u]);
    }
}

[numthreads(256, 1, 1)]
void PrepareNativePage(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint planIndex = groupId.y;
    if (planIndex >= _NativeCounters[1u].w) return;
    if (planIndex >= SigmaN4PublishResidentPagePlanCapacity())
    {
        if (threadId.x == 0u)
            InterlockedOr(_NativeFrames[0u].Publication.w,
                SIGMA_N4_PUBLICATION_FAULT_TAG |
                SIGMA_N4_FAULT_PAGE_VALIDATION);
        return;
    }
    uint address = SigmaN4PublishPlanAddress(planIndex, 0u);
    uint2 plan0 = _NativeCloseScratch[address];
    uint2 plan1 = _NativeCloseScratch[address + 1u];
    uint2 plan2 = _NativeCloseScratch[address + 2u];
    uint sourceSlot = plan0.y;
    uint targetSlot = plan1.x;
    if (targetSlot >= _NativeTargetPageCapacity)
    {
        if (threadId.x == 0u)
            InterlockedOr(_NativeFrames[0u].Publication.w,
                SIGMA_N4_PUBLICATION_FAULT_TAG |
                SIGMA_N4_FAULT_PAGE_VALIDATION);
        return;
    }
    uint word = groupId.x * 256u + threadId.x;
    if (word < SIGMA_PAGE_LANE_COUNT)
    {
        uint sample = word / SIGMA_FRAME_LANE_COUNT;
        uint2 value = 0u;
        if (sample < plan2.x &&
            SigmaN4PublishSourceSampleInRange(sourceSlot, sample))
            value = _NativeSourceCarrierState[
                sourceSlot * SIGMA_PAGE_LANE_COUNT + word];
        _TargetCarrierState[targetSlot * SIGMA_PAGE_LANE_COUNT + word] = value;
    }
    uint representationWords = SIGMA_PAGE_SAMPLE_COUNT *
        SIGMA_REPRESENTATION_WORDS_PER_SAMPLE;
    if (word < representationWords)
    {
        uint sample = word / SIGMA_REPRESENTATION_WORDS_PER_SAMPLE;
        uint4 value = 0u;
        if (sample < plan2.x &&
            SigmaN4PublishSourceSampleInRange(sourceSlot, sample))
            value = _NativeSourceCarrierRepresentation[
                sourceSlot * representationWords + word];
        _TargetCarrierRepresentation[targetSlot * representationWords + word] =
            value;
    }
}

uint2 SigmaN4PublishDeltaLane(SigmaNativeStateDeltaGpu delta, uint lane)
{
    uint4 pair = lane < 2u ? delta.State01 :
        (lane < 4u ? delta.State23 :
        (lane < 6u ? delta.State45 :
        (lane < 8u ? delta.State67 :
        (lane < 10u ? delta.State89 :
        (lane < 12u ? delta.State1011 :
        (lane < 14u ? delta.State1213 : delta.State1415))))));
    return (lane & 1u) == 0u ? pair.xy : pair.zw;
}

[numthreads(256, 1, 1)]
void ScatterNativeState(uint3 id : SV_DispatchThreadID)
{
    uint mutationCount = _NativeCounters[2u].w;
    uint stateWord = id.x;
    if (stateWord < mutationCount * SIGMA_FRAME_LANE_COUNT)
    {
        uint mutation = stateWord / SIGMA_FRAME_LANE_COUNT;
        uint lane = stateWord - mutation * SIGMA_FRAME_LANE_COUNT;
        SigmaNativeStateDeltaGpu delta = _NativeStateDeltas[mutation];
        bool targetValid = delta.Generation.x < _NativeTargetPageCapacity &&
            delta.Generation.y < SIGMA_PAGE_SAMPLE_COUNT;
        if ((delta.Changed.x & SIGMA_NATIVE_DELTA_STATE_CHANGED) != 0u)
        {
            if (targetValid)
                _TargetCarrierState[
                    delta.Generation.x * SIGMA_PAGE_LANE_COUNT +
                    delta.Generation.y * SIGMA_FRAME_LANE_COUNT + lane] =
                    SigmaN4PublishDeltaLane(delta, lane);
            else
                InterlockedOr(_NativeFrames[0u].Publication.w,
                    SIGMA_N4_PUBLICATION_FAULT_TAG |
                    SIGMA_N4_FAULT_PAGE_VALIDATION);
        }
    }
    uint representationWord = id.x;
    if (representationWord <
        mutationCount * SIGMA_REPRESENTATION_WORDS_PER_SAMPLE)
    {
        uint mutation = representationWord /
            SIGMA_REPRESENTATION_WORDS_PER_SAMPLE;
        uint word = representationWord -
            mutation * SIGMA_REPRESENTATION_WORDS_PER_SAMPLE;
        SigmaNativeStateDeltaGpu delta = _NativeStateDeltas[mutation];
        if (delta.Changed.x != 0u)
        {
            bool targetValid = delta.Generation.x < _NativeTargetPageCapacity &&
                delta.Generation.y < SIGMA_PAGE_SAMPLE_COUNT;
            SigmaNativeGaugeDeltaGpu gauge = _NativeGaugeDeltas[mutation];
            bool gaugeWord = word < SIGMA_REPRESENTATION_CERTIFICATE;
            bool write = gaugeWord
                ? (delta.Changed.x & SIGMA_NATIVE_DELTA_GAUGE_CHANGED) != 0u
                : delta.Changed.w != 0u;
            if (write)
            {
                uint4 value = 0u;
                if (word == SIGMA_REPRESENTATION_GAUGE_COORDINATE)
                    value = gauge.Coordinate;
                else if (word == SIGMA_REPRESENTATION_GAUGE_PLAN)
                    value = gauge.Next;
                else if ((delta.Receipts.x &
                        SIGMA_N4_CERTIFICATE_SOURCE_CARRIER) != 0u)
                    value = _NativeSourceCarrierRepresentation[
                        (delta.Receipts.x &
                            ~SIGMA_N4_CERTIFICATE_SOURCE_CARRIER) + word -
                            SIGMA_REPRESENTATION_CERTIFICATE];
                else if ((delta.Receipts.x &
                        SIGMA_N4_CERTIFICATE_SOURCE_MEET) != 0u)
                {
                    uint valid;
                    value = SigmaN4PublishParentCertificateMeetWord(
                        delta.Witness.w,
                        delta.Receipts.x &
                            ~SIGMA_N4_CERTIFICATE_SOURCE_MEET,
                        word - SIGMA_REPRESENTATION_CERTIFICATE, valid);
                    if (valid == 0u)
                        InterlockedOr(_NativeFrames[0u].Publication.w,
                            SIGMA_N4_PUBLICATION_FAULT_TAG |
                            SIGMA_N4_FAULT_CERTIFICATE_MEET);
                }
                else
                    value = _NativeLocalityCertificateWords[
                        delta.Receipts.x + word -
                            SIGMA_REPRESENTATION_CERTIFICATE];
                if (targetValid)
                    _TargetCarrierRepresentation[
                        SigmaCarrierRepresentationAddress(delta.Generation.x,
                            delta.Generation.y, word)] = value;
                else
                    InterlockedOr(_NativeFrames[0u].Publication.w,
                        SIGMA_N4_PUBLICATION_FAULT_TAG |
                        SIGMA_N4_FAULT_PAGE_VALIDATION);
            }
        }
    }
}

[numthreads(256, 1, 1)]
void CloseAndPublishNativeRevision(uint3 threadId : SV_GroupThreadID)
{
    uint threadIndex = threadId.x;
    if (threadIndex == 0u)
    {
        uint publicationReceipt = _NativeFrames[0u].Publication.w;
        SigmaN4PublishFault =
            (publicationReceipt & SIGMA_N4_PUBLICATION_FAULT_TAG) != 0u
                ? publicationReceipt & SIGMA_N4_PUBLICATION_COUNT_MASK
                : 0u;
        SigmaN4PublishCount = _NativeFrames[0u].Disposition.x;
    }
    GroupMemoryBarrierWithGroupSync();
    if (SigmaN4PublishCount != SIGMA_NATIVE_FRAME_DISPOSITION_RESOLVED)
        return;
    SigmaNativeFrameGpu frame = _NativeFrames[0u];
    frame.Publication.w &= SIGMA_N4_PUBLICATION_COUNT_MASK;
    uint touched = frame.Publication.y;
    [loop]
    for (uint validatePagePlanIndex = threadIndex;
         validatePagePlanIndex < touched; validatePagePlanIndex += 256u)
    {
        uint address = SigmaN4PublishPlanAddress(validatePagePlanIndex, 0u);
        uint2 plan0 = _NativeSourceCarrierState[address];
        uint2 plan1 = _NativeSourceCarrierState[address + 1u];
        uint2 plan2 = _NativeSourceCarrierState[address + 2u];
        uint target = plan1.x;
        uint valid = target < _NativeTargetPageCapacity &&
            plan1.y != 0u && plan2.x <= SIGMA_PAGE_SAMPLE_COUNT ? 1u : 0u;
        [loop]
        for (uint sample = 0u; sample < plan2.x; ++sample)
        {
            uint representation = SigmaCarrierRepresentationAddress(target,
                sample, 0u);
            uint4 gauge = _TargetCarrierRepresentation[representation + 1u];
            uint4 certificate = _TargetCarrierRepresentation[
                representation + SIGMA_REPRESENTATION_CERTIFICATE];
            valid &= (gauge.y & SIGMA_NATIVE_GAUGE_CELL_FLAGS_ACTIVE) != 0u &&
                (certificate.x &
                    SIGMA_NATIVE_CERTIFICATE_FLAGS_VALID) != 0u ? 1u : 0u;
        }
        if (valid == 0u)
            InterlockedOr(SigmaN4PublishFault,
                SIGMA_N4_FAULT_PAGE_VALIDATION);
    }
    GroupMemoryBarrierWithGroupSync();
    if (SigmaN4PublishFault != 0u)
    {
        if (threadIndex == 0u)
        {
            frame.Identity.w = SIGMA_NATIVE_COLD_REASON_PAGE_FAULT;
            frame.Disposition = uint4(
                SIGMA_NATIVE_FRAME_DISPOSITION_FAULTED,
                SigmaN4PublishFault, 0u,
                SIGMA_NATIVE_COLD_REASON_PAGE_FAULT);
            _NativeFrames[0u] = frame;
            SigmaNativeWriteCompletionFrame(frame,
                _NativeSourcePublicationRoot[0u]);
        }
        return;
    }

    [loop]
    for (uint publishPagePlanIndex = threadIndex;
         publishPagePlanIndex < touched; publishPagePlanIndex += 256u)
    {
        uint address = SigmaN4PublishPlanAddress(publishPagePlanIndex, 0u);
        uint2 plan0 = _NativeSourceCarrierState[address];
        uint2 plan1 = _NativeSourceCarrierState[address + 1u];
        uint2 plan2 = _NativeSourceCarrierState[address + 2u];
        SigmaCarrierPageMetaGpu source = (SigmaCarrierPageMetaGpu)0;
        if (plan0.y != SIGMA_N4_INVALID)
            source = _TargetPageMetadata[plan0.y];
        SigmaCarrierPageMetaGpu metadata;
        metadata.pageXLo = plan0.x;
        metadata.pageXHi = 0u;
        metadata.pageYLo = 0u;
        metadata.pageYHi = 0u;
        metadata.generation = plan1.y;
        metadata.revision = _NativeRevision;
        metadata.certificateOffsetLo = 0u;
        metadata.certificateOffsetHi = 0u;
        metadata.certificateCount = plan2.x;
        metadata.flags = SIGMA_PAGE_ALLOCATED | SIGMA_PAGE_PUBLISHED |
            SIGMA_PAGE_DIRTY;
        metadata.gaugeGeneration = source.gaugeGeneration +
            ((plan2.y & SIGMA_N4_PAGE_PLAN_GAUGE_CHANGED) != 0u ? 1u : 0u);
        metadata.certificateGeneration = source.certificateGeneration +
            ((plan2.y & SIGMA_N4_PAGE_PLAN_CERTIFICATE_CHANGED) != 0u
                ? 1u : 0u);
        metadata.representationFlags = SIGMA_REPRESENTATION_HAS_GAUGE |
            SIGMA_REPRESENTATION_HAS_CERTIFICATE;
        metadata.representationFingerprint = SIGMA_CHI_FINGERPRINT[0u] ^
            SIGMA_KAPPA_FINGERPRINT[0u] ^
            SIGMA_CERTIFICATE_FINGERPRINT[0u];
        metadata.activeSampleCount = plan2.x;
        metadata.reserved0 = 0u;
        _TargetPageMetadata[plan1.x] = metadata;
        _TargetDirtyFlags[plan1.x] = 1u;
        _TargetReadoutDirtyFlags[plan1.x] = 1u;
    }
    DeviceMemoryBarrierWithGroupSync();

    if (threadIndex == 0u)
    {
        uint revisionSlot = (_NativeRevision - 1u) & 1u;
        SigmaNativeFieldRevisionGpu revision;
        revision.Identity = uint4(_NativeRevision, frame.Publication.x,
            SIGMA_NATIVE_REVISION_STATE_PUBLISHED, _NativeCalibrationEpoch);
        revision.Changed = uint4(frame.Disposition.y,
            frame.Disposition.z, frame.Disposition.w, touched);
        revision.Evidence = uint4(_NativeProvenanceReceipt[0],
            _NativeProvenanceReceipt[1], _NativeProvenanceReceipt[2],
            _NativeProvenanceReceipt[3]);
        revision.Publication = uint4(touched, frame.Publication.z,
            frame.Publication.w, 0u);
        _NativeRevisions[revisionSlot] = revision;
        uint previous;
        InterlockedExchange(_PublishedRevisionRoot[0u], _NativeRevision,
            previous);
        frame.Disposition.x = SIGMA_NATIVE_FRAME_DISPOSITION_PUBLISHED;
        frame.Publication = uint4(previous, _NativeRevision, touched,
            frame.Publication.z);
        _NativeFrames[0u] = frame;
        SigmaNativeWriteCompletionFrame(frame, _NativeRevision);
    }
}
