// Close is a root-last scalar publication kernel.  Bind its immutable inputs as
// SRVs so the six true mutation targets stay below Quest's eight-UAV limit; do
// not split publication into another dispatch merely to satisfy descriptor
// pressure.
StructuredBuffer<SigmaNativeObservationGpu> _NativePrepareObservations;
StructuredBuffer<uint2> _NativePrepareStates;

// Read aliases keep the observation kernel below Quest's eight-UAV binding
// ceiling without splitting the semantic close into another dispatch.
StructuredBuffer<uint2> _NativeSourceCarrierState;
StructuredBuffer<uint4> _NativeSourceCarrierRepresentation;
StructuredBuffer<SigmaCarrierPageMetaGpu> _NativeSourcePageMetadata;
StructuredBuffer<uint> _NativeSourcePublicationRoot;
