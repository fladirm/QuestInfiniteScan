#define SIGMA_N4_FAULT_SOURCE_LOCATOR 0x00000800u
#define SIGMA_N4_FAULT_REFINEMENT_MAPPING 0x00001000u
#define SIGMA_N4_FAULT_RELOCATION 0x00002000u
