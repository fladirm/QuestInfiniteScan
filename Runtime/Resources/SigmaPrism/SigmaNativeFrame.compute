// N3R fixed NativeCloseCommit frame boundary and root-last publication.
// Work cardinality is carried by workgroups; no kernel is dispatched per page,
// support, relation family, source leaf or S16 lane.
#pragma kernel BuildNativeObservation
#pragma kernel PrepareNativeRevision
#pragma kernel PrepareNativePage
#pragma kernel ScatterNativeState
#pragma kernel CloseAndPublishNativeRevision
#pragma target 5.0

#include "SigmaFrameAbi.hlsl"
#include "SigmaInverseMath.hlsl"
#include "Generated/SigmaGeneratedMerkabaProgram.hlsl"
#include "SigmaPoseConsume.hlsl"

