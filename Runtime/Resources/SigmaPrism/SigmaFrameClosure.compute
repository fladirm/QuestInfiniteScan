#pragma kernel ReduceTargetWindow
#pragma kernel FinalizeReducedTargets
#pragma target 5.0

#include "SigmaFrameAbi.hlsl"
#include "SigmaInverseMath.hlsl"
#include "SigmaGeometryReadout.hlsl"
#include "SigmaStableScan.hlsl"
#include "SigmaTopologyAbi.hlsl"

// Closure is over one coherent observation. Optical neighbours only propose a
// local pending edge; exact depth-cell overlap and valid S16 contact decide it.
// Backing pages appear only after promoted component closure.

#define SIGMA_FRAME_LINK_RIGHT 1u
#define SIGMA_FRAME_LINK_DOWN 2u
#define SIGMA_FRAME_GUARD 16u
#define SIGMA_FRAME_ROOT_BLOCK 256u

static const uint2 SIGMA_FRAME_Q48_ZERO = uint2(0u, 0u);

StructuredBuffer<SigmaFrameCandidateGpu> _FrameCandidates;
StructuredBuffer<SigmaFrameOutcomeGpu> _FrameOutcomes;
StructuredBuffer<uint2> _FrameCandidateStates;
RWStructuredBuffer<SigmaFrameDeltaGpu> _FrameDeltas;
RWStructuredBuffer<uint> _FrameResolvedIndices;
RWStructuredBuffer<uint> _PendingLabels;
RWStructuredBuffer<uint> _PendingLinks;
RWStructuredBuffer<uint> _FrameDeferredFlags;
RWStructuredBuffer<SigmaPendingGaugeGpu> _PendingGauges;
RWStructuredBuffer<uint2> _RootLocalOffsets;
RWStructuredBuffer<uint2> _RootBlockOffsets;
RWStructuredBuffer<uint2> _RootSuperOffsets;
RWStructuredBuffer<uint4> _FrameClosureCounters;
RWStructuredBuffer<uint4> _FrameExtentAllocator;
RWStructuredBuffer<SigmaDirtyEdgeGpu> _FrameDirtyEdges;
RWStructuredBuffer<uint> _FramePageMarks;
RWStructuredBuffer<SigmaFrameDeltaGpu> _FrameTargetScratch;
StructuredBuffer<uint2> _FrameCandidateLower;
StructuredBuffer<uint2> _FrameCandidateUpper;
StructuredBuffer<uint> _FrameCandidateValidity;
RWStructuredBuffer<uint2> _ReducedTargetLower;
RWStructuredBuffer<uint2> _ReducedTargetUpper;
RWStructuredBuffer<uint2> _ReducedTargetGap;
RWStructuredBuffer<uint> _ReducedTargetValidity;
RWStructuredBuffer<uint2> _ReducedTargetStates;

StructuredBuffer<uint2> _CarrierState;
StructuredBuffer<SigmaCarrierPageMetaGpu> _PageMetadata;
StructuredBuffer<uint> _CurrentFlags;

StructuredBuffer<uint2> _DepthLeftLower;
StructuredBuffer<uint2> _DepthLeftUpper;
StructuredBuffer<uint> _DepthLeftValidity;
StructuredBuffer<uint2> _DepthRightLower;
StructuredBuffer<uint2> _DepthRightUpper;
StructuredBuffer<uint> _DepthRightValidity;

RWStructuredBuffer<SigmaCarrierPageMetaGpu> _TargetPageMetadata;

uint2 _FrameResolution;
uint _FrameRevision;
uint _FrameSlot;
uint _FrameFootprintCount;
uint _FrameCandidateCount;
uint4 _FrameSourceKeys;
uint _RootBlockCount;
uint _RootSuperCount;
uint _TargetSegmentIndex;
uint _TargetPageCapacity;
uint _TargetSortCapacity;
uint _SortK;
uint _SortJ;
uint _TargetHeadBlockCount;
uint _TargetHeadSuperCount;
uint _TargetWindowFirst;
uint _TargetWindowCount;
uint _CandidateWindowFirst;
uint _CandidateWindowCount;
uint _ReductionFirstWindow;
uint _FinalizeProposalKind;
uint _CarrierSegmentIndex;
uint _PageCapacity;

groupshared SigmaFrameDeltaGpu FrameTargetSort[256];
groupshared uint2 FrameTargetValueA[256];
groupshared uint2 FrameTargetValueB[256];
groupshared uint2 FrameTargetLower[256];
groupshared uint2 FrameTargetUpper[256];
groupshared uint FrameTargetCellFlags[256];
groupshared uint2 FrameTargetMass[16];
groupshared uint2 FrameTargetMaximumWidth[16];
groupshared uint4 FrameTargetMeta[16];
groupshared uint FrameTargetChanged[16];
groupshared uint FrameTargetFault[16];

SigmaFrameDeltaGpu SigmaFrameEmptyTarget()
{
    SigmaFrameDeltaGpu record;
    record.Coordinate = SIGMA_FRAME_INVALID;
    record.Candidate = SIGMA_FRAME_INVALID;
    record.Evidence = 0u;
    return record;
}

bool SigmaFrameTargetActive(SigmaFrameDeltaGpu record)
{
    return record.Evidence.z != SIGMA_FRAME_PROPOSAL_KIND_NONE &&
        record.Evidence.w < 4u;
}

int SigmaFrameCompareU32(uint left, uint right)
{
    if (left < right)
        return -1;
    if (left > right)
        return 1;
    return 0;
}

int SigmaFrameCompareI64(uint2 left, uint2 right)
{
    if (all(left == right))
        return 0;
    if (SigmaI64Less(left, right))
        return -1;
    return 1;
}

int SigmaFrameCompareTarget(SigmaFrameDeltaGpu left,
    SigmaFrameDeltaGpu right)
{
    bool leftActive = SigmaFrameTargetActive(left);
    bool rightActive = SigmaFrameTargetActive(right);
    if (leftActive != rightActive)
        return leftActive ? -1 : 1;
    if (!leftActive)
        return 0;
    int order = SigmaFrameCompareU32(left.Evidence.z, right.Evidence.z);
    if (order != 0)
        return order;
    order = SigmaFrameCompareI64(left.Coordinate.xy, right.Coordinate.xy);
    if (order != 0)
        return order;
    order = SigmaFrameCompareI64(left.Coordinate.zw, right.Coordinate.zw);
    if (order != 0)
        return order;
    if (left.Evidence.z == SIGMA_FRAME_PROPOSAL_KIND_CURRENT)
    {
        order = SigmaFrameCompareU32(left.Candidate.x, right.Candidate.x);
        if (order != 0)
            return order;
        order = SigmaFrameCompareU32(left.Candidate.y, right.Candidate.y);
        if (order != 0)
            return order;
        order = SigmaFrameCompareU32(left.Candidate.z, right.Candidate.z);
        if (order != 0)
            return order;
        order = SigmaFrameCompareU32(left.Candidate.w, right.Candidate.w);
        if (order != 0)
            return order;
    }
    order = SigmaFrameCompareU32(left.Evidence.x, right.Evidence.x);
    if (order != 0)
        return order;
    return SigmaFrameCompareU32(left.Evidence.w, right.Evidence.w);
}

bool SigmaFrameTargetLess(SigmaFrameDeltaGpu left,
    SigmaFrameDeltaGpu right)
{
    return SigmaFrameCompareTarget(left, right) < 0;
}

bool SigmaFrameSameTarget(SigmaFrameDeltaGpu left,
    SigmaFrameDeltaGpu right)
{
    if (!SigmaFrameTargetActive(left) || !SigmaFrameTargetActive(right) ||
        left.Evidence.z != right.Evidence.z ||
        any(left.Coordinate != right.Coordinate))
        return false;
    if (left.Evidence.z == SIGMA_FRAME_PROPOSAL_KIND_CURRENT)
        return all(left.Candidate == right.Candidate);
    return left.Evidence.x == right.Evidence.x;
}

SigmaQ48Bounds SigmaFrameReductionFullBounds()
{
    SigmaQ48Bounds result;
    result.lo = uint2(0u, 0x80000000u);
    result.hi = uint2(0xffffffffu, 0x7fffffffu);
    return result;
}

bool SigmaFrameSourceMaskIndependent(uint sourceMask)
{
    uint firstKey = 0u;
    [unroll]
    for (uint source = 0u; source < SIGMA_FRAME_SOURCE_COUNT; ++source)
    {
        if ((sourceMask & (1u << source)) == 0u)
            continue;
        uint key = _FrameSourceKeys[source];
        if (key == 0u)
            continue;
        if (firstKey == 0u)
            firstKey = key;
        else if (firstKey != key)
            return true;
    }
    return false;
}

uint2 SigmaFrameTargetTransform(uint base, uint row, inout uint valid)
{
    uint2 sum = SIGMA_FRAME_Q48_ZERO;
    [unroll]
    for (uint lane = 0u; lane < SIGMA_FRAME_LANE_COUNT; ++lane)
    {
        uint2 term = SigmaHadamardSign(row, lane) < 0
            ? SigmaQ48NegateChecked(FrameTargetValueA[base + lane], valid)
            : FrameTargetValueA[base + lane];
        sum = SigmaQ48AddChecked(sum, term, valid);
    }
    return sum;
}

bool SigmaFrameClosureEnabled()
{
    return _SigmaExactBackendGate[0] != 0u;
}

uint SigmaFrameResolved(uint footprint)
{
    return footprint < _FrameFootprintCount
        ? _FrameResolvedIndices[footprint] : SIGMA_FRAME_INVALID;
}

uint SigmaFrameOutcomeFlags(uint candidate)
{
    return candidate < _FrameCandidateCount
        ? _FrameOutcomes[candidate].Classification.x : 0u;
}

bool SigmaFramePendingActive(uint footprint)
{
    uint candidate = SigmaFrameResolved(footprint);
    if (candidate == SIGMA_FRAME_INVALID)
        return false;
    uint kind = _FrameCandidates[candidate].Identity.z;
    uint flags = SigmaFrameOutcomeFlags(candidate);
    return kind != SIGMA_FRAME_PROPOSAL_KIND_CURRENT &&
        (flags & (SIGMA_FRAME_OUTCOME_ACCEPTED |
            SIGMA_FRAME_OUTCOME_PENDING)) != 0u &&
        (flags & (SIGMA_FRAME_OUTCOME_CONFLICT |
            SIGMA_FRAME_OUTCOME_FAULT)) == 0u;
}

uint2 SigmaFrameStateLane(uint footprint, uint lane)
{
    uint candidate = SigmaFrameResolved(footprint);
    return candidate == SIGMA_FRAME_INVALID ? SIGMA_FRAME_Q48_ZERO :
        _FrameCandidateStates[candidate * SIGMA_FRAME_LANE_COUNT + lane];
}

bool SigmaFrameStateHasContact(uint2 state[16], out uint readoutValid)
{
    uint2 geometry[4];
    uint2 projectivePosition[3];
    return SigmaGeometryReadoutExact(state, geometry, projectivePosition,
        readoutValid);
}

bool SigmaFrameDepthBounds(uint footprint, uint coordinate,
    out uint2 lower, out uint2 upper, inout uint valid)
{
    uint address = footprint * SIGMA_FRAME_LANE_COUNT + coordinate;
    bool hasLeft = (_DepthLeftValidity[address] &
        SIGMA_FRAME_CELL_CONSTRAINED) != 0u;
    bool hasRight = (_DepthRightValidity[address] &
        SIGMA_FRAME_CELL_CONSTRAINED) != 0u;
    if (!hasLeft && !hasRight)
    {
        lower = SIGMA_FRAME_Q48_ZERO;
        upper = SIGMA_FRAME_Q48_ZERO;
        return false;
    }
    lower = hasLeft ? _DepthLeftLower[address] : _DepthRightLower[address];
    upper = hasLeft ? _DepthLeftUpper[address] : _DepthRightUpper[address];
    if (hasRight)
    {
        lower = SigmaQ48Max(lower, _DepthRightLower[address]);
        upper = SigmaQ48Min(upper, _DepthRightUpper[address]);
    }
    if (SigmaQ48Less(upper, lower))
        valid = 0u;
    return valid != 0u;
}

bool SigmaFramePendingCompatible(uint leftFootprint, uint rightFootprint)
{
    uint2 left[16];
    uint2 right[16];
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
    {
        left[lane] = SigmaFrameStateLane(leftFootprint, lane);
        right[lane] = SigmaFrameStateLane(rightFootprint, lane);
    }
    uint leftValid;
    uint rightValid;
    if (!SigmaFrameStateHasContact(left, leftValid) ||
        !SigmaFrameStateHasContact(right, rightValid) ||
        leftValid == 0u || rightValid == 0u)
        return false;

    uint valid = 1u;
    [unroll]
    for (uint axis = 0u; axis < 3u; ++axis)
    {
        uint coordinate = SIGMA_GEOMETRY_ROWS[axis + 1u];
        uint2 leftLo;
        uint2 leftHi;
        uint2 rightLo;
        uint2 rightHi;
        if (!SigmaFrameDepthBounds(leftFootprint, coordinate, leftLo, leftHi,
                valid) ||
            !SigmaFrameDepthBounds(rightFootprint, coordinate, rightLo, rightHi,
                valid))
            return false;
        uint2 leftWidth = SigmaQ48SubChecked(leftHi, leftLo, valid);
        uint2 rightWidth = SigmaQ48SubChecked(rightHi, rightLo, valid);
        uint2 tolerance = SigmaQ48Max(leftWidth, rightWidth);
        uint2 gap = SIGMA_FRAME_Q48_ZERO;
        if (SigmaQ48Less(leftHi, rightLo))
            gap = SigmaQ48SubChecked(rightLo, leftHi, valid);
        else if (SigmaQ48Less(rightHi, leftLo))
            gap = SigmaQ48SubChecked(leftLo, rightHi, valid);
        if (valid == 0u || SigmaQ48Less(tolerance, gap))
            return false;
    }
    return true;
}

uint2 SigmaFrameAddU64(uint2 value, uint addend)
{
    uint low = value.x + addend;
    return uint2(low, value.y + (low < value.x ? 1u : 0u));
}

uint SigmaFramePaddedWidth(SigmaPendingGaugeGpu gauge)
{
    uint width = gauge.LocalExtent.z - gauge.LocalExtent.x + 1u +
        2u * SIGMA_FRAME_GUARD;
    return (width + 63u) & ~63u;
}

uint2 SigmaFrameRootCost(uint footprint)
{
    SigmaPendingGaugeGpu gauge = _PendingGauges[footprint];
    bool root = _PendingLabels[footprint] == footprint &&
        gauge.Identity.z != 0u;
    if (!root)
        return uint2(0u, 0u);
    uint paddedWidth = SigmaFramePaddedWidth(gauge);
    uint height = gauge.LocalExtent.w - gauge.LocalExtent.y + 1u +
        2u * SIGMA_FRAME_GUARD;
    uint pageCount = (paddedWidth >> 6u) * ((height + 63u) >> 6u);
    return uint2(paddedWidth, pageCount);
}

[numthreads(256, 1, 1)]
void ClearTargetReduction(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index < _TargetSortCapacity)
    {
        if (index >= _FrameFootprintCount)
            _FrameDeltas[index] = SigmaFrameEmptyTarget();
        _FrameTargetScratch[index] = SigmaFrameEmptyTarget();
    }
    if (index < _FrameFootprintCount)
        _FrameResolvedIndices[index] = 0u;
    if (index < 4u)
        _FrameClosureCounters[index] = 0u;
}

[numthreads(256, 1, 1)]
void SortTargetBlocks(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint lane = threadId.x;
    uint index = groupId.x * 256u + lane;
    if (index < _TargetSortCapacity)
        FrameTargetSort[lane] = _FrameDeltas[index];
    else
        FrameTargetSort[lane] = SigmaFrameEmptyTarget();
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint width = 2u; width <= 256u; width <<= 1u)
    {
        [unroll]
        for (uint stride = width >> 1u; stride != 0u; stride >>= 1u)
        {
            uint partner = lane ^ stride;
            if (partner > lane)
            {
                bool ascending = (index & width) == 0u;
                SigmaFrameDeltaGpu left = FrameTargetSort[lane];
                SigmaFrameDeltaGpu right = FrameTargetSort[partner];
                bool swap = ascending
                    ? SigmaFrameTargetLess(right, left)
                    : SigmaFrameTargetLess(left, right);
                if (swap)
                {
                    FrameTargetSort[lane] = right;
                    FrameTargetSort[partner] = left;
                }
            }
            GroupMemoryBarrierWithGroupSync();
        }
    }
    if (index < _TargetSortCapacity)
        _FrameDeltas[index] = FrameTargetSort[lane];
}

[numthreads(256, 1, 1)]
void MergeTargetStage(uint3 id : SV_DispatchThreadID)
{
    uint leftIndex = id.x;
    if (leftIndex >= _TargetSortCapacity)
        return;
    uint rightIndex = leftIndex ^ _SortJ;
    if (rightIndex <= leftIndex || rightIndex >= _TargetSortCapacity)
        return;
    SigmaFrameDeltaGpu left = _FrameDeltas[leftIndex];
    SigmaFrameDeltaGpu right = _FrameDeltas[rightIndex];
    bool ascending = (leftIndex & _SortK) == 0u;
    bool swap = ascending
        ? SigmaFrameTargetLess(right, left)
        : SigmaFrameTargetLess(left, right);
    if (swap)
    {
        _FrameDeltas[leftIndex] = right;
        _FrameDeltas[rightIndex] = left;
    }
}

[numthreads(256, 1, 1)]
void MergeTargetTails(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint lane = threadId.x;
    uint index = groupId.x * 256u + lane;
    if (index < _TargetSortCapacity)
        FrameTargetSort[lane] = _FrameDeltas[index];
    else
        FrameTargetSort[lane] = SigmaFrameEmptyTarget();
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint stride = 128u; stride != 0u; stride >>= 1u)
    {
        uint partner = lane ^ stride;
        if (partner > lane)
        {
            bool ascending = (index & _SortK) == 0u;
            SigmaFrameDeltaGpu left = FrameTargetSort[lane];
            SigmaFrameDeltaGpu right = FrameTargetSort[partner];
            bool swap = ascending
                ? SigmaFrameTargetLess(right, left)
                : SigmaFrameTargetLess(left, right);
            if (swap)
            {
                FrameTargetSort[lane] = right;
                FrameTargetSort[partner] = left;
            }
        }
        GroupMemoryBarrierWithGroupSync();
    }
    if (index < _TargetSortCapacity)
        _FrameDeltas[index] = FrameTargetSort[lane];
}

[numthreads(256, 1, 1)]
void MarkTargetHeads(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= _FrameFootprintCount)
        return;
    SigmaFrameDeltaGpu record = _FrameDeltas[index];
    bool head = SigmaFrameTargetActive(record) &&
        (index == 0u ||
            !SigmaFrameSameTarget(_FrameDeltas[index - 1u], record));
    _FrameResolvedIndices[index] = head ? 1u : 0u;
}

[numthreads(256, 1, 1)]
void ScanTargetHeads(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint lane = threadId.x;
    uint index = groupId.x * 256u + lane;
    uint value = index < _FrameFootprintCount
        ? _FrameResolvedIndices[index] : 0u;
    uint total;
    uint prefix = SigmaStableExclusiveScan256(lane, value, total);
    if (index < _FrameFootprintCount)
        _RootLocalOffsets[index] = uint2(prefix, 0u);
    if (lane == 0u)
        _RootBlockOffsets[groupId.x] = uint2(total, 0u);
}

[numthreads(256, 1, 1)]
void ScanTargetHeadBlocks(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint lane = threadId.x;
    uint block = groupId.x * 256u + lane;
    uint value = block < _TargetHeadBlockCount
        ? _RootBlockOffsets[block].x : 0u;
    uint total;
    uint prefix = SigmaStableExclusiveScan256(lane, value, total);
    if (block < _TargetHeadBlockCount)
        _RootBlockOffsets[block] = uint2(prefix, 0u);
    if (lane == 0u)
        _RootSuperOffsets[groupId.x] = uint2(total, 0u);
}

[numthreads(256, 1, 1)]
void ScanTargetHeadSupers(uint3 threadId : SV_GroupThreadID)
{
    uint lane = threadId.x;
    uint value = lane < _TargetHeadSuperCount
        ? _RootSuperOffsets[lane].x : 0u;
    uint total;
    uint prefix = SigmaStableExclusiveScan256(lane, value, total);
    if (lane < _TargetHeadSuperCount)
        _RootSuperOffsets[lane] = uint2(prefix, 0u);
    if (lane == 0u)
        _FrameClosureCounters[0].x = total;
}

[numthreads(256, 1, 1)]
void CompactTargetHeads(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= _FrameFootprintCount ||
        _FrameResolvedIndices[index] == 0u)
        return;
    uint block = index >> 8u;
    uint superBlock = block >> 8u;
    uint ordinal = _RootLocalOffsets[index].x +
        _RootBlockOffsets[block].x + _RootSuperOffsets[superBlock].x;
    SigmaFrameDeltaGpu head = SigmaFrameEmptyTarget();
    head.Evidence.x = index;
    _FrameTargetScratch[_TargetSortCapacity + ordinal] = head;
}

[numthreads(16, 1, 1)]
void ReduceTargetWindow(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint coordinate = threadId.x;
    uint ordinal = _TargetWindowFirst + groupId.x;
    uint targetCount = _FrameClosureCounters[0].x;
    if (ordinal >= targetCount ||
        ordinal >= _TargetWindowFirst + _TargetWindowCount)
        return;
    uint localTarget = ordinal - _TargetWindowFirst;
    uint targetAddress = localTarget * SIGMA_FRAME_LANE_COUNT + coordinate;
    SigmaQ48Bounds accumulator = SigmaFrameReductionFullBounds();
    uint cellFlags = 0u;
    uint2 representativeState = SIGMA_FRAME_Q48_ZERO;
    if (_ReductionFirstWindow == 0u)
    {
        accumulator.lo = _ReducedTargetLower[targetAddress];
        accumulator.hi = _ReducedTargetUpper[targetAddress];
        cellFlags = _ReducedTargetValidity[targetAddress];
        representativeState = _ReducedTargetStates[targetAddress];
    }

    uint start =
        _FrameTargetScratch[_TargetSortCapacity + ordinal].Evidence.x;
    SigmaFrameDeltaGpu target = _FrameDeltas[start];
    [loop]
    for (uint cursor = start; cursor < _FrameFootprintCount; ++cursor)
    {
        SigmaFrameDeltaGpu record = _FrameDeltas[cursor];
        if (!SigmaFrameSameTarget(target, record))
            break;
        uint footprint = record.Evidence.x;
        if (footprint < _CandidateWindowFirst ||
            footprint >= _CandidateWindowFirst + _CandidateWindowCount)
            continue;
        uint proposal = record.Evidence.w;
        uint localFootprint = footprint - _CandidateWindowFirst;
        uint candidate = localFootprint * 4u + proposal;
        uint address = candidate * SIGMA_FRAME_LANE_COUNT + coordinate;
        uint incomingFlags = _FrameCandidateValidity[address];
        if ((record.Evidence.y & SIGMA_FRAME_OUTCOME_ACCEPTED) != 0u)
            incomingFlags |= SIGMA_FRAME_CELL_ACCEPTED;
        if ((record.Evidence.y & SIGMA_FRAME_OUTCOME_CONFLICT) != 0u)
            incomingFlags |= SIGMA_FRAME_CELL_CONFLICT;
        if ((record.Evidence.y & SIGMA_FRAME_OUTCOME_FAULT) != 0u)
            incomingFlags |= SIGMA_FRAME_CELL_FAULT;
        if ((incomingFlags & SIGMA_FRAME_CELL_CONSTRAINED) != 0u)
        {
            accumulator.lo = SigmaQ48Max(accumulator.lo,
                _FrameCandidateLower[address]);
            accumulator.hi = SigmaQ48Min(accumulator.hi,
                _FrameCandidateUpper[address]);
        }
        cellFlags |= incomingFlags;
        if (cursor == start)
            representativeState = _FrameCandidateStates[address];
    }
    bool conflict = SigmaQ48Less(accumulator.hi, accumulator.lo);
    if (conflict)
        cellFlags |= SIGMA_FRAME_CELL_CONFLICT;
    uint gapValid = 1u;
    uint2 gap = SIGMA_FRAME_Q48_ZERO;
    if (conflict)
        gap = SigmaQ48SubChecked(accumulator.lo, accumulator.hi, gapValid);
    if (gapValid == 0u)
        cellFlags |= SIGMA_FRAME_CELL_FAULT;
    _ReducedTargetLower[targetAddress] = accumulator.lo;
    _ReducedTargetUpper[targetAddress] = accumulator.hi;
    _ReducedTargetGap[targetAddress] = gap;
    _ReducedTargetValidity[targetAddress] = cellFlags;
    _ReducedTargetStates[targetAddress] = representativeState;
}

[numthreads(256, 1, 1)]
void FinalizeReducedTargets(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint coordinate = threadId.x & 15u;
    uint local = threadId.x >> 4u;
    uint ordinal = _TargetWindowFirst + groupId.x * 16u + local;
    uint flat = local * SIGMA_FRAME_LANE_COUNT + coordinate;
    uint targetCount = _FrameClosureCounters[0].x;
    bool inRange = ordinal < targetCount &&
        ordinal < _TargetWindowFirst + _TargetWindowCount;
    SigmaFrameDeltaGpu record = SigmaFrameEmptyTarget();
    if (inRange)
    {
        uint start =
            _FrameTargetScratch[_TargetSortCapacity + ordinal].Evidence.x;
        record = _FrameDeltas[start];
    }
    uint kind = record.Evidence.z;
    bool process = inRange && kind == _FinalizeProposalKind;
    if (kind == SIGMA_FRAME_PROPOSAL_KIND_CURRENT)
        process = process && record.Candidate.x == _CarrierSegmentIndex &&
            record.Candidate.y < _PageCapacity &&
            record.Candidate.w < SIGMA_PAGE_SAMPLE_COUNT;

    uint localTarget = inRange ? ordinal - _TargetWindowFirst : 0u;
    uint targetAddress = localTarget * SIGMA_FRAME_LANE_COUNT + coordinate;
    uint2 prior = SIGMA_FRAME_Q48_ZERO;
    if (process && kind == SIGMA_FRAME_PROPOSAL_KIND_CURRENT)
    {
        SigmaCarrierPageMetaGpu metadata =
            _PageMetadata[record.Candidate.y];
        bool current = _CurrentFlags[record.Candidate.y] != 0u &&
            metadata.generation == record.Candidate.z &&
            all(uint4(metadata.pageXLo, metadata.pageXHi,
                metadata.pageYLo, metadata.pageYHi) == record.Coordinate);
        process = process && current;
        if (process)
            prior = _CarrierState[record.Candidate.y * SIGMA_PAGE_LANE_COUNT +
                record.Candidate.w * SIGMA_FRAME_LANE_COUNT + coordinate];
    }
    else if (process)
        prior = _ReducedTargetStates[targetAddress];

    if (coordinate == 0u)
    {
        FrameTargetChanged[local] =
            kind == SIGMA_FRAME_PROPOSAL_KIND_NOVEL ? 1u : 0u;
        FrameTargetFault[local] = process ? 0u : 1u;
    }
    FrameTargetValueA[flat] = prior;
    GroupMemoryBarrierWithGroupSync();

    uint valid = process ? 1u : 0u;
    uint2 transformed = valid != 0u
        ? SigmaFrameTargetTransform(flat - coordinate, coordinate, valid)
        : SIGMA_FRAME_Q48_ZERO;
    FrameTargetValueB[flat] = transformed;
    if (coordinate == SIGMA_GEOMETRY_ROWS[0])
        FrameTargetMass[local] = transformed;
    uint2 lower = inRange ? _ReducedTargetLower[targetAddress]
        : SIGMA_FRAME_Q48_ZERO;
    uint2 upper = inRange ? _ReducedTargetUpper[targetAddress]
        : SIGMA_FRAME_Q48_ZERO;
    uint cellFlags = inRange ? _ReducedTargetValidity[targetAddress] : 0u;
    FrameTargetLower[flat] = lower;
    FrameTargetUpper[flat] = upper;
    FrameTargetCellFlags[flat] = cellFlags;
    GroupMemoryBarrierWithGroupSync();

    uint2 mass = FrameTargetMass[local];
    valid &= SigmaQ48Positive(mass) ? 1u : 0u;
    uint2 currentY = valid != 0u
        ? SigmaQ48DivNearestEven(transformed, mass, valid)
        : SIGMA_FRAME_Q48_ZERO;
    FrameTargetValueB[flat] = currentY;
    if (valid == 0u)
        InterlockedOr(FrameTargetFault[local], 2u);
    if (coordinate == 0u)
    {
        uint constrained = 0u;
        uint conflict = 0u;
        uint fault = valid == 0u ? 1u : 0u;
        uint aggregateSourceMask = 0u;
        uint accepted = 0u;
        uint2 maximumWidth = SIGMA_FRAME_Q48_ZERO;
        [unroll]
        for (uint lane = 0u; lane < SIGMA_FRAME_LANE_COUNT; ++lane)
        {
            uint flags = FrameTargetCellFlags[flat + lane];
            bool laneConstrained =
                (flags & SIGMA_FRAME_CELL_CONSTRAINED) != 0u;
            if (laneConstrained)
            {
                constrained |= 1u << lane;
                uint laneSourceMask =
                    (flags >> SIGMA_FRAME_SOURCE_MASK_SHIFT) &
                    ((1u << SIGMA_FRAME_SOURCE_COUNT) - 1u);
                aggregateSourceMask |= laneSourceMask;
                if (!SigmaQ48Less(FrameTargetUpper[flat + lane],
                        FrameTargetLower[flat + lane]))
                {
                    maximumWidth = SigmaQ48Max(maximumWidth,
                        SigmaQ48SubChecked(FrameTargetUpper[flat + lane],
                            FrameTargetLower[flat + lane], valid));
                }
            }
            accepted |= (flags & SIGMA_FRAME_CELL_ACCEPTED) != 0u ? 1u : 0u;
            conflict |= (flags & SIGMA_FRAME_CELL_CONFLICT) != 0u ? 1u : 0u;
            fault |= (flags & SIGMA_FRAME_CELL_FAULT) != 0u ? 1u : 0u;
        }
        uint support = constrained != 0u &&
            SigmaFrameSourceMaskIndependent(aggregateSourceMask) ? 1u : 0u;
        FrameTargetMeta[local] = uint4(constrained, conflict, fault,
            support | (accepted << 1u));
        FrameTargetMaximumWidth[local] = maximumWidth;
        if (fault != 0u)
            InterlockedOr(FrameTargetFault[local], 4u);
    }
    GroupMemoryBarrierWithGroupSync();

    uint constrainedMask = FrameTargetMeta[local].x;
    bool eligible = (FrameTargetMeta[local].w & 2u) != 0u &&
        FrameTargetMeta[local].y == 0u && FrameTargetFault[local] == 0u;
    uint2 targetMass = mass;
    if (eligible && (FrameTargetMeta[local].w & 1u) != 0u)
        targetMass = SigmaQ48Max(targetMass,
            SigmaInformationMassForWidth(FrameTargetMaximumWidth[local], valid));
    uint2 targetY = eligible &&
        (constrainedMask & (1u << coordinate)) != 0u
        ? SigmaProjectiveClamp(currentY, lower, upper)
        : currentY;
    FrameTargetValueB[flat] = targetY;
    GroupMemoryBarrierWithGroupSync();

    uint2 candidateState = prior;
    if (eligible && valid != 0u)
    {
        uint2 inverse = SIGMA_FRAME_Q48_ZERO;
        [unroll]
        for (uint sourceLane = 0u; sourceLane <
            SIGMA_FRAME_LANE_COUNT; ++sourceLane)
        {
            uint2 term = SigmaHadamardSign(coordinate, sourceLane) < 0
                ? SigmaQ48NegateChecked(
                    FrameTargetValueB[flat - coordinate + sourceLane], valid)
                : FrameTargetValueB[flat - coordinate + sourceLane];
            inverse = SigmaQ48AddChecked(inverse, term, valid);
        }
        uint2 projective =
            SigmaQ48ShiftRightNearestEven(inverse, 4u, valid);
        candidateState =
            SigmaQ48MulNearestEven(targetMass, projective, valid);
    }
    _ReducedTargetStates[targetAddress] = candidateState;
    if (!all(candidateState == prior))
        InterlockedOr(FrameTargetChanged[local], 1u);
    if (valid == 0u)
        InterlockedOr(FrameTargetFault[local], 8u);
    GroupMemoryBarrierWithGroupSync();

    if (coordinate == 0u && process)
    {
        uint flags;
        if ((record.Evidence.y & SIGMA_FRAME_OUTCOME_FAULT) != 0u ||
            FrameTargetFault[local] != 0u)
        {
            flags = SIGMA_FRAME_OUTCOME_FAULT;
            InterlockedOr(_FrameClosureCounters[3].x,
                FrameTargetFault[local]);
        }
        else if ((record.Evidence.y & SIGMA_FRAME_OUTCOME_CONFLICT) != 0u ||
            FrameTargetMeta[local].y != 0u)
            flags = SIGMA_FRAME_OUTCOME_CONFLICT;
        else if (!eligible)
            flags = SIGMA_FRAME_OUTCOME_PENDING;
        else
            flags = SIGMA_FRAME_OUTCOME_ACCEPTED |
                (FrameTargetChanged[local] == 0u
                    ? SIGMA_FRAME_OUTCOME_UNCHANGED : 0u);
        record.Evidence.y = flags;
        record.Evidence.w = ordinal;
        _FrameTargetScratch[ordinal] = record;
    }
}

[numthreads(256, 1, 1)]
void ClearFrameClosure(uint3 id : SV_DispatchThreadID)
{
    uint footprint = id.x;
    if (footprint < _FrameFootprintCount)
    {
        bool active = SigmaFrameClosureEnabled() &&
            SigmaFramePendingActive(footprint);
        _PendingLabels[footprint] = active ? footprint : SIGMA_FRAME_INVALID;
        _PendingLinks[footprint] = 0u;
        _FrameDeferredFlags[footprint] = 0u;
        _RootLocalOffsets[footprint] = 0u;
        SigmaPendingGaugeGpu gauge;
        gauge.Identity = uint4(_FrameRevision,
            SIGMA_PENDING_GAUGE_STATE_OPEN, 0u, SIGMA_FRAME_INVALID);
        gauge.Provenance = uint4(footprint, _FrameSlot, 0u, 0u);
        gauge.LocalExtent = uint4(SIGMA_FRAME_INVALID,
            SIGMA_FRAME_INVALID, 0u, 0u);
        _PendingGauges[footprint] = gauge;
        SigmaDirtyEdgeGpu horizontal;
        horizontal.Left = SIGMA_FRAME_INVALID;
        horizontal.Right = SIGMA_FRAME_INVALID;
        horizontal.Closure = uint4(SIGMA_FRAME_CLAIM_KIND_NONE,
            SIGMA_TOPOLOGY_UNSUPPORTED, 0u, 0u);
        _FrameDirtyEdges[footprint * 2u] = horizontal;
        _FrameDirtyEdges[footprint * 2u + 1u] = horizontal;
    }
}

[numthreads(256, 1, 1)]
void ClearFrameClosureStorage(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index < _TargetPageCapacity)
        _FramePageMarks[index] = 0u;
    if (index < _RootBlockCount)
        _RootBlockOffsets[index] = 0u;
    if (index < _RootSuperCount)
        _RootSuperOffsets[index] = 0u;
    if (index < 4u)
        _FrameClosureCounters[index] = 0u;
}

[numthreads(256, 1, 1)]
void BuildPendingEdges(uint3 id : SV_DispatchThreadID)
{
    uint footprint = id.x;
    if (footprint >= _FrameFootprintCount ||
        _PendingLabels[footprint] == SIGMA_FRAME_INVALID)
        return;
    uint x = footprint % _FrameResolution.x;
    uint y = footprint / _FrameResolution.x;
    uint links = 0u;
    if (x + 1u < _FrameResolution.x &&
        _PendingLabels[footprint + 1u] != SIGMA_FRAME_INVALID &&
        SigmaFramePendingCompatible(footprint, footprint + 1u))
    {
        links |= SIGMA_FRAME_LINK_RIGHT;
        InterlockedMin(_PendingLabels[footprint + 1u], footprint);
    }
    if (y + 1u < _FrameResolution.y &&
        _PendingLabels[footprint + _FrameResolution.x] !=
            SIGMA_FRAME_INVALID &&
        SigmaFramePendingCompatible(footprint,
            footprint + _FrameResolution.x))
    {
        links |= SIGMA_FRAME_LINK_DOWN;
        InterlockedMin(_PendingLabels[footprint + _FrameResolution.x],
            footprint);
    }
    _PendingLinks[footprint] = links;
}

[numthreads(256, 1, 1)]
void RelaxPendingLabels(uint3 id : SV_DispatchThreadID)
{
    uint footprint = id.x;
    if (footprint >= _FrameFootprintCount)
        return;
    uint label = _PendingLabels[footprint];
    if (label == SIGMA_FRAME_INVALID)
        return;
    uint x = footprint % _FrameResolution.x;
    uint y = footprint / _FrameResolution.x;
    uint best = label;
    if ((_PendingLinks[footprint] & SIGMA_FRAME_LINK_RIGHT) != 0u)
        best = min(best, _PendingLabels[footprint + 1u]);
    if ((_PendingLinks[footprint] & SIGMA_FRAME_LINK_DOWN) != 0u)
        best = min(best,
            _PendingLabels[footprint + _FrameResolution.x]);
    if (x != 0u &&
        (_PendingLinks[footprint - 1u] & SIGMA_FRAME_LINK_RIGHT) != 0u)
        best = min(best, _PendingLabels[footprint - 1u]);
    if (y != 0u &&
        (_PendingLinks[footprint - _FrameResolution.x] &
            SIGMA_FRAME_LINK_DOWN) != 0u)
        best = min(best,
            _PendingLabels[footprint - _FrameResolution.x]);
    if (label < _FrameFootprintCount)
        best = min(best, _PendingLabels[label]);
    InterlockedMin(_PendingLabels[footprint], best);
}

[numthreads(256, 1, 1)]
void FinalizePendingGauges(uint3 id : SV_DispatchThreadID)
{
    uint footprint = id.x;
    if (footprint >= _FrameFootprintCount)
        return;
    uint root = _PendingLabels[footprint];
    if (root == SIGMA_FRAME_INVALID || root >= _FrameFootprintCount)
        return;
    [loop]
    for (uint step = 0u; step < 18u; ++step)
    {
        uint parent = _PendingLabels[root];
        if (parent == root || parent == SIGMA_FRAME_INVALID)
            break;
        root = parent;
    }
    _PendingLabels[footprint] = root;
    uint x = footprint % _FrameResolution.x;
    uint y = footprint / _FrameResolution.x;
    InterlockedMin(_PendingGauges[root].LocalExtent.x, x);
    InterlockedMin(_PendingGauges[root].LocalExtent.y, y);
    InterlockedMax(_PendingGauges[root].LocalExtent.z, x);
    InterlockedMax(_PendingGauges[root].LocalExtent.w, y);
    uint candidate = SigmaFrameResolved(footprint);
    if ((SigmaFrameOutcomeFlags(candidate) & SIGMA_FRAME_OUTCOME_ACCEPTED) != 0u)
        InterlockedAdd(_PendingGauges[root].Identity.z, 1u);
}

[numthreads(256, 1, 1)]
void ScanPendingRoots(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint lane = threadId.x;
    uint footprint = groupId.x * 256u + lane;
    uint2 cost = footprint < _FrameFootprintCount
        ? SigmaFrameRootCost(footprint) : 0u;
    uint widthTotal;
    uint widthPrefix = SigmaStableExclusiveScan256(lane, cost.x, widthTotal);
    uint pageTotal;
    uint pagePrefix = SigmaStableExclusiveScan256(lane, cost.y, pageTotal);
    if (footprint < _FrameFootprintCount)
        _RootLocalOffsets[footprint] = uint2(widthPrefix, pagePrefix);
    if (lane == 0u)
        _RootBlockOffsets[groupId.x] = uint2(widthTotal, pageTotal);
}

[numthreads(256, 1, 1)]
void ScanPendingRootBlocks(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint lane = threadId.x;
    uint block = groupId.x * 256u + lane;
    uint2 value = block < _RootBlockCount
        ? _RootBlockOffsets[block] : 0u;
    uint widthTotal;
    uint widthPrefix = SigmaStableExclusiveScan256(lane, value.x, widthTotal);
    uint pageTotal;
    uint pagePrefix = SigmaStableExclusiveScan256(lane, value.y, pageTotal);
    if (block < _RootBlockCount)
        _RootBlockOffsets[block] = uint2(widthPrefix, pagePrefix);
    if (lane == 0u)
        _RootSuperOffsets[groupId.x] = uint2(widthTotal, pageTotal);
}

[numthreads(256, 1, 1)]
void ScanPendingRootSupers(uint3 threadId : SV_GroupThreadID)
{
    uint lane = threadId.x;
    uint2 value = lane < _RootSuperCount ? _RootSuperOffsets[lane] : 0u;
    uint widthTotal;
    uint widthPrefix = SigmaStableExclusiveScan256(lane, value.x, widthTotal);
    uint pageTotal;
    uint pagePrefix = SigmaStableExclusiveScan256(lane, value.y, pageTotal);
    if (lane < _RootSuperCount)
        _RootSuperOffsets[lane] = uint2(widthPrefix, pagePrefix);
    if (lane == 0u)
        _FrameClosureCounters[0] = uint4(widthTotal, pageTotal,
            _RootBlockCount, _RootSuperCount);
}

[numthreads(1, 1, 1)]
void ReserveFrameAllocation(uint3 id : SV_DispatchThreadID)
{
    uint4 total = _FrameClosureCounters[0];
    uint4 allocator = _FrameExtentAllocator[0];
    uint requiredPhysical = total.y * 2u;
    bool capacity = requiredPhysical <= _TargetPageCapacity &&
        allocator.z <= _TargetPageCapacity - requiredPhysical;
    _FrameClosureCounters[1] = uint4(allocator.xy, allocator.z, 0u);
    _FrameClosureCounters[2] = uint4(capacity ? 0u : 1u, 0u, 0u, 0u);
    if (!capacity)
        return;
    allocator.xy = SigmaFrameAddU64(allocator.xy, total.x);
    allocator.z += requiredPhysical;
    _FrameExtentAllocator[0] = allocator;
}

[numthreads(256, 1, 1)]
void AllocatePendingRoots(uint3 id : SV_DispatchThreadID)
{
    uint footprint = id.x;
    if (footprint >= _FrameFootprintCount ||
        _PendingLabels[footprint] != footprint ||
        _PendingGauges[footprint].Identity.z == 0u ||
        _FrameClosureCounters[2].x != 0u)
        return;
    uint block = footprint >> 8u;
    uint superBlock = block >> 8u;
    uint2 prefix = _RootLocalOffsets[footprint] +
        _RootBlockOffsets[block] + _RootSuperOffsets[superBlock];
    uint4 frameBase = _FrameClosureCounters[1];
    uint2 componentBase = SigmaFrameAddU64(frameBase.xy, prefix.x);
    uint pageSlotBase = frameBase.z + prefix.y * 2u;
    SigmaPendingGaugeGpu gauge = _PendingGauges[footprint];
    uint paddedWidth = SigmaFramePaddedWidth(gauge);
    uint pageCountX = paddedWidth >> 6u;
    uint height = gauge.LocalExtent.w - gauge.LocalExtent.y + 1u +
        2u * SIGMA_FRAME_GUARD;
    uint pageCountY = (height + 63u) >> 6u;
    uint2 origin = SigmaFrameAddU64(componentBase, SIGMA_FRAME_GUARD);
    gauge.Identity.y = SIGMA_PENDING_GAUGE_STATE_PROMOTED;
    gauge.Identity.w = pageSlotBase;
    gauge.Provenance = uint4(footprint, _FrameSlot, origin);
    _PendingGauges[footprint] = gauge;

    uint2 pageXBase = uint2((componentBase.x >> 6u) |
        (componentBase.y << 26u), componentBase.y >> 6u);
    [loop]
    for (uint pageY = 0u; pageY < pageCountY; ++pageY)
    {
        [loop]
        for (uint pageX = 0u; pageX < pageCountX; ++pageX)
        {
            uint pageOrdinal = pageY * pageCountX + pageX;
            uint slot = pageSlotBase + pageOrdinal * 2u;
            SigmaCarrierPageMetaGpu metadata;
            uint2 pageCoordinateX = SigmaFrameAddU64(pageXBase, pageX);
            metadata.pageXLo = pageCoordinateX.x;
            metadata.pageXHi = pageCoordinateX.y;
            metadata.pageYLo = pageY;
            metadata.pageYHi = 0u;
            metadata.generation = 1u;
            metadata.revision = _FrameRevision;
            metadata.certificateOffsetLo = _FrameSlot;
            metadata.certificateOffsetHi = 0u;
            metadata.certificateCount = gauge.Identity.z;
            metadata.flags = SIGMA_PAGE_ALLOCATED | SIGMA_PAGE_DIRTY;
            metadata.reserved0 = SIGMA_FRAME_INVALID;
            metadata.reserved1 = footprint;
            _TargetPageMetadata[slot] = metadata;
            _FramePageMarks[slot] = _FrameRevision;
        }
    }
}

[numthreads(256, 1, 1)]
void ResolveFrameTargets(uint3 id : SV_DispatchThreadID)
{
    uint footprint = id.x;
    if (footprint >= _FrameFootprintCount)
        return;
    uint candidateIndex = SigmaFrameResolved(footprint);
    if (candidateIndex == SIGMA_FRAME_INVALID)
        return;
    SigmaFrameCandidateGpu candidate = _FrameCandidates[candidateIndex];
    SigmaFrameDeltaGpu delta = _FrameDeltas[footprint];
    if (candidate.Identity.z == SIGMA_FRAME_PROPOSAL_KIND_CURRENT)
    {
        uint sourceSlot = candidate.Handle.y;
        uint targetSlot = sourceSlot ^ 1u;
        if (targetSlot >= _TargetPageCapacity)
        {
            _FrameDeferredFlags[footprint] = 1u;
            InterlockedOr(_FrameClosureCounters[2].x, 1u);
            return;
        }
        uint original;
        InterlockedCompareExchange(_FramePageMarks[targetSlot], 0u,
            _FrameRevision, original);
        if (original == 0u)
        {
            SigmaCarrierPageMetaGpu metadata =
                _TargetPageMetadata[sourceSlot];
            metadata.generation++;
            metadata.revision = _FrameRevision;
            metadata.flags = SIGMA_PAGE_ALLOCATED | SIGMA_PAGE_DIRTY;
            metadata.reserved0 = sourceSlot;
            _TargetPageMetadata[targetSlot] = metadata;
        }
        delta.Candidate = uint4(targetSlot, candidate.Handle.z + 1u,
            _TargetSegmentIndex, candidateIndex);
    }
    else
    {
        uint root = _PendingLabels[footprint];
        if (root == SIGMA_FRAME_INVALID || root >= _FrameFootprintCount)
            return;
        SigmaPendingGaugeGpu gauge = _PendingGauges[root];
        if (gauge.Identity.y != SIGMA_PENDING_GAUGE_STATE_PROMOTED)
            return;
        uint localX = footprint % _FrameResolution.x;
        uint localY = footprint / _FrameResolution.x;
        uint offsetX = localX - gauge.LocalExtent.x + SIGMA_FRAME_GUARD;
        uint offsetY = localY - gauge.LocalExtent.y + SIGMA_FRAME_GUARD;
        uint pageCountX = SigmaFramePaddedWidth(gauge) >> 6u;
        uint pageOrdinal = (offsetY >> 6u) * pageCountX + (offsetX >> 6u);
        uint targetSlot = gauge.Identity.w + pageOrdinal * 2u;
        SigmaCarrierPageMetaGpu metadata = _TargetPageMetadata[targetSlot];
        delta.Coordinate = uint4(metadata.pageXLo, metadata.pageXHi,
            metadata.pageYLo, metadata.pageYHi);
        delta.Candidate = uint4(targetSlot, metadata.generation,
            _TargetSegmentIndex, candidateIndex);
        delta.Evidence.w = (offsetY & 63u) * 64u + (offsetX & 63u);
    }
    _FrameDeltas[footprint] = delta;
}

[numthreads(256, 1, 1)]
void BuildDirtyEdges(uint3 id : SV_DispatchThreadID)
{
    uint footprint = id.x;
    if (footprint >= _FrameFootprintCount)
        return;
    SigmaFrameDeltaGpu left = _FrameDeltas[footprint];
    if (left.Candidate.x == SIGMA_FRAME_INVALID ||
        _FrameDeferredFlags[footprint] != 0u)
        return;
    uint x = footprint % _FrameResolution.x;
    uint y = footprint / _FrameResolution.x;
    [unroll]
    for (uint direction = 0u; direction < 2u; ++direction)
    {
        bool inside = direction == 0u
            ? x + 1u < _FrameResolution.x
            : y + 1u < _FrameResolution.y;
        uint neighbour = direction == 0u
            ? footprint + 1u : footprint + _FrameResolution.x;
        if (!inside || neighbour >= _FrameFootprintCount)
            continue;
        SigmaFrameDeltaGpu right = _FrameDeltas[neighbour];
        if (right.Candidate.x == SIGMA_FRAME_INVALID ||
            _FrameDeferredFlags[neighbour] != 0u)
            continue;
        bool samePending = _PendingLabels[footprint] != SIGMA_FRAME_INVALID &&
            _PendingLabels[footprint] == _PendingLabels[neighbour];
        bool bothCurrent = _FrameCandidates[left.Candidate.w].Identity.z ==
                SIGMA_FRAME_PROPOSAL_KIND_CURRENT &&
            _FrameCandidates[right.Candidate.w].Identity.z ==
                SIGMA_FRAME_PROPOSAL_KIND_CURRENT;
        if (!samePending && !bothCurrent)
            continue;
        SigmaDirtyEdgeGpu edge;
        edge.Left = left.Coordinate;
        edge.Right = right.Coordinate;
        edge.Closure = uint4(SIGMA_FRAME_CLAIM_KIND_CONTACT,
            SIGMA_TOPOLOGY_UNRESOLVED, left.Evidence.w, right.Evidence.w);
        _FrameDirtyEdges[footprint * 2u + direction] = edge;
        InterlockedAdd(_FrameClosureCounters[2].y, 1u);
    }
}
