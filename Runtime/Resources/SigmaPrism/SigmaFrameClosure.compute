#pragma kernel ClearFrameClosure
#pragma kernel ClearFrameClosureStorage
#pragma kernel BuildPendingEdges
#pragma kernel RelaxPendingLabels
#pragma kernel FinalizePendingGauges
#pragma kernel ScanPendingRoots
#pragma kernel ScanPendingRootBlocks
#pragma kernel ScanPendingRootSupers
#pragma kernel ReserveFrameAllocation
#pragma kernel AllocatePendingRoots
#pragma kernel ResolveFrameTargets
#pragma kernel BuildDirtyEdges
#pragma kernel ClearTargetReduction
#pragma kernel SortTargetBlocks
#pragma kernel MergeTargetStage
#pragma kernel MergeTargetTails
#pragma kernel MarkTargetHeads
#pragma kernel ScanTargetHeads
#pragma kernel ScanTargetHeadBlocks
#pragma kernel ScanTargetHeadSupers
