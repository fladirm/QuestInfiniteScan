#include "SigmaTopologyAbi.hlsl"
#include "SigmaTopologyMath.hlsl"

// One coherent observation reduces to unique canonical/pending targets before
// closure. Optical adjacency only proposes an edge. Exact S16 state and retained
// source qualification decide it; page, dispatch and image partitions own no
// physical identity.

static const uint2 SIGMA_FRAME_Q48_ZERO = uint2(0u, 0u);

RWStructuredBuffer<SigmaFrameDeltaGpu> _FrameDeltas;
RWStructuredBuffer<uint> _FrameResolvedIndices;
RWStructuredBuffer<uint> _PendingReusableSlots;
RWStructuredBuffer<uint> _PendingLabels;
RWStructuredBuffer<uint> _PendingLinks;
RWStructuredBuffer<uint> _FrameDeferredFlags;
RWStructuredBuffer<SigmaPendingGaugeGpu> _PendingGauges;
RWStructuredBuffer<uint2> _PendingStates;
RWStructuredBuffer<uint2> _PendingLower;
RWStructuredBuffer<uint2> _PendingUpper;
RWStructuredBuffer<uint> _PendingValidity;
RWStructuredBuffer<uint4> _PendingControl;
StructuredBuffer<SigmaPendingGaugeGpu> _PendingGaugesRead;
StructuredBuffer<uint2> _PendingStatesRead;
StructuredBuffer<uint4> _PendingControlRead;
RWStructuredBuffer<uint2> _RootLocalOffsets;
RWStructuredBuffer<uint2> _RootBlockOffsets;
RWStructuredBuffer<uint2> _RootSuperOffsets;
RWStructuredBuffer<uint4> _FrameClosureCounters;
StructuredBuffer<uint4> _FrameClosureCountersRead;
RWStructuredBuffer<SigmaDirtyEdgeGpu> _FrameDirtyEdges;
RWStructuredBuffer<SigmaFrameDeltaGpu> _FrameTargetScratch;
StructuredBuffer<uint2> _FrameCandidateLower;
StructuredBuffer<uint2> _FrameCandidateUpper;
StructuredBuffer<uint> _FrameCandidateValidity;
StructuredBuffer<uint2> _FrameCandidateStates;
RWStructuredBuffer<uint2> _FrameEdgeLower;
RWStructuredBuffer<uint2> _FrameEdgeUpper;
RWStructuredBuffer<uint> _FrameEdgeValidity;
RWStructuredBuffer<uint2> _FrameEdgeStates;
RWStructuredBuffer<uint2> _ReducedTargetLower;
RWStructuredBuffer<uint2> _ReducedTargetUpper;
RWStructuredBuffer<uint2> _ReducedTargetGap;
RWStructuredBuffer<uint> _ReducedTargetValidity;
RWStructuredBuffer<uint2> _ReducedTargetStates;
StructuredBuffer<uint2> _ReducedTargetLowerRead;
StructuredBuffer<uint2> _ReducedTargetUpperRead;
StructuredBuffer<uint> _ReducedTargetValidityRead;
StructuredBuffer<uint2> _ReducedTargetStatesRead;

StructuredBuffer<uint2> _CarrierState;
StructuredBuffer<SigmaCarrierPageMetaGpu> _PageMetadata;
StructuredBuffer<uint> _PublishedRevisionRoot;

uint2 _FrameResolution;
uint _FrameRevision;
uint _FrameSlot;
uint _FrameFootprintCount;
uint4 _FrameSourceKeys;
uint _TargetSortCapacity;
uint _SortK;
uint _SortJ;
uint _TargetHeadBlockCount;
uint _TargetHeadSuperCount;
uint _TargetWindowFirst;
uint _TargetWindowCount;
uint _CandidateWindowFirst;
uint _CandidateWindowCount;
uint _ReductionFirstWindow;
uint _FinalizeProposalKind;
uint _CarrierSegmentIndex;
uint _PageCapacity;
uint _EdgeFirstFootprint;
uint _EdgeFootprintCount;
uint _SingularShift;
uint _AssociatorShift;
uint _PendingCapacity;
uint _PendingFirst;
uint _PendingCount;
uint _LinearDispatchGroupsX;

groupshared SigmaFrameDeltaGpu FrameTargetSort[256];
groupshared uint2 FrameTargetValueA[256];
groupshared uint2 FrameTargetValueB[256];
groupshared uint2 FrameTargetLower[256];
groupshared uint2 FrameTargetUpper[256];
groupshared uint FrameTargetCellFlags[256];
groupshared uint2 FrameTargetMass[16];
groupshared uint2 FrameTargetMaximumWidth[16];
groupshared uint4 FrameTargetMeta[16];
groupshared uint FrameTargetChanged[16];
groupshared uint FrameTargetFault[16];
groupshared uint2 FrameEdgeLeft[16];
groupshared uint2 FrameEdgeRight[16];
groupshared uint2 FrameEdgeDown[16];
groupshared uint2 FrameEdgeTau[16];
groupshared uint2 FrameEdgeDeltaU[16];
groupshared uint2 FrameEdgeDeltaV[16];
groupshared uint2 FrameEdgeProductAB[16];
groupshared uint2 FrameEdgeProductBC[16];
groupshared uint2 FrameEdgeLeftBracket[16];
groupshared uint2 FrameEdgeRightBracket[16];
groupshared uint4 FrameEdgeError[256];
groupshared uint FrameEdgeId[256];
groupshared uint4 FrameEdgeMeta[2];

SigmaFrameDeltaGpu SigmaFrameEmptyTarget()
{
    SigmaFrameDeltaGpu record;
    record.Coordinate = SIGMA_FRAME_INVALID;
    record.Candidate = SIGMA_FRAME_INVALID;
    record.Evidence = 0u;
    return record;
}
bool SigmaFrameTargetActive(SigmaFrameDeltaGpu record)
{
    return record.Evidence.z != SIGMA_FRAME_PROPOSAL_KIND_NONE &&
        record.Evidence.w < 4u;
}

int SigmaFrameCompareU32(uint left, uint right)
{
    if (left < right)
        return -1;
    if (left > right)
        return 1;
    return 0;
}

int SigmaFrameCompareI64(uint2 left, uint2 right)
{
    if (all(left == right))
        return 0;
    if (SigmaI64Less(left, right))
        return -1;
    return 1;
}

int SigmaFrameCompareTarget(SigmaFrameDeltaGpu left,
    SigmaFrameDeltaGpu right)
{
    bool leftActive = SigmaFrameTargetActive(left);
    bool rightActive = SigmaFrameTargetActive(right);
    if (leftActive != rightActive)
        return leftActive ? -1 : 1;
    if (!leftActive)
        return 0;
    int order = SigmaFrameCompareU32(left.Evidence.z, right.Evidence.z);
    if (order != 0)
        return order;
    order = SigmaFrameCompareI64(left.Coordinate.xy, right.Coordinate.xy);
    if (order != 0)
        return order;
    order = SigmaFrameCompareI64(left.Coordinate.zw, right.Coordinate.zw);
    if (order != 0)
        return order;
    if (left.Evidence.z == SIGMA_FRAME_PROPOSAL_KIND_CURRENT ||
        left.Evidence.z == SIGMA_FRAME_PROPOSAL_KIND_PENDING)
    {
        order = SigmaFrameCompareU32(left.Candidate.x, right.Candidate.x);
        if (order != 0)
            return order;
        order = SigmaFrameCompareU32(left.Candidate.y, right.Candidate.y);
        if (order != 0)
            return order;
        order = SigmaFrameCompareU32(left.Candidate.z, right.Candidate.z);
        if (order != 0)
            return order;
        order = SigmaFrameCompareU32(left.Candidate.w, right.Candidate.w);
        if (order != 0)
            return order;
    }
    order = SigmaFrameCompareU32(left.Evidence.x, right.Evidence.x);
    if (order != 0)
        return order;
    return SigmaFrameCompareU32(left.Evidence.w, right.Evidence.w);
}

bool SigmaFrameTargetLess(SigmaFrameDeltaGpu left,
    SigmaFrameDeltaGpu right)
{
    return SigmaFrameCompareTarget(left, right) < 0;
}

bool SigmaFrameSameTarget(SigmaFrameDeltaGpu left,
    SigmaFrameDeltaGpu right)
{
    if (!SigmaFrameTargetActive(left) || !SigmaFrameTargetActive(right) ||
        left.Evidence.z != right.Evidence.z ||
        any(left.Coordinate != right.Coordinate))
        return false;
    if (left.Evidence.z == SIGMA_FRAME_PROPOSAL_KIND_CURRENT ||
        left.Evidence.z == SIGMA_FRAME_PROPOSAL_KIND_PENDING)
        return all(left.Candidate == right.Candidate);
    return left.Evidence.x == right.Evidence.x;
}

SigmaQ48Bounds SigmaFrameReductionFullBounds()
{
    SigmaQ48Bounds result;
    result.lo = uint2(0u, 0x80000000u);
    result.hi = uint2(0xffffffffu, 0x7fffffffu);
    return result;
}

bool SigmaFrameSourceMaskIndependent(uint sourceMask)
{
    uint firstKey = 0u;
    [unroll]
    for (uint source = 0u; source < SIGMA_FRAME_SOURCE_COUNT; ++source)
    {
        if ((sourceMask & (1u << source)) == 0u)
            continue;
        uint key = _FrameSourceKeys[source];
        if (key == 0u)
            continue;
        if (firstKey == 0u)
            firstKey = key;
        else if (firstKey != key)
            return true;
    }
    return false;
}

uint2 SigmaFrameTargetTransform(uint base, uint row, inout uint valid)
{
    uint2 sum = SIGMA_FRAME_Q48_ZERO;
    [unroll]
    for (uint lane = 0u; lane < SIGMA_FRAME_LANE_COUNT; ++lane)
    {
        uint2 term = SigmaHadamardSign(row, lane) < 0
            ? SigmaQ48NegateChecked(FrameTargetValueA[base + lane], valid)
            : FrameTargetValueA[base + lane];
        sum = SigmaQ48AddChecked(sum, term, valid);
    }
    return sum;
}


[numthreads(256, 1, 1)]
void ClearTargetReduction(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index < _TargetSortCapacity)
    {
        if (index >= _FrameFootprintCount)
            _FrameDeltas[index] = SigmaFrameEmptyTarget();
        _FrameTargetScratch[index] = SigmaFrameEmptyTarget();
    }
    if (index < _FrameFootprintCount)
        _FrameResolvedIndices[index] = 0u;
    if (index < 4u)
        _FrameClosureCounters[index] = 0u;
}

[numthreads(256, 1, 1)]
void SortTargetBlocks(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint lane = threadId.x;
    uint index = groupId.x * 256u + lane;
    if (index < _TargetSortCapacity)
        FrameTargetSort[lane] = _FrameDeltas[index];
    else
        FrameTargetSort[lane] = SigmaFrameEmptyTarget();
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint width = 2u; width <= 256u; width <<= 1u)
    {
        [unroll]
        for (uint stride = width >> 1u; stride != 0u; stride >>= 1u)
        {
            uint partner = lane ^ stride;
            if (partner > lane)
            {
                bool ascending = (index & width) == 0u;
                SigmaFrameDeltaGpu left = FrameTargetSort[lane];
                SigmaFrameDeltaGpu right = FrameTargetSort[partner];
                bool swap = ascending
                    ? SigmaFrameTargetLess(right, left)
                    : SigmaFrameTargetLess(left, right);
                if (swap)
                {
                    FrameTargetSort[lane] = right;
                    FrameTargetSort[partner] = left;
                }
            }
            GroupMemoryBarrierWithGroupSync();
        }
    }
    if (index < _TargetSortCapacity)
        _FrameDeltas[index] = FrameTargetSort[lane];
}

[numthreads(256, 1, 1)]
void MergeTargetStage(uint3 id : SV_DispatchThreadID)
{
    uint leftIndex = id.x;
    if (leftIndex >= _TargetSortCapacity)
        return;
    uint rightIndex = leftIndex ^ _SortJ;
    if (rightIndex <= leftIndex || rightIndex >= _TargetSortCapacity)
        return;
    SigmaFrameDeltaGpu left = _FrameDeltas[leftIndex];
    SigmaFrameDeltaGpu right = _FrameDeltas[rightIndex];
    bool ascending = (leftIndex & _SortK) == 0u;
    bool swap = ascending
        ? SigmaFrameTargetLess(right, left)
        : SigmaFrameTargetLess(left, right);
    if (swap)
    {
        _FrameDeltas[leftIndex] = right;
        _FrameDeltas[rightIndex] = left;
    }
}

[numthreads(256, 1, 1)]
void MergeTargetTails(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint lane = threadId.x;
    uint index = groupId.x * 256u + lane;
    if (index < _TargetSortCapacity)
        FrameTargetSort[lane] = _FrameDeltas[index];
    else
        FrameTargetSort[lane] = SigmaFrameEmptyTarget();
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint stride = 128u; stride != 0u; stride >>= 1u)
    {
        uint partner = lane ^ stride;
        if (partner > lane)
        {
            bool ascending = (index & _SortK) == 0u;
            SigmaFrameDeltaGpu left = FrameTargetSort[lane];
            SigmaFrameDeltaGpu right = FrameTargetSort[partner];
            bool swap = ascending
                ? SigmaFrameTargetLess(right, left)
                : SigmaFrameTargetLess(left, right);
            if (swap)
            {
                FrameTargetSort[lane] = right;
                FrameTargetSort[partner] = left;
            }
        }
        GroupMemoryBarrierWithGroupSync();
    }
    if (index < _TargetSortCapacity)
        _FrameDeltas[index] = FrameTargetSort[lane];
}

[numthreads(256, 1, 1)]
void MarkTargetHeads(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= _FrameFootprintCount)
        return;
    SigmaFrameDeltaGpu record = _FrameDeltas[index];
    bool head = SigmaFrameTargetActive(record) &&
        (index == 0u ||
            !SigmaFrameSameTarget(_FrameDeltas[index - 1u], record));
    _FrameResolvedIndices[index] = head ? 1u : 0u;
}

[numthreads(256, 1, 1)]
void ScanTargetHeads(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint lane = threadId.x;
    uint index = groupId.x * 256u + lane;
    uint value = index < _FrameFootprintCount
        ? _FrameResolvedIndices[index] : 0u;
    uint total;
    uint prefix = SigmaStableExclusiveScan256(lane, value, total);
    if (index < _FrameFootprintCount)
        _RootLocalOffsets[index] = uint2(prefix, 0u);
    if (lane == 0u)
        _RootBlockOffsets[groupId.x] = uint2(total, 0u);
}

[numthreads(256, 1, 1)]
void ScanTargetHeadBlocks(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint lane = threadId.x;
    uint block = groupId.x * 256u + lane;
    uint value = block < _TargetHeadBlockCount
        ? _RootBlockOffsets[block].x : 0u;
    uint total;
    uint prefix = SigmaStableExclusiveScan256(lane, value, total);
    if (block < _TargetHeadBlockCount)
        _RootBlockOffsets[block] = uint2(prefix, 0u);
    if (lane == 0u)
        _RootSuperOffsets[groupId.x] = uint2(total, 0u);
}

[numthreads(256, 1, 1)]
void ScanTargetHeadSupers(uint3 threadId : SV_GroupThreadID)
{
    uint lane = threadId.x;
    uint value = lane < _TargetHeadSuperCount
        ? _RootSuperOffsets[lane].x : 0u;
    uint total;
    uint prefix = SigmaStableExclusiveScan256(lane, value, total);
    if (lane < _TargetHeadSuperCount)
        _RootSuperOffsets[lane] = uint2(prefix, 0u);
    if (lane == 0u)
        _FrameClosureCounters[0].x = total;
}

[numthreads(256, 1, 1)]
void CompactTargetHeads(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= _FrameFootprintCount ||
        _FrameResolvedIndices[index] == 0u)
        return;
    uint block = index >> 8u;
    uint superBlock = block >> 8u;
    uint ordinal = _RootLocalOffsets[index].x +
        _RootBlockOffsets[block].x + _RootSuperOffsets[superBlock].x;
    SigmaFrameDeltaGpu head = SigmaFrameEmptyTarget();
    head.Evidence.x = index;
    _FrameTargetScratch[_TargetSortCapacity + ordinal] = head;
}


[numthreads(256, 1, 1)]
void MapTargetOrdinals(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= _FrameFootprintCount)
        return;
    SigmaFrameDeltaGpu record = _FrameDeltas[index];
    if (!SigmaFrameTargetActive(record))
        return;
    uint block = index >> 8u;
    uint superBlock = block >> 8u;
    uint prefix = _RootLocalOffsets[index].x +
        _RootBlockOffsets[block].x + _RootSuperOffsets[superBlock].x;
    bool head = index == 0u ||
        !SigmaFrameSameTarget(_FrameDeltas[index - 1u], record);
    uint ordinal = head ? prefix : prefix - 1u;
    if (record.Evidence.x < _FrameFootprintCount)
        _FrameResolvedIndices[record.Evidence.x] = ordinal;
}

[numthreads(16, 1, 1)]
void ReduceTargetWindow(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint coordinate = threadId.x;
    uint linearGroup = groupId.y * _LinearDispatchGroupsX + groupId.x;
    uint ordinal = _TargetWindowFirst + linearGroup;
    uint targetCount = _FrameClosureCounters[0].x;
    if (ordinal >= targetCount ||
        ordinal >= _TargetWindowFirst + _TargetWindowCount)
        return;
    uint localTarget = ordinal - _TargetWindowFirst;
    uint targetAddress = localTarget * SIGMA_FRAME_LANE_COUNT + coordinate;
    SigmaQ48Bounds accumulator = SigmaFrameReductionFullBounds();
    uint cellFlags = 0u;
    uint2 representativeState = SIGMA_FRAME_Q48_ZERO;
    if (_ReductionFirstWindow == 0u)
    {
        accumulator.lo = _ReducedTargetLower[targetAddress];
        accumulator.hi = _ReducedTargetUpper[targetAddress];
        cellFlags = _ReducedTargetValidity[targetAddress];
        representativeState = _ReducedTargetStates[targetAddress];
    }

    uint start =
        _FrameTargetScratch[_TargetSortCapacity + ordinal].Evidence.x;
    SigmaFrameDeltaGpu target = _FrameDeltas[start];
    [loop]
    for (uint cursor = start; cursor < _FrameFootprintCount; ++cursor)
    {
        SigmaFrameDeltaGpu record = _FrameDeltas[cursor];
        if (!SigmaFrameSameTarget(target, record))
            break;
        uint footprint = record.Evidence.x;
        if (footprint < _CandidateWindowFirst ||
            footprint >= _CandidateWindowFirst + _CandidateWindowCount)
            continue;
        uint proposal = record.Evidence.w;
        uint localFootprint = footprint - _CandidateWindowFirst;
        uint candidate = localFootprint * 4u + proposal;
        uint address = candidate * SIGMA_FRAME_LANE_COUNT + coordinate;
        uint incomingFlags = _FrameCandidateValidity[address];
        if ((record.Evidence.y & SIGMA_FRAME_OUTCOME_ACCEPTED) != 0u)
            incomingFlags |= SIGMA_FRAME_CELL_ACCEPTED;
        if ((record.Evidence.y & SIGMA_FRAME_OUTCOME_CONFLICT) != 0u)
            incomingFlags |= SIGMA_FRAME_CELL_CONFLICT;
        if ((record.Evidence.y & SIGMA_FRAME_OUTCOME_FAULT) != 0u)
            incomingFlags |= SIGMA_FRAME_CELL_FAULT;
        if ((incomingFlags & SIGMA_FRAME_CELL_CONSTRAINED) != 0u)
        {
            accumulator.lo = SigmaQ48Max(accumulator.lo,
                _FrameCandidateLower[address]);
            accumulator.hi = SigmaQ48Min(accumulator.hi,
                _FrameCandidateUpper[address]);
        }
        cellFlags |= incomingFlags;
        if (cursor == start)
            representativeState = _FrameCandidateStates[address];
    }
    bool conflict = SigmaQ48Less(accumulator.hi, accumulator.lo);
    if (conflict)
        cellFlags |= SIGMA_FRAME_CELL_CONFLICT;
    uint gapValid = 1u;
    uint2 gap = SIGMA_FRAME_Q48_ZERO;
    if (conflict)
        gap = SigmaQ48SubChecked(accumulator.lo, accumulator.hi, gapValid);
    if (gapValid == 0u)
        cellFlags |= SIGMA_FRAME_CELL_FAULT;
    _ReducedTargetLower[targetAddress] = accumulator.lo;
    _ReducedTargetUpper[targetAddress] = accumulator.hi;
    _ReducedTargetGap[targetAddress] = gap;
    _ReducedTargetValidity[targetAddress] = cellFlags;
    _ReducedTargetStates[targetAddress] = representativeState;
}

[numthreads(256, 1, 1)]
void FinalizeReducedTargets(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint coordinate = threadId.x & 15u;
    uint local = threadId.x >> 4u;
    uint ordinal = _TargetWindowFirst + groupId.x * 16u + local;
    uint flat = local * SIGMA_FRAME_LANE_COUNT + coordinate;
    uint targetCount = _FrameClosureCounters[0].x;
    bool inRange = ordinal < targetCount &&
        ordinal < _TargetWindowFirst + _TargetWindowCount;
    SigmaFrameDeltaGpu record = SigmaFrameEmptyTarget();
    if (inRange)
    {
        uint start =
            _FrameTargetScratch[_TargetSortCapacity + ordinal].Evidence.x;
        record = _FrameDeltas[start];
    }
    uint kind = record.Evidence.z;
    bool process = inRange && kind == _FinalizeProposalKind;
    if (kind == SIGMA_FRAME_PROPOSAL_KIND_CURRENT)
        process = process && record.Candidate.x == _CarrierSegmentIndex &&
            record.Candidate.y < _PageCapacity &&
            record.Candidate.w < SIGMA_PAGE_SAMPLE_COUNT;
    else if (kind == SIGMA_FRAME_PROPOSAL_KIND_PENDING)
    {
        uint4 pendingControl = _PendingControlRead[0u];
        uint pendingHandle = record.Candidate.y;
        process = process &&
            record.Candidate.x == SIGMA_FRAME_TARGET_KIND_PENDING &&
            pendingHandle >= _PendingFirst &&
            pendingHandle < _PendingFirst + _PendingCount &&
            pendingHandle < pendingControl.x &&
            pendingHandle < pendingControl.y &&
            _PendingGaugesRead[pendingHandle - _PendingFirst].Identity.x ==
                record.Candidate.z &&
            (_PendingGaugesRead[pendingHandle - _PendingFirst].Identity.y ==
                SIGMA_PENDING_GAUGE_STATE_OPEN ||
             _PendingGaugesRead[pendingHandle - _PendingFirst].Identity.y ==
                SIGMA_PENDING_GAUGE_STATE_SUPPORTED);
    }

    uint localTarget = inRange ? ordinal - _TargetWindowFirst : 0u;
    uint targetAddress = localTarget * SIGMA_FRAME_LANE_COUNT + coordinate;
    uint2 prior = SIGMA_FRAME_Q48_ZERO;
    if (process && kind == SIGMA_FRAME_PROPOSAL_KIND_CURRENT)
    {
        uint pageSlot = record.Candidate.y;
        SigmaCarrierPageMetaGpu metadata = _PageMetadata[pageSlot];
        uint siblingSlot = pageSlot ^ 1u;
        SigmaCarrierPageMetaGpu sibling = metadata;
        if (siblingSlot < _PageCapacity)
            sibling = _PageMetadata[siblingSlot];
        bool current = SigmaCarrierVisibleAtRoot(metadata, sibling,
                siblingSlot < _PageCapacity, _PublishedRevisionRoot[0u]) &&
            metadata.generation == record.Candidate.z &&
            all(uint4(metadata.pageXLo, metadata.pageXHi,
                metadata.pageYLo, metadata.pageYHi) == record.Coordinate);
        process = process && current;
        if (process)
            prior = _CarrierState[record.Candidate.y * SIGMA_PAGE_LANE_COUNT +
                record.Candidate.w * SIGMA_FRAME_LANE_COUNT + coordinate];
    }
    else if (process && kind == SIGMA_FRAME_PROPOSAL_KIND_PENDING)
    {
        prior = _PendingStatesRead[(record.Candidate.y - _PendingFirst) *
            SIGMA_FRAME_LANE_COUNT + coordinate];
    }
    else if (process)
        prior = _ReducedTargetStates[targetAddress];

    if (coordinate == 0u)
    {
        FrameTargetChanged[local] =
            kind == SIGMA_FRAME_PROPOSAL_KIND_NOVEL ? 1u : 0u;
        FrameTargetFault[local] = process ? 0u : 1u;
    }
    FrameTargetValueA[flat] = prior;
    GroupMemoryBarrierWithGroupSync();

    uint valid = process ? 1u : 0u;
    uint2 transformed = valid != 0u
        ? SigmaFrameTargetTransform(flat - coordinate, coordinate, valid)
        : SIGMA_FRAME_Q48_ZERO;
    FrameTargetValueB[flat] = transformed;
    if (coordinate == SIGMA_GEOMETRY_ROWS[0])
        FrameTargetMass[local] = transformed;
    uint2 lower = inRange ? _ReducedTargetLower[targetAddress]
        : SIGMA_FRAME_Q48_ZERO;
    uint2 upper = inRange ? _ReducedTargetUpper[targetAddress]
        : SIGMA_FRAME_Q48_ZERO;
    uint cellFlags = inRange ? _ReducedTargetValidity[targetAddress] : 0u;
    FrameTargetLower[flat] = lower;
    FrameTargetUpper[flat] = upper;
    FrameTargetCellFlags[flat] = cellFlags;
    GroupMemoryBarrierWithGroupSync();

    uint2 mass = FrameTargetMass[local];
    valid &= SigmaQ48Positive(mass) ? 1u : 0u;
    uint2 currentY = valid != 0u
        ? SigmaQ48DivNearestEven(transformed, mass, valid)
        : SIGMA_FRAME_Q48_ZERO;
    FrameTargetValueB[flat] = currentY;
    if (valid == 0u)
        InterlockedOr(FrameTargetFault[local], 2u);
    if (coordinate == 0u)
    {
        uint constrained = 0u;
        uint conflict = 0u;
        uint fault = valid == 0u ? 1u : 0u;
        uint aggregateSourceMask = 0u;
        uint independent = 0u;
        uint accepted = 0u;
        uint2 maximumWidth = SIGMA_FRAME_Q48_ZERO;
        [unroll]
        for (uint lane = 0u; lane < SIGMA_FRAME_LANE_COUNT; ++lane)
        {
            uint flags = FrameTargetCellFlags[flat + lane];
            bool laneConstrained =
                (flags & SIGMA_FRAME_CELL_CONSTRAINED) != 0u;
            if (laneConstrained)
            {
                constrained |= 1u << lane;
                uint laneSourceMask =
                    (flags >> SIGMA_FRAME_SOURCE_MASK_SHIFT) &
                    ((1u << SIGMA_FRAME_SOURCE_COUNT) - 1u);
                aggregateSourceMask |= laneSourceMask;
                if (!SigmaQ48Less(FrameTargetUpper[flat + lane],
                        FrameTargetLower[flat + lane]))
                {
                    maximumWidth = SigmaQ48Max(maximumWidth,
                        SigmaQ48SubChecked(FrameTargetUpper[flat + lane],
                            FrameTargetLower[flat + lane], valid));
                }
            }
            accepted |= (flags & SIGMA_FRAME_CELL_ACCEPTED) != 0u ? 1u : 0u;
            independent |= (flags & SIGMA_FRAME_CELL_INDEPENDENT) != 0u
                ? 1u << lane : 0u;
            conflict |= (flags & SIGMA_FRAME_CELL_CONFLICT) != 0u ? 1u : 0u;
            fault |= (flags & SIGMA_FRAME_CELL_FAULT) != 0u ? 1u : 0u;
        }
        uint support = constrained != 0u &&
            (SigmaFrameSourceMaskIndependent(aggregateSourceMask) ||
             (independent & constrained) == constrained) ? 1u : 0u;
        FrameTargetMeta[local] = uint4(constrained, conflict, fault,
            support | (accepted << 1u));
        FrameTargetMaximumWidth[local] = maximumWidth;
        if (fault != 0u)
            InterlockedOr(FrameTargetFault[local], 4u);
    }
    GroupMemoryBarrierWithGroupSync();

    uint constrainedMask = FrameTargetMeta[local].x;
    bool eligible = (FrameTargetMeta[local].w & 2u) != 0u &&
        FrameTargetMeta[local].y == 0u && FrameTargetFault[local] == 0u;
    uint2 targetMass = mass;
    if (eligible && (FrameTargetMeta[local].w & 1u) != 0u)
        targetMass = SigmaQ48Max(targetMass,
            SigmaInformationMassForWidth(FrameTargetMaximumWidth[local], valid));
    uint2 targetY = eligible &&
        (constrainedMask & (1u << coordinate)) != 0u
        ? SigmaProjectiveClamp(currentY, lower, upper)
        : currentY;
    FrameTargetValueB[flat] = targetY;
    GroupMemoryBarrierWithGroupSync();

    uint2 candidateState = prior;
    if (eligible && valid != 0u)
    {
        uint2 inverse = SIGMA_FRAME_Q48_ZERO;
        [unroll]
        for (uint sourceLane = 0u; sourceLane <
            SIGMA_FRAME_LANE_COUNT; ++sourceLane)
        {
            uint2 term = SigmaHadamardSign(coordinate, sourceLane) < 0
                ? SigmaQ48NegateChecked(
                    FrameTargetValueB[flat - coordinate + sourceLane], valid)
                : FrameTargetValueB[flat - coordinate + sourceLane];
            inverse = SigmaQ48AddChecked(inverse, term, valid);
        }
        uint2 projective =
            SigmaQ48ShiftRightNearestEven(inverse, 4u, valid);
        candidateState =
            SigmaQ48MulNearestEven(targetMass, projective, valid);
    }
    if (process)
        _ReducedTargetStates[targetAddress] = candidateState;
    if (process && !all(candidateState == prior))
        InterlockedOr(FrameTargetChanged[local], 1u);
    if (valid == 0u)
        InterlockedOr(FrameTargetFault[local], 8u);
    GroupMemoryBarrierWithGroupSync();

    if (coordinate == 0u && process)
    {
        uint flags;
        if ((record.Evidence.y & SIGMA_FRAME_OUTCOME_FAULT) != 0u ||
            FrameTargetFault[local] != 0u)
        {
            flags = SIGMA_FRAME_OUTCOME_FAULT;
            InterlockedOr(_FrameClosureCounters[3].x,
                FrameTargetFault[local]);
        }
        else if ((record.Evidence.y & SIGMA_FRAME_OUTCOME_CONFLICT) != 0u ||
            FrameTargetMeta[local].y != 0u)
            flags = SIGMA_FRAME_OUTCOME_CONFLICT;
        else if (!eligible)
            flags = SIGMA_FRAME_OUTCOME_PENDING;
        else
            flags = SIGMA_FRAME_OUTCOME_ACCEPTED |
                (FrameTargetChanged[local] == 0u
                    ? SIGMA_FRAME_OUTCOME_UNCHANGED : 0u);
        record.Evidence.y = flags;
        record.Evidence.w = ordinal;
        _FrameTargetScratch[ordinal] = record;
    }
}



uint SigmaFrameTargetFlags(uint ordinal)
{
    return ordinal < _FrameClosureCounters[0].x
        ? _FrameTargetScratch[ordinal].Evidence.y : 0u;
}

bool SigmaFrameTargetAccepted(uint ordinal)
{
    uint flags = SigmaFrameTargetFlags(ordinal);
    return (flags & SIGMA_FRAME_OUTCOME_ACCEPTED) != 0u &&
        (flags & (SIGMA_FRAME_OUTCOME_CONFLICT |
            SIGMA_FRAME_OUTCOME_FAULT)) == 0u;
}

bool SigmaFrameTargetViable(uint ordinal)
{
    uint flags = SigmaFrameTargetFlags(ordinal);
    return (flags & (SIGMA_FRAME_OUTCOME_ACCEPTED |
            SIGMA_FRAME_OUTCOME_PENDING)) != 0u &&
        (flags & (SIGMA_FRAME_OUTCOME_CONFLICT |
            SIGMA_FRAME_OUTCOME_FAULT)) == 0u;
}

bool SigmaFrameTargetChanged(uint ordinal)
{
    uint flags = SigmaFrameTargetFlags(ordinal);
    return (flags & SIGMA_FRAME_OUTCOME_ACCEPTED) != 0u &&
        (flags & SIGMA_FRAME_OUTCOME_UNCHANGED) == 0u;
}

bool SigmaFrameTargetPending(uint ordinal)
{
    if (!SigmaFrameTargetViable(ordinal))
        return false;
    uint kind = _FrameTargetScratch[ordinal].Evidence.z;
    return kind != SIGMA_FRAME_PROPOSAL_KIND_CURRENT;
}

uint SigmaFrameSourceMask(uint validityBase)
{
    uint mask = 0u;
    [unroll]
    for (uint lane = 0u; lane < SIGMA_FRAME_LANE_COUNT; ++lane)
    {
        uint flags = _FrameEdgeValidity[validityBase + lane];
        if ((flags & (SIGMA_FRAME_CELL_CONSTRAINED |
                SIGMA_FRAME_CELL_OBSERVED)) ==
            (SIGMA_FRAME_CELL_CONSTRAINED | SIGMA_FRAME_CELL_OBSERVED))
        {
            mask |= (flags >> SIGMA_FRAME_SOURCE_MASK_SHIFT) &
                ((1u << SIGMA_FRAME_SOURCE_COUNT) - 1u);
        }
    }
    return mask;
}

void SigmaFrameSelectKeys(uint sourceMask, out uint key0, out uint key1)
{
    key0 = 0u;
    key1 = 0u;
    [unroll]
    for (uint source = 0u; source < SIGMA_FRAME_SOURCE_COUNT; ++source)
    {
        if ((sourceMask & (1u << source)) == 0u)
            continue;
        uint key = _FrameSourceKeys[source];
        if (key == 0u)
            continue;
        if (key0 == 0u)
            key0 = key;
        else if (key != key0 && key1 == 0u)
            key1 = key;
    }
}

uint SigmaFrameQualifyEdge(uint leftBase, uint rightBase,
    out uint key0, out uint key1)
{
    uint leftMask = SigmaFrameSourceMask(leftBase);
    uint rightMask = SigmaFrameSourceMask(rightBase);
    SigmaFrameSelectKeys(leftMask | rightMask, key0, key1);
    uint endpointFlags = 0u;
    bool observed = true;
    bool intersects = true;
    [unroll]
    for (uint axis = 0u; axis < 3u; ++axis)
    {
        uint coordinate = SIGMA_GEOMETRY_ROWS[axis + 1u];
        uint leftFlags = _FrameEdgeValidity[leftBase + coordinate];
        uint rightFlags = _FrameEdgeValidity[rightBase + coordinate];
        uint required = SIGMA_FRAME_CELL_CONSTRAINED |
            SIGMA_FRAME_CELL_OBSERVED;
        bool axisObserved = (leftFlags & required) == required &&
            (rightFlags & required) == required;
        observed = observed && axisObserved;
        if (axisObserved)
        {
            intersects = intersects &&
                !SigmaQ48Less(_FrameEdgeUpper[leftBase + coordinate],
                    _FrameEdgeLower[rightBase + coordinate]) &&
                !SigmaQ48Less(_FrameEdgeUpper[rightBase + coordinate],
                    _FrameEdgeLower[leftBase + coordinate]);
        }
    }
    [unroll]
    for (uint coordinate = 0u; coordinate < SIGMA_FRAME_LANE_COUNT;
        ++coordinate)
    {
        endpointFlags |= _FrameEdgeValidity[leftBase + coordinate];
        endpointFlags |= _FrameEdgeValidity[rightBase + coordinate];
    }
    if ((endpointFlags &
            (SIGMA_FRAME_CELL_CONFLICT | SIGMA_FRAME_CELL_FAULT)) != 0u)
        return SIGMA_FRAME_CLAIM_KIND_CONFLICT;
    // Geometry source bits are emitted only for inclusive first-hit depth cells.
    // Optical adjacency proposes this check but cannot manufacture the relation.
    if (!observed || !intersects || (leftMask & 3u) == 0u ||
        (rightMask & 3u) == 0u)
        return SIGMA_FRAME_CLAIM_KIND_NONE;
    return SIGMA_FRAME_CLAIM_KIND_CONTACT;
}

uint2 SigmaFrameAssociatorProduct(uint stage, uint outputLane,
    inout uint valid)
{
    uint2 sum = SIGMA_FRAME_Q48_ZERO;
    [loop]
    for (uint leftLane = 0u; leftLane < SIGMA_FRAME_LANE_COUNT; ++leftLane)
    {
        uint rightLane = leftLane ^ outputLane;
        uint2 left;
        uint2 right;
        if (stage == 0u)
        {
            left = FrameEdgeLeft[leftLane];
            right = FrameEdgeDeltaU[rightLane];
        }
        else if (stage == 1u)
        {
            left = FrameEdgeDeltaU[leftLane];
            right = FrameEdgeDeltaV[rightLane];
        }
        else if (stage == 2u)
        {
            left = FrameEdgeProductAB[leftLane];
            right = FrameEdgeDeltaV[rightLane];
        }
        else
        {
            left = FrameEdgeLeft[leftLane];
            right = FrameEdgeProductBC[rightLane];
        }
        uint2 term = SigmaQ48MulNearestEven(left, right, valid);
        if (SigmaMulBasisSign(leftLane, rightLane) < 0)
            term = SigmaQ48NegateChecked(term, valid);
        sum = SigmaQ48AddChecked(sum, term, valid);
    }
    return sum;
}

[numthreads(256, 1, 1)]
void ClearExactClosure(uint3 id : SV_DispatchThreadID)
{
    uint ordinal = id.x;
    uint targetCount = _FrameClosureCounters[0].x;
    if (ordinal < _FrameFootprintCount)
    {
        bool pending = ordinal < targetCount && SigmaFrameTargetPending(ordinal);
        _PendingLabels[ordinal] = pending ? ordinal : SIGMA_FRAME_INVALID;
        _PendingLinks[ordinal] = SIGMA_FRAME_INVALID;
        _FrameDeferredFlags[ordinal] = 0u;
    }
    if (ordinal == 0u)
    {
        uint targetTotal = _FrameClosureCounters[0].x;
        _FrameClosureCounters[0] = uint4(targetTotal, 0u, 0u, 0u);
        _FrameClosureCounters[1] = 0u;
        _FrameClosureCounters[2] = 0u;
        _FrameClosureCounters[3] = 0u;
    }
}

[numthreads(256, 1, 1)]
void BuildPendingEdges(uint3 id : SV_DispatchThreadID)
{
    uint localFootprint = id.x;
    if (localFootprint >= _EdgeFootprintCount)
        return;
    uint footprint = _EdgeFirstFootprint + localFootprint;
    uint2 pixel = uint2(footprint % _FrameResolution.x,
        footprint / _FrameResolution.x);
    uint leftOrdinal = footprint < _FrameFootprintCount
        ? _FrameResolvedIndices[footprint] : SIGMA_FRAME_INVALID;

    [unroll]
    for (uint direction = 0u; direction < 2u; ++direction)
    {
        uint edgeIndex = localFootprint * 2u + direction;
        SigmaDirtyEdgeGpu edge;
        edge.Left = SIGMA_FRAME_INVALID;
        edge.Right = SIGMA_FRAME_INVALID;
        edge.Closure = uint4(SIGMA_FRAME_CLAIM_KIND_NONE,
            SigmaTopologyPack(SIGMA_TOPOLOGY_UNSUPPORTED, 255u, 0u),
            0u, 0u);

        bool inside = direction == 0u
            ? pixel.x + 1u < _FrameResolution.x
            : pixel.y + 1u < _FrameResolution.y;
        uint neighbour = direction == 0u
            ? footprint + 1u : footprint + _FrameResolution.x;
        uint rightOrdinal = inside && neighbour < _FrameFootprintCount
            ? _FrameResolvedIndices[neighbour] : SIGMA_FRAME_INVALID;
        uint targetCount = _FrameClosureCounters[0].x;
        if (leftOrdinal < targetCount && rightOrdinal < targetCount &&
            leftOrdinal != rightOrdinal &&
            SigmaFrameTargetViable(leftOrdinal) &&
            SigmaFrameTargetViable(rightOrdinal))
        {
            uint leftKind =
                _FrameTargetScratch[leftOrdinal].Evidence.z;
            uint rightKind =
                _FrameTargetScratch[rightOrdinal].Evidence.z;
            if (leftKind != SIGMA_FRAME_PROPOSAL_KIND_CURRENT ||
                rightKind != SIGMA_FRAME_PROPOSAL_KIND_CURRENT)
            {
                edge.Left = uint4(leftOrdinal, rightOrdinal,
                    footprint, neighbour);
                edge.Right = uint4(leftKind, rightKind, direction, 0u);
                edge.Closure = uint4(SIGMA_FRAME_CLAIM_KIND_NONE,
                    SigmaTopologyPack(SIGMA_TOPOLOGY_UNRESOLVED, 255u, 0u),
                    0u, 0u);
                InterlockedAdd(_FrameClosureCounters[1].x, 1u);
            }
        }
        _FrameDirtyEdges[edgeIndex] = edge;
    }
}

[numthreads(256, 1, 1)]
void GatherEdgeEndpoints(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint coordinate = threadId.x & 15u;
    uint local = threadId.x >> 4u;
    uint localFootprint = groupId.x * 16u + local;
    if (localFootprint >= _EdgeFootprintCount)
        return;
    [unroll]
    for (uint direction = 0u; direction < 2u; ++direction)
    {
        SigmaDirtyEdgeGpu edge =
            _FrameDirtyEdges[localFootprint * 2u + direction];
        [unroll]
        for (uint endpoint = 0u; endpoint < 2u; ++endpoint)
        {
            uint ordinal = endpoint == 0u ? edge.Left.x : edge.Left.y;
            if (ordinal < _TargetWindowFirst ||
                ordinal >= _TargetWindowFirst + _TargetWindowCount)
                continue;
            uint source = (ordinal - _TargetWindowFirst) *
                SIGMA_FRAME_LANE_COUNT + coordinate;
            uint edgeCandidate = localFootprint * 4u +
                direction * 2u + endpoint;
            uint destination = edgeCandidate * SIGMA_FRAME_LANE_COUNT +
                coordinate;
            _FrameEdgeStates[destination] =
                _ReducedTargetStatesRead[source];
            _FrameEdgeLower[destination] =
                _ReducedTargetLowerRead[source];
            _FrameEdgeUpper[destination] =
                _ReducedTargetUpperRead[source];
            _FrameEdgeValidity[destination] =
                _ReducedTargetValidityRead[source];
        }
    }
}

[numthreads(256, 1, 1)]
void ClosePendingEdges(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint edgeIndex = groupId.y * _LinearDispatchGroupsX + groupId.x;
    uint lane = threadId.x;
    uint localFootprint = edgeIndex >> 1u;
    uint direction = edgeIndex & 1u;
    bool active = localFootprint < _EdgeFootprintCount;
    SigmaDirtyEdgeGpu edge;
    if (active)
        edge = _FrameDirtyEdges[edgeIndex];
    else
    {
        edge.Left = SIGMA_FRAME_INVALID;
        edge.Right = SIGMA_FRAME_INVALID;
        edge.Closure = uint4(SIGMA_FRAME_CLAIM_KIND_NONE,
            SigmaTopologyPack(SIGMA_TOPOLOGY_UNSUPPORTED, 255u, 0u),
            0u, 0u);
    }
    active = active && edge.Left.x != SIGMA_FRAME_INVALID &&
        edge.Left.y != SIGMA_FRAME_INVALID;

    uint leftBase = (localFootprint * 4u + direction * 2u) *
        SIGMA_FRAME_LANE_COUNT;
    uint rightBase = leftBase + SIGMA_FRAME_LANE_COUNT;
    SigmaDirtyEdgeGpu horizontal = edge;
    SigmaDirtyEdgeGpu vertical = edge;
    if (active)
    {
        horizontal = _FrameDirtyEdges[localFootprint * 2u];
        vertical = _FrameDirtyEdges[localFootprint * 2u + 1u];
    }
    bool cellActive = active && horizontal.Left.x != SIGMA_FRAME_INVALID &&
        horizontal.Left.y != SIGMA_FRAME_INVALID &&
        vertical.Left.x != SIGMA_FRAME_INVALID &&
        vertical.Left.y != SIGMA_FRAME_INVALID;
    uint downBase = (localFootprint * 4u + 3u) *
        SIGMA_FRAME_LANE_COUNT;
    if (lane < SIGMA_FRAME_LANE_COUNT)
    {
        FrameEdgeLeft[lane] = active
            ? _FrameEdgeStates[leftBase + lane] : SIGMA_FRAME_Q48_ZERO;
        FrameEdgeRight[lane] = active
            ? _FrameEdgeStates[rightBase + lane] : SIGMA_FRAME_Q48_ZERO;
        FrameEdgeDown[lane] = cellActive
            ? _FrameEdgeStates[downBase + lane] : SIGMA_FRAME_Q48_ZERO;
    }
    GroupMemoryBarrierWithGroupSync();

    if (lane == 0u)
    {
        uint key0 = 0u;
        uint key1 = 0u;
        uint claim = active
            ? SigmaFrameQualifyEdge(leftBase, rightBase, key0, key1)
            : SIGMA_FRAME_CLAIM_KIND_NONE;
        uint horizontalKey0 = 0u;
        uint horizontalKey1 = 0u;
        uint verticalKey0 = 0u;
        uint verticalKey1 = 0u;
        uint horizontalClaim = cellActive
            ? SigmaFrameQualifyEdge(localFootprint * 4u *
                SIGMA_FRAME_LANE_COUNT,
                (localFootprint * 4u + 1u) * SIGMA_FRAME_LANE_COUNT,
                horizontalKey0, horizontalKey1)
            : SIGMA_FRAME_CLAIM_KIND_NONE;
        uint verticalClaim = cellActive
            ? SigmaFrameQualifyEdge((localFootprint * 4u + 2u) *
                SIGMA_FRAME_LANE_COUNT,
                (localFootprint * 4u + 3u) * SIGMA_FRAME_LANE_COUNT,
                verticalKey0, verticalKey1)
            : SIGMA_FRAME_CLAIM_KIND_NONE;
        FrameEdgeMeta[0] = uint4(claim, key0, key1, 1u);
        FrameEdgeMeta[1] = uint4(0u,
            horizontalClaim == SIGMA_FRAME_CLAIM_KIND_CONTACT &&
            verticalClaim == SIGMA_FRAME_CLAIM_KIND_CONTACT ? 1u : 0u,
            0u, 0u);
    }
    GroupMemoryBarrierWithGroupSync();

    uint transitionValid = FrameEdgeMeta[0].x !=
        SIGMA_FRAME_CLAIM_KIND_NONE ? 1u : 0u;
    if (lane < SIGMA_FRAME_LANE_COUNT && transitionValid != 0u)
    {
        uint2 sum = SIGMA_FRAME_Q48_ZERO;
        [unroll]
        for (uint leftLane = 0u; leftLane < SIGMA_FRAME_LANE_COUNT;
            ++leftLane)
        {
            uint rightLane = leftLane ^ lane;
            uint2 left = FrameEdgeLeft[leftLane];
            if (SigmaConjugateSign(leftLane) < 0)
                left = SigmaQ48NegateChecked(left, transitionValid);
            uint2 term = SigmaQ48MulNearestEven(left,
                FrameEdgeRight[rightLane], transitionValid);
            if (SigmaMulBasisSign(leftLane, rightLane) < 0)
                term = SigmaQ48NegateChecked(term, transitionValid);
            sum = SigmaQ48AddChecked(sum, term, transitionValid);
        }
        FrameEdgeTau[lane] = sum;
        FrameEdgeId[lane] = transitionValid;
    }
    else if (lane < SIGMA_FRAME_LANE_COUNT)
    {
        FrameEdgeTau[lane] = SIGMA_FRAME_Q48_ZERO;
        FrameEdgeId[lane] = transitionValid;
    }
    GroupMemoryBarrierWithGroupSync();

    if (lane == 0u)
    {
        uint valid = FrameEdgeMeta[0].w;
        [unroll]
        for (uint coordinate = 0u; coordinate < SIGMA_FRAME_LANE_COUNT;
            ++coordinate)
            valid &= FrameEdgeId[coordinate];
        FrameEdgeMeta[0].w = valid;
    }
    GroupMemoryBarrierWithGroupSync();

    uint actionValid = FrameEdgeMeta[0].w;
    if (lane < SIGMA_ANNIHILATOR_ACTION_COUNT && actionValid != 0u)
    {
        FrameEdgeError[lane] = SigmaRightDyadL1(FrameEdgeTau,
            SIGMA_ANNIHILATOR_ACTIONS[lane], actionValid);
        FrameEdgeId[lane] = actionValid != 0u ? lane : 255u;
        if (actionValid == 0u)
            FrameEdgeError[lane] = SIGMA_U128_MAX;
    }
    else
    {
        FrameEdgeError[lane] = SIGMA_U128_MAX;
        FrameEdgeId[lane] = 255u;
    }
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint stride = 128u; stride != 0u; stride >>= 1u)
    {
        if (lane < stride)
        {
            uint partner = lane + stride;
            bool partnerBetter =
                SigmaU128Less(FrameEdgeError[partner], FrameEdgeError[lane]) ||
                (SigmaU128Equal(FrameEdgeError[partner],
                    FrameEdgeError[lane]) &&
                    FrameEdgeId[partner] < FrameEdgeId[lane]);
            if (partnerBetter)
            {
                FrameEdgeError[lane] = FrameEdgeError[partner];
                FrameEdgeId[lane] = FrameEdgeId[partner];
            }
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if (lane == 0u)
    {
        uint scaleValid = FrameEdgeMeta[0].w;
        uint4 transitionScale = SigmaS16L1(FrameEdgeTau, scaleValid);
        if (SigmaU128Equal(transitionScale, SIGMA_U128_ZERO))
            transitionScale = SIGMA_U128_ONE;
        FrameEdgeError[254u] = transitionScale;
        FrameEdgeMeta[1].x = FrameEdgeId[0];
        FrameEdgeMeta[1].z = scaleValid != 0u &&
            FrameEdgeMeta[1].y != 0u &&
            SigmaRelativeNearGate(FrameEdgeError[0], transitionScale,
                _SingularShift) ? 1u : 0u;
        FrameEdgeMeta[1].w = 0u;
    }
    GroupMemoryBarrierWithGroupSync();

    if (FrameEdgeMeta[1].z != 0u)
    {
        uint associatorValid = FrameEdgeMeta[0].w;
        if (lane < SIGMA_FRAME_LANE_COUNT)
        {
            FrameEdgeDeltaU[lane] = SigmaQ48SubChecked(FrameEdgeRight[lane],
                FrameEdgeLeft[lane], associatorValid);
            FrameEdgeDeltaV[lane] = SigmaQ48SubChecked(FrameEdgeDown[lane],
                FrameEdgeLeft[lane], associatorValid);
            FrameEdgeId[lane] = associatorValid;
        }
        GroupMemoryBarrierWithGroupSync();
        if (lane == 0u)
        {
            uint valid = 1u;
            [unroll]
            for (uint coordinate = 0u; coordinate < SIGMA_FRAME_LANE_COUNT;
                ++coordinate)
                valid &= FrameEdgeId[coordinate];
            FrameEdgeMeta[1].w = valid;
        }
        GroupMemoryBarrierWithGroupSync();

        associatorValid = FrameEdgeMeta[1].w;
        if (lane < SIGMA_FRAME_LANE_COUNT)
        {
            FrameEdgeProductAB[lane] = SigmaFrameAssociatorProduct(0u, lane,
                associatorValid);
            FrameEdgeId[lane] = associatorValid;
        }
        GroupMemoryBarrierWithGroupSync();
        if (lane == 0u)
        {
            uint valid = 1u;
            [unroll]
            for (uint coordinate = 0u; coordinate < SIGMA_FRAME_LANE_COUNT;
                ++coordinate)
                valid &= FrameEdgeId[coordinate];
            FrameEdgeMeta[1].w = valid;
        }
        GroupMemoryBarrierWithGroupSync();

        associatorValid = FrameEdgeMeta[1].w;
        if (lane < SIGMA_FRAME_LANE_COUNT)
        {
            FrameEdgeProductBC[lane] = SigmaFrameAssociatorProduct(1u, lane,
                associatorValid);
            FrameEdgeId[lane] = associatorValid;
        }
        GroupMemoryBarrierWithGroupSync();
        if (lane == 0u)
        {
            uint valid = 1u;
            [unroll]
            for (uint coordinate = 0u; coordinate < SIGMA_FRAME_LANE_COUNT;
                ++coordinate)
                valid &= FrameEdgeId[coordinate];
            FrameEdgeMeta[1].w = valid;
        }
        GroupMemoryBarrierWithGroupSync();

        associatorValid = FrameEdgeMeta[1].w;
        if (lane < SIGMA_FRAME_LANE_COUNT)
        {
            FrameEdgeLeftBracket[lane] = SigmaFrameAssociatorProduct(2u, lane,
                associatorValid);
            FrameEdgeRightBracket[lane] = SigmaFrameAssociatorProduct(3u, lane,
                associatorValid);
            FrameEdgeId[lane] = associatorValid;
        }
        GroupMemoryBarrierWithGroupSync();
        if (lane == 0u)
        {
            uint valid = 1u;
            [unroll]
            for (uint coordinate = 0u; coordinate < SIGMA_FRAME_LANE_COUNT;
                ++coordinate)
                valid &= FrameEdgeId[coordinate];
            FrameEdgeMeta[1].w = valid;
        }
        GroupMemoryBarrierWithGroupSync();

        associatorValid = FrameEdgeMeta[1].w;
        if (lane < SIGMA_FRAME_LANE_COUNT)
        {
            FrameEdgeProductAB[lane] = SigmaQ48SubChecked(
                FrameEdgeLeftBracket[lane], FrameEdgeRightBracket[lane],
                associatorValid);
            FrameEdgeId[lane] = associatorValid;
        }
        GroupMemoryBarrierWithGroupSync();
        if (lane == 0u)
        {
            uint valid = 1u;
            [unroll]
            for (uint coordinate = 0u; coordinate < SIGMA_FRAME_LANE_COUNT;
                ++coordinate)
                valid &= FrameEdgeId[coordinate];
            uint4 associatorError = SigmaS16L1(FrameEdgeProductAB, valid);
            uint4 associatorScale = SigmaS16L1(FrameEdgeLeft, valid);
            associatorScale = SigmaU128Add(associatorScale,
                SigmaS16L1(FrameEdgeDeltaU, valid), valid);
            associatorScale = SigmaU128Add(associatorScale,
                SigmaS16L1(FrameEdgeDeltaV, valid), valid);
            if (SigmaU128Equal(associatorScale, SIGMA_U128_ZERO))
                associatorScale = SIGMA_U128_ONE;
            FrameEdgeMeta[1].w = valid != 0u &&
                SigmaRelativeAssociatorGate(associatorError,
                    associatorScale, _AssociatorShift) ? 1u : 0u;
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if (lane == 0u && active)
    {
        uint leftReadoutValid;
        uint rightReadoutValid;
        bool leftContact = SigmaStateHasContact(FrameEdgeLeft,
            leftReadoutValid);
        bool rightContact = SigmaStateHasContact(FrameEdgeRight,
            rightReadoutValid);
        uint valid = FrameEdgeMeta[0].w & leftReadoutValid &
            rightReadoutValid;
        uint4 scale = FrameEdgeError[254u];
        uint4 closure = SigmaClassifyClaimedPair(leftContact, rightContact,
            FrameEdgeMeta[0].x, FrameEdgeMeta[0].y, FrameEdgeMeta[0].z,
            FrameEdgeMeta[1].x, FrameEdgeError[0], scale, _SingularShift,
            false, valid);
        if (FrameEdgeMeta[1].w != 0u &&
            FrameEdgeMeta[0].x != SIGMA_FRAME_CLAIM_KIND_NONE)
        {
            bool near = SigmaRelativeNearGate(FrameEdgeError[0], scale,
                _SingularShift);
            bool independent = FrameEdgeMeta[0].y != 0u &&
                FrameEdgeMeta[0].z != 0u &&
                FrameEdgeMeta[0].y != FrameEdgeMeta[0].z;
            uint classification = near && independent
                ? SIGMA_TOPOLOGY_SINGULAR : SIGMA_TOPOLOGY_UNRESOLVED;
            closure.x = (closure.x & ~SIGMA_TOPOLOGY_CLASS_MASK) |
                SIGMA_TOPOLOGY_ASSOCIATOR | classification;
        }
        edge.Closure = uint4(FrameEdgeMeta[0].x, closure.x,
            closure.y, closure.z);
        _FrameDirtyEdges[edgeIndex] = edge;
    }
}

[numthreads(256, 1, 1)]
void ApplyPendingEdges(uint3 id : SV_DispatchThreadID)
{
    uint edgeIndex = id.x;
    if (edgeIndex >= _EdgeFootprintCount * 2u)
        return;
    SigmaDirtyEdgeGpu edge = _FrameDirtyEdges[edgeIndex];
    uint classification = SigmaTopologyClass(edge.Closure.y);
    if (edge.Left.x == SIGMA_FRAME_INVALID ||
        (classification != SIGMA_TOPOLOGY_REGULAR &&
            classification != SIGMA_TOPOLOGY_SINGULAR))
        return;
    uint left = edge.Left.x;
    uint right = edge.Left.y;
    if (_FrameDeferredFlags[left] != 0u ||
        _FrameDeferredFlags[right] != 0u)
        return;
    bool leftPending = SigmaFrameTargetPending(left);
    bool rightPending = SigmaFrameTargetPending(right);
    if (leftPending && rightPending)
    {
        uint root = min(left, right);
        InterlockedMin(_PendingLabels[left], root);
        InterlockedMin(_PendingLabels[right], root);
    }
    else if (leftPending != rightPending)
    {
        uint pending = leftPending ? left : right;
        uint current = leftPending ? right : left;
        InterlockedMin(_PendingLinks[pending], current);
    }
    InterlockedAdd(_FrameClosureCounters[1].y, 1u);
}

[numthreads(256, 1, 1)]
void RelaxPendingLabels(uint3 id : SV_DispatchThreadID)
{
    uint ordinal = id.x;
    uint targetCount = _FrameClosureCounters[0].x;
    if (ordinal >= targetCount)
        return;
    uint label = _PendingLabels[ordinal];
    if (label == SIGMA_FRAME_INVALID || label >= targetCount)
        return;
    uint parent = _PendingLabels[label];
    if (parent != SIGMA_FRAME_INVALID)
        InterlockedMin(_PendingLabels[ordinal], parent);
}

[numthreads(256, 1, 1)]
void FinalizePendingGauges(uint3 id : SV_DispatchThreadID)
{
    uint ordinal = id.x;
    uint targetCount = _FrameClosureCounters[0].x;
    if (ordinal >= targetCount || !SigmaFrameTargetPending(ordinal) ||
        _FrameDeferredFlags[ordinal] != 0u)
        return;
    uint root = _PendingLabels[ordinal];
    [loop]
    for (uint step = 0u; step < 18u && root < targetCount; ++step)
    {
        uint parent = _PendingLabels[root];
        if (parent == root || parent == SIGMA_FRAME_INVALID)
            break;
        root = parent;
    }
    if (root >= targetCount)
        return;
    _PendingLabels[ordinal] = root;
    uint anchor = _PendingLinks[ordinal];
    if (anchor != SIGMA_FRAME_INVALID)
        InterlockedMin(_PendingLinks[root], anchor);

}

[numthreads(256, 1, 1)]
void DeferUnresolvedEdges(uint3 id : SV_DispatchThreadID)
{
    uint edgeIndex = id.x;
    if (edgeIndex >= _EdgeFootprintCount * 2u)
        return;
    SigmaDirtyEdgeGpu edge = _FrameDirtyEdges[edgeIndex];
    if (edge.Left.x == SIGMA_FRAME_INVALID ||
        edge.Closure.x == SIGMA_FRAME_CLAIM_KIND_NONE ||
        SigmaTopologyClass(edge.Closure.y) != SIGMA_TOPOLOGY_UNRESOLVED)
        return;
    if (SigmaFrameTargetChanged(edge.Left.x))
        _FrameDeferredFlags[edge.Left.x] = 1u;
    if (SigmaFrameTargetChanged(edge.Left.y))
        _FrameDeferredFlags[edge.Left.y] = 1u;
    InterlockedAdd(_FrameClosureCounters[1].z, 1u);
}

[numthreads(256, 1, 1)]
void FinalizeExactClosure(uint3 id : SV_DispatchThreadID)
{
    uint ordinal = id.x;
    uint targetCount = _FrameClosureCounters[0].x;
    if (ordinal >= targetCount)
        return;
    SigmaFrameDeltaGpu target = _FrameTargetScratch[ordinal];
    uint flags = target.Evidence.y;
    if (_FrameDeferredFlags[ordinal] != 0u)
    {
        flags &= ~(SIGMA_FRAME_OUTCOME_ACCEPTED |
            SIGMA_FRAME_OUTCOME_UNCHANGED);
        flags |= SIGMA_FRAME_OUTCOME_PENDING |
            SIGMA_FRAME_OUTCOME_DEFERRED;
        InterlockedAdd(_FrameClosureCounters[2].x, 1u);
    }
    else if (SigmaFrameTargetPending(ordinal))
    {
        uint root = _PendingLabels[ordinal];
        if (root < targetCount)
        {
            uint anchor = _PendingLinks[root];
            bool accepted = (flags & SIGMA_FRAME_OUTCOME_ACCEPTED) != 0u;
            bool promotesExisting = accepted && target.Candidate.x ==
                SIGMA_FRAME_TARGET_KIND_PENDING;
            flags &= promotesExisting
                ? ~SIGMA_FRAME_OUTCOME_UNCHANGED : 0xffffffffu;
            target.Evidence.z = accepted
                ? (anchor != SIGMA_FRAME_INVALID
                    ? SIGMA_FRAME_PROPOSAL_KIND_CONTINUATION
                    : SIGMA_FRAME_PROPOSAL_KIND_NOVEL)
                : SIGMA_FRAME_PROPOSAL_KIND_PENDING;
            if (accepted && anchor != SIGMA_FRAME_INVALID)
                target.Candidate.x = anchor;
        }
    }
    target.Evidence.y = flags;
    _FrameTargetScratch[ordinal] = target;
}
bool SigmaPendingNeedsRetention(SigmaFrameDeltaGpu target)
{
    uint flags = target.Evidence.y;
    return (flags & SIGMA_FRAME_OUTCOME_PENDING) != 0u &&
        (flags & (SIGMA_FRAME_OUTCOME_CONFLICT | SIGMA_FRAME_OUTCOME_FAULT)) == 0u &&
        target.Evidence.z != SIGMA_FRAME_PROPOSAL_KIND_CURRENT;
}
bool SigmaPendingExistingHandle(SigmaFrameDeltaGpu target, uint4 control,
    out uint handle)
{
    handle = target.Candidate.y;
    return target.Candidate.x == SIGMA_FRAME_TARGET_KIND_PENDING && handle < control.x &&
        handle < control.y && handle < _PendingCapacity;
}
[numthreads(256, 1, 1)]
void MarkPromotedPendingSlots(uint3 id : SV_DispatchThreadID)
{
    uint localSlot = id.x;
    if (localSlot >= _PendingCount)
        return;
    uint slot = _PendingFirst + localSlot;
    uint4 control = _PendingControlRead[0u];
    _PendingReusableSlots[slot] = slot < control.x && slot < control.y &&
        slot < _PendingCapacity && _PendingGaugesRead[localSlot].Identity.y ==
            SIGMA_PENDING_GAUGE_STATE_PROMOTED ? 1u : 0u;
}
[numthreads(1, 1, 1)]
void AllocatePendingRetention(uint3 id : SV_DispatchThreadID)
{
    uint4 control = _PendingControl[0u];
    uint capacity = min(control.y, _PendingCapacity), targetCount = _FrameClosureCounters[0].x;
    if (control.x > capacity)
        { _FrameClosureCounters[3].x = 1u; return; }
    uint needed = 0u, existingHandleReused = 0u;
    [loop]
    for (uint index = 0u; index < targetCount; ++index)
    {
        SigmaFrameDeltaGpu target = _FrameTargetScratch[index];
        uint existing;
        if (!SigmaPendingNeedsRetention(target))
            continue;
        if (SigmaPendingExistingHandle(target, control, existing))
            ++existingHandleReused;
        else
            ++needed;
    }
    uint holes = 0u;
    [loop]
    for (uint slot = 0u; slot < control.x; ++slot)
        holes += _PendingReusableSlots[slot] != 0u ? 1u : 0u;
    _FrameClosureCounters[3].y = needed;
    _FrameClosureCounters[3].z = holes;
    _FrameClosureCounters[3].w = existingHandleReused;
    if (needed > holes + capacity - control.x)
        { _FrameClosureCounters[3].x = 1u; return; }
    uint holeCursor = 0u, tail = control.x;
    [loop]
    for (uint ordinal = 0u; ordinal < targetCount; ++ordinal)
    {
        SigmaFrameDeltaGpu target = _FrameTargetScratch[ordinal];
        if (!SigmaPendingNeedsRetention(target))
            continue;
        uint slot;
        if (!SigmaPendingExistingHandle(target, control, slot))
        {
            [loop]
            while (holeCursor < control.x && _PendingReusableSlots[holeCursor] == 0u)
                ++holeCursor;
            uint append = holeCursor >= control.x ? 1u : 0u; slot = append != 0u ? tail : holeCursor; holeCursor += 1u - append; tail += append;
        }
        _PendingLinks[ordinal] = slot;
    }
    control.x = tail;
    _PendingControl[0u] = control;
}
void SigmaPendingSelectKeys(uint sourceMask, SigmaPendingGaugeGpu previous,
    bool existing, out uint key0, out uint key1)
{
    key0 = existing ? previous.Provenance.y : 0u;
    key1 = existing ? previous.Provenance.z : 0u;
    [unroll]
    for (uint source = 0u; source < SIGMA_FRAME_SOURCE_COUNT; ++source)
    {
        if ((sourceMask & (1u << source)) == 0u)
            continue;
        uint key = _FrameSourceKeys[source];
        if (key == 0u || key == key0 || key == key1)
            continue;
        if (key0 == 0u)
            key0 = key;
        else if (key1 == 0u)
            key1 = key;
    }
}

[numthreads(16, 1, 1)]
void PersistPendingTargets(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint coordinate = threadId.x;
    uint linearGroup = groupId.y * _LinearDispatchGroupsX + groupId.x;
    uint ordinal = _TargetWindowFirst + linearGroup;
    uint targetCount = _FrameClosureCountersRead[0].x;
    if (_FrameClosureCountersRead[3].x != 0u || ordinal >= targetCount ||
        ordinal >= _TargetWindowFirst + _TargetWindowCount)
        return;
    SigmaFrameDeltaGpu target = _FrameTargetScratch[ordinal];
    if (!SigmaPendingNeedsRetention(target))
        return;
    uint slot = _PendingLinks[ordinal];
    if (slot < _PendingFirst || slot >= _PendingFirst + _PendingCount ||
        slot >= _PendingCapacity || slot >= _PendingControlRead[0u].y)
        return;
    uint localSlot = slot - _PendingFirst;
    uint localTarget = ordinal - _TargetWindowFirst;
    uint source = localTarget * SIGMA_FRAME_LANE_COUNT + coordinate;
    uint destination = localSlot * SIGMA_FRAME_LANE_COUNT + coordinate;
    _PendingStates[destination] = _ReducedTargetStatesRead[source];
    _PendingLower[destination] = _ReducedTargetLowerRead[source];
    _PendingUpper[destination] = _ReducedTargetUpperRead[source];
    _PendingValidity[destination] = _ReducedTargetValidityRead[source];

    if (coordinate == 0u)
    {
        bool existing = target.Candidate.x ==
            SIGMA_FRAME_TARGET_KIND_PENDING &&
            target.Candidate.y == slot;
        SigmaPendingGaugeGpu previous;
        if (existing)
            previous = _PendingGaugesRead[localSlot];
        else
        {
            previous.Identity = 0u;
            previous.Provenance = 0u;
            previous.LocalExtent = 0u;
        }
        uint sourceMask = 0u;
        [unroll]
        for (uint lane = 0u; lane < SIGMA_FRAME_LANE_COUNT; ++lane)
        {
            sourceMask |= (_ReducedTargetValidityRead[
                localTarget * SIGMA_FRAME_LANE_COUNT + lane] >>
                SIGMA_FRAME_SOURCE_MASK_SHIFT) &
                ((1u << SIGMA_FRAME_SOURCE_COUNT) - 1u);
        }
        if (existing)
            sourceMask |= previous.Provenance.x;
        uint key0;
        uint key1;
        SigmaPendingSelectKeys(sourceMask, previous, existing, key0, key1);
        uint generation = existing ? previous.Identity.x : _FrameRevision;
        uint root = _PendingLabels[ordinal];
        uint rootSlot = root < targetCount &&
            _PendingLinks[root] != SIGMA_FRAME_INVALID
            ? _PendingLinks[root] : slot;
        uint footprint = target.Evidence.x;
        SigmaPendingGaugeGpu gauge;
        gauge.Identity = uint4(generation,
            SIGMA_PENDING_GAUGE_STATE_OPEN,
            existing ? previous.Identity.z + 1u : 1u, rootSlot);
        gauge.Provenance = uint4(sourceMask, key0, key1,
            existing ? previous.Provenance.w : _FrameRevision);
        gauge.LocalExtent = uint4(
            footprint % _FrameResolution.x,
            footprint / _FrameResolution.x, rootSlot, 0u);
        _PendingGauges[localSlot] = gauge;
        target.Candidate = uint4(SIGMA_FRAME_TARGET_KIND_PENDING, slot,
            generation, gauge.Provenance.w);
        target.Evidence.z = SIGMA_FRAME_PROPOSAL_KIND_PENDING;
        _FrameTargetScratch[ordinal] = target;
    }
}
[numthreads(256, 1, 1)]
void CommitPromotedPending(uint3 id : SV_DispatchThreadID)
{
    uint ordinal = id.x;
    if (_PublishedRevisionRoot[0u] != _FrameRevision ||
        ordinal >= _FrameClosureCountersRead[0].x)
        return;
    SigmaFrameDeltaGpu target = _FrameTargetScratch[ordinal];
    uint flags = target.Evidence.y, kind = target.Evidence.z;
    if ((flags & SIGMA_FRAME_OUTCOME_ACCEPTED) == 0u ||
        (flags & (SIGMA_FRAME_OUTCOME_UNCHANGED |
            SIGMA_FRAME_OUTCOME_CONFLICT | SIGMA_FRAME_OUTCOME_FAULT |
            SIGMA_FRAME_OUTCOME_DEFERRED)) != 0u ||
        (kind != SIGMA_FRAME_PROPOSAL_KIND_CONTINUATION &&
            kind != SIGMA_FRAME_PROPOSAL_KIND_NOVEL))
        return;
    uint handle = target.Candidate.y, generation = target.Candidate.z;
    uint4 control = _PendingControlRead[0u];
    if (handle < _PendingFirst || handle >= _PendingFirst + _PendingCount ||
        handle >= control.x || handle >= control.y || handle >= _PendingCapacity)
        return;
    uint localSlot = handle - _PendingFirst;
    SigmaPendingGaugeGpu gauge = _PendingGauges[localSlot];
    if (gauge.Identity.x != generation ||
        (gauge.Identity.y != SIGMA_PENDING_GAUGE_STATE_OPEN &&
            gauge.Identity.y != SIGMA_PENDING_GAUGE_STATE_SUPPORTED))
        return;
    gauge.Identity.y = SIGMA_PENDING_GAUGE_STATE_PROMOTED;
    _PendingGauges[localSlot] = gauge;
}
