#pragma kernel MaterializePublishedTopology
#pragma target 5.0

#include "SigmaInverseWorkAbi.hlsl"
#include "SigmaTopologyAbi.hlsl"

// Disposable topology/readout materialization. Canonical transition closure is
// already complete in CB2; this pass can neither evaluate nor authorize Psi.

StructuredBuffer<SigmaStreamWorkItemGpu> _StreamWorkItems;
StructuredBuffer<uint> _StreamWorkCounts;
StructuredBuffer<SigmaTransactionGpu> _StreamTransactions;
StructuredBuffer<uint4> _StreamCandidateTransitions;
StructuredBuffer<uint4> _StreamCandidateNeighbours;
StructuredBuffer<SigmaCarrierPageMetaGpu> _PageMetadata;
StructuredBuffer<SigmaPublicationManifestGpu> _StreamManifests;
StructuredBuffer<SigmaPageVisibilityGpu> _StreamPageVisibility;

RWStructuredBuffer<uint4> _TopologyTransitionRecords;
RWStructuredBuffer<uint> _TopologyCellFlags;
RWStructuredBuffer<uint4> _TopologyPageKeys;
RWStructuredBuffer<uint> _ReadoutDirtyFlags;

uint _PageCapacity;
uint _TopologyPageCapacity;
uint _StreamManifestCapacity;

#define SIGMA_DERIVED_INVALID 0xffffffffu

groupshared uint DerivedActive;
groupshared uint DerivedTransactionSlot;
groupshared uint DerivedTargetPage;
groupshared uint DerivedTransactionGeneration;
groupshared uint DerivedRightPage;
groupshared uint DerivedDownPage;

uint SigmaDerivedTransitionAddress(uint pageSlot, uint transition)
{
    return pageSlot * SIGMA_TRANSITIONS_PER_PAGE + transition;
}

uint SigmaDerivedCellAddress(uint pageSlot, uint sample)
{
    return pageSlot * SIGMA_PAGE_SAMPLE_COUNT + sample;
}

bool SigmaDerivedManifestPublished(uint2 handle)
{
    if (handle.x >= _StreamManifestCapacity || handle.y == 0u)
        return false;
    uint4 identity = _StreamManifests[handle.x].identity;
    return identity.x == SIGMA_STREAM_MANIFEST_PUBLISHED &&
        identity.y == handle.y;
}

bool SigmaDerivedPageVisible(uint pageSlot)
{
    if (pageSlot >= _PageCapacity ||
        pageSlot >= _StreamManifestCapacity)
        return false;
    SigmaPageVisibilityGpu visibility = _StreamPageVisibility[pageSlot];
    uint2 bornHandle = visibility.bornRetired.xy;
    if (!SigmaDerivedManifestPublished(bornHandle))
        return false;
    uint2 retiredHandle = visibility.bornRetired.zw;
    return retiredHandle.x == SIGMA_STREAM_INVALID ||
        !SigmaDerivedManifestPublished(retiredHandle);
}

bool SigmaDerivedTopologyCurrent(uint pageSlot)
{
    if (pageSlot >= _TopologyPageCapacity ||
        !SigmaDerivedPageVisible(pageSlot))
        return false;
    SigmaCarrierPageMetaGpu metadata = _PageMetadata[pageSlot];
    uint4 key = _TopologyPageKeys[pageSlot];
    return key.x == metadata.generation &&
        key.y == metadata.revision && key.z == 1u;
}

uint4 SigmaDerivedUnresolvedRecord()
{
    return uint4(SigmaTopologyPack(SIGMA_TOPOLOGY_UNRESOLVED, 255u,
        SIGMA_TOPOLOGY_INVALID), 0u, 0u, 0u);
}

uint4 SigmaDerivedNeighbourRecord(uint pageSlot, uint transition)
{
    if (!SigmaDerivedTopologyCurrent(pageSlot))
        return SigmaDerivedUnresolvedRecord();
    return _TopologyTransitionRecords[SigmaDerivedTransitionAddress(
        pageSlot, transition)];
}

bool SigmaDerivedRecordCuts(uint4 record)
{
    return SigmaTopologyClass(record.x) != SIGMA_TOPOLOGY_REGULAR;
}

void SigmaDerivedPrepareGroup(uint workIndex)
{
    DerivedActive = 0u;
    DerivedTransactionSlot = SIGMA_DERIVED_INVALID;
    DerivedTargetPage = SIGMA_DERIVED_INVALID;
    DerivedTransactionGeneration = 0u;
    DerivedRightPage = SIGMA_DERIVED_INVALID;
    DerivedDownPage = SIGMA_DERIVED_INVALID;

    uint workCount = _StreamWorkCounts[
        SIGMA_STREAM_OPCODE_PUBLISH_MANIFEST];
    if (workIndex >= workCount)
        return;
    SigmaStreamWorkItemGpu work = _StreamWorkItems[
        SigmaStreamWorkAddress(SIGMA_STREAM_OPCODE_PUBLISH_MANIFEST,
            workIndex)];
    uint transactionSlot = work.identity.y;
    if (work.identity.x != SIGMA_STREAM_OPCODE_PUBLISH_MANIFEST ||
        transactionSlot >= SIGMA_STREAM_TRANSACTION_CAPACITY)
        return;
    SigmaTransactionGpu transaction = _StreamTransactions[transactionSlot];
    uint generation = SigmaStreamTransactionGeneration(transaction);
    if (generation != work.identity.z ||
        SigmaStreamTransactionState(transaction) !=
            SIGMA_STREAM_TRANSACTION_PUBLISHED ||
        !SigmaDerivedManifestPublished(transaction.publication.xy))
        return;

    uint target = transaction.page0.state.y;
    if (target >= _PageCapacity || target >= _TopologyPageCapacity ||
        !SigmaDerivedPageVisible(target))
        return;

    uint4 neighbours = _StreamCandidateNeighbours[transactionSlot];
    DerivedTransactionSlot = transactionSlot;
    DerivedTargetPage = target;
    DerivedTransactionGeneration = generation;
    if (neighbours.x == generation)
    {
        DerivedRightPage = neighbours.y;
        DerivedDownPage = neighbours.z;
    }
    DerivedActive = 1u;
}

[numthreads(256, 1, 1)]
void MaterializePublishedTopology(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint lane = threadId.x;
    if (lane == 0u)
        SigmaDerivedPrepareGroup(groupId.x);
    GroupMemoryBarrierWithGroupSync();
    if (DerivedActive == 0u)
        return;

    uint transactionSlot = DerivedTransactionSlot;
    uint target = DerivedTargetPage;
    uint candidateBase = transactionSlot * SIGMA_TRANSITIONS_PER_PAGE;
    uint targetBase = target * SIGMA_TRANSITIONS_PER_PAGE;
    for (uint transition = lane; transition < SIGMA_TRANSITIONS_PER_PAGE;
        transition += 256u)
    {
        _TopologyTransitionRecords[targetBase + transition] =
            _StreamCandidateTransitions[candidateBase + transition];
    }
    DeviceMemoryBarrierWithGroupSync();

    for (uint sample = lane; sample < SIGMA_PAGE_SAMPLE_COUNT;
        sample += 256u)
    {
        uint x = sample & 63u;
        uint y = sample >> 6u;
        uint4 top = _TopologyTransitionRecords[targetBase + sample];
        uint4 left = _TopologyTransitionRecords[targetBase +
            SIGMA_PAGE_SAMPLE_COUNT + sample];
        uint4 right;
        if (x < 63u)
        {
            right = _TopologyTransitionRecords[targetBase +
                SIGMA_PAGE_SAMPLE_COUNT + sample + 1u];
        }
        else
        {
            right = SigmaDerivedNeighbourRecord(DerivedRightPage,
                SIGMA_PAGE_SAMPLE_COUNT + y * 64u);
        }
        uint4 bottom;
        if (y < 63u)
            bottom = _TopologyTransitionRecords[targetBase + sample + 64u];
        else
            bottom = SigmaDerivedNeighbourRecord(DerivedDownPage, x);

        uint flags = 0u;
        if (SigmaDerivedRecordCuts(top) || SigmaDerivedRecordCuts(left))
            flags |= SIGMA_TOPOLOGY_TRIANGLE_0_CUT;
        if (SigmaDerivedRecordCuts(right) || SigmaDerivedRecordCuts(bottom))
            flags |= SIGMA_TOPOLOGY_TRIANGLE_1_CUT;

        uint classes[4] = {
            SigmaTopologyClass(top.x), SigmaTopologyClass(left.x),
            SigmaTopologyClass(right.x), SigmaTopologyClass(bottom.x)
        };
        [unroll]
        for (uint edge = 0u; edge < 4u; ++edge)
        {
            if (classes[edge] == SIGMA_TOPOLOGY_SINGULAR)
                flags |= SIGMA_TOPOLOGY_CELL_SINGULAR;
            else if (classes[edge] != SIGMA_TOPOLOGY_REGULAR)
                flags |= SIGMA_TOPOLOGY_CELL_UNRESOLVED;
        }
        _TopologyCellFlags[SigmaDerivedCellAddress(target, sample)] = flags;
    }
    DeviceMemoryBarrierWithGroupSync();

    if (lane == 0u)
    {
        SigmaCarrierPageMetaGpu metadata = _PageMetadata[target];
        _TopologyPageKeys[target] = uint4(metadata.generation,
            metadata.revision, 1u, 0u);
        _ReadoutDirtyFlags[target] = 1u;
    }
}
