#pragma kernel AccumulateSigmaPerformanceCounters
#pragma target 5.0

#include "SigmaPerformanceAbi.hlsl"

StructuredBuffer<uint> _FrameCounters;
StructuredBuffer<uint> _InverseWorkControl;
StructuredBuffer<uint> _TopologyCounters;
RWStructuredBuffer<uint> _PerformanceCounters;
RWStructuredBuffer<uint> _PerformanceTopologyHistory;

#define SIGMA_FRAME_HIT_SAMPLES 1u
#define SIGMA_FRAME_EMPTY_MEETS 3u
#define SIGMA_PAGE_SAMPLE_COUNT 4096u

uint SigmaPerfSaturatingAdd(uint left, uint right)
{
    uint value = left + right;
    return value < left ? 0xffffffffu : value;
}

uint SigmaPerfSaturatingMul(uint left, uint right)
{
    if (left == 0u || right == 0u)
        return 0u;
    return left > 0xffffffffu / right
        ? 0xffffffffu : left * right;
}

uint SigmaPerfSum3(uint first, uint second, uint third)
{
    return SigmaPerfSaturatingAdd(
        SigmaPerfSaturatingAdd(first, second), third);
}

// One scalar publication writes the fixed-plan costs for the already compacted
// GPU work. There are no per-operation atomics and no CPU readback. Topology
// counters are cumulative, so their previous values stay in a separate GPU-only
// history buffer and are differenced modulo uint for the current submission.
[numthreads(1, 1, 1)]
void AccumulateSigmaPerformanceCounters(uint3 id : SV_DispatchThreadID)
{
    uint topologyDelta[SIGMA_PERF_TOPOLOGY_HISTORY_COUNT];
    [unroll]
    for (uint index = 0u; index < SIGMA_PERF_TOPOLOGY_HISTORY_COUNT; ++index)
    {
        uint current = _TopologyCounters[index];
        topologyDelta[index] = current - _PerformanceTopologyHistory[index];
        _PerformanceTopologyHistory[index] = current;
    }

    uint activeWork = _InverseWorkControl[2u];
    uint activeSamples = SigmaPerfSaturatingMul(activeWork,
        SIGMA_PAGE_SAMPLE_COUNT);
    uint hitSamples = _FrameCounters[SIGMA_FRAME_HIT_SAMPLES];
    uint depthCells = SigmaPerfSaturatingMul(hitSamples, 2u);
    uint rgbCells = SigmaPerfSaturatingMul(activeSamples >> 4u, 2u);
    uint sourceCells = SigmaPerfSaturatingAdd(depthCells, rgbCells);
    uint sourceMeets = SigmaPerfSaturatingMul(hitSamples, 4u);
    uint hadamardPlans = SigmaPerfSaturatingMul(activeSamples, 2u);
    uint witnessEvaluations = topologyDelta[1u];
    uint associatorEvaluations = topologyDelta[2u];

    uint xorOps = SigmaPerfSaturatingAdd(
        SigmaPerfSaturatingMul(sourceCells,
            SIGMA_COST_SOURCE_XOR_PERMUTATION),
        SigmaPerfSaturatingMul(witnessEvaluations,
            SIGMA_COST_DYAD_XOR_PERMUTATION));
    uint signedOps = SigmaPerfSum3(
        SigmaPerfSaturatingMul(sourceCells,
            SIGMA_COST_SOURCE_SIGNED_ADD_SUB),
        SigmaPerfSaturatingMul(hadamardPlans,
            SIGMA_COST_HADAMARD_SIGNED_ADD_SUB),
        SigmaPerfSaturatingMul(witnessEvaluations,
            SIGMA_COST_DYAD_SIGNED_ADD_SUB));
    uint maskOps = SigmaPerfSum3(
        SigmaPerfSaturatingMul(sourceCells,
            SIGMA_COST_SOURCE_MASK_SELECT),
        SigmaPerfSaturatingMul(hadamardPlans,
            SIGMA_COST_HADAMARD_MASK_SELECT),
        SigmaPerfSaturatingMul(witnessEvaluations,
            SIGMA_COST_DYAD_MASK_SELECT));
    maskOps = SigmaPerfSaturatingAdd(maskOps,
        SigmaPerfSaturatingMul(sourceMeets,
            SIGMA_COST_MEET_MASK_SELECT));

    _PerformanceCounters[SIGMA_PERF_ACTIVE_CARRIER_SAMPLES] = activeSamples;
    _PerformanceCounters[SIGMA_PERF_ACTIVE_TRANSITIONS] = topologyDelta[0u];
    _PerformanceCounters[SIGMA_PERF_TRANSITION_CACHE_HIT] = topologyDelta[5u];
    _PerformanceCounters[SIGMA_PERF_TRANSITION_CACHE_MISS] = topologyDelta[0u];
    _PerformanceCounters[SIGMA_PERF_XOR_PERMUTATION_OPS] = xorOps;
    _PerformanceCounters[SIGMA_PERF_SIGNED_ADD_SUB_OPS] = signedOps;
    _PerformanceCounters[SIGMA_PERF_MASK_SELECT_OPS] = maskOps;
    _PerformanceCounters[SIGMA_PERF_Q48_WIDE_MUL_OPS] =
        SigmaPerfSaturatingMul(sourceCells,
            SIGMA_COST_SOURCE_WIDE_MULTIPLY);
    _PerformanceCounters[SIGMA_PERF_Q48_DIV_OPS] =
        SigmaPerfSaturatingMul(sourceCells, SIGMA_COST_SOURCE_DIVIDE);
    _PerformanceCounters[SIGMA_PERF_INTERVAL_MULDIV_OPS] =
        SigmaPerfSaturatingMul(sourceCells,
            SIGMA_COST_SOURCE_INTERVAL_MULDIV);
    _PerformanceCounters[SIGMA_PERF_ANNIHILATOR_WITNESS_EVALS] =
        witnessEvaluations;
    _PerformanceCounters[SIGMA_PERF_GENERIC_DENSE_S16_PRODUCTS] =
        SigmaPerfSaturatingMul(associatorEvaluations,
            SIGMA_COST_ASSOCIATOR_DENSE_PRODUCTS);
    _PerformanceCounters[SIGMA_PERF_OPERATOR_PLAN_INVOCATIONS] =
        SigmaPerfSum3(sourceCells, hadamardPlans,
            SigmaPerfSaturatingAdd(witnessEvaluations,
                associatorEvaluations));
    _PerformanceCounters[SIGMA_PERF_SOURCE_CELLS_BUILT] = sourceCells;
    _PerformanceCounters[SIGMA_PERF_SOURCE_CELLS_MET] = sourceMeets;
    _PerformanceCounters[SIGMA_PERF_EMPTY_MEETS] =
        _FrameCounters[SIGMA_FRAME_EMPTY_MEETS];
    _PerformanceCounters[SIGMA_PERF_BYTES_READ] = SigmaPerfSaturatingAdd(
        SigmaPerfSaturatingMul(activeSamples, 192u),
        SigmaPerfSaturatingMul(sourceCells, 128u));
    _PerformanceCounters[SIGMA_PERF_BYTES_WRITTEN] = SigmaPerfSaturatingAdd(
        SigmaPerfSaturatingMul(activeSamples, 144u),
        SigmaPerfSaturatingMul(sourceCells, 64u));
}
