#pragma kernel ClearProofTransaction
#pragma kernel ReduceProofSources
#pragma kernel FinalizeProofPage
#pragma kernel CommitRawProof
#pragma target 5.0

#include "Generated/SigmaGeneratedLayout.hlsl"
#include "SigmaExactCompare.hlsl"
#include "SigmaOperatorPlan.hlsl"
#include "SigmaConstraintLedgerAbi.hlsl"
#include "SigmaInverseWorkAbi.hlsl"

RWStructuredBuffer<SigmaProofSampleGpu> _ProofSamples;
RWStructuredBuffer<SigmaConstraintCertificateGpu> _Certificates;
RWStructuredBuffer<SigmaQ48Bounds> _CertificateBounds;
RWStructuredBuffer<SigmaConstraintBlockGpu> _ConstraintBlocks;
RWStructuredBuffer<SigmaRawObservationTileGpu> _RawTiles;
RWStructuredBuffer<uint4> _RawTileWords;
StructuredBuffer<uint> _RawReservations;
RWStructuredBuffer<SigmaRawRetentionRequestGpu> _RawRequests;
StructuredBuffer<SigmaRawFrameRecordGpu> _RawFrameStaging;
RWStructuredBuffer<SigmaRawFrameRecordGpu> _RawFrameRecords;
StructuredBuffer<uint4> _PoseResult;
RWStructuredBuffer<uint> _ProofPageStatus;
// Disposable per-transaction reduction scratch. Four source records are
// indexed by compact inverse work, never by physical/world identity.
RWStructuredBuffer<uint4> _ProofSourceScratchMeta;
RWStructuredBuffer<SigmaQ48Bounds> _ProofSourceScratchBounds;
StructuredBuffer<uint4> _ProofSourceScratchMetaRead;
StructuredBuffer<SigmaQ48Bounds> _ProofSourceScratchBoundsRead;
StructuredBuffer<SigmaInverseWorkGpu> _InverseWork;
StructuredBuffer<uint> _InverseWorkControl;

uint _SourceProofSlot;
uint _TargetProofSlot;
uint _ProofFrameSlot;
uint _ProofCalibrationEpoch;
uint _ProofRevision;
uint _RawTileCapacity;
uint _UseInverseWorkList;

#define SIGMA_LEDGER_CANDIDATE_CAPACITY 8u

groupshared uint4 LedgerIdentity[SIGMA_LEDGER_CANDIDATE_CAPACITY];
groupshared uint4 LedgerRange[SIGMA_LEDGER_CANDIDATE_CAPACITY];
groupshared uint2 LedgerSampleMask[SIGMA_LEDGER_CANDIDATE_CAPACITY];
groupshared SigmaQ48Bounds LedgerBounds[SIGMA_LEDGER_CANDIDATE_CAPACITY * 16u];
// Source-reduction scratch. One lane owns one 8x8-block sample while source
// cells are aggregated.  Keeping a single source plane resident lets the
// reducer preserve exact source order/provenance without the old lane-0
// 64-sample x 16-coordinate serial walk.
groupshared uint4 ProofReduce[64u];
groupshared uint4 ProofRawReduce[64u];
groupshared uint4 ProofSourceIdentity[64u];
groupshared SigmaQ48Bounds ProofSourceBounds[64u * 16u];

SigmaQ48Bounds SigmaFullBounds()
{
    SigmaQ48Bounds result;
    result.lo = uint2(0u, 0x80000000u);
    result.hi = uint2(0xffffffffu, 0x7fffffffu);
    return result;
}

uint SigmaPopCount64(uint2 mask)
{
    return countbits(mask.x) + countbits(mask.y);
}

bool SigmaMaskBit(uint2 mask, uint sample)
{
    return sample < 32u
        ? (mask.x & (1u << sample)) != 0u
        : (mask.y & (1u << (sample - 32u))) != 0u;
}

void SigmaSetMaskBit(inout uint2 mask, uint sample)
{
    if (sample < 32u)
        mask.x |= 1u << sample;
    else
        mask.y |= 1u << (sample - 32u);
}

void SigmaClearCandidate(uint candidate)
{
    LedgerIdentity[candidate] = 0u;
    LedgerRange[candidate] = 0u;
    LedgerSampleMask[candidate] = 0u;
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
        LedgerBounds[candidate * 16u + lane] = SigmaFullBounds();
}

SigmaQ48Bounds SigmaCandidateBound(uint candidate, uint lane)
{
    return LedgerBounds[candidate * 16u + lane];
}

void SigmaSetCandidateBound(uint candidate, uint lane, SigmaQ48Bounds value)
{
    LedgerBounds[candidate * 16u + lane] = value;
}

bool SigmaCertificateLess(uint left, uint right)
{
    uint4 a = LedgerRange[left];
    uint4 b = LedgerRange[right];
    if (a.x != b.x) return a.x < b.x;
    uint4 ai = LedgerIdentity[left];
    uint4 bi = LedgerIdentity[right];
    if (ai.z != bi.z) return ai.z < bi.z;
    if (ai.y != bi.y) return ai.y < bi.y;
    if (ai.w != bi.w) return ai.w < bi.w;
    if (ai.x != bi.x) return ai.x < bi.x;
    [loop]
    for (uint lane = 0u; lane < 16u; ++lane)
    {
        SigmaQ48Bounds ab = SigmaCandidateBound(left, lane);
        SigmaQ48Bounds bb = SigmaCandidateBound(right, lane);
        if (!SigmaU64Equal(ab.lo, bb.lo)) return SigmaQ48Less(ab.lo, bb.lo);
        if (!SigmaU64Equal(ab.hi, bb.hi)) return SigmaQ48Less(ab.hi, bb.hi);
    }
    if (LedgerSampleMask[left].y != LedgerSampleMask[right].y)
        return LedgerSampleMask[left].y < LedgerSampleMask[right].y;
    return LedgerSampleMask[left].x < LedgerSampleMask[right].x;
}

void SigmaSwapCandidates(uint left, uint right)
{
    uint4 identity = LedgerIdentity[left];
    LedgerIdentity[left] = LedgerIdentity[right];
    LedgerIdentity[right] = identity;
    uint4 range = LedgerRange[left];
    LedgerRange[left] = LedgerRange[right];
    LedgerRange[right] = range;
    uint2 samples = LedgerSampleMask[left];
    LedgerSampleMask[left] = LedgerSampleMask[right];
    LedgerSampleMask[right] = samples;
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
    {
        SigmaQ48Bounds bound = SigmaCandidateBound(left, lane);
        SigmaSetCandidateBound(left, lane,
            SigmaCandidateBound(right, lane));
        SigmaSetCandidateBound(right, lane, bound);
    }
}

void SigmaRemoveCandidate(inout uint count, uint index)
{
    [loop]
    for (uint move = index; move + 1u < count; ++move)
        SigmaSwapCandidates(move, move + 1u);
    count--;
    SigmaClearCandidate(count);
}

bool SigmaSameCoalesceKey(uint left, uint right)
{
    return LedgerRange[left].x == LedgerRange[right].x &&
        LedgerIdentity[left].z == LedgerIdentity[right].z &&
        LedgerIdentity[left].y == LedgerIdentity[right].y &&
        LedgerIdentity[left].w == LedgerIdentity[right].w;
}

uint SigmaIndependentCoordinateMask(uint candidateCount, int skipped)
{
    uint result = 0u;
    [loop]
    for (uint lane = 0u; lane < 16u; ++lane)
    {
        [loop]
        for (uint first = 0u; first < candidateCount; ++first)
        {
            if ((int)first == skipped ||
                (LedgerIdentity[first].x & (1u << lane)) == 0u ||
                LedgerIdentity[first].z == 0u)
                continue;
            [loop]
            for (uint second = first + 1u; second < candidateCount; ++second)
            {
                if ((int)second == skipped ||
                    (LedgerIdentity[second].x & (1u << lane)) == 0u ||
                    LedgerIdentity[second].z == 0u ||
                    LedgerIdentity[first].z == LedgerIdentity[second].z)
                    continue;
                uint2 overlap = LedgerSampleMask[first] &
                    LedgerSampleMask[second];
                if (any(overlap != 0u))
                    result |= 1u << lane;
            }
        }
    }
    return result;
}

void SigmaComputeCandidateMeet(uint candidateCount, int skipped,
    out uint coordinateMask, out uint roleMask, out uint independentMask,
    out SigmaQ48Bounds meet[16])
{
    coordinateMask = 0u;
    roleMask = 0u;
    independentMask = SigmaIndependentCoordinateMask(candidateCount, skipped);
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
        meet[lane] = SigmaFullBounds();
    [loop]
    for (uint candidate = 0u; candidate < candidateCount; ++candidate)
    {
        if ((int)candidate == skipped)
            continue;
        uint mask = LedgerIdentity[candidate].x;
        coordinateMask |= mask;
        roleMask |= LedgerRange[candidate].x;
        [loop]
        for (uint lane = 0u; lane < 16u; ++lane)
        {
            if ((mask & (1u << lane)) == 0u)
                continue;
            SigmaQ48Bounds bound = SigmaCandidateBound(candidate, lane);
            meet[lane].lo = SigmaQ48Max(meet[lane].lo, bound.lo);
            meet[lane].hi = SigmaQ48Min(meet[lane].hi, bound.hi);
        }
    }
}

bool SigmaSameProofResult(uint maskA, uint roleA, uint independentA,
    SigmaQ48Bounds meetA[16], uint maskB, uint roleB, uint independentB,
    SigmaQ48Bounds meetB[16])
{
    if (maskA != maskB || roleA != roleB || independentA != independentB)
        return false;
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
    {
        if ((maskA & (1u << lane)) == 0u)
            continue;
        if (!SigmaU64Equal(meetA[lane].lo, meetB[lane].lo) ||
            !SigmaU64Equal(meetA[lane].hi, meetB[lane].hi))
            return false;
    }
    return true;
}

uint SigmaLoadPriorCertificates(uint block, uint sourceProofSlot)
{
    if (sourceProofSlot == SIGMA_INVALID_PROOF_SLOT)
        return 0u;
    SigmaConstraintBlockGpu prior = _ConstraintBlocks[
        SigmaConstraintBlockAddress(sourceProofSlot, block)];
    uint count = min(prior.counts.x, SIGMA_CERTIFICATES_PER_BLOCK);
    [loop]
    for (uint candidate = 0u; candidate < count; ++candidate)
    {
        SigmaConstraintCertificateGpu certificate = _Certificates[
            SigmaCertificateAddress(sourceProofSlot, block, candidate)];
        LedgerIdentity[candidate] = certificate.identity;
        LedgerRange[candidate] = certificate.range;
        LedgerSampleMask[candidate] = certificate.sampleMask;
        [unroll]
        for (uint lane = 0u; lane < 16u; ++lane)
            SigmaSetCandidateBound(candidate, lane, SigmaFullBounds());
        uint cursor = 0u;
        [loop]
        for (uint lane = 0u; lane < 16u; ++lane)
        {
            if ((certificate.identity.x & (1u << lane)) == 0u)
                continue;
            if (cursor >= certificate.range.z)
                break;
            SigmaSetCandidateBound(candidate, lane, _CertificateBounds[
                SigmaCertificateBoundAddress(sourceProofSlot, block,
                    certificate.range.y + cursor)]);
            cursor++;
        }
    }
    return count;
}

bool SigmaSourceCell(uint source, SigmaProofSampleGpu sample,
    out uint coordinateMask, out uint sourceClass, out uint key,
    out uint roleMask, out SigmaQ48Bounds bounds[16])
{
    coordinateMask = 0u;
    sourceClass = 0u;
    key = 0u;
    roleMask = 0u;
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
        bounds[lane] = SigmaFullBounds();
    if (source < 2u)
    {
        SigmaDepthCell3 cell;
        if (source == 0u)
            cell = sample.depthLeft;
        else
            cell = sample.depthRight;
        if (cell.valid == 0u || cell.sector != SIGMA_SECTOR_HIT)
            return false;
        [unroll]
        for (uint axis = 0u; axis < 3u; ++axis)
        {
            uint lane = SIGMA_GEOMETRY_ROWS[axis + 1u];
            coordinateMask |= 1u << lane;
            bounds[lane] = cell.axis[axis];
        }
        sourceClass = cell.sourceClass;
        key = cell.independenceKey;
        roleMask = SIGMA_ROLE_SUPPORT | SIGMA_ROLE_GEOMETRY;
        return true;
    }
    SigmaAdmissibleCell16 rgb;
    if (source == 2u)
        rgb = sample.rgbLeft;
    else
        rgb = sample.rgbRight;
    if (rgb.valid == 0u || rgb.coordinateMask == 0u)
        return false;
    coordinateMask = rgb.coordinateMask;
    sourceClass = rgb.sourceClass;
    key = rgb.independenceKey;
    roleMask = SIGMA_ROLE_SUPPORT | SIGMA_ROLE_APPEARANCE;
    [unroll]
    for (uint rgbLane = 0u; rgbLane < 16u; ++rgbLane)
        bounds[rgbLane] = rgb.coordinate[rgbLane];
    return true;
}

bool SigmaProofEqualsSource(uint block, uint sourceProofSlot, uint count,
    uint boundCount, uint meetMask, uint roleMask, uint independentMask)
{
    if (sourceProofSlot == SIGMA_INVALID_PROOF_SLOT)
        return count == 0u && boundCount == 0u;
    SigmaConstraintBlockGpu prior = _ConstraintBlocks[
        SigmaConstraintBlockAddress(sourceProofSlot, block)];
    if (prior.counts.x != count || prior.counts.y != boundCount ||
        prior.proof.x != meetMask || prior.proof.y != roleMask ||
        prior.proof.z != independentMask)
        return false;
    uint cursor = 0u;
    [loop]
    for (uint candidate = 0u; candidate < count; ++candidate)
    {
        SigmaConstraintCertificateGpu previous = _Certificates[
            SigmaCertificateAddress(sourceProofSlot, block, candidate)];
        if (any(previous.identity != LedgerIdentity[candidate]) ||
            previous.range.x != LedgerRange[candidate].x ||
            previous.range.z != LedgerRange[candidate].z ||
            previous.range.w != LedgerRange[candidate].w ||
            any(previous.sampleMask != LedgerSampleMask[candidate]))
            return false;
        [loop]
        for (uint lane = 0u; lane < 16u; ++lane)
        {
            if ((LedgerIdentity[candidate].x & (1u << lane)) == 0u)
                continue;
            SigmaQ48Bounds a = SigmaCandidateBound(candidate, lane);
            SigmaQ48Bounds b = _CertificateBounds[
                SigmaCertificateBoundAddress(sourceProofSlot, block, cursor)];
            if (!SigmaU64Equal(a.lo, b.lo) || !SigmaU64Equal(a.hi, b.hi))
                return false;
            cursor++;
        }
    }
    return true;
}

[numthreads(64, 1, 1)]
void ClearProofTransaction(uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint workIndex = _UseInverseWorkList != 0u ? groupId.y : 0u;
    uint sample = groupId.x * 64u + groupThreadId.x;
    if (_UseInverseWorkList != 0u &&
        workIndex >= _InverseWorkControl[2u])
        return;
    uint targetProofSlot = _UseInverseWorkList != 0u
        ? _InverseWork[workIndex].slots.w : _TargetProofSlot;
    if (sample < SIGMA_PAGE_SAMPLE_COUNT)
        _ProofSamples[workIndex * SIGMA_PAGE_SAMPLE_COUNT + sample] =
            (SigmaProofSampleGpu)0;
    if (sample < SIGMA_PROOF_STATUS_STRIDE)
        _ProofPageStatus[SigmaProofStatusAddress(targetProofSlot, sample)] = 0u;
    if (sample < SIGMA_CERTIFICATE_BLOCKS_PER_PAGE)
        _RawRequests[workIndex * SIGMA_CERTIFICATE_BLOCKS_PER_PAGE + sample] =
            (SigmaRawRetentionRequestGpu)0;
}

#define SIGMA_PROOF_SOURCE_COUNT 4u
#define SIGMA_PROOF_SOURCE_META_RECORDS 3u

uint SigmaProofSourceScratchIndex(uint workIndex, uint block, uint source)
{
    return (workIndex * SIGMA_CERTIFICATE_BLOCKS_PER_PAGE + block) *
        SIGMA_PROOF_SOURCE_COUNT + source;
}

uint SigmaProofSourceMetaAddress(uint workIndex, uint block, uint source,
    uint record)
{
    return SigmaProofSourceScratchIndex(workIndex, block, source) *
        SIGMA_PROOF_SOURCE_META_RECORDS + record;
}

uint SigmaProofSourceBoundAddress(uint workIndex, uint block, uint source,
    uint coordinate)
{
    return SigmaProofSourceScratchIndex(workIndex, block, source) * 16u +
        coordinate;
}

// One independent source plane per workgroup. The dispatch z dimension is the
// canonical source order DepthL, DepthR, RGBL, RGBR. Each 64-lane group reduces
// one complete 8x8 proof block and writes one fixed scratch candidate. No
// barrier-bearing helper is recursively inlined four times.
[numthreads(64, 1, 1)]
void ReduceProofSources(uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint block = groupId.x;
    uint workIndex = _UseInverseWorkList != 0u ? groupId.y : 0u;
    uint source = groupId.z;
    uint lane = groupThreadId.x;
    if ((_UseInverseWorkList != 0u &&
            workIndex >= _InverseWorkControl[2u]) ||
        !SigmaCanonicalMutationEnabled() ||
        block >= SIGMA_CERTIFICATE_BLOCKS_PER_PAGE ||
        source >= SIGMA_PROOF_SOURCE_COUNT)
        return;

    uint proofSampleBase = workIndex * SIGMA_PAGE_SAMPLE_COUNT;
    SigmaProofSampleGpu proof = _ProofSamples[proofSampleBase +
        SigmaProofPageSample(block, lane)];
    SigmaQ48Bounds incoming[16];
    uint incomingMask;
    uint incomingSource;
    uint incomingKey;
    uint incomingRole;
    bool present = SigmaSourceCell(source, proof, incomingMask, incomingSource,
        incomingKey, incomingRole, incoming);
    if (!present)
    {
        incomingMask = 0u;
        incomingSource = 0u;
        incomingKey = 0u;
        incomingRole = 0u;
    }
    ProofSourceIdentity[lane] = uint4(incomingMask, incomingSource,
        incomingKey, incomingRole);
    [unroll]
    for (uint coordinate = 0u; coordinate < 16u; ++coordinate)
        ProofSourceBounds[lane * 16u + coordinate] = incoming[coordinate];
    ProofReduce[lane] = uint4(incomingMask, incomingRole, 0u, 0u);

    uint status = proof.meta.x;
    uint reason = 0u;
    if ((status & SIGMA_PROPOSAL_CONFLICT) != 0u)
        reason |= SIGMA_RAW_REASON_CONFLICT;
    if ((status & SIGMA_PROPOSAL_EXCLUSION) != 0u)
        reason |= SIGMA_RAW_REASON_EXCLUSION;
    if ((status & SIGMA_PROPOSAL_RGB_UNOBSERVABLE) != 0u && proof.meta.z != 0u)
        reason |= SIGMA_RAW_REASON_UNOBSERVABLE;
    ProofRawReduce[lane] = source == 0u ? uint4(reason,
        lane < 32u && reason != 0u ? (1u << lane) : 0u,
        lane >= 32u && reason != 0u ? (1u << (lane - 32u)) : 0u, 0u) : 0u;
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint offset = 32u; offset > 0u; offset >>= 1u)
    {
        if (lane < offset)
        {
            uint other = lane + offset;
            uint4 a = ProofReduce[lane];
            uint4 b = ProofReduce[other];
            uint mismatch = a.z | b.z;
            [unroll]
            for (uint coordinate = 0u; coordinate < 16u; ++coordinate)
            {
                uint bit = 1u << coordinate;
                bool hasA = (a.x & bit) != 0u;
                bool hasB = (b.x & bit) != 0u;
                if (!hasB)
                    continue;
                SigmaQ48Bounds bb = ProofSourceBounds[other * 16u +
                    coordinate];
                if (!hasA)
                {
                    ProofSourceBounds[lane * 16u + coordinate] = bb;
                    continue;
                }
                SigmaQ48Bounds aa = ProofSourceBounds[lane * 16u +
                    coordinate];
                mismatch |= !SigmaU64Equal(aa.lo, bb.lo) ||
                    !SigmaU64Equal(aa.hi, bb.hi) ? 1u : 0u;
                aa.lo = SigmaQ48Min(aa.lo, bb.lo);
                aa.hi = SigmaQ48Max(aa.hi, bb.hi);
                ProofSourceBounds[lane * 16u + coordinate] = aa;
            }
            ProofReduce[lane] = uint4(a.x | b.x, a.y | b.y, mismatch, 0u);
            ProofRawReduce[lane] |= ProofRawReduce[other];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    uint scratch = SigmaProofSourceScratchIndex(workIndex, block, source);
    uint coordinateMask = ProofReduce[0u].x;
    if (lane < 16u)
    {
        SigmaQ48Bounds bound = SigmaFullBounds();
        if ((coordinateMask & (1u << lane)) != 0u)
            bound = ProofSourceBounds[lane];
        _ProofSourceScratchBounds[scratch * 16u + lane] = bound;
    }
    if (lane != 0u)
        return;

    uint2 sourceSamples = 0u;
    uint2 laneSamples[16];
    [unroll]
    for (uint coordinate = 0u; coordinate < 16u; ++coordinate)
        laneSamples[coordinate] = 0u;
    bool requiresRawCell = ProofReduce[0u].z != 0u;
    uint sourceClass = 0u;
    uint key = 0u;
    [loop]
    for (uint local = 0u; local < 64u; ++local)
    {
        uint4 identity = ProofSourceIdentity[local];
        if (identity.x == 0u)
            continue;
        if (key != 0u && (key != identity.z || sourceClass != identity.y))
            requiresRawCell = true;
        key = key == 0u ? identity.z : key;
        sourceClass = sourceClass == 0u ? identity.y : sourceClass;
        SigmaSetMaskBit(sourceSamples, local);
        [unroll]
        for (uint coordinate = 0u; coordinate < 16u; ++coordinate)
            if ((identity.x & (1u << coordinate)) != 0u)
                SigmaSetMaskBit(laneSamples[coordinate], local);
    }
    [unroll]
    for (uint coordinate = 0u; coordinate < 16u; ++coordinate)
        if ((coordinateMask & (1u << coordinate)) != 0u &&
            any(laneSamples[coordinate] != sourceSamples))
            requiresRawCell = true;

    uint meta = scratch * SIGMA_PROOF_SOURCE_META_RECORDS;
    _ProofSourceScratchMeta[meta + 0u] = uint4(coordinateMask, sourceClass,
        key, _ProofCalibrationEpoch);
    _ProofSourceScratchMeta[meta + 1u] = uint4(ProofReduce[0u].y,
        sourceSamples, requiresRawCell ? 1u : 0u);
    _ProofSourceScratchMeta[meta + 2u] = source == 0u
        ? ProofRawReduce[0u] : 0u;
}

// Candidate count is at most eight. Source aggregation above owns all 64-sample
// work; this bounded finalizer preserves the existing canonical lexicographic,
// coalesce and reverse-redundancy order byte-for-byte.
[numthreads(1, 1, 1)]
void FinalizeProofPage(uint3 groupId : SV_GroupID)
{
    uint block = groupId.x;
    uint workIndex = _UseInverseWorkList != 0u ? groupId.y : 0u;
    if ((_UseInverseWorkList != 0u &&
            workIndex >= _InverseWorkControl[2u]) ||
        !SigmaCanonicalMutationEnabled() ||
        block >= SIGMA_CERTIFICATE_BLOCKS_PER_PAGE)
        return;

    SigmaInverseWorkGpu work = (SigmaInverseWorkGpu)0;
    if (_UseInverseWorkList != 0u)
        work = _InverseWork[workIndex];
    uint sourceProofSlot = _UseInverseWorkList != 0u
        ? work.slots.z : _SourceProofSlot;
    uint targetProofSlot = _UseInverseWorkList != 0u
        ? work.slots.w : _TargetProofSlot;
    uint proofCalibrationEpoch = _ProofCalibrationEpoch;
    uint proofRevision = _UseInverseWorkList != 0u
        ? work.control.w : _ProofRevision;
    uint proofSampleBase = workIndex * SIGMA_PAGE_SAMPLE_COUNT;

    [unroll]
    for (uint candidate = 0u; candidate < SIGMA_LEDGER_CANDIDATE_CAPACITY;
        ++candidate)
        SigmaClearCandidate(candidate);
    uint candidateCount = SigmaLoadPriorCertificates(block, sourceProofSlot);
    uint rawMeta = SigmaProofSourceMetaAddress(workIndex, block, 0u, 2u);
    uint4 rawSummary = _ProofSourceScratchMetaRead[rawMeta];
    uint rawReasons = rawSummary.x;
    uint2 rawSamples = rawSummary.yz;

    [unroll]
    for (uint source = 0u; source < SIGMA_PROOF_SOURCE_COUNT; ++source)
    {
        uint scratch = SigmaProofSourceScratchIndex(workIndex, block, source);
        uint meta = scratch * SIGMA_PROOF_SOURCE_META_RECORDS;
        uint4 identity = _ProofSourceScratchMetaRead[meta + 0u];
        uint4 range = _ProofSourceScratchMetaRead[meta + 1u];
        if (identity.x == 0u)
            continue;
        if (range.w != 0u)
        {
            rawReasons |= SIGMA_RAW_REASON_NONUNIFORM_CELL;
            rawSamples |= range.yz;
        }
        if (candidateCount >= SIGMA_LEDGER_CANDIDATE_CAPACITY)
        {
            rawReasons |= SIGMA_RAW_REASON_CERTIFICATE_OVERFLOW;
            rawSamples |= range.yz;
            continue;
        }
        uint candidate = candidateCount++;
        SigmaClearCandidate(candidate);
        LedgerIdentity[candidate] = identity;
        LedgerRange[candidate] = uint4(range.x, 0u,
            countbits(identity.x), SIGMA_CERTIFICATE_ACTIVE);
        LedgerSampleMask[candidate] = range.yz;
        [unroll]
        for (uint coordinate = 0u; coordinate < 16u; ++coordinate)
            SigmaSetCandidateBound(candidate, coordinate,
                _ProofSourceScratchBoundsRead[scratch * 16u + coordinate]);
    }

    // Canonical lexicographic order.
    [loop]
    for (uint sortPass = 0u; sortPass < candidateCount; ++sortPass)
    [loop]
    for (uint index = 0u; index + 1u < candidateCount - sortPass; ++index)
        if (SigmaCertificateLess(index + 1u, index))
            SigmaSwapCandidates(index, index + 1u);

    // Identical-source records coalesce only when their exact meet is non-empty.
    uint coalesce = 0u;
    [loop]
    while (coalesce + 1u < candidateCount)
    {
        if (!SigmaSameCoalesceKey(coalesce, coalesce + 1u))
        {
            coalesce++;
            continue;
        }
        uint unionMask = LedgerIdentity[coalesce].x |
            LedgerIdentity[coalesce + 1u].x;
        bool empty = false;
        [loop]
        for (uint lane = 0u; lane < 16u; ++lane)
        {
            if ((unionMask & (1u << lane)) == 0u)
                continue;
            SigmaQ48Bounds a = SigmaCandidateBound(coalesce, lane);
            SigmaQ48Bounds b = SigmaCandidateBound(coalesce + 1u, lane);
            SigmaQ48Bounds meet;
            meet.lo = SigmaQ48Max(a.lo, b.lo);
            meet.hi = SigmaQ48Min(a.hi, b.hi);
            empty = empty || SigmaQ48Less(meet.hi, meet.lo);
            SigmaSetCandidateBound(coalesce, lane, meet);
        }
        if (empty)
        {
            LedgerRange[coalesce].w |= SIGMA_CERTIFICATE_UNRESOLVED;
            LedgerRange[coalesce + 1u].w |= SIGMA_CERTIFICATE_UNRESOLVED;
            rawReasons |= SIGMA_RAW_REASON_CONFLICT;
            coalesce++;
            continue;
        }
        LedgerIdentity[coalesce].x = unionMask;
        LedgerRange[coalesce].z = countbits(unionMask);
        LedgerSampleMask[coalesce] |= LedgerSampleMask[coalesce + 1u];
        SigmaRemoveCandidate(candidateCount, coalesce + 1u);
    }

    SigmaQ48Bounds targetMeet[16];
    uint targetMask;
    uint targetRole;
    uint targetIndependent;
    SigmaComputeCandidateMeet(candidateCount, -1, targetMask, targetRole,
        targetIndependent, targetMeet);
    bool removed;
    uint redundancySweeps = 0u;
    do
    {
        removed = false;
        [loop]
        for (int candidate = (int)candidateCount - 1; candidate >= 0;
            --candidate)
        {
            if ((LedgerRange[candidate].w & SIGMA_CERTIFICATE_UNRESOLVED) != 0u)
                continue;
            SigmaQ48Bounds trialMeet[16];
            uint trialMask;
            uint trialRole;
            uint trialIndependent;
            SigmaComputeCandidateMeet(candidateCount, candidate, trialMask,
                trialRole, trialIndependent, trialMeet);
            if (!SigmaSameProofResult(targetMask, targetRole,
                    targetIndependent, targetMeet, trialMask, trialRole,
                    trialIndependent, trialMeet))
                continue;
            SigmaRemoveCandidate(candidateCount, (uint)candidate);
            removed = true;
        }
        redundancySweeps++;
    } while (removed && redundancySweeps < SIGMA_LEDGER_CANDIDATE_CAPACITY);

    uint storedCount = min(candidateCount, SIGMA_CERTIFICATES_PER_BLOCK);
    uint boundCount = 0u;
    [loop]
    for (uint stored = 0u; stored < storedCount; ++stored)
        boundCount += countbits(LedgerIdentity[stored].x);
    if (candidateCount > SIGMA_CERTIFICATES_PER_BLOCK ||
        boundCount > SIGMA_CERTIFICATE_BOUNDS_PER_BLOCK)
    {
        rawReasons |= SIGMA_RAW_REASON_CERTIFICATE_OVERFLOW;
        rawSamples = uint2(0xffffffffu, 0xffffffffu);
        while (storedCount > 0u && boundCount >
            SIGMA_CERTIFICATE_BOUNDS_PER_BLOCK)
        {
            storedCount--;
            boundCount -= countbits(LedgerIdentity[storedCount].x);
        }
    }

    bool proofEqual = SigmaProofEqualsSource(block, sourceProofSlot,
        storedCount, boundCount, targetMask, targetRole, targetIndependent);
    uint outputBound = 0u;
    [loop]
    for (uint certificate = 0u; certificate <
        SIGMA_CERTIFICATES_PER_BLOCK; ++certificate)
    {
        SigmaConstraintCertificateGpu output = (SigmaConstraintCertificateGpu)0;
        if (certificate < storedCount)
        {
            output.identity = LedgerIdentity[certificate];
            output.range = LedgerRange[certificate];
            output.range.y = outputBound;
            output.range.z = countbits(output.identity.x);
            output.sampleMask = LedgerSampleMask[certificate];
            [loop]
            for (uint lane = 0u; lane < 16u; ++lane)
            {
                if ((output.identity.x & (1u << lane)) == 0u)
                    continue;
                _CertificateBounds[SigmaCertificateBoundAddress(
                    targetProofSlot, block, outputBound++)] =
                    SigmaCandidateBound(certificate, lane);
            }
        }
        _Certificates[SigmaCertificateAddress(targetProofSlot, block,
            certificate)] = output;
    }
    [loop]
    for (uint clearBound = outputBound; clearBound <
        SIGMA_CERTIFICATE_BOUNDS_PER_BLOCK; ++clearBound)
        _CertificateBounds[SigmaCertificateBoundAddress(targetProofSlot,
            block, clearBound)] = (SigmaQ48Bounds)0;

    uint priorRawHead = SIGMA_INVALID_RAW_TILE;
    if (sourceProofSlot != SIGMA_INVALID_PROOF_SLOT)
        priorRawHead = _ConstraintBlocks[SigmaConstraintBlockAddress(
            sourceProofSlot, block)].counts.z;
    uint rawHead = priorRawHead;
    uint rawRequestIndex = workIndex * SIGMA_CERTIFICATE_BLOCKS_PER_PAGE + block;
    _RawRequests[rawRequestIndex].value = uint4(rawReasons, rawSamples,
        priorRawHead);
    // The retained CPU/reference fixture path owns reservations up front. The
    // live GPU graph defers payload/frame publication until the stable parallel
    // planner has assigned only the requests that survived proof reduction.
    if (rawReasons != 0u && _UseInverseWorkList == 0u)
    {
        uint reservation = _RawReservations[
            targetProofSlot * SIGMA_CERTIFICATE_BLOCKS_PER_PAGE + block];
        if (reservation >= _RawTileCapacity)
        {
            InterlockedOr(_ProofPageStatus[SigmaProofStatusAddress(
                targetProofSlot, 1u)], SIGMA_PROOF_FAILED);
        }
        else
        {
            SigmaRawObservationTileGpu raw;
            raw.identity = uint4(priorRawHead, _ProofFrameSlot,
                (targetProofSlot << 6u) | block, proofRevision);
            raw.provenance = uint4(rawReasons, proofCalibrationEpoch,
                rawSamples.x, rawSamples.y);
            _RawTiles[reservation] = raw;
            [loop]
            for (uint local = 0u; local < 64u; ++local)
            [unroll]
            for (uint word = 0u; word < SIGMA_RAW_WORD4_PER_SAMPLE; ++word)
                _RawTileWords[reservation * SIGMA_RAW_WORD4_PER_TILE +
                    local * SIGMA_RAW_WORD4_PER_SAMPLE + word] =
                    _ProofSamples[proofSampleBase +
                        SigmaProofPageSample(block, local)].raw[word];
            rawHead = reservation;
            uint statusWord = block < 32u ? 2u : 3u;
            uint bit = 1u << (block & 31u);
            InterlockedOr(_ProofPageStatus[SigmaProofStatusAddress(
                targetProofSlot, statusWord)], bit);
            InterlockedOr(_ProofPageStatus[SigmaProofStatusAddress(
                targetProofSlot, 1u)], SIGMA_PROOF_RAW_CHANGED);
        }
    }
    if (!proofEqual)
        InterlockedOr(_ProofPageStatus[SigmaProofStatusAddress(
            targetProofSlot, 1u)], SIGMA_PROOF_SET_CHANGED);
    InterlockedOr(_ProofPageStatus[SigmaProofStatusAddress(
        targetProofSlot, 7u)], rawReasons);
    InterlockedAdd(_ProofPageStatus[SigmaProofStatusAddress(
        targetProofSlot, 6u)], storedCount);

    SigmaConstraintBlockGpu blockOutput;
    blockOutput.counts = uint4(storedCount, outputBound, rawHead,
        rawReasons != 0u ? 1u : 0u);
    blockOutput.proof = uint4(targetMask, targetRole, targetIndependent,
        proofRevision);
    _ConstraintBlocks[SigmaConstraintBlockAddress(targetProofSlot, block)] =
        blockOutput;
    InterlockedAdd(_ProofPageStatus[SigmaProofStatusAddress(
        targetProofSlot, 0u)], 1u);
}

// The live reducer first finishes the exact certificate decision. Only then can
// raw retention be planned without reserving one durable slot per submitted
// frame. One lane copies one finite-footprint sample; lane zero publishes the
// tile header, the same-frame pose gauge and the new immutable raw-chain head.
[numthreads(64, 1, 1)]
void CommitRawProof(uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint block = groupId.x;
    uint workIndex = groupId.y;
    uint local = groupThreadId.x;
    if (!SigmaCanonicalMutationEnabled() ||
        workIndex >= _InverseWorkControl[2u] ||
        block >= SIGMA_CERTIFICATE_BLOCKS_PER_PAGE)
        return;

    SigmaInverseWorkGpu work = _InverseWork[workIndex];
    uint targetProofSlot = work.slots.w;
    uint requestIndex = workIndex * SIGMA_CERTIFICATE_BLOCKS_PER_PAGE + block;
    uint4 request = _RawRequests[requestIndex].value;
    if (request.x == 0u)
        return;

    uint reservation = _RawReservations[
        targetProofSlot * SIGMA_CERTIFICATE_BLOCKS_PER_PAGE + block];
    if (reservation >= _RawTileCapacity)
    {
        if (local == 0u)
            InterlockedOr(_ProofPageStatus[SigmaProofStatusAddress(
                targetProofSlot, 1u)], SIGMA_PROOF_FAILED);
        return;
    }

    uint proofSampleBase = workIndex * SIGMA_PAGE_SAMPLE_COUNT;
    [unroll]
    for (uint word = 0u; word < SIGMA_RAW_WORD4_PER_SAMPLE; ++word)
        _RawTileWords[reservation * SIGMA_RAW_WORD4_PER_TILE +
            local * SIGMA_RAW_WORD4_PER_SAMPLE + word] =
            _ProofSamples[proofSampleBase +
                SigmaProofPageSample(block, local)].raw[word];

    if (local != 0u)
        return;

    SigmaRawObservationTileGpu raw;
    raw.identity = uint4(request.w, reservation,
        (targetProofSlot << 6u) | block, work.control.w);
    raw.provenance = uint4(request.x, _ProofCalibrationEpoch,
        request.y, request.z);
    _RawTiles[reservation] = raw;

    SigmaRawFrameRecordGpu frame = _RawFrameStaging[0u];
    frame.word[33u] = _PoseResult[0u];
    frame.word[34u] = _PoseResult[1u];
    frame.word[35u] = _PoseResult[2u];
    frame.word[36u] = _PoseResult[3u];
    _RawFrameRecords[reservation] = frame;

    uint blockAddress = SigmaConstraintBlockAddress(targetProofSlot, block);
    SigmaConstraintBlockGpu blockOutput = _ConstraintBlocks[blockAddress];
    blockOutput.counts.z = reservation;
    blockOutput.counts.w = 1u;
    _ConstraintBlocks[blockAddress] = blockOutput;

    uint statusWord = block < 32u ? 2u : 3u;
    uint bit = 1u << (block & 31u);
    InterlockedOr(_ProofPageStatus[SigmaProofStatusAddress(
        targetProofSlot, statusWord)], bit);
    InterlockedOr(_ProofPageStatus[SigmaProofStatusAddress(
        targetProofSlot, 1u)], SIGMA_PROOF_RAW_CHANGED);
}
