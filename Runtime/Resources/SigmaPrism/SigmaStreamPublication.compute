#pragma kernel PreparePublicationManifest
#pragma kernel PublishPublicationManifest
#pragma kernel ResolvePublishedPageCaches
#pragma kernel RetirePublishedTransaction
#pragma kernel InitializeManifestVisibility
#pragma target 5.0

#include "SigmaOperatorPlan.hlsl"
#include "SigmaConstraintLedgerAbi.hlsl"
#include "SigmaInverseWorkAbi.hlsl"
#include "SigmaManifestVisibility.hlsl"

StructuredBuffer<SigmaStreamWorkItemGpu> _StreamWorkItems;
StructuredBuffer<uint> _StreamWorkCounts;
StructuredBuffer<SigmaConstraintBlockGpu> _ConstraintBlocks;

RWStructuredBuffer<SigmaTransactionGpu> _StreamTransactions;
RWStructuredBuffer<SigmaSealedSourceBundleGpu> _StreamBundles;
RWStructuredBuffer<SigmaSourceHandleSegmentGpu> _StreamSourceSegments;
RWStructuredBuffer<uint4> _StreamAssociationOwners;
RWStructuredBuffer<SigmaPublicationManifestGpu> _StreamManifests;
RWStructuredBuffer<SigmaPageVisibilityGpu> _StreamPageVisibility;
RWStructuredBuffer<SigmaCarrierPageMetaGpu> _PageMetadata;
RWStructuredBuffer<uint> _CurrentFlags;
RWStructuredBuffer<uint> _DirtyFlags;
RWStructuredBuffer<uint> _ReadoutDirtyFlags;
RWStructuredBuffer<uint> _RawLiveWords;
RWStructuredBuffer<uint> _StreamSchedulerControl;
RWStructuredBuffer<SigmaStreamDiagnosticGpu> _StreamDiagnostics;

uint _PageCapacity;
uint _StreamManifestCapacity;
uint _StreamSourceSegmentCapacity;
uint _RawTileCapacity;

// Existing S4-02 single-page publications enter the same visibility contract
// once.  This is a GPU-only bridge for representation-neutral carrier lifetime,
// not a second publication authority; every later reader resolves this handle.
[numthreads(64, 1, 1)]
void InitializeManifestVisibility(uint3 id : SV_DispatchThreadID)
{
    uint slot = id.x;
    if (slot >= _PageCapacity || slot >= _StreamManifestCapacity ||
        _CurrentFlags[slot] == 0u)
        return;
    SigmaCarrierPageMetaGpu metadata = _PageMetadata[slot];
    if ((metadata.flags & SIGMA_PAGE_PUBLISHED) == 0u)
        return;
    SigmaPageVisibilityGpu visibility = _StreamPageVisibility[slot];
    if (SigmaManifestHandleValid(visibility.bornRetired.xy,
            _StreamManifestCapacity))
        return;
    SigmaPublicationManifestGpu previous = _StreamManifests[slot];
    uint generation = previous.identity.y + 1u;
    if (generation == 0u)
        return;
    SigmaPublicationManifestGpu manifest =
        (SigmaPublicationManifestGpu)0;
    manifest.identity = uint4(SIGMA_STREAM_MANIFEST_PUBLISHED, generation,
        metadata.revision, SIGMA_STREAM_INVALID);
    manifest.closure = uint4(1u, 1u, 1u, 1u);
    manifest.pages = uint4(slot, SIGMA_STREAM_INVALID,
        SIGMA_STREAM_INVALID, SIGMA_STREAM_INVALID);
    _StreamManifests[slot] = manifest;
    visibility.bornRetired = uint4(slot, generation,
        SIGMA_STREAM_INVALID, 0u);
    visibility.pins = uint4(0u, 0u, metadata.generation, 0u);
    _StreamPageVisibility[slot] = visibility;
}

bool SigmaPublicationWork(uint workIndex, uint requiredState,
    out uint slot, out SigmaTransactionGpu transaction)
{
    slot = SIGMA_STREAM_INVALID;
    transaction = (SigmaTransactionGpu)0;
    if (workIndex >= _StreamWorkCounts[
            SIGMA_STREAM_OPCODE_PUBLISH_MANIFEST] ||
        !SigmaCanonicalMutationEnabled())
        return false;
    SigmaStreamWorkItemGpu work = _StreamWorkItems[SigmaStreamWorkAddress(
        SIGMA_STREAM_OPCODE_PUBLISH_MANIFEST, workIndex)];
    slot = work.identity.y;
    if (slot >= SIGMA_STREAM_TRANSACTION_CAPACITY)
        return false;
    transaction = _StreamTransactions[slot];
    return SigmaStreamTransactionGeneration(transaction) == work.identity.z &&
        SigmaStreamTransactionState(transaction) == requiredState;
}

SigmaStreamPageReferenceGpu SigmaPublicationPage(
    SigmaTransactionGpu transaction, uint index)
{
    if (index == 0u)
        return transaction.page0;
    if (index == 1u)
        return transaction.page1;
    if (index == 2u)
        return transaction.page2;
    return transaction.page3;
}

uint SigmaPublicationPageCount(SigmaTransactionGpu transaction)
{
    uint count = 0u;
    [unroll]
    for (uint index = 0u; index < SIGMA_STREAM_MAX_PAGES; ++index)
    {
        SigmaStreamPageReferenceGpu page = SigmaPublicationPage(transaction,
            index);
        count += page.state.y < _PageCapacity ? 1u : 0u;
    }
    return count;
}

[numthreads(4, 1, 1)]
void PreparePublicationManifest(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint transactionSlot;
    SigmaTransactionGpu transaction;
    if (!SigmaPublicationWork(groupId.x,
            SIGMA_STREAM_TRANSACTION_PUBLISHABLE, transactionSlot,
            transaction))
        return;

    uint lane = threadId.x;
    uint pageCount = SigmaPublicationPageCount(transaction);
    if (pageCount == 0u)
        return;
    uint manifestSlot = transaction.page0.state.y;
    if (manifestSlot >= _StreamManifestCapacity)
        return;
    if (lane == 0u)
    {
        SigmaPublicationManifestGpu previous =
            _StreamManifests[manifestSlot];
        uint generation = previous.identity.y + 1u;
        if (generation == 0u)
        {
            transaction.identity.x = SIGMA_STREAM_TRANSACTION_FAILED;
            _StreamTransactions[transactionSlot] = transaction;
            return;
        }
        SigmaPublicationManifestGpu manifest =
            (SigmaPublicationManifestGpu)0;
        manifest.identity = uint4(SIGMA_STREAM_MANIFEST_PREPARING,
            generation, transaction.ticket.z, transactionSlot);
        manifest.closure = uint4(pageCount, pageCount, 1u, 1u);
        manifest.pages = uint4(transaction.page0.state.y,
            transaction.page1.state.y, transaction.page2.state.y,
            transaction.page3.state.y);
        _StreamManifests[manifestSlot] = manifest;
        transaction.publication = uint4(manifestSlot, generation,
            pageCount, 0u);
        _StreamTransactions[transactionSlot] = transaction;
    }
    DeviceMemoryBarrierWithGroupSync();
    transaction = _StreamTransactions[transactionSlot];
    uint2 manifestHandle = transaction.publication.xy;
    if (!SigmaManifestHandleValid(manifestHandle,
            _StreamManifestCapacity) || lane >= pageCount)
        return;

    SigmaStreamPageReferenceGpu page = SigmaPublicationPage(transaction,
        lane);
    uint target = page.state.y;
    uint source = page.state.x;
    if (target >= _PageCapacity)
        return;
    SigmaPageVisibilityGpu targetVisibility =
        (SigmaPageVisibilityGpu)0;
    targetVisibility.bornRetired = uint4(manifestHandle,
        SIGMA_STREAM_INVALID, 0u);
    targetVisibility.pins = uint4(transaction.ticket.xy,
        SigmaStreamTransactionGeneration(transaction), 0u);
    _StreamPageVisibility[target] = targetVisibility;
    if (source < _PageCapacity)
    {
        SigmaPageVisibilityGpu sourceVisibility =
            _StreamPageVisibility[source];
        sourceVisibility.bornRetired.zw = manifestHandle;
        _StreamPageVisibility[source] = sourceVisibility;
    }
    SigmaCarrierPageMetaGpu metadata = _PageMetadata[target];
    metadata.flags |= SIGMA_PAGE_ALLOCATED | SIGMA_PAGE_PUBLISHED |
        SIGMA_PAGE_DIRTY;
    metadata.revision = transaction.ticket.z;
    _PageMetadata[target] = metadata;
}

[numthreads(1, 1, 1)]
void PublishPublicationManifest(uint3 groupId : SV_GroupID)
{
    uint transactionSlot;
    SigmaTransactionGpu transaction;
    if (!SigmaPublicationWork(groupId.x,
            SIGMA_STREAM_TRANSACTION_PUBLISHABLE, transactionSlot,
            transaction))
        return;
    uint2 handle = transaction.publication.xy;
    if (!SigmaManifestHandleValid(handle, _StreamManifestCapacity))
        return;
    SigmaPublicationManifestGpu manifest = _StreamManifests[handle.x];
    if (manifest.identity.x != SIGMA_STREAM_MANIFEST_PREPARING ||
        manifest.identity.y != handle.y || manifest.closure.x == 0u ||
        manifest.closure.x != manifest.closure.y ||
        manifest.closure.z == 0u || manifest.closure.w == 0u)
        return;
    DeviceMemoryBarrier();
    manifest.identity.x = SIGMA_STREAM_MANIFEST_PUBLISHED;
    _StreamManifests[handle.x] = manifest;
    transaction.identity.x = SIGMA_STREAM_TRANSACTION_PUBLISHED;
    _StreamTransactions[transactionSlot] = transaction;
}

[numthreads(4, 1, 1)]
void ResolvePublishedPageCaches(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint transactionSlot;
    SigmaTransactionGpu transaction;
    if (!SigmaPublicationWork(groupId.x,
            SIGMA_STREAM_TRANSACTION_PUBLISHED, transactionSlot,
            transaction))
        return;
    uint2 handle = transaction.publication.xy;
    if (!SigmaManifestHandleValid(handle, _StreamManifestCapacity))
        return;
    SigmaPublicationManifestGpu manifest = _StreamManifests[handle.x];
    if (!SigmaManifestHandlePublished(handle, manifest))
        return;
    uint lane = threadId.x;
    uint pageCount = transaction.publication.z;
    if (lane >= pageCount)
        return;
    SigmaStreamPageReferenceGpu page = SigmaPublicationPage(transaction,
        lane);
    uint target = page.state.y;
    uint source = page.state.x;
    if (target >= _PageCapacity)
        return;
    _CurrentFlags[target] = 1u;
    _DirtyFlags[target] = 1u;
    _ReadoutDirtyFlags[target] = 1u;
    if (source < _PageCapacity && source != target)
        _CurrentFlags[source] = 0u;
}

bool SigmaPublicationRetainsRaw(uint proofSlot)
{
    if (proofSlot >= _PageCapacity)
        return true;
    [unroll]
    for (uint block = 0u; block < SIGMA_CERTIFICATE_BLOCKS_PER_PAGE; ++block)
        if (_ConstraintBlocks[SigmaConstraintBlockAddress(proofSlot,
                block)].counts.w != 0u)
            return true;
    return false;
}

void SigmaPublicationReleaseAssociation(uint bundleSlot,
    SigmaSealedSourceBundleGpu bundle)
{
    uint association = bundle.raw.z;
    if (association >= SIGMA_STREAM_TRANSACTION_CAPACITY)
        return;
    uint4 owner = _StreamAssociationOwners[association];
    if (owner.x == bundleSlot && owner.y ==
            SigmaStreamBundleGeneration(bundle))
        _StreamAssociationOwners[association] =
            uint4(SIGMA_STREAM_INVALID, 0u, 0u, 0u);
}

[numthreads(1, 1, 1)]
void RetirePublishedTransaction(uint3 groupId : SV_GroupID)
{
    uint transactionSlot;
    SigmaTransactionGpu transaction;
    if (!SigmaPublicationWork(groupId.x,
            SIGMA_STREAM_TRANSACTION_PUBLISHED, transactionSlot,
            transaction))
        return;
    uint2 handle = transaction.publication.xy;
    if (!SigmaManifestHandleValid(handle, _StreamManifestCapacity) ||
        !SigmaManifestHandlePublished(handle, _StreamManifests[handle.x]))
        return;

    bool retainRaw = SigmaPublicationRetainsRaw(transaction.page0.state.y);
    uint segmentSlot = transaction.source.x;
    uint segmentGeneration = transaction.source.y;
    uint remaining = transaction.source.z;
    [loop]
    for (uint visited = 0u; visited < _StreamSourceSegmentCapacity &&
        remaining > 0u; ++visited)
    {
        if (!SigmaStreamHandleValid(segmentSlot, segmentGeneration,
                _StreamSourceSegmentCapacity))
            return;
        SigmaSourceHandleSegmentGpu segment =
            _StreamSourceSegments[segmentSlot];
        if (!SigmaStreamSourceSegmentValid(segment, segmentGeneration) ||
            segment.identity.x != SIGMA_STREAM_SOURCE_SEGMENT_SEALED)
            return;
        uint count = min(remaining, segment.identity.z);
        [loop]
        for (uint offset = 0u; offset < count; ++offset)
        {
            uint2 sourceHandle = SigmaStreamSourceHandle(segment, offset);
            if (!SigmaStreamHandleValid(sourceHandle.x, sourceHandle.y,
                    SIGMA_STREAM_BUNDLE_CAPACITY))
                return;
            SigmaSealedSourceBundleGpu bundle =
                _StreamBundles[sourceHandle.x];
            if (SigmaStreamBundleGeneration(bundle) != sourceHandle.y)
                return;
            SigmaPublicationReleaseAssociation(sourceHandle.x, bundle);
            if (retainRaw)
            {
                bundle.identity.x = SIGMA_STREAM_BUNDLE_DORMANT;
                bundle.identity.w &=
                    ~SIGMA_STREAM_BUNDLE_FLAG_HAS_ASSOCIATION;
                bundle.raw.z = SIGMA_STREAM_INVALID;
                _StreamBundles[sourceHandle.x] = bundle;
            }
            else
            {
                uint generation = bundle.identity.y;
                uint liveWord = bundle.raw.x >> 5u;
                if (liveWord + 1u < (_RawTileCapacity + 31u) / 32u)
                {
                    _RawLiveWords[liveWord] = 0u;
                    _RawLiveWords[liveWord + 1u] = 0u;
                }
                bundle = (SigmaSealedSourceBundleGpu)0;
                bundle.identity.y = generation;
                _StreamBundles[sourceHandle.x] = bundle;
            }
        }
        remaining -= count;
        uint nextSlot = segment.link.x;
        uint nextGeneration = segment.link.y;
        SigmaSourceHandleSegmentGpu cleared =
            (SigmaSourceHandleSegmentGpu)0;
        cleared.identity.y = segment.identity.y;
        cleared.link.x = SIGMA_STREAM_INVALID;
        _StreamSourceSegments[segmentSlot] = cleared;
        segmentSlot = nextSlot;
        segmentGeneration = nextGeneration;
    }

    uint generation = SigmaStreamTransactionGeneration(transaction);
    transaction = (SigmaTransactionGpu)0;
    transaction.identity.y = generation;
    _StreamTransactions[transactionSlot] = transaction;
    if (_StreamSchedulerControl[SIGMA_STREAM_CONTROL_PROOF_OWNER] ==
            transactionSlot)
        _StreamSchedulerControl[SIGMA_STREAM_CONTROL_PROOF_OWNER] =
            SIGMA_STREAM_INVALID;
    if (_StreamSchedulerControl[SIGMA_STREAM_CONTROL_REVALIDATE_OWNER] ==
            transactionSlot)
        _StreamSchedulerControl[SIGMA_STREAM_CONTROL_REVALIDATE_OWNER] =
            SIGMA_STREAM_INVALID;
    InterlockedAdd(_StreamSchedulerControl[
        SIGMA_STREAM_CONTROL_PUBLISHED_COUNT], 1u);
    InterlockedAdd(_StreamDiagnostics[0u].publication.x, 1u);
}
