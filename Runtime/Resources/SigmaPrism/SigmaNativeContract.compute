// N3R live exact reverse lowering. Branches are disposable and never own Psi.
// The three fixed entry points are independent of candidate, relation, channel,
// transfer-segment and execution-window cardinality.
#pragma kernel ContractNativeQuery SIGMA_NATIVE_ORACLE_QUERY_MATH
#pragma kernel BuildContractOverflowArgs SIGMA_NATIVE_ORACLE_OVERFLOW_ARGS_ONLY
#pragma kernel ResolveContractorOverflow SIGMA_NATIVE_ORACLE_QUERY_MATH
#pragma target 5.0

#include "SigmaFrameAbi.hlsl"
#include "Generated/SigmaGeneratedMerkabaProgram.hlsl"

#define SIGMA_NATIVE_OBSERVATION_ORDER 1u
#define SIGMA_NATIVE_OBSERVATION_OPTICAL 2u
#define SIGMA_NATIVE_OBSERVATION_OPTICAL_METADATA 4u

// Object/candidate identity and external relation truth are deliberately absent.
// Every decision
// below is derived from complete keys/gauge records and the generated relation
// program. Layouts are documented at their declarations.
StructuredBuffer<uint4> _NativeReverseKeys;
// x=prior state, y=proposed state, z=relation right, w=relation context offsets.
StructuredBuffer<uint4> _NativeReverseStates;
// Two records per candidate, prior then proposed: signed-64 u/v limbs.
StructuredBuffer<uint4> _NativeReverseGaugeCoordinates;
// Two records per candidate, prior then proposed: level,payload-key lo/hi,reserved.
StructuredBuffer<uint4> _NativeReverseGaugeMetadata;
// Complete generated relation witnesses produced by the fixed
// EvaluateNativeRelation entry point over the same reverse worklist.
StructuredBuffer<uint4> _NativeReverseRelationResults;
StructuredBuffer<uint4> _NativeReverseRelationFactors;
StructuredBuffer<uint4> _NativeReverseRelationHashes;
StructuredBuffer<uint> _NativeReverseDeltaHashes;
RWStructuredBuffer<uint2> _NativeStates;
StructuredBuffer<uint2> _NativeQueryRows;

// Fresh-admission input is immutable coherent instrument evidence. It contains
// no prebuilt Merkaba rows, proposed state, gauge address or relation truth.
// Per branch: two headers, 2 eyes x 3 calibrated room-ray coefficients, and
// 2 eyes x 4 raw sensor-code intervals. The generated boundary program builds
// all eight signed/permuted leaves inside this existing workgroup.
StructuredBuffer<uint4> _NativeFreshObservationHeaders;
StructuredBuffer<uint2> _NativeFreshRoomRays;
StructuredBuffer<uint2> _NativeFreshCodeLeaves;

// Exact observation/query data.
StructuredBuffer<uint2> _NativeObservationOrder;
StructuredBuffer<uint2> _NativeMeasuredOptical;
StructuredBuffer<uint2> _NativeDirection;
StructuredBuffer<uint2> _NativePhotometricExposure;
// Eight uint2 values per channel: gain L/U, illumination L/U,
// white-balance L/U and offset L/U.
StructuredBuffer<uint2> _NativePhotometricChannelParameters;
// x=first segment, y=count for each channel.
StructuredBuffer<uint2> _NativePhotometricTransferRanges;
// Four uint2 values per segment: domain L/U, slope and offset.
StructuredBuffer<uint2> _NativePhotometricTransferData;

RWStructuredBuffer<uint4> _NativeBranchHeaders;
RWStructuredBuffer<uint2> _NativeBranchSupports;
RWStructuredBuffer<uint4> _NativeBranchActions;
// Four records per candidate: order then three native optical points.
RWStructuredBuffer<uint4> _NativeBranchPredictions;
RWStructuredBuffer<uint4> _NativeBranchRelationFactors;
RWStructuredBuffer<uint4> _NativeBranchRelationHashes;
RWStructuredBuffer<uint> _NativeOverflowArgs;

#include "SigmaNativeMath.hlsl"

uint _NativeReverseCount;
uint _NativeHotCapacity;
uint _NativeObservationFlags;
uint _NativeEntryPointIndex;
uint _NativeContractMode;
uint _NativeFreshBranchCount;
uint _NativeFreshLeftEntryPointIndex;
uint _NativeFreshRightEntryPointIndex;

#define SIGMA_NATIVE_CONTRACT_EXISTING 0u
#define SIGMA_NATIVE_CONTRACT_FRESH_LIFT 1u
#define SIGMA_NATIVE_CONTRACT_FRESH_UNION 2u
#define SIGMA_NATIVE_FRESH_HOT_BRANCH_CAPACITY 4u
#define SIGMA_NATIVE_FRESH_ADMITTED 1u
#define SIGMA_NATIVE_FRESH_UNRESOLVED 0u
#define SIGMA_NATIVE_FRESH_COLD_CONTINUATION 2u
#define SIGMA_NATIVE_FRESH_COHERENT 1u
#define SIGMA_NATIVE_FRESH_LEFT_FIRST_HIT 2u
#define SIGMA_NATIVE_FRESH_RIGHT_FIRST_HIT 4u
#define SIGMA_NATIVE_FRESH_LEFT_EVIDENCE 8u
#define SIGMA_NATIVE_FRESH_RIGHT_EVIDENCE 16u

#if defined(SIGMA_NATIVE_ORACLE_QUERY_MATH)
groupshared uint SigmaNativeFreshLeafAxis[8];
groupshared uint SigmaNativeFreshLeafEye[8];
groupshared uint2 SigmaNativeFreshLeafLower[8];
groupshared uint2 SigmaNativeFreshLeafUpper[8];
groupshared uint4 SigmaNativeFreshEyePermutation[2];
groupshared int SigmaNativeFreshEyeSign[2];
groupshared uint2 SigmaNativeFreshInstrumentLower[8];
groupshared uint2 SigmaNativeFreshInstrumentUpper[8];
groupshared uint2 SigmaNativeFreshAxisLower[4];
groupshared uint2 SigmaNativeFreshAxisUpper[4];
groupshared uint2 SigmaNativeFreshSelected[4];
groupshared uint2 SigmaNativeFreshState[16];
groupshared uint2 SigmaNativeFreshForward[4];
groupshared uint2 SigmaNativeFreshPriorForward[4];
groupshared uint SigmaNativeFreshScratch[64];
groupshared uint SigmaNativeFreshPhaseValid;
groupshared uint SigmaNativeFreshUsePrior;

uint _NativeFreshPriorStateOffset;

bool SigmaNativeFreshQ48Equal(uint2 left, uint2 right)
{
    return all(left == right);
}

bool SigmaNativeFreshEntryValid(uint entryPointIndex)
{
    return entryPointIndex < SIGMA_MERKABA_ENTRY_POINT_COUNT &&
        SIGMA_MERKABA_IR_ENTRY_POINTS[entryPointIndex].x == 7 &&
        SIGMA_MERKABA_IR_ENTRY_POINTS[entryPointIndex].y == 8 &&
        SIGMA_MERKABA_IR_ENTRY_POINTS[entryPointIndex].z == 1;
}

uint SigmaNativeFreshPermutationAxis(uint eye, uint leaf)
{
    uint4 permutation = SigmaNativeFreshEyePermutation[eye];
    return leaf == 0u ? permutation.x :
        leaf == 1u ? permutation.y :
        leaf == 2u ? permutation.z : permutation.w;
}

uint2 SigmaNativeFreshLiftWeight(int numerator)
{
    // numerator / 64 in Q16.48 => numerator * 2^42.
    return uint2(0u, asuint(numerator * 1024));
}

uint SigmaNativeFreshReduceAnd(uint threadIndex)
{
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint stride = 32u; stride != 0u; stride >>= 1u)
    {
        if (threadIndex < stride)
            SigmaNativeFreshScratch[threadIndex] &=
                SigmaNativeFreshScratch[threadIndex + stride];
        GroupMemoryBarrierWithGroupSync();
    }
    return SigmaNativeFreshScratch[0];
}

uint SigmaNativeFreshReduceOr(uint threadIndex)
{
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint stride = 32u; stride != 0u; stride >>= 1u)
    {
        if (threadIndex < stride)
            SigmaNativeFreshScratch[threadIndex] |=
                SigmaNativeFreshScratch[threadIndex + stride];
        GroupMemoryBarrierWithGroupSync();
    }
    return SigmaNativeFreshScratch[0];
}

void SigmaNativeFreshLiftBranch(uint branchIndex, uint threadIndex)
{
    uint4 header = _NativeFreshObservationHeaders[branchIndex * 2u];
    uint4 instrument = _NativeFreshObservationHeaders[branchIndex * 2u + 1u];
    uint requiredFlags = SIGMA_NATIVE_FRESH_COHERENT |
        SIGMA_NATIVE_FRESH_LEFT_FIRST_HIT |
        SIGMA_NATIVE_FRESH_RIGHT_FIRST_HIT |
        SIGMA_NATIVE_FRESH_LEFT_EVIDENCE |
        SIGMA_NATIVE_FRESH_RIGHT_EVIDENCE;
    bool transferValid = instrument.x <= 1u && instrument.y <= 1u;
    bool contextValid = (header.x & requiredFlags) == requiredFlags &&
        (header.y != 0u || header.z != 0u) && header.w != 0u &&
        instrument.z != 0u && instrument.w != 0u && transferValid &&
        SigmaNativeFreshEntryValid(_NativeFreshLeftEntryPointIndex) &&
        SigmaNativeFreshEntryValid(_NativeFreshRightEntryPointIndex);

    SigmaNativeFreshScratch[threadIndex] = 1u;
    if (threadIndex < 2u)
    {
        uint eye = threadIndex;
        uint rayBase = branchIndex * 6u + eye * 3u;
        uint2 roomRay[3];
        [unroll]
        for (uint component = 0u; component < 3u; ++component)
            roomRay[component] = _NativeFreshRoomRays[rayBase + component];
        uint valid = contextValid ? 1u : 0u;
        uint4 permutation = uint4(0u, 0u, 0u, 0u);
        int globalSign = 0;
        SigmaMerkabaBuildInstrumentRowPermutation(roomRay, permutation,
            globalSign, valid);
        uint2 codeLower[4];
        uint2 codeUpper[4];
        uint codeBase = branchIndex * 16u + eye * 8u;
        [unroll]
        for (uint instrumentLeaf = 0u; instrumentLeaf < 4u; ++instrumentLeaf)
        {
            codeLower[instrumentLeaf] =
                _NativeFreshCodeLeaves[codeBase + instrumentLeaf * 2u];
            codeUpper[instrumentLeaf] =
                _NativeFreshCodeLeaves[codeBase + instrumentLeaf * 2u + 1u];
        }
        uint2 measuredLower[4];
        uint2 measuredUpper[4];
        SigmaMerkabaAssembleInstrumentTangent(codeLower, codeUpper,
            globalSign, measuredLower, measuredUpper, valid);
        SigmaNativeFreshEyePermutation[eye] = permutation;
        SigmaNativeFreshEyeSign[eye] = globalSign;
        [unroll]
        for (uint measuredLeaf = 0u; measuredLeaf < 4u; ++measuredLeaf)
        {
            uint destination = eye * 4u + measuredLeaf;
            SigmaNativeFreshInstrumentLower[destination] =
                measuredLower[measuredLeaf];
            SigmaNativeFreshInstrumentUpper[destination] =
                measuredUpper[measuredLeaf];
        }
        SigmaNativeFreshScratch[threadIndex] = valid;
    }
    GroupMemoryBarrierWithGroupSync();

    if (threadIndex < 8u)
    {
        uint eye = threadIndex >> 2u;
        uint leaf = threadIndex & 3u;
        uint axis = SigmaNativeFreshPermutationAxis(eye, leaf);
        uint leafValid = contextValid &&
            SigmaNativeFreshEyeSign[eye] != 0 ? 1u : 0u;
        leafValid &= axis < 4u ? 1u : 0u;
        uint2 measuredLower = SigmaNativeFreshInstrumentLower[threadIndex];
        uint2 measuredUpper = SigmaNativeFreshInstrumentUpper[threadIndex];
        leafValid &= !SigmaI64Less(measuredUpper, measuredLower) ? 1u : 0u;
        uint pullValid = leafValid;
        if (SigmaNativeFreshEyeSign[eye] < 0)
        {
            SigmaNativeFreshLeafLower[threadIndex] =
                SigmaQ48NegateChecked(measuredUpper, pullValid);
            SigmaNativeFreshLeafUpper[threadIndex] =
                SigmaQ48NegateChecked(measuredLower, pullValid);
        }
        else
        {
            SigmaNativeFreshLeafLower[threadIndex] = measuredLower;
            SigmaNativeFreshLeafUpper[threadIndex] = measuredUpper;
        }
        leafValid &= pullValid;
        SigmaNativeFreshLeafAxis[threadIndex] = axis;
        SigmaNativeFreshLeafEye[threadIndex] = eye;
        SigmaNativeFreshScratch[threadIndex] = leafValid;
    }
    GroupMemoryBarrierWithGroupSync();

    if (threadIndex < 4u)
    {
        uint2 lower = uint2(0u, 0x80000000u);
        uint2 upper = uint2(0xffffffffu, 0x7fffffffu);
        uint eyeMask = 0u;
        uint axisValid = contextValid ? 1u : 0u;
        [unroll]
        for (uint sourceLeaf = 0u; sourceLeaf < 8u; ++sourceLeaf)
        {
            if (SigmaNativeFreshLeafAxis[sourceLeaf] == threadIndex)
            {
                axisValid &= SigmaNativeFreshScratch[sourceLeaf];
                lower = SigmaQ48Max(lower,
                    SigmaNativeFreshLeafLower[sourceLeaf]);
                upper = SigmaQ48Min(upper,
                    SigmaNativeFreshLeafUpper[sourceLeaf]);
                eyeMask |= 1u << SigmaNativeFreshLeafEye[sourceLeaf];
            }
        }
        axisValid &= (eyeMask == 3u && !SigmaI64Less(upper, lower)) ? 1u : 0u;
        SigmaNativeFreshAxisLower[threadIndex] = lower;
        SigmaNativeFreshAxisUpper[threadIndex] = upper;
        SigmaNativeFreshScratch[threadIndex] = axisValid;
    }
    else
        SigmaNativeFreshScratch[threadIndex] = 1u;
    uint axisPhaseValid = SigmaNativeFreshReduceAnd(threadIndex);

    // If the complete current S16 representative already satisfies both raw
    // calibrated eye shadows, retain all sixteen bytes—including shadow-hidden
    // modes—instead of relifting a lower-dimensional representative.
    bool priorRequested = (header.x &
        SIGMA_NATIVE_OBSERVATION_PRIOR_SUPPORT) != 0u;
    SigmaNativeFreshScratch[threadIndex] = threadIndex < 16u &&
        any(_NativeStates[_NativeFreshPriorStateOffset + threadIndex] != 0u)
        ? 1u : 0u;
    uint priorNonzero = SigmaNativeFreshReduceOr(threadIndex);
    if (threadIndex < 4u)
    {
        uint priorValid = priorRequested && priorNonzero != 0u ? 1u : 0u;
        uint2 sum = uint2(0u, 0u);
        [unroll]
        for (uint priorLane = 0u; priorLane < 16u; ++priorLane)
        {
            uint2 weight = SigmaNativeShadowWeight(
                SigmaMerkabaShadowNumerator(priorLane, threadIndex));
            sum = SigmaQ48AddChecked(sum, SigmaQ48MulNearestEven(
                _NativeStates[_NativeFreshPriorStateOffset + priorLane],
                weight, priorValid), priorValid);
        }
        SigmaNativeFreshPriorForward[threadIndex] = sum;
        SigmaNativeFreshScratch[threadIndex] = priorValid;
    }
    else
        SigmaNativeFreshScratch[threadIndex] = 1u;
    uint priorForwardValid = SigmaNativeFreshReduceAnd(threadIndex);

    SigmaNativeFreshScratch[threadIndex] = 1u;
    if (threadIndex < 8u)
    {
        uint eye = threadIndex >> 2u;
        uint leaf = threadIndex & 3u;
        uint priorLeafValid = priorForwardValid;
        uint axis = SigmaNativeFreshPermutationAxis(eye, leaf);
        uint2 predicted = SigmaNativeFreshPriorForward[axis];
        if (SigmaNativeFreshEyeSign[eye] < 0)
            predicted = SigmaQ48NegateChecked(predicted, priorLeafValid);
        priorLeafValid &= SigmaNativePointInInterval(predicted,
            SigmaNativeFreshInstrumentLower[threadIndex],
            SigmaNativeFreshInstrumentUpper[threadIndex]) ? 1u : 0u;
        SigmaNativeFreshScratch[threadIndex] = priorLeafValid;
    }
    uint priorRawValid = SigmaNativeFreshReduceAnd(threadIndex);

    if (threadIndex == 0u)
    {
        SigmaNativeFreshUsePrior = priorRequested && priorNonzero != 0u &&
            priorRawValid != 0u ? 1u : 0u;
        uint selectorValid = axisPhaseValid;
        bool selectedValid = SigmaNativeFreshUsePrior != 0u;
        if (SigmaNativeFreshUsePrior != 0u)
        {
            [unroll]
            for (uint priorAxis = 0u; priorAxis < 4u; ++priorAxis)
                SigmaNativeFreshSelected[priorAxis] =
                    SigmaNativeFreshPriorForward[priorAxis];
        }
        else
        {
            uint2 lower[4];
            uint2 upper[4];
            uint2 selected[4];
            [unroll]
            for (uint axisCopy = 0u; axisCopy < 4u; ++axisCopy)
            {
                lower[axisCopy] = SigmaNativeFreshAxisLower[axisCopy];
                upper[axisCopy] = SigmaNativeFreshAxisUpper[axisCopy];
                selected[axisCopy] = uint2(0u, 0u);
            }
            selectedValid = SigmaMerkabaSelectFreshTangent(lower, upper,
                selected, selectorValid);
            [unroll]
            for (uint selectedAxis = 0u; selectedAxis < 4u; ++selectedAxis)
                SigmaNativeFreshSelected[selectedAxis] = selected[selectedAxis];
        }
        SigmaNativeFreshPhaseValid = selectedValid && selectorValid != 0u
            ? 1u : 0u;
    }
    GroupMemoryBarrierWithGroupSync();

    SigmaNativeFreshScratch[threadIndex] = 1u;
    if (threadIndex < 16u)
    {
        uint laneValid = SigmaNativeFreshPhaseValid;
        uint2 laneValue = SigmaNativeFreshUsePrior != 0u
            ? _NativeStates[_NativeFreshPriorStateOffset + threadIndex]
            : uint2(0u, 0u);
        if (SigmaNativeFreshUsePrior == 0u)
        {
            [unroll]
            for (uint liftAxis = 0u; liftAxis < 4u; ++liftAxis)
            {
                uint2 weight = SigmaNativeFreshLiftWeight(
                    SigmaMerkabaShadowNumerator(threadIndex, liftAxis));
                laneValue = SigmaQ48AddChecked(laneValue,
                    SigmaQ48MulNearestEven(SigmaNativeFreshSelected[liftAxis],
                        weight, laneValid), laneValid);
            }
        }
        SigmaNativeFreshState[threadIndex] = laneValue;
        _NativeStates[branchIndex * 16u + threadIndex] = laneValue;
        SigmaNativeFreshScratch[threadIndex] = laneValid;
    }
    uint liftValid = SigmaNativeFreshReduceAnd(threadIndex);

    SigmaNativeFreshScratch[threadIndex] = threadIndex < 16u &&
        any(SigmaNativeFreshState[threadIndex] != 0u) ? 1u : 0u;
    uint stateNonzero = SigmaNativeFreshReduceOr(threadIndex);
    if (threadIndex == 0u)
    {
        SigmaNativeFreshPhaseValid &= liftValid & stateNonzero;
    }
    GroupMemoryBarrierWithGroupSync();

    if (threadIndex < 4u)
    {
        uint forwardValid = SigmaNativeFreshPhaseValid;
        uint2 sum = uint2(0u, 0u);
        [unroll]
        for (uint forwardLane = 0u; forwardLane < 16u; ++forwardLane)
        {
            uint2 weight = SigmaNativeShadowWeight(
                SigmaMerkabaShadowNumerator(forwardLane, threadIndex));
            sum = SigmaQ48AddChecked(sum,
                SigmaQ48MulNearestEven(SigmaNativeFreshState[forwardLane],
                    weight, forwardValid), forwardValid);
        }
        SigmaNativeFreshForward[threadIndex] = sum;
        SigmaNativeFreshScratch[threadIndex] = forwardValid;
    }
    else
        SigmaNativeFreshScratch[threadIndex] = 1u;
    uint forwardPhaseValid = SigmaNativeFreshReduceAnd(threadIndex);

    SigmaNativeFreshScratch[threadIndex] = 1u;
    if (threadIndex < 8u)
    {
        uint eye = threadIndex >> 2u;
        uint leaf = threadIndex & 3u;
        uint leafForwardValid = forwardPhaseValid;
        uint axis = SigmaNativeFreshPermutationAxis(eye, leaf);
        uint2 predicted = SigmaNativeFreshForward[axis];
        if (SigmaNativeFreshEyeSign[eye] < 0)
            predicted = SigmaQ48NegateChecked(predicted, leafForwardValid);
        leafForwardValid &= SigmaNativePointInInterval(predicted,
            SigmaNativeFreshInstrumentLower[threadIndex],
            SigmaNativeFreshInstrumentUpper[threadIndex]) ? 1u : 0u;
        SigmaNativeFreshScratch[threadIndex] = leafForwardValid;
    }
    uint rawForwardValid = SigmaNativeFreshReduceAnd(threadIndex);

    if (threadIndex == 0u)
    {
        SigmaNativeFreshPhaseValid &= rawForwardValid;
        _NativeBranchHeaders[branchIndex] = uint4(branchIndex,
            SigmaNativeFreshPhaseValid,
            header.x, 0u);
    }
    if (threadIndex < 4u)
        _NativeBranchPredictions[branchIndex * 4u + threadIndex] = uint4(
            SigmaNativeFreshSelected[threadIndex], 0u, 0u);
    GroupMemoryBarrierWithGroupSync();
    if (SigmaNativeFreshPhaseValid == 0u && threadIndex < 16u)
        _NativeStates[branchIndex * 16u + threadIndex] = uint2(0u, 0u);
}

void SigmaNativeFreshFinalize(uint threadIndex)
{
    uint branchCount = _NativeFreshBranchCount;
    bool bounded = branchCount > 0u &&
        branchCount <= SIGMA_NATIVE_FRESH_HOT_BRANCH_CAPACITY;
    uint branch = threadIndex >> 4u;
    uint lane = threadIndex & 15u;
    bool activeBranch = bounded && branch < branchCount;
    // HLSL does not promise short-circuit resource loads. Clamp inactive lanes
    // to branch zero so the fixed four-branch collective never probes beyond
    // the physically allocated buffers when branchCount is one to three.
    uint safeBranch = activeBranch ? branch : 0u;
    bool branchValid = activeBranch &&
        _NativeBranchHeaders[safeBranch].y != 0u &&
        _NativeReverseRelationResults[safeBranch].w != 0u &&
        _NativeReverseRelationResults[safeBranch].x ==
            SIGMA_MERKABA_RELATION_NO_RELATION;
    bool laneEqual = !activeBranch || all(
        _NativeStates[safeBranch * 16u + lane] == _NativeStates[lane]);
    SigmaNativeFreshScratch[threadIndex] =
        branchValid && laneEqual ? 0u : (activeBranch ? 1u : 0u);
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint stride = 8u; stride != 0u; stride >>= 1u)
    {
        if (lane < stride)
            SigmaNativeFreshScratch[branch * 16u + lane] |=
                SigmaNativeFreshScratch[branch * 16u + lane + stride];
        GroupMemoryBarrierWithGroupSync();
    }

    if (threadIndex == 0u)
    {
        uint mismatch = bounded ? 0u : 1u;
        [unroll]
        for (uint branchProbe = 0u;
            branchProbe < SIGMA_NATIVE_FRESH_HOT_BRANCH_CAPACITY; ++branchProbe)
            if (branchProbe < branchCount)
                mismatch |= SigmaNativeFreshScratch[branchProbe * 16u];
        SigmaNativeFreshPhaseValid = mismatch == 0u ? 1u : 0u;
    }
    GroupMemoryBarrierWithGroupSync();

    uint admissionOffset = branchCount * 16u;
    if (threadIndex < 16u)
        _NativeStates[admissionOffset + threadIndex] =
            SigmaNativeFreshPhaseValid != 0u
            ? _NativeStates[threadIndex] : uint2(0u, 0u);
    if (threadIndex == 0u)
    {
        uint status = SigmaNativeFreshPhaseValid != 0u
            ? SIGMA_NATIVE_FRESH_ADMITTED : SIGMA_NATIVE_FRESH_UNRESOLVED;
        uint relation = SigmaNativeFreshPhaseValid != 0u
            ? SIGMA_MERKABA_RELATION_NO_RELATION
            : SIGMA_MERKABA_RELATION_UNRESOLVED;
        uint coldReason = branchCount > SIGMA_NATIVE_FRESH_HOT_BRANCH_CAPACITY
            ? SIGMA_NATIVE_FRESH_COLD_CONTINUATION : 0u;
        _NativeBranchHeaders[branchCount] = uint4(status, relation,
            branchCount, coldReason);
        _NativeBranchSupports[branchCount] = uint2(0u, 0u);
    }
}

bool SigmaNativeContractKeyEqual(uint2 left, uint2 right)
{
    return all(left == right);
}

bool SigmaNativeGaugeEqual(uint candidateIndex)
{
    uint priorIndex = candidateIndex * 2u;
    uint proposedIndex = priorIndex + 1u;
    return all(_NativeReverseGaugeCoordinates[priorIndex] ==
            _NativeReverseGaugeCoordinates[proposedIndex]) &&
        all(_NativeReverseGaugeMetadata[priorIndex] ==
            _NativeReverseGaugeMetadata[proposedIndex]);
}

void SigmaNativeIntervalMultiply(uint2 leftLower, uint2 leftUpper,
    uint2 rightLower, uint2 rightUpper, out uint2 outputLower,
    out uint2 outputUpper, inout uint valid)
{
    uint2 lo00 = SigmaQ48MulLower(leftLower, rightLower, valid);
    uint2 lo01 = SigmaQ48MulLower(leftLower, rightUpper, valid);
    uint2 lo10 = SigmaQ48MulLower(leftUpper, rightLower, valid);
    uint2 lo11 = SigmaQ48MulLower(leftUpper, rightUpper, valid);
    uint2 hi00 = SigmaQ48MulUpper(leftLower, rightLower, valid);
    uint2 hi01 = SigmaQ48MulUpper(leftLower, rightUpper, valid);
    uint2 hi10 = SigmaQ48MulUpper(leftUpper, rightLower, valid);
    uint2 hi11 = SigmaQ48MulUpper(leftUpper, rightUpper, valid);
    outputLower = SigmaQ48Min(SigmaQ48Min(lo00, lo01), SigmaQ48Min(lo10, lo11));
    outputUpper = SigmaQ48Max(SigmaQ48Max(hi00, hi01), SigmaQ48Max(hi10, hi11));
}

bool SigmaNativeTransferContains(uint2 value, uint2 lower, uint2 upper)
{
    return !SigmaI64Less(value, lower) && !SigmaI64Less(upper, value);
}

void SigmaNativeApplyOpticalNuisance(uint channel, uint2 response,
    out uint2 lower, out uint2 upper, inout uint valid)
{
    uint2 stageLower = response;
    uint2 stageUpper = response;
    uint2 nextLower;
    uint2 nextUpper;

    SigmaNativeIntervalMultiply(stageLower, stageUpper,
        _NativePhotometricExposure[0], _NativePhotometricExposure[1],
        nextLower, nextUpper, valid);
    stageLower = nextLower;
    stageUpper = nextUpper;

    uint parameterBase = channel * 8u;
    [unroll]
    for (uint factor = 0u; factor < 3u; ++factor)
    {
        uint parameter = parameterBase + factor * 2u;
        SigmaNativeIntervalMultiply(stageLower, stageUpper,
            _NativePhotometricChannelParameters[parameter],
            _NativePhotometricChannelParameters[parameter + 1u],
            nextLower, nextUpper, valid);
        stageLower = nextLower;
        stageUpper = nextUpper;
    }
    stageLower = SigmaQ48AddChecked(stageLower,
        _NativePhotometricChannelParameters[parameterBase + 6u], valid);
    stageUpper = SigmaQ48AddChecked(stageUpper,
        _NativePhotometricChannelParameters[parameterBase + 7u], valid);

    uint2 range = _NativePhotometricTransferRanges[channel];
    bool foundLower = false;
    bool foundUpper = false;
    uint2 lowerSlope = uint2(0u, 0u);
    uint2 lowerOffset = uint2(0u, 0u);
    uint2 upperSlope = uint2(0u, 0u);
    uint2 upperOffset = uint2(0u, 0u);
    [loop]
    for (uint local = 0u; local < range.y; ++local)
    {
        uint segment = range.x + local;
        uint data = segment * 4u;
        uint2 domainLower = _NativePhotometricTransferData[data];
        uint2 domainUpper = _NativePhotometricTransferData[data + 1u];
        bool containsLower = SigmaNativeTransferContains(stageLower,
            domainLower, domainUpper);
        bool containsUpper = SigmaNativeTransferContains(stageUpper,
            domainLower, domainUpper);
        if (containsLower && !foundLower)
        {
            foundLower = true;
            lowerSlope = _NativePhotometricTransferData[data + 2u];
            lowerOffset = _NativePhotometricTransferData[data + 3u];
        }
        // Deliberately retain the last segment at a shared boundary. Exact
        // transfer continuity makes either segment equal there; this mirrors CPU.
        if (containsUpper)
        {
            foundUpper = true;
            upperSlope = _NativePhotometricTransferData[data + 2u];
            upperOffset = _NativePhotometricTransferData[data + 3u];
        }
    }
    valid &= (foundLower && foundUpper && range.y != 0u) ? 1u : 0u;
    lower = SigmaQ48AddChecked(
        SigmaQ48MulLower(stageLower, lowerSlope, valid), lowerOffset, valid);
    upper = SigmaQ48AddChecked(
        SigmaQ48MulUpper(stageUpper, upperSlope, valid), upperOffset, valid);
}

bool SigmaNativeRelationPermits(uint relationClass)
{
    return relationClass == SIGMA_MERKABA_RELATION_DEFAULT_SAT ||
        relationClass == SIGMA_MERKABA_RELATION_REGULAR ||
        relationClass == SIGMA_MERKABA_RELATION_EXACT_ZD ||
        relationClass == SIGMA_MERKABA_RELATION_NEAR_SINGULAR_Q48;
}

bool SigmaNativeRelationPermitsIdentity(uint relationClass)
{
    return SigmaNativeRelationPermits(relationClass) &&
        relationClass != SIGMA_MERKABA_RELATION_NEAR_SINGULAR_Q48;
}

void SigmaNativeContractOne(uint candidateIndex)
{
    uint4 keys = _NativeReverseKeys[candidateIndex];
    uint4 statePlan = _NativeReverseStates[candidateIndex];
    uint valid = 1u;
    bool entryValid = _NativeEntryPointIndex < SIGMA_MERKABA_ENTRY_POINT_COUNT &&
        SIGMA_MERKABA_IR_ENTRY_POINTS[_NativeEntryPointIndex].x == 7 &&
        SIGMA_MERKABA_IR_ENTRY_POINTS[_NativeEntryPointIndex].y == 8;
    valid &= entryValid ? 1u : 0u;

    uint2 proposedOrder;
    uint2 proposedOptical[3];
    SigmaNativeEvaluateState(statePlan.y, proposedOrder, proposedOptical, valid);

    uint4 relation = _NativeReverseRelationResults[candidateIndex];
    uint4 relationFactors = _NativeReverseRelationFactors[candidateIndex];
    uint4 relationHashes = _NativeReverseRelationHashes[candidateIndex];
    valid &= relation.w != 0u ? 1u : 0u;

    bool orderClaim = (_NativeObservationFlags &
        SIGMA_NATIVE_OBSERVATION_ORDER) != 0u;
    bool opticalRequested = (_NativeObservationFlags &
        SIGMA_NATIVE_OBSERVATION_OPTICAL) != 0u;
    bool opticalClaim = opticalRequested &&
        (_NativeObservationFlags &
            SIGMA_NATIVE_OBSERVATION_OPTICAL_METADATA) != 0u;
    bool orderCompatible = !orderClaim || SigmaNativePointInInterval(
        proposedOrder, _NativeObservationOrder[0], _NativeObservationOrder[1]);
    bool opticalCompatible = true;
    uint2 predictedOpticalLower[3];
    uint2 predictedOpticalUpper[3];
    [unroll]
    for (uint channel = 0u; channel < SIGMA_NATIVE_OPTICAL_CHANNELS; ++channel)
    {
        SigmaNativeApplyOpticalNuisance(channel, proposedOptical[channel],
            predictedOpticalLower[channel], predictedOpticalUpper[channel], valid);
        uint evidence = channel * 2u;
        opticalCompatible = opticalCompatible && (!opticalClaim ||
            (!SigmaI64Less(predictedOpticalUpper[channel],
                _NativeMeasuredOptical[evidence]) &&
             !SigmaI64Less(_NativeMeasuredOptical[evidence + 1u],
                predictedOpticalLower[channel])));
    }

    bool priorDefault = SigmaNativeStateIsZero(statePlan.x);
    uint2 priorOrder = uint2(0u, 0u);
    uint2 ignoredOptical[3];
    if (!priorDefault)
        SigmaNativeEvaluateState(statePlan.x, priorOrder, ignoredOptical, valid);
    bool priorPreHit = !priorDefault &&
        SigmaI64Less(priorOrder, _NativeObservationOrder[0]);
    bool priorAtMould = !priorDefault && SigmaNativePointInInterval(priorOrder,
        _NativeObservationOrder[0], _NativeObservationOrder[1]);
    uint role = priorDefault || priorAtMould
        ? SIGMA_NATIVE_QUERY_FIRST_HIT_MOULD
        : (priorPreHit ? SIGMA_NATIVE_QUERY_PRE_HIT_EXCLUSION
            : SIGMA_NATIVE_QUERY_NO_CLAIM);

    uint2 residualLower = priorDefault ? _NativeObservationOrder[0]
        : SigmaQ48SubChecked(_NativeObservationOrder[0], priorOrder, valid);
    uint2 residualUpper = priorDefault ? _NativeObservationOrder[1]
        : SigmaQ48SubChecked(_NativeObservationOrder[1], priorOrder, valid);
    uint actionRole;
    uint actionActive;
    uint2 actionLower;
    uint2 actionUpper;
    SigmaMerkabaBuildDirectionalAction(role, _NativeDirection[0],
        _NativeDirection[1], residualLower, residualUpper, actionRole,
        actionActive, actionLower, actionUpper, valid);

    bool sameSupport = SigmaNativeContractKeyEqual(keys.xy, keys.zw);
    bool identityTransport = sameSupport && SigmaNativeGaugeEqual(candidateIndex) &&
        SigmaNativeRelationPermitsIdentity(relation.x);
    bool rolePermits = role != SIGMA_NATIVE_QUERY_NO_CLAIM &&
        (role != SIGMA_NATIVE_QUERY_PRE_HIT_EXCLUSION || identityTransport);
    bool viable = valid != 0u && SigmaNativeRelationPermits(relation.x) &&
        rolePermits && orderCompatible && opticalCompatible &&
        (orderClaim || opticalClaim);
    uint branchFlags = (viable ? 1u : 0u) |
        (viable && actionActive != 0u ? 2u : 0u) |
        (role << 2u) | (opticalClaim ? 16u : 0u) |
        (valid != 0u ? 32u : 0u) | (identityTransport ? 64u : 0u);
    _NativeBranchHeaders[candidateIndex] = uint4(candidateIndex, branchFlags,
        _NativeReverseDeltaHashes[candidateIndex], relation.x);
    _NativeBranchSupports[candidateIndex] = keys.zw;
    _NativeBranchActions[candidateIndex] = viable
        ? uint4(actionLower, actionUpper) : uint4(0u, 0u, 0u, 0u);
    _NativeBranchPredictions[candidateIndex * 4u] = uint4(proposedOrder,
        uint2(0u, 0u));
    [unroll]
    for (uint outputChannel = 0u;
        outputChannel < SIGMA_NATIVE_OPTICAL_CHANNELS; ++outputChannel)
        _NativeBranchPredictions[candidateIndex * 4u + 1u + outputChannel] =
            uint4(predictedOpticalLower[outputChannel],
                predictedOpticalUpper[outputChannel]);
    _NativeBranchRelationFactors[candidateIndex] = relationFactors;
    _NativeBranchRelationHashes[candidateIndex] = relationHashes;
}

[numthreads(64, 1, 1)]
void ContractNativeQuery(uint3 id : SV_DispatchThreadID,
    uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    if (_NativeContractMode == SIGMA_NATIVE_CONTRACT_FRESH_LIFT)
    {
        if (groupId.x < _NativeFreshBranchCount)
            SigmaNativeFreshLiftBranch(groupId.x, groupThreadId.x);
        return;
    }
    if (_NativeContractMode == SIGMA_NATIVE_CONTRACT_FRESH_UNION)
    {
        if (groupId.x == 0u)
            SigmaNativeFreshFinalize(groupThreadId.x);
        return;
    }
    uint hotCount = min(_NativeReverseCount, _NativeHotCapacity);
    if (id.x < hotCount)
        SigmaNativeContractOne(id.x);
}
#endif

#if defined(SIGMA_NATIVE_ORACLE_OVERFLOW_ARGS_ONLY)
[numthreads(1, 1, 1)]
void BuildContractOverflowArgs(uint3 id : SV_DispatchThreadID)
{
    uint remaining = _NativeReverseCount > _NativeHotCapacity
        ? _NativeReverseCount - _NativeHotCapacity : 0u;
    _NativeOverflowArgs[0] = (remaining + 63u) / 64u;
    _NativeOverflowArgs[1] = 1u;
    _NativeOverflowArgs[2] = 1u;
}
#endif

#if defined(SIGMA_NATIVE_ORACLE_QUERY_MATH)
[numthreads(64, 1, 1)]
void ResolveContractorOverflow(uint3 id : SV_DispatchThreadID)
{
    uint candidateIndex = _NativeHotCapacity + id.x;
    if (candidateIndex < _NativeReverseCount)
        SigmaNativeContractOne(candidateIndex);
}
#endif
