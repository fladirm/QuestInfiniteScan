// N3R/N4R live exact fresh reverse lowering. Branches are disposable and never
// own Psi. One fixed kernel serves lift and union phases; branch cardinality
// changes workgroups, never the submission sequence.
#pragma kernel ContractNativeQuery SIGMA_NATIVE_FRESH_MATH
#pragma multi_compile_local _ SIGMA_N4_TILE_CLOSE_VARIANT
#pragma target 5.0

#include "SigmaFrameAbi.hlsl"
#include "Generated/SigmaGeneratedMerkabaProgram.hlsl"

// Complete generated relation witnesses produced by the fixed
// EvaluateNativeRelation entry point over the same reverse worklist.
StructuredBuffer<uint4> _NativeReverseRelationResults;
RWStructuredBuffer<uint2> _NativeStates;

// Fresh-admission input is immutable coherent instrument evidence. It contains
// no prebuilt Merkaba rows, proposed state, gauge address or relation truth.
// Per branch: one packed completion record containing two headers, 2 eyes x 3
// calibrated room-ray coefficients, and 2 eyes x 4 raw sensor-code intervals.
// This is the same immutable journal record written by BuildNativeObservation;
// no duplicate fresh-evidence buffers or transfer pass exist.
RWStructuredBuffer<uint2> _NativeFreshEvidenceWords;
StructuredBuffer<SigmaNativeObservationGpu> _NativeObservations;
StructuredBuffer<uint2> _NativeSourceCarrierState;
StructuredBuffer<uint4> _NativeSourceCarrierRepresentation;
RWStructuredBuffer<uint2> _NativeCloseScratch;

RWStructuredBuffer<uint4> _NativeBranchHeaders;
RWStructuredBuffer<uint2> _NativeBranchSupports;
// Four records per candidate: order then three native optical points.
RWStructuredBuffer<uint4> _NativeBranchPredictions;
RWStructuredBuffer<uint4> _NativeLocalityCertificateWords;
RWStructuredBuffer<uint4> _NativeCounters;

#include "SigmaNativeMath.hlsl"

uint _NativeContractMode;
uint _NativeFreshBranchCount;
uint _NativeFreshLeftEntryPointIndex;
uint _NativeFreshRightEntryPointIndex;
uint _NativeCompletionRecordIndex;
uint _NativeFootprintCount;
uint _NativeLinearDispatchWidth;
uint _NativeFootprintStateOffset;
uint _NativeFootprintCertificateOffset;
uint2 _NativeResolution;
uint2 _NativeTileCount;
uint _NativeBoundaryCount;
uint _NativeBoundaryScratchOffset;
uint _NativeTileHeaderScratchOffset;
uint _NativeTileFootprintScratchOffset;
uint _NativeTileSupportSummaryScratchOffset;
uint _NativeTileComponentSummaryScratchOffset;
uint _NativeGlobalHeaderScratchOffset;
uint _NativeActiveSupportMarkerScratchOffset;
uint _NativeActiveSupportListScratchOffset;
uint _NativeSupportLocatorCapacity;
uint _NativeRevision;
uint _NativeCanonicalComponentScratchOffset;
uint _NativeCanonicalComponentCapacity;
uint _NativeCanonicalImageScratchOffset;
uint _NativeCanonicalImageStride;

#define SIGMA_NATIVE_CONTRACT_FRESH_LIFT 1u
#define SIGMA_NATIVE_CONTRACT_FRESH_UNION 2u
#define SIGMA_NATIVE_CONTRACT_TILE_CLOSE 3u
#define SIGMA_NATIVE_FRESH_HOT_BRANCH_CAPACITY 4u
#define SIGMA_NATIVE_FRESH_ADMITTED 1u
#define SIGMA_NATIVE_FRESH_UNRESOLVED 0u
#define SIGMA_NATIVE_FRESH_COLD_CONTINUATION 2u
#define SIGMA_NATIVE_FRESH_COHERENT 1u
#define SIGMA_NATIVE_FRESH_LEFT_FIRST_HIT 2u
#define SIGMA_NATIVE_FRESH_RIGHT_FIRST_HIT 4u
#define SIGMA_NATIVE_FRESH_LEFT_EVIDENCE 8u
#define SIGMA_NATIVE_FRESH_RIGHT_EVIDENCE 16u
#define SIGMA_NATIVE_FRESH_SOURCE_COMPLETION 0u
#define SIGMA_NATIVE_FRESH_SOURCE_FOOTPRINT 1u
#define SIGMA_N4_FOOTPRINT_HEADER 0u
#define SIGMA_N4_FOOTPRINT_INSTRUMENT 2u
#define SIGMA_N4_FOOTPRINT_ROOM_RAYS 4u
#define SIGMA_N4_FOOTPRINT_CODE_LEAVES 10u
#define SIGMA_N4_FOOTPRINT_SUPPORT 50u
#define SIGMA_N4_FOOTPRINT_EVIDENCE_WORDS 52u
#define SIGMA_N4_FOOTPRINT_BOUNDARY_ENVELOPES 26u
#define SIGMA_N4_FOOTPRINT_LEVEL_MASK 0x0000003fu
#define SIGMA_N4_FOOTPRINT_STATIC_EXCLUSION 0x00000100u
#define SIGMA_N4_BOUNDARY_RECEIPT_WORDS 6u
#define SIGMA_N4_SAMPLE_SIDE_LEFT 0u
#define SIGMA_N4_SAMPLE_SIDE_RIGHT 1u
#define SIGMA_N4_SAMPLE_SIDE_UP 2u
#define SIGMA_N4_SAMPLE_SIDE_DOWN 3u
#define SIGMA_N4_TILE_SIZE 16u
#define SIGMA_N4_TILE_FOOTPRINT_CAPACITY 256u
#define SIGMA_N4_TILE_HEADER_WORDS 2u
#define SIGMA_N4_TILE_FOOTPRINT_RECEIPT_WORDS 8u
#define SIGMA_N4_TILE_SUPPORT_SUMMARY_WORDS 2u
#define SIGMA_N4_TILE_COMPONENT_SUMMARY_WORDS 2u
#define SIGMA_N4_TILE_ORBIT_COUNT 3u
#define SIGMA_N4_TILE_FOREST_ROUNDS 8u
#define SIGMA_N4_TILE_CHART_COORD_BITS 13u
#define SIGMA_N4_TILE_CHART_COORD_MASK 0x1fffu
#define SIGMA_N4_TILE_CHART_FRAME_SHIFT 26u
#define SIGMA_N4_TILE_CHART_ASSIGNED (1u << 29u)
#define SIGMA_N4_TILE_INVALID 0xffffffffu
#define SIGMA_N4_COMPONENT_WORDS 10u
#define SIGMA_N4_COMPONENT_LIST_IMAGE 8u
#define SIGMA_N4_COMPONENT_SCAN_IMAGE 9u
#define SIGMA_N4_ANCHOR_LOCATOR_MASK 0x0001ffffu

#if defined(SIGMA_NATIVE_FRESH_MATH)
#if defined(SIGMA_N4_TILE_CLOSE_VARIANT)
groupshared uint SigmaNativeFreshScratch[256];
#else
groupshared uint SigmaNativeFreshScratch[256];
#endif

#if !defined(SIGMA_N4_TILE_CLOSE_VARIANT)
#define SIGMA_NATIVE_FRESH_TEAM_COUNT 16u
#define SIGMA_NATIVE_FRESH_TEAM_LANES 16u
#define SIGMA_NATIVE_FRESH_LEAVES 8u
#define SIGMA_NATIVE_FRESH_AXES 4u
#define SIGMA_NATIVE_FRESH_EYES 2u

// A 256-thread workgroup contains sixteen completely disjoint 16-lane
// footprint teams.  The old 64-lane isolated lowering only used lanes 0..15;
// lanes 16..63 contributed neutral AND/OR values.  Every former groupshared
// value is therefore partitioned here by team, while workgroup barriers retain
// one fixed uniform trace.  No team address is ever serialized or published.
groupshared uint SigmaNativeFreshLeafAxis[128];
groupshared uint SigmaNativeFreshLeafEye[128];
groupshared uint2 SigmaNativeFreshLeafLower[128];
groupshared uint2 SigmaNativeFreshLeafUpper[128];
groupshared uint4 SigmaNativeFreshEyePermutation[32];
groupshared int SigmaNativeFreshEyeSign[32];
groupshared uint2 SigmaNativeFreshInstrumentLower[128];
groupshared uint2 SigmaNativeFreshInstrumentUpper[128];
groupshared uint2 SigmaNativeFreshAxisLower[64];
groupshared uint2 SigmaNativeFreshAxisUpper[64];
groupshared uint2 SigmaNativeFreshSelected[64];
groupshared uint2 SigmaNativeFreshState[256];
groupshared uint2 SigmaNativeFreshForward[64];
groupshared uint2 SigmaNativeFreshPriorForward[64];
groupshared uint2 SigmaNativeFreshPriorState[256];
groupshared uint4 SigmaNativeFreshPriorCertificate[256];
groupshared uint SigmaNativeFreshTeamPhaseValid[16];
groupshared uint SigmaNativeFreshTeamHasPrior[16];
groupshared uint SigmaNativeFreshTeamUsePrior[16];
groupshared uint SigmaNativeFreshTeamStaticExclusion[16];
groupshared uint SigmaNativeFreshTeamPriorSlot[16];
groupshared uint SigmaNativeFreshTeamPriorSample[16];
groupshared uint SigmaNativeFreshPhaseValid;
groupshared uint SigmaNativeFreshHasPrior;
groupshared uint SigmaNativeFreshUsePrior;
groupshared uint SigmaNativeFreshStaticExclusion;
groupshared uint SigmaNativeFreshPriorSlot;
groupshared uint SigmaNativeFreshPriorSample;
#endif

#if defined(SIGMA_N4_TILE_CLOSE_VARIANT)
// One 16x16 tile is the only N4 local execution partition. These arrays are
// disposable workgroup scratch, never persistent topology/component state.
// WideA/B are deliberately reused by chart propagation and certificate meets.
groupshared uint2 SigmaN4TileSort[256];
groupshared uint2 SigmaN4TileLabel[256];
groupshared uint4 SigmaN4TileWideA[256];
groupshared uint4 SigmaN4TileWideB[256];
groupshared uint SigmaN4TileFlags[256];
groupshared uint SigmaN4TileComponentOrbits[256];
groupshared uint SigmaN4TileSupportedCount;
groupshared uint SigmaN4TileSupportSummaryCount;
groupshared uint SigmaN4TileComponentCount;
groupshared uint SigmaN4TileBorderComponentCount;
groupshared uint SigmaN4TileUnresolvedComponentCount;
groupshared uint SigmaN4TileOrbitAssignment[3];
#endif

#if !defined(SIGMA_N4_TILE_CLOSE_VARIANT)
uint _NativeFreshPriorStateOffset;

uint SigmaNativeFreshTeamLaneAddress(uint team, uint lane)
{
    return team * SIGMA_NATIVE_FRESH_TEAM_LANES + lane;
}

uint SigmaNativeFreshTeamLeafAddress(uint team, uint leaf)
{
    return team * SIGMA_NATIVE_FRESH_LEAVES + leaf;
}

uint SigmaNativeFreshTeamAxisAddress(uint team, uint axis)
{
    return team * SIGMA_NATIVE_FRESH_AXES + axis;
}

uint SigmaNativeFreshTeamEyeAddress(uint team, uint eye)
{
    return team * SIGMA_NATIVE_FRESH_EYES + eye;
}

uint SigmaNativeFreshEvidenceAddress(uint sourceKind, uint sourceIndex,
    uint word)
{
    return sourceKind == SIGMA_NATIVE_FRESH_SOURCE_COMPLETION
        ? (_NativeCompletionRecordIndex + sourceIndex) *
            SIGMA_COMPLETION_WORD_COUNT + word
        : sourceIndex * SIGMA_N4_FOOTPRINT_EVIDENCE_WORDS + word;
}

uint2 SigmaNativeFreshLoad2(uint sourceKind, uint sourceIndex, uint word)
{
    uint address = SigmaNativeFreshEvidenceAddress(sourceKind, sourceIndex,
        word);
    return sourceKind == SIGMA_NATIVE_FRESH_SOURCE_COMPLETION
        ? _NativeFreshEvidenceWords[address] : _NativeCloseScratch[address];
}

uint4 SigmaNativeFreshLoad4(uint sourceKind, uint sourceIndex, uint word)
{
    uint2 lower = SigmaNativeFreshLoad2(sourceKind, sourceIndex, word);
    uint2 upper = SigmaNativeFreshLoad2(sourceKind, sourceIndex, word + 1u);
    return uint4(lower, upper);
}

bool SigmaNativeFreshQ48Equal(uint2 left, uint2 right)
{
    return all(left == right);
}

bool SigmaNativeFreshEntryValid(uint entryPointIndex)
{
    return entryPointIndex < SIGMA_MERKABA_ENTRY_POINT_COUNT &&
        SIGMA_MERKABA_IR_ENTRY_POINTS[entryPointIndex].x == 7 &&
        SIGMA_MERKABA_IR_ENTRY_POINTS[entryPointIndex].y == 8 &&
        SIGMA_MERKABA_IR_ENTRY_POINTS[entryPointIndex].z == 1;
}

uint SigmaNativeFreshPermutationAxis(uint team, uint eye, uint leaf)
{
    uint4 permutation = SigmaNativeFreshEyePermutation[
        SigmaNativeFreshTeamEyeAddress(team, eye)];
    return leaf == 0u ? permutation.x :
        leaf == 1u ? permutation.y :
        leaf == 2u ? permutation.z : permutation.w;
}

uint SigmaNativeFreshPermutationMode(uint4 permutation, int globalSign)
{
    // Lehmer rank is collision-free over the generated four-axis permutation;
    // the sign bit extends its 24 modes to the exact 48-mode row inventory.
    uint rank = 0u;
    uint factorial[4] = { 6u, 2u, 1u, 1u };
    [unroll]
    for (uint left = 0u; left < 4u; ++left)
    {
        uint smaller = 0u;
        [unroll]
        for (uint right = left + 1u; right < 4u; ++right)
            smaller += permutation[right] < permutation[left] ? 1u : 0u;
        rank += smaller * factorial[left];
    }
    return rank + (globalSign < 0 ? 24u : 0u);
}

uint2 SigmaNativeFreshModeMask(uint2 prior, uint mode)
{
    uint2 result = prior;
    if (mode < 32u)
        result.x |= 1u << mode;
    else if (mode < 48u)
        result.y |= 1u << (mode - 32u);
    return result;
}

void SigmaNativeFreshLiftSource(uint sourceKind, uint sourceIndex,
    uint stateOffset, uint certificateOffset, uint team, uint teamLane,
    bool teamActive, bool writeLegacyReceipt)
{
    uint laneAddress = SigmaNativeFreshTeamLaneAddress(team, teamLane);
    uint leafBase = SigmaNativeFreshTeamLeafAddress(team, 0u);
    uint axisBase = SigmaNativeFreshTeamAxisAddress(team, 0u);
    uint eyeBase = SigmaNativeFreshTeamEyeAddress(team, 0u);
    uint headerWord = sourceKind == SIGMA_NATIVE_FRESH_SOURCE_COMPLETION
        ? SIGMA_COMPLETION_OBSERVATION_HEADERS : SIGMA_N4_FOOTPRINT_HEADER;
    uint instrumentWord = sourceKind == SIGMA_NATIVE_FRESH_SOURCE_COMPLETION
        ? SIGMA_COMPLETION_OBSERVATION_HEADERS + 2u :
            SIGMA_N4_FOOTPRINT_INSTRUMENT;
    uint roomRayWord = sourceKind == SIGMA_NATIVE_FRESH_SOURCE_COMPLETION
        ? SIGMA_COMPLETION_ROOM_RAYS : SIGMA_N4_FOOTPRINT_ROOM_RAYS;
    uint codeLeafWord = sourceKind == SIGMA_NATIVE_FRESH_SOURCE_COMPLETION
        ? SIGMA_COMPLETION_CODE_LEAVES : SIGMA_N4_FOOTPRINT_CODE_LEAVES;
    uint4 header = SigmaNativeFreshLoad4(sourceKind, sourceIndex, headerWord);
    uint4 instrument = SigmaNativeFreshLoad4(sourceKind, sourceIndex,
        instrumentWord);
    uint requiredFlags = SIGMA_NATIVE_FRESH_COHERENT |
        SIGMA_NATIVE_FRESH_LEFT_FIRST_HIT |
        SIGMA_NATIVE_FRESH_RIGHT_FIRST_HIT |
        SIGMA_NATIVE_FRESH_LEFT_EVIDENCE |
        SIGMA_NATIVE_FRESH_RIGHT_EVIDENCE;
    bool transferValid = instrument.x <= 1u && instrument.y <= 1u;
    bool contextValid = teamActive &&
        (header.x & requiredFlags) == requiredFlags &&
        (header.y != 0u || header.z != 0u) && header.w != 0u &&
        instrument.z != 0u && instrument.w != 0u && transferValid &&
        SigmaNativeFreshEntryValid(_NativeFreshLeftEntryPointIndex) &&
        SigmaNativeFreshEntryValid(_NativeFreshRightEntryPointIndex);

    if (teamLane == 0u)
    {
        SigmaNativeFreshTeamPriorSlot[team] = 0u;
        SigmaNativeFreshTeamPriorSample[team] = 0u;
        if (teamActive &&
            sourceKind == SIGMA_NATIVE_FRESH_SOURCE_FOOTPRINT)
        {
            uint2 support = SigmaNativeFreshLoad2(sourceKind, sourceIndex,
                SIGMA_N4_FOOTPRINT_SUPPORT);
            SigmaNativeFreshTeamPriorSlot[team] = support.x;
            SigmaNativeFreshTeamPriorSample[team] = support.y;
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (teamLane < 16u)
    {
        bool priorRequested = teamActive && (header.x &
            SIGMA_NATIVE_OBSERVATION_PRIOR_SUPPORT) != 0u;
        if (sourceKind == SIGMA_NATIVE_FRESH_SOURCE_FOOTPRINT &&
            priorRequested)
        {
            uint stateAddress = SigmaNativeFreshTeamPriorSlot[team] *
                SIGMA_PAGE_LANE_COUNT +
                SigmaNativeFreshTeamPriorSample[team] * 16u + teamLane;
            uint certificateAddress = SigmaCarrierRepresentationAddress(
                SigmaNativeFreshTeamPriorSlot[team],
                SigmaNativeFreshTeamPriorSample[team],
                SIGMA_REPRESENTATION_CERTIFICATE + teamLane);
            SigmaNativeFreshPriorState[laneAddress] =
                _NativeSourceCarrierState[stateAddress];
            SigmaNativeFreshPriorCertificate[laneAddress] =
                _NativeSourceCarrierRepresentation[certificateAddress];
        }
        else if (teamActive &&
            sourceKind == SIGMA_NATIVE_FRESH_SOURCE_COMPLETION)
        {
            SigmaNativeFreshPriorState[laneAddress] =
                _NativeStates[_NativeFreshPriorStateOffset + teamLane];
            SigmaNativeFreshPriorCertificate[laneAddress] =
                _NativeLocalityCertificateWords[teamLane];
        }
        else
        {
            SigmaNativeFreshPriorState[laneAddress] = uint2(0u, 0u);
            SigmaNativeFreshPriorCertificate[laneAddress] = 0u;
        }
    }
    GroupMemoryBarrierWithGroupSync();

    SigmaNativeFreshScratch[laneAddress] = 1u;
    if (teamLane < 2u)
    {
        uint eye = teamLane;
        uint valid = 0u;
        uint4 permutation = uint4(0u, 0u, 0u, 0u);
        int globalSign = 0;
        uint2 measuredLower[4];
        uint2 measuredUpper[4];
        [unroll]
        for (uint initializeLeaf = 0u; initializeLeaf < 4u;
             ++initializeLeaf)
        {
            measuredLower[initializeLeaf] = uint2(0u, 0u);
            measuredUpper[initializeLeaf] = uint2(0u, 0u);
        }
        if (contextValid)
        {
            valid = 1u;
            uint2 roomRay[3];
            [unroll]
            for (uint component = 0u; component < 3u; ++component)
                roomRay[component] = SigmaNativeFreshLoad2(sourceKind,
                    sourceIndex, roomRayWord + eye * 3u + component);
            SigmaMerkabaBuildInstrumentRowPermutation(roomRay, permutation,
                globalSign, valid);
            uint2 codeLower[4];
            uint2 codeUpper[4];
            [unroll]
            for (uint instrumentLeaf = 0u; instrumentLeaf < 4u;
                 ++instrumentLeaf)
            {
                uint codeWord = codeLeafWord + eye * 8u +
                    instrumentLeaf * 2u;
                codeLower[instrumentLeaf] = SigmaNativeFreshLoad2(sourceKind,
                    sourceIndex, codeWord);
                codeUpper[instrumentLeaf] = SigmaNativeFreshLoad2(sourceKind,
                    sourceIndex, codeWord + 1u);
            }
            SigmaMerkabaAssembleInstrumentTangent(codeLower, codeUpper,
                globalSign, measuredLower, measuredUpper, valid);
        }
        SigmaNativeFreshEyePermutation[eyeBase + eye] = permutation;
        SigmaNativeFreshEyeSign[eyeBase + eye] = globalSign;
        [unroll]
        for (uint measuredLeaf = 0u; measuredLeaf < 4u; ++measuredLeaf)
        {
            uint destination = eye * 4u + measuredLeaf;
            SigmaNativeFreshInstrumentLower[leafBase + destination] =
                measuredLower[measuredLeaf];
            SigmaNativeFreshInstrumentUpper[leafBase + destination] =
                measuredUpper[measuredLeaf];
        }
        SigmaNativeFreshScratch[laneAddress] = valid;
    }
    GroupMemoryBarrierWithGroupSync();

    if (teamLane < 8u)
    {
        uint eye = teamLane >> 2u;
        uint leaf = teamLane & 3u;
        uint axis = 0u;
        uint leafValid = 0u;
        uint2 pulledLower = uint2(0u, 0u);
        uint2 pulledUpper = uint2(0u, 0u);
        if (contextValid)
        {
            axis = SigmaNativeFreshPermutationAxis(team, eye, leaf);
            leafValid = SigmaNativeFreshEyeSign[eyeBase + eye] != 0
                ? 1u : 0u;
            leafValid &= axis < 4u ? 1u : 0u;
            uint2 measuredLower =
                SigmaNativeFreshInstrumentLower[leafBase + teamLane];
            uint2 measuredUpper =
                SigmaNativeFreshInstrumentUpper[leafBase + teamLane];
            leafValid &= !SigmaI64Less(measuredUpper, measuredLower)
                ? 1u : 0u;
            uint pullValid = leafValid;
            if (SigmaNativeFreshEyeSign[eyeBase + eye] < 0)
            {
                pulledLower = SigmaQ48NegateChecked(measuredUpper,
                    pullValid);
                pulledUpper = SigmaQ48NegateChecked(measuredLower,
                    pullValid);
            }
            else
            {
                pulledLower = measuredLower;
                pulledUpper = measuredUpper;
            }
            leafValid &= pullValid;
        }
        SigmaNativeFreshLeafLower[leafBase + teamLane] = pulledLower;
        SigmaNativeFreshLeafUpper[leafBase + teamLane] = pulledUpper;
        SigmaNativeFreshLeafAxis[leafBase + teamLane] = axis;
        SigmaNativeFreshLeafEye[leafBase + teamLane] = eye;
        SigmaNativeFreshScratch[laneAddress] = leafValid;
    }
    GroupMemoryBarrierWithGroupSync();

    if (teamLane < 4u)
    {
        uint2 lower = uint2(0u, 0x80000000u);
        uint2 upper = uint2(0xffffffffu, 0x7fffffffu);
        uint eyeMask = 0u;
        uint axisValid = contextValid ? 1u : 0u;
        [unroll]
        for (uint sourceLeaf = 0u; sourceLeaf < 8u; ++sourceLeaf)
        {
            if (SigmaNativeFreshLeafAxis[leafBase + sourceLeaf] == teamLane)
            {
                axisValid &= SigmaNativeFreshScratch[
                    SigmaNativeFreshTeamLaneAddress(team, sourceLeaf)];
                lower = SigmaQ48Max(lower,
                    SigmaNativeFreshLeafLower[leafBase + sourceLeaf]);
                upper = SigmaQ48Min(upper,
                    SigmaNativeFreshLeafUpper[leafBase + sourceLeaf]);
                eyeMask |= 1u <<
                    SigmaNativeFreshLeafEye[leafBase + sourceLeaf];
            }
        }
        axisValid &= (eyeMask == 3u && !SigmaI64Less(upper, lower)) ? 1u : 0u;
        uint4 priorIdentity = SigmaNativeFreshPriorCertificate[
            SigmaNativeFreshTeamLaneAddress(team,
                SIGMA_CERTIFICATE_IDENTITY)];
        if ((priorIdentity.x & SIGMA_NATIVE_CERTIFICATE_FLAGS_VALID) != 0u)
        {
            uint4 priorAxis = SigmaNativeFreshPriorCertificate[
                SigmaNativeFreshTeamLaneAddress(team,
                    SIGMA_CERTIFICATE_AXIS0 + teamLane)];
            lower = SigmaQ48Max(lower, priorAxis.xy);
            upper = SigmaQ48Min(upper, priorAxis.zw);
            axisValid &= !SigmaI64Less(upper, lower) ? 1u : 0u;
        }
        SigmaNativeFreshAxisLower[axisBase + teamLane] = lower;
        SigmaNativeFreshAxisUpper[axisBase + teamLane] = upper;
        SigmaNativeFreshScratch[laneAddress] = axisValid;
    }
    else
        SigmaNativeFreshScratch[laneAddress] = 1u;
    GroupMemoryBarrierWithGroupSync();
    uint axisPhaseValid = 1u;
    if (teamLane == 0u)
    {
        uint axisPhaseBase = SigmaNativeFreshTeamLaneAddress(team, 0u);
        axisPhaseValid = SigmaNativeFreshScratch[axisPhaseBase] &
            SigmaNativeFreshScratch[axisPhaseBase + 1u] &
            SigmaNativeFreshScratch[axisPhaseBase + 2u] &
            SigmaNativeFreshScratch[axisPhaseBase + 3u];
    }

    // If the complete current S16 representative already satisfies both raw
    // calibrated eye shadows, retain all sixteen bytes—including shadow-hidden
    // modes—instead of relifting a lower-dimensional representative.
    bool priorRequested = teamActive && (header.x &
        SIGMA_NATIVE_OBSERVATION_PRIOR_SUPPORT) != 0u;
    SigmaNativeFreshScratch[laneAddress] = teamLane < 16u &&
        any(SigmaNativeFreshPriorState[laneAddress] != 0u)
        ? 1u : 0u;
    GroupMemoryBarrierWithGroupSync();
    uint priorNonzeroBase = SigmaNativeFreshTeamLaneAddress(team, 0u);
    if (teamLane == 0u)
    {
        uint aggregate = 0u;
        [unroll]
        for (uint reduceLane = 0u; reduceLane < 16u; ++reduceLane)
            aggregate |= SigmaNativeFreshScratch[
                priorNonzeroBase + reduceLane];
        SigmaNativeFreshScratch[priorNonzeroBase] = aggregate;
    }
    GroupMemoryBarrierWithGroupSync();
    uint priorNonzero = teamLane < 4u
        ? SigmaNativeFreshScratch[priorNonzeroBase] : 0u;
    if (teamLane < 4u)
    {
        uint priorValid = contextValid && priorRequested &&
            priorNonzero != 0u ? 1u : 0u;
        uint2 sum = uint2(0u, 0u);
        if (priorValid != 0u)
        {
            [unroll]
            for (uint priorLane = 1u; priorLane < 15u; ++priorLane)
            {
                sum = SigmaQ48AddChecked(sum,
                    SigmaMerkabaMultiplyDyadic(
                        SigmaNativeFreshPriorState[
                            SigmaNativeFreshTeamLaneAddress(team, priorLane)],
                        SIGMA_MERKABA_SHADOW_NUMERATOR4[
                            priorLane * 4u + teamLane], 2u,
                        priorValid), priorValid);
            }
        }
        SigmaNativeFreshPriorForward[axisBase + teamLane] = sum;
        SigmaNativeFreshScratch[laneAddress] = priorValid;
    }
    else
        SigmaNativeFreshScratch[laneAddress] = 1u;
    GroupMemoryBarrierWithGroupSync();
    uint priorForwardBase = SigmaNativeFreshTeamLaneAddress(team, 0u);
    if (teamLane == 0u)
    {
        SigmaNativeFreshScratch[priorForwardBase] =
            SigmaNativeFreshScratch[priorForwardBase] &
            SigmaNativeFreshScratch[priorForwardBase + 1u] &
            SigmaNativeFreshScratch[priorForwardBase + 2u] &
            SigmaNativeFreshScratch[priorForwardBase + 3u];
    }
    GroupMemoryBarrierWithGroupSync();
    uint priorForwardValid = teamLane < 8u
        ? SigmaNativeFreshScratch[priorForwardBase] : 0u;

    // A supported prior strictly before both independently measured first-hit
    // strata is exact stereo pass-through evidence.  Keep this proof separate
    // from the lifted mould state: it may retire the contradicted support, but
    // it may never drag an unrelated farther manifestation into that gauge.
    SigmaNativeFreshScratch[laneAddress] = 1u;
    if (teamLane < 8u)
    {
        uint eye = teamLane >> 2u;
        uint leaf = teamLane & 3u;
        if (leaf == SIGMA_NATIVE_LEAF_KIND_ORDER)
        {
            uint preHitValid = priorForwardValid;
            uint axis = SigmaNativeFreshPermutationAxis(team, eye, leaf);
            uint2 predicted = SigmaNativeFreshPriorForward[axisBase + axis];
            if (SigmaNativeFreshEyeSign[eyeBase + eye] < 0)
                predicted = SigmaQ48NegateChecked(predicted, preHitValid);
            SigmaNativeFreshScratch[laneAddress] = preHitValid != 0u &&
                SigmaI64Less(predicted,
                    SigmaNativeFreshInstrumentLower[leafBase + teamLane])
                    ? 1u : 0u;
        }
    }
    GroupMemoryBarrierWithGroupSync();
    uint stereoPreHit = 1u;
    if (teamLane == 0u)
    {
        uint stereoPreHitBase = SigmaNativeFreshTeamLaneAddress(team, 0u);
        stereoPreHit = SigmaNativeFreshScratch[stereoPreHitBase] &
            SigmaNativeFreshScratch[stereoPreHitBase + 4u];
    }
    if (teamLane == 0u)
    {
        uint required = SIGMA_NATIVE_FRESH_COHERENT |
            SIGMA_NATIVE_FRESH_LEFT_FIRST_HIT |
            SIGMA_NATIVE_FRESH_RIGHT_FIRST_HIT |
            SIGMA_NATIVE_FRESH_LEFT_EVIDENCE |
            SIGMA_NATIVE_FRESH_RIGHT_EVIDENCE;
        SigmaNativeFreshTeamStaticExclusion[team] = priorRequested &&
            priorNonzero != 0u && priorForwardValid != 0u &&
            stereoPreHit != 0u && (header.x & required) == required ? 1u : 0u;
    }
    GroupMemoryBarrierWithGroupSync();

    SigmaNativeFreshScratch[laneAddress] = 1u;
    if (teamLane < 8u)
    {
        uint eye = teamLane >> 2u;
        uint leaf = teamLane & 3u;
        uint priorLeafValid = priorForwardValid;
        uint axis = SigmaNativeFreshPermutationAxis(team, eye, leaf);
        uint2 predicted = SigmaNativeFreshPriorForward[axisBase + axis];
        if (SigmaNativeFreshEyeSign[eyeBase + eye] < 0)
            predicted = SigmaQ48NegateChecked(predicted, priorLeafValid);
        priorLeafValid &= SigmaNativePointInInterval(predicted,
            SigmaNativeFreshInstrumentLower[leafBase + teamLane],
            SigmaNativeFreshInstrumentUpper[leafBase + teamLane]) ? 1u : 0u;
        SigmaNativeFreshScratch[laneAddress] = priorLeafValid;
    }
    GroupMemoryBarrierWithGroupSync();
    uint priorRawValid = 1u;
    if (teamLane == 0u)
    {
        uint priorRawBase = SigmaNativeFreshTeamLaneAddress(team, 0u);
        [unroll]
        for (uint reduceLane = 0u; reduceLane < 8u; ++reduceLane)
            priorRawValid &= SigmaNativeFreshScratch[
                priorRawBase + reduceLane];
    }

    if (teamLane == 0u)
    {
        SigmaNativeFreshTeamHasPrior[team] = priorRequested &&
            priorNonzero != 0u &&
            priorForwardValid != 0u ? 1u : 0u;
        SigmaNativeFreshTeamUsePrior[team] =
            SigmaNativeFreshTeamHasPrior[team] != 0u &&
            priorRawValid != 0u ? 1u : 0u;
        uint selectorValid = axisPhaseValid;
        bool selectedValid = SigmaNativeFreshTeamUsePrior[team] != 0u;
        if (SigmaNativeFreshTeamUsePrior[team] != 0u)
        {
            [unroll]
            for (uint priorAxis = 0u; priorAxis < 4u; ++priorAxis)
                SigmaNativeFreshSelected[axisBase + priorAxis] =
                    SigmaNativeFreshPriorForward[axisBase + priorAxis];
        }
        else if (contextValid)
        {
            uint2 lower[4];
            uint2 upper[4];
            uint2 selected[4];
            [unroll]
            for (uint axisCopy = 0u; axisCopy < 4u; ++axisCopy)
            {
                lower[axisCopy] =
                    SigmaNativeFreshAxisLower[axisBase + axisCopy];
                upper[axisCopy] =
                    SigmaNativeFreshAxisUpper[axisBase + axisCopy];
                selected[axisCopy] = uint2(0u, 0u);
            }
            selectedValid = SigmaMerkabaSelectFreshTangent(lower, upper,
                selected, selectorValid);
            [unroll]
            for (uint selectedAxis = 0u; selectedAxis < 4u; ++selectedAxis)
                SigmaNativeFreshSelected[axisBase + selectedAxis] =
                    selected[selectedAxis];
        }
        else
        {
            [unroll]
            for (uint selectedAxis = 0u; selectedAxis < 4u; ++selectedAxis)
                SigmaNativeFreshSelected[axisBase + selectedAxis] =
                    uint2(0u, 0u);
        }
        SigmaNativeFreshTeamPhaseValid[team] =
            selectedValid && selectorValid != 0u
            ? 1u : 0u;
    }
    GroupMemoryBarrierWithGroupSync();

    SigmaNativeFreshScratch[laneAddress] = 1u;
    if (teamLane < 16u)
    {
        uint laneValid = SigmaNativeFreshTeamPhaseValid[team];
        uint2 laneValue = SigmaNativeFreshTeamHasPrior[team] != 0u
            ? SigmaNativeFreshPriorState[laneAddress]
            : uint2(0u, 0u);
        if (SigmaNativeFreshTeamPhaseValid[team] != 0u &&
            SigmaNativeFreshTeamUsePrior[team] == 0u &&
            teamLane > 0u && teamLane < 15u)
        {
            [unroll]
            for (uint liftAxis = 0u; liftAxis < 4u; ++liftAxis)
            {
                uint2 correction =
                    SigmaNativeFreshSelected[axisBase + liftAxis];
                if (SigmaNativeFreshTeamHasPrior[team] != 0u)
                    correction = SigmaQ48SubChecked(correction,
                        SigmaNativeFreshPriorForward[axisBase + liftAxis],
                        laneValid);
                laneValue = SigmaQ48AddChecked(laneValue,
                    SigmaMerkabaMultiplyDyadic(correction,
                        SIGMA_MERKABA_SHADOW_NUMERATOR4[
                            teamLane * 4u + liftAxis], 6u,
                        laneValid), laneValid);
            }
        }
        SigmaNativeFreshState[laneAddress] = laneValue;
        if (teamActive)
            _NativeStates[stateOffset + teamLane] = laneValue;
        SigmaNativeFreshScratch[laneAddress] = laneValid;
    }
    GroupMemoryBarrierWithGroupSync();
    uint liftValid = 1u;
    if (teamLane == 0u)
    {
        uint liftValidBase = SigmaNativeFreshTeamLaneAddress(team, 0u);
        [unroll]
        for (uint reduceLane = 0u; reduceLane < 16u; ++reduceLane)
            liftValid &= SigmaNativeFreshScratch[liftValidBase + reduceLane];
    }

    SigmaNativeFreshScratch[laneAddress] = teamLane < 16u &&
        any(SigmaNativeFreshState[laneAddress] != 0u) ? 1u : 0u;
    GroupMemoryBarrierWithGroupSync();
    uint stateNonzero = 0u;
    if (teamLane == 0u)
    {
        uint stateNonzeroBase = SigmaNativeFreshTeamLaneAddress(team, 0u);
        [unroll]
        for (uint reduceLane = 0u; reduceLane < 16u; ++reduceLane)
            stateNonzero |= SigmaNativeFreshScratch[
                stateNonzeroBase + reduceLane];
    }
    if (teamLane == 0u)
    {
        SigmaNativeFreshTeamPhaseValid[team] &= liftValid & stateNonzero;
    }
    GroupMemoryBarrierWithGroupSync();

    if (teamLane < 4u)
    {
        uint forwardValid = SigmaNativeFreshTeamPhaseValid[team];
        uint2 sum = SigmaNativeFreshTeamUsePrior[team] != 0u
            ? SigmaNativeFreshPriorForward[axisBase + teamLane]
            : uint2(0u, 0u);
        if (SigmaNativeFreshTeamPhaseValid[team] != 0u &&
            SigmaNativeFreshTeamUsePrior[team] == 0u)
        {
            [unroll]
            for (uint forwardLane = 1u; forwardLane < 15u; ++forwardLane)
            {
                sum = SigmaQ48AddChecked(sum,
                    SigmaMerkabaMultiplyDyadic(
                        SigmaNativeFreshState[
                            SigmaNativeFreshTeamLaneAddress(team, forwardLane)],
                        SIGMA_MERKABA_SHADOW_NUMERATOR4[
                            forwardLane * 4u + teamLane], 2u,
                        forwardValid), forwardValid);
            }
        }
        SigmaNativeFreshForward[axisBase + teamLane] = sum;
        SigmaNativeFreshScratch[laneAddress] = forwardValid;
    }
    else
        SigmaNativeFreshScratch[laneAddress] = 1u;
    GroupMemoryBarrierWithGroupSync();
    uint forwardPhaseBase = SigmaNativeFreshTeamLaneAddress(team, 0u);
    if (teamLane == 0u)
    {
        SigmaNativeFreshScratch[forwardPhaseBase] =
            SigmaNativeFreshScratch[forwardPhaseBase] &
            SigmaNativeFreshScratch[forwardPhaseBase + 1u] &
            SigmaNativeFreshScratch[forwardPhaseBase + 2u] &
            SigmaNativeFreshScratch[forwardPhaseBase + 3u];
    }
    GroupMemoryBarrierWithGroupSync();
    uint forwardPhaseValid = teamLane < 8u
        ? SigmaNativeFreshScratch[forwardPhaseBase] : 0u;

    SigmaNativeFreshScratch[laneAddress] = 1u;
    if (teamLane < 8u)
    {
        uint eye = teamLane >> 2u;
        uint leaf = teamLane & 3u;
        uint leafForwardValid = forwardPhaseValid;
        uint axis = SigmaNativeFreshPermutationAxis(team, eye, leaf);
        uint2 predicted = SigmaNativeFreshForward[axisBase + axis];
        if (SigmaNativeFreshEyeSign[eyeBase + eye] < 0)
            predicted = SigmaQ48NegateChecked(predicted, leafForwardValid);
        leafForwardValid &= SigmaNativePointInInterval(predicted,
            SigmaNativeFreshInstrumentLower[leafBase + teamLane],
            SigmaNativeFreshInstrumentUpper[leafBase + teamLane]) ? 1u : 0u;
        SigmaNativeFreshScratch[laneAddress] = leafForwardValid;
    }
    GroupMemoryBarrierWithGroupSync();
    uint rawForwardValid = 1u;
    if (teamLane == 0u)
    {
        uint rawForwardBase = SigmaNativeFreshTeamLaneAddress(team, 0u);
        [unroll]
        for (uint reduceLane = 0u; reduceLane < 8u; ++reduceLane)
            rawForwardValid &= SigmaNativeFreshScratch[
                rawForwardBase + reduceLane];
    }

    if (teamActive && writeLegacyReceipt && teamLane == 0u)
    {
        SigmaNativeFreshTeamPhaseValid[team] &= rawForwardValid;
        _NativeBranchHeaders[sourceIndex] = uint4(sourceIndex,
            SigmaNativeFreshTeamPhaseValid[team], header.x,
            SigmaNativeFreshTeamStaticExclusion[team]);
    }
    else if (teamLane == 0u)
        SigmaNativeFreshTeamPhaseValid[team] &= rawForwardValid;
    GroupMemoryBarrierWithGroupSync();
    if (teamActive && writeLegacyReceipt && teamLane < 4u)
        _NativeBranchPredictions[sourceIndex * 4u + teamLane] = uint4(
            SigmaNativeFreshSelected[axisBase + teamLane], 0u, 0u);
    if (teamLane < SIGMA_CERTIFICATE_WORD_COUNT)
    {
        uint4 certificateWord = 0u;
        uint4 priorIdentity = SigmaNativeFreshPriorCertificate[
            SigmaNativeFreshTeamLaneAddress(team,
                SIGMA_CERTIFICATE_IDENTITY)];
        if (teamLane == SIGMA_CERTIFICATE_IDENTITY)
        {
            certificateWord = uint4(
                SIGMA_NATIVE_CERTIFICATE_FLAGS_VALID |
                SIGMA_NATIVE_CERTIFICATE_FLAGS_DIRECTIONAL |
                SIGMA_NATIVE_CERTIFICATE_FLAGS_MINIMIZED,
                SIGMA_CERTIFICATE_FINGERPRINT[0u], 1u, priorIdentity.w);
        }
        else if (teamLane == SIGMA_CERTIFICATE_CONTEXT)
            certificateWord = uint4(header.z,
                header.x & ~SIGMA_NATIVE_OBSERVATION_PRIOR_SUPPORT,
                instrument.x, instrument.y);
        else if (teamLane == SIGMA_CERTIFICATE_INDEPENDENCE)
            certificateWord = uint4(0u,
                SigmaNativeFreshPermutationMode(
                    SigmaNativeFreshEyePermutation[eyeBase],
                    SigmaNativeFreshEyeSign[eyeBase]),
                SigmaNativeFreshPermutationMode(
                    SigmaNativeFreshEyePermutation[eyeBase + 1u],
                    SigmaNativeFreshEyeSign[eyeBase + 1u]), 0u);
        else if (teamLane == SIGMA_CERTIFICATE_RELATION)
            certificateWord = 0u;
        else if (teamLane >= SIGMA_CERTIFICATE_AXIS0 &&
            teamLane < SIGMA_CERTIFICATE_INFORMATION0)
        {
            uint axis = teamLane - SIGMA_CERTIFICATE_AXIS0;
            certificateWord = uint4(
                SigmaNativeFreshAxisLower[axisBase + axis],
                SigmaNativeFreshAxisUpper[axisBase + axis]);
        }
        else if (teamLane >= SIGMA_CERTIFICATE_INFORMATION0 &&
            teamLane < SIGMA_CERTIFICATE_RECEIPTS0)
        {
            uint axis = teamLane - SIGMA_CERTIFICATE_INFORMATION0;
            uint widthValid = SigmaNativeFreshTeamPhaseValid[team];
            uint2 width = SigmaQ48SubChecked(
                SigmaNativeFreshAxisUpper[axisBase + axis],
                SigmaNativeFreshAxisLower[axisBase + axis], widthValid);
            certificateWord = widthValid != 0u
                ? uint4(width, axis, 3u) : 0u;
        }
        else if (teamLane == SIGMA_CERTIFICATE_RECEIPTS0)
            certificateWord = uint4(header.z,
                header.x & ~SIGMA_NATIVE_OBSERVATION_PRIOR_SUPPORT,
                instrument.x, instrument.y);
        else if (teamLane == SIGMA_CERTIFICATE_RECEIPTS0 + 1u)
            certificateWord = instrument;
        else if (teamLane == SIGMA_CERTIFICATE_RECEIPTS0 + 2u)
        {
            uint4 priorModes = SigmaNativeFreshPriorCertificate[
                SigmaNativeFreshTeamLaneAddress(team,
                    SIGMA_CERTIFICATE_RECEIPTS0 + 2u)];
            uint leftMode = SigmaNativeFreshPermutationMode(
                SigmaNativeFreshEyePermutation[eyeBase],
                SigmaNativeFreshEyeSign[eyeBase]);
            uint rightMode = SigmaNativeFreshPermutationMode(
                SigmaNativeFreshEyePermutation[eyeBase + 1u],
                SigmaNativeFreshEyeSign[eyeBase + 1u]);
            uint2 leftMask = SigmaNativeFreshModeMask(priorModes.xy, leftMode);
            uint2 rightMask = SigmaNativeFreshModeMask(priorModes.zw, rightMode);
            certificateWord = uint4(leftMask, rightMask);
        }
        else if (teamLane == SIGMA_CERTIFICATE_RECEIPTS0 + 3u)
            certificateWord = uint4(SIGMA_CERTIFICATE_FINGERPRINT[0u],
                SIGMA_CERTIFICATE_FINGERPRINT[1u],
                SIGMA_CERTIFICATE_FINGERPRINT[2u],
                SIGMA_CERTIFICATE_FINGERPRINT[3u]);
        uint4 persistedCertificate =
            SigmaNativeFreshTeamPhaseValid[team] != 0u
            ? certificateWord : 0u;
        if (teamActive)
            _NativeLocalityCertificateWords[
                certificateOffset + teamLane] = persistedCertificate;
        // The same lane writes its already-contracted proof into the cold
        // persistence envelope.  This is not another pass or authority: the
        // live carrier continues to consume LocalityCertificateWords directly.
        if (teamActive && writeLegacyReceipt && sourceIndex == 0u)
        {
            uint completion = SigmaNativeFreshEvidenceAddress(sourceKind,
                sourceIndex,
                SIGMA_COMPLETION_CERTIFICATE + teamLane * 2u);
            _NativeFreshEvidenceWords[completion] = persistedCertificate.xy;
            _NativeFreshEvidenceWords[completion + 1u] =
                persistedCertificate.zw;
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (teamActive && SigmaNativeFreshTeamPhaseValid[team] == 0u &&
        teamLane < 16u)
        _NativeStates[stateOffset + teamLane] = uint2(0u, 0u);
    if (teamActive && !writeLegacyReceipt && teamLane == 0u)
    {
        // CUT E consumes this generated contractor disposition.  It is
        // execution evidence beside the level, never another physical state.
        uint address = sourceIndex * SIGMA_N4_FOOTPRINT_EVIDENCE_WORDS +
            SIGMA_N4_FOOTPRINT_EVIDENCE_WORDS - 1u;
        uint2 detail = _NativeCloseScratch[address];
        detail.y = (detail.y & SIGMA_N4_FOOTPRINT_LEVEL_MASK) |
            (SigmaNativeFreshTeamStaticExclusion[team] != 0u
                ? SIGMA_N4_FOOTPRINT_STATIC_EXCLUSION : 0u);
        _NativeCloseScratch[address] = detail;
    }
}

void SigmaNativeFreshLiftLegacyBranch(uint branchIndex, uint team,
    uint teamLane, bool active)
{
    SigmaNativeFreshLiftSource(SIGMA_NATIVE_FRESH_SOURCE_COMPLETION,
        branchIndex, branchIndex * 16u, SIGMA_CERTIFICATE_WORD_COUNT,
        team, teamLane, active, active);
}

void SigmaNativeFreshLiftFootprint(uint footprint, uint team, uint teamLane,
    bool active)
{
    SigmaNativeFreshLiftSource(SIGMA_NATIVE_FRESH_SOURCE_FOOTPRINT,
        footprint, _NativeFootprintStateOffset + footprint * 16u,
        _NativeFootprintCertificateOffset + footprint *
            SIGMA_CERTIFICATE_WORD_COUNT, team, teamLane, active, false);
}

void SigmaN4ContractStoreNoStitch(uint boundary)
{
    uint address = _NativeBoundaryScratchOffset +
        boundary * SIGMA_N4_BOUNDARY_RECEIPT_WORDS;
    _NativeCloseScratch[address] = uint2(SIGMA_STITCH_NO_STITCH, 0u);
    _NativeCloseScratch[address + 1u] = 0u;
    _NativeCloseScratch[address + 2u] = 0u;
    _NativeCloseScratch[address + 3u] = 0u;
    _NativeCloseScratch[address + 4u] =
        SIGMA_STITCH_GENERATED_BRACKET_FINGERPRINT;
    _NativeCloseScratch[address + 5u] = 0u;
    uint ignored;
    InterlockedAdd(_NativeCloseScratch[
        _NativeGlobalHeaderScratchOffset + 3u].y, 1u, ignored);
}

void SigmaN4ContractBoundaryCandidate(uint boundary, uint left, uint right,
    uint leftSide, uint rightSide)
{
    uint required = SIGMA_NATIVE_OBSERVATION_LEFT_EVIDENCE |
        SIGMA_NATIVE_OBSERVATION_RIGHT_EVIDENCE |
        SIGMA_NATIVE_OBSERVATION_LEFT_FIRST_HIT |
        SIGMA_NATIVE_OBSERVATION_RIGHT_FIRST_HIT;
    uint leftFlags = _NativeObservations[left + 1u].Identity.w;
    uint rightFlags = _NativeObservations[right + 1u].Identity.w;
    if ((leftFlags & required) != required ||
        (rightFlags & required) != required)
    {
        SigmaN4ContractStoreNoStitch(boundary);
        return;
    }

    uint2 leftLower[3];
    uint2 leftUpper[3];
    uint2 rightLower[3];
    uint2 rightUpper[3];
    [unroll]
    for (uint axis = 0u; axis < 3u; ++axis)
    {
        uint leftAddress = left * SIGMA_N4_FOOTPRINT_EVIDENCE_WORDS +
            SIGMA_N4_FOOTPRINT_BOUNDARY_ENVELOPES + leftSide * 6u +
            axis * 2u;
        uint rightAddress = right * SIGMA_N4_FOOTPRINT_EVIDENCE_WORDS +
            SIGMA_N4_FOOTPRINT_BOUNDARY_ENVELOPES + rightSide * 6u +
            axis * 2u;
        leftLower[axis] = _NativeCloseScratch[leftAddress];
        leftUpper[axis] = _NativeCloseScratch[leftAddress + 1u];
        rightLower[axis] = _NativeCloseScratch[rightAddress];
        rightUpper[axis] = _NativeCloseScratch[rightAddress + 1u];
    }
    if (!SigmaMerkabaBoundaryEnvelopesContact(
            SIGMA_NATIVE_QUERY_FIRST_HIT_MOULD,
            SIGMA_NATIVE_QUERY_FIRST_HIT_MOULD,
            leftLower, leftUpper, rightLower, rightUpper))
    {
        SigmaN4ContractStoreNoStitch(boundary);
        return;
    }

    // Atomic append order is execution-only.  The exact evaluator reloads the
    // canonical boundary id and writes only to that boundary's receipt address.
    uint compactIndex;
    InterlockedAdd(_NativeCounters[2u].w, 1u, compactIndex);
    _NativeCloseScratch[_NativeActiveSupportListScratchOffset + compactIndex] =
        uint2(boundary, 0u);

    // Dispatch group zero retains the legacy relation collective.  Vulkan's
    // per-dimension limit is 65535; padding in the final row performs no payload.
    uint totalGroups = compactIndex + 2u;
    uint gridX = min(totalGroups, 65535u);
    uint gridY = (totalGroups + 65534u) / 65535u;
    uint ignored;
    InterlockedMax(_NativeCounters[2u].x, gridX, ignored);
    InterlockedMax(_NativeCounters[2u].y, gridY, ignored);
}
#endif

#if defined(SIGMA_N4_TILE_CLOSE_VARIANT)
uint SigmaN4TileFootprintAddress(uint footprint, uint word)
{
    return _NativeTileFootprintScratchOffset +
        footprint * SIGMA_N4_TILE_FOOTPRINT_RECEIPT_WORDS + word;
}

uint SigmaN4TileSupportAddress(uint tile, uint summary, uint word)
{
    return _NativeTileSupportSummaryScratchOffset +
        (tile * SIGMA_N4_TILE_FOOTPRINT_CAPACITY + summary) *
            SIGMA_N4_TILE_SUPPORT_SUMMARY_WORDS + word;
}

uint SigmaN4TileComponentAddress(uint tile, uint summary, uint word)
{
    return _NativeTileComponentSummaryScratchOffset +
        (tile * SIGMA_N4_TILE_FOOTPRINT_CAPACITY + summary) *
            SIGMA_N4_TILE_COMPONENT_SUMMARY_WORDS + word;
}

uint SigmaN4TileCanonicalComponentAddress(uint component, uint word)
{
    return _NativeCanonicalComponentScratchOffset +
        component * SIGMA_N4_COMPONENT_WORDS + word;
}

uint SigmaN4TileCanonicalImageAddress(uint image, uint index)
{
    return _NativeCanonicalImageScratchOffset +
        image * _NativeCanonicalImageStride + index;
}

uint SigmaN4TileGlobalFootprint(uint tile, uint local)
{
    uint tileCountX = (_NativeResolution.x + SIGMA_N4_TILE_SIZE - 1u) /
        SIGMA_N4_TILE_SIZE;
    uint2 tileCoordinate = uint2(tile % tileCountX, tile / tileCountX);
    uint2 localCoordinate = uint2(local & 15u, local >> 4u);
    uint2 pixel = tileCoordinate * SIGMA_N4_TILE_SIZE + localCoordinate;
    return pixel.y * _NativeResolution.x + pixel.x;
}

bool SigmaN4TileFootprintValid(uint footprint)
{
    uint required = SIGMA_NATIVE_OBSERVATION_LEFT_EVIDENCE |
        SIGMA_NATIVE_OBSERVATION_RIGHT_EVIDENCE |
        SIGMA_NATIVE_OBSERVATION_LEFT_FIRST_HIT |
        SIGMA_NATIVE_OBSERVATION_RIGHT_FIRST_HIT;
    uint flags = _NativeObservations[footprint + 1u].Identity.w;
    uint certificate = _NativeLocalityCertificateWords[
        _NativeFootprintCertificateOffset +
        footprint * SIGMA_CERTIFICATE_WORD_COUNT +
        SIGMA_CERTIFICATE_IDENTITY].x;
    uint certificateRequired = SIGMA_NATIVE_CERTIFICATE_FLAGS_VALID |
        SIGMA_NATIVE_CERTIFICATE_FLAGS_DIRECTIONAL |
        SIGMA_NATIVE_CERTIFICATE_FLAGS_MINIMIZED;
    return (flags & required) == required &&
        (certificate & certificateRequired) == certificateRequired;
}

uint SigmaN4TileSupportKey(uint footprint)
{
    uint flags = _NativeObservations[footprint + 1u].Identity.w;
    uint result = SIGMA_N4_TILE_INVALID;
    if ((flags & SIGMA_NATIVE_OBSERVATION_PRIOR_SUPPORT) != 0u)
    {
        uint2 support = _NativeCloseScratch[
            footprint * SIGMA_N4_FOOTPRINT_EVIDENCE_WORDS +
            SIGMA_N4_FOOTPRINT_SUPPORT];
        if (support.y < SIGMA_PAGE_SAMPLE_COUNT)
            result = support.x * SIGMA_PAGE_SAMPLE_COUNT + support.y;
    }
    return result;
}

uint SigmaN4TileAnchorEncode(uint footprint)
{
    return footprint == SIGMA_N4_TILE_INVALID ? 0u : footprint + 1u;
}

uint SigmaN4TileAnchorDecode(uint value)
{
    value &= SIGMA_N4_ANCHOR_LOCATOR_MASK;
    return value == 0u ? SIGMA_N4_TILE_INVALID : value - 1u;
}

uint2 SigmaN4TilePackAnchorOrbits(uint orbit0, uint orbit1, uint orbit2)
{
    uint a = SigmaN4TileAnchorEncode(orbit0);
    uint b = SigmaN4TileAnchorEncode(orbit1);
    uint c = SigmaN4TileAnchorEncode(orbit2);
    return uint2(a | ((b & 0x00007fffu) << 17u),
        (b >> 15u) | (c << 2u));
}

uint SigmaN4TileUnpackAnchorOrbit(uint2 packed, uint orbit)
{
    uint encoded = orbit == 0u
        ? packed.x & SIGMA_N4_ANCHOR_LOCATOR_MASK
        : (orbit == 1u
            ? ((packed.x >> 17u) | ((packed.y & 3u) << 15u)) &
                SIGMA_N4_ANCHOR_LOCATOR_MASK
            : (packed.y >> 2u) & SIGMA_N4_ANCHOR_LOCATOR_MASK);
    return SigmaN4TileAnchorDecode(encoded);
}

int SigmaN4TileCompareSignedDyadic(int left, uint leftLevel,
    int right, uint rightLevel)
{
    if (left == right && leftLevel == rightLevel) return 0;
    bool leftNegative = left < 0;
    bool rightNegative = right < 0;
    if (leftNegative != rightNegative) return leftNegative ? -1 : 1;
    uint leftMagnitude = leftNegative ? (~asuint(left) + 1u) : asuint(left);
    uint rightMagnitude = rightNegative
        ? (~asuint(right) + 1u) : asuint(right);
    if (leftMagnitude == 0u || rightMagnitude == 0u)
    {
        if (leftMagnitude == rightMagnitude) return 0;
        return leftMagnitude == 0u
            ? (rightNegative ? 1 : -1)
            : (leftNegative ? -1 : 1);
    }
    uint leftBits = firstbithigh(leftMagnitude) + 1u;
    uint rightBits = firstbithigh(rightMagnitude) + 1u;
    int leftExponent = (int)leftBits - (int)leftLevel;
    int rightExponent = (int)rightBits - (int)rightLevel;
    int comparison = 0;
    if (leftExponent != rightExponent)
        comparison = leftExponent < rightExponent ? -1 : 1;
    else
    {
        uint leftNormalized = leftMagnitude << (32u - leftBits);
        uint rightNormalized = rightMagnitude << (32u - rightBits);
        if (leftNormalized != rightNormalized)
            comparison = leftNormalized < rightNormalized ? -1 : 1;
    }
    return leftNegative ? -comparison : comparison;
}

int SigmaN4TileCompareAnchor(uint left, uint right, uint image, uint orbit)
{
    if (left == right) return 0;
    if (left == SIGMA_N4_TILE_INVALID) return 1;
    if (right == SIGMA_N4_TILE_INVALID) return -1;
    uint leftAddress = SigmaN4TileFootprintAddress(left, 2u + orbit * 2u);
    uint rightAddress = SigmaN4TileFootprintAddress(right, 2u + orbit * 2u);
    uint4 leftChart = uint4(_NativeCloseScratch[leftAddress],
        _NativeCloseScratch[leftAddress + 1u]);
    uint4 rightChart = uint4(_NativeCloseScratch[rightAddress],
        _NativeCloseScratch[rightAddress + 1u]);
    bool leftAssigned = (leftChart.z & 8u) != 0u;
    bool rightAssigned = (rightChart.z & 8u) != 0u;
    if (leftAssigned != rightAssigned) return leftAssigned ? -1 : 1;
    if (!leftAssigned) return left < right ? -1 : 1;
    uint valid = 1u;
    int2 leftCell = SigmaMerkabaTransformChartCellLower(
        int2(asint(leftChart.x), asint(leftChart.y)), image, valid);
    int2 rightCell = SigmaMerkabaTransformChartCellLower(
        int2(asint(rightChart.x), asint(rightChart.y)), image, valid);
    uint leftLevel = _NativeCloseScratch[
        left * SIGMA_N4_FOOTPRINT_EVIDENCE_WORDS +
        SIGMA_N4_FOOTPRINT_EVIDENCE_WORDS - 1u].y &
        SIGMA_N4_FOOTPRINT_LEVEL_MASK;
    uint rightLevel = _NativeCloseScratch[
        right * SIGMA_N4_FOOTPRINT_EVIDENCE_WORDS +
        SIGMA_N4_FOOTPRINT_EVIDENCE_WORDS - 1u].y &
        SIGMA_N4_FOOTPRINT_LEVEL_MASK;
    int comparison = SigmaN4TileCompareSignedDyadic(leftCell.x, leftLevel,
        rightCell.x, rightLevel);
    if (comparison == 0)
        comparison = SigmaN4TileCompareSignedDyadic(leftCell.y, leftLevel,
            rightCell.y, rightLevel);
    // An equal dyadic lower corner has one identical translation. The locator
    // tie is execution-only and cannot enter canonical bytes.
    if (comparison == 0) comparison = left < right ? -1 : 1;
    return valid != 0u ? comparison : (left < right ? -1 : 1);
}

uint SigmaN4TileBoundaryIndex(uint footprint, uint neighbour)
{
    uint horizontalCount = (_NativeResolution.x - 1u) *
        _NativeResolution.y;
    uint low = min(footprint, neighbour);
    uint difference = max(footprint, neighbour) - low;
    uint result = 0u;
    if (difference == 1u)
    {
        uint y = low / _NativeResolution.x;
        uint x = low - y * _NativeResolution.x;
        result = y * (_NativeResolution.x - 1u) + x;
    }
    else
    {
        uint y = low / _NativeResolution.x;
        uint x = low - y * _NativeResolution.x;
        result = horizontalCount + y * _NativeResolution.x + x;
    }
    return result;
}

uint4 SigmaN4TileBoundaryHeader(uint boundary)
{
    uint address = _NativeBoundaryScratchOffset +
        boundary * SIGMA_N4_BOUNDARY_RECEIPT_WORDS;
    return uint4(_NativeCloseScratch[address],
        _NativeCloseScratch[address + 1u]);
}

bool SigmaN4TileResolvedEdge(uint footprint, uint neighbour)
{
    return SigmaN4TileBoundaryHeader(
        SigmaN4TileBoundaryIndex(footprint, neighbour)).x ==
        SIGMA_STITCH_RESOLVED;
}

int2 SigmaN4ChartDirection(uint assignment, uint frame, uint sector,
    inout uint valid)
{
    int2 source = SigmaMerkabaSectorChartCandidateDirection(assignment,
        sector, valid);
    valid &= frame < 8u ? 1u : 0u;
    int4 transform = SIGMA_STITCH_CHART_D4[min(frame, 7u)];
    return int2(transform.x * source.x + transform.y * source.y,
        transform.z * source.x + transform.w * source.y);
}

bool SigmaN4TileNeighbour(uint tile, uint local, uint direction,
    out uint neighbourLocal, out uint neighbourFootprint)
{
    uint x = local & 15u;
    uint y = local >> 4u;
    bool valid = true;
    if (direction == 0u) valid = x != 0u;
    else if (direction == 1u) valid = x != 15u;
    else if (direction == 2u) valid = y != 0u;
    else valid = y != 15u;
    int offset = direction == 0u ? -1 :
        (direction == 1u ? 1 : (direction == 2u ? -16 : 16));
    neighbourLocal = valid ? (uint)((int)local + offset) : local;
    neighbourFootprint = SigmaN4TileGlobalFootprint(tile, neighbourLocal);
    return valid;
}

void SigmaN4TileSortSupports(uint tile, uint local)
{
    uint footprint = SigmaN4TileGlobalFootprint(tile, local);
    uint key = SigmaN4TileFootprintValid(footprint)
        ? SigmaN4TileSupportKey(footprint) : SIGMA_N4_TILE_INVALID;
    uint2 entry = uint2(key, local);
    SigmaN4TileLabel[local] = entry;
    if (local == 0u)
        SigmaN4TileSupportedCount = 0u;
    GroupMemoryBarrierWithGroupSync();

    if (key != SIGMA_N4_TILE_INVALID)
    {
        uint ignored;
        InterlockedAdd(SigmaN4TileSupportedCount, 1u, ignored);
    }
    GroupMemoryBarrierWithGroupSync();

    // The common fresh tile has no prior support and performs no ranking at
    // all.  When support exists, only supported lanes rank against supported
    // keys; the invalid tail is never sorted for execution cosmetics.
    if (SigmaN4TileSupportedCount != 0u && key != SIGMA_N4_TILE_INVALID)
    {
        uint rank = 0u;
        [loop]
        for (uint other = 0u; other < SIGMA_N4_TILE_FOOTPRINT_CAPACITY;
             ++other)
        {
            uint2 candidate = SigmaN4TileLabel[other];
            rank += candidate.x != SIGMA_N4_TILE_INVALID &&
                (candidate.x < entry.x ||
                (candidate.x == entry.x && candidate.y < entry.y)) ? 1u : 0u;
        }
        SigmaN4TileSort[rank] = entry;
    }
    GroupMemoryBarrierWithGroupSync();
}

uint4 SigmaN4TileCertificate(uint footprint, uint word)
{
    return _NativeLocalityCertificateWords[
        _NativeFootprintCertificateOffset +
        footprint * SIGMA_CERTIFICATE_WORD_COUNT + word];
}

void SigmaN4TileStoreCertificate(uint footprint, uint word, uint4 value)
{
    _NativeLocalityCertificateWords[_NativeFootprintCertificateOffset +
        footprint * SIGMA_CERTIFICATE_WORD_COUNT + word] = value;
}

uint4 SigmaN4TileCertificateReduce(uint word, uint4 left, uint4 right)
{
    uint4 result = left | right;
    if (word == SIGMA_CERTIFICATE_IDENTITY)
        result = uint4(left.x | right.x, left.y, 1u, 0u);
    else if (word >= SIGMA_CERTIFICATE_AXIS0 &&
        word < SIGMA_CERTIFICATE_INFORMATION0)
        result = uint4(SigmaQ48Max(left.xy, right.xy),
            SigmaQ48Min(left.zw, right.zw));
    return result;
}

bool SigmaN4TileStructuralCertificateEqual(uint footprint, uint leader)
{
    bool equal = true;
    [unroll]
    for (uint index = 0u; index < 5u; ++index)
    {
        uint word = index == 0u ? SIGMA_CERTIFICATE_CONTEXT :
            (index == 1u ? SIGMA_CERTIFICATE_RELATION :
            (index == 2u ? SIGMA_CERTIFICATE_RECEIPTS0 :
            (index == 3u ? SIGMA_CERTIFICATE_RECEIPTS0 + 1u :
                SIGMA_CERTIFICATE_RECEIPTS0 + 3u)));
        equal = equal && all(SigmaN4TileCertificate(footprint,
            word) == SigmaN4TileCertificate(leader, word));
    }
    uint4 identity = SigmaN4TileCertificate(footprint,
        SIGMA_CERTIFICATE_IDENTITY);
    uint4 leaderIdentity = SigmaN4TileCertificate(leader,
        SIGMA_CERTIFICATE_IDENTITY);
    equal = equal && identity.y == leaderIdentity.y &&
        ((identity.x ^ leaderIdentity.x) &
            SIGMA_NATIVE_CERTIFICATE_FLAGS_COUPLED) == 0u;
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
        equal = equal && all(_NativeStates[_NativeFootprintStateOffset +
            footprint * 16u + lane] ==
            _NativeStates[_NativeFootprintStateOffset +
                leader * 16u + lane]);
    return equal;
}

void SigmaN4TileMeetSupports(uint tile, uint local)
{
    uint supportedCount = SigmaN4TileSupportedCount;
    bool active = local < supportedCount;
    uint2 sorted = active ? SigmaN4TileSort[local] :
        uint2(SIGMA_N4_TILE_INVALID, local);
    uint key = sorted.x;

    // Every fresh/unsupported footprint receives deterministic no-prior
    // execution routing without entering the support sort.
    uint originalFootprint = SigmaN4TileGlobalFootprint(tile, local);
    _NativeCloseScratch[SigmaN4TileFootprintAddress(originalFootprint, 1u)] =
        uint2(local, SIGMA_N4_TILE_INVALID);

    // Label is dead after ordering. Lane zero walks the compact supported
    // stream once and writes exact [start,end) plus member routing. This is
    // O(S) per tile and support key remains the sole grouping authority.
    SigmaN4TileLabel[local] = 0u;
    SigmaN4TileFlags[local] = 1u;
    if (local == 0u)
    {
        uint summaryCount = 0u;
        uint segmentStart = 0u;
        uint previousKey = SIGMA_N4_TILE_INVALID;
        [loop]
        for (uint scan = 0u; scan < supportedCount; ++scan)
        {
            uint scanKey = SigmaN4TileSort[scan].x;
            bool head = scan == 0u || scanKey != previousKey;
            if (head)
            {
                if (scan != 0u)
                    SigmaN4TileLabel[summaryCount - 1u].y = scan;
                segmentStart = scan;
                SigmaN4TileLabel[summaryCount] = uint2(scan, supportedCount);
                ++summaryCount;
            }
            SigmaN4TileWideA[scan] = uint4(segmentStart,
                summaryCount - 1u, 0u, 0u);
            previousKey = scanKey;
        }
        SigmaN4TileSupportSummaryCount = summaryCount;
    }
    GroupMemoryBarrierWithGroupSync();

    uint2 routing = active ? SigmaN4TileWideA[local].xy :
        uint2(local, SIGMA_N4_TILE_INVALID);
    uint start = routing.x;
    uint summary = routing.y;
    uint leaderLocal = active ? SigmaN4TileSort[start].y : sorted.y;
    uint footprint = SigmaN4TileGlobalFootprint(tile, sorted.y);
    uint leaderFootprint = SigmaN4TileGlobalFootprint(tile, leaderLocal);
    if (active)
    {
        uint ignored;
        uint structural = SigmaN4TileStructuralCertificateEqual(footprint,
            leaderFootprint) ? 1u : 0u;
        InterlockedAnd(SigmaN4TileFlags[summary], structural, ignored);
    }
    uint footprintReceipt = SigmaN4TileFootprintAddress(footprint, 1u);
    _NativeCloseScratch[footprintReceipt] = uint2(leaderLocal, summary);
    GroupMemoryBarrierWithGroupSync();

    // Six certificate words are independent. Distribute (summary,word) tasks
    // over all 256 lanes and scan only that locator's exact sorted segment.
    // No lane ever serially merges a complete certificate and no member cap is
    // introduced: the mathematical maximum remains all 256 tile footprints.
    uint summaryCount = SigmaN4TileSupportSummaryCount;
    uint taskCount = summaryCount * 6u;
    [loop]
    for (uint task = local; task < taskCount;
         task += SIGMA_N4_TILE_FOOTPRINT_CAPACITY)
    {
        uint taskSummary = task / 6u;
        uint mergeIndex = task - taskSummary * 6u;
        uint word = mergeIndex == 0u ? SIGMA_CERTIFICATE_IDENTITY :
            (mergeIndex < 5u ? SIGMA_CERTIFICATE_AXIS0 + mergeIndex - 1u :
                SIGMA_CERTIFICATE_RECEIPTS0 + 2u);
        uint2 bounds = SigmaN4TileLabel[taskSummary];
        uint firstLocal = SigmaN4TileSort[bounds.x].y;
        uint firstFootprint = SigmaN4TileGlobalFootprint(tile, firstLocal);
        uint4 value = SigmaN4TileCertificate(firstFootprint, word);
        [loop]
        for (uint member = bounds.x + 1u; member < bounds.y; ++member)
        {
            uint memberFootprint = SigmaN4TileGlobalFootprint(tile,
                SigmaN4TileSort[member].y);
            value = SigmaN4TileCertificateReduce(word, value,
                SigmaN4TileCertificate(memberFootprint, word));
        }
        SigmaN4TileStoreCertificate(firstFootprint, word, value);
    }
    GroupMemoryBarrierWithGroupSync();

    if (local < summaryCount)
    {
        uint2 bounds = SigmaN4TileLabel[local];
        uint first = bounds.x;
        uint end = bounds.y;
        uint summaryLocal = SigmaN4TileSort[first].y;
        uint summaryFootprint = SigmaN4TileGlobalFootprint(tile,
            summaryLocal);
        uint summaryKey = SigmaN4TileSort[first].x;
        uint valid = SigmaN4TileFlags[local];
        uint4 identity = SigmaN4TileCertificate(summaryFootprint,
            SIGMA_CERTIFICATE_IDENTITY);
        identity.x |= SIGMA_NATIVE_CERTIFICATE_FLAGS_MINIMIZED;
        identity.z = 1u;
        identity.w = 0u;
        SigmaN4TileStoreCertificate(summaryFootprint,
            SIGMA_CERTIFICATE_IDENTITY, identity);
        SigmaN4TileStoreCertificate(summaryFootprint,
            SIGMA_CERTIFICATE_INDEPENDENCE, 0u);
        [unroll]
        for (uint axis = 0u; axis < 4u; ++axis)
        {
            uint4 interval = SigmaN4TileCertificate(summaryFootprint,
                SIGMA_CERTIFICATE_AXIS0 + axis);
            valid &= !SigmaI64Less(interval.zw, interval.xy) ? 1u : 0u;
            uint widthValid = valid;
            uint2 width = SigmaQ48SubChecked(interval.zw, interval.xy,
                widthValid);
            valid &= widthValid;
            SigmaN4TileStoreCertificate(summaryFootprint,
                SIGMA_CERTIFICATE_INFORMATION0 + axis,
                valid != 0u ? uint4(width, axis, 3u) : 0u);
        }
        uint count = end - first;
        _NativeCloseScratch[SigmaN4TileSupportAddress(tile, local, 0u)] =
            uint2(summaryKey, summaryFootprint);
        _NativeCloseScratch[SigmaN4TileSupportAddress(tile, local, 1u)] =
            uint2(count, valid);
        if (summaryKey < _NativeSupportLocatorCapacity)
        {
            uint markerAddress = _NativeActiveSupportMarkerScratchOffset +
                summaryKey;
            uint previous = _NativeCloseScratch[markerAddress].x;
            if (previous != _NativeRevision)
            {
                uint observed;
                InterlockedCompareExchange(
                    _NativeCloseScratch[markerAddress].x, previous,
                    _NativeRevision, observed);
                if (observed == previous)
                {
                    uint activeIndex;
                    InterlockedAdd(_NativeCounters[3u].w, 1u, activeIndex);
                    if (activeIndex < _NativeFootprintCount)
                    {
                        uint activeAddress =
                            _NativeActiveSupportListScratchOffset +
                            activeIndex * 2u;
                        _NativeCloseScratch[activeAddress] =
                            uint2(summaryKey, summaryFootprint);
                        _NativeCloseScratch[activeAddress + 1u] =
                            uint2(0u, 0u);
                        uint ignored;
                        InterlockedAdd(_NativeCounters[3u].x, 1u, ignored);
                    }
                }
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
}

uint4 SigmaN4TilePackChart(int2 position, uint frame, bool assigned)
{
    return uint4(asuint(position.x), asuint(position.y),
        (frame & 7u) | (assigned ? 8u : 0u), 0u);
}

bool SigmaN4TileChartAssigned(uint4 value) { return (value.z & 8u) != 0u; }

#define SIGMA_N4_TILE_CHART_COORD_MIN (-4096)
#define SIGMA_N4_TILE_CHART_COORD_MAX 4095

int SigmaN4TileUnpackChartCoordinate(uint value)
{
    return asint((value & SIGMA_N4_TILE_CHART_COORD_MASK) <<
        (32u - SIGMA_N4_TILE_CHART_COORD_BITS)) >>
        (32u - SIGMA_N4_TILE_CHART_COORD_BITS);
}

uint SigmaN4TilePackChartTransform(int2 position, uint frame,
    inout uint valid)
{
    valid &= frame < 8u &&
        all(position >= int2(SIGMA_N4_TILE_CHART_COORD_MIN,
            SIGMA_N4_TILE_CHART_COORD_MIN)) &&
        all(position <= int2(SIGMA_N4_TILE_CHART_COORD_MAX,
            SIGMA_N4_TILE_CHART_COORD_MAX)) ? 1u : 0u;
    return valid == 0u ? 0u :
        (asuint(position.x) & SIGMA_N4_TILE_CHART_COORD_MASK) |
        ((asuint(position.y) & SIGMA_N4_TILE_CHART_COORD_MASK) <<
            SIGMA_N4_TILE_CHART_COORD_BITS) |
        ((frame & 7u) << SIGMA_N4_TILE_CHART_FRAME_SHIFT) |
        SIGMA_N4_TILE_CHART_ASSIGNED;
}

bool SigmaN4TileChartTransformAssigned(uint value)
{
    return (value & SIGMA_N4_TILE_CHART_ASSIGNED) != 0u;
}

int2 SigmaN4TileChartTransformPosition(uint value)
{
    return int2(SigmaN4TileUnpackChartCoordinate(value),
        SigmaN4TileUnpackChartCoordinate(
            value >> SIGMA_N4_TILE_CHART_COORD_BITS));
}

uint SigmaN4TileChartTransformFrame(uint value)
{
    return (value >> SIGMA_N4_TILE_CHART_FRAME_SHIFT) & 7u;
}

int2 SigmaN4TileApplyChartFrame(uint frame, int2 position,
    inout uint valid)
{
    valid &= frame < 8u ? 1u : 0u;
    int4 transform = SIGMA_STITCH_CHART_D4[min(frame, 7u)];
    return int2(transform.x * position.x + transform.y * position.y,
        transform.z * position.x + transform.w * position.y);
}

uint SigmaN4TileComposeChartTransform(uint left, uint right)
{
    uint valid = SigmaN4TileChartTransformAssigned(left) &&
        SigmaN4TileChartTransformAssigned(right) ? 1u : 0u;
    uint leftFrame = SigmaN4TileChartTransformFrame(left);
    int2 position = SigmaN4TileChartTransformPosition(left) +
        SigmaN4TileApplyChartFrame(leftFrame,
            SigmaN4TileChartTransformPosition(right), valid);
    uint frame = SigmaMerkabaComposeChartD4(leftFrame,
        SigmaN4TileChartTransformFrame(right), valid);
    return SigmaN4TilePackChartTransform(position, frame, valid);
}

uint SigmaN4TileInverseChartTransform(uint value)
{
    uint valid = SigmaN4TileChartTransformAssigned(value) ? 1u : 0u;
    uint inverseFrame = SigmaMerkabaInverseChartD4(
        SigmaN4TileChartTransformFrame(value), valid);
    int2 position = -SigmaN4TileApplyChartFrame(inverseFrame,
        SigmaN4TileChartTransformPosition(value), valid);
    return SigmaN4TilePackChartTransform(position, inverseFrame, valid);
}

uint SigmaN4TileIdentityChartTransform()
{
    uint valid = 1u;
    return SigmaN4TilePackChartTransform(int2(0, 0), 0u, valid);
}

uint SigmaN4TileOrbitTransform(uint4 transforms, uint orbit)
{
    return orbit == 0u ? transforms.x :
        (orbit == 1u ? transforms.y : transforms.z);
}

uint4 SigmaN4TileSetOrbitTransform(uint4 transforms, uint orbit,
    uint value)
{
    if (orbit == 0u) transforms.x = value;
    else if (orbit == 1u) transforms.y = value;
    else transforms.z = value;
    return transforms;
}

uint4 SigmaN4TileComposeChartTransforms(uint4 left, uint4 right)
{
    return uint4(
        SigmaN4TileComposeChartTransform(left.x, right.x),
        SigmaN4TileComposeChartTransform(left.y, right.y),
        SigmaN4TileComposeChartTransform(left.z, right.z), 0u);
}

uint SigmaN4TileRelativeChartTransform(uint tile, uint sourceLocal,
    uint targetLocal, uint orbit)
{
    uint result = 0u;
    uint source = SigmaN4TileGlobalFootprint(tile, sourceLocal);
    uint target = SigmaN4TileGlobalFootprint(tile, targetLocal);
    uint sourceSupport = SigmaN4TileSupportKey(source);
    uint targetSupport = SigmaN4TileSupportKey(target);
    if (sourceSupport != SIGMA_N4_TILE_INVALID &&
        sourceSupport == targetSupport)
        result = SigmaN4TileIdentityChartTransform();
    else
    {
        uint boundary = SigmaN4TileBoundaryIndex(source, target);
        uint address = _NativeBoundaryScratchOffset +
            boundary * SIGMA_N4_BOUNDARY_RECEIPT_WORDS;
        uint4 header = uint4(_NativeCloseScratch[address],
            _NativeCloseScratch[address + 1u]);
        uint valid = header.x == SIGMA_STITCH_RESOLVED ? 1u : 0u;
        bool sourceFirst = source < target;
        uint sourceSector = sourceFirst ? header.y : header.z;
        uint targetSector = sourceFirst ? header.z : header.y;
        uint signBits = _NativeCloseScratch[address + 5u].x;
        int parity = ((signBits & 1u) == ((signBits >> 1u) & 1u))
            ? 1 : -1;
        uint assignment = SigmaMerkabaChartOrbitRepresentative(orbit, valid);
        int2 direction = SigmaN4ChartDirection(assignment, 0u,
            sourceSector, valid);
        uint targetFrame = SigmaMerkabaResolveAdjacentOrbitFrame(orbit, 0u,
            sourceSector, targetSector, parity, valid);
        result = SigmaN4TilePackChartTransform(direction, targetFrame, valid);
    }
    return result;
}

uint4 SigmaN4TileHookTransform(uint tile, uint highLocal, uint lowLocal,
    uint4 highState, uint4 lowState)
{
    uint4 result = 0u;
    [loop]
    for (uint orbit = 0u; orbit < SIGMA_N4_TILE_ORBIT_COUNT; ++orbit)
    {
        uint edge = SigmaN4TileRelativeChartTransform(tile, highLocal,
            lowLocal, orbit);
        uint lowToHigh = SigmaN4TileComposeChartTransform(
            SigmaN4TileOrbitTransform(lowState, orbit),
            SigmaN4TileComposeChartTransform(
                SigmaN4TileInverseChartTransform(edge),
                SigmaN4TileInverseChartTransform(
                    SigmaN4TileOrbitTransform(highState, orbit))));
        result = SigmaN4TileSetOrbitTransform(result, orbit, lowToHigh);
    }
    return result;
}

void SigmaN4TileOfferForestEdge(uint local, uint neighbour)
{
    uint localRoot = SigmaN4TileFlags[local];
    uint neighbourRoot = SigmaN4TileFlags[neighbour];
    if (localRoot == SIGMA_N4_TILE_INVALID ||
        neighbourRoot == SIGMA_N4_TILE_INVALID ||
        localRoot == neighbourRoot)
        return;
    uint highRoot = max(localRoot, neighbourRoot);
    uint lowRoot = min(localRoot, neighbourRoot);
    uint highLocal = localRoot == highRoot ? local : neighbour;
    uint lowLocal = localRoot == highRoot ? neighbour : local;
    uint candidate = (lowRoot << 16u) | (highLocal << 8u) | lowLocal;
    uint ignored;
    InterlockedMin(SigmaN4TileSort[highRoot].x, candidate, ignored);
}

bool SigmaN4TilePackedChartEqual(uint left, uint right)
{
    return left == right && SigmaN4TileChartTransformAssigned(left);
}

uint SigmaN4TileChartOverlapHash(uint root, int2 position)
{
    // Probe placement is execution-only. Full root/coordinate equality below
    // is the sole duplicate predicate and no hash/probe value is serialized.
    uint hash = root * 0x9e3779b9u;
    hash ^= asuint(position.x) * 0x85ebca6bu;
    hash ^= asuint(position.y) * 0xc2b2ae35u;
    hash ^= hash >> 16u;
    return hash & 255u;
}

void SigmaN4TileRejectDistinctChartOverlaps(uint tile)
{
    [loop]
    for (uint orbit = 0u; orbit < SIGMA_N4_TILE_ORBIT_COUNT; ++orbit)
    {
        uint generation = orbit + 1u;
        [loop]
        for (uint member = 0u; member < SIGMA_N4_TILE_FOOTPRINT_CAPACITY;
             ++member)
        {
            uint footprint = SigmaN4TileGlobalFootprint(tile, member);
            uint root = SigmaN4TileFlags[member];
            uint solved = SigmaN4TileOrbitTransform(
                SigmaN4TileWideA[member], orbit);
            if (root == SIGMA_N4_TILE_INVALID ||
                !SigmaN4TileChartTransformAssigned(solved))
                continue;
            int2 position = SigmaN4TileChartTransformPosition(solved);
            uint support = SigmaN4TileSupportKey(footprint);
            uint start = SigmaN4TileChartOverlapHash(root, position);
            [loop]
            for (uint probe = 0u; probe < SIGMA_N4_TILE_FOOTPRINT_CAPACITY;
                 ++probe)
            {
                uint slot = (start + probe) & 255u;
                if (SigmaN4TileSort[slot].y != generation)
                {
                    SigmaN4TileWideB[slot] = uint4(root, asuint(position.x),
                        asuint(position.y), support);
                    SigmaN4TileSort[slot].y = generation;
                    break;
                }
                uint4 existing = SigmaN4TileWideB[slot];
                bool equalKey = existing.x == root &&
                    existing.y == asuint(position.x) &&
                    existing.z == asuint(position.y);
                if (!equalKey)
                    continue;
                bool samePublishedLocality = support != SIGMA_N4_TILE_INVALID &&
                    existing.w == support;
                if (!samePublishedLocality)
                    SigmaN4TileComponentOrbits[root] &= ~(1u << orbit);
                break;
            }
        }
    }
}

void SigmaN4TileBuildWeightedComponents(uint tile, uint local)
{
    uint footprint = SigmaN4TileGlobalFootprint(tile, local);
    bool valid = SigmaN4TileFootprintValid(footprint);
    uint supportKey = valid ? SigmaN4TileSupportKey(footprint) :
        SIGMA_N4_TILE_INVALID;
    uint supportLeader = _NativeCloseScratch[
        SigmaN4TileFootprintAddress(footprint, 1u)].x;
    uint identity = SigmaN4TileIdentityChartTransform();
    SigmaN4TileFlags[local] = !valid ? SIGMA_N4_TILE_INVALID :
        (supportKey != SIGMA_N4_TILE_INVALID ? supportLeader : local);
    SigmaN4TileWideA[local] = valid
        ? uint4(identity, identity, identity, 0u) : 0u;
    GroupMemoryBarrierWithGroupSync();

    // One deterministic weighted transient forest solves connectivity and all
    // three chart-orbit potentials together.  Candidate roots are execution
    // tie-breaks only; every selected forest edge is an actual prior alias or
    // resolved native boundary.  Each of the eight fixed rounds performs one
    // hook and one pointer-doubling step; it must not nest another eight-round
    // shortcut interpreter inside every hook round.
    [loop]
    for (uint round = 0u; round < SIGMA_N4_TILE_FOREST_ROUNDS; ++round)
    {
        SigmaN4TileSort[local].x = SIGMA_N4_TILE_INVALID;
        // Hook transforms must read the pre-hook root potentials.  A lower
        // root may itself hook during this round, so reading WideA directly
        // from another root would race its parent-transform publication.
        SigmaN4TileWideB[local] = SigmaN4TileWideA[local];
        GroupMemoryBarrierWithGroupSync();
        if (valid)
        {
            [loop]
            for (uint direction = 1u; direction < 4u; direction += 2u)
            {
                uint neighbourLocal;
                uint neighbourFootprint;
                bool inside = SigmaN4TileNeighbour(tile, local, direction,
                    neighbourLocal, neighbourFootprint);
                if (inside && SigmaN4TileFootprintValid(neighbourFootprint) &&
                    SigmaN4TileResolvedEdge(footprint, neighbourFootprint))
                    SigmaN4TileOfferForestEdge(local, neighbourLocal);
            }
        }
        GroupMemoryBarrierWithGroupSync();
        uint candidate = SigmaN4TileSort[local].x;
        if (valid && SigmaN4TileFlags[local] == local &&
            candidate != SIGMA_N4_TILE_INVALID)
        {
            uint lowRoot = candidate >> 16u;
            uint highLocal = (candidate >> 8u) & 0xffu;
            uint lowLocal = candidate & 0xffu;
            SigmaN4TileFlags[local] = lowRoot;
            SigmaN4TileWideA[local] = SigmaN4TileHookTransform(tile,
                highLocal, lowLocal, SigmaN4TileWideB[highLocal],
                SigmaN4TileWideB[lowLocal]);
        }
        GroupMemoryBarrierWithGroupSync();

        uint parent = SigmaN4TileFlags[local];
        uint safeParent = parent < SIGMA_N4_TILE_FOOTPRINT_CAPACITY
            ? parent : local;
        if (parent == SIGMA_N4_TILE_INVALID)
        {
            SigmaN4TileLabel[local].x = SIGMA_N4_TILE_INVALID;
            SigmaN4TileWideB[local] = 0u;
        }
        else
        {
            SigmaN4TileLabel[local].x = SigmaN4TileFlags[safeParent];
            SigmaN4TileWideB[local] = SigmaN4TileComposeChartTransforms(
                SigmaN4TileWideA[safeParent], SigmaN4TileWideA[local]);
        }
        GroupMemoryBarrierWithGroupSync();
        SigmaN4TileFlags[local] = SigmaN4TileLabel[local].x;
        SigmaN4TileWideA[local] = SigmaN4TileWideB[local];
        GroupMemoryBarrierWithGroupSync();
    }

    uint root = valid ? SigmaN4TileFlags[local] : SIGMA_N4_TILE_INVALID;
    uint safeRoot = valid && root < SIGMA_N4_TILE_FOOTPRINT_CAPACITY
        ? root : local;
    SigmaN4TileLabel[local] = uint2(root, supportLeader);
    _NativeCloseScratch[SigmaN4TileFootprintAddress(footprint, 0u)] =
        uint2(root, valid ? 1u : 0u);
    SigmaN4TileComponentOrbits[local] = valid && root == local
        ? 0xffffff07u : 0u;
    GroupMemoryBarrierWithGroupSync();

    if (valid)
    {
        [loop]
        for (uint orbit = 0u; orbit < SIGMA_N4_TILE_ORBIT_COUNT; ++orbit)
        {
            uint solved = SigmaN4TileOrbitTransform(
                SigmaN4TileWideA[local], orbit);
            bool exact = SigmaN4TileChartTransformAssigned(solved);
            [loop]
            for (uint direction = 0u; direction < 4u; ++direction)
            {
                uint neighbourLocal;
                uint neighbourFootprint;
                bool inside = SigmaN4TileNeighbour(tile, local, direction,
                    neighbourLocal, neighbourFootprint);
                if (!inside || !SigmaN4TileFootprintValid(neighbourFootprint))
                    continue;
                uint support = SigmaN4TileSupportKey(footprint);
                uint neighbourSupport = SigmaN4TileSupportKey(
                    neighbourFootprint);
                bool priorAlias = support != SIGMA_N4_TILE_INVALID &&
                    support == neighbourSupport;
                bool resolvedEdge = SigmaN4TileResolvedEdge(footprint,
                    neighbourFootprint);
                if (priorAlias || resolvedEdge)
                {
                    bool sameComponent = SigmaN4TileFlags[neighbourLocal] ==
                        root;
                    uint expected = SigmaN4TileComposeChartTransform(solved,
                        SigmaN4TileRelativeChartTransform(tile, local,
                            neighbourLocal, orbit));
                    uint actual = SigmaN4TileOrbitTransform(
                        SigmaN4TileWideA[neighbourLocal], orbit);
                    exact = exact && sameComponent &&
                        SigmaN4TilePackedChartEqual(expected, actual);
                }
            }
            if (!exact)
            {
                uint ignored;
                InterlockedAnd(SigmaN4TileComponentOrbits[safeRoot],
                    ~(1u << orbit), ignored);
            }
            int2 position = SigmaN4TileChartTransformPosition(solved);
            uint4 full = SigmaN4TilePackChart(position,
                SigmaN4TileChartTransformFrame(solved),
                SigmaN4TileChartTransformAssigned(solved));
            uint output = SigmaN4TileFootprintAddress(footprint,
                2u + orbit * 2u);
            _NativeCloseScratch[output] = full.xy;
            _NativeCloseScratch[output + 1u] = full.zw;
        }
    }
    GroupMemoryBarrierWithGroupSync();
    // Edge consistency is complete. Reuse dead sort/wide scratch as one exact
    // bounded open-address table. Tags avoid clearing between the three
    // orbits; probe order and placement remain execution-only.
    SigmaN4TileSort[local].y = 0u;
    GroupMemoryBarrierWithGroupSync();
    if (local == 0u)
        SigmaN4TileRejectDistinctChartOverlaps(tile);
    GroupMemoryBarrierWithGroupSync();
    uint2 supportReceipt = _NativeCloseScratch[
        SigmaN4TileFootprintAddress(footprint, 1u)];
    supportReceipt.y = valid ? SigmaN4TileComponentOrbits[safeRoot] : 0u;
    _NativeCloseScratch[SigmaN4TileFootprintAddress(footprint, 1u)] =
        supportReceipt;
    // Unity's Vulkan lowering has exhibited pathological combined-device/group
    // sync for this large exact kernel.  Flush each lane's UAV writes first,
    // then reconverge the fixed workgroup explicitly; the resulting happens-
    // before relation is identical and every lane executes both operations.
    DeviceMemoryBarrier();
    GroupMemoryBarrierWithGroupSync();
}

uint SigmaN4TileD4EquivalenceMask(uint4 left, uint4 right)
{
    if (!SigmaN4TileChartAssigned(left) ||
        !SigmaN4TileChartAssigned(right))
        return 0u;
    int x = asint(left.x);
    int y = asint(left.y);
    int u = asint(right.x);
    int v = asint(right.y);
    // This predicate is accumulated for the same footprint over every actual
    // member of the component.  Only those realized cells (and the resolved
    // edge receipts that produced them) occur in the accepted canonical stream.
    // Comparing all four latent sector directions would distinguish unused
    // chart assignments that serialize to the same physical component image.
    uint mask = 0u;
    mask |= x == u && y == v ? 1u << 0u : 0u;
    mask |= -y - 1 == u && x == v ? 1u << 1u : 0u;
    mask |= -x - 1 == u && -y - 1 == v ? 1u << 2u : 0u;
    mask |= y == u && -x - 1 == v ? 1u << 3u : 0u;
    mask |= -x - 1 == u && y == v ? 1u << 4u : 0u;
    mask |= x == u && -y - 1 == v ? 1u << 5u : 0u;
    mask |= y == u && x == v ? 1u << 6u : 0u;
    mask |= -y - 1 == u && -x - 1 == v ? 1u << 7u : 0u;
    return mask;
}

void SigmaN4TileFinalizeComponents(uint tile, uint local)
{
    uint footprint = SigmaN4TileGlobalFootprint(tile, local);
    bool valid = SigmaN4TileFootprintValid(footprint);
    uint root = valid ? _NativeCloseScratch[
        SigmaN4TileFootprintAddress(footprint, 0u)].x : SIGMA_N4_TILE_INVALID;
    // Inactive lanes carry the explicit invalid sentinel.  HLSL may evaluate
    // indexed operands before a later boolean predicate, so keep every
    // groupshared access in range without changing the payload predicate.
    uint safeRoot = valid && root < SIGMA_N4_TILE_FOOTPRINT_CAPACITY
        ? root : local;
    SigmaN4TileComponentOrbits[local] = valid && root == local
        ? _NativeCloseScratch[SigmaN4TileFootprintAddress(footprint, 1u)].y
        : 0u;
    GroupMemoryBarrierWithGroupSync();
    if (valid)
    {
        [loop]
        for (uint pair = 0u; pair < 3u; ++pair)
        {
            uint leftOrbit = pair == 2u ? 1u : 0u;
            uint rightOrbit = pair == 0u ? 1u : 2u;
            uint leftAddress = SigmaN4TileFootprintAddress(footprint,
                2u + leftOrbit * 2u);
            uint rightAddress = SigmaN4TileFootprintAddress(footprint,
                2u + rightOrbit * 2u);
            uint4 leftState = uint4(_NativeCloseScratch[leftAddress],
                _NativeCloseScratch[leftAddress + 1u]);
            uint4 rightState = uint4(_NativeCloseScratch[rightAddress],
                _NativeCloseScratch[rightAddress + 1u]);
            uint mask = SigmaN4TileD4EquivalenceMask(leftState, rightState);
            uint offset = (pair + 1u) * 8u;
            uint preserve = ~(0xffu << offset) | (mask << offset);
            uint ignored;
            InterlockedAnd(SigmaN4TileComponentOrbits[safeRoot], preserve,
                ignored);
        }
    }
    GroupMemoryBarrierWithGroupSync();
    SigmaN4TileWideA[local] = uint4(0u, SIGMA_N4_TILE_INVALID, 0u, 0u);
    GroupMemoryBarrierWithGroupSync();
    if (valid)
    {
        uint ignored;
        InterlockedAdd(SigmaN4TileWideA[safeRoot].x, 1u, ignored);
        uint support = SigmaN4TileSupportKey(footprint);
        if (support != SIGMA_N4_TILE_INVALID)
        {
            InterlockedMin(SigmaN4TileWideA[safeRoot].y, support, ignored);
            InterlockedMax(SigmaN4TileWideA[safeRoot].z, support + 1u,
                ignored);
        }
        else
            InterlockedOr(SigmaN4TileWideA[safeRoot].w, 2u, ignored);
        uint x = local & 15u;
        uint y = local >> 4u;
        if (x == 0u || x == 15u || y == 0u || y == 15u)
            InterlockedOr(SigmaN4TileWideA[safeRoot].w, 1u, ignored);
    }
    GroupMemoryBarrierWithGroupSync();
    bool isRoot = valid && root == local;
    uint orbitReceipt = isRoot ? SigmaN4TileComponentOrbits[safeRoot] : 0u;
    uint feasible = orbitReceipt & 7u;
    uint feasibleCount = countbits(feasible);
    bool eq01 = ((orbitReceipt >> 8u) & 0xffu) != 0u;
    bool eq02 = ((orbitReceipt >> 16u) & 0xffu) != 0u;
    bool eq12 = ((orbitReceipt >> 24u) & 0xffu) != 0u;
    bool priorAliasOnly = SigmaN4TileWideA[safeRoot].y !=
            SIGMA_N4_TILE_INVALID &&
        SigmaN4TileWideA[safeRoot].z ==
            SigmaN4TileWideA[safeRoot].y + 1u &&
        (SigmaN4TileWideA[safeRoot].w & 2u) == 0u;
    bool oneClass = priorAliasOnly || feasibleCount == 1u ||
        (feasibleCount == 2u &&
            (((feasible & 3u) == 3u && eq01) ||
             ((feasible & 5u) == 5u && eq02) ||
             ((feasible & 6u) == 6u && eq12))) ||
        (feasibleCount == 3u &&
            ((eq01 && eq02) || (eq01 && eq12) || (eq02 && eq12)));
    bool border = isRoot && (SigmaN4TileWideA[safeRoot].w & 1u) != 0u;
    SigmaN4TileSort[local] = uint2(isRoot && border ? 1u : 0u,
        isRoot && !border ? 1u : 0u);
    GroupMemoryBarrierWithGroupSync();
    [loop]
    for (uint compactionStride = 1u; compactionStride < 256u;
         compactionStride <<= 1u)
    {
        uint2 value = SigmaN4TileSort[local];
        uint previous = local >= compactionStride
            ? local - compactionStride : local;
        if (local >= compactionStride)
            value += SigmaN4TileSort[previous];
        SigmaN4TileLabel[local] = value;
        GroupMemoryBarrierWithGroupSync();
        SigmaN4TileSort[local] = SigmaN4TileLabel[local];
        GroupMemoryBarrierWithGroupSync();
    }
    if (local == 0u)
    {
        SigmaN4TileBorderComponentCount = SigmaN4TileSort[255u].x;
        SigmaN4TileComponentCount = SigmaN4TileSort[255u].x +
            SigmaN4TileSort[255u].y;
        SigmaN4TileUnresolvedComponentCount = 0u;
    }
    GroupMemoryBarrierWithGroupSync();
    // Root selection is irregular, but global UAV publication is performed by
    // the fixed 256 summary lanes below.  WideB is dead after weighted close;
    // reuse it as the transient two-word component receipt so no divergent root
    // lane performs a dynamic UAV write before group synchronization.
    SigmaN4TileWideB[local] = 0u;
    GroupMemoryBarrierWithGroupSync();
    if (isRoot)
    {
        uint rank = border ? SigmaN4TileSort[local].x :
            SigmaN4TileSort[local].y;
        bool rankValid = rank != 0u;
        uint slot = !rankValid ? 0u :
            (border ? rank - 1u :
                SigmaN4TileBorderComponentCount + rank - 1u);
        bool slotValid = rankValid &&
            slot < SIGMA_N4_TILE_FOOTPRINT_CAPACITY;
        uint anchor = SigmaN4TileWideA[safeRoot].y !=
                SIGMA_N4_TILE_INVALID &&
            SigmaN4TileWideA[safeRoot].z ==
                SigmaN4TileWideA[safeRoot].y + 1u
            ? SigmaN4TileWideA[safeRoot].y : SIGMA_N4_TILE_INVALID;
        if (slotValid)
        {
            SigmaN4TileWideB[slot] = uint4(footprint, orbitReceipt, anchor,
                SigmaN4TileWideA[safeRoot].x |
                    (priorAliasOnly ? 1u << 16u : 0u) |
                    (oneClass ? 1u << 17u : 0u));
            SigmaN4TileFlags[safeRoot] = slot;
            if (!oneClass)
            {
                uint ignored;
                InterlockedAdd(SigmaN4TileUnresolvedComponentCount,
                    border ? 1u : (1u << 16u), ignored);
            }
        }
        else
            SigmaN4TileFlags[safeRoot] = SIGMA_N4_TILE_INVALID;
    }
    GroupMemoryBarrierWithGroupSync();
    uint4 componentReceipt = SigmaN4TileWideB[local];
    _NativeCloseScratch[SigmaN4TileComponentAddress(tile, local, 0u)] =
        componentReceipt.xy;
    _NativeCloseScratch[SigmaN4TileComponentAddress(tile, local, 1u)] =
        componentReceipt.zw;
    DeviceMemoryBarrier();
    GroupMemoryBarrierWithGroupSync();
    if (valid)
    {
        uint slot = SigmaN4TileFlags[safeRoot];
        if (slot < SIGMA_N4_TILE_FOOTPRINT_CAPACITY)
        {
            uint flags = _NativeCloseScratch[
                SigmaN4TileComponentAddress(tile, slot, 0u)].y;
            _NativeCloseScratch[SigmaN4TileFootprintAddress(footprint, 0u)] =
                uint2(slot, flags);
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (local == 0u)
    {
        uint address = _NativeTileHeaderScratchOffset +
            tile * SIGMA_N4_TILE_HEADER_WORDS;
        _NativeCloseScratch[address] = uint2(
            SigmaN4TileSupportSummaryCount, SigmaN4TileComponentCount);
        _NativeCloseScratch[address + 1u] = uint2(
            SigmaN4TileBorderComponentCount,
            SigmaN4TileUnresolvedComponentCount);
    }
}

void SigmaN4TileCompactCanonicalInput(uint tile, uint local)
{
    uint footprint = SigmaN4TileGlobalFootprint(tile, local);
    bool active = footprint < _NativeFootprintCount &&
        SigmaN4TileFootprintValid(footprint);
    if (active)
    {
        uint slot = _NativeCloseScratch[
            SigmaN4TileFootprintAddress(footprint, 0u)].x;
        active = slot < SigmaN4TileComponentCount;
    }
    SigmaNativeFreshScratch[local] = active ? 1u : 0u;
    GroupMemoryBarrierWithGroupSync();
    [loop]
    for (uint stride = 1u; stride < 256u; stride <<= 1u)
    {
        uint value = SigmaNativeFreshScratch[local];
        if (local >= stride)
            value += SigmaNativeFreshScratch[local - stride];
        SigmaN4TileWideA[local].x = value;
        GroupMemoryBarrierWithGroupSync();
        SigmaNativeFreshScratch[local] = SigmaN4TileWideA[local].x;
        GroupMemoryBarrierWithGroupSync();
    }
    uint fixedAddress = SigmaN4TileCanonicalImageAddress(
        SIGMA_N4_COMPONENT_SCAN_IMAGE,
        tile * SIGMA_N4_TILE_FOOTPRINT_CAPACITY + local);
    _NativeCloseScratch[fixedAddress] = uint2(SIGMA_N4_TILE_INVALID, 0u);
    GroupMemoryBarrierWithGroupSync();
    if (active)
    {
        uint rank = SigmaNativeFreshScratch[local] - 1u;
        _NativeCloseScratch[SigmaN4TileCanonicalImageAddress(
            SIGMA_N4_COMPONENT_SCAN_IMAGE,
            tile * SIGMA_N4_TILE_FOOTPRINT_CAPACITY + rank)] =
                uint2(footprint, 0u);
    }
    if (local == 0u)
        _NativeCloseScratch[SigmaN4TileCanonicalImageAddress(
            SIGMA_N4_COMPONENT_LIST_IMAGE, tile)] =
                uint2(SigmaNativeFreshScratch[255u], 0u);
}

void SigmaN4TileClose(uint tile, uint local)
{
    SigmaN4TileSortSupports(tile, local);
    SigmaN4TileMeetSupports(tile, local);
    SigmaN4TileBuildWeightedComponents(tile, local);
    SigmaN4TileFinalizeComponents(tile, local);
    SigmaN4TileCompactCanonicalInput(tile, local);
}
#endif

#if !defined(SIGMA_N4_TILE_CLOSE_VARIANT)
void SigmaNativeFreshFinalize(uint threadIndex)
{
    uint branchCount = _NativeFreshBranchCount;
    bool bounded = branchCount > 0u &&
        branchCount <= SIGMA_NATIVE_FRESH_HOT_BRANCH_CAPACITY;
    uint branch = threadIndex >> 4u;
    uint lane = threadIndex & 15u;
    bool activeBranch = bounded && branch < branchCount;
    // HLSL does not promise short-circuit resource loads. Clamp inactive lanes
    // to branch zero so the fixed four-branch collective never probes beyond
    // the physically allocated buffers when branchCount is one to three.
    uint safeBranch = activeBranch ? branch : 0u;
    bool branchValid = activeBranch &&
        _NativeBranchHeaders[safeBranch].y != 0u &&
        _NativeReverseRelationResults[safeBranch].w != 0u &&
        _NativeReverseRelationResults[safeBranch].x ==
            SIGMA_MERKABA_RELATION_NO_RELATION;
    bool laneEqual = !activeBranch || all(
        _NativeStates[safeBranch * 16u + lane] == _NativeStates[lane]);
    SigmaNativeFreshScratch[threadIndex] =
        branchValid && laneEqual ? 0u : (activeBranch ? 1u : 0u);
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint stride = 8u; stride != 0u; stride >>= 1u)
    {
        if (lane < stride)
            SigmaNativeFreshScratch[branch * 16u + lane] |=
                SigmaNativeFreshScratch[branch * 16u + lane + stride];
        GroupMemoryBarrierWithGroupSync();
    }

    if (threadIndex == 0u)
    {
        uint mismatch = bounded ? 0u : 1u;
        uint staticExclusion = bounded ? 1u : 0u;
        [unroll]
        for (uint branchProbe = 0u;
            branchProbe < SIGMA_NATIVE_FRESH_HOT_BRANCH_CAPACITY; ++branchProbe)
            if (branchProbe < branchCount)
            {
                mismatch |= SigmaNativeFreshScratch[branchProbe * 16u];
                staticExclusion &= _NativeBranchHeaders[branchProbe].w != 0u
                    ? 1u : 0u;
            }
        SigmaNativeFreshPhaseValid = mismatch == 0u ? 1u : 0u;
        SigmaNativeFreshStaticExclusion = staticExclusion;
    }
    GroupMemoryBarrierWithGroupSync();

    uint admissionOffset = branchCount * 16u;
    if (threadIndex < 16u)
        _NativeStates[admissionOffset + threadIndex] =
            SigmaNativeFreshPhaseValid != 0u
            ? _NativeStates[threadIndex] : uint2(0u, 0u);
    if (threadIndex == 0u)
    {
        uint status = SigmaNativeFreshPhaseValid != 0u
            ? SIGMA_NATIVE_FRESH_ADMITTED : SIGMA_NATIVE_FRESH_UNRESOLVED;
        uint relation = SigmaNativeFreshPhaseValid != 0u
            ? SIGMA_MERKABA_RELATION_NO_RELATION
            : SIGMA_MERKABA_RELATION_UNRESOLVED;
        uint coldReason = branchCount > SIGMA_NATIVE_FRESH_HOT_BRANCH_CAPACITY
            ? SIGMA_NATIVE_FRESH_COLD_CONTINUATION :
            (SigmaNativeFreshStaticExclusion != 0u
                ? SIGMA_NATIVE_COLD_REASON_STATIC_EXCLUSION : 0u);
        _NativeBranchHeaders[branchCount] = uint4(status, relation,
            branchCount, coldReason);
        _NativeBranchSupports[branchCount] = uint2(0u, 0u);
    }
}
#endif

#if defined(SIGMA_N4_TILE_CLOSE_VARIANT)
[numthreads(256, 1, 1)]
#else
[numthreads(256, 1, 1)]
#endif
void ContractNativeQuery(uint3 id : SV_DispatchThreadID,
    uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
#if defined(SIGMA_N4_TILE_CLOSE_VARIANT)
    // The production graph dispatches exactly TileCapacity workgroups.  Decode
    // the execution-only tile from the linear dispatch id; this preserves the
    // exact grid without introducing any physical/canonical identity.
    SigmaN4TileClose(id.x / SIGMA_N4_TILE_FOOTPRINT_CAPACITY,
        groupThreadId.x);
#else
    uint linearGroup = groupId.x + groupId.y * _NativeLinearDispatchWidth;
    if (_NativeContractMode == SIGMA_NATIVE_CONTRACT_FRESH_LIFT)
    {
        uint team = groupThreadId.x >> 4u;
        uint teamLane = groupThreadId.x & 15u;
        if (_NativeFootprintCount == 0u)
        {
            bool active = team == 0u &&
                linearGroup < _NativeFreshBranchCount;
            SigmaNativeFreshLiftLegacyBranch(
                active ? linearGroup : 0u, team, teamLane, active);
        }
        else if (linearGroup == 0u)
            SigmaNativeFreshLiftLegacyBranch(0u, team, teamLane,
                team == 0u);
        else
        {
            uint footprint = (linearGroup - 1u) *
                SIGMA_NATIVE_FRESH_TEAM_COUNT + team;
            bool active = footprint < _NativeFootprintCount;
            SigmaNativeFreshLiftFootprint(active ? footprint : 0u,
                team, teamLane, active);
            GroupMemoryBarrierWithGroupSync();
            if (active && teamLane < 2u)
            {
                uint x = footprint % _NativeResolution.x;
                uint y = footprint / _NativeResolution.x;
                uint horizontal = (_NativeResolution.x - 1u) *
                    _NativeResolution.y;
                if (teamLane == 0u &&
                    x + 1u < _NativeResolution.x)
                    SigmaN4ContractBoundaryCandidate(
                        y * (_NativeResolution.x - 1u) + x,
                        footprint, footprint + 1u,
                        SIGMA_N4_SAMPLE_SIDE_RIGHT,
                        SIGMA_N4_SAMPLE_SIDE_LEFT);
                else if (teamLane == 1u &&
                    y + 1u < _NativeResolution.y)
                    SigmaN4ContractBoundaryCandidate(
                        horizontal + y * _NativeResolution.x + x,
                        footprint, footprint + _NativeResolution.x,
                        SIGMA_N4_SAMPLE_SIDE_DOWN,
                        SIGMA_N4_SAMPLE_SIDE_UP);
            }
        }
        return;
    }
    if (_NativeContractMode == SIGMA_NATIVE_CONTRACT_FRESH_UNION)
    {
        if (linearGroup == 0u)
            SigmaNativeFreshFinalize(groupThreadId.x);
        return;
    }
#endif
}
#endif
