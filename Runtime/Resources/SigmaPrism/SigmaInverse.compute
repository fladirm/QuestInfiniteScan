bool SigmaProjectWorldToPixel(float3 worldPosition, uint eye, out uint2 pixel,
    out float3 opticalPosition);

uint SigmaPackPixel16(uint2 pixel)
{
    return (pixel.x & 0xffffu) | ((pixel.y & 0xffffu) << 16u);
}

uint SigmaPackUnorm4x8Exact(float4 colour)
{
    uint4 quantized = (uint4)round(saturate(colour) * 255.0);
    return quantized.x | (quantized.y << 8u) | (quantized.z << 16u) |
        (quantized.w << 24u);
}

void SigmaCaptureRgbRaw(uint eye, float3 worldPosition,
    out uint4 first, out uint4 second)
{
    first = uint4(0xffffffffu, 0xffffffffu, 0u, 0u);
    second = 0u;
    float2 projected;
    if (!SigmaProjectWorldToRgb(SigmaPoseUnapplyWorld(worldPosition), eye,
            projected))
        return;
    int2 p00 = int2(floor(projected - 0.5));
    float4 c00 = SigmaRgbLoad(eye, p00);
    float4 c10 = SigmaRgbLoad(eye, p00 + int2(1, 0));
    float4 c01 = SigmaRgbLoad(eye, p00 + int2(0, 1));
    float4 c11 = SigmaRgbLoad(eye, p00 + int2(1, 1));
    if (!all(isfinite(c00)) || !all(isfinite(c10)) ||
        !all(isfinite(c01)) || !all(isfinite(c11)))
        return;
    first = uint4(asuint(projected.x), asuint(projected.y),
        SigmaPackUnorm4x8Exact(c00), SigmaPackUnorm4x8Exact(c10));
    second = uint4(SigmaPackUnorm4x8Exact(c01),
        SigmaPackUnorm4x8Exact(c11), 1u, eye);
}

uint4 SigmaCaptureDepthRaw(uint eye, float3 worldPosition,
    SigmaDepthCell3 cell)
{
    uint2 pixel;
    float3 optical;
    if (!SigmaProjectWorldToPixel(worldPosition, eye, pixel, optical) ||
        any(pixel >= _Resolution))
        return uint4(0xffffffffu, 0u, 0u, 0u);
    float2 metric = _MetricDepth[uint3(pixel, eye)];
    return uint4(SigmaPackPixel16(pixel), asuint(metric.x), asuint(metric.y),
        (cell.valid & 1u) | ((cell.sector & 3u) << 1u));
}

void SigmaWriteProofSample(uint workIndex, uint sample, uint status,
    uint constrainedMask,
    uint rgbUnobservableMask, bool scheduleRgb, float3 worldPosition,
    SigmaDepthCell3 depthLeft, SigmaDepthCell3 depthRight,
    SigmaAdmissibleCell16 rgbLeft, SigmaAdmissibleCell16 rgbRight)
{
    SigmaProofSampleGpu proof = (SigmaProofSampleGpu)0;
    proof.meta = uint4(status, constrainedMask,
        scheduleRgb ? 1u : 0u, rgbUnobservableMask);
    proof.depthLeft = depthLeft;
    proof.depthRight = depthRight;
    proof.rgbLeft = rgbLeft;
    proof.rgbRight = rgbRight;
    proof.raw[0] = SigmaCaptureDepthRaw(0u, worldPosition, depthLeft);
    proof.raw[1] = SigmaCaptureDepthRaw(1u, worldPosition, depthRight);
    if (scheduleRgb)
    {
        SigmaCaptureRgbRaw(0u, worldPosition, proof.raw[2], proof.raw[3]);
        SigmaCaptureRgbRaw(1u, worldPosition, proof.raw[4], proof.raw[5]);
    }
    _ProofSamples[workIndex * SIGMA_PAGE_SAMPLE_COUNT + sample] = proof;
}

bool SigmaPredictionHasContact(uint2 pixel, uint eye)
{
    return _PredDepthSupport[uint3(pixel, eye)].y > 0.0 &&
        _PredStateKey[uint3(pixel, eye)].x != 0u;
}

bool SigmaProjectWorldToPixel(float3 worldPosition, uint eye, out uint2 pixel,
    out float3 opticalPosition)
{
    float4x4 opticalFromWorld = eye == 0u
        ? _OpticalFromWorldLeft : _OpticalFromWorldRight;
    float4 intrinsics = eye == 0u ? _DepthIntrinsicsLeft : _DepthIntrinsicsRight;
    float3 rawWorldPosition = SigmaPoseUnapplyWorld(worldPosition);
    opticalPosition = mul(opticalFromWorld,
        float4(rawWorldPosition, 1.0)).xyz;
    if (!all(isfinite(opticalPosition)) || opticalPosition.z <= 1e-6)
    {
        pixel = 0u;
        return false;
    }
    float2 projected = opticalPosition.xy / opticalPosition.z * intrinsics.xy +
        intrinsics.zw;
    int2 candidate = int2(floor(projected));
    if (any(candidate < 0) || any(candidate >= (int2)_Resolution))
    {
        pixel = 0u;
        return false;
    }
    pixel = (uint2)candidate;
    return true;
}

float3 SigmaDepthWorldPointCandidate(uint eye, uint2 pixel, float range)
{
    float3 ray = eye == 0u
        ? _DepthRayCenterLeft[pixel].xyz
        : _DepthRayCenterRight[pixel].xyz;
    float4x4 worldFromOptical = eye == 0u
        ? _WorldFromOpticalLeft : _WorldFromOpticalRight;
    float3 rawWorld = mul(worldFromOptical,
        float4(ray * range, 1.0)).xyz;
    return SigmaPoseApplyWorld(rawWorld);
}

uint SigmaFirstHitSectorForPixel(uint eye, uint2 pixel,
    SigmaQ48Bounds measuredRange, uint2 measuredRangeCenter,
    uint2 measuredHalfWidth, inout uint valid)
{
    float2 prediction = _PredDepthSupport[uint3(pixel, eye)];
    SigmaQ48Bounds rebuiltMeasured;
    SigmaQ48Bounds predicted;
    uint sector = SigmaClassifyFirstHitExact(measuredRangeCenter,
        measuredHalfWidth, prediction, rebuiltMeasured, predicted, valid);
    if (valid == 0u || !SigmaU64Equal(rebuiltMeasured.lo, measuredRange.lo) ||
        !SigmaU64Equal(rebuiltMeasured.hi, measuredRange.hi))
        return SIGMA_SECTOR_NO_CONSTRAINT;
    return sector;
}

bool SigmaPredictionMatchesSample(uint eye, uint2 pixel,
    SigmaCarrierPageMetaGpu metadata, uint pageSlot, uint sample)
{
    uint3 address = uint3(pixel, eye);
    uint4 key = _PredStateKey[address];
    uint4 page = _PredCarrierPage[address];
    if (key.x != metadata.generation || key.z != _SegmentIndex ||
        key.w != pageSlot || page.x != metadata.pageXLo ||
        page.y != metadata.pageXHi || page.z != metadata.pageYLo ||
        page.w != metadata.pageYHi)
        return false;
    float2 uv = _PredCarrierUvNormal[address].xy;
    float2 local = float2(sample & 63u, sample >> 6u);
    return all(abs(uv - local) <= 1.75);
}

bool SigmaBuildMatchedEyeCell(uint eye, float3 worldPosition,
    SigmaCarrierPageMetaGpu metadata, uint pageSlot, uint sample,
    out SigmaDepthCell3 cell)
{
    cell = (SigmaDepthCell3)0;
    uint2 pixel;
    float3 optical;
    if (!SigmaProjectWorldToPixel(worldPosition, eye, pixel, optical) ||
        !SigmaPredictionMatchesSample(eye, pixel, metadata, pageSlot, sample) ||
        (_DepthFlags[uint3(pixel, eye)] & 1u) == 0u)
        return false;

    float2 metric = _MetricDepth[uint3(pixel, eye)];
    SigmaQ48Bounds measuredRange;
    uint source = eye == 0u ? SIGMA_SOURCE_DEPTH_LEFT :
        SIGMA_SOURCE_DEPTH_RIGHT;
    uint key = eye == 0u ? _LeftIndependenceKey : _RightIndependenceKey;
    if (!SigmaBuildDepthWorldCell(eye, pixel, metric, source, key, cell,
            measuredRange))
        return false;
    uint valid = 1u;
    uint2 range = SigmaQ48FromFloatNearestEven(metric.x, valid);
    uint2 halfWidth = SigmaDepthHalfWidth(eye, range, valid);
    cell.sector = SigmaFirstHitSectorForPixel(eye, pixel, measuredRange,
        range, halfWidth, valid);
    cell.valid = valid;
    return valid != 0u;
}

#define SIGMA_SOLVE_SAMPLES_PER_GROUP 16u
#define SIGMA_SOLVE_THREADS 256u

groupshared uint2 SolveOriginal[SIGMA_SOLVE_THREADS];
groupshared uint2 SolveTransformA[SIGMA_SOLVE_THREADS];
groupshared uint2 SolveTransformB[SIGMA_SOLVE_THREADS];
groupshared uint SolveTransformValidA[SIGMA_SOLVE_THREADS];
groupshared uint SolveTransformValidB[SIGMA_SOLVE_THREADS];
groupshared uint2 SolveCurrentY[SIGMA_SOLVE_THREADS];
groupshared SigmaQ48Bounds SolveAccepted[SIGMA_SOLVE_THREADS];
groupshared uint2 SolveCandidate[SIGMA_SOLVE_THREADS];
groupshared uint2 SolveGap[SIGMA_SOLVE_THREADS];
groupshared uint SolveLoSource[SIGMA_SOLVE_THREADS];
groupshared uint SolveHiSource[SIGMA_SOLVE_THREADS];
groupshared uint SolveCoordinateValid[SIGMA_SOLVE_THREADS];
groupshared uint SolveCoordinateConstrained[SIGMA_SOLVE_THREADS];
groupshared uint SolveCoordinateIndependent[SIGMA_SOLVE_THREADS];
groupshared uint SolveCoordinateChanged[SIGMA_SOLVE_THREADS];
groupshared SigmaCarrierPageMetaGpu SolveMetadata[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared SigmaDepthCell3 SolveDepthLeft[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared SigmaDepthCell3 SolveDepthRight[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared uint4 SolveRgbLeftMeta[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared uint4 SolveRgbRightMeta[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared float4 SolveWorldPosition[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared uint2 SolveMass[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared uint2 SolvePriorWidth[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared uint2 SolveTargetMass[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared uint SolveButterflySafe[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared uint SolveGeometryValid[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared uint SolveSampleValid[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared uint SolveStatus[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared uint SolveConstrainedMask[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared uint SolveConflictMask[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared uint SolveIndependentMask[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared uint SolveSectorMask[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared uint SolveRgbUnobservableMask[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared uint SolveScheduleRgb[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared uint SolveNeedsCandidate[SIGMA_SOLVE_SAMPLES_PER_GROUP];
groupshared uint SolveCandidateAccepted[SIGMA_SOLVE_SAMPLES_PER_GROUP];

void SigmaSolveButterflyStage(uint flat, uint coordinate, uint span,
    bool sourceA)
{
    uint base = flat - coordinate;
    uint lower = base + (coordinate & ~span);
    uint upper = lower | span;
    uint2 a = sourceA ? SolveTransformA[lower] : SolveTransformB[lower];
    uint2 b = sourceA ? SolveTransformA[upper] : SolveTransformB[upper];
    uint valid = (sourceA ? SolveTransformValidA[lower] :
        SolveTransformValidB[lower]) &
        (sourceA ? SolveTransformValidA[upper] :
        SolveTransformValidB[upper]);
    uint2 result = (coordinate & span) == 0u
        ? SigmaQ48AddChecked(a, b, valid)
        : SigmaQ48SubChecked(a, b, valid);
    if (sourceA)
    {
        SolveTransformB[flat] = result;
        SolveTransformValidB[flat] = valid;
    }
    else
    {
        SolveTransformA[flat] = result;
        SolveTransformValidA[flat] = valid;
    }
}

void SigmaSolveHadamard(uint flat, uint coordinate, uint sampleLocal,
    out uint2 result, out uint valid)
{
    uint inputValid = SolveTransformValidA[flat];
    SolveOriginal[flat] = SolveTransformA[flat];
    if (coordinate == 0u)
        SolveButterflySafe[sampleLocal] = 1u;
    GroupMemoryBarrierWithGroupSync();
    const uint2 limit = uint2(0xffffffffu, 0x07ffffffu);
    if (SigmaU64Less(limit, SigmaU64AbsSigned(SolveOriginal[flat])))
        InterlockedAnd(SolveButterflySafe[sampleLocal], 0u);
    GroupMemoryBarrierWithGroupSync();

    SigmaSolveButterflyStage(flat, coordinate, 1u, true);
    GroupMemoryBarrierWithGroupSync();
    SigmaSolveButterflyStage(flat, coordinate, 2u, false);
    GroupMemoryBarrierWithGroupSync();
    SigmaSolveButterflyStage(flat, coordinate, 4u, true);
    GroupMemoryBarrierWithGroupSync();
    SigmaSolveButterflyStage(flat, coordinate, 8u, false);
    GroupMemoryBarrierWithGroupSync();

    if (SolveButterflySafe[sampleLocal] != 0u)
    {
        result = SolveTransformA[flat];
        valid = SolveTransformValidA[flat];
        return;
    }
    valid = inputValid;
    result = SIGMA_Q48_ZERO;
    uint base = flat - coordinate;
    [unroll]
    for (uint sourceLane = 0u; sourceLane < 16u; ++sourceLane)
    {
        uint2 term = SigmaHadamardSign(coordinate, sourceLane) < 0
            ? SigmaQ48NegateChecked(SolveOriginal[base + sourceLane], valid)
            : SolveOriginal[base + sourceLane];
        result = SigmaQ48AddChecked(result, term, valid);
    }
}

void SigmaSolveMeetLane(SigmaQ48Bounds incoming, uint source,
    inout SigmaQ48Bounds joint, inout uint loSource, inout uint hiSource)
{
    bool takeLo = SigmaQ48Less(joint.lo, incoming.lo) ||
        (SigmaU64Equal(incoming.lo, joint.lo) && source < loSource);
    bool takeHi = SigmaQ48Less(incoming.hi, joint.hi) ||
        (SigmaU64Equal(incoming.hi, joint.hi) && source < hiSource);
    if (takeLo)
    {
        joint.lo = incoming.lo;
        loSource = source;
    }
    if (takeHi)
    {
        joint.hi = incoming.hi;
        hiSource = source;
    }
}

void SigmaSolveReduceCoordinateFacts(uint flat, uint coordinate)
{
    uint constrainedBit = SolveCoordinateConstrained[flat] != 0u
        ? 1u << coordinate : 0u;
    uint conflictBit = SolveCoordinateConstrained[flat] != 0u &&
        SigmaQ48Less(SolveAccepted[flat].hi, SolveAccepted[flat].lo)
        ? 1u << coordinate : 0u;
    uint independentBit = SolveCoordinateIndependent[flat] != 0u
        ? 1u << coordinate : 0u;
    uint laneValid = SolveCoordinateValid[flat];
    uint2 width = SIGMA_Q48_ZERO;
    if (constrainedBit != 0u && conflictBit == 0u)
        width = SigmaQ48SubChecked(SolveAccepted[flat].hi,
            SolveAccepted[flat].lo, laneValid);
    SolveTransformA[flat] = width;
    SolveTransformB[flat] = uint2(constrainedBit | (conflictBit << 16u),
        independentBit);
    SolveTransformValidA[flat] = laneValid;
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint span = 1u; span < 16u; span <<= 1u)
    {
        if ((coordinate & ((span << 1u) - 1u)) == 0u)
        {
            uint other = flat + span;
            SolveTransformA[flat] = SigmaQ48Max(SolveTransformA[flat],
                SolveTransformA[other]);
            SolveTransformB[flat] |= SolveTransformB[other];
            SolveTransformValidA[flat] &= SolveTransformValidA[other];
        }
        GroupMemoryBarrierWithGroupSync();
    }
}

void SigmaSolveReduceCoordinateOr(uint flat, uint coordinate, uint value)
{
    SolveTransformValidB[flat] = value;
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint span = 1u; span < 16u; span <<= 1u)
    {
        if ((coordinate & ((span << 1u) - 1u)) == 0u)
            SolveTransformValidB[flat] |= SolveTransformValidB[flat + span];
        GroupMemoryBarrierWithGroupSync();
    }
}

void SigmaSolveReduceCoordinateAnd(uint flat, uint coordinate, uint value)
{
    SolveTransformValidB[flat] = value;
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint span = 1u; span < 16u; span <<= 1u)
    {
        if ((coordinate & ((span << 1u) - 1u)) == 0u)
            SolveTransformValidB[flat] &= SolveTransformValidB[flat + span];
        GroupMemoryBarrierWithGroupSync();
    }
}

uint2 SigmaSolvePackSources(uint base)
{
    uint low = 0u;
    uint high = 0u;
    [unroll]
    for (uint coordinate = 0u; coordinate < 8u; ++coordinate)
        low |= (SolveLoSource[base + coordinate] & 15u) << (coordinate * 4u);
    [unroll]
    for (uint coordinate = 8u; coordinate < 16u; ++coordinate)
        high |= (SolveLoSource[base + coordinate] & 15u) <<
            ((coordinate - 8u) * 4u);
    return uint2(low, high);
}

uint2 SigmaSolvePackHiSources(uint base)
{
    uint low = 0u;
    uint high = 0u;
    [unroll]
    for (uint coordinate = 0u; coordinate < 8u; ++coordinate)
        low |= (SolveHiSource[base + coordinate] & 15u) << (coordinate * 4u);
    [unroll]
    for (uint coordinate = 8u; coordinate < 16u; ++coordinate)
        high |= (SolveHiSource[base + coordinate] & 15u) <<
            ((coordinate - 8u) * 4u);
    return uint2(low, high);
}

void SigmaAppendSolveEvidence(uint sampleLocal, uint sample)
{
    uint recordIndex;
    InterlockedAdd(_ConflictCount[0], 1u, recordIndex);
    if (recordIndex >= _ConflictCapacity)
        return;
    uint base = sampleLocal * 16u;
    SigmaCarrierPageMetaGpu metadata = SolveMetadata[sampleLocal];
    SigmaInverseConflictGpu record;
    record.carrierPage = uint4(metadata.pageXLo, metadata.pageXHi,
        metadata.pageYLo, metadata.pageYHi);
    record.stateAndSector = uint4(metadata.generation, sample,
        SolveSectorMask[sampleLocal], SolveConflictMask[sampleLocal]);
    record.independenceKeys = uint4(_LeftIndependenceKey,
        _RightIndependenceKey, _RgbLeftIndependenceKey,
        _RgbRightIndependenceKey);
    record.provenance = uint4(SigmaSolvePackSources(base),
        SigmaSolvePackHiSources(base));
    [unroll]
    for (uint pair = 0u; pair < 8u; ++pair)
        record.gapPairs[pair] = uint4(SolveGap[base + pair * 2u],
            SolveGap[base + pair * 2u + 1u]);
    _ConflictRecords[recordIndex] = record;
}

[numthreads(64, 1, 1)]
void ClearInverseFrame(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index < _ActiveFlagCount)
        _ActivePageFlags[index] = 0u;
    if (index < _BlockFlagCount)
    {
        _UnmatchedBlockFlags[index] = 0u;
        _UnmatchedBlockAnchors[index] = 0xffffffffu;
    }
    if (index == 0u)
        _ConflictCount[0] = 0u;
    if (index < SIGMA_COUNTER_COUNT)
        _FrameCounters[index] = 0u;
    if (index < _GaugeCommitCapacity)
        _GaugePromotionCounts[index] = 0u;
}

[numthreads(8, 8, 1)]
void ClassifyDepthFrame(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _Resolution) || id.z >= 2u)
        return;
    uint eye = id.z;
    uint3 address = uint3(id.xy, eye);
    float2 prediction = _PredDepthSupport[address];
    uint4 stateKey = _PredStateKey[address];
    if (prediction.y > 0.0 && stateKey.x != 0u &&
        stateKey.z < _SegmentCount && stateKey.w < 256u)
    {
        uint globalPage = stateKey.z * 256u + stateKey.w;
        if (globalPage < _ActiveFlagCount)
            InterlockedOr(_ActivePageFlags[globalPage], 1u);
    }

    if (eye != 0u || (_DepthFlags[address] & 1u) == 0u)
        return;
    float2 leftMetric = _MetricDepth[address];
    uint valid = 1u;
    uint2 leftRange = SigmaQ48FromFloatNearestEven(leftMetric.x, valid);
    uint2 leftWidth = SigmaDepthHalfWidth(0u, leftRange, valid);
    SigmaQ48Bounds measured;
    SigmaQ48Bounds predicted;
    uint sector = SigmaClassifyFirstHitExact(leftRange, leftWidth, prediction,
        measured, predicted, valid);
    bool novelLeft = valid != 0u &&
        (!(prediction.y > 0.0) || sector == SIGMA_SECTOR_NO_CONSTRAINT);
    if (!novelLeft)
        return;

    float3 world = SigmaDepthWorldPointCandidate(0u, id.xy, leftMetric.x);
    uint2 rightPixel;
    float3 rightOptical;
    if (!SigmaProjectWorldToPixel(world, 1u, rightPixel, rightOptical) ||
        (_DepthFlags[uint3(rightPixel, 1u)] & 1u) == 0u)
        return;
    float2 rightMetric = _MetricDepth[uint3(rightPixel, 1u)];
    float expectedRightRange = length(rightOptical);
    float candidateWidth = 0.006 + 0.006 *
        max(leftMetric.x * leftMetric.x, rightMetric.x * rightMetric.x);
    if (abs(rightMetric.x - expectedRightRange) > candidateWidth)
        return;
    float2 rightPrediction = _PredDepthSupport[uint3(rightPixel, 1u)];
    uint2 rightRange = SigmaQ48FromFloatNearestEven(rightMetric.x, valid);
    uint2 rightWidth = SigmaDepthHalfWidth(1u, rightRange, valid);
    uint rightSector = SigmaClassifyFirstHitExact(rightRange, rightWidth,
        rightPrediction, measured, predicted, valid);
    if (valid == 0u || (rightPrediction.y > 0.0 &&
        rightSector != SIGMA_SECTOR_NO_CONSTRAINT))
        return;

    uint2 block = id.xy >> 5u;
    if (any(block >= _GaugeBlockResolution))
        return;
    uint blockIndex = block.y * _GaugeBlockResolution.x + block.x;
    uint previous;
    InterlockedOr(_UnmatchedBlockFlags[blockIndex], 1u, previous);
    if (previous == 0u)
        InterlockedAdd(_FrameCounters[SIGMA_COUNTER_UNMATCHED_BLOCKS], 1u);

    // Gauge allocation prefers an existing carrier neighbour but the image
    // neighbourhood is only a scheduling hint: no topology or geometry is
    // inferred from it. The exact promotion gate below remains authoritative.
    uint anchor = 0xffffffffu;
    [unroll]
    for (int offsetY = -1; offsetY <= 1; ++offsetY)
    {
        [unroll]
        for (int offsetX = -1; offsetX <= 1; ++offsetX)
        {
            if (offsetX == 0 && offsetY == 0)
                continue;
            int2 neighbour = int2(id.xy) + int2(offsetX, offsetY);
            if (any(neighbour < 0) || any(neighbour >= (int2)_Resolution))
                continue;
            uint4 key = _PredStateKey[uint3((uint2)neighbour, 0u)];
            if (key.x == 0u || key.z >= _SegmentCount || key.w >= 256u)
                continue;
            anchor = min(anchor, key.z * 256u + key.w);
        }
    }
    if (anchor != 0xffffffffu)
        InterlockedMin(_UnmatchedBlockAnchors[blockIndex], anchor);
}

[numthreads(256, 1, 1)]
void SolveAndCommitPage(uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint workIndex = _UseInverseWorkList != 0u ? groupId.y : 0u;
    if ((_UseInverseWorkList != 0u &&
            workIndex >= _InverseWorkControl[0u]) ||
        groupId.x >= SIGMA_PAGE_SAMPLE_COUNT /
            SIGMA_SOLVE_SAMPLES_PER_GROUP ||
        !SigmaCanonicalMutationEnabled())
        return;

    SigmaInverseWorkGpu work = (SigmaInverseWorkGpu)0;
    if (_UseInverseWorkList != 0u)
        work = _InverseWork[workIndex];
    uint sourcePageSlot = _UseInverseWorkList != 0u
        ? work.slots.x : _SourcePageSlot;
    uint targetPageSlot = _UseInverseWorkList != 0u
        ? work.slots.y : _TargetPageSlot;
    uint proofTargetSlot = _UseInverseWorkList != 0u
        ? work.slots.w : _ProofTargetSlot;
    if (targetPageSlot >= _TargetPageCapacity ||
        sourcePageSlot >= _PageCapacity)
        return;

    uint flat = groupThreadId.x;
    uint coordinate = flat & 15u;
    uint sampleLocal = flat >> 4u;
    uint sample = groupId.x * SIGMA_SOLVE_SAMPLES_PER_GROUP + sampleLocal;
    uint sampleBase = sampleLocal * 16u;
    uint targetBase = targetPageSlot * SIGMA_PAGE_LANE_COUNT +
        sample * SIGMA_LANE_COUNT;
    uint proposalPageSlot = _UseInverseWorkList != 0u
        ? targetPageSlot : sourcePageSlot;
    uint proposalIndex = proposalPageSlot * SIGMA_PAGE_SAMPLE_COUNT + sample;
    uint proofIndex = workIndex * SIGMA_PAGE_SAMPLE_COUNT + sample;

    if (coordinate == 0u)
    {
        SolveMetadata[sampleLocal] = _PageMetadata[sourcePageSlot];
        SolveDepthLeft[sampleLocal] = (SigmaDepthCell3)0;
        SolveDepthRight[sampleLocal] = (SigmaDepthCell3)0;
        SolveRgbLeftMeta[sampleLocal] = 0u;
        SolveRgbRightMeta[sampleLocal] = 0u;
        SolveWorldPosition[sampleLocal] = 0.0;
        SolveGeometryValid[sampleLocal] = 0u;
        SolveSampleValid[sampleLocal] = 0u;
        SolveStatus[sampleLocal] = 0u;
        SolveConstrainedMask[sampleLocal] = 0u;
        SolveConflictMask[sampleLocal] = 0u;
        SolveIndependentMask[sampleLocal] = 0u;
        SolveSectorMask[sampleLocal] = 0u;
        SolveRgbUnobservableMask[sampleLocal] = 0u;
        SolveScheduleRgb[sampleLocal] = SigmaRgbSampleScheduled(sample,
            _RgbPhase) ? 1u : 0u;
        SolveNeedsCandidate[sampleLocal] = 0u;
        SolveCandidateAccepted[sampleLocal] = 0u;
        SolveTargetMass[sampleLocal] = SIGMA_Q48_ZERO;
        _ProposalStatus[proposalIndex] = 0u;
        if (sample == 0u)
            _ProposalEpoch[proposalPageSlot] = _ProposalFrameSerial;
    }
    SolveTransformA[flat] = _TargetCarrierState[targetBase + coordinate];
    SolveTransformValidA[flat] = 1u;
    GroupMemoryBarrierWithGroupSync();

    uint2 transformed;
    uint transformValid;
    SigmaSolveHadamard(flat, coordinate, sampleLocal, transformed,
        transformValid);
    SolveTransformB[flat] = transformed;
    SolveTransformValidB[flat] = transformValid;
    if (coordinate == SIGMA_GEOMETRY_ROWS[0])
        SolveMass[sampleLocal] = transformed;
    GroupMemoryBarrierWithGroupSync();

    if (coordinate == 0u)
    {
        uint widthValid = SolveTransformValidB[sampleBase +
            SIGMA_GEOMETRY_ROWS[0]];
        if (!SigmaQ48Positive(SolveMass[sampleLocal]))
            widthValid = 0u;
        SolvePriorWidth[sampleLocal] = SigmaPriorHalfWidth(
            SolveMass[sampleLocal], widthValid);
        SolveSampleValid[sampleLocal] = widthValid;
    }
    GroupMemoryBarrierWithGroupSync();

    uint projectiveValid = transformValid & SolveSampleValid[sampleLocal];
    uint2 currentY = SIGMA_Q48_ZERO;
    SigmaQ48Bounds accepted = SigmaQ48PointBounds(SIGMA_Q48_ZERO);
    if (projectiveValid != 0u)
    {
        currentY = SigmaQ48DivNearestEven(transformed,
            SolveMass[sampleLocal], projectiveValid);
        accepted = SigmaQ48Widen(currentY,
            SolvePriorWidth[sampleLocal], projectiveValid);
    }
    SolveCurrentY[flat] = currentY;
    SolveTransformValidA[flat] = projectiveValid;
    uint priorValid = projectiveValid;
    if (priorValid != 0u)
        priorValid &= SigmaApplyConstraintPriorLane(
            SolveMetadata[sampleLocal], sample, coordinate, accepted) ? 1u : 0u;
    SolveAccepted[flat] = accepted;
    SolveCoordinateValid[flat] = priorValid;
    SolveLoSource[flat] = SIGMA_SOURCE_PRIOR;
    SolveHiSource[flat] = SIGMA_SOURCE_PRIOR;
    SolveGap[flat] = SIGMA_Q48_ZERO;
    SolveCoordinateConstrained[flat] = 0u;
    SolveCoordinateIndependent[flat] = 0u;
    SolveCoordinateChanged[flat] = 0u;
    GroupMemoryBarrierWithGroupSync();

    if (coordinate == 0u)
    {
        uint geometryValid = SolveTransformValidA[sampleBase +
            SIGMA_GEOMETRY_ROWS[0]] &
            SolveTransformValidA[sampleBase + SIGMA_GEOMETRY_ROWS[1]] &
            SolveTransformValidA[sampleBase + SIGMA_GEOMETRY_ROWS[2]] &
            SolveTransformValidA[sampleBase + SIGMA_GEOMETRY_ROWS[3]];
        SolveGeometryValid[sampleLocal] = geometryValid;
        float3 world = float3(
            SigmaQ48ToReadoutFloat(SolveCurrentY[sampleBase +
                SIGMA_GEOMETRY_ROWS[1]]),
            SigmaQ48ToReadoutFloat(SolveCurrentY[sampleBase +
                SIGMA_GEOMETRY_ROWS[2]]),
            SigmaQ48ToReadoutFloat(SolveCurrentY[sampleBase +
                SIGMA_GEOMETRY_ROWS[3]]));
        SolveWorldPosition[sampleLocal] = float4(world, 1.0);
        if (geometryValid != 0u)
        {
            SigmaBuildMatchedEyeCell(0u, world,
                SolveMetadata[sampleLocal], sourcePageSlot, sample,
                SolveDepthLeft[sampleLocal]);
            SigmaBuildMatchedEyeCell(1u, world,
                SolveMetadata[sampleLocal], sourcePageSlot, sample,
                SolveDepthRight[sampleLocal]);
        }
        SigmaDepthCell3 left = SolveDepthLeft[sampleLocal];
        SigmaDepthCell3 right = SolveDepthRight[sampleLocal];
        SolveSectorMask[sampleLocal] = (left.sector & 3u) |
            ((right.sector & 3u) << 2u);
        bool exclusion = (left.valid != 0u &&
                left.sector == SIGMA_SECTOR_PRE_HIT_EXCLUSION) ||
            (right.valid != 0u &&
                right.sector == SIGMA_SECTOR_PRE_HIT_EXCLUSION);
        if (exclusion)
            SolveStatus[sampleLocal] = SIGMA_PROPOSAL_EXCLUSION;

        if (SolveScheduleRgb[sampleLocal] != 0u)
        {
            uint scheduledSample = SigmaRgbPhaseScheduledIndex(sample);
            uint cellBase = workIndex * 2u * SIGMA_RGB_PHASE_SAMPLE_COUNT;
            SolveRgbLeftMeta[sampleLocal] = _RgbSourceMetaRead[cellBase +
                SigmaRgbSourceCellAddress(0u, scheduledSample)];
            SolveRgbRightMeta[sampleLocal] = _RgbSourceMetaRead[cellBase +
                SigmaRgbSourceCellAddress(1u, scheduledSample)];
            SolveRgbUnobservableMask[sampleLocal] =
                ((SolveRgbLeftMeta[sampleLocal].w &
                    SIGMA_RGB_SOURCE_UNOBSERVABLE) != 0u ? 1u : 0u) |
                ((SolveRgbRightMeta[sampleLocal].w &
                    SIGMA_RGB_SOURCE_UNOBSERVABLE) != 0u ? 2u : 0u);
        }

        uint allValid = geometryValid;
        [unroll]
        for (uint lane = 0u; lane < 16u; ++lane)
            allValid &= SolveCoordinateValid[sampleBase + lane];
        if (!SigmaU64Equal(SolveCurrentY[sampleBase +
                SIGMA_GEOMETRY_ROWS[0]], SIGMA_Q48_ONE))
            allValid = 0u;
        SolveSampleValid[sampleLocal] = allValid;
    }
    GroupMemoryBarrierWithGroupSync();

    bool exclusion = (SolveStatus[sampleLocal] &
        SIGMA_PROPOSAL_EXCLUSION) != 0u;
    uint laneValid = SolveSampleValid[sampleLocal];
    SigmaQ48Bounds laneAccepted = SolveAccepted[flat];
    uint loSource = SIGMA_SOURCE_PRIOR;
    uint hiSource = SIGMA_SOURCE_PRIOR;
    bool constrained = false;
    bool independent = false;
    uint firstKey = 0u;

    if (laneValid != 0u && !exclusion)
    {
        [unroll]
        for (uint axis = 0u; axis < 3u; ++axis)
        {
            if (coordinate != SIGMA_GEOMETRY_ROWS[axis + 1u])
                continue;
            SigmaDepthCell3 left = SolveDepthLeft[sampleLocal];
            SigmaDepthCell3 right = SolveDepthRight[sampleLocal];
            if (left.valid != 0u && left.sector == SIGMA_SECTOR_HIT)
            {
                SigmaSolveMeetLane(left.axis[axis], SIGMA_SOURCE_DEPTH_LEFT,
                    laneAccepted, loSource, hiSource);
                constrained = true;
                SigmaAccumulateIndependentKey(left.independenceKey,
                    firstKey, independent);
            }
            if (right.valid != 0u && right.sector == SIGMA_SECTOR_HIT)
            {
                SigmaSolveMeetLane(right.axis[axis], SIGMA_SOURCE_DEPTH_RIGHT,
                    laneAccepted, loSource, hiSource);
                constrained = true;
                SigmaAccumulateIndependentKey(right.independenceKey,
                    firstKey, independent);
            }
        }

        if (SolveScheduleRgb[sampleLocal] != 0u)
        {
            uint scheduledSample = SigmaRgbPhaseScheduledIndex(sample);
            uint boundBase = workIndex * 2u *
                SIGMA_RGB_PHASE_SAMPLE_COUNT * 16u;
            uint4 leftMeta = SolveRgbLeftMeta[sampleLocal];
            uint4 rightMeta = SolveRgbRightMeta[sampleLocal];
            if ((leftMeta.w & SIGMA_RGB_SOURCE_VALID) != 0u &&
                (leftMeta.x & (1u << coordinate)) != 0u)
            {
                SigmaQ48Bounds rgb = _RgbSourceBoundsRead[boundBase +
                    SigmaRgbSourceBoundAddress(0u, scheduledSample,
                        coordinate)];
                SigmaSolveMeetLane(rgb, SIGMA_SOURCE_RGB_LEFT,
                    laneAccepted, loSource, hiSource);
                constrained = true;
                SigmaAccumulateIndependentKey(leftMeta.z,
                    firstKey, independent);
            }
            if ((rightMeta.w & SIGMA_RGB_SOURCE_VALID) != 0u &&
                (rightMeta.x & (1u << coordinate)) != 0u)
            {
                SigmaQ48Bounds rgb = _RgbSourceBoundsRead[boundBase +
                    SigmaRgbSourceBoundAddress(1u, scheduledSample,
                        coordinate)];
                SigmaSolveMeetLane(rgb, SIGMA_SOURCE_RGB_RIGHT,
                    laneAccepted, loSource, hiSource);
                constrained = true;
                SigmaAccumulateIndependentKey(rightMeta.z,
                    firstKey, independent);
            }
        }
    }

    SolveAccepted[flat] = laneAccepted;
    SolveLoSource[flat] = loSource;
    SolveHiSource[flat] = hiSource;
    SolveCoordinateConstrained[flat] = constrained ? 1u : 0u;
    SolveCoordinateIndependent[flat] = independent ? 1u : 0u;
    if (laneValid != 0u && constrained &&
        SigmaQ48Less(laneAccepted.hi, laneAccepted.lo))
    {
        SolveGap[flat] = SigmaQ48SubChecked(laneAccepted.lo,
            laneAccepted.hi, laneValid);
    }
    SolveCoordinateValid[flat] = laneValid;
    SigmaSolveReduceCoordinateFacts(flat, coordinate);

    if (coordinate == 0u)
    {
        uint status = SolveStatus[sampleLocal];
        uint2 facts = SolveTransformB[sampleBase];
        uint constrainedMask = facts.x & 0xffffu;
        uint conflictMask = facts.x >> 16u;
        uint independentMask = facts.y;
        uint reductionValid = SolveSampleValid[sampleLocal] &
            SolveTransformValidA[sampleBase];
        uint2 maximumWidth = SolveTransformA[sampleBase];
        SigmaDepthCell3 left = SolveDepthLeft[sampleLocal];
        SigmaDepthCell3 right = SolveDepthRight[sampleLocal];
        if (!exclusion && reductionValid != 0u)
        {
            if (left.valid != 0u && left.sector == SIGMA_SECTOR_HIT)
                status |= SIGMA_PROPOSAL_HIT_LEFT;
            if (right.valid != 0u && right.sector == SIGMA_SECTOR_HIT)
                status |= SIGMA_PROPOSAL_HIT_RIGHT;
            uint4 leftMeta = SolveRgbLeftMeta[sampleLocal];
            uint4 rightMeta = SolveRgbRightMeta[sampleLocal];
            if (SolveRgbUnobservableMask[sampleLocal] != 0u)
                status |= SIGMA_PROPOSAL_RGB_UNOBSERVABLE;
            if ((leftMeta.w & SIGMA_RGB_SOURCE_VALID) != 0u &&
                leftMeta.x != 0u)
                status |= SIGMA_PROPOSAL_RGB_LEFT;
            if ((rightMeta.w & SIGMA_RGB_SOURCE_VALID) != 0u &&
                rightMeta.x != 0u)
                status |= SIGMA_PROPOSAL_RGB_RIGHT;
        }
        SolveConstrainedMask[sampleLocal] = constrainedMask;
        SolveConflictMask[sampleLocal] = conflictMask;
        SolveIndependentMask[sampleLocal] = independentMask;
        if (conflictMask != 0u)
            status |= SIGMA_PROPOSAL_CONFLICT;
        if (constrainedMask == 0u || conflictMask != 0u ||
            reductionValid == 0u || exclusion)
            SolveSampleValid[sampleLocal] = 0u;
        else
        {
            uint2 targetMass = SolveMass[sampleLocal];
            if ((independentMask & constrainedMask) == constrainedMask)
                targetMass = SigmaQ48Max(targetMass,
                    SigmaInformationMassForWidth(maximumWidth,
                        reductionValid));
            SolveTargetMass[sampleLocal] = targetMass;
            SolveSampleValid[sampleLocal] = reductionValid;
        }
        SolveStatus[sampleLocal] = status;
    }
    GroupMemoryBarrierWithGroupSync();

    uint2 targetY = SolveCurrentY[flat];
    uint targetValid = SolveSampleValid[sampleLocal];
    if (targetValid != 0u &&
        SolveCoordinateConstrained[flat] != 0u)
        targetY = SigmaProjectiveClamp(targetY,
            SolveAccepted[flat].lo, SolveAccepted[flat].hi);
    SolveCoordinateChanged[flat] = targetValid != 0u &&
        (!SigmaU64Equal(targetY, SolveCurrentY[flat]) ||
         SigmaQ48Less(SolveMass[sampleLocal],
            SolveTargetMass[sampleLocal])) ? 1u : 0u;
    SolveTransformA[flat] = targetY;
    SolveTransformValidA[flat] = targetValid;
    SigmaSolveReduceCoordinateOr(flat, coordinate,
        SolveCoordinateChanged[flat]);

    if (coordinate == 0u)
    {
        uint changed = SolveTransformValidB[sampleBase];
        SolveNeedsCandidate[sampleLocal] = changed;
        if (SolveSampleValid[sampleLocal] != 0u && changed == 0u)
            SolveStatus[sampleLocal] |= SIGMA_PROPOSAL_ACCEPTED;
    }
    GroupMemoryBarrierWithGroupSync();

    uint needsCandidate = SolveNeedsCandidate[sampleLocal] &
        SolveSampleValid[sampleLocal];
    if (needsCandidate == 0u)
    {
        SolveTransformA[flat] = SIGMA_Q48_ZERO;
        SolveTransformValidA[flat] = 0u;
    }
    uint2 inverse;
    uint inverseValid;
    SigmaSolveHadamard(flat, coordinate, sampleLocal, inverse, inverseValid);
    uint candidateValid = needsCandidate & inverseValid;
    uint2 projective = SigmaQ48ShiftRightNearestEven(inverse, 4u,
        candidateValid);
    uint2 candidate = SigmaQ48MulNearestEven(
        SolveTargetMass[sampleLocal], projective, candidateValid);
    SolveCandidate[flat] = candidate;
    SolveTransformA[flat] = candidate;
    SolveTransformValidA[flat] = candidateValid;

    uint2 candidateReadout;
    uint candidateReadoutValid;
    SigmaSolveHadamard(flat, coordinate, sampleLocal, candidateReadout,
        candidateReadoutValid);
    SolveTransformB[flat] = candidateReadout;
    SolveCoordinateValid[flat] = candidateReadoutValid;
    if (coordinate == SIGMA_GEOMETRY_ROWS[0])
        SolveMass[sampleLocal] = candidateReadout;
    GroupMemoryBarrierWithGroupSync();

    uint revalidate = candidateReadoutValid & needsCandidate;
    uint2 oneLsb = uint2(1u, 0u);
    if (revalidate != 0u && coordinate == SIGMA_GEOMETRY_ROWS[0])
    {
        if (!SigmaQ48Positive(SolveMass[sampleLocal]) ||
            SigmaQ48Less(oneLsb, SigmaQ48AbsDifference(
                SolveMass[sampleLocal], SolveTargetMass[sampleLocal],
                revalidate)))
            revalidate = 0u;
    }
    if (revalidate != 0u && SolveCoordinateConstrained[flat] != 0u)
    {
        uint2 check = SigmaQ48DivNearestEven(candidateReadout,
            SolveMass[sampleLocal], revalidate);
        uint2 lo = SigmaQ48SubChecked(SolveAccepted[flat].lo,
            oneLsb, revalidate);
        uint2 hi = SigmaQ48AddChecked(SolveAccepted[flat].hi,
            oneLsb, revalidate);
        if (revalidate == 0u || SigmaQ48Less(check, lo) ||
            SigmaQ48Less(hi, check))
            revalidate = 0u;
    }
    SolveCoordinateValid[flat] = revalidate;
    SigmaSolveReduceCoordinateAnd(flat, coordinate, revalidate);

    if (coordinate == 0u)
    {
        uint acceptedCandidate = needsCandidate &
            SolveTransformValidB[sampleBase];
        SolveCandidateAccepted[sampleLocal] = acceptedCandidate;
        if (needsCandidate != 0u)
        {
            if (acceptedCandidate != 0u)
                SolveStatus[sampleLocal] |= SIGMA_PROPOSAL_ACCEPTED |
                    SIGMA_PROPOSAL_CHANGED;
            else
                SolveStatus[sampleLocal] |= SIGMA_PROPOSAL_INVALID;
        }
    }
    GroupMemoryBarrierWithGroupSync();

    if (SolveCandidateAccepted[sampleLocal] != 0u)
        _TargetCarrierState[targetBase + coordinate] = SolveCandidate[flat];

    // Write the proof record cooperatively. Distinct coordinate lanes own
    // disjoint structured-buffer members; lane zero owns scalar provenance.
    SigmaQ48Bounds rgbLeftBound = (SigmaQ48Bounds)0;
    SigmaQ48Bounds rgbRightBound = (SigmaQ48Bounds)0;
    if (SolveScheduleRgb[sampleLocal] != 0u)
    {
        uint scheduledSample = SigmaRgbPhaseScheduledIndex(sample);
        uint boundBase = workIndex * 2u *
            SIGMA_RGB_PHASE_SAMPLE_COUNT * 16u;
        rgbLeftBound = _RgbSourceBoundsRead[boundBase +
            SigmaRgbSourceBoundAddress(0u, scheduledSample, coordinate)];
        rgbRightBound = _RgbSourceBoundsRead[boundBase +
            SigmaRgbSourceBoundAddress(1u, scheduledSample, coordinate)];
    }
    _ProofSamples[proofIndex].rgbLeft.coordinate[coordinate] = rgbLeftBound;
    _ProofSamples[proofIndex].rgbRight.coordinate[coordinate] = rgbRightBound;

    if (coordinate == 0u)
    {
        uint status = SolveStatus[sampleLocal];
        uint constrainedMask = SolveConstrainedMask[sampleLocal];
        uint rgbUnobservable = SolveRgbUnobservableMask[sampleLocal];
        float3 world = SolveWorldPosition[sampleLocal].xyz;
        if (SolveGeometryValid[sampleLocal] == 0u)
        {
            status = 0u;
            constrainedMask = 0u;
            rgbUnobservable = 0u;
        }
        _ProofSamples[proofIndex].meta = uint4(status, constrainedMask,
            SolveScheduleRgb[sampleLocal], rgbUnobservable);
        _ProofSamples[proofIndex].depthLeft = SolveDepthLeft[sampleLocal];
        _ProofSamples[proofIndex].depthRight = SolveDepthRight[sampleLocal];
        uint4 leftMeta = SolveRgbLeftMeta[sampleLocal];
        uint4 rightMeta = SolveRgbRightMeta[sampleLocal];
        _ProofSamples[proofIndex].rgbLeft.coordinateMask = leftMeta.x;
        _ProofSamples[proofIndex].rgbLeft.sourceClass = leftMeta.y;
        _ProofSamples[proofIndex].rgbLeft.independenceKey = leftMeta.z;
        _ProofSamples[proofIndex].rgbLeft.valid = leftMeta.w &
            SIGMA_RGB_SOURCE_VALID;
        _ProofSamples[proofIndex].rgbRight.coordinateMask = rightMeta.x;
        _ProofSamples[proofIndex].rgbRight.sourceClass = rightMeta.y;
        _ProofSamples[proofIndex].rgbRight.independenceKey = rightMeta.z;
        _ProofSamples[proofIndex].rgbRight.valid = rightMeta.w &
            SIGMA_RGB_SOURCE_VALID;
        _ProofSamples[proofIndex].raw[0] = SolveGeometryValid[sampleLocal] != 0u
            ? SigmaCaptureDepthRaw(0u, world, SolveDepthLeft[sampleLocal]) : 0u;
        _ProofSamples[proofIndex].raw[1] = SolveGeometryValid[sampleLocal] != 0u
            ? SigmaCaptureDepthRaw(1u, world, SolveDepthRight[sampleLocal]) : 0u;
        uint4 rgb00 = 0u, rgb01 = 0u, rgb10 = 0u, rgb11 = 0u;
        if (SolveGeometryValid[sampleLocal] != 0u &&
            SolveScheduleRgb[sampleLocal] != 0u)
        {
            SigmaCaptureRgbRaw(0u, world, rgb00, rgb01);
            SigmaCaptureRgbRaw(1u, world, rgb10, rgb11);
        }
        _ProofSamples[proofIndex].raw[2] = rgb00;
        _ProofSamples[proofIndex].raw[3] = rgb01;
        _ProofSamples[proofIndex].raw[4] = rgb10;
        _ProofSamples[proofIndex].raw[5] = rgb11;

        _ProposalStatus[proposalIndex] = status;
        if ((status & (SIGMA_PROPOSAL_HIT_LEFT |
                SIGMA_PROPOSAL_HIT_RIGHT)) != 0u)
            InterlockedAdd(_FrameCounters[SIGMA_COUNTER_HIT_SAMPLES], 1u);
        if ((status & SIGMA_PROPOSAL_EXCLUSION) != 0u)
        {
            SigmaAppendSolveEvidence(sampleLocal, sample);
            InterlockedAdd(_FrameCounters[SIGMA_COUNTER_EXCLUSIONS], 1u);
        }
        if ((status & SIGMA_PROPOSAL_CONFLICT) != 0u)
        {
            SigmaAppendSolveEvidence(sampleLocal, sample);
            InterlockedAdd(_FrameCounters[SIGMA_COUNTER_EMPTY_MEETS], 1u);
        }
        if ((status & (SIGMA_PROPOSAL_ACCEPTED |
                SIGMA_PROPOSAL_CHANGED)) ==
            (SIGMA_PROPOSAL_ACCEPTED | SIGMA_PROPOSAL_CHANGED))
        {
            InterlockedAdd(_FrameCounters[SIGMA_COUNTER_CHANGED_SAMPLES], 1u);
            InterlockedOr(_ProofPageStatus[SigmaProofStatusAddress(
                proofTargetSlot, 1u)], SIGMA_PROOF_STATE_CHANGED);
        }
    }
}

[numthreads(8, 8, 1)]
void PromoteGaugePage(uint3 id : SV_DispatchThreadID)
{
    uint gaugeIndex = _UseInverseWorkList != 0u ? id.z : 0u;
    uint workIndex = _UseInverseWorkList != 0u
        ? _InverseWorkControl[0u] + gaugeIndex : 0u;
    if (_UseInverseWorkList != 0u &&
        gaugeIndex >= _InverseWorkControl[1u])
        return;
    SigmaInverseWorkGpu work = (SigmaInverseWorkGpu)0;
    if (_UseInverseWorkList != 0u)
        work = _InverseWork[workIndex];
    uint targetPageSlot = _UseInverseWorkList != 0u
        ? work.slots.y : _TargetPageSlot;
    uint proofTargetSlot = _UseInverseWorkList != 0u
        ? work.slots.w : _ProofTargetSlot;
    uint2 gaugePixelOrigin = _UseInverseWorkList != 0u
        ? uint2(SigmaInverseWorkImageX(work), SigmaInverseWorkImageY(work))
        : _GaugePixelOrigin;
    uint gaugeBlockMask = _UseInverseWorkList != 0u
        ? work.control.z : _GaugeBlockMask;
    if (!SigmaCanonicalMutationEnabled() || any(id.xy >= 64u) ||
        targetPageSlot >= _TargetPageCapacity)
        return;
    uint2 quadrant = id.xy >> 5u;
    uint quadrantBit = 1u << (quadrant.y * 2u + quadrant.x);
    if ((gaugeBlockMask & quadrantBit) == 0u)
        return;
    uint2 leftPixel = gaugePixelOrigin + id.xy;
    if (any(leftPixel >= _Resolution) ||
        (_DepthFlags[uint3(leftPixel, 0u)] & 1u) == 0u)
        return;
    float2 leftMetric = _MetricDepth[uint3(leftPixel, 0u)];
    SigmaDepthCell3 left;
    SigmaQ48Bounds leftRangeBounds;
    if (!SigmaBuildDepthWorldCell(0u, leftPixel, leftMetric,
            SIGMA_SOURCE_DEPTH_LEFT, _LeftIndependenceKey, left,
            leftRangeBounds))
        return;
    uint valid = 1u;
    uint2 leftRange = SigmaQ48FromFloatNearestEven(leftMetric.x, valid);
    uint2 leftWidth = SigmaDepthHalfWidth(0u, leftRange, valid);
    SigmaQ48Bounds ignored;
    uint leftSector = SigmaClassifyFirstHitExact(leftRange, leftWidth,
        _PredDepthSupport[uint3(leftPixel, 0u)], leftRangeBounds, ignored, valid);
    bool leftNovel = valid != 0u &&
        (!SigmaPredictionHasContact(leftPixel, 0u) ||
         leftSector == SIGMA_SECTOR_NO_CONSTRAINT);
    if (!leftNovel)
        return;

    float3 world = SigmaDepthWorldPointCandidate(0u, leftPixel, leftMetric.x);
    uint2 rightPixel;
    float3 rightOptical;
    if (!SigmaProjectWorldToPixel(world, 1u, rightPixel, rightOptical) ||
        (_DepthFlags[uint3(rightPixel, 1u)] & 1u) == 0u)
        return;
    float2 rightMetric = _MetricDepth[uint3(rightPixel, 1u)];
    SigmaDepthCell3 right;
    SigmaQ48Bounds rightRangeBounds;
    if (!SigmaBuildDepthWorldCell(1u, rightPixel, rightMetric,
            SIGMA_SOURCE_DEPTH_RIGHT, _RightIndependenceKey, right,
            rightRangeBounds))
        return;
    uint2 rightRange = SigmaQ48FromFloatNearestEven(rightMetric.x, valid);
    uint2 rightWidth = SigmaDepthHalfWidth(1u, rightRange, valid);
    uint rightSector = SigmaClassifyFirstHitExact(rightRange, rightWidth,
        _PredDepthSupport[uint3(rightPixel, 1u)], rightRangeBounds, ignored, valid);
    bool rightNovel = valid != 0u &&
        (!SigmaPredictionHasContact(rightPixel, 1u) ||
         rightSector == SIGMA_SECTOR_NO_CONSTRAINT);
    if (!rightNovel)
        return;

    uint2 promoted[16];
    if (!SigmaLiftNullDepthMeet(left, right, promoted))
        return;
    uint sample = id.y * 64u + id.x;
    uint proposalIndex = targetPageSlot * SIGMA_PAGE_SAMPLE_COUNT + sample;
    _ProposalStatus[proposalIndex] = SIGMA_PROPOSAL_ACCEPTED |
        SIGMA_PROPOSAL_CHANGED | SIGMA_PROPOSAL_HIT_LEFT |
        SIGMA_PROPOSAL_HIT_RIGHT;
    if (sample == 0u)
        _ProposalEpoch[targetPageSlot] = _ProposalFrameSerial;
    uint targetBase = targetPageSlot * SIGMA_PAGE_LANE_COUNT +
        sample * SIGMA_LANE_COUNT;
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
        _TargetCarrierState[targetBase + lane] = promoted[lane];
    SigmaAdmissibleCell16 emptyRgb = (SigmaAdmissibleCell16)0;
    SigmaWriteProofSample(workIndex, sample,
        SIGMA_PROPOSAL_ACCEPTED | SIGMA_PROPOSAL_CHANGED |
        SIGMA_PROPOSAL_HIT_LEFT | SIGMA_PROPOSAL_HIT_RIGHT,
        (1u << SIGMA_GEOMETRY_ROWS[1]) |
        (1u << SIGMA_GEOMETRY_ROWS[2]) |
        (1u << SIGMA_GEOMETRY_ROWS[3]), 0u, false,
        SigmaDepthWorldPointCandidate(0u, leftPixel, leftMetric.x),
        left, right, emptyRgb, emptyRgb);
    InterlockedOr(_ProofPageStatus[SigmaProofStatusAddress(
        proofTargetSlot, 1u)], SIGMA_PROOF_STATE_CHANGED);
    uint promotionIndex = _UseInverseWorkList != 0u
        ? workIndex : _GaugeCommitIndex;
    if (promotionIndex < _GaugeCommitCapacity)
        InterlockedAdd(_GaugePromotionCounts[promotionIndex], 1u);
}

[numthreads(1, 1, 1)]
void EvaluateDepthMeetFixture(uint3 dispatchId : SV_DispatchThreadID)
{
    uint2 state[16];
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
        state[lane] = _FixtureState[lane];
    SigmaDepthCell3 cells[2];
    [unroll]
    for (uint sourceIndex = 0u; sourceIndex < 2u; ++sourceIndex)
    {
        [unroll]
        for (uint axis = 0u; axis < 3u; ++axis)
        {
            cells[sourceIndex].axis[axis].lo =
                _FixtureCellBounds[sourceIndex * 6u + axis * 2u];
            cells[sourceIndex].axis[axis].hi =
                _FixtureCellBounds[sourceIndex * 6u + axis * 2u + 1u];
        }
        uint4 metadata = _FixtureCellMeta[sourceIndex];
        cells[sourceIndex].sourceClass = metadata.x;
        cells[sourceIndex].independenceKey = metadata.y;
        cells[sourceIndex].sector = metadata.z;
        cells[sourceIndex].valid = metadata.w;
    }
    uint2 targetGeometry[3];
    uint2 targetMass;
    uint status;
    uint conflictMask;
    uint loSources;
    uint hiSources;
    uint2 gaps[3];
    SigmaBuildSupportedDepthProposal(state, cells[0], cells[1], targetGeometry,
        targetMass, status, conflictMask, loSources, hiSources, gaps);

    uint valid = 1u;
    uint2 geometry[4];
    SigmaGeometryGPlan(state, geometry, valid);
    if ((status & (SIGMA_PROPOSAL_ACCEPTED | SIGMA_PROPOSAL_CHANGED)) ==
        (SIGMA_PROPOSAL_ACCEPTED | SIGMA_PROPOSAL_CHANGED))
    {
        uint2 candidate[16];
        if (SigmaApplyGeometryTargets(state, geometry, targetGeometry,
                candidate, valid) && SigmaStrengthenCandidateMass(candidate,
                geometry[0], targetMass, valid))
        {
            [loop]
            for (uint lane = 0u; lane < 16u; ++lane)
                state[lane] = candidate[lane];
        }
    }
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
        _FixtureStateOut[lane] = state[lane];
    _FixtureResult[0] = uint4(status, conflictMask, loSources, hiSources);
    _FixtureResult[1] = uint4(gaps[0].x, gaps[0].y, gaps[1].x, gaps[1].y);
    _FixtureResult[2] = uint4(gaps[2].x, gaps[2].y, valid, 0u);
}

[numthreads(1, 1, 1)]
void EvaluateNullDepthMeetFixture(uint3 dispatchId : SV_DispatchThreadID)
{
    SigmaDepthCell3 cells[2];
    [unroll]
    for (uint sourceIndex = 0u; sourceIndex < 2u; ++sourceIndex)
    {
        [unroll]
        for (uint fixtureAxis = 0u; fixtureAxis < 3u; ++fixtureAxis)
        {
            cells[sourceIndex].axis[fixtureAxis].lo =
                _FixtureCellBounds[sourceIndex * 6u + fixtureAxis * 2u];
            cells[sourceIndex].axis[fixtureAxis].hi =
                _FixtureCellBounds[sourceIndex * 6u + fixtureAxis * 2u + 1u];
        }
        uint4 metadata = _FixtureCellMeta[sourceIndex];
        cells[sourceIndex].sourceClass = metadata.x;
        cells[sourceIndex].independenceKey = metadata.y;
        cells[sourceIndex].sector = metadata.z;
        cells[sourceIndex].valid = metadata.w;
    }
    uint2 promoted[16];
    bool accepted = SigmaLiftNullDepthMeet(cells[0], cells[1], promoted);
    [unroll]
    for (uint fixtureLane = 0u; fixtureLane < 16u; ++fixtureLane)
        _FixtureStateOut[fixtureLane] = accepted ? promoted[fixtureLane] :
            SIGMA_Q48_ZERO;
    uint valid = 1u;
    uint2 geometry[4];
    if (accepted)
        SigmaGeometryGPlan(promoted, geometry, valid);
    else
    {
        [unroll]
        for (uint geometryRow = 0u; geometryRow < 4u; ++geometryRow)
            geometry[geometryRow] = SIGMA_Q48_ZERO;
    }
    _FixtureResult[0] = uint4(accepted ? 1u : 0u, valid,
        geometry[0].x, geometry[0].y);
    _FixtureResult[1] = 0u;
    _FixtureResult[2] = 0u;
}
