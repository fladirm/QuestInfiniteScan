#pragma kernel ClearInverseFrame
#pragma kernel ClassifyDepthFrame
#pragma kernel CompactActivePages
#pragma kernel BuildDepthProposals
#pragma kernel CommitDepthProposals
#pragma kernel PromoteGaugePage
#pragma kernel EvaluateDepthMeetFixture
#pragma kernel EvaluateNullDepthMeetFixture
#pragma target 5.0

#include "SigmaGeometryReadout.hlsl"
#include "SigmaInverseMath.hlsl"

Texture2DArray<float2> _MetricDepth;
Texture2DArray<uint> _DepthFlags;
Texture2DArray<float2> _PredDepthSupport;
Texture2DArray<uint4> _PredCarrierPage;
Texture2DArray<float4> _PredCarrierUvNormal;
Texture2DArray<uint4> _PredStateKey;
Texture2D<float4> _DepthRayCenterLeft;
Texture2D<float4> _DepthRayCenterRight;

StructuredBuffer<uint2> _CarrierState;
StructuredBuffer<SigmaCarrierPageMetaGpu> _PageMetadata;
StructuredBuffer<uint> _CurrentFlags;
StructuredBuffer<uint> _ActivePageFlagsRead;
StructuredBuffer<uint> _ActivePageSlotsRead;
StructuredBuffer<uint2> _ProposalGeometryRead;
StructuredBuffer<uint2> _ProposalMassRead;
StructuredBuffer<uint> _ProposalStatusRead;

RWStructuredBuffer<uint> _ActivePageFlags;
RWStructuredBuffer<uint> _CommitPageFlags;
RWStructuredBuffer<uint> _UnmatchedBlockFlags;
RWStructuredBuffer<uint> _UnmatchedBlockAnchors;
RWStructuredBuffer<uint> _ActivePageSlots;
RWStructuredBuffer<uint> _ActiveDispatchArgs;
RWStructuredBuffer<uint2> _ProposalGeometry;
RWStructuredBuffer<uint2> _ProposalMass;
RWStructuredBuffer<uint> _ProposalStatus;
RWStructuredBuffer<SigmaDepthConflictGpu> _ConflictRecords;
RWStructuredBuffer<uint> _ConflictCount;
RWStructuredBuffer<uint> _FrameCounters;
RWStructuredBuffer<uint> _GaugePromotionCounts;
RWStructuredBuffer<uint2> _TargetCarrierState;

StructuredBuffer<uint2> _FixtureState;
StructuredBuffer<uint2> _FixtureCellBounds;
StructuredBuffer<uint4> _FixtureCellMeta;
RWStructuredBuffer<uint2> _FixtureStateOut;
RWStructuredBuffer<uint4> _FixtureResult;

uint2 _Resolution;
uint2 _GaugeBlockResolution;
uint _ActiveFlagCount;
uint _BlockFlagCount;
uint _ClearCount;
uint _SegmentCount;
uint _SegmentIndex;
uint _SegmentFlagOffset;
uint _PageCapacity;
uint _ConflictCapacity;
uint _LeftIndependenceKey;
uint _RightIndependenceKey;
uint _TargetPageSlot;
uint _TargetPageCapacity;
uint _SourcePageSlot;
uint _GaugeBlockMask;
uint _GaugeCommitCapacity;
uint _GaugeCommitIndex;
uint2 _GaugePixelOrigin;

float4x4 _WorldFromOpticalLeft;
float4x4 _WorldFromOpticalRight;
float4x4 _OpticalFromWorldLeft;
float4x4 _OpticalFromWorldRight;
float4 _DepthIntrinsicsLeft;
float4 _DepthIntrinsicsRight;

groupshared uint SigmaActiveScan[256];

bool SigmaPredictionHasContact(uint2 pixel, uint eye)
{
    return _PredDepthSupport[uint3(pixel, eye)].y > 0.0 &&
        _PredStateKey[uint3(pixel, eye)].x != 0u;
}

bool SigmaProjectWorldToPixel(float3 worldPosition, uint eye, out uint2 pixel,
    out float3 opticalPosition)
{
    float4x4 opticalFromWorld = eye == 0u
        ? _OpticalFromWorldLeft : _OpticalFromWorldRight;
    float4 intrinsics = eye == 0u ? _DepthIntrinsicsLeft : _DepthIntrinsicsRight;
    opticalPosition = mul(opticalFromWorld, float4(worldPosition, 1.0)).xyz;
    if (!all(isfinite(opticalPosition)) || opticalPosition.z <= 1e-6)
    {
        pixel = 0u;
        return false;
    }
    float2 projected = opticalPosition.xy / opticalPosition.z * intrinsics.xy +
        intrinsics.zw;
    int2 candidate = int2(floor(projected));
    if (any(candidate < 0) || any(candidate >= (int2)_Resolution))
    {
        pixel = 0u;
        return false;
    }
    pixel = (uint2)candidate;
    return true;
}

float3 SigmaDepthWorldPointCandidate(uint eye, uint2 pixel, float range)
{
    float3 ray = eye == 0u
        ? _DepthRayCenterLeft[pixel].xyz
        : _DepthRayCenterRight[pixel].xyz;
    float4x4 worldFromOptical = eye == 0u
        ? _WorldFromOpticalLeft : _WorldFromOpticalRight;
    return mul(worldFromOptical, float4(ray * range, 1.0)).xyz;
}

uint SigmaFirstHitSectorForPixel(uint eye, uint2 pixel,
    SigmaQ48Bounds measuredRange, uint2 measuredRangeCenter,
    uint2 measuredHalfWidth, inout uint valid)
{
    float2 prediction = _PredDepthSupport[uint3(pixel, eye)];
    SigmaQ48Bounds rebuiltMeasured;
    SigmaQ48Bounds predicted;
    uint sector = SigmaClassifyFirstHitExact(measuredRangeCenter,
        measuredHalfWidth, prediction, rebuiltMeasured, predicted, valid);
    if (valid == 0u || !SigmaU64Equal(rebuiltMeasured.lo, measuredRange.lo) ||
        !SigmaU64Equal(rebuiltMeasured.hi, measuredRange.hi))
        return SIGMA_SECTOR_NO_CONSTRAINT;
    return sector;
}

bool SigmaPredictionMatchesSample(uint eye, uint2 pixel,
    SigmaCarrierPageMetaGpu metadata, uint pageSlot, uint sample)
{
    uint3 address = uint3(pixel, eye);
    uint4 key = _PredStateKey[address];
    uint4 page = _PredCarrierPage[address];
    if (key.x != metadata.generation || key.z != _SegmentIndex ||
        key.w != pageSlot || page.x != metadata.pageXLo ||
        page.y != metadata.pageXHi || page.z != metadata.pageYLo ||
        page.w != metadata.pageYHi)
        return false;
    float2 uv = _PredCarrierUvNormal[address].xy;
    float2 local = float2(sample & 63u, sample >> 6u);
    return all(abs(uv - local) <= 1.75);
}

bool SigmaBuildMatchedEyeCell(uint eye, float3 worldPosition,
    SigmaCarrierPageMetaGpu metadata, uint pageSlot, uint sample,
    out SigmaDepthCell3 cell)
{
    cell = (SigmaDepthCell3)0;
    uint2 pixel;
    float3 optical;
    if (!SigmaProjectWorldToPixel(worldPosition, eye, pixel, optical) ||
        !SigmaPredictionMatchesSample(eye, pixel, metadata, pageSlot, sample) ||
        (_DepthFlags[uint3(pixel, eye)] & 1u) == 0u)
        return false;

    float2 metric = _MetricDepth[uint3(pixel, eye)];
    SigmaQ48Bounds measuredRange;
    uint source = eye == 0u ? SIGMA_SOURCE_DEPTH_LEFT :
        SIGMA_SOURCE_DEPTH_RIGHT;
    uint key = eye == 0u ? _LeftIndependenceKey : _RightIndependenceKey;
    if (!SigmaBuildDepthWorldCell(eye, pixel, metric, source, key, cell,
            measuredRange))
        return false;
    uint valid = 1u;
    uint2 range = SigmaQ48FromFloatNearestEven(metric.x, valid);
    uint2 halfWidth = SigmaDepthHalfWidth(eye, range, valid);
    cell.sector = SigmaFirstHitSectorForPixel(eye, pixel, measuredRange,
        range, halfWidth, valid);
    cell.valid = valid;
    return valid != 0u;
}

void SigmaAppendEvidence(SigmaCarrierPageMetaGpu metadata, uint sample,
    uint sectorMask, uint conflictMask, uint loSources, uint hiSources,
    uint2 gaps[3])
{
    uint recordIndex;
    InterlockedAdd(_ConflictCount[0], 1u, recordIndex);
    if (recordIndex >= _ConflictCapacity)
        return;
    SigmaDepthConflictGpu record;
    record.carrierPage = uint4(metadata.pageXLo, metadata.pageXHi,
        metadata.pageYLo, metadata.pageYHi);
    record.stateAndSector = uint4(metadata.generation, sample, sectorMask,
        conflictMask);
    record.provenance = uint4(loSources, hiSources,
        _LeftIndependenceKey, _RightIndependenceKey);
    record.gapX = gaps[0];
    record.gapY = gaps[1];
    record.gapZ = gaps[2];
    _ConflictRecords[recordIndex] = record;
}

[numthreads(64, 1, 1)]
void ClearInverseFrame(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index < _ActiveFlagCount)
    {
        _ActivePageFlags[index] = 0u;
        _CommitPageFlags[index] = 0u;
    }
    if (index < _BlockFlagCount)
    {
        _UnmatchedBlockFlags[index] = 0u;
        _UnmatchedBlockAnchors[index] = 0xffffffffu;
    }
    if (index == 0u)
        _ConflictCount[0] = 0u;
    if (index < SIGMA_COUNTER_COUNT)
        _FrameCounters[index] = 0u;
    if (index < _GaugeCommitCapacity)
        _GaugePromotionCounts[index] = 0u;
}

[numthreads(8, 8, 1)]
void ClassifyDepthFrame(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _Resolution) || id.z >= 2u)
        return;
    uint eye = id.z;
    uint3 address = uint3(id.xy, eye);
    float2 prediction = _PredDepthSupport[address];
    uint4 stateKey = _PredStateKey[address];
    if (prediction.y > 0.0 && stateKey.x != 0u &&
        stateKey.z < _SegmentCount && stateKey.w < 256u)
    {
        uint globalPage = stateKey.z * 256u + stateKey.w;
        if (globalPage < _ActiveFlagCount)
            InterlockedOr(_ActivePageFlags[globalPage], 1u);
    }

    if (eye != 0u || (_DepthFlags[address] & 1u) == 0u)
        return;
    float2 leftMetric = _MetricDepth[address];
    uint valid = 1u;
    uint2 leftRange = SigmaQ48FromFloatNearestEven(leftMetric.x, valid);
    uint2 leftWidth = SigmaDepthHalfWidth(0u, leftRange, valid);
    SigmaQ48Bounds measured;
    SigmaQ48Bounds predicted;
    uint sector = SigmaClassifyFirstHitExact(leftRange, leftWidth, prediction,
        measured, predicted, valid);
    bool novelLeft = valid != 0u &&
        (!(prediction.y > 0.0) || sector == SIGMA_SECTOR_NO_CONSTRAINT);
    if (!novelLeft)
        return;

    float3 world = SigmaDepthWorldPointCandidate(0u, id.xy, leftMetric.x);
    uint2 rightPixel;
    float3 rightOptical;
    if (!SigmaProjectWorldToPixel(world, 1u, rightPixel, rightOptical) ||
        (_DepthFlags[uint3(rightPixel, 1u)] & 1u) == 0u)
        return;
    float2 rightMetric = _MetricDepth[uint3(rightPixel, 1u)];
    float expectedRightRange = length(rightOptical);
    float candidateWidth = 0.006 + 0.006 *
        max(leftMetric.x * leftMetric.x, rightMetric.x * rightMetric.x);
    if (abs(rightMetric.x - expectedRightRange) > candidateWidth)
        return;
    float2 rightPrediction = _PredDepthSupport[uint3(rightPixel, 1u)];
    uint2 rightRange = SigmaQ48FromFloatNearestEven(rightMetric.x, valid);
    uint2 rightWidth = SigmaDepthHalfWidth(1u, rightRange, valid);
    uint rightSector = SigmaClassifyFirstHitExact(rightRange, rightWidth,
        rightPrediction, measured, predicted, valid);
    if (valid == 0u || (rightPrediction.y > 0.0 &&
        rightSector != SIGMA_SECTOR_NO_CONSTRAINT))
        return;

    uint2 block = id.xy >> 5u;
    if (any(block >= _GaugeBlockResolution))
        return;
    uint blockIndex = block.y * _GaugeBlockResolution.x + block.x;
    uint previous;
    InterlockedOr(_UnmatchedBlockFlags[blockIndex], 1u, previous);
    if (previous == 0u)
        InterlockedAdd(_FrameCounters[SIGMA_COUNTER_UNMATCHED_BLOCKS], 1u);

    // Gauge allocation prefers an existing carrier neighbour but the image
    // neighbourhood is only a scheduling hint: no topology or geometry is
    // inferred from it. The exact promotion gate below remains authoritative.
    uint anchor = 0xffffffffu;
    [unroll]
    for (int offsetY = -1; offsetY <= 1; ++offsetY)
    {
        [unroll]
        for (int offsetX = -1; offsetX <= 1; ++offsetX)
        {
            if (offsetX == 0 && offsetY == 0)
                continue;
            int2 neighbour = int2(id.xy) + int2(offsetX, offsetY);
            if (any(neighbour < 0) || any(neighbour >= (int2)_Resolution))
                continue;
            uint4 key = _PredStateKey[uint3((uint2)neighbour, 0u)];
            if (key.x == 0u || key.z >= _SegmentCount || key.w >= 256u)
                continue;
            anchor = min(anchor, key.z * 256u + key.w);
        }
    }
    if (anchor != 0xffffffffu)
        InterlockedMin(_UnmatchedBlockAnchors[blockIndex], anchor);
}

[numthreads(256, 1, 1)]
void CompactActivePages(uint3 groupThreadId : SV_GroupThreadID)
{
    uint lane = groupThreadId.x;
    uint active = lane < _PageCapacity &&
        _ActivePageFlagsRead[_SegmentFlagOffset + lane] != 0u ? 1u : 0u;
    SigmaActiveScan[lane] = active;
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint offset = 1u; offset < 256u; offset <<= 1u)
    {
        uint addend = lane >= offset ? SigmaActiveScan[lane - offset] : 0u;
        GroupMemoryBarrierWithGroupSync();
        SigmaActiveScan[lane] += addend;
        GroupMemoryBarrierWithGroupSync();
    }
    if (active != 0u)
        _ActivePageSlots[SigmaActiveScan[lane] - 1u] = lane;
    if (lane == 0u)
    {
        uint count = SigmaActiveScan[255u];
        _ActiveDispatchArgs[0] = 64u;
        _ActiveDispatchArgs[1] = count;
        _ActiveDispatchArgs[2] = 1u;
        InterlockedAdd(_FrameCounters[SIGMA_COUNTER_ACTIVE_PAGES], count);
    }
}

[numthreads(64, 1, 1)]
void BuildDepthProposals(uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint pageSlot = _ActivePageSlotsRead[groupId.y];
    uint sample = groupId.x * 64u + groupThreadId.x;
    if (pageSlot >= _PageCapacity || sample >= SIGMA_PAGE_SAMPLE_COUNT ||
        _CurrentFlags[pageSlot] == 0u)
        return;
    uint proposalIndex = pageSlot * SIGMA_PAGE_SAMPLE_COUNT + sample;
    _ProposalStatus[proposalIndex] = 0u;
    _ProposalMass[proposalIndex] = SIGMA_Q48_ZERO;
    [unroll]
    for (uint axis = 0u; axis < 3u; ++axis)
        _ProposalGeometry[proposalIndex * 3u + axis] = SIGMA_Q48_ZERO;

    SigmaCarrierPageMetaGpu metadata = _PageMetadata[pageSlot];
    if ((metadata.flags & SIGMA_PAGE_PUBLISHED) == 0u)
        return;
    uint stateBase = pageSlot * SIGMA_PAGE_LANE_COUNT +
        sample * SIGMA_LANE_COUNT;
    uint2 state[16];
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
        state[lane] = _CarrierState[stateBase + lane];
    float3 worldPosition;
    float mass;
    if (!SigmaGeometryReadoutPlan(state, worldPosition, mass))
        return;

    SigmaDepthCell3 left;
    SigmaDepthCell3 right;
    SigmaBuildMatchedEyeCell(0u, worldPosition, metadata, pageSlot, sample, left);
    SigmaBuildMatchedEyeCell(1u, worldPosition, metadata, pageSlot, sample, right);
    uint sectorMask = (left.sector & 3u) | ((right.sector & 3u) << 2u);
    uint2 zeroGaps[3];
    [unroll]
    for (uint axis = 0u; axis < 3u; ++axis)
        zeroGaps[axis] = SIGMA_Q48_ZERO;
    if ((left.valid != 0u && left.sector == SIGMA_SECTOR_PRE_HIT_EXCLUSION) ||
        (right.valid != 0u && right.sector == SIGMA_SECTOR_PRE_HIT_EXCLUSION))
    {
        _ProposalStatus[proposalIndex] = SIGMA_PROPOSAL_EXCLUSION;
        SigmaAppendEvidence(metadata, sample, sectorMask, 0u, 0u, 0u,
            zeroGaps);
        InterlockedAdd(_FrameCounters[SIGMA_COUNTER_EXCLUSIONS], 1u);
        return;
    }

    uint2 targetGeometry[3];
    uint2 targetMass;
    uint status;
    uint conflictMask;
    uint loSources;
    uint hiSources;
    uint2 gaps[3];
    bool accepted = SigmaBuildSupportedDepthProposal(state, left, right,
        targetGeometry, targetMass, status, conflictMask, loSources, hiSources,
        gaps);
    _ProposalStatus[proposalIndex] = status;
    _ProposalMass[proposalIndex] = targetMass;
    [unroll]
    for (uint axis = 0u; axis < 3u; ++axis)
        _ProposalGeometry[proposalIndex * 3u + axis] = targetGeometry[axis];
    if ((status & (SIGMA_PROPOSAL_HIT_LEFT | SIGMA_PROPOSAL_HIT_RIGHT)) != 0u)
        InterlockedAdd(_FrameCounters[SIGMA_COUNTER_HIT_SAMPLES], 1u);
    if ((status & SIGMA_PROPOSAL_CONFLICT) != 0u)
    {
        SigmaAppendEvidence(metadata, sample, sectorMask, conflictMask,
            loSources, hiSources, gaps);
        InterlockedAdd(_FrameCounters[SIGMA_COUNTER_EMPTY_MEETS], 1u);
    }
    if (accepted && (status & SIGMA_PROPOSAL_CHANGED) != 0u)
    {
        _CommitPageFlags[_SegmentFlagOffset + pageSlot] = 1u;
        InterlockedAdd(_FrameCounters[SIGMA_COUNTER_CHANGED_SAMPLES], 1u);
    }
}

[numthreads(64, 1, 1)]
void CommitDepthProposals(uint3 dispatchId : SV_DispatchThreadID)
{
    uint sample = dispatchId.x;
    if (!SigmaCanonicalMutationEnabled() || sample >= SIGMA_PAGE_SAMPLE_COUNT ||
        _TargetPageSlot >= _TargetPageCapacity)
        return;
    uint proposalIndex = _SourcePageSlot * SIGMA_PAGE_SAMPLE_COUNT + sample;
    uint status = _ProposalStatusRead[proposalIndex];
    if ((status & (SIGMA_PROPOSAL_ACCEPTED | SIGMA_PROPOSAL_CHANGED)) !=
        (SIGMA_PROPOSAL_ACCEPTED | SIGMA_PROPOSAL_CHANGED))
        return;

    uint targetBase = _TargetPageSlot * SIGMA_PAGE_LANE_COUNT +
        sample * SIGMA_LANE_COUNT;
    uint2 state[16];
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
        state[lane] = _TargetCarrierState[targetBase + lane];
    uint valid = 1u;
    uint2 geometry[4];
    SigmaGeometryGPlan(state, geometry, valid);
    uint2 targetGeometry[3];
    SigmaQ48Bounds accepted[3];
    uint2 oneLsb = uint2(1u, 0u);
    [unroll]
    for (uint axis = 0u; axis < 3u; ++axis)
    {
        targetGeometry[axis] = _ProposalGeometryRead[
            proposalIndex * 3u + axis];
        uint2 coordinate = SigmaQ48DivNearestEven(targetGeometry[axis],
            geometry[0], valid);
        accepted[axis].lo = SigmaQ48SubChecked(coordinate, oneLsb, valid);
        accepted[axis].hi = SigmaQ48AddChecked(coordinate, oneLsb, valid);
    }
    uint2 candidate[16];
    uint2 targetMass = _ProposalMassRead[proposalIndex];
    if (!SigmaApplyGeometryTargets(state, geometry, targetGeometry, candidate,
            valid) || !SigmaStrengthenCandidateMass(candidate, geometry[0],
            targetMass, valid) || !SigmaRevalidateGeometryCandidate(candidate,
            targetMass, accepted, valid))
        return;
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
        _TargetCarrierState[targetBase + lane] = candidate[lane];
}

[numthreads(8, 8, 1)]
void PromoteGaugePage(uint3 id : SV_DispatchThreadID)
{
    if (!SigmaCanonicalMutationEnabled() || any(id.xy >= 64u) ||
        _TargetPageSlot >= _TargetPageCapacity)
        return;
    uint2 quadrant = id.xy >> 5u;
    uint quadrantBit = 1u << (quadrant.y * 2u + quadrant.x);
    if ((_GaugeBlockMask & quadrantBit) == 0u)
        return;
    uint2 leftPixel = _GaugePixelOrigin + id.xy;
    if (any(leftPixel >= _Resolution) ||
        (_DepthFlags[uint3(leftPixel, 0u)] & 1u) == 0u)
        return;
    float2 leftMetric = _MetricDepth[uint3(leftPixel, 0u)];
    SigmaDepthCell3 left;
    SigmaQ48Bounds leftRangeBounds;
    if (!SigmaBuildDepthWorldCell(0u, leftPixel, leftMetric,
            SIGMA_SOURCE_DEPTH_LEFT, _LeftIndependenceKey, left,
            leftRangeBounds))
        return;
    uint valid = 1u;
    uint2 leftRange = SigmaQ48FromFloatNearestEven(leftMetric.x, valid);
    uint2 leftWidth = SigmaDepthHalfWidth(0u, leftRange, valid);
    SigmaQ48Bounds ignored;
    uint leftSector = SigmaClassifyFirstHitExact(leftRange, leftWidth,
        _PredDepthSupport[uint3(leftPixel, 0u)], leftRangeBounds, ignored, valid);
    bool leftNovel = valid != 0u &&
        (!SigmaPredictionHasContact(leftPixel, 0u) ||
         leftSector == SIGMA_SECTOR_NO_CONSTRAINT);
    if (!leftNovel)
        return;

    float3 world = SigmaDepthWorldPointCandidate(0u, leftPixel, leftMetric.x);
    uint2 rightPixel;
    float3 rightOptical;
    if (!SigmaProjectWorldToPixel(world, 1u, rightPixel, rightOptical) ||
        (_DepthFlags[uint3(rightPixel, 1u)] & 1u) == 0u)
        return;
    float2 rightMetric = _MetricDepth[uint3(rightPixel, 1u)];
    SigmaDepthCell3 right;
    SigmaQ48Bounds rightRangeBounds;
    if (!SigmaBuildDepthWorldCell(1u, rightPixel, rightMetric,
            SIGMA_SOURCE_DEPTH_RIGHT, _RightIndependenceKey, right,
            rightRangeBounds))
        return;
    uint2 rightRange = SigmaQ48FromFloatNearestEven(rightMetric.x, valid);
    uint2 rightWidth = SigmaDepthHalfWidth(1u, rightRange, valid);
    uint rightSector = SigmaClassifyFirstHitExact(rightRange, rightWidth,
        _PredDepthSupport[uint3(rightPixel, 1u)], rightRangeBounds, ignored, valid);
    bool rightNovel = valid != 0u &&
        (!SigmaPredictionHasContact(rightPixel, 1u) ||
         rightSector == SIGMA_SECTOR_NO_CONSTRAINT);
    if (!rightNovel)
        return;

    uint2 promoted[16];
    if (!SigmaLiftNullDepthMeet(left, right, promoted))
        return;
    uint sample = id.y * 64u + id.x;
    uint targetBase = _TargetPageSlot * SIGMA_PAGE_LANE_COUNT +
        sample * SIGMA_LANE_COUNT;
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
        _TargetCarrierState[targetBase + lane] = promoted[lane];
    if (_GaugeCommitIndex < _GaugeCommitCapacity)
        InterlockedAdd(_GaugePromotionCounts[_GaugeCommitIndex], 1u);
}

[numthreads(1, 1, 1)]
void EvaluateDepthMeetFixture(uint3 dispatchId : SV_DispatchThreadID)
{
    uint2 state[16];
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
        state[lane] = _FixtureState[lane];
    SigmaDepthCell3 cells[2];
    [unroll]
    for (uint sourceIndex = 0u; sourceIndex < 2u; ++sourceIndex)
    {
        [unroll]
        for (uint axis = 0u; axis < 3u; ++axis)
        {
            cells[sourceIndex].axis[axis].lo =
                _FixtureCellBounds[sourceIndex * 6u + axis * 2u];
            cells[sourceIndex].axis[axis].hi =
                _FixtureCellBounds[sourceIndex * 6u + axis * 2u + 1u];
        }
        uint4 metadata = _FixtureCellMeta[sourceIndex];
        cells[sourceIndex].sourceClass = metadata.x;
        cells[sourceIndex].independenceKey = metadata.y;
        cells[sourceIndex].sector = metadata.z;
        cells[sourceIndex].valid = metadata.w;
    }
    uint2 targetGeometry[3];
    uint2 targetMass;
    uint status;
    uint conflictMask;
    uint loSources;
    uint hiSources;
    uint2 gaps[3];
    SigmaBuildSupportedDepthProposal(state, cells[0], cells[1], targetGeometry,
        targetMass, status, conflictMask, loSources, hiSources, gaps);

    uint valid = 1u;
    uint2 geometry[4];
    SigmaGeometryGPlan(state, geometry, valid);
    if ((status & (SIGMA_PROPOSAL_ACCEPTED | SIGMA_PROPOSAL_CHANGED)) ==
        (SIGMA_PROPOSAL_ACCEPTED | SIGMA_PROPOSAL_CHANGED))
    {
        uint2 candidate[16];
        if (SigmaApplyGeometryTargets(state, geometry, targetGeometry,
                candidate, valid) && SigmaStrengthenCandidateMass(candidate,
                geometry[0], targetMass, valid))
        {
            [loop]
            for (uint lane = 0u; lane < 16u; ++lane)
                state[lane] = candidate[lane];
        }
    }
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
        _FixtureStateOut[lane] = state[lane];
    _FixtureResult[0] = uint4(status, conflictMask, loSources, hiSources);
    _FixtureResult[1] = uint4(gaps[0].x, gaps[0].y, gaps[1].x, gaps[1].y);
    _FixtureResult[2] = uint4(gaps[2].x, gaps[2].y, valid, 0u);
}

[numthreads(1, 1, 1)]
void EvaluateNullDepthMeetFixture(uint3 dispatchId : SV_DispatchThreadID)
{
    SigmaDepthCell3 cells[2];
    [unroll]
    for (uint sourceIndex = 0u; sourceIndex < 2u; ++sourceIndex)
    {
        [unroll]
        for (uint fixtureAxis = 0u; fixtureAxis < 3u; ++fixtureAxis)
        {
            cells[sourceIndex].axis[fixtureAxis].lo =
                _FixtureCellBounds[sourceIndex * 6u + fixtureAxis * 2u];
            cells[sourceIndex].axis[fixtureAxis].hi =
                _FixtureCellBounds[sourceIndex * 6u + fixtureAxis * 2u + 1u];
        }
        uint4 metadata = _FixtureCellMeta[sourceIndex];
        cells[sourceIndex].sourceClass = metadata.x;
        cells[sourceIndex].independenceKey = metadata.y;
        cells[sourceIndex].sector = metadata.z;
        cells[sourceIndex].valid = metadata.w;
    }
    uint2 promoted[16];
    bool accepted = SigmaLiftNullDepthMeet(cells[0], cells[1], promoted);
    [unroll]
    for (uint fixtureLane = 0u; fixtureLane < 16u; ++fixtureLane)
        _FixtureStateOut[fixtureLane] = accepted ? promoted[fixtureLane] :
            SIGMA_Q48_ZERO;
    uint valid = 1u;
    uint2 geometry[4];
    if (accepted)
        SigmaGeometryGPlan(promoted, geometry, valid);
    else
    {
        [unroll]
        for (uint geometryRow = 0u; geometryRow < 4u; ++geometryRow)
            geometry[geometryRow] = SIGMA_Q48_ZERO;
    }
    _FixtureResult[0] = uint4(accepted ? 1u : 0u, valid,
        geometry[0].x, geometry[0].y);
    _FixtureResult[1] = 0u;
    _FixtureResult[2] = 0u;
}
