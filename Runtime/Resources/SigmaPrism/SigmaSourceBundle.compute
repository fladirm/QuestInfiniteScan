#pragma kernel CopySealedBundleMetadata
#pragma kernel ExtractSealedBundleSamples
#pragma target 5.0

#include "SigmaGeometryReadout.hlsl"
#include "SigmaConstraintLedgerAbi.hlsl"
#include "SigmaInverseWorkAbi.hlsl"
#include "SigmaPoseConsume.hlsl"

// This file is the sole transient-to-owned ingress boundary.  It may sample the
// current capture and prediction textures, but every surviving transaction reads
// only the copied raw/calibration/provenance/association arenas below.

Texture2DArray<float2> _MetricDepth;
Texture2DArray<uint> _DepthFlags;
Texture2DArray<float2> _PredDepthSupport;
Texture2DArray<uint4> _PredCarrierPage;
Texture2DArray<float4> _PredCarrierUvNormal;
Texture2DArray<uint4> _PredStateKey;
Texture2D<float4> _DepthRayCenterLeft;
Texture2D<float4> _RgbLeft;
Texture2D<float4> _RgbRight;

StructuredBuffer<uint2> _CarrierState;
StructuredBuffer<SigmaCarrierPageMetaGpu> _PageMetadata;
StructuredBuffer<uint2> _DepthCalibrationQ48;
StructuredBuffer<uint2> _RgbCalibrationQ48;
StructuredBuffer<SigmaRawFrameRecordGpu> _RawFrameStaging;
StructuredBuffer<SigmaStreamWorkItemGpu> _StreamWorkItems;
StructuredBuffer<uint> _StreamWorkCounts;
StructuredBuffer<SigmaProbationGpu> _StreamProbation;

RWStructuredBuffer<SigmaSealedSourceBundleGpu> _StreamBundles;
RWStructuredBuffer<uint2> _StreamBundleCalibration;
RWStructuredBuffer<uint> _StreamBundleRayEpoch;
RWStructuredBuffer<SigmaAssociationSampleGpu> _StreamAssociation;
RWStructuredBuffer<uint4> _RawWords;
RWStructuredBuffer<SigmaRawFrameRecordGpu> _RawFrameRecords;

uint2 _Resolution;
uint _PageCapacity;

float4x4 _WorldFromOpticalLeft;
float4x4 _OpticalFromWorldLeft;
float4x4 _OpticalFromWorldRight;
float4 _DepthIntrinsicsLeft;
float4 _DepthIntrinsicsRight;

float4x4 _RgbOpticalFromWorldLeft;
float4x4 _RgbOpticalFromWorldRight;
float4 _RgbIntrinsicsLeft;
float4 _RgbIntrinsicsRight;
uint2 _RgbResolutionLeft;
uint2 _RgbResolutionRight;

uint SigmaBundlePackPixel(uint2 pixel)
{
    return (pixel.x & 0xffffu) | ((pixel.y & 0xffffu) << 16u);
}

uint SigmaBundlePackUnorm4x8(float4 colour)
{
    uint4 value = (uint4)round(saturate(colour) * 255.0);
    return value.x | (value.y << 8u) | (value.z << 16u) |
        (value.w << 24u);
}

bool SigmaBundleProjectDepth(float3 worldPosition, uint eye,
    out uint2 pixel, out float range)
{
    float4x4 opticalFromWorld = eye == 0u
        ? _OpticalFromWorldLeft : _OpticalFromWorldRight;
    float4 intrinsics = eye == 0u
        ? _DepthIntrinsicsLeft : _DepthIntrinsicsRight;
    float3 rawWorld = SigmaPoseUnapplyWorld(worldPosition);
    float3 optical = mul(opticalFromWorld, float4(rawWorld, 1.0)).xyz;
    if (!all(isfinite(optical)) || optical.z <= 1e-6)
    {
        pixel = 0u;
        range = 0.0;
        return false;
    }
    float2 projected = optical.xy / optical.z * intrinsics.xy +
        intrinsics.zw;
    int2 integerPixel = int2(floor(projected));
    if (any(integerPixel < 0) || any(integerPixel >= (int2)_Resolution))
    {
        pixel = 0u;
        range = 0.0;
        return false;
    }
    pixel = (uint2)integerPixel;
    range = length(optical);
    return true;
}

bool SigmaBundleProjectRgb(float3 rawWorldPosition, uint eye,
    out float2 pixel)
{
    float4x4 opticalFromWorld = eye == 0u
        ? _RgbOpticalFromWorldLeft : _RgbOpticalFromWorldRight;
    float4 intrinsics = eye == 0u
        ? _RgbIntrinsicsLeft : _RgbIntrinsicsRight;
    uint2 resolution = eye == 0u
        ? _RgbResolutionLeft : _RgbResolutionRight;
    float3 optical = mul(opticalFromWorld,
        float4(rawWorldPosition, 1.0)).xyz;
    if (!all(isfinite(optical)) || optical.z <= 1e-6)
    {
        pixel = 0.0;
        return false;
    }
    pixel = optical.xy / optical.z * intrinsics.xy + intrinsics.zw;
    return all(pixel >= 0.5) && all(pixel <= (float2)resolution - 1.5);
}

float4 SigmaBundleLoadRgb(uint eye, int2 pixel)
{
    return eye == 0u ? _RgbLeft.Load(int3(pixel, 0)) :
        _RgbRight.Load(int3(pixel, 0));
}

float3 SigmaBundleGaugeWorld(uint2 leftPixel, float range)
{
    float3 ray = _DepthRayCenterLeft[leftPixel].xyz;
    float3 rawWorld = mul(_WorldFromOpticalLeft,
        float4(ray * range, 1.0)).xyz;
    return SigmaPoseApplyWorld(rawWorld);
}

bool SigmaBundleMatchedWorld(uint sourcePage, uint sample,
    out float3 worldPosition, out float informationMass)
{
    worldPosition = 0.0;
    informationMass = 0.0;
    if (sourcePage >= _PageCapacity)
        return false;
    uint baseAddress = sourcePage * SIGMA_PAGE_LANE_COUNT +
        sample * SIGMA_LANE_COUNT;
    uint2 state[16];
    [unroll]
    for (uint lane = 0u; lane < 16u; ++lane)
        state[lane] = _CarrierState[baseAddress + lane];
    return SigmaGeometryReadoutPlan(state, worldPosition, informationMass);
}

uint SigmaBundleDormantAnchor(SigmaSealedSourceBundleGpu bundle)
{
    uint selected = SIGMA_STREAM_INVALID;
    uint2 selectedTicket = uint2(0xffffffffu, 0xffffffffu);
    [loop]
    for (uint slot = 0u; slot < SIGMA_STREAM_BUNDLE_CAPACITY; ++slot)
    {
        SigmaProbationGpu probation = _StreamProbation[slot];
        if (probation.identity.x != SIGMA_STREAM_PROBATION_SEALED ||
            probation.identity.z != slot || probation.identity.w == 0u ||
            probation.support.z != bundle.calibration.w ||
            (probation.bundleHandles.w & bundle.raw.w) == 0u)
            continue;
        uint target = probation.bundleHandles.x;
        if (target >= _PageCapacity)
            continue;
        SigmaCarrierPageMetaGpu metadata = _PageMetadata[target];
        bool retainedCandidate = metadata.flags == SIGMA_PAGE_ALLOCATED &&
            metadata.generation == probation.bundleHandles.y;
        if (!retainedCandidate)
            continue;
        uint2 ticket = probation.support.xy;
        if (selected == SIGMA_STREAM_INVALID ||
            SigmaStreamTicketLess(ticket, selectedTicket) ||
            (SigmaStreamTicketEqual(ticket, selectedTicket) && slot < selected))
        {
            selected = slot;
            selectedTicket = ticket;
        }
    }
    return selected;
}

void SigmaBundleCaptureCandidateAssociation(uint eye, uint2 pixel,
    float predictedRange, float support, SigmaCarrierPageMetaGpu metadata,
    uint sourcePage, uint sample,
    inout SigmaAssociationSampleGpu association)
{
    uint4 depthPage = uint4(asuint(predictedRange), asuint(support),
        metadata.pageXLo, metadata.pageXHi);
    uint4 stateUv = uint4(metadata.pageYLo, metadata.pageYHi,
        asuint((float)(sample & 63u)), asuint((float)(sample >> 6u)));
    uint4 generation = uint4(metadata.generation, metadata.revision, 0u,
        sourcePage);
    if (eye == 0u)
    {
        association.leftDepthPage = depthPage;
        association.leftStateUv = stateUv;
        association.leftGeneration = generation;
    }
    else
    {
        association.rightDepthPage = depthPage;
        association.rightStateUv = stateUv;
        association.rightGeneration = generation;
    }
}

uint4 SigmaBundleCaptureDepth(uint eye, uint2 pixel)
{
    if (any(pixel >= _Resolution) ||
        (_DepthFlags[uint3(pixel, eye)] & 1u) == 0u)
        return uint4(0xffffffffu, 0u, 0u, 0u);
    float2 metric = _MetricDepth[uint3(pixel, eye)];
    if (!(metric.x > 0.0) || !(metric.y > 0.0) || !all(isfinite(metric)))
        return uint4(0xffffffffu, 0u, 0u, 0u);
    return uint4(SigmaBundlePackPixel(pixel), asuint(metric.x),
        asuint(metric.y), 1u);
}

void SigmaBundleCaptureRgb(uint eye, float3 worldPosition,
    out uint4 first, out uint4 second)
{
    first = uint4(0xffffffffu, 0xffffffffu, 0u, 0u);
    second = 0u;
    float2 projected;
    float3 rawWorld = SigmaPoseUnapplyWorld(worldPosition);
    if (!SigmaBundleProjectRgb(rawWorld, eye, projected))
        return;
    int2 p00 = int2(floor(projected - 0.5));
    float4 c00 = SigmaBundleLoadRgb(eye, p00);
    float4 c10 = SigmaBundleLoadRgb(eye, p00 + int2(1, 0));
    float4 c01 = SigmaBundleLoadRgb(eye, p00 + int2(0, 1));
    float4 c11 = SigmaBundleLoadRgb(eye, p00 + int2(1, 1));
    if (!all(isfinite(c00)) || !all(isfinite(c10)) ||
        !all(isfinite(c01)) || !all(isfinite(c11)))
        return;
    first = uint4(asuint(projected.x), asuint(projected.y),
        SigmaBundlePackUnorm4x8(c00), SigmaBundlePackUnorm4x8(c10));
    second = uint4(SigmaBundlePackUnorm4x8(c01),
        SigmaBundlePackUnorm4x8(c11), 1u, eye);
}

void SigmaBundleCaptureAssociation(uint eye, uint2 pixel,
    inout SigmaAssociationSampleGpu association)
{
    uint4 depthPage = 0u;
    uint4 stateUv = 0u;
    uint4 generation = 0u;
    if (all(pixel < _Resolution))
    {
        float2 depthSupport = _PredDepthSupport[uint3(pixel, eye)];
        uint4 page = _PredCarrierPage[uint3(pixel, eye)];
        float2 uv = _PredCarrierUvNormal[uint3(pixel, eye)].xy;
        uint4 key = _PredStateKey[uint3(pixel, eye)];
        depthPage = uint4(asuint(depthSupport.x),
            asuint(depthSupport.y), page.x, page.y);
        stateUv = uint4(page.z, page.w, asuint(uv.x), asuint(uv.y));
        generation = key;
    }
    if (eye == 0u)
    {
        association.leftDepthPage = depthPage;
        association.leftStateUv = stateUv;
        association.leftGeneration = generation;
    }
    else
    {
        association.rightDepthPage = depthPage;
        association.rightStateUv = stateUv;
        association.rightGeneration = generation;
    }
}

// One group per selected bundle.  This pass closes all immutable metadata before
// sample extraction.  Matched logical coordinates are copied here rather than in
// admission so the bounded admission kernel stays within Quest's eight-UAV gate.
[numthreads(128, 1, 1)]
void CopySealedBundleMetadata(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint workIndex = groupId.y;
    uint count = _StreamWorkCounts[SIGMA_STREAM_OPCODE_EXTRACT_BUNDLE];
    if (workIndex >= count)
        return;
    SigmaStreamWorkItemGpu work = _StreamWorkItems[SigmaStreamWorkAddress(
        SIGMA_STREAM_OPCODE_EXTRACT_BUNDLE, workIndex)];
    if (work.identity.x != SIGMA_STREAM_OPCODE_EXTRACT_BUNDLE)
        return;
    uint bundleSlot = work.identity.y;
    if (bundleSlot >= SIGMA_STREAM_BUNDLE_CAPACITY)
        return;
    SigmaSealedSourceBundleGpu bundle = _StreamBundles[bundleSlot];
    if (SigmaStreamBundleGeneration(bundle) != work.identity.z ||
        SigmaStreamBundleState(bundle) != SIGMA_STREAM_BUNDLE_EXTRACTING)
        return;

    uint lane = threadId.x;
    if (lane < SIGMA_STREAM_CALIBRATION_Q48_PER_BUNDLE)
    {
        uint depthCount = SIGMA_DEPTH_VIEW_STRIDE * 2u;
        uint2 value = lane < depthCount ? _DepthCalibrationQ48[lane] :
            _RgbCalibrationQ48[lane - depthCount];
        _StreamBundleCalibration[bundle.calibration.x + lane] = value;
    }
    if (lane == 0u)
    {
        SigmaRawFrameRecordGpu record = _RawFrameStaging[0u];
        [unroll]
        for (uint word = 0u; word < SIGMA_RAW_FRAME_WORD4_COUNT; ++word)
            _RawFrameRecords[bundle.raw.y].word[word] = record.word[word];

        bool gauge = (bundle.identity.w & SIGMA_STREAM_BUNDLE_FLAG_GAUGE) != 0u;
        bool canOwnAssociation = bundle.raw.z <
            SIGMA_STREAM_TRANSACTION_CAPACITY;
        uint dormantProbation = gauge && canOwnAssociation
            ? SigmaBundleDormantAnchor(bundle) : SIGMA_STREAM_INVALID;
        if (dormantProbation != SIGMA_STREAM_INVALID)
        {
            SigmaProbationGpu probation = _StreamProbation[dormantProbation];
            uint target = probation.bundleHandles.x;
            SigmaCarrierPageMetaGpu metadata = _PageMetadata[target];
            bundle.identity.w |= SIGMA_STREAM_BUNDLE_FLAG_DORMANT_PROPOSAL;
            bundle.identity.w &= ~SIGMA_STREAM_BUNDLE_FLAG_NEEDS_REVALIDATION;
            bundle.probation = uint4(metadata.pageXLo, metadata.pageXHi,
                metadata.pageYLo, metadata.pageYHi);
            bundle.dependency = uint4(target, metadata.generation,
                metadata.revision, bundle.dependency.w);
            // calibration.z is otherwise unused execution metadata. Storing the
            // generation-safe probation slot here avoids a second identity scan;
            // exact inverse still decides whether this proposal is viable.
            bundle.calibration.z = dormantProbation + 1u;
        }

        if ((bundle.identity.w & SIGMA_STREAM_BUNDLE_FLAG_MATCHED) != 0u)
        {
            uint source = bundle.dependency.x;
            if (source < _PageCapacity)
            {
                SigmaCarrierPageMetaGpu metadata = _PageMetadata[source];
                bundle.probation = uint4(metadata.pageXLo,
                    metadata.pageXHi, metadata.pageYLo, metadata.pageYHi);
                bundle.dependency = uint4(source, metadata.generation,
                    metadata.revision, bundle.dependency.w);
            }
            else
            {
                bundle.identity.w |=
                    SIGMA_STREAM_BUNDLE_FLAG_NEEDS_REVALIDATION;
            }
        }
        _StreamBundles[bundleSlot] = bundle;
    }
    if (lane < 4u)
    {
        uint value = lane == 0u ? bundle.calibration.y :
            lane == 1u ? bundle.provenance.w :
            lane == 2u ? _Resolution.x : _Resolution.y;
        _StreamBundleRayEpoch[bundleSlot * 4u + lane] = value;
    }
}

// Sixty-four 8x8 groups copy one complete owned packet.  FP selects source
// pixels only; exact association, first-hit sectors and mutation are rebuilt
// later from these immutable bytes and copied Q48 calibration.
[numthreads(64, 1, 1)]
void ExtractSealedBundleSamples(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint workIndex = groupId.y;
    uint count = _StreamWorkCounts[SIGMA_STREAM_OPCODE_EXTRACT_BUNDLE];
    if (workIndex >= count || groupId.x >= 64u)
        return;
    SigmaStreamWorkItemGpu work = _StreamWorkItems[SigmaStreamWorkAddress(
        SIGMA_STREAM_OPCODE_EXTRACT_BUNDLE, workIndex)];
    if (work.identity.x != SIGMA_STREAM_OPCODE_EXTRACT_BUNDLE)
        return;
    uint bundleSlot = work.identity.y;
    if (bundleSlot >= SIGMA_STREAM_BUNDLE_CAPACITY)
        return;
    SigmaSealedSourceBundleGpu bundle = _StreamBundles[bundleSlot];
    if (SigmaStreamBundleGeneration(bundle) != work.identity.z ||
        SigmaStreamBundleState(bundle) != SIGMA_STREAM_BUNDLE_EXTRACTING)
        return;

    uint sample = groupId.x * 64u + threadId.x;
    uint2 local = uint2(sample & 63u, sample >> 6u);
    bool dormantProposal = (bundle.identity.w &
        SIGMA_STREAM_BUNDLE_FLAG_DORMANT_PROPOSAL) != 0u;
    bool gauge = (bundle.identity.w & SIGMA_STREAM_BUNDLE_FLAG_GAUGE) != 0u &&
        !dormantProposal;
    uint2 leftPixel = 0u;
    uint2 rightPixel = 0u;
    float3 worldPosition = 0.0;
    float informationMass = 0.0;
    float leftRange = 0.0;
    float rightRange = 0.0;
    bool worldValid = false;
    if (gauge)
    {
        uint2 origin = uint2(bundle.calibration.w & 0xffffu,
            bundle.calibration.w >> 16u);
        leftPixel = origin + local;
        if (all(leftPixel < _Resolution) &&
            (_DepthFlags[uint3(leftPixel, 0u)] & 1u) != 0u)
        {
            float2 metric = _MetricDepth[uint3(leftPixel, 0u)];
            if (metric.x > 0.0 && all(isfinite(metric)))
            {
                worldPosition = SigmaBundleGaugeWorld(leftPixel, metric.x);
                worldValid = all(isfinite(worldPosition));
            }
        }
    }
    else
    {
        worldValid = SigmaBundleMatchedWorld(bundle.dependency.x, sample,
            worldPosition, informationMass);
        if (worldValid)
            worldValid = SigmaBundleProjectDepth(worldPosition, 0u, leftPixel,
                leftRange);
    }
    bool rightProjected = worldValid && SigmaBundleProjectDepth(worldPosition,
        1u, rightPixel, rightRange);

    uint4 raw[6];
    raw[0] = worldValid ? SigmaBundleCaptureDepth(0u, leftPixel) :
        uint4(0xffffffffu, 0u, 0u, 0u);
    raw[1] = rightProjected ? SigmaBundleCaptureDepth(1u, rightPixel) :
        uint4(0xffffffffu, 0u, 0u, 0u);
    raw[2] = uint4(0xffffffffu, 0xffffffffu, 0u, 0u);
    raw[3] = 0u;
    raw[4] = uint4(0xffffffffu, 0xffffffffu, 0u, 0u);
    raw[5] = 0u;
    if (worldValid)
    {
        SigmaBundleCaptureRgb(0u, worldPosition, raw[2], raw[3]);
        SigmaBundleCaptureRgb(1u, worldPosition, raw[4], raw[5]);
    }
    [unroll]
    for (uint word = 0u; word < SIGMA_STREAM_RAW_WORD4_PER_SAMPLE; ++word)
        _RawWords[SigmaStreamRawWordAddress(bundle.raw.x, sample, word)] =
            raw[word];

    uint associationSlot = bundle.raw.z;
    if (associationSlot < SIGMA_STREAM_TRANSACTION_CAPACITY)
    {
        SigmaAssociationSampleGpu association =
            (SigmaAssociationSampleGpu)0;
        if (dormantProposal && worldValid)
        {
            SigmaCarrierPageMetaGpu metadata =
                _PageMetadata[bundle.dependency.x];
            SigmaBundleCaptureCandidateAssociation(0u, leftPixel, leftRange,
                informationMass, metadata, bundle.dependency.x, sample,
                association);
        }
        else if (worldValid)
            SigmaBundleCaptureAssociation(0u, leftPixel, association);
        if (dormantProposal && rightProjected)
        {
            SigmaCarrierPageMetaGpu metadata =
                _PageMetadata[bundle.dependency.x];
            SigmaBundleCaptureCandidateAssociation(1u, rightPixel, rightRange,
                informationMass, metadata, bundle.dependency.x, sample,
                association);
        }
        else if (rightProjected)
            SigmaBundleCaptureAssociation(1u, rightPixel, association);
        _StreamAssociation[associationSlot * SIGMA_PAGE_SAMPLE_COUNT + sample] =
            association;
    }

    // Proposal flags accelerate bounded admission only.  Exact support and
    // independence are reconstructed from the owned packet before publication.
    if ((raw[0].w & 1u) != 0u && (raw[1].w & 1u) != 0u)
        InterlockedOr(_StreamBundles[bundleSlot].identity.w,
            SIGMA_STREAM_BUNDLE_FLAG_DUAL_DEPTH);
    if (((raw[0].w | raw[1].w) & 1u) != 0u &&
        ((raw[3].z | raw[5].z) & 1u) != 0u)
        InterlockedOr(_StreamBundles[bundleSlot].identity.w,
            SIGMA_STREAM_BUNDLE_FLAG_DEPTH_RGB);
}
