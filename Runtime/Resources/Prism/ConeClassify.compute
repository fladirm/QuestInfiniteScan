#pragma kernel ClearClassCounters
#pragma kernel ClassifyConeEvents
#pragma kernel BuildClassDispatchArguments

#include "ConeMath.hlsl"

Texture2DArray<float4> _MeasuredConsensus;
Texture2DArray<uint> _MeasuredFlags;
Texture2DArray<float4> _MeasuredNormal;
Texture2DArray<float4> _BoundaryEvidence;
Texture2DArray<float2> _PredictedDepthSigma;
Texture2DArray<float4> _PredictedNormalConfidence;
Texture2DArray<uint2> _PredictedFilmIdGeneration;
Texture2DArray<float4> _PredictedUvMetadata;
Texture2DArray<float2> _Layer1DepthSigma;
Texture2DArray<float4> _Layer1NormalConfidence;
Texture2DArray<uint2> _Layer1FilmIdGeneration;
Texture2DArray<float4> _Layer1UvMetadata;
Texture2D<float4> _DepthRayCenterLeft;
Texture2D<float4> _DepthRayCenterRight;
Texture2D<float4> _DepthRayDifferentialXLeft;
Texture2D<float4> _DepthRayDifferentialXRight;
Texture2D<float4> _DepthRayDifferentialYLeft;
Texture2D<float4> _DepthRayDifferentialYRight;

struct ContactBoundaryHeader
{
    uint id;
    uint generation;
    uint chunkId;
    uint flags;
    uint filmA;
    uint filmAGeneration;
    uint filmB;
    uint filmBGeneration;
    float4 controlUv01;
    float4 controlUv23;
    float sigma;
    float support;
    float confidence;
    float contradiction;
    uint revision;
    uint cellKey;
    uint viewBinMask;
    uint lastSeenSequence;
};

struct BoundaryHashEntry
{
    uint hash;
    uint filmId;
    uint filmGeneration;
    uint cellKey;
    uint boundaryId;
};

StructuredBuffer<ContactBoundaryHeader> _CanonicalBoundaryHeaders;
StructuredBuffer<BoundaryHashEntry> _CanonicalBoundaryHash;

struct ConeEvent
{
    uint pixelLinear;
    uint packedPixel;
    uint classification;
    uint flags;
    float measuredRange;
    float predictedRange;
    float combinedSigma;
    float confidence;
    float3 measuredNormal;
    float boundaryEvidence;
    uint filmId;
    uint filmGeneration;
    float2 predictedUv;
    float footprintArea;
    float incidence;
    float pressurePrecision;
    uint occluderFilmId;
    uint occluderGeneration;
};

RWStructuredBuffer<ConeEvent> _ConeEvents;
RWStructuredBuffer<uint> _ClassifiedIndices;
RWStructuredBuffer<uint> _ClassCounters;
RWStructuredBuffer<uint3> _ClassDispatchArguments;

uint2 _Resolution;
uint _EventCapacity;
float _NormalCosineGate;
float _BoundaryGate;
uint _HasCanonicalBoundaries;
uint _CanonicalBoundaryHashMask;
uint _CanonicalBoundaryCellsPerAxis;

static const uint CLASS_INVALID = 0u;
static const uint CLASS_MATCH = 1u;
static const uint CLASS_NEW_FRONT = 2u;
static const uint CLASS_BEHIND = 3u;
static const uint CLASS_NEW_LAYER = 4u;
static const uint CLASS_UNSEEN = 5u;
static const uint CLASS_BOUNDARY = 6u;
static const uint CLASS_COUNT = 7u;
static const uint FLAG_VALID = 1u;
static const uint FLAG_CANONICAL_BOUNDARY = 1u << 20u;
static const uint BOUNDARY_ACTIVE = 1u;
static const uint BOUNDARY_PERSISTENT = 8u;

float3 LoadRay(uint2 pixel, uint eye)
{
    return eye == 0u ? _DepthRayCenterLeft[pixel].xyz :
        _DepthRayCenterRight[pixel].xyz;
}

float3 LoadRayDx(uint2 pixel, uint eye)
{
    return eye == 0u ? _DepthRayDifferentialXLeft[pixel].xyz :
        _DepthRayDifferentialXRight[pixel].xyz;
}

float3 LoadRayDy(uint2 pixel, uint eye)
{
    return eye == 0u ? _DepthRayDifferentialYLeft[pixel].xyz :
        _DepthRayDifferentialYRight[pixel].xyz;
}

uint BoundaryHashKey(uint filmId, uint generation, uint cellKey)
{
    uint value = filmId * 0x9e3779b9u;
    value ^= generation + 0x85ebca6bu + (value << 6u) + (value >> 2u);
    value ^= cellKey + 0xc2b2ae35u + (value << 6u) + (value >> 2u);
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    return max(1u, value & 0x7fffffffu);
}

float2 BoundaryCubic(ContactBoundaryHeader boundary, float t)
{
    float s = 1.0 - t;
    return s * s * s * boundary.controlUv01.xy +
        3.0 * s * s * t * boundary.controlUv01.zw +
        3.0 * s * t * t * boundary.controlUv23.xy +
        t * t * t * boundary.controlUv23.zw;
}

float BoundaryDistance(ContactBoundaryHeader boundary, float2 uv)
{
    float distance = 1e9;
    float2 previous = boundary.controlUv01.xy;
    [unroll]
    for (uint sampleIndex = 1u; sampleIndex <= 8u; ++sampleIndex)
    {
        float2 current = BoundaryCubic(boundary,
            (float)sampleIndex / 8.0);
        float2 segment = current - previous;
        float along = saturate(dot(uv - previous, segment) /
            max(dot(segment, segment), 1e-10));
        distance = min(distance, length(uv - previous - along * segment));
        previous = current;
    }
    return distance;
}

bool HasCanonicalBoundary(uint filmId, uint generation, float2 uv)
{
    if (_HasCanonicalBoundaries == 0u || filmId == 0u || generation == 0u)
        return false;
    uint cells = max(_CanonicalBoundaryCellsPerAxis, 1u);
    int2 center = (int2)min((uint2)(saturate(uv) * (float)cells), cells - 1u);
    [unroll]
    for (int y = -1; y <= 1; ++y)
    [unroll]
    for (int x = -1; x <= 1; ++x)
    {
        int2 cell = center + int2(x, y);
        if (any(cell < 0) || any(cell >= (int)cells)) continue;
        uint cellKey = (uint)cell.x | ((uint)cell.y << 16u);
        uint hash = BoundaryHashKey(filmId, generation, cellKey);
        [loop]
        for (uint probe = 0u; probe < 16u; ++probe)
        {
            uint slot = (hash + probe * 0x9e3779b9u) &
                _CanonicalBoundaryHashMask;
            BoundaryHashEntry entry = _CanonicalBoundaryHash[slot];
            if (entry.hash == 0u) break;
            if (entry.hash != hash || entry.filmId != filmId ||
                entry.filmGeneration != generation || entry.cellKey != cellKey ||
                entry.boundaryId == 0u) continue;
            ContactBoundaryHeader boundary =
                _CanonicalBoundaryHeaders[entry.boundaryId - 1u];
            if (boundary.filmA != filmId ||
                boundary.filmAGeneration != generation ||
                (boundary.flags & (BOUNDARY_ACTIVE | BOUNDARY_PERSISTENT)) !=
                    (BOUNDARY_ACTIVE | BOUNDARY_PERSISTENT)) continue;
            float threshold = max(1.5 * boundary.sigma, 0.45 / (float)cells);
            if (BoundaryDistance(boundary, uv) <= threshold) return true;
        }
    }
    return false;
}

void PublishEvent(uint eventIndex, uint classification, ConeEvent eventData)
{
    eventData.classification = classification;
    _ConeEvents[eventIndex] = eventData;
    uint classSlot;
    InterlockedAdd(_ClassCounters[classification], 1u, classSlot);
    if (classSlot < _EventCapacity)
        _ClassifiedIndices[classification * _EventCapacity + classSlot] = eventIndex;
}

[numthreads(8, 1, 1)]
void ClearClassCounters(uint3 id : SV_DispatchThreadID)
{
    if (id.x < CLASS_COUNT)
    {
        _ClassCounters[id.x] = 0u;
        _ClassDispatchArguments[id.x] = uint3(0u, 1u, 1u);
    }
}

[numthreads(8, 8, 1)]
void ClassifyConeEvents(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _Resolution) || id.z >= 2u) return;
    uint pixelsPerEye = _Resolution.x * _Resolution.y;
    uint eventIndex = id.z * pixelsPerEye + id.y * _Resolution.x + id.x;
    float4 measured = _MeasuredConsensus[id];
    uint measuredFlags = _MeasuredFlags[id];
    float4 measuredNormal = _MeasuredNormal[id];
    float boundary = _BoundaryEvidence[id].w;
    float2 predicted = _PredictedDepthSigma[id];
    float4 predictedNormal = _PredictedNormalConfidence[id];
    uint2 film = _PredictedFilmIdGeneration[id];
    float4 predictedUvMetadata = _PredictedUvMetadata[id];
    float2 layer1 = _Layer1DepthSigma[id];
    float4 layer1Normal = _Layer1NormalConfidence[id];
    uint2 layer1Film = _Layer1FilmIdGeneration[id];
    float4 layer1UvMetadata = _Layer1UvMetadata[id];

    ConeEvent eventData;
    eventData.pixelLinear = eventIndex;
    eventData.packedPixel = (id.x & 0xffffu) | ((id.y & 0x7fffu) << 16u) |
        ((id.z & 1u) << 31u);
    eventData.flags = measuredFlags;
    eventData.measuredRange = measured.x;
    eventData.predictedRange = predicted.x;
    eventData.combinedSigma = measured.z;
    eventData.confidence = measured.w;
    eventData.measuredNormal = measuredNormal.xyz;
    eventData.boundaryEvidence = boundary;
    eventData.filmId = film.x;
    eventData.filmGeneration = film.y;
    eventData.predictedUv = predictedUvMetadata.xy;
    eventData.footprintArea = 0.0;
    eventData.incidence = 0.0;
    eventData.pressurePrecision = 0.0;
    eventData.occluderFilmId = 0u;
    eventData.occluderGeneration = 0u;

    if ((measuredFlags & FLAG_VALID) == 0u || measured.x <= 0.0 ||
        !isfinite(measured.x))
    {
        PublishEvent(eventIndex, CLASS_INVALID, eventData);
        return;
    }

    float3 ray = LoadRay(id.xy, id.z);
    float3 footprintNormal = measuredNormal.w > 0.0 ? measuredNormal.xyz :
        (predictedNormal.w > 0.0 ? predictedNormal.xyz : -ray);
    float3 axisX, axisY;
    float footprintArea, incidence;
    if (ConeSurfaceFootprint(ray, LoadRayDx(id.xy, id.z),
        LoadRayDy(id.xy, id.z), measured.x, footprintNormal,
        axisX, axisY, footprintArea, incidence))
    {
        eventData.footprintArea = footprintArea;
        eventData.incidence = incidence;
        // Initial information carried into Q3-08. Metric range sigma and finite
        // surface footprint are both variances in metres; angle/contact confidence
        // attenuate weak far or grazing observations without an arbitrary 1/r^2 law.
        eventData.pressurePrecision = measured.w * incidence * incidence /
            max(measured.z * measured.z + footprintArea, 1e-10);
    }

    bool hasPrediction = film.x != 0u && film.y != 0u && predicted.x > 0.0 &&
        isfinite(predicted.x);
    bool canonicalBoundary = hasPrediction &&
        HasCanonicalBoundary(film.x, film.y, predictedUvMetadata.xy);
    if (boundary >= _BoundaryGate || canonicalBoundary)
    {
        if (canonicalBoundary) eventData.flags |= FLAG_CANONICAL_BOUNDARY;
        PublishEvent(eventIndex, CLASS_BOUNDARY, eventData);
        return;
    }

    if (!hasPrediction)
    {
        PublishEvent(eventIndex, CLASS_UNSEEN, eventData);
        return;
    }

    float combinedSigma = sqrt(max(0.0,
        measured.z * measured.z + predicted.y * predicted.y));
    float gate = 3.0 * combinedSigma + 0.002;
    float residual = measured.x - predicted.x;
    eventData.combinedSigma = combinedSigma;
    bool normalCompatible = measuredNormal.w <= 0.0 ||
        predictedNormal.w <= 0.0 ||
        dot(measuredNormal.xyz, predictedNormal.xyz) >= _NormalCosineGate;
    bool visibleSide = dot(predictedNormal.xyz, -ray) > 0.0;

    if (abs(residual) <= gate && normalCompatible && visibleSide)
    {
        PublishEvent(eventIndex, CLASS_MATCH, eventData);
        return;
    }

    // A persistent contact hidden behind a contradicted foreground film remains
    // refinable.  The second hardware depth peel avoids respawning it every frame
    // and records the front occluder as separate contradiction evidence.
    bool hasLayer1 = layer1Film.x != 0u && layer1Film.y != 0u &&
        layer1Film.x != film.x && layer1.x > 0.0 && isfinite(layer1.x);
    if (hasLayer1)
    {
        float layerCombinedSigma = sqrt(max(0.0,
            measured.z * measured.z + layer1.y * layer1.y));
        float layerGate = 3.0 * layerCombinedSigma + 0.002;
        float layerResidual = measured.x - layer1.x;
        bool layerNormalCompatible = measuredNormal.w <= 0.0 ||
            layer1Normal.w <= 0.0 ||
            dot(measuredNormal.xyz, layer1Normal.xyz) >= _NormalCosineGate;
        bool layerVisibleSide = dot(layer1Normal.xyz, -ray) > 0.0;
        if (abs(layerResidual) <= layerGate && layerNormalCompatible &&
            layerVisibleSide)
        {
            eventData.predictedRange = layer1.x;
            eventData.combinedSigma = layerCombinedSigma;
            eventData.filmId = layer1Film.x;
            eventData.filmGeneration = layer1Film.y;
            eventData.predictedUv = layer1UvMetadata.xy;
            eventData.occluderFilmId = film.x;
            eventData.occluderGeneration = film.y;
            PublishEvent(eventIndex, CLASS_MATCH, eventData);
            return;
        }
    }

    uint classification;
    if (residual < -gate)
        classification = CLASS_NEW_FRONT;
    else if (residual > gate)
        classification = CLASS_BEHIND;
    else
        classification = CLASS_NEW_LAYER;
    PublishEvent(eventIndex, classification, eventData);
}

[numthreads(8, 1, 1)]
void BuildClassDispatchArguments(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= CLASS_COUNT) return;
    uint count = min(_ClassCounters[id.x], _EventCapacity);
    _ClassDispatchArguments[id.x] = uint3((count + 63u) / 64u, 1u, 1u);
}
