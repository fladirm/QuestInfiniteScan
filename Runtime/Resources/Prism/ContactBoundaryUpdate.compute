#pragma kernel InitializeBoundaryState
#pragma kernel ClearLoadedBoundaryHash
#pragma kernel RehashLoadedBoundaries
#pragma kernel ClearBoundaryFrame
#pragma kernel AccumulateBoundaryEvents
#pragma kernel AccumulateBoundaryAbsence
#pragma kernel BuildBoundarySolveArguments
#pragma kernel SolveDirtyBoundaries

struct ConeEvent
{
    uint pixelLinear;
    uint packedPixel;
    uint classification;
    uint flags;
    float measuredRange;
    float predictedRange;
    float combinedSigma;
    float confidence;
    float3 measuredNormal;
    float boundaryEvidence;
    uint filmId;
    uint filmGeneration;
    float2 predictedUv;
    float footprintArea;
    float incidence;
    float pressurePrecision;
    uint occluderFilmId;
    uint occluderGeneration;
    float2 occluderUv;
};

struct ContactFilmHeader
{
    uint id;
    uint generation;
    uint chunkId;
    uint flags;
    float3 origin;
    float supportTotal;
    float3 normal;
    float sigmaNormal;
    float3 tangentU;
    float extentU;
    float3 tangentV;
    float extentV;
    float4 quadratic0123;
    float2 quadratic45;
    float confidence;
    float contradiction;
    uint revision;
    uint displacementPage;
    uint appearancePage;
    uint boundaryStart;
    uint boundaryCount;
    uint supportMaskLow;
    uint supportMaskHigh;
    uint reserved0;
    uint reserved1;
    uint reserved2;
};

struct ContactBoundaryHeader
{
    uint id;
    uint generation;
    uint chunkId;
    uint flags;
    uint filmA;
    uint filmAGeneration;
    uint filmB;
    uint filmBGeneration;
    float4 controlUv01;
    float4 controlUv23;
    float sigma;
    float support;
    float confidence;
    float contradiction;
    uint revision;
    uint cellKey;
    uint viewBinMask;
    uint lastSeenSequence;
};

struct BoundaryHashEntry
{
    uint hash;
    uint filmId;
    uint filmGeneration;
    uint cellKey;
    uint boundaryId;
};

StructuredBuffer<ConeEvent> _ConeEvents;
StructuredBuffer<uint> _ClassifiedIndices;
StructuredBuffer<uint> _ClassCounters;
StructuredBuffer<ContactFilmHeader> _FilmHeadersRead;
RWStructuredBuffer<ContactFilmHeader> _FilmHeaders;
RWStructuredBuffer<ContactBoundaryHeader> _BoundaryHeaders;
RWStructuredBuffer<float4> _BoundaryInformation;
RWStructuredBuffer<BoundaryHashEntry> _BoundaryHash;
RWStructuredBuffer<uint> _BoundaryAllocator;
RWStructuredBuffer<int> _BoundaryFrameAccumulator;
RWStructuredBuffer<uint> _BoundaryDirtyFlags;
RWStructuredBuffer<uint> _DirtyBoundaryIndices;
RWStructuredBuffer<uint> _BoundaryDirtyState;
RWStructuredBuffer<uint3> _BoundarySolveArguments;
RWStructuredBuffer<uint> _ManifoldDiagnostics;

Texture2DArray<float4> _MeasuredConsensus;
Texture2DArray<float4> _BoundaryEvidenceTexture;
Texture2DArray<uint2> _PredictedFilmIdGeneration;
Texture2D<float4> _RgbLeft;
Texture2D<float4> _RgbRight;
Texture2D<float4> _DepthRayCenterLeft;
Texture2D<float4> _DepthRayCenterRight;

uint _BoundaryCapacity;
uint _FilmCapacity;
uint _HashMask;
uint _EventCapacity;
uint _CellsPerAxis;
uint _PersistentSupport;
uint _MinimumViewBins;
uint _SearchRadiusPixels;
uint _FrameSequence;
uint2 _DepthResolution;
uint2 _RgbResolution;
float _RetirementEvidence;
float4 _RgbIntrinsics[2];
float4x4 _ChunkFromDepth[2];
float4x4 _ChunkFromRgb[2];
float4x4 _RgbFromDepth[2];

static const uint CLASS_MATCH = 1u;
static const uint CLASS_BOUNDARY = 6u;
static const uint FILM_ACTIVE = 1u;
static const uint FLAG_CANONICAL_BOUNDARY = 1u << 20u;
static const uint BOUNDARY_ACTIVE = 1u;
static const uint BOUNDARY_UNCERTAIN = 2u;
static const uint BOUNDARY_DIRTY = 4u;
static const uint BOUNDARY_PERSISTENT = 8u;
static const uint BOUNDARY_RETIRED = 16u;
static const uint BOUNDARY_MULTIVIEW = 32u;
static const uint WORDS_PER_BOUNDARY = 16u;
static const uint INFORMATION_RECORDS = 9u;
static const float MOMENT_SCALE = 65536.0;
static const float SUPPORT_SCALE = 4096.0;

uint HashKey(uint filmId, uint generation, uint cellKey)
{
    uint value = filmId * 0x9e3779b9u;
    value ^= generation + 0x85ebca6bu + (value << 6u) + (value >> 2u);
    value ^= cellKey + 0xc2b2ae35u + (value << 6u) + (value >> 2u);
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    return max(1u, value & 0x7fffffffu);
}

float3 LoadDepthRay(uint2 pixel, uint eye)
{
    return eye == 0u ? _DepthRayCenterLeft[pixel].xyz :
        _DepthRayCenterRight[pixel].xyz;
}

float4 LoadRgb(int2 pixel, uint eye)
{
    pixel = clamp(pixel, int2(0, 0), (int2)_RgbResolution - 1);
    return eye == 0u ? _RgbLeft.Load(int3(pixel, 0)) :
        _RgbRight.Load(int3(pixel, 0));
}

float Luminance(int2 pixel, uint eye)
{
    return dot(LoadRgb(pixel, eye).rgb, float3(0.2126, 0.7152, 0.0722));
}

float SobelMagnitude(int2 pixel, uint eye)
{
    if (any(pixel < 1) || any(pixel >= (int2)_RgbResolution - 1)) return 0.0;
    float gx = Luminance(pixel + int2(1, -1), eye) +
        2.0 * Luminance(pixel + int2(1, 0), eye) +
        Luminance(pixel + int2(1, 1), eye) -
        Luminance(pixel + int2(-1, -1), eye) -
        2.0 * Luminance(pixel + int2(-1, 0), eye) -
        Luminance(pixel + int2(-1, 1), eye);
    float gy = Luminance(pixel + int2(-1, 1), eye) +
        2.0 * Luminance(pixel + int2(0, 1), eye) +
        Luminance(pixel + int2(1, 1), eye) -
        Luminance(pixel + int2(-1, -1), eye) -
        2.0 * Luminance(pixel + int2(0, -1), eye) -
        Luminance(pixel + int2(1, -1), eye);
    return length(float2(gx, gy));
}

float Height(ContactFilmHeader film, float u, float v)
{
    return film.quadratic0123.x + film.quadratic0123.y * u +
        film.quadratic0123.z * v + film.quadratic0123.w * u * u +
        film.quadratic45.x * u * v + film.quadratic45.y * v * v;
}

float3 SurfacePoint(ContactFilmHeader film, float2 uv)
{
    float u = lerp(-film.extentU, film.extentU, uv.x);
    float v = lerp(-film.extentV, film.extentV, uv.y);
    return film.origin + film.tangentU * u + film.tangentV * v +
        film.normal * Height(film, u, v);
}

float3 SurfaceNormal(ContactFilmHeader film, float2 uv)
{
    float u = lerp(-film.extentU, film.extentU, uv.x);
    float v = lerp(-film.extentV, film.extentV, uv.y);
    float dhdu = film.quadratic0123.y +
        2.0 * film.quadratic0123.w * u + film.quadratic45.x * v;
    float dhdv = film.quadratic0123.z + film.quadratic45.x * u +
        2.0 * film.quadratic45.y * v;
    float3 normal = normalize(cross(film.tangentU + film.normal * dhdu,
        film.tangentV + film.normal * dhdv));
    return dot(normal, film.normal) >= 0.0 ? normal : -normal;
}

float2 PointToUv(ContactFilmHeader film, float3 surfacePosition)
{
    // `point` is an HLSL interpolation modifier on Vulkan backends.
    float3 delta = surfacePosition - film.origin;
    return float2(dot(delta, film.tangentU) / max(2.0 * film.extentU, 0.002) + 0.5,
        dot(delta, film.tangentV) / max(2.0 * film.extentV, 0.002) + 0.5);
}

float2 Cubic(float4 uv01, float4 uv23, float t)
{
    float s = 1.0 - t;
    return s * s * s * uv01.xy + 3.0 * s * s * t * uv01.zw +
        3.0 * s * t * t * uv23.xy + t * t * t * uv23.zw;
}

float DistanceToCurve(ContactBoundaryHeader boundary, float2 uv)
{
    float distance = 1e9;
    float2 previous = boundary.controlUv01.xy;
    [unroll]
    for (uint sampleIndex = 1u; sampleIndex <= 12u; ++sampleIndex)
    {
        float2 current = Cubic(boundary.controlUv01, boundary.controlUv23,
            (float)sampleIndex / 12.0);
        float2 segment = current - previous;
        float t = saturate(dot(uv - previous, segment) /
            max(dot(segment, segment), 1e-10));
        distance = min(distance, length(uv - (previous + segment * t)));
        previous = current;
    }
    return distance;
}

void AtomicAddScaled(uint address, float value, float scale)
{
    int quantized = (int)round(clamp(value * scale,
        -2140000000.0, 2140000000.0));
    if (quantized != 0)
        InterlockedAdd(_BoundaryFrameAccumulator[address], quantized);
}

void MarkDirty(uint boundaryIndex)
{
    uint prior;
    InterlockedCompareExchange(_BoundaryDirtyFlags[boundaryIndex], 0u, 1u, prior);
    if (prior != 0u) return;
    uint slot;
    InterlockedAdd(_BoundaryDirtyState[0], 1u, slot);
    if (slot < _BoundaryCapacity)
        _DirtyBoundaryIndices[slot] = boundaryIndex;
    else
        InterlockedAdd(_BoundaryDirtyState[1], 1u);
}

bool FindBoundary(uint filmId, uint generation, uint cellKey,
    out uint boundaryIndex)
{
    boundaryIndex = 0xffffffffu;
    uint hash = HashKey(filmId, generation, cellKey);
    [loop]
    for (uint probe = 0u; probe < 16u; ++probe)
    {
        uint slot = (hash + probe * 0x9e3779b9u) & _HashMask;
        BoundaryHashEntry entry = _BoundaryHash[slot];
        if (entry.hash == 0u) return false;
        if (entry.hash == hash && entry.filmId == filmId &&
            entry.filmGeneration == generation && entry.cellKey == cellKey &&
            entry.boundaryId > 0u)
        {
            boundaryIndex = entry.boundaryId - 1u;
            return boundaryIndex < _BoundaryCapacity;
        }
    }
    return false;
}

bool ResolveBoundary(uint filmId, uint generation, uint cellKey,
    out uint boundaryIndex)
{
    if (FindBoundary(filmId, generation, cellKey, boundaryIndex)) return true;
    boundaryIndex = 0xffffffffu;
    uint hash = HashKey(filmId, generation, cellKey);
    uint claim = hash | 0x80000000u;
    [loop]
    for (uint probe = 0u; probe < 16u; ++probe)
    {
        uint slot = (hash + probe * 0x9e3779b9u) & _HashMask;
        uint previous;
        InterlockedCompareExchange(_BoundaryHash[slot].hash, 0u, claim, previous);
        if (previous == 0u)
        {
            uint allocated;
            InterlockedAdd(_BoundaryAllocator[0], 1u, allocated);
            if (allocated >= _BoundaryCapacity)
            {
                InterlockedAdd(_BoundaryAllocator[2], 1u);
                _BoundaryHash[slot].hash = 0u;
                return false;
            }
            InterlockedAdd(_BoundaryAllocator[1], 1u);
            uint boundaryGeneration = max(1u, _BoundaryAllocator[3]);
            ContactFilmHeader film = _FilmHeadersRead[filmId - 1u];
            ContactBoundaryHeader boundary = (ContactBoundaryHeader)0;
            boundary.id = allocated + 1u;
            boundary.generation = boundaryGeneration;
            boundary.chunkId = film.chunkId;
            boundary.flags = BOUNDARY_ACTIVE | BOUNDARY_UNCERTAIN |
                BOUNDARY_DIRTY;
            boundary.filmA = filmId;
            boundary.filmAGeneration = generation;
            boundary.sigma = max(0.001, film.sigmaNormal);
            boundary.cellKey = cellKey;
            _BoundaryHeaders[allocated] = boundary;
            uint information = allocated * INFORMATION_RECORDS;
            [unroll] for (uint record = 0u; record < INFORMATION_RECORDS; ++record)
                _BoundaryInformation[information + record] = 0.0;
            _BoundaryInformation[information + 2u] =
                float4(boundary.sigma, 0.0, 0.0, 0.0);
            _BoundaryHash[slot].filmId = filmId;
            _BoundaryHash[slot].filmGeneration = generation;
            _BoundaryHash[slot].cellKey = cellKey;
            _BoundaryHash[slot].boundaryId = allocated + 1u;
            // A single-view gradient is provisional evidence, not canonical
            // topology.  Counting it here permanently locks an otherwise smooth
            // film against cross-tile/cross-eye merging.  The owning film is only
            // linked when this boundary survives the multi-view persistence gate
            // in SolveDirtyBoundaries.
            DeviceMemoryBarrier();
            _BoundaryHash[slot].hash = hash;
            boundaryIndex = allocated;
            return true;
        }

        if (previous == claim)
        {
            [loop]
            for (uint spin = 0u; spin < 32u; ++spin)
            {
                DeviceMemoryBarrier();
                BoundaryHashEntry waiting = _BoundaryHash[slot];
                if (waiting.hash != claim)
                {
                    previous = waiting.hash;
                    break;
                }
            }
        }
        if (previous == hash)
        {
            BoundaryHashEntry existing = _BoundaryHash[slot];
            if (existing.filmId == filmId &&
                existing.filmGeneration == generation &&
                existing.cellKey == cellKey && existing.boundaryId > 0u)
            {
                boundaryIndex = existing.boundaryId - 1u;
                return boundaryIndex < _BoundaryCapacity;
            }
        }
    }
    InterlockedAdd(_BoundaryAllocator[2], 1u);
    return false;
}

uint ViewBin(ContactFilmHeader film, float3 contact, uint eye)
{
    float3 camera = mul(_ChunkFromDepth[eye], float4(0, 0, 0, 1)).xyz;
    float3 view = normalize(camera - contact);
    float angle = atan2(dot(view, film.tangentV), dot(view, film.tangentU));
    float normalizedAngle = frac(angle / 6.28318530718 + 1.0);
    uint azimuth = min(7u, (uint)floor(normalizedAngle * 8.0));
    uint elevation = dot(view, film.normal) >= 0.70710678 ? 1u : 0u;
    return azimuth + elevation * 8u;
}

bool RefineUvWithRgb(ConeEvent eventData, ContactFilmHeader film,
    uint2 depthPixel, uint eye, float3 measuredChunk, out float2 refinedUv,
    out float rgbScore)
{
    refinedUv = PointToUv(film, measuredChunk);
    rgbScore = 0.0;
    float3 depthPoint = LoadDepthRay(depthPixel, eye) * eventData.measuredRange;
    float3 rgbPoint = mul(_RgbFromDepth[eye], float4(depthPoint, 1.0)).xyz;
    if (rgbPoint.z <= 1e-5) return false;
    float4 intrinsics = _RgbIntrinsics[eye];
    float2 projected = float2(rgbPoint.x / rgbPoint.z * intrinsics.x + intrinsics.z,
        rgbPoint.y / rgbPoint.z * intrinsics.y + intrinsics.w);
    if (any(projected < 5.0) || any(projected >= (float2)_RgbResolution - 5.0))
        return false;

    int2 leftPixel = int2(max((int)depthPixel.x - 1, 0), depthPixel.y);
    int2 rightPixel = int2(min(depthPixel.x + 1u, _DepthResolution.x - 1u),
        depthPixel.y);
    int2 downPixel = int2(depthPixel.x, max((int)depthPixel.y - 1, 0));
    int2 upPixel = int2(depthPixel.x,
        min(depthPixel.y + 1u, _DepthResolution.y - 1u));
    float centerRange = eventData.measuredRange;
    float leftRange = _MeasuredConsensus[uint3((uint2)leftPixel, eye)].x;
    float rightRange = _MeasuredConsensus[uint3((uint2)rightPixel, eye)].x;
    float downRange = _MeasuredConsensus[uint3((uint2)downPixel, eye)].x;
    float upRange = _MeasuredConsensus[uint3((uint2)upPixel, eye)].x;
    leftRange = leftRange > 0.0 ? leftRange : centerRange;
    rightRange = rightRange > 0.0 ? rightRange : centerRange;
    downRange = downRange > 0.0 ? downRange : centerRange;
    upRange = upRange > 0.0 ? upRange : centerRange;
    float2 edgeNormal = float2(rightRange - leftRange, upRange - downRange);
    if (dot(edgeNormal, edgeNormal) < 1e-10) edgeNormal = float2(1.0, 0.0);
    edgeNormal = normalize(edgeNormal * (float2)_RgbResolution /
        max((float2)_DepthResolution, 1.0));

    float best = 0.0;
    float second = 0.0;
    int2 bestPixel = (int2)round(projected);
    [loop]
    for (int offset = -(int)_SearchRadiusPixels;
        offset <= (int)_SearchRadiusPixels; ++offset)
    {
        int2 candidate = (int2)round(projected + edgeNormal * (float)offset);
        float score = SobelMagnitude(candidate, eye);
        if (score > best)
        {
            second = best;
            best = score;
            bestPixel = candidate;
        }
        else if (score > second) second = score;
    }
    rgbScore = saturate(best * 0.5);
    if (best < 0.06 || best < second + 0.004) return false;

    float3 cameraOrigin = mul(_ChunkFromRgb[eye], float4(0, 0, 0, 1)).xyz;
    float3 rgbRay = normalize(float3(
        ((float)bestPixel.x + 0.5 - intrinsics.z) / intrinsics.x,
        ((float)bestPixel.y + 0.5 - intrinsics.w) / intrinsics.y, 1.0));
    float3 rayChunk = normalize(mul(_ChunkFromRgb[eye],
        float4(rgbRay, 0.0)).xyz);
    float2 seedUv = saturate(eventData.predictedUv);
    float3 surface = SurfacePoint(film, seedUv);
    float3 surfaceNormal = SurfaceNormal(film, seedUv);
    float denominator = dot(rayChunk, surfaceNormal);
    if (abs(denominator) < 1e-4) return false;
    float distance = dot(surface - cameraOrigin, surfaceNormal) / denominator;
    if (distance <= 0.0 || !isfinite(distance)) return false;
    float2 rgbUv = PointToUv(film, cameraOrigin + rayChunk * distance);
    if (any(rgbUv < -0.08) || any(rgbUv > 1.08)) return false;
    float focus = saturate((best - second) * 12.0);
    refinedUv = lerp(refinedUv, rgbUv, 0.25 + 0.75 * focus);
    return true;
}

[numthreads(64, 1, 1)]
void InitializeBoundaryState(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index <= _HashMask)
        _BoundaryHash[index] = (BoundaryHashEntry)0;
    if (index < _BoundaryCapacity)
    {
        uint baseWord = index * WORDS_PER_BOUNDARY;
        [unroll] for (uint word = 0u; word < WORDS_PER_BOUNDARY; ++word)
            _BoundaryFrameAccumulator[baseWord + word] = 0;
        _BoundaryDirtyFlags[index] = 0u;
        _DirtyBoundaryIndices[index] = 0u;
    }
    if (index == 0u)
    {
        [unroll] for (uint state = 0u; state < 4u; ++state)
            _BoundaryDirtyState[state] = 0u;
        _BoundarySolveArguments[0] = uint3(0u, 1u, 1u);
        _BoundarySolveArguments[1] = uint3(0u, 1u, 1u);
    }
}

[numthreads(64, 1, 1)]
void ClearLoadedBoundaryHash(uint3 id : SV_DispatchThreadID)
{
    if (id.x <= _HashMask) _BoundaryHash[id.x] = (BoundaryHashEntry)0;
}

[numthreads(64, 1, 1)]
void RehashLoadedBoundaries(uint3 id : SV_DispatchThreadID)
{
    uint count = min(_BoundaryAllocator[0], _BoundaryCapacity);
    uint index = id.x;
    if (index >= count) return;
    ContactBoundaryHeader boundary = _BoundaryHeaders[index];
    if ((boundary.flags & BOUNDARY_ACTIVE) == 0u ||
        (boundary.flags & BOUNDARY_RETIRED) != 0u || boundary.filmA == 0u)
        return;
    uint hash = HashKey(boundary.filmA, boundary.filmAGeneration,
        boundary.cellKey);
    [loop]
    for (uint probe = 0u; probe < 32u; ++probe)
    {
        uint slot = (hash + probe * 0x9e3779b9u) & _HashMask;
        uint observed;
        InterlockedCompareExchange(_BoundaryHash[slot].hash, 0u, hash, observed);
        if (observed == 0u || observed == hash)
        {
            BoundaryHashEntry entry;
            entry.hash = hash;
            entry.filmId = boundary.filmA;
            entry.filmGeneration = boundary.filmAGeneration;
            entry.cellKey = boundary.cellKey;
            entry.boundaryId = boundary.id;
            _BoundaryHash[slot] = entry;
            return;
        }
    }
    InterlockedAdd(_BoundaryAllocator[2], 1u);
}

[numthreads(1, 1, 1)]
void ClearBoundaryFrame(uint3 id : SV_DispatchThreadID)
{
    [unroll] for (uint state = 0u; state < 4u; ++state)
        _BoundaryDirtyState[state] = 0u;
    _BoundarySolveArguments[0] = uint3(0u, 1u, 1u);
}

[numthreads(64, 1, 1)]
void AccumulateBoundaryEvents(uint3 id : SV_DispatchThreadID)
{
    uint count = min(_ClassCounters[CLASS_BOUNDARY], _EventCapacity);
    if (id.x >= count) return;
    uint eventIndex = _ClassifiedIndices[CLASS_BOUNDARY * _EventCapacity + id.x];
    ConeEvent eventData = _ConeEvents[eventIndex];
    if (eventData.classification != CLASS_BOUNDARY || eventData.filmId == 0u ||
        eventData.filmGeneration == 0u || eventData.boundaryEvidence <= 0.0) return;
    ContactFilmHeader film = _FilmHeadersRead[eventData.filmId - 1u];
    if (film.id != eventData.filmId || film.generation != eventData.filmGeneration ||
        (film.flags & FILM_ACTIVE) == 0u) return;

    // The classifier also protects already-persistent curves from ordinary fusion.
    // Protection is not positive evidence: if the current calibrated view is smooth
    // across that curve, feed conservative absence evidence instead of making the
    // stored boundary self-confirm forever.
    if ((eventData.flags & FLAG_CANONICAL_BOUNDARY) != 0u &&
        eventData.boundaryEvidence < 0.2)
    {
        float2 protectedUv = saturate(eventData.predictedUv);
        uint2 protectedCell = min((uint2)(protectedUv * (float)_CellsPerAxis),
            _CellsPerAxis - 1u);
        [unroll]
        for (int cy = -1; cy <= 1; ++cy)
        [unroll]
        for (int cx = -1; cx <= 1; ++cx)
        {
            int2 cell = (int2)protectedCell + int2(cx, cy);
            if (any(cell < 0) || any(cell >= (int)_CellsPerAxis)) continue;
            uint cellKey = (uint)cell.x | ((uint)cell.y << 16u);
            uint boundaryIndex;
            if (!FindBoundary(eventData.filmId, eventData.filmGeneration,
                cellKey, boundaryIndex)) continue;
            ContactBoundaryHeader existing = _BoundaryHeaders[boundaryIndex];
            if ((existing.flags & BOUNDARY_ACTIVE) == 0u) continue;
            float proximity = max(1.5 * existing.sigma,
                0.75 / max((float)_CellsPerAxis, 1.0));
            if (DistanceToCurve(existing, protectedUv) > proximity) continue;
            MarkDirty(boundaryIndex);
            uint baseWord = boundaryIndex * WORDS_PER_BOUNDARY;
            float absence = saturate(eventData.confidence) *
                saturate(eventData.incidence) *
                (0.2 - eventData.boundaryEvidence) * 2.0;
            AtomicAddScaled(baseWord + 11u, absence, SUPPORT_SCALE);
        }
        return;
    }

    uint2 pixel = uint2(eventData.packedPixel & 0xffffu,
        (eventData.packedPixel >> 16u) & 0x7fffu);
    uint eye = eventData.packedPixel >> 31u;
    float3 measuredDepth = LoadDepthRay(pixel, eye) * eventData.measuredRange;
    float3 measuredChunk = mul(_ChunkFromDepth[eye],
        float4(measuredDepth, 1.0)).xyz;
    float2 uv;
    float rgbScore;
    RefineUvWithRgb(eventData, film, pixel, eye, measuredChunk, uv, rgbScore);
    uv = saturate(uv);
    uint2 cell = min((uint2)(uv * (float)_CellsPerAxis), _CellsPerAxis - 1u);
    uint cellKey = cell.x | (cell.y << 16u);
    uint boundaryIndex;
    if (!ResolveBoundary(eventData.filmId, eventData.filmGeneration,
        cellKey, boundaryIndex)) return;
    MarkDirty(boundaryIndex);

    float4 evidence = _BoundaryEvidenceTexture[uint3(pixel, eye)];
    float sourceEvidence = saturate(max(eventData.boundaryEvidence,
        max(evidence.x, max(evidence.y, evidence.z))));
    float metricFootprint = sqrt(max(eventData.footprintArea, 1e-10));
    float precision = rcp(max(eventData.combinedSigma * eventData.combinedSigma +
        metricFootprint * metricFootprint, 1e-8));
    float weight = sourceEvidence * saturate(eventData.confidence) *
        saturate(eventData.incidence) * sqrt(saturate(precision * 0.0001));
    weight = max(weight, 0.01 * sourceEvidence);
    uint baseWord = boundaryIndex * WORDS_PER_BOUNDARY;
    AtomicAddScaled(baseWord + 0u, weight * uv.x, MOMENT_SCALE);
    AtomicAddScaled(baseWord + 1u, weight * uv.y, MOMENT_SCALE);
    AtomicAddScaled(baseWord + 2u, weight * uv.x * uv.x, MOMENT_SCALE);
    AtomicAddScaled(baseWord + 3u, weight * uv.x * uv.y, MOMENT_SCALE);
    AtomicAddScaled(baseWord + 4u, weight * uv.y * uv.y, MOMENT_SCALE);
    AtomicAddScaled(baseWord + 5u, weight, SUPPORT_SCALE);
    InterlockedAdd(_BoundaryFrameAccumulator[baseWord + 6u], 1);
    AtomicAddScaled(baseWord + 7u, sourceEvidence, SUPPORT_SCALE);
    AtomicAddScaled(baseWord + 8u, eventData.footprintArea, MOMENT_SCALE);
    uint viewBit = 1u << ViewBin(film, measuredChunk, eye);
    InterlockedOr(_BoundaryFrameAccumulator[baseWord + 9u], (int)viewBit);
    AtomicAddScaled(baseWord + 10u, rgbScore, SUPPORT_SCALE);
    float firstHitScale = max(3.0 * eventData.combinedSigma +
        sqrt(max(eventData.footprintArea, 1e-10)), 0.001);
    float firstHitScore = eventData.predictedRange > 0.0 ?
        exp(-abs(eventData.measuredRange - eventData.predictedRange) /
            firstHitScale) : 0.5;
    float visibilityScore = saturate(eventData.confidence * eventData.incidence);
    float poseCalibrationQuality = saturate(max(eventData.confidence * 0.5,
        eventData.pressurePrecision * eventData.combinedSigma *
            eventData.combinedSigma));
    float sidednessScore = saturate(dot(eventData.measuredNormal, film.normal));
    AtomicAddScaled(baseWord + 12u, weight * firstHitScore, SUPPORT_SCALE);
    AtomicAddScaled(baseWord + 13u, weight * visibilityScore, SUPPORT_SCALE);
    AtomicAddScaled(baseWord + 14u, weight * poseCalibrationQuality,
        SUPPORT_SCALE);
    AtomicAddScaled(baseWord + 15u, weight * sidednessScore, SUPPORT_SCALE);
}

[numthreads(64, 1, 1)]
void AccumulateBoundaryAbsence(uint3 id : SV_DispatchThreadID)
{
    uint count = min(_ClassCounters[CLASS_MATCH], _EventCapacity);
    if (id.x >= count) return;
    uint eventIndex = _ClassifiedIndices[CLASS_MATCH * _EventCapacity + id.x];
    ConeEvent eventData = _ConeEvents[eventIndex];
    if (eventData.classification != CLASS_MATCH || eventData.filmId == 0u ||
        eventData.boundaryEvidence >= 0.2 || eventData.confidence < 0.65 ||
        eventData.incidence < 0.35) return;
    float2 uv = saturate(eventData.predictedUv);
    uint2 center = min((uint2)(uv * (float)_CellsPerAxis), _CellsPerAxis - 1u);
    [unroll]
    for (int y = -1; y <= 1; ++y)
    [unroll]
    for (int x = -1; x <= 1; ++x)
    {
        int2 cell = (int2)center + int2(x, y);
        if (any(cell < 0) || any(cell >= (int)_CellsPerAxis)) continue;
        uint cellKey = (uint)cell.x | ((uint)cell.y << 16u);
        uint boundaryIndex;
        if (!FindBoundary(eventData.filmId, eventData.filmGeneration,
            cellKey, boundaryIndex)) continue;
        ContactBoundaryHeader boundary = _BoundaryHeaders[boundaryIndex];
        if ((boundary.flags & BOUNDARY_ACTIVE) == 0u ||
            (boundary.flags & BOUNDARY_PERSISTENT) == 0u) continue;
        float proximity = max(1.5 * boundary.sigma,
            0.75 / max((float)_CellsPerAxis, 1.0));
        if (DistanceToCurve(boundary, uv) > proximity) continue;
        MarkDirty(boundaryIndex);
        uint baseWord = boundaryIndex * WORDS_PER_BOUNDARY;
        float contradiction = saturate(eventData.confidence) *
            saturate(eventData.incidence) * (0.2 - eventData.boundaryEvidence) * 2.0;
        AtomicAddScaled(baseWord + 11u, contradiction, SUPPORT_SCALE);
    }
}

[numthreads(1, 1, 1)]
void BuildBoundarySolveArguments(uint3 id : SV_DispatchThreadID)
{
    uint count = min(_BoundaryDirtyState[0], _BoundaryCapacity);
    _BoundarySolveArguments[0] = uint3((count + 63u) / 64u, 1u, 1u);
    uint allocated = min(_BoundaryAllocator[0], _BoundaryCapacity);
    _BoundarySolveArguments[1] = uint3((allocated + 63u) / 64u, 1u, 1u);
}

[numthreads(64, 1, 1)]
void SolveDirtyBoundaries(uint3 id : SV_DispatchThreadID)
{
    uint dirtyCount = min(_BoundaryDirtyState[0], _BoundaryCapacity);
    if (id.x >= dirtyCount) return;
    uint boundaryIndex = _DirtyBoundaryIndices[id.x];
    if (boundaryIndex >= _BoundaryCapacity) return;
    uint baseWord = boundaryIndex * WORDS_PER_BOUNDARY;
    uint information = boundaryIndex * INFORMATION_RECORDS;
    ContactBoundaryHeader boundary = _BoundaryHeaders[boundaryIndex];
    if (boundary.filmA == 0u) return;
    ContactFilmHeader film = _FilmHeaders[boundary.filmA - 1u];
    if (film.id != boundary.filmA || film.generation != boundary.filmAGeneration)
        return;

    float4 moments0 = _BoundaryInformation[information + 0u];
    float4 moments1 = _BoundaryInformation[information + 1u];
    float4 state = _BoundaryInformation[information + 7u];
    float4 physical = _BoundaryInformation[information + 8u];
    float frameSupport = max(0.0,
        (float)_BoundaryFrameAccumulator[baseWord + 5u] / SUPPORT_SCALE);
    float frameContradiction = max(0.0,
        (float)_BoundaryFrameAccumulator[baseWord + 11u] / SUPPORT_SCALE);
    bool wasRetired = (boundary.flags & BOUNDARY_RETIRED) != 0u;
    bool wasPersistent = (boundary.flags & BOUNDARY_PERSISTENT) != 0u;
    moments0 += float4(
        (float)_BoundaryFrameAccumulator[baseWord + 0u] / MOMENT_SCALE,
        (float)_BoundaryFrameAccumulator[baseWord + 1u] / MOMENT_SCALE,
        (float)_BoundaryFrameAccumulator[baseWord + 2u] / MOMENT_SCALE,
        (float)_BoundaryFrameAccumulator[baseWord + 3u] / MOMENT_SCALE);
    moments1.x += (float)_BoundaryFrameAccumulator[baseWord + 4u] / MOMENT_SCALE;
    moments1.y += frameSupport;
    moments1.z += (float)max(0, _BoundaryFrameAccumulator[baseWord + 6u]);
    moments1.w += (float)_BoundaryFrameAccumulator[baseWord + 7u] / SUPPORT_SCALE;
    state.x += (float)_BoundaryFrameAccumulator[baseWord + 10u] / SUPPORT_SCALE;
    state.y = max(0.0, state.y * 0.995 + frameContradiction - frameSupport * 0.2);
    state.z += (float)_BoundaryFrameAccumulator[baseWord + 8u] / MOMENT_SCALE;
    physical += float4(
        (float)_BoundaryFrameAccumulator[baseWord + 12u] / SUPPORT_SCALE,
        (float)_BoundaryFrameAccumulator[baseWord + 13u] / SUPPORT_SCALE,
        (float)_BoundaryFrameAccumulator[baseWord + 14u] / SUPPORT_SCALE,
        (float)_BoundaryFrameAccumulator[baseWord + 15u] / SUPPORT_SCALE);
    uint frameViewMask = asuint(_BoundaryFrameAccumulator[baseWord + 9u]);
    boundary.viewBinMask |= frameViewMask;
    uint distinctViews = countbits(boundary.viewBinMask);

    if (frameSupport > 0.0)
    {
        if (wasRetired)
        {
            boundary.flags &= ~BOUNDARY_RETIRED;
        }
        boundary.flags |= BOUNDARY_ACTIVE | BOUNDARY_DIRTY;
        boundary.lastSeenSequence = _FrameSequence;
        boundary.revision = boundary.revision == 0xffffffffu ? 1u :
            boundary.revision + 1u;
    }

    float support = max(moments1.y, 1e-6);
    float2 mean = moments0.xy / support;
    float covarianceUU = max(0.0, moments0.z / support - mean.x * mean.x);
    float covarianceUV = moments0.w / support - mean.x * mean.y;
    float covarianceVV = max(0.0, moments1.x / support - mean.y * mean.y);
    float angle = 0.5 * atan2(2.0 * covarianceUV,
        covarianceUU - covarianceVV);
    float2 direction = float2(cos(angle), sin(angle));
    float trace = covarianceUU + covarianceVV;
    float discriminant = sqrt(max(0.0,
        (covarianceUU - covarianceVV) * (covarianceUU - covarianceVV) +
        4.0 * covarianceUV * covarianceUV));
    float majorVariance = 0.5 * (trace + discriminant);
    float minorVariance = max(0.0, 0.5 * (trace - discriminant));
    float cellSize = 1.0 / max(1.0, (float)_CellsPerAxis);
    float halfLength = clamp(2.5 * sqrt(max(majorVariance, 1e-8)),
        0.2 * cellSize, 1.75 * cellSize);
    float2 start = saturate(mean - direction * halfLength);
    float2 end = saturate(mean + direction * halfLength);
    boundary.controlUv01 = float4(start, lerp(start, end, 1.0 / 3.0));
    boundary.controlUv23 = float4(lerp(start, end, 2.0 / 3.0), end);
    boundary.support = support;
    float averageEvidence = saturate(moments1.w / max(moments1.z, 1.0));
    float viewFactor = saturate((float)distinctViews /
        max((float)_MinimumViewBins, 1.0));
    boundary.confidence = saturate((1.0 - exp(-support * 0.2)) *
        averageEvidence * (0.4 + 0.6 * viewFactor));
    boundary.sigma = max(0.00025, sqrt(minorVariance) /
        sqrt(max(1.0, (float)distinctViews)));
    boundary.contradiction = state.y;
    if (distinctViews >= _MinimumViewBins)
        boundary.flags |= BOUNDARY_MULTIVIEW;
    if (boundary.revision >= _PersistentSupport &&
        distinctViews >= _MinimumViewBins && boundary.confidence >= 0.35)
    {
        boundary.flags |= BOUNDARY_PERSISTENT;
        boundary.flags &= ~BOUNDARY_UNCERTAIN;
        if (!wasPersistent)
        {
            uint ignored;
            InterlockedCompareExchange(
                _FilmHeaders[boundary.filmA - 1u].boundaryStart,
                0u, boundaryIndex + 1u, ignored);
            InterlockedAdd(
                _FilmHeaders[boundary.filmA - 1u].boundaryCount, 1u);
            wasPersistent = true;
        }
    }

    float metricSigma = boundary.sigma *
        max(2.0 * film.extentU, 2.0 * film.extentV);
    _BoundaryInformation[information + 3u] =
        float4(SurfacePoint(film, boundary.controlUv01.xy), metricSigma);
    _BoundaryInformation[information + 4u] =
        float4(SurfacePoint(film, boundary.controlUv01.zw), metricSigma);
    _BoundaryInformation[information + 5u] =
        float4(SurfacePoint(film, boundary.controlUv23.xy), metricSigma);
    _BoundaryInformation[information + 6u] =
        float4(SurfacePoint(film, boundary.controlUv23.zw), metricSigma);

    float retirementGate = max(_RetirementEvidence,
        4.0 + 0.75 * sqrt(max(boundary.support, 0.0)));
    if ((boundary.flags & BOUNDARY_PERSISTENT) != 0u &&
        boundary.contradiction > retirementGate && frameSupport <= 0.0)
    {
        boundary.flags &= ~(BOUNDARY_ACTIVE | BOUNDARY_PERSISTENT);
        boundary.flags |= BOUNDARY_RETIRED;
        if (wasPersistent)
            InterlockedAdd(_FilmHeaders[boundary.filmA - 1u].boundaryCount,
                0xffffffffu);
    }

    _BoundaryHeaders[boundaryIndex] = boundary;
    _BoundaryInformation[information + 0u] = moments0;
    _BoundaryInformation[information + 1u] = moments1;
    _BoundaryInformation[information + 2u] = float4(boundary.sigma,
        boundary.confidence, majorVariance, minorVariance);
    state.w = (float)distinctViews;
    _BoundaryInformation[information + 7u] = state;
    _BoundaryInformation[information + 8u] = physical;

    [unroll] for (uint word = 0u; word < WORDS_PER_BOUNDARY; ++word)
        _BoundaryFrameAccumulator[baseWord + word] = 0;
    _BoundaryDirtyFlags[boundaryIndex] = 0u;
}
