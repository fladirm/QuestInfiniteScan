#pragma kernel InitializeBoundaryState
#pragma kernel ClearBoundaryFrame
#pragma kernel AccumulateBoundaryEvents
#pragma kernel BuildBoundarySolveArguments
#pragma kernel SolveDirtyBoundaries

struct ConeEvent
{
    uint pixelLinear;
    uint packedPixel;
    uint classification;
    uint flags;
    float measuredRange;
    float predictedRange;
    float combinedSigma;
    float confidence;
    float3 measuredNormal;
    float boundaryEvidence;
    uint filmId;
    uint filmGeneration;
    float2 predictedUv;
    float footprintArea;
    float incidence;
    float pressurePrecision;
    uint occluderFilmId;
    uint occluderGeneration;
};

struct ContactFilmHeader
{
    uint id;
    uint generation;
    uint chunkId;
    uint flags;
    float3 origin;
    float supportTotal;
    float3 normal;
    float sigmaNormal;
    float3 tangentU;
    float extentU;
    float3 tangentV;
    float extentV;
    float4 quadratic0123;
    float2 quadratic45;
    float confidence;
    float contradiction;
    uint revision;
    uint displacementPage;
    uint appearancePage;
    uint boundaryStart;
    uint boundaryCount;
    uint reserved0;
    uint reserved1;
    uint reserved2;
};

struct ContactBoundaryHeader
{
    uint id;
    uint generation;
    uint chunkId;
    uint flags;
    uint filmA;
    uint filmAGeneration;
    uint filmB;
    uint filmBGeneration;
    float4 controlUv01;
    float4 controlUv23;
    float sigma;
    float support;
    float confidence;
    float contradiction;
    uint revision;
    uint cellKey;
    uint reserved0;
    uint reserved1;
};

struct BoundaryHashEntry
{
    uint hash;
    uint filmId;
    uint filmGeneration;
    uint cellKey;
    uint boundaryId;
};

StructuredBuffer<ConeEvent> _ConeEvents;
StructuredBuffer<uint> _ClassifiedIndices;
StructuredBuffer<uint> _ClassCounters;
StructuredBuffer<ContactFilmHeader> _FilmHeaders;
RWStructuredBuffer<ContactBoundaryHeader> _BoundaryHeaders;
RWStructuredBuffer<float4> _BoundaryInformation;
RWStructuredBuffer<BoundaryHashEntry> _BoundaryHash;
RWStructuredBuffer<uint> _BoundaryAllocator;
RWStructuredBuffer<int> _BoundaryFrameAccumulator;
RWStructuredBuffer<uint> _BoundaryDirtyFlags;
RWStructuredBuffer<uint> _DirtyBoundaryIndices;
RWStructuredBuffer<uint> _BoundaryDirtyState;
RWStructuredBuffer<uint3> _BoundarySolveArguments;

uint _BoundaryCapacity;
uint _HashMask;
uint _EventCapacity;
uint _CellsPerAxis;
uint _PersistentSupport;

static const uint CLASS_BOUNDARY = 6u;
static const uint BOUNDARY_ACTIVE = 1u;
static const uint BOUNDARY_UNCERTAIN = 2u;
static const uint BOUNDARY_DIRTY = 4u;
static const uint BOUNDARY_PERSISTENT = 8u;
static const uint WORDS_PER_BOUNDARY = 16u;
static const float MOMENT_SCALE = 65536.0;
static const float SUPPORT_SCALE = 4096.0;

uint HashKey(uint filmId, uint generation, uint cellKey)
{
    uint value = filmId * 0x9e3779b9u;
    value ^= generation + 0x85ebca6bu + (value << 6u) + (value >> 2u);
    value ^= cellKey + 0xc2b2ae35u + (value << 6u) + (value >> 2u);
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    return max(1u, value & 0x7fffffffu);
}

void AtomicAddScaled(uint address, float value, float scale)
{
    int quantized = (int)round(clamp(value * scale,
        -2140000000.0, 2140000000.0));
    if (quantized != 0)
        InterlockedAdd(_BoundaryFrameAccumulator[address], quantized);
}

void MarkDirty(uint boundaryIndex)
{
    uint prior;
    InterlockedCompareExchange(_BoundaryDirtyFlags[boundaryIndex], 0u, 1u, prior);
    if (prior != 0u) return;
    uint slot;
    InterlockedAdd(_BoundaryDirtyState[0], 1u, slot);
    if (slot < _BoundaryCapacity)
        _DirtyBoundaryIndices[slot] = boundaryIndex;
    else
        InterlockedAdd(_BoundaryDirtyState[1], 1u);
}

bool ResolveBoundary(uint filmId, uint generation, uint cellKey,
    out uint boundaryIndex)
{
    boundaryIndex = 0xffffffffu;
    uint hash = HashKey(filmId, generation, cellKey);
    uint claim = hash | 0x80000000u;
    [loop]
    for (uint probe = 0u; probe < 16u; ++probe)
    {
        uint slot = (hash + probe * 0x9e3779b9u) & _HashMask;
        uint previous;
        InterlockedCompareExchange(_BoundaryHash[slot].hash, 0u, claim, previous);
        if (previous == 0u)
        {
            uint allocated;
            InterlockedAdd(_BoundaryAllocator[0], 1u, allocated);
            if (allocated >= _BoundaryCapacity)
            {
                InterlockedAdd(_BoundaryAllocator[2], 1u);
                _BoundaryHash[slot].hash = 0u;
                return false;
            }
            InterlockedAdd(_BoundaryAllocator[1], 1u);
            uint boundaryGeneration = max(1u, _BoundaryAllocator[3]);
            ContactFilmHeader film = _FilmHeaders[filmId - 1u];
            ContactBoundaryHeader boundary = (ContactBoundaryHeader)0;
            boundary.id = allocated + 1u;
            boundary.generation = boundaryGeneration;
            boundary.chunkId = film.chunkId;
            boundary.flags = BOUNDARY_ACTIVE | BOUNDARY_UNCERTAIN |
                BOUNDARY_DIRTY;
            boundary.filmA = filmId;
            boundary.filmAGeneration = generation;
            boundary.filmB = 0u;
            boundary.filmBGeneration = 0u;
            boundary.sigma = max(0.001, film.sigmaNormal);
            boundary.revision = 0u;
            boundary.cellKey = cellKey;
            _BoundaryHeaders[allocated] = boundary;
            uint info = allocated * 3u;
            _BoundaryInformation[info + 0u] = 0.0;
            _BoundaryInformation[info + 1u] = 0.0;
            _BoundaryInformation[info + 2u] = float4(boundary.sigma, 0, 0, 0);
            _BoundaryHash[slot].filmId = filmId;
            _BoundaryHash[slot].filmGeneration = generation;
            _BoundaryHash[slot].cellKey = cellKey;
            _BoundaryHash[slot].boundaryId = allocated + 1u;
            DeviceMemoryBarrier();
            _BoundaryHash[slot].hash = hash;
            boundaryIndex = allocated;
            return true;
        }

        if (previous == claim)
        {
            [loop]
            for (uint spin = 0u; spin < 16u; ++spin)
            {
                DeviceMemoryBarrier();
                BoundaryHashEntry waiting = _BoundaryHash[slot];
                if (waiting.hash != claim)
                {
                    previous = waiting.hash;
                    break;
                }
            }
        }
        if (previous == hash)
        {
            BoundaryHashEntry existing = _BoundaryHash[slot];
            if (existing.filmId == filmId &&
                existing.filmGeneration == generation &&
                existing.cellKey == cellKey && existing.boundaryId > 0u)
            {
                boundaryIndex = existing.boundaryId - 1u;
                return boundaryIndex < _BoundaryCapacity;
            }
        }
    }
    InterlockedAdd(_BoundaryAllocator[2], 1u);
    return false;
}

[numthreads(64, 1, 1)]
void InitializeBoundaryState(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index <= _HashMask)
    {
        BoundaryHashEntry entry = (BoundaryHashEntry)0;
        _BoundaryHash[index] = entry;
    }
    if (index < _BoundaryCapacity)
    {
        uint baseWord = index * WORDS_PER_BOUNDARY;
        [unroll] for (uint word = 0u; word < WORDS_PER_BOUNDARY; ++word)
            _BoundaryFrameAccumulator[baseWord + word] = 0;
        _BoundaryDirtyFlags[index] = 0u;
        _DirtyBoundaryIndices[index] = 0u;
    }
    if (index == 0u)
    {
        [unroll] for (uint state = 0u; state < 4u; ++state)
            _BoundaryDirtyState[state] = 0u;
        _BoundarySolveArguments[0] = uint3(0u, 1u, 1u);
    }
}

[numthreads(1, 1, 1)]
void ClearBoundaryFrame(uint3 id : SV_DispatchThreadID)
{
    [unroll] for (uint state = 0u; state < 4u; ++state)
        _BoundaryDirtyState[state] = 0u;
    _BoundarySolveArguments[0] = uint3(0u, 1u, 1u);
}

[numthreads(64, 1, 1)]
void AccumulateBoundaryEvents(uint3 id : SV_DispatchThreadID)
{
    uint count = min(_ClassCounters[CLASS_BOUNDARY], _EventCapacity);
    if (id.x >= count) return;
    uint eventIndex = _ClassifiedIndices[CLASS_BOUNDARY * _EventCapacity + id.x];
    ConeEvent eventData = _ConeEvents[eventIndex];
    if (eventData.classification != CLASS_BOUNDARY || eventData.filmId == 0u ||
        eventData.filmGeneration == 0u || eventData.boundaryEvidence <= 0.0) return;
    ContactFilmHeader film = _FilmHeaders[eventData.filmId - 1u];
    if (film.id != eventData.filmId || film.generation != eventData.filmGeneration)
        return;

    float2 uv = saturate(eventData.predictedUv);
    uint2 cell = min((uint2)(uv * (float)_CellsPerAxis),
        _CellsPerAxis - 1u);
    uint cellKey = cell.x | (cell.y << 16u);
    uint boundaryIndex;
    if (!ResolveBoundary(eventData.filmId, eventData.filmGeneration,
        cellKey, boundaryIndex)) return;
    MarkDirty(boundaryIndex);

    float weight = saturate(eventData.boundaryEvidence) *
        saturate(eventData.confidence);
    uint baseWord = boundaryIndex * WORDS_PER_BOUNDARY;
    AtomicAddScaled(baseWord + 0u, weight * uv.x, MOMENT_SCALE);
    AtomicAddScaled(baseWord + 1u, weight * uv.y, MOMENT_SCALE);
    AtomicAddScaled(baseWord + 2u, weight * uv.x * uv.x, MOMENT_SCALE);
    AtomicAddScaled(baseWord + 3u, weight * uv.x * uv.y, MOMENT_SCALE);
    AtomicAddScaled(baseWord + 4u, weight * uv.y * uv.y, MOMENT_SCALE);
    AtomicAddScaled(baseWord + 5u, weight, SUPPORT_SCALE);
    InterlockedAdd(_BoundaryFrameAccumulator[baseWord + 6u], 1);
    AtomicAddScaled(baseWord + 7u, eventData.boundaryEvidence, SUPPORT_SCALE);
    AtomicAddScaled(baseWord + 8u, eventData.footprintArea, MOMENT_SCALE);
}

[numthreads(1, 1, 1)]
void BuildBoundarySolveArguments(uint3 id : SV_DispatchThreadID)
{
    uint count = min(_BoundaryDirtyState[0], _BoundaryCapacity);
    _BoundarySolveArguments[0] = uint3((count + 63u) / 64u, 1u, 1u);
}

[numthreads(64, 1, 1)]
void SolveDirtyBoundaries(uint3 id : SV_DispatchThreadID)
{
    uint dirtyCount = min(_BoundaryDirtyState[0], _BoundaryCapacity);
    if (id.x >= dirtyCount) return;
    uint boundaryIndex = _DirtyBoundaryIndices[id.x];
    if (boundaryIndex >= _BoundaryCapacity) return;
    uint baseWord = boundaryIndex * WORDS_PER_BOUNDARY;
    uint info = boundaryIndex * 3u;
    ContactBoundaryHeader boundary = _BoundaryHeaders[boundaryIndex];
    float4 moments0 = _BoundaryInformation[info + 0u];
    float4 moments1 = _BoundaryInformation[info + 1u];
    float frameSupport = max(0.0,
        (float)_BoundaryFrameAccumulator[baseWord + 5u] / SUPPORT_SCALE);
    moments0 += float4(
        (float)_BoundaryFrameAccumulator[baseWord + 0u] / MOMENT_SCALE,
        (float)_BoundaryFrameAccumulator[baseWord + 1u] / MOMENT_SCALE,
        (float)_BoundaryFrameAccumulator[baseWord + 2u] / MOMENT_SCALE,
        (float)_BoundaryFrameAccumulator[baseWord + 3u] / MOMENT_SCALE);
    moments1.x += (float)_BoundaryFrameAccumulator[baseWord + 4u] / MOMENT_SCALE;
    moments1.y += frameSupport;
    moments1.z += (float)max(0, _BoundaryFrameAccumulator[baseWord + 6u]);
    moments1.w += (float)_BoundaryFrameAccumulator[baseWord + 7u] / SUPPORT_SCALE;
    float support = max(moments1.y, 1e-6);
    float2 mean = moments0.xy / support;
    float covarianceUU = max(0.0, moments0.z / support - mean.x * mean.x);
    float covarianceUV = moments0.w / support - mean.x * mean.y;
    float covarianceVV = max(0.0, moments1.x / support - mean.y * mean.y);
    float angle = 0.5 * atan2(2.0 * covarianceUV,
        covarianceUU - covarianceVV);
    float2 direction = float2(cos(angle), sin(angle));
    float trace = covarianceUU + covarianceVV;
    float discriminant = sqrt(max(0.0,
        (covarianceUU - covarianceVV) * (covarianceUU - covarianceVV) +
        4.0 * covarianceUV * covarianceUV));
    float majorVariance = 0.5 * (trace + discriminant);
    float minorVariance = max(0.0, 0.5 * (trace - discriminant));
    float cellSize = 1.0 / max(1.0, (float)_CellsPerAxis);
    float halfLength = clamp(2.0 * sqrt(max(majorVariance, 1e-8)),
        0.2 * cellSize, 1.5 * cellSize);
    float2 start = saturate(mean - direction * halfLength);
    float2 end = saturate(mean + direction * halfLength);
    boundary.controlUv01 = float4(start, lerp(start, end, 1.0 / 3.0));
    boundary.controlUv23 = float4(lerp(start, end, 2.0 / 3.0), end);
    boundary.support = support;
    boundary.revision = boundary.revision == 0xffffffffu ? 1u :
        boundary.revision + 1u;
    float averageEvidence = saturate(moments1.w /
        max(moments1.z, 1.0));
    boundary.confidence = saturate((1.0 - exp(-(float)boundary.revision / 4.0)) *
        averageEvidence);
    boundary.sigma = max(0.0005, sqrt(minorVariance));
    boundary.flags |= BOUNDARY_ACTIVE | BOUNDARY_DIRTY;
    if (boundary.revision >= _PersistentSupport && boundary.confidence >= 0.35)
    {
        boundary.flags |= BOUNDARY_PERSISTENT;
        boundary.flags &= ~BOUNDARY_UNCERTAIN;
    }
    _BoundaryHeaders[boundaryIndex] = boundary;
    _BoundaryInformation[info + 0u] = moments0;
    _BoundaryInformation[info + 1u] = moments1;
    _BoundaryInformation[info + 2u] = float4(boundary.sigma,
        boundary.confidence, majorVariance, minorVariance);

    [unroll] for (uint word = 0u; word < WORDS_PER_BOUNDARY; ++word)
        _BoundaryFrameAccumulator[baseWord + word] = 0;
    _BoundaryDirtyFlags[boundaryIndex] = 0u;
}
