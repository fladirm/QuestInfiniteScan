#pragma kernel ClearHalfEdgeBoundaryClaims
#pragma kernel ClaimBoundaryHalfEdges
#pragma kernel CommitBoundaryCurves

#include "PressureManifoldAtlasAbi.hlsl"
#include "BoundaryCurveAtlasAbi.hlsl"
#include "SurfaceChartGeometry.hlsl"

struct BoundaryHashEntry
{
    uint hash; uint filmId; uint filmGeneration; uint cellKey; uint boundaryId;
};

StructuredBuffer<AtlasContactFilmHeader> _FilmHeadersRead;
RWStructuredBuffer<AtlasContactFilmHeader> _FilmHeaders;
RWStructuredBuffer<AtlasContactBoundaryHeader> _BoundaryHeaders;
StructuredBuffer<float4> _BoundaryInformation;
StructuredBuffer<uint> _BoundaryAllocator;
StructuredBuffer<AtlasFilmMembership> _FilmMemberships;
StructuredBuffer<SupportContourSegment> _SupportContours;
RWStructuredBuffer<SurfaceHalfEdge> _HalfEdges;
RWStructuredBuffer<ContinuationEvidence> _ContinuationEvidence;
StructuredBuffer<uint> _HalfEdgeHashHeads;
StructuredBuffer<uint> _HalfEdgeHashNext;
RWStructuredBuffer<uint> _HalfEdgeBoundaryClaims;
StructuredBuffer<uint> _HalfEdgeBoundaryClaimsRead;
RWStructuredBuffer<BoundaryCurveTopology> _BoundaryCurveTopology;
RWStructuredBuffer<BoundaryCurveCache> _BoundaryCurveCache;
RWStructuredBuffer<BoundaryHashEntry> _BoundaryHash;
RWStructuredBuffer<uint> _ManifoldDiagnostics;

uint _FilmCapacity;
uint _BoundaryCapacity;
uint _BoundaryHashMask;
uint _BoundaryCellsPerAxis;
uint _HalfEdgeCapacity;
uint _HalfEdgeHashCapacity;
uint _ContourSegmentCapacity;
float _BoundaryAttachFloor;

static const uint INFORMATION_RECORDS = 9u;
static const uint CONTOUR_ACTIVE = 1u;
static const uint CONTOUR_MEASURED = 1u << 1u;
static const uint FILM_ACTIVE = 1u;
static const uint EVIDENCE_GEOMETRY = 1u << 0u;
static const uint EVIDENCE_SIDEDNESS = 1u << 1u;
static const uint EVIDENCE_FIRST_HIT = 1u << 2u;
static const uint EVIDENCE_VISIBILITY = 1u << 3u;
static const uint EVIDENCE_MULTIVIEW = 1u << 4u;
static const uint EVIDENCE_POSE_CALIBRATION = 1u << 5u;
static const uint EVIDENCE_BOUNDARY_SHARED = 1u << 6u;
static const uint EVIDENCE_COMMITTABLE = 1u << 8u;

uint HashCell(int3 cell)
{
    uint value = asuint(cell.x) * 0x8da6b343u;
    value ^= asuint(cell.y) * 0xd8163841u;
    value ^= asuint(cell.z) * 0xcb1ab31fu;
    value ^= value >> 16u; value *= 0x7feb352du; value ^= value >> 15u;
    return max(1u, value);
}

int3 WorldCell(float3 worldPosition)
{
    return (int3)floor(worldPosition / 0.0125);
}

uint BoundaryHashKey(uint filmId, uint generation, uint cellKey)
{
    uint value = filmId * 0x9e3779b9u;
    value ^= generation + 0x85ebca6bu + (value << 6u) + (value >> 2u);
    value ^= cellKey + 0xc2b2ae35u + (value << 6u) + (value >> 2u);
    value ^= value >> 16u; value *= 0x7feb352du; value ^= value >> 15u;
    return max(1u, value & 0x7fffffffu);
}

float3 FilmPoint(AtlasContactFilmHeader film, float2 uv)
{
    return AtlasSurfacePoint(film, uv);
}

float2 FilmUv(AtlasContactFilmHeader film, float3 worldPosition)
{
    float3 delta = worldPosition - film.origin;
    float u = dot(delta, film.tangentU) / max(2.0 * film.extentU, 1e-6) + 0.5;
    float v = dot(delta, film.tangentV) / max(2.0 * film.extentV, 1e-6) + 0.5;
    return saturate(float2(u, v));
}

float3 WorldControl(uint boundaryIndex, uint control)
{
    return _BoundaryInformation[boundaryIndex * INFORMATION_RECORDS + 3u +
        control].xyz;
}

float3 WorldCubic(uint boundaryIndex, float t)
{
    float s = 1.0 - t;
    return s * s * s * WorldControl(boundaryIndex, 0u) +
        3.0 * s * s * t * WorldControl(boundaryIndex, 1u) +
        3.0 * s * t * t * WorldControl(boundaryIndex, 2u) +
        t * t * t * WorldControl(boundaryIndex, 3u);
}

float2 UvCubic(AtlasContactBoundaryHeader boundary, float t)
{
    float s = 1.0 - t;
    return s * s * s * boundary.controlUv01.xy +
        3.0 * s * s * t * boundary.controlUv01.zw +
        3.0 * s * t * t * boundary.controlUv23.xy +
        t * t * t * boundary.controlUv23.zw;
}

bool ActiveEdge(uint index, out SurfaceHalfEdge edge,
    out SupportContourSegment segment)
{
    edge = (SurfaceHalfEdge)0; segment = (SupportContourSegment)0;
    if (index >= _HalfEdgeCapacity || index >= _ContourSegmentCapacity) return false;
    edge = _HalfEdges[index]; segment = _SupportContours[index];
    return (edge.flags & (HALF_EDGE_ACTIVE | HALF_EDGE_MEASURED)) ==
            (HALF_EDGE_ACTIVE | HALF_EDGE_MEASURED) &&
        segment.id == index + 1u && segment.generation == edge.generation &&
        (segment.flags & (CONTOUR_ACTIVE | CONTOUR_MEASURED)) ==
            (CONTOUR_ACTIVE | CONTOUR_MEASURED) &&
        segment.filmId == edge.filmId && segment.filmGeneration == edge.filmGeneration;
}

float PointSegmentDistance(float3 samplePosition, float3 a, float3 b)
{
    float3 edge = b - a;
    float t = saturate(dot(samplePosition - a, edge) /
        max(dot(edge, edge), 1e-12));
    return distance(samplePosition, lerp(a, b, t));
}

uint FindBoundaryHalfEdge(uint boundaryIndex, uint requiredFilmId,
    uint excludedFilmId, uint manifoldId, uint manifoldGeneration,
    out float bestResidual)
{
    float3 samples[5];
    [unroll] for (uint sample = 0u; sample < 5u; ++sample)
        samples[sample] = WorldCubic(boundaryIndex, (float)sample * 0.25);
    uint best = ATLAS_INVALID; bestResidual = 3.402823466e+38;
    [loop] for (uint sample = 0u; sample < 5u; ++sample)
    {
        int3 centre = WorldCell(samples[sample]);
        [loop] for (int z = -1; z <= 1; ++z)
        [loop] for (int y = -1; y <= 1; ++y)
        [loop] for (int x = -1; x <= 1; ++x)
        {
            uint key = HashCell(centre + int3(x, y, z));
            uint other = _HalfEdgeHashHeads[key & (_HalfEdgeHashCapacity - 1u)];
            [loop]
            for (uint chain = 0u; chain < 128u && other != ATLAS_INVALID; ++chain)
            {
                SurfaceHalfEdge edge; SupportContourSegment segment;
                if (ActiveEdge(other, edge, segment) &&
                    edge.manifoldId == manifoldId &&
                    edge.manifoldGeneration == manifoldGeneration &&
                    (requiredFilmId == 0u || edge.filmId == requiredFilmId) &&
                    edge.filmId != excludedFilmId && edge.filmId <= _FilmCapacity)
                {
                    AtlasContactFilmHeader film = _FilmHeadersRead[edge.filmId - 1u];
                    if (film.id == edge.filmId && film.generation == edge.filmGeneration &&
                        (film.flags & FILM_ACTIVE) != 0u)
                    {
                        float3 p0 = FilmPoint(film, segment.uv01.xy);
                        float3 p1 = FilmPoint(film, segment.uv01.zw);
                        float residual = PointSegmentDistance(samples[sample], p0, p1);
                        float boundarySigma = max(
                            _BoundaryInformation[boundaryIndex *
                                INFORMATION_RECORDS + 3u].w, 0.00025);
                        float gate = _BoundaryAttachFloor + 3.0 *
                            sqrt(segment.sigma * segment.sigma +
                                boundarySigma * boundarySigma) +
                            0.75 * segment.bandwidth;
                        if (residual <= gate && residual < bestResidual)
                        {
                            bestResidual = residual; best = other;
                        }
                    }
                }
                other = other < _HalfEdgeCapacity ? _HalfEdgeHashNext[other] :
                    ATLAS_INVALID;
            }
        }
    }
    return best;
}

float4 Segment(float2 a, float2 b) { return float4(a, b); }

void FillCurveCache(uint boundaryIndex, AtlasContactBoundaryHeader boundary,
    AtlasContactFilmHeader filmB, bool hasB, out BoundaryCurveCache cache)
{
    cache = (BoundaryCurveCache)0;
    cache.boundaryId = boundary.id; cache.boundaryGeneration = boundary.generation;
    cache.filmA = boundary.filmA; cache.filmAGeneration = boundary.filmAGeneration;
    cache.filmB = hasB ? filmB.id : 0u;
    cache.filmBGeneration = hasB ? filmB.generation : 0u;
    float2 a[5]; float2 b[5];
    [unroll] for (uint sample = 0u; sample < 5u; ++sample)
    {
        float t = (float)sample * 0.25;
        a[sample] = UvCubic(boundary, t);
        b[sample] = hasB ? FilmUv(filmB, WorldCubic(boundaryIndex, t)) : 0.0;
    }
    cache.segmentA0 = Segment(a[0], a[1]);
    cache.segmentA1 = Segment(a[1], a[2]);
    cache.segmentA2 = Segment(a[2], a[3]);
    cache.segmentA3 = Segment(a[3], a[4]);
    cache.segmentB0 = Segment(b[0], b[1]);
    cache.segmentB1 = Segment(b[1], b[2]);
    cache.segmentB2 = Segment(b[2], b[3]);
    cache.segmentB3 = Segment(b[3], b[4]);
    cache.flags = BOUNDARY_TOPOLOGY_ACTIVE |
        (hasB ? BOUNDARY_TOPOLOGY_SHARED : 0u);
    cache.revision = boundary.revision;
}

void InsertBoundaryHash(uint filmId, uint filmGeneration, uint cellKey,
    uint boundaryId)
{
    uint hash = BoundaryHashKey(filmId, filmGeneration, cellKey);
    [loop] for (uint probe = 0u; probe < 32u; ++probe)
    {
        uint slot = (hash + probe * 0x9e3779b9u) & _BoundaryHashMask;
        uint observed;
        InterlockedCompareExchange(_BoundaryHash[slot].hash, 0u, hash, observed);
        if (observed == 0u || observed == hash)
        {
            BoundaryHashEntry current = _BoundaryHash[slot];
            if (observed == 0u || current.boundaryId == boundaryId ||
                (current.filmId == filmId && current.filmGeneration == filmGeneration &&
                    current.cellKey == cellKey))
            {
                current.hash = hash; current.filmId = filmId;
                current.filmGeneration = filmGeneration; current.cellKey = cellKey;
                current.boundaryId = boundaryId; _BoundaryHash[slot] = current;
                return;
            }
        }
    }
    InterlockedAdd(_ManifoldDiagnostics[10], 1u);
}

[numthreads(64, 1, 1)]
void ClearHalfEdgeBoundaryClaims(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _HalfEdgeCapacity) _HalfEdgeBoundaryClaims[id.x] = ATLAS_INVALID;
}

[numthreads(64, 1, 1)]
void ClaimBoundaryHalfEdges(uint3 id : SV_DispatchThreadID)
{
    uint boundaryIndex = id.x;
    uint count = min(_BoundaryAllocator[0], _BoundaryCapacity);
    if (boundaryIndex >= count) return;
    AtlasContactBoundaryHeader boundary = _BoundaryHeaders[boundaryIndex];
    if (boundary.id != boundaryIndex + 1u || boundary.filmA == 0u ||
        boundary.filmA > _FilmCapacity ||
        (boundary.flags & (BOUNDARY_ACTIVE | BOUNDARY_PERSISTENT |
            BOUNDARY_MULTIVIEW)) != (BOUNDARY_ACTIVE | BOUNDARY_PERSISTENT |
            BOUNDARY_MULTIVIEW)) return;
    AtlasFilmMembership membership = _FilmMemberships[boundary.filmA - 1u];
    if (membership.filmId != boundary.filmA ||
        membership.filmGeneration != boundary.filmAGeneration ||
        membership.manifoldId == 0u) return;
    float residualA, residualB;
    uint edgeA = FindBoundaryHalfEdge(boundaryIndex, boundary.filmA, 0u,
        membership.manifoldId, membership.manifoldGeneration, residualA);
    uint edgeB = FindBoundaryHalfEdge(boundaryIndex, 0u, boundary.filmA,
        membership.manifoldId, membership.manifoldGeneration, residualB);
    BoundaryCurveTopology topology = (BoundaryCurveTopology)0;
    topology.boundaryId = boundary.id;
    topology.boundaryGeneration = boundary.generation;
    topology.manifoldId = membership.manifoldId;
    topology.manifoldGeneration = membership.manifoldGeneration;
    topology.leftHalfEdgeId = edgeA != ATLAS_INVALID ? edgeA + 1u : 0u;
    topology.leftHalfEdgeGeneration = edgeA != ATLAS_INVALID ?
        _HalfEdges[edgeA].generation : 0u;
    topology.rightHalfEdgeId = edgeB != ATLAS_INVALID ? edgeB + 1u : 0u;
    topology.rightHalfEdgeGeneration = edgeB != ATLAS_INVALID ?
        _HalfEdges[edgeB].generation : 0u;
    topology.leftFilmId = boundary.filmA;
    topology.leftFilmGeneration = boundary.filmAGeneration;
    topology.rightFilmId = edgeB != ATLAS_INVALID ? _HalfEdges[edgeB].filmId : 0u;
    topology.rightFilmGeneration = edgeB != ATLAS_INVALID ?
        _HalfEdges[edgeB].filmGeneration : 0u;
    topology.positionResidual = max(residualA,
        edgeB != ATLAS_INVALID ? residualB : 0.0);
    topology.positionSigma = max(_BoundaryInformation[boundaryIndex *
        INFORMATION_RECORDS + 3u].w, 0.00025);
    float support = max(boundary.support, 1e-6);
    float4 physical = _BoundaryInformation[boundaryIndex *
        INFORMATION_RECORDS + 8u] / support;
    topology.firstHitScore = saturate(physical.x);
    topology.visibilityScore = saturate(physical.y);
    topology.poseCalibrationQuality = saturate(physical.z);
    topology.sidednessScore = saturate(physical.w);
    topology.independentViewMask = boundary.viewBinMask;
    topology.flags = BOUNDARY_TOPOLOGY_ACTIVE |
        BOUNDARY_TOPOLOGY_DIRTY_CACHE |
        (edgeA != ATLAS_INVALID ? BOUNDARY_TOPOLOGY_LEFT : 0u) |
        (edgeB != ATLAS_INVALID ? BOUNDARY_TOPOLOGY_RIGHT : 0u) |
        (countbits(boundary.viewBinMask) >= 2u ? BOUNDARY_TOPOLOGY_MULTIVIEW : 0u);
    topology.revision = boundary.revision;
    _BoundaryCurveTopology[boundaryIndex] = topology;
    if (edgeA != ATLAS_INVALID)
        InterlockedMin(_HalfEdgeBoundaryClaims[edgeA], boundaryIndex);
    if (edgeB != ATLAS_INVALID)
        InterlockedMin(_HalfEdgeBoundaryClaims[edgeB], boundaryIndex);
}

[numthreads(64, 1, 1)]
void CommitBoundaryCurves(uint3 id : SV_DispatchThreadID)
{
    uint boundaryIndex = id.x;
    uint count = min(_BoundaryAllocator[0], _BoundaryCapacity);
    if (boundaryIndex >= count) return;
    AtlasContactBoundaryHeader boundary = _BoundaryHeaders[boundaryIndex];
    BoundaryCurveTopology topology = _BoundaryCurveTopology[boundaryIndex];
    if (topology.boundaryId != boundary.id || topology.boundaryGeneration !=
        boundary.generation || (topology.flags & BOUNDARY_TOPOLOGY_ACTIVE) == 0u)
        return;
    uint edgeAIndex = topology.leftHalfEdgeId > 0u ?
        topology.leftHalfEdgeId - 1u : ATLAS_INVALID;
    uint edgeBIndex = topology.rightHalfEdgeId > 0u ?
        topology.rightHalfEdgeId - 1u : ATLAS_INVALID;
    bool ownsA = edgeAIndex < _HalfEdgeCapacity &&
        _HalfEdgeBoundaryClaimsRead[edgeAIndex] == boundaryIndex;
    bool ownsB = edgeBIndex < _HalfEdgeCapacity &&
        _HalfEdgeBoundaryClaimsRead[edgeBIndex] == boundaryIndex;
    bool quality = countbits(topology.independentViewMask) >= 2u &&
        topology.firstHitScore >= 0.15 && topology.visibilityScore >= 0.15 &&
        topology.poseCalibrationQuality >= 0.1 && topology.sidednessScore >= 0.1;
    ownsB = ownsB && quality;
    AtlasContactFilmHeader filmB = (AtlasContactFilmHeader)0;
    if (ownsB)
    {
        SurfaceHalfEdge edgeB = _HalfEdges[edgeBIndex];
        if (edgeB.filmId == 0u || edgeB.filmId > _FilmCapacity)
            ownsB = false;
        else
        {
            filmB = _FilmHeadersRead[edgeB.filmId - 1u];
            ownsB = filmB.id == edgeB.filmId &&
                filmB.generation == edgeB.filmGeneration &&
                (filmB.flags & FILM_ACTIVE) != 0u;
        }
    }

    BoundaryCurveCache cache;
    FillCurveCache(boundaryIndex, boundary, filmB, ownsB, cache);
    _BoundaryCurveCache[boundaryIndex] = cache;

    if (ownsA)
    {
        SurfaceHalfEdge edgeA = _HalfEdges[edgeAIndex];
        edgeA.boundaryId = boundary.id;
        edgeA.boundaryGeneration = boundary.generation;
        edgeA.relation = ownsB ? HALF_EDGE_CREASE : HALF_EDGE_OUTER_FRONTIER;
        edgeA.revision = max(1u, edgeA.revision + 1u);
        _HalfEdges[edgeAIndex] = edgeA;
        topology.flags |= BOUNDARY_TOPOLOGY_LEFT;
    }
    if (ownsA && ownsB)
    {
        SurfaceHalfEdge edgeA = _HalfEdges[edgeAIndex];
        SurfaceHalfEdge edgeB = _HalfEdges[edgeBIndex];
        float normalCosine = dot(_FilmHeadersRead[edgeA.filmId - 1u].normal,
            filmB.normal);
        uint relation = normalCosine >= 0.15 ? HALF_EDGE_CREASE :
            HALF_EDGE_OCCLUSION;
        edgeA.twinId = edgeB.id; edgeA.twinGeneration = edgeB.generation;
        edgeB.twinId = edgeA.id; edgeB.twinGeneration = edgeA.generation;
        edgeA.relation = relation; edgeB.relation = relation;
        edgeA.flags = (edgeA.flags & ~HALF_EDGE_OUTER) |
            HALF_EDGE_TWIN_CONFIRMED;
        edgeB.flags = (edgeB.flags & ~HALF_EDGE_OUTER) |
            HALF_EDGE_TWIN_CONFIRMED;
        edgeB.boundaryId = boundary.id;
        edgeB.boundaryGeneration = boundary.generation;
        ContinuationEvidence evidence = (ContinuationEvidence)0;
        evidence.id = edgeA.id; evidence.generation = edgeA.generation;
        evidence.filmA = edgeA.filmId;
        evidence.filmAGeneration = edgeA.filmGeneration;
        evidence.filmB = edgeB.filmId;
        evidence.filmBGeneration = edgeB.filmGeneration;
        evidence.boundaryId = boundary.id;
        evidence.boundaryGeneration = boundary.generation;
        evidence.positionResidual = topology.positionResidual;
        evidence.positionSigma = topology.positionSigma;
        evidence.normalCosine = normalCosine;
        evidence.sidednessScore = topology.sidednessScore;
        evidence.firstHitScore = topology.firstHitScore;
        evidence.visibilityScore = topology.visibilityScore;
        evidence.poseCalibrationQuality = topology.poseCalibrationQuality;
        evidence.support = boundary.support;
        evidence.independentViewMask = topology.independentViewMask;
        evidence.flags = EVIDENCE_GEOMETRY | EVIDENCE_SIDEDNESS |
            EVIDENCE_FIRST_HIT | EVIDENCE_VISIBILITY | EVIDENCE_MULTIVIEW |
            EVIDENCE_POSE_CALIBRATION | EVIDENCE_BOUNDARY_SHARED |
            EVIDENCE_COMMITTABLE;
        evidence.revision = boundary.revision;
        _ContinuationEvidence[edgeAIndex] = evidence;
        edgeA.evidenceId = evidence.id;
        edgeA.evidenceGeneration = evidence.generation;
        edgeB.evidenceId = evidence.id;
        edgeB.evidenceGeneration = evidence.generation;
        _HalfEdges[edgeAIndex] = edgeA; _HalfEdges[edgeBIndex] = edgeB;

        uint previousFilmB = boundary.filmB;
        uint previousFilmBGeneration = boundary.filmBGeneration;
        boundary.filmB = filmB.id; boundary.filmBGeneration = filmB.generation;
        if (previousFilmB != filmB.id || previousFilmBGeneration != filmB.generation)
        {
            if (previousFilmB > 0u && previousFilmB <= _FilmCapacity)
                InterlockedAdd(_FilmHeaders[previousFilmB - 1u].boundaryCount,
                    0xffffffffu);
            uint ignored;
            InterlockedCompareExchange(_FilmHeaders[filmB.id - 1u].boundaryStart,
                0u, boundary.id, ignored);
            InterlockedAdd(_FilmHeaders[filmB.id - 1u].boundaryCount, 1u);
        }
        float2 middleUvB = FilmUv(filmB, WorldCubic(boundaryIndex, 0.5));
        uint2 cellB = min((uint2)(middleUvB *
            (float)_BoundaryCellsPerAxis), _BoundaryCellsPerAxis - 1u);
        topology.cellKeyB = cellB.x | (cellB.y << 16u);
        InsertBoundaryHash(filmB.id, filmB.generation, topology.cellKeyB,
            boundary.id);
        topology.rightFilmId = filmB.id;
        topology.rightFilmGeneration = filmB.generation;
        topology.flags |= BOUNDARY_TOPOLOGY_RIGHT |
            BOUNDARY_TOPOLOGY_SHARED |
            (relation == HALF_EDGE_CREASE ? BOUNDARY_TOPOLOGY_CREASE :
                BOUNDARY_TOPOLOGY_OCCLUSION);
    }
    else if (boundary.filmB != 0u)
    {
        uint previous = boundary.filmB;
        if (previous <= _FilmCapacity)
            InterlockedAdd(_FilmHeaders[previous - 1u].boundaryCount, 0xffffffffu);
        boundary.filmB = 0u; boundary.filmBGeneration = 0u;
        topology.rightFilmId = 0u; topology.rightFilmGeneration = 0u;
        topology.rightHalfEdgeId = 0u; topology.rightHalfEdgeGeneration = 0u;
        topology.flags &= ~(BOUNDARY_TOPOLOGY_RIGHT |
            BOUNDARY_TOPOLOGY_SHARED | BOUNDARY_TOPOLOGY_CREASE |
            BOUNDARY_TOPOLOGY_OCCLUSION);
    }
    topology.cellKeyA = boundary.cellKey;
    topology.cacheGeneration = topology.cacheGeneration == 0xffffffffu ? 1u :
        topology.cacheGeneration + 1u;
    topology.flags &= ~BOUNDARY_TOPOLOGY_DIRTY_CACHE;
    _BoundaryCurveTopology[boundaryIndex] = topology;
    _BoundaryHeaders[boundaryIndex] = boundary;
}
