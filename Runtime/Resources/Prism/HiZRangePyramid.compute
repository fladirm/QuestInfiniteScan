#pragma kernel CopyHiZLevelZero
#pragma kernel ReduceHiZLevel

Texture2DArray<float2> _DepthSigma;
Texture2DArray<float> _HiZSource;
RWTexture2DArray<float> _HiZDestination;
uint2 _SourceSize;
uint2 _DestinationSize;

[numthreads(8, 8, 1)]
void CopyHiZLevelZero(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _DestinationSize) || id.z >= 2u) return;
    float range = _DepthSigma.Load(int4(id.xy, id.z, 0)).x;
    // Unknown pixels prevent conservative occlusion of every coarser region that
    // contains them. Max reduction therefore treats unknown as infinity.
    _HiZDestination[id] = range > 0.0 && isfinite(range) ? range : 3.402823e+38;
}

[numthreads(8, 8, 1)]
void ReduceHiZLevel(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _DestinationSize) || id.z >= 2u) return;
    uint2 source = id.xy * 2u;
    uint2 maximum = max(_SourceSize, 1u) - 1u;
    float a = _HiZSource.Load(int4(min(source, maximum), id.z, 0));
    float b = _HiZSource.Load(int4(min(source + uint2(1u, 0u), maximum), id.z, 0));
    float c = _HiZSource.Load(int4(min(source + uint2(0u, 1u), maximum), id.z, 0));
    float d = _HiZSource.Load(int4(min(source + 1u, maximum), id.z, 0));
    _HiZDestination[id] = max(max(a, b), max(c, d));
}
