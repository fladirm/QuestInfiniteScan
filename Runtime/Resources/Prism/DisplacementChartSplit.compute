#pragma kernel InitializeSplitDisplacement

#include "PressureManifoldAtlasAbi.hlsl"
#include "BoundaryCurveAtlasAbi.hlsl"

struct DisplacementPageHeader
{
    uint id; uint generation; uint filmId; uint filmGeneration;
    uint level; uint parentPage; uint parentCell; uint flags;
    float4 uvBounds;
    uint bestFootprintBits; uint maximumVarianceBits; uint supportFixed; uint revision;
};

struct DisplacementCell
{
    float displacement; float sigma; float support; float coverage;
    float bestPrecision; float bestFootprint; float residualVariance;
    float preHitPressure; uint preHitPressureViewMask; uint revision;
};

StructuredBuffer<AtlasContactFilmHeader> _FilmHeaders;
StructuredBuffer<EvidenceAlignedSplitPlan> _SplitPlans;
StructuredBuffer<uint> _SplitRecordIndices;
StructuredBuffer<BoundaryCurveCache> _BoundaryCurveCache;
StructuredBuffer<uint> _DisplacementAllocator;
RWStructuredBuffer<DisplacementPageHeader> _DisplacementPages;
RWStructuredBuffer<DisplacementCell> _BaseDisplacementCells;
RWStructuredBuffer<DisplacementCell> _MicroDisplacementCells;
RWStructuredBuffer<uint> _BaseChildPages;
RWStructuredBuffer<uint> _MicroChildPages;
RWStructuredBuffer<int> _BaseDisplacementCellAccumulator;
RWStructuredBuffer<uint> _DisplacementCellDirtyFlags;

uint _FilmCapacity;
uint _BasePageCapacity;
uint _MicroPageCapacity;
uint _BaseCellCapacity;
uint _MaximumMicroLevels;

static const uint PAGE_ACTIVE = 1u;
static const uint PAGE_BASE = 1u << 1u;
static const uint PAGE_MICRO = 1u << 2u;
static const uint PAGE_DIRTY = 1u << 3u;
static const uint PAGE_LINEAGE_FALLBACK = 1u << 4u;
static const uint SPLIT_RESERVED = 2u;
static const uint BASE_GRID = 16u;
static const uint MICRO_GRID = 8u;
static const uint BASE_CELLS = 256u;
static const uint MICRO_CELLS = 64u;
static const uint WORDS_PER_CELL = 11u;
static const uint ALLOCATION_CLAIM = 0xffffffffu;

float4 CachedSegment(BoundaryCurveCache cache, bool sideA, uint index)
{
    if (sideA)
        return index == 0u ? cache.segmentA0 : index == 1u ? cache.segmentA1 :
            index == 2u ? cache.segmentA2 : cache.segmentA3;
    return index == 0u ? cache.segmentB0 : index == 1u ? cache.segmentB1 :
        index == 2u ? cache.segmentB2 : cache.segmentB3;
}

float SegmentSignedDistance(float2 sampleUv, float4 segment)
{
    float2 a = segment.xy, b = segment.zw;
    float2 edge = b - a;
    float lengthSquared = max(dot(edge, edge), 1e-10);
    float t = saturate(dot(sampleUv - a, edge) / lengthSquared);
    float2 closest = lerp(a, b, t);
    float signValue = edge.x * (sampleUv.y - closest.y) -
        edge.y * (sampleUv.x - closest.x);
    return (signValue >= 0.0 ? 1.0 : -1.0) *
        distance(sampleUv, closest);
}

float SplitDistance(EvidenceAlignedSplitPlan plan,
    AtlasContactFilmHeader parent, float2 uv)
{
    if (plan.splitKind == 1u && plan.boundaryId > 0u)
    {
        BoundaryCurveCache cache = _BoundaryCurveCache[plan.boundaryId - 1u];
        bool sideA = cache.filmA == parent.id &&
            cache.filmAGeneration == parent.generation;
        bool sideB = cache.filmB == parent.id &&
            cache.filmBGeneration == parent.generation;
        if (sideA || sideB)
        {
            float best = 3.402823466e+38;
            [unroll] for (uint segment = 0u; segment < 4u; ++segment)
            {
                float value = SegmentSignedDistance(uv,
                    CachedSegment(cache, sideA, segment));
                if (abs(value) < abs(best)) best = value;
            }
            float lineSign = dot(plan.separatorUv.xy, uv) + plan.separatorUv.z;
            return abs(best) * (lineSign >= 0.0 ? 1.0 : -1.0);
        }
    }
    return dot(plan.separatorUv.xy, uv) + plan.separatorUv.z;
}

uint ChildHandle(bool micro, uint pageIndex, uint cell)
{
    return micro ? _MicroChildPages[pageIndex * MICRO_CELLS + cell] :
        _BaseChildPages[pageIndex * BASE_CELLS + cell];
}

DisplacementCell LoadCell(bool micro, uint pageIndex, uint cell)
{
    if (micro)
        return _MicroDisplacementCells[pageIndex * MICRO_CELLS + cell];
    return _BaseDisplacementCells[pageIndex * BASE_CELLS + cell];
}

DisplacementCell SampleHierarchy(uint rootHandle, float2 uv)
{
    DisplacementCell empty = (DisplacementCell)0;
    empty.bestFootprint = 3.402823466e+38;
    uint lineage = rootHandle;
    [loop]
    for (uint lineageDepth = 0u; lineageDepth < 8u && lineage != 0u;
        ++lineageDepth)
    {
        uint baseIndex = lineage - 1u;
        if (baseIndex >= _BasePageCapacity) break;
        DisplacementPageHeader root = _DisplacementPages[baseIndex];
        if ((root.flags & PAGE_ACTIVE) == 0u) break;
        bool micro = false; uint pageIndex = baseIndex;
        DisplacementPageHeader page = root;
        [loop]
        for (uint level = 0u; level < _MaximumMicroLevels; ++level)
        {
            uint grid = micro ? MICRO_GRID : BASE_GRID;
            float2 span = max(page.uvBounds.zw - page.uvBounds.xy, 1e-8);
            float2 localUv = saturate((uv - page.uvBounds.xy) / span);
            uint2 cell = min((uint2)(localUv * (float)grid), grid - 1u);
            uint child = ChildHandle(micro, pageIndex, cell.y * grid + cell.x);
            if (child == 0u || child == ALLOCATION_CLAIM) break;
            uint childIndex = child - 1u;
            if (childIndex >= _MicroPageCapacity) break;
            DisplacementPageHeader next =
                _DisplacementPages[_BasePageCapacity + childIndex];
            if ((next.flags & (PAGE_ACTIVE | PAGE_MICRO)) !=
                (PAGE_ACTIVE | PAGE_MICRO)) break;
            micro = true; pageIndex = childIndex; page = next;
        }
        uint grid = micro ? MICRO_GRID : BASE_GRID;
        float2 span = max(page.uvBounds.zw - page.uvBounds.xy, 1e-8);
        float2 localUv = saturate((uv - page.uvBounds.xy) / span);
        uint2 cell = min((uint2)(localUv * (float)grid), grid - 1u);
        DisplacementCell sample = LoadCell(micro, pageIndex,
            cell.y * grid + cell.x);
        if (sample.revision != 0u || root.parentPage == 0u) return sample;
        lineage = root.parentPage;
    }
    return empty;
}

[numthreads(64, 1, 1)]
void InitializeSplitDisplacement(uint3 id : SV_DispatchThreadID)
{
    uint childOrdinal = id.x / BASE_CELLS;
    uint cell = id.x % BASE_CELLS;
    uint splitOrdinal = childOrdinal >> 1u;
    bool positive = (childOrdinal & 1u) == 0u;
    uint parentIndex = _SplitRecordIndices[splitOrdinal];
    if (parentIndex >= _FilmCapacity) return;
    EvidenceAlignedSplitPlan plan = _SplitPlans[parentIndex];
    if (plan.transactionState != SPLIT_RESERVED) return;
    AtlasContactFilmHeader parent = _FilmHeaders[parentIndex];
    uint childIndex = positive ? plan.childFilmIndex0 : plan.childFilmIndex1;
    uint pageIndex = positive ? plan.childBasePage0 : plan.childBasePage1;
    if (childIndex >= _FilmCapacity || pageIndex >= _BasePageCapacity) return;
    AtlasContactFilmHeader child = _FilmHeaders[childIndex];
    float2 uv = (float2(cell & 15u, cell >> 4u) + 0.5) / 16.0;
    DisplacementCell inherited = SampleHierarchy(parent.displacementPage, uv);
    bool owns = (SplitDistance(plan, parent, uv) >= 0.0) == positive;
    DisplacementCell output = inherited;
    // The full parent hierarchy remains the exact immutable spatial prior.
    // Child cells start as empty overlays; later measurements replace only the
    // cells they truly resolve, so a split cannot erase close-range microdetail.
    output.displacement = 0.0;
    output.support = 0.0;
    output.coverage = owns ? inherited.coverage : 0.0;
    output.preHitPressure = 0.0;
    output.preHitPressureViewMask = 0u;
    output.revision = 0u;
    _BaseDisplacementCells[pageIndex * BASE_CELLS + cell] = output;
    _BaseChildPages[pageIndex * BASE_CELLS + cell] = 0u;
    _DisplacementCellDirtyFlags[pageIndex * BASE_CELLS + cell] = 0u;
    uint accumulator = (pageIndex * BASE_CELLS + cell) * WORDS_PER_CELL;
    [unroll] for (uint word = 0u; word < WORDS_PER_CELL; ++word)
        _BaseDisplacementCellAccumulator[accumulator + word] =
            word == 6u ? 0x7f7fffff : 0;
    if (cell == 0u)
    {
        DisplacementPageHeader page = (DisplacementPageHeader)0;
        page.id = pageIndex + 1u;
        page.generation = max(1u, _DisplacementAllocator[4]);
        page.filmId = child.id;
        page.filmGeneration = child.generation;
        page.parentPage = parent.displacementPage;
        page.parentCell = 0xffffffffu;
        page.flags = PAGE_ACTIVE | PAGE_BASE | PAGE_DIRTY |
            PAGE_LINEAGE_FALLBACK;
        page.uvBounds = float4(0.0, 0.0, 1.0, 1.0);
        page.bestFootprintBits = asuint(max(inherited.bestFootprint, 1e-12));
        page.maximumVarianceBits = asuint(max(inherited.residualVariance, 0.0));
        page.revision = 1u;
        _DisplacementPages[pageIndex] = page;
    }
}
