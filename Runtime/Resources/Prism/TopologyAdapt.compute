#pragma kernel ClearTopologyAdaptFrame
#pragma kernel SplitContactFilms
#pragma kernel BuildTopologyAdaptArguments
#pragma kernel InitializeSplitDisplacement
#pragma kernel TransferSplitBoundaries
#pragma kernel ClearTopologyBoundaryHash
#pragma kernel RehashTopologyBoundaries
#pragma kernel ClearFilmMergeHash
#pragma kernel BuildFilmMergeHash
#pragma kernel MergeCompatibleFilms
#pragma kernel BuildMergeArguments
#pragma kernel InitializeMergedDisplacement

struct ContactFilmHeader
{
    uint id; uint generation; uint chunkId; uint flags;
    float3 origin; float supportTotal;
    float3 normal; float sigmaNormal;
    float3 tangentU; float extentU;
    float3 tangentV; float extentV;
    float4 quadratic0123; float2 quadratic45;
    float confidence; float contradiction;
    uint revision; uint displacementPage; uint appearancePage;
    uint boundaryStart; uint boundaryCount;
    uint reserved0; uint reserved1; uint reserved2;
};

struct DisplacementPageHeader
{
    uint id; uint generation; uint filmId; uint filmGeneration;
    uint level; uint parentPage; uint parentCell; uint flags;
    float4 uvBounds;
    uint bestFootprintBits; uint maximumVarianceBits;
    uint supportFixed; uint revision;
};

struct DisplacementCell
{
    float displacement; float sigma; float support; float coverage;
    float bestPrecision; float bestFootprint; float residualVariance;
    uint revision;
};

struct ContactTopologyEvidence
{
    float positiveMoment; float positiveSupport;
    float negativeMoment; float negativeSupport;
    float residualVariance; float boundarySupport; float totalSupport;
    uint revision;
};

struct ContactBoundaryHeader
{
    uint id; uint generation; uint chunkId; uint flags;
    uint filmA; uint filmAGeneration; uint filmB; uint filmBGeneration;
    float4 controlUv01; float4 controlUv23;
    float sigma; float support; float confidence; float contradiction;
    uint revision; uint cellKey; uint viewBinMask; uint lastSeenSequence;
};

struct BoundaryHashEntry
{
    uint hash; uint filmId; uint filmGeneration; uint cellKey; uint boundaryId;
};

struct TopologySplitRecord
{
    uint parentFilmIndex;
    uint firstChildFilmIndex;
    uint firstChildBasePage;
    uint childCount;
};

struct TopologyMergeRecord
{
    uint filmAIndex; uint filmBIndex;
    uint mergedFilmIndex; uint mergedBasePage;
    uint reserved0; uint reserved1; uint reserved2; uint reserved3;
};

struct FilmMergeHashEntry
{
    int3 cell;
    uint filmId;
    uint generation;
    uint hash;
};

RWStructuredBuffer<ContactFilmHeader> _FilmHeaders;
RWStructuredBuffer<float4> _FilmInformation;
RWStructuredBuffer<uint> _FilmAllocator;
RWStructuredBuffer<DisplacementPageHeader> _DisplacementPages;
RWStructuredBuffer<DisplacementCell> _BaseDisplacementCells;
RWStructuredBuffer<DisplacementCell> _MicroDisplacementCells;
RWStructuredBuffer<uint> _BaseChildPages;
RWStructuredBuffer<uint> _MicroChildPages;
RWStructuredBuffer<uint> _DisplacementAllocator;
RWStructuredBuffer<int> _DisplacementCellAccumulator;
RWStructuredBuffer<uint> _DisplacementCellDirtyFlags;
RWStructuredBuffer<ContactTopologyEvidence> _TopologyEvidence;
StructuredBuffer<uint> _DirtyTopologyIndices;
StructuredBuffer<uint> _TopologyState;
RWStructuredBuffer<ContactBoundaryHeader> _BoundaryHeaders;
RWStructuredBuffer<float4> _BoundaryInformation;
RWStructuredBuffer<BoundaryHashEntry> _BoundaryHash;
RWStructuredBuffer<uint> _BoundaryAllocator;
RWStructuredBuffer<TopologySplitRecord> _SplitRecords;
RWStructuredBuffer<TopologyMergeRecord> _MergeRecords;
RWStructuredBuffer<FilmMergeHashEntry> _FilmMergeHash;
RWStructuredBuffer<uint> _AdaptState;
RWStructuredBuffer<uint3> _AdaptDispatchArguments;

uint _FilmCapacity;
uint _BasePageCapacity;
uint _MicroPageCapacity;
uint _BaseCellCapacity;
uint _MaximumMicroLevels;
uint _BoundaryCapacity;
uint _BoundaryHashMask;
uint _BoundaryCellsPerAxis;
uint _MaximumSplitDepth;
float _MinimumSplitExtent;
float _BimodalSeparation;
float _SplitVariance;
float _SplitBoundarySupport;
uint _FilmMergeHashMask;
float _MergeHashCellSize;
float _MergeNormalCosine;
float _MergeSurfaceGap;

static const uint FILM_ACTIVE = 1u;
static const uint FILM_ONE_SIDED = 2u;
static const uint FILM_UNCERTAIN = 4u;
static const uint FILM_DIRTY_GEOMETRY = 8u;
static const uint FILM_DIRTY_MESHLET = 16u;
static const uint FILM_HAS_DISPLACEMENT = 32u;
static const uint FILM_SPLIT_PARENT = 64u;
static const uint FILM_RETIRED = 128u;
static const uint FILM_TOPOLOGY_LOCKED = 256u;
static const uint PAGE_ACTIVE = 1u;
static const uint PAGE_BASE = 2u;
static const uint PAGE_DIRTY = 8u;
static const uint BOUNDARY_ACTIVE = 1u;
static const uint BOUNDARY_DIRTY = 4u;
static const uint BOUNDARY_RETIRED = 16u;
static const uint BASE_GRID = 16u;
static const uint MICRO_GRID = 8u;
static const uint BASE_CELLS_PER_PAGE = 256u;
static const uint MICRO_CELLS_PER_PAGE = 64u;
static const uint INFORMATION_RECORDS = 8u;
static const uint WORDS_PER_CELL = 8u;
static const uint ALLOCATION_CLAIM = 0xffffffffu;

uint UpperIndex(uint row, uint column)
{
    return row * 6u - (row * (row - 1u)) / 2u + (column - row);
}

float LoadH(uint info, uint row, uint column)
{
    uint packed = UpperIndex(min(row, column), max(row, column));
    return _FilmInformation[info + (packed >> 2u)][packed & 3u];
}

float LoadG(uint info, uint index)
{
    return index < 4u ? _FilmInformation[info + 6u][index] :
        _FilmInformation[info + 7u][index - 4u];
}

void StoreInformation(uint info, float H[36], float g[6],
    float4 countSupport, float4 quality)
{
    _FilmInformation[info + 0u] = float4(H[0], H[1], H[2], H[3]);
    _FilmInformation[info + 1u] = float4(H[4], H[5], H[7], H[8]);
    _FilmInformation[info + 2u] = float4(H[9], H[10], H[11], H[14]);
    _FilmInformation[info + 3u] = float4(H[15], H[16], H[17], H[21]);
    _FilmInformation[info + 4u] = float4(H[22], H[23], H[28], H[29]);
    _FilmInformation[info + 5u] = float4(H[35], 0.0, 0.0, 0.0);
    _FilmInformation[info + 6u] = float4(g[0], g[1], g[2], g[3]);
    _FilmInformation[info + 7u] = float4(g[4], g[5],
        countSupport.z, countSupport.w);
    _FilmInformation[info + 8u] = quality;
}

float Height(ContactFilmHeader film, float u, float v)
{
    return film.quadratic0123.x + film.quadratic0123.y * u +
        film.quadratic0123.z * v + film.quadratic0123.w * u * u +
        film.quadratic45.x * u * v + film.quadratic45.y * v * v;
}

bool IsMicroCell(uint globalCell) { return globalCell >= _BaseCellCapacity; }

DisplacementCell LoadCell(uint globalCell)
{
    return IsMicroCell(globalCell)
        ? _MicroDisplacementCells[globalCell - _BaseCellCapacity]
        : _BaseDisplacementCells[globalCell];
}

uint LoadChild(uint globalCell)
{
    return IsMicroCell(globalCell)
        ? _MicroChildPages[globalCell - _BaseCellCapacity]
        : _BaseChildPages[globalCell];
}

uint PageHeaderIndex(bool micro, uint pageIndex)
{
    return micro ? _BasePageCapacity + pageIndex : pageIndex;
}

uint CellForPage(bool micro, uint pageIndex, uint localCell)
{
    return micro ? _BaseCellCapacity + pageIndex * MICRO_CELLS_PER_PAGE + localCell :
        pageIndex * BASE_CELLS_PER_PAGE + localCell;
}

bool ResolveLeaf(ContactFilmHeader film, float2 uv, out uint globalCell)
{
    globalCell = 0u;
    if (film.displacementPage == 0u || film.displacementPage == ALLOCATION_CLAIM)
        return false;
    uint pageIndex = film.displacementPage - 1u;
    if (pageIndex >= _BasePageCapacity) return false;
    bool micro = false;
    DisplacementPageHeader page = _DisplacementPages[pageIndex];
    if ((page.flags & PAGE_ACTIVE) == 0u || page.filmId != film.id ||
        page.filmGeneration != film.generation) return false;
    [loop]
    for (uint level = 0u; level <= _MaximumMicroLevels; ++level)
    {
        float2 span = max(page.uvBounds.zw - page.uvBounds.xy, 1e-8);
        float2 localUv = saturate((uv - page.uvBounds.xy) / span);
        uint grid = micro ? MICRO_GRID : BASE_GRID;
        uint2 cell = min((uint2)(localUv * (float)grid), grid - 1u);
        globalCell = CellForPage(micro, pageIndex, cell.y * grid + cell.x);
        if (level == _MaximumMicroLevels) break;
        uint child = LoadChild(globalCell);
        if (child == 0u || child == ALLOCATION_CLAIM) break;
        uint childPage = child - 1u;
        if (childPage >= _MicroPageCapacity) break;
        DisplacementPageHeader next =
            _DisplacementPages[PageHeaderIndex(true, childPage)];
        if ((next.flags & PAGE_ACTIVE) == 0u || next.filmId != film.id ||
            next.filmGeneration != film.generation) break;
        micro = true;
        pageIndex = childPage;
        page = next;
    }
    return true;
}

float QuadrantSupport(ContactFilmHeader film, uint quadrant, out float total)
{
    total = 0.0;
    if (film.displacementPage == 0u || film.displacementPage == ALLOCATION_CLAIM)
        return 0.0;
    uint page = film.displacementPage - 1u;
    if (page >= _BasePageCapacity) return 0.0;
    float selected = 0.0;
    [loop]
    for (uint cell = 0u; cell < BASE_CELLS_PER_PAGE; ++cell)
    {
        float support = max(0.0,
            _BaseDisplacementCells[page * BASE_CELLS_PER_PAGE + cell].support);
        total += support;
        uint x = cell & 15u;
        uint y = cell >> 4u;
        uint q = (x >= 8u ? 1u : 0u) | (y >= 8u ? 2u : 0u);
        if (q == quadrant) selected += support;
    }
    return selected;
}

void ChildBasisTransform(uint quadrant, out float A[36])
{
    [unroll] for (uint i = 0u; i < 36u; ++i) A[i] = 0.0;
    float uc = (quadrant & 1u) != 0u ? 0.5 : -0.5;
    float vc = (quadrant & 2u) != 0u ? 0.5 : -0.5;
    A[0 * 6 + 0] = 1.0;
    A[1 * 6 + 0] = uc; A[1 * 6 + 1] = 0.5;
    A[2 * 6 + 0] = vc; A[2 * 6 + 2] = 0.5;
    A[3 * 6 + 0] = uc * uc; A[3 * 6 + 1] = uc;
    A[3 * 6 + 3] = 0.25;
    A[4 * 6 + 0] = uc * vc; A[4 * 6 + 1] = 0.5 * vc;
    A[4 * 6 + 2] = 0.5 * uc; A[4 * 6 + 4] = 0.25;
    A[5 * 6 + 0] = vc * vc; A[5 * 6 + 2] = vc;
    A[5 * 6 + 5] = 0.25;
}

void TransformChildInformation(uint parentInfo, uint childInfo, uint quadrant,
    float fraction, float heightOffset)
{
    float parentH[36];
    float parentG[6];
    [unroll]
    for (uint row = 0u; row < 6u; ++row)
    {
        parentG[row] = LoadG(parentInfo, row);
        [unroll] for (uint column = 0u; column < 6u; ++column)
            parentH[row * 6u + column] = LoadH(parentInfo, row, column);
    }
    float A[36];
    ChildBasisTransform(quadrant, A);
    float childH[36];
    float childG[6];
    [unroll]
    for (uint row = 0u; row < 6u; ++row)
    {
        float g = 0.0;
        [unroll] for (uint source = 0u; source < 6u; ++source)
            g += A[source * 6u + row] * parentG[source];
        childG[row] = fraction * g;
        [unroll]
        for (uint column = 0u; column < 6u; ++column)
        {
            float value = 0.0;
            [unroll]
            for (uint a = 0u; a < 6u; ++a)
            [unroll]
            for (uint b = 0u; b < 6u; ++b)
                value += A[a * 6u + row] * parentH[a * 6u + b] *
                    A[b * 6u + column];
            childH[row * 6u + column] = fraction * value;
        }
    }
    [unroll] for (uint i = 0u; i < 6u; ++i)
        childG[i] -= heightOffset * childH[i];
    float4 countSupport = _FilmInformation[parentInfo + 7u];
    countSupport.zw *= fraction;
    float4 quality = _FilmInformation[parentInfo + 8u];
    StoreInformation(childInfo, childH, childG, countSupport, quality);
}

uint BoundaryHashKey(uint filmId, uint generation, uint cellKey)
{
    uint value = filmId * 0x9e3779b9u;
    value ^= generation + 0x85ebca6bu + (value << 6u) + (value >> 2u);
    value ^= cellKey + 0xc2b2ae35u + (value << 6u) + (value >> 2u);
    value ^= value >> 16u; value *= 0x7feb352du; value ^= value >> 15u;
    return max(1u, value & 0x7fffffffu);
}

[numthreads(1, 1, 1)]
void ClearTopologyAdaptFrame(uint3 id : SV_DispatchThreadID)
{
    [unroll] for (uint i = 0u; i < 8u; ++i) _AdaptState[i] = 0u;
    [unroll] for (uint i = 0u; i < 8u; ++i)
        _AdaptDispatchArguments[i] = uint3(0u, 1u, 1u);
}

[numthreads(64, 1, 1)]
void SplitContactFilms(uint3 id : SV_DispatchThreadID)
{
    uint dirtyCount = min(_TopologyState[0], _FilmCapacity);
    if (id.x >= dirtyCount) return;
    uint parentIndex = _DirtyTopologyIndices[id.x];
    if (parentIndex >= _FilmCapacity) return;
    ContactFilmHeader parent = _FilmHeaders[parentIndex];
    if ((parent.flags & FILM_ACTIVE) == 0u ||
        (parent.flags & (FILM_SPLIT_PARENT | FILM_RETIRED |
            FILM_TOPOLOGY_LOCKED)) != 0u ||
        parent.reserved2 >= _MaximumSplitDepth ||
        min(parent.extentU, parent.extentV) < _MinimumSplitExtent)
        return;
    ContactTopologyEvidence evidence = _TopologyEvidence[parentIndex];
    float positiveMean = evidence.positiveSupport > 0.0 ?
        evidence.positiveMoment / evidence.positiveSupport : 0.0;
    float negativeMean = evidence.negativeSupport > 0.0 ?
        evidence.negativeMoment / evidence.negativeSupport : 0.0;
    float separation = positiveMean - negativeMean;
    bool bimodal = evidence.positiveSupport >= 4.0 &&
        evidence.negativeSupport >= 4.0 &&
        separation >= max(_BimodalSeparation, 4.0 * parent.sigmaNormal);
    bool boundarySplit = parent.boundaryCount > 0u &&
        evidence.boundarySupport >= _SplitBoundarySupport;
    bool nonSingle = evidence.totalSupport >= 8.0 &&
        evidence.residualVariance >= _SplitVariance &&
        parent.contradiction >= 0.35;
    if (!bimodal && !boundarySplit && !nonSingle) return;

    uint firstChild;
    InterlockedAdd(_FilmAllocator[0], 4u, firstChild);
    if (firstChild > _FilmCapacity - 4u)
    {
        InterlockedAdd(_FilmAllocator[2], 4u);
        return;
    }
    uint firstPage;
    InterlockedAdd(_DisplacementAllocator[0], 4u, firstPage);
    if (firstPage > _BasePageCapacity - 4u)
    {
        InterlockedAdd(_DisplacementAllocator[2], 4u);
        return;
    }
    uint generation = max(1u, _FilmAllocator[3]);
    uint pageGeneration = max(1u, _DisplacementAllocator[4]);
    float totalPageSupport;
    QuadrantSupport(parent, 0u, totalPageSupport);
    uint parentInfo = parentIndex * 9u;
    [unroll]
    for (uint quadrant = 0u; quadrant < 4u; ++quadrant)
    {
        float ignored;
        float selected = QuadrantSupport(parent, quadrant, ignored);
        float fraction = totalPageSupport > 1e-6 ?
            selected / totalPageSupport : 0.25;
        fraction = clamp(fraction, 0.01, 0.97);
        float uc = (quadrant & 1u) != 0u ? 0.5 : -0.5;
        float vc = (quadrant & 2u) != 0u ? 0.5 : -0.5;
        float centerU = uc * parent.extentU;
        float centerV = vc * parent.extentV;
        float centerHeight = Height(parent, centerU, centerV);
        uint childIndex = firstChild + quadrant;
        ContactFilmHeader child = parent;
        child.id = childIndex + 1u;
        child.generation = generation;
        child.flags = FILM_ACTIVE | FILM_ONE_SIDED | FILM_UNCERTAIN |
            FILM_DIRTY_GEOMETRY | FILM_DIRTY_MESHLET | FILM_HAS_DISPLACEMENT;
        child.origin = parent.origin + centerU * parent.tangentU +
            centerV * parent.tangentV + centerHeight * parent.normal;
        child.supportTotal = parent.supportTotal * fraction;
        child.extentU = parent.extentU * 0.5;
        child.extentV = parent.extentV * 0.5;
        child.quadratic0123 = float4(0.0,
            parent.quadratic0123.y + 2.0 * parent.quadratic0123.w * centerU +
                parent.quadratic45.x * centerV,
            parent.quadratic0123.z + parent.quadratic45.x * centerU +
                2.0 * parent.quadratic45.y * centerV,
            parent.quadratic0123.w);
        child.quadratic45 = parent.quadratic45;
        child.contradiction *= 0.5;
        child.revision = parent.revision + 1u;
        child.displacementPage = firstPage + quadrant + 1u;
        child.boundaryStart = 0u;
        child.boundaryCount = 0u;
        child.reserved0 = parent.id;
        child.reserved1 = quadrant;
        child.reserved2 = parent.reserved2 + 1u;
        _FilmHeaders[childIndex] = child;
        TransformChildInformation(parentInfo, childIndex * 9u, quadrant,
            fraction, centerHeight);
        ContactTopologyEvidence childEvidence = evidence;
        childEvidence.positiveMoment *= fraction;
        childEvidence.positiveSupport *= fraction;
        childEvidence.negativeMoment *= fraction;
        childEvidence.negativeSupport *= fraction;
        childEvidence.boundarySupport *= fraction;
        childEvidence.totalSupport *= fraction;
        childEvidence.revision = 1u;
        _TopologyEvidence[childIndex] = childEvidence;

        DisplacementPageHeader page = (DisplacementPageHeader)0;
        page.id = firstPage + quadrant + 1u;
        page.generation = pageGeneration;
        page.filmId = child.id;
        page.filmGeneration = child.generation;
        page.flags = PAGE_ACTIVE | PAGE_BASE | PAGE_DIRTY;
        page.uvBounds = float4(0, 0, 1, 1);
        page.bestFootprintBits = asuint(3.402823466e+38);
        _DisplacementPages[firstPage + quadrant] = page;
    }
    InterlockedAdd(_FilmAllocator[1], 3u);
    parent.flags &= ~FILM_ACTIVE;
    parent.flags |= FILM_SPLIT_PARENT | FILM_RETIRED | FILM_DIRTY_MESHLET;
    parent.boundaryCount = 0u;
    parent.reserved0 = firstChild + 1u;
    parent.reserved1 = 4u;
    parent.revision = parent.revision + 1u;
    _FilmHeaders[parentIndex] = parent;
    uint splitSlot;
    InterlockedAdd(_AdaptState[0], 1u, splitSlot);
    if (splitSlot < _FilmCapacity)
    {
        TopologySplitRecord record;
        record.parentFilmIndex = parentIndex;
        record.firstChildFilmIndex = firstChild;
        record.firstChildBasePage = firstPage;
        record.childCount = 4u;
        _SplitRecords[splitSlot] = record;
    }
    else InterlockedAdd(_AdaptState[1], 1u);
}

[numthreads(1, 1, 1)]
void BuildTopologyAdaptArguments(uint3 id : SV_DispatchThreadID)
{
    uint splitCount = min(_AdaptState[0], _FilmCapacity);
    uint boundaryCount = min(_BoundaryAllocator[0], _BoundaryCapacity);
    _AdaptDispatchArguments[0] = uint3(
        (splitCount * 4u * BASE_CELLS_PER_PAGE + 63u) / 64u, 1u, 1u);
    _AdaptDispatchArguments[1] = uint3(splitCount > 0u ?
        (boundaryCount + 63u) / 64u : 0u, 1u, 1u);
    _AdaptDispatchArguments[2] = uint3(splitCount > 0u ?
        ((_BoundaryHashMask + 1u) + 63u) / 64u : 0u, 1u, 1u);
    _AdaptDispatchArguments[3] = _AdaptDispatchArguments[1];
    uint filmCount = min(_FilmAllocator[0], _FilmCapacity);
    _AdaptDispatchArguments[4] = uint3((filmCount + 63u) / 64u, 1u, 1u);
    _AdaptDispatchArguments[5] = uint3(
        ((_FilmMergeHashMask + 1u) + 63u) / 64u, 1u, 1u);
}

[numthreads(64, 1, 1)]
void InitializeSplitDisplacement(uint3 id : SV_DispatchThreadID)
{
    uint splitCount = min(_AdaptState[0], _FilmCapacity);
    uint ordinal = id.x / BASE_CELLS_PER_PAGE;
    uint localCell = id.x % BASE_CELLS_PER_PAGE;
    if (ordinal >= splitCount * 4u) return;
    uint splitIndex = ordinal / 4u;
    uint quadrant = ordinal & 3u;
    TopologySplitRecord record = _SplitRecords[splitIndex];
    ContactFilmHeader parent = _FilmHeaders[record.parentFilmIndex];
    uint childIndex = record.firstChildFilmIndex + quadrant;
    ContactFilmHeader child = _FilmHeaders[childIndex];
    uint x = localCell & 15u;
    uint y = localCell >> 4u;
    float2 childUv = (float2(x, y) + 0.5) / 16.0;
    float2 quadrantOffset = float2((quadrant & 1u) != 0u ? 1.0 : 0.0,
        (quadrant & 2u) != 0u ? 1.0 : 0.0);
    float2 parentUv = (childUv + quadrantOffset) * 0.5;
    DisplacementCell inherited = (DisplacementCell)0;
    inherited.sigma = child.sigmaNormal;
    inherited.bestFootprint = 3.402823466e+38;
    uint sourceCell;
    if (ResolveLeaf(parent, parentUv, sourceCell))
    {
        inherited = LoadCell(sourceCell);
        inherited.support *= 0.25;
        inherited.coverage *= 0.25;
        inherited.revision = 1u;
    }
    uint page = record.firstChildBasePage + quadrant;
    uint target = page * BASE_CELLS_PER_PAGE + localCell;
    _BaseDisplacementCells[target] = inherited;
    _BaseChildPages[target] = 0u;
    _DisplacementCellDirtyFlags[target] = 0u;
    uint accumulator = target * WORDS_PER_CELL;
    [unroll] for (uint word = 0u; word < WORDS_PER_CELL; ++word)
        _DisplacementCellAccumulator[accumulator + word] =
            word == 6u ? 0x7f7fffff : 0;
    InterlockedMin(_DisplacementPages[page].bestFootprintBits,
        asuint(max(inherited.bestFootprint, 1e-12)));
    InterlockedMax(_DisplacementPages[page].maximumVarianceBits,
        asuint(max(inherited.residualVariance, 0.0)));
    InterlockedAdd(_DisplacementPages[page].supportFixed,
        (uint)max(0.0, round(inherited.support * 4096.0)));
    if (localCell == 0u) _DisplacementPages[page].revision = 1u;
}

float2 TransformUvToChild(float2 uv, uint quadrant)
{
    float2 offset = float2((quadrant & 1u) != 0u ? 1.0 : 0.0,
        (quadrant & 2u) != 0u ? 1.0 : 0.0);
    return saturate(uv * 2.0 - offset);
}

float2 BoundaryUv(ContactBoundaryHeader boundary, float t)
{
    float s = 1.0 - t;
    return s * s * s * boundary.controlUv01.xy +
        3.0 * s * s * t * boundary.controlUv01.zw +
        3.0 * s * t * t * boundary.controlUv23.xy +
        t * t * t * boundary.controlUv23.zw;
}

float2 BoundaryUvDerivative(ContactBoundaryHeader boundary, float t)
{
    float2 p0 = boundary.controlUv01.xy;
    float2 p1 = boundary.controlUv01.zw;
    float2 p2 = boundary.controlUv23.xy;
    float2 p3 = boundary.controlUv23.zw;
    float s = 1.0 - t;
    return 3.0 * (s * s * (p1 - p0) + 2.0 * s * t * (p2 - p1) +
        t * t * (p3 - p2));
}

float3 BoundaryPoint3(float3 p0, float3 p1, float3 p2, float3 p3, float t)
{
    float s = 1.0 - t;
    return s * s * s * p0 + 3.0 * s * s * t * p1 +
        3.0 * s * t * t * p2 + t * t * t * p3;
}

float3 BoundaryDerivative3(float3 p0, float3 p1, float3 p2, float3 p3,
    float t)
{
    float s = 1.0 - t;
    return 3.0 * (s * s * (p1 - p0) + 2.0 * s * t * (p2 - p1) +
        t * t * (p3 - p2));
}

uint UvQuadrant(float2 uv)
{
    return (uv.x >= 0.5 ? 1u : 0u) | (uv.y >= 0.5 ? 2u : 0u);
}

void WriteSplitBoundary(uint targetIndex, ContactBoundaryHeader source,
    uint quadrant, float t0, float t1, ContactFilmHeader child,
    float4 originalInfo[INFORMATION_RECORDS])
{
    float dt = max(t1 - t0, 1.0 / 32.0);
    float2 q0 = BoundaryUv(source, t0);
    float2 q3 = BoundaryUv(source, t1);
    float2 q1 = q0 + BoundaryUvDerivative(source, t0) * (dt / 3.0);
    float2 q2 = q3 - BoundaryUvDerivative(source, t1) * (dt / 3.0);
    ContactBoundaryHeader segment = source;
    segment.id = targetIndex + 1u;
    if (targetIndex != source.id - 1u)
        segment.generation = max(1u, _BoundaryAllocator[3]);
    segment.filmA = child.id;
    segment.filmAGeneration = child.generation;
    if (segment.filmB == source.filmA)
    {
        segment.filmB = 0u;
        segment.filmBGeneration = 0u;
    }
    segment.controlUv01 = float4(TransformUvToChild(q0, quadrant),
        TransformUvToChild(q1, quadrant));
    segment.controlUv23 = float4(TransformUvToChild(q2, quadrant),
        TransformUvToChild(q3, quadrant));
    segment.support = source.support * dt;
    segment.flags |= BOUNDARY_ACTIVE | BOUNDARY_DIRTY;
    segment.flags &= ~BOUNDARY_RETIRED;
    segment.revision = source.revision + 1u;
    float2 middle = BoundaryUv(segment, 0.5);
    uint2 cell = min((uint2)(saturate(middle) *
        (float)_BoundaryCellsPerAxis), _BoundaryCellsPerAxis - 1u);
    segment.cellKey = cell.x | (cell.y << 16u);
    _BoundaryHeaders[targetIndex] = segment;

    uint targetInfo = targetIndex * INFORMATION_RECORDS;
    float support = max(segment.support, 1e-6);
    float2 samples[4] = {
        segment.controlUv01.xy, segment.controlUv01.zw,
        segment.controlUv23.xy, segment.controlUv23.zw
    };
    float2 mean = 0.0;
    float uu = 0.0, uv = 0.0, vv = 0.0;
    [unroll]
    for (uint sample = 0u; sample < 4u; ++sample)
    {
        mean += samples[sample];
        uu += samples[sample].x * samples[sample].x;
        uv += samples[sample].x * samples[sample].y;
        vv += samples[sample].y * samples[sample].y;
    }
    mean *= 0.25; uu *= 0.25; uv *= 0.25; vv *= 0.25;
    _BoundaryInformation[targetInfo + 0u] =
        float4(mean * support, uu * support, uv * support);
    float4 info1 = originalInfo[1u];
    info1.x = vv * support;
    info1.y *= dt; info1.z *= dt; info1.w *= dt;
    _BoundaryInformation[targetInfo + 1u] = info1;
    _BoundaryInformation[targetInfo + 2u] = originalInfo[2u];

    float3 p0 = originalInfo[3u].xyz;
    float3 p1 = originalInfo[4u].xyz;
    float3 p2 = originalInfo[5u].xyz;
    float3 p3 = originalInfo[6u].xyz;
    float3 s0 = BoundaryPoint3(p0, p1, p2, p3, t0);
    float3 s3 = BoundaryPoint3(p0, p1, p2, p3, t1);
    float3 s1 = s0 + BoundaryDerivative3(p0, p1, p2, p3, t0) * (dt / 3.0);
    float3 s2 = s3 - BoundaryDerivative3(p0, p1, p2, p3, t1) * (dt / 3.0);
    _BoundaryInformation[targetInfo + 3u] = float4(s0, originalInfo[3u].w);
    _BoundaryInformation[targetInfo + 4u] = float4(s1, originalInfo[4u].w);
    _BoundaryInformation[targetInfo + 5u] = float4(s2, originalInfo[5u].w);
    _BoundaryInformation[targetInfo + 6u] = float4(s3, originalInfo[6u].w);
    float4 state = originalInfo[7u];
    state.xyz *= dt;
    _BoundaryInformation[targetInfo + 7u] = state;
    uint ignored;
    InterlockedCompareExchange(_FilmHeaders[child.id - 1u].boundaryStart,
        0u, targetIndex + 1u, ignored);
    InterlockedAdd(_FilmHeaders[child.id - 1u].boundaryCount, 1u);
}

[numthreads(64, 1, 1)]
void TransferSplitBoundaries(uint3 id : SV_DispatchThreadID)
{
    uint boundaryCount = min(_BoundaryAllocator[0], _BoundaryCapacity);
    uint boundaryIndex = id.x;
    if (boundaryIndex >= boundaryCount) return;
    ContactBoundaryHeader boundary = _BoundaryHeaders[boundaryIndex];
    if ((boundary.flags & BOUNDARY_ACTIVE) == 0u || boundary.filmA == 0u)
        return;
    uint parentIndex = boundary.filmA - 1u;
    if (parentIndex >= _FilmCapacity) return;
    ContactFilmHeader parent = _FilmHeaders[parentIndex];
    if ((parent.flags & FILM_SPLIT_PARENT) == 0u || parent.reserved1 != 4u)
        return;
    uint info = boundaryIndex * INFORMATION_RECORDS;
    float4 originalInfo[INFORMATION_RECORDS];
    [unroll] for (uint record = 0u; record < INFORMATION_RECORDS; ++record)
        originalInfo[record] = _BoundaryInformation[info + record];
    bool wroteOriginal = false;
    [unroll]
    for (uint quadrant = 0u; quadrant < 4u; ++quadrant)
    {
        uint firstSample = 33u;
        uint lastSample = 0u;
        [unroll]
        for (uint sample = 0u; sample <= 32u; ++sample)
        {
            float t = (float)sample / 32.0;
            if (UvQuadrant(BoundaryUv(boundary, t)) != quadrant) continue;
            firstSample = min(firstSample, sample);
            lastSample = max(lastSample, sample);
        }
        if (firstSample > 32u) continue;
        float t0 = (float)(firstSample > 0u ? firstSample - 1u : 0u) / 32.0;
        float t1 = (float)min(32u, lastSample + 1u) / 32.0;
        uint target = boundaryIndex;
        if (wroteOriginal)
        {
            InterlockedAdd(_BoundaryAllocator[0], 1u, target);
            if (target >= _BoundaryCapacity)
            {
                InterlockedAdd(_BoundaryAllocator[2], 1u);
                continue;
            }
            InterlockedAdd(_BoundaryAllocator[1], 1u);
        }
        uint childIndex = parent.reserved0 - 1u + quadrant;
        if (childIndex >= _FilmCapacity) continue;
        WriteSplitBoundary(target, boundary, quadrant, t0, t1,
            _FilmHeaders[childIndex], originalInfo);
        wroteOriginal = true;
        InterlockedAdd(_AdaptState[2], 1u);
    }
    if (!wroteOriginal)
    {
        boundary.flags &= ~BOUNDARY_ACTIVE;
        boundary.flags |= BOUNDARY_RETIRED;
        _BoundaryHeaders[boundaryIndex] = boundary;
        InterlockedAdd(_BoundaryAllocator[1], 0xffffffffu);
    }
}

[numthreads(64, 1, 1)]
void ClearTopologyBoundaryHash(uint3 id : SV_DispatchThreadID)
{
    if (id.x <= _BoundaryHashMask) _BoundaryHash[id.x] = (BoundaryHashEntry)0;
}

[numthreads(64, 1, 1)]
void RehashTopologyBoundaries(uint3 id : SV_DispatchThreadID)
{
    uint count = min(_BoundaryAllocator[0], _BoundaryCapacity);
    uint index = id.x;
    if (index >= count) return;
    ContactBoundaryHeader boundary = _BoundaryHeaders[index];
    if ((boundary.flags & BOUNDARY_ACTIVE) == 0u ||
        (boundary.flags & BOUNDARY_RETIRED) != 0u || boundary.filmA == 0u)
        return;
    uint hash = BoundaryHashKey(boundary.filmA, boundary.filmAGeneration,
        boundary.cellKey);
    [loop]
    for (uint probe = 0u; probe < 32u; ++probe)
    {
        uint slot = (hash + probe * 0x9e3779b9u) & _BoundaryHashMask;
        uint observed;
        InterlockedCompareExchange(_BoundaryHash[slot].hash, 0u, hash, observed);
        if (observed == 0u || observed == hash)
        {
            BoundaryHashEntry entry;
            entry.hash = hash;
            entry.filmId = boundary.filmA;
            entry.filmGeneration = boundary.filmAGeneration;
            entry.cellKey = boundary.cellKey;
            entry.boundaryId = boundary.id;
            _BoundaryHash[slot] = entry;
            return;
        }
    }
    InterlockedAdd(_AdaptState[3], 1u);
}

uint FilmCellHash(int3 cell)
{
    uint value = asuint(cell.x) * 0x8da6b343u;
    value ^= asuint(cell.y) * 0xd8163841u;
    value ^= asuint(cell.z) * 0xcb1ab31fu;
    value ^= value >> 16u; value *= 0x7feb352du; value ^= value >> 15u;
    return max(1u, value & 0x7fffffffu);
}

int3 FilmCell(float3 position)
{
    return (int3)floor(position / max(_MergeHashCellSize, 0.05));
}

[numthreads(64, 1, 1)]
void ClearFilmMergeHash(uint3 id : SV_DispatchThreadID)
{
    if (id.x <= _FilmMergeHashMask)
        _FilmMergeHash[id.x] = (FilmMergeHashEntry)0;
}

[numthreads(64, 1, 1)]
void BuildFilmMergeHash(uint3 id : SV_DispatchThreadID)
{
    uint filmCount = min(_FilmAllocator[0], _FilmCapacity);
    uint index = id.x;
    if (index >= filmCount) return;
    ContactFilmHeader film = _FilmHeaders[index];
    if ((film.flags & FILM_ACTIVE) == 0u || film.boundaryCount != 0u ||
        film.reserved0 != 0u) return;
    int3 cell = FilmCell(film.origin);
    uint hash = FilmCellHash(cell);
    [loop]
    for (uint probe = 0u; probe < 32u; ++probe)
    {
        uint slot = (hash + probe * 0x9e3779b9u) & _FilmMergeHashMask;
        uint observed;
        InterlockedCompareExchange(_FilmMergeHash[slot].hash, 0u, hash, observed);
        if (observed == 0u)
        {
            FilmMergeHashEntry entry;
            entry.cell = cell;
            entry.filmId = film.id;
            entry.generation = film.generation;
            entry.hash = hash;
            _FilmMergeHash[slot] = entry;
            return;
        }
    }
    InterlockedAdd(_AdaptState[7], 1u);
}

bool MergeCompatible(ContactFilmHeader a, ContactFilmHeader b,
    uint aIndex, uint bIndex)
{
    if (a.id >= b.id || a.chunkId != b.chunkId ||
        (a.flags & FILM_ACTIVE) == 0u || (b.flags & FILM_ACTIVE) == 0u ||
        a.boundaryCount != 0u || b.boundaryCount != 0u ||
        a.reserved0 != 0u || b.reserved0 != 0u ||
        a.appearancePage != b.appearancePage ||
        dot(a.normal, b.normal) < _MergeNormalCosine ||
        dot(a.tangentU, b.tangentU) < _MergeNormalCosine ||
        dot(a.tangentV, b.tangentV) < _MergeNormalCosine)
        return false;
    float3 delta = b.origin - a.origin;
    float normalGap = abs(dot(delta, normalize(a.normal + b.normal)));
    if (normalGap > max(_MergeSurfaceGap,
        3.0 * max(a.sigmaNormal, b.sigmaNormal))) return false;
    if (abs(dot(delta, a.tangentU)) > a.extentU + b.extentU +
        _MergeSurfaceGap || abs(dot(delta, a.tangentV)) >
        a.extentV + b.extentV + _MergeSurfaceGap) return false;
    ContactTopologyEvidence ea = _TopologyEvidence[aIndex];
    ContactTopologyEvidence eb = _TopologyEvidence[bIndex];
    if (ea.totalSupport < 8.0 || eb.totalSupport < 8.0 ||
        ea.residualVariance > _SplitVariance * 0.25 ||
        eb.residualVariance > _SplitVariance * 0.25 ||
        a.contradiction > 0.2 || b.contradiction > 0.2)
        return false;
    return true;
}

bool LockFilm(uint index, out uint originalFlags)
{
    originalFlags = _FilmHeaders[index].flags;
    if ((originalFlags & (FILM_ACTIVE | FILM_TOPOLOGY_LOCKED)) != FILM_ACTIVE)
        return false;
    uint observed;
    InterlockedCompareExchange(_FilmHeaders[index].flags, originalFlags,
        originalFlags | FILM_TOPOLOGY_LOCKED, observed);
    return observed == originalFlags;
}

void IncludeFilmBounds(ContactFilmHeader film, float3 center, float3 tangentU,
    float3 tangentV, inout float2 minimum, inout float2 maximum)
{
    [unroll]
    for (uint corner = 0u; corner < 4u; ++corner)
    {
        float su = (corner & 1u) != 0u ? 1.0 : -1.0;
        float sv = (corner & 2u) != 0u ? 1.0 : -1.0;
        float3 point = film.origin + su * film.extentU * film.tangentU +
            sv * film.extentV * film.tangentV;
        float3 delta = point - center;
        float2 projected = float2(dot(delta, tangentU), dot(delta, tangentV));
        minimum = min(minimum, projected);
        maximum = max(maximum, projected);
    }
}

void GeneralBasisTransform(ContactFilmHeader source,
    ContactFilmHeader merged, out float A[36])
{
    [unroll] for (uint i = 0u; i < 36u; ++i) A[i] = 0.0;
    float3 offset = merged.origin - source.origin;
    float bu = dot(offset, source.tangentU) / max(source.extentU, 0.001);
    float bv = dot(offset, source.tangentV) / max(source.extentV, 0.001);
    float au = merged.extentU * dot(merged.tangentU, source.tangentU) /
        max(source.extentU, 0.001);
    float av = merged.extentV * dot(merged.tangentV, source.tangentU) /
        max(source.extentU, 0.001);
    float cu = merged.extentU * dot(merged.tangentU, source.tangentV) /
        max(source.extentV, 0.001);
    float cv = merged.extentV * dot(merged.tangentV, source.tangentV) /
        max(source.extentV, 0.001);
    A[0] = 1.0;
    A[6] = bu; A[7] = au; A[8] = av;
    A[12] = bv; A[13] = cu; A[14] = cv;
    A[18] = bu * bu; A[19] = 2.0 * bu * au;
    A[20] = 2.0 * bu * av; A[21] = au * au;
    A[22] = 2.0 * au * av; A[23] = av * av;
    A[24] = bu * bv; A[25] = au * bv + bu * cu;
    A[26] = av * bv + bu * cv; A[27] = au * cu;
    A[28] = au * cv + av * cu; A[29] = av * cv;
    A[30] = bv * bv; A[31] = 2.0 * bv * cu;
    A[32] = 2.0 * bv * cv; A[33] = cu * cu;
    A[34] = 2.0 * cu * cv; A[35] = cv * cv;
}

void AddTransformedInformation(ContactFilmHeader source,
    ContactFilmHeader merged, uint sourceInfo, inout float totalH[36],
    inout float totalG[6])
{
    float sourceH[36];
    float sourceG[6];
    [unroll]
    for (uint row = 0u; row < 6u; ++row)
    {
        sourceG[row] = LoadG(sourceInfo, row);
        [unroll] for (uint column = 0u; column < 6u; ++column)
            sourceH[row * 6u + column] = LoadH(sourceInfo, row, column);
    }
    float A[36];
    GeneralBasisTransform(source, merged, A);
    float transformedH[36];
    float heightOffset = dot(source.origin - merged.origin, merged.normal);
    [unroll]
    for (uint row = 0u; row < 6u; ++row)
    {
        float g = 0.0;
        [unroll] for (uint a = 0u; a < 6u; ++a)
            g += A[a * 6u + row] * sourceG[a];
        [unroll]
        for (uint column = 0u; column < 6u; ++column)
        {
            float value = 0.0;
            [unroll]
            for (uint a = 0u; a < 6u; ++a)
            [unroll]
            for (uint b = 0u; b < 6u; ++b)
                value += A[a * 6u + row] * sourceH[a * 6u + b] *
                    A[b * 6u + column];
            transformedH[row * 6u + column] = value;
            totalH[row * 6u + column] += value;
        }
        totalG[row] += g + heightOffset * transformedH[row * 6u];
    }
}

bool SolveSix(float matrix[36], float rhs[6], out float solution[6])
{
    float lower[36];
    [unroll] for (uint i = 0u; i < 36u; ++i) lower[i] = 0.0;
    [unroll]
    for (uint row = 0u; row < 6u; ++row)
    {
        [unroll]
        for (uint column = 0u; column <= row; ++column)
        {
            float sum = matrix[row * 6u + column];
            [unroll] for (uint k = 0u; k < column; ++k)
                sum -= lower[row * 6u + k] * lower[column * 6u + k];
            if (row == column)
            {
                if (sum <= 1e-10 || !isfinite(sum)) return false;
                lower[row * 6u + column] = sqrt(sum);
            }
            else lower[row * 6u + column] = sum /
                max(lower[column * 6u + column], 1e-8);
        }
    }
    float y[6];
    [unroll]
    for (uint row = 0u; row < 6u; ++row)
    {
        float sum = rhs[row];
        [unroll] for (uint k = 0u; k < row; ++k)
            sum -= lower[row * 6u + k] * y[k];
        y[row] = sum / max(lower[row * 6u + row], 1e-8);
    }
    for (int row = 5; row >= 0; --row)
    {
        float sum = y[row];
        for (int k = row + 1; k < 6; ++k)
            sum -= lower[k * 6 + row] * solution[k];
        solution[row] = sum / max(lower[row * 6 + row], 1e-8);
    }
    return true;
}

[numthreads(64, 1, 1)]
void MergeCompatibleFilms(uint3 id : SV_DispatchThreadID)
{
    uint filmCount = min(_FilmAllocator[0], _FilmCapacity);
    uint aIndex = id.x;
    if (aIndex >= filmCount) return;
    ContactFilmHeader a = _FilmHeaders[aIndex];
    if ((a.flags & FILM_ACTIVE) == 0u || a.boundaryCount != 0u ||
        a.reserved0 != 0u) return;
    int3 centerCell = FilmCell(a.origin);
    uint bIndex = 0xffffffffu;
    ContactFilmHeader b = (ContactFilmHeader)0;
    [loop]
    for (int dz = -1; dz <= 1 && bIndex == 0xffffffffu; ++dz)
    [loop]
    for (int dy = -1; dy <= 1 && bIndex == 0xffffffffu; ++dy)
    [loop]
    for (int dx = -1; dx <= 1 && bIndex == 0xffffffffu; ++dx)
    {
        int3 cell = centerCell + int3(dx, dy, dz);
        uint hash = FilmCellHash(cell);
        [loop]
        for (uint probe = 0u; probe < 32u; ++probe)
        {
            uint slot = (hash + probe * 0x9e3779b9u) & _FilmMergeHashMask;
            FilmMergeHashEntry entry = _FilmMergeHash[slot];
            if (entry.hash == 0u) break;
            if (entry.hash != hash || any(entry.cell != cell) ||
                entry.filmId == 0u || entry.filmId <= a.id) continue;
            uint candidateIndex = entry.filmId - 1u;
            if (candidateIndex >= filmCount) continue;
            ContactFilmHeader candidate = _FilmHeaders[candidateIndex];
            if (candidate.generation != entry.generation ||
                !MergeCompatible(a, candidate, aIndex, candidateIndex)) continue;
            bIndex = candidateIndex;
            b = candidate;
            break;
        }
    }
    if (bIndex == 0xffffffffu) return;
    uint flagsA, flagsB;
    if (!LockFilm(aIndex, flagsA)) return;
    if (!LockFilm(bIndex, flagsB))
    {
        _FilmHeaders[aIndex].flags = flagsA;
        return;
    }
    // Revalidate after both ordered locks were acquired.
    a = _FilmHeaders[aIndex]; b = _FilmHeaders[bIndex];
    a.flags &= ~FILM_TOPOLOGY_LOCKED;
    b.flags &= ~FILM_TOPOLOGY_LOCKED;
    if (!MergeCompatible(a, b, aIndex, bIndex))
    {
        _FilmHeaders[aIndex].flags = flagsA;
        _FilmHeaders[bIndex].flags = flagsB;
        return;
    }
    uint mergedIndex;
    InterlockedAdd(_FilmAllocator[0], 1u, mergedIndex);
    if (mergedIndex >= _FilmCapacity)
    {
        InterlockedAdd(_FilmAllocator[2], 1u);
        _FilmHeaders[aIndex].flags = flagsA;
        _FilmHeaders[bIndex].flags = flagsB;
        return;
    }
    uint mergedPage;
    InterlockedAdd(_DisplacementAllocator[0], 1u, mergedPage);
    if (mergedPage >= _BasePageCapacity)
    {
        InterlockedAdd(_DisplacementAllocator[2], 1u);
        _FilmHeaders[aIndex].flags = flagsA;
        _FilmHeaders[bIndex].flags = flagsB;
        return;
    }

    float supportA = max(a.supportTotal, 1e-3);
    float supportB = max(b.supportTotal, 1e-3);
    float3 normal = normalize(a.normal * supportA + b.normal * supportB);
    float3 tangentU = normalize(a.tangentU - normal * dot(a.tangentU, normal));
    float3 tangentV = normalize(cross(normal, tangentU));
    if (dot(tangentV, a.tangentV) < 0.0) tangentV = -tangentV;
    float3 center = (a.origin * supportA + b.origin * supportB) /
        (supportA + supportB);
    float2 minimum = float2(3.402823466e+38, 3.402823466e+38);
    float2 maximum = -minimum;
    IncludeFilmBounds(a, center, tangentU, tangentV, minimum, maximum);
    IncludeFilmBounds(b, center, tangentU, tangentV, minimum, maximum);
    float2 tangentShift = 0.5 * (minimum + maximum);
    center += tangentShift.x * tangentU + tangentShift.y * tangentV;
    float2 extents = max(0.5 * (maximum - minimum), 0.005);

    ContactFilmHeader merged = a;
    merged.id = mergedIndex + 1u;
    merged.generation = max(1u, _FilmAllocator[3]);
    merged.flags = FILM_ACTIVE | FILM_ONE_SIDED | FILM_DIRTY_GEOMETRY |
        FILM_DIRTY_MESHLET | FILM_HAS_DISPLACEMENT;
    if ((a.flags & FILM_UNCERTAIN) != 0u ||
        (b.flags & FILM_UNCERTAIN) != 0u) merged.flags |= FILM_UNCERTAIN;
    merged.origin = center;
    merged.normal = normal;
    merged.tangentU = tangentU; merged.tangentV = tangentV;
    merged.extentU = extents.x; merged.extentV = extents.y;
    merged.supportTotal = a.supportTotal + b.supportTotal;
    merged.sigmaNormal = min(a.sigmaNormal, b.sigmaNormal);
    merged.confidence = saturate((a.confidence * supportA +
        b.confidence * supportB) / (supportA + supportB));
    merged.contradiction = min(a.contradiction, b.contradiction);
    merged.revision = max(a.revision, b.revision) + 1u;
    merged.displacementPage = mergedPage + 1u;
    merged.boundaryStart = 0u; merged.boundaryCount = 0u;
    merged.reserved0 = merged.reserved1 = merged.reserved2 = 0u;

    float totalH[36]; float totalG[6];
    [unroll] for (uint i = 0u; i < 36u; ++i) totalH[i] = 0.0;
    [unroll] for (uint i = 0u; i < 6u; ++i) totalG[i] = 0.0;
    AddTransformedInformation(a, merged, aIndex * 9u, totalH, totalG);
    AddTransformedInformation(b, merged, bIndex * 9u, totalH, totalG);
    float solved[6] = { 0, 0, 0, 0, 0, 0 };
    if (SolveSix(totalH, totalG, solved))
    {
        merged.quadratic0123 = float4(solved[0], solved[1] / merged.extentU,
            solved[2] / merged.extentV,
            solved[3] / (merged.extentU * merged.extentU));
        merged.quadratic45 = float2(
            solved[4] / (merged.extentU * merged.extentV),
            solved[5] / (merged.extentV * merged.extentV));
    }
    else
    {
        merged.quadratic0123 = 0.0;
        merged.quadratic45 = 0.0;
    }
    float4 countSupport = _FilmInformation[aIndex * 9u + 7u] +
        _FilmInformation[bIndex * 9u + 7u];
    float4 qa = _FilmInformation[aIndex * 9u + 8u];
    float4 qb = _FilmInformation[bIndex * 9u + 8u];
    float4 quality = float4(min(qa.x, qb.x), merged.confidence,
        min(qa.z, qb.z), max(qa.w, qb.w));
    StoreInformation(mergedIndex * 9u, totalH, totalG,
        countSupport, quality);
    ContactTopologyEvidence ea = _TopologyEvidence[aIndex];
    ContactTopologyEvidence eb = _TopologyEvidence[bIndex];
    ContactTopologyEvidence em;
    em.positiveMoment = ea.positiveMoment + eb.positiveMoment;
    em.positiveSupport = ea.positiveSupport + eb.positiveSupport;
    em.negativeMoment = ea.negativeMoment + eb.negativeMoment;
    em.negativeSupport = ea.negativeSupport + eb.negativeSupport;
    em.totalSupport = ea.totalSupport + eb.totalSupport;
    em.residualVariance = em.totalSupport > 0.0 ?
        (ea.residualVariance * ea.totalSupport +
         eb.residualVariance * eb.totalSupport) / em.totalSupport : 0.0;
    em.boundarySupport = ea.boundarySupport + eb.boundarySupport;
    em.revision = max(ea.revision, eb.revision) + 1u;
    _TopologyEvidence[mergedIndex] = em;

    DisplacementPageHeader page = (DisplacementPageHeader)0;
    page.id = mergedPage + 1u;
    page.generation = max(1u, _DisplacementAllocator[4]);
    page.filmId = merged.id; page.filmGeneration = merged.generation;
    page.flags = PAGE_ACTIVE | PAGE_BASE | PAGE_DIRTY;
    page.uvBounds = float4(0, 0, 1, 1);
    page.bestFootprintBits = asuint(min(qa.z, qb.z));
    _DisplacementPages[mergedPage] = page;
    _FilmHeaders[mergedIndex] = merged;
    a.flags = (flagsA & ~FILM_ACTIVE) | FILM_RETIRED | FILM_DIRTY_MESHLET;
    b.flags = (flagsB & ~FILM_ACTIVE) | FILM_RETIRED | FILM_DIRTY_MESHLET;
    a.reserved0 = merged.id; b.reserved0 = merged.id;
    a.revision++; b.revision++;
    _FilmHeaders[aIndex] = a; _FilmHeaders[bIndex] = b;
    InterlockedAdd(_FilmAllocator[1], 0xffffffffu);
    uint mergeSlot;
    InterlockedAdd(_AdaptState[4], 1u, mergeSlot);
    if (mergeSlot < _FilmCapacity)
    {
        TopologyMergeRecord record = (TopologyMergeRecord)0;
        record.filmAIndex = aIndex; record.filmBIndex = bIndex;
        record.mergedFilmIndex = mergedIndex;
        record.mergedBasePage = mergedPage;
        _MergeRecords[mergeSlot] = record;
    }
    else InterlockedAdd(_AdaptState[5], 1u);
}

[numthreads(1, 1, 1)]
void BuildMergeArguments(uint3 id : SV_DispatchThreadID)
{
    uint mergeCount = min(_AdaptState[4], _FilmCapacity);
    _AdaptDispatchArguments[6] = uint3(
        (mergeCount * BASE_CELLS_PER_PAGE + 63u) / 64u, 1u, 1u);
}

bool SourceDisplacement(ContactFilmHeader source, float3 point,
    out float displacement, out DisplacementCell cell)
{
    float3 delta = point - source.origin;
    float u = dot(delta, source.tangentU);
    float v = dot(delta, source.tangentV);
    float2 uv = float2(u / max(2.0 * source.extentU, 0.002) + 0.5,
        v / max(2.0 * source.extentV, 0.002) + 0.5);
    displacement = 0.0; cell = (DisplacementCell)0;
    if (any(uv < 0.0) || any(uv > 1.0)) return false;
    uint sourceCell;
    if (ResolveLeaf(source, uv, sourceCell)) cell = LoadCell(sourceCell);
    float3 sourceSurface = source.origin + u * source.tangentU +
        v * source.tangentV + (Height(source, u, v) + cell.displacement) *
        source.normal;
    displacement = dot(sourceSurface - point, source.normal);
    return true;
}

[numthreads(64, 1, 1)]
void InitializeMergedDisplacement(uint3 id : SV_DispatchThreadID)
{
    uint mergeCount = min(_AdaptState[4], _FilmCapacity);
    uint recordIndex = id.x / BASE_CELLS_PER_PAGE;
    uint localCell = id.x % BASE_CELLS_PER_PAGE;
    if (recordIndex >= mergeCount) return;
    TopologyMergeRecord record = _MergeRecords[recordIndex];
    ContactFilmHeader a = _FilmHeaders[record.filmAIndex];
    ContactFilmHeader b = _FilmHeaders[record.filmBIndex];
    ContactFilmHeader merged = _FilmHeaders[record.mergedFilmIndex];
    uint x = localCell & 15u; uint y = localCell >> 4u;
    float2 uv = (float2(x, y) + 0.5) / 16.0;
    float u = lerp(-merged.extentU, merged.extentU, uv.x);
    float v = lerp(-merged.extentV, merged.extentV, uv.y);
    float baseHeight = Height(merged, u, v);
    float3 basePoint = merged.origin + u * merged.tangentU +
        v * merged.tangentV + baseHeight * merged.normal;
    float da, db; DisplacementCell ca, cb;
    bool hasA = SourceDisplacement(a, basePoint, da, ca);
    bool hasB = SourceDisplacement(b, basePoint, db, cb);
    float wa = hasA ? max(ca.support, a.confidence) : 0.0;
    float wb = hasB ? max(cb.support, b.confidence) : 0.0;
    DisplacementCell result = (DisplacementCell)0;
    result.sigma = merged.sigmaNormal;
    result.bestFootprint = 3.402823466e+38;
    if (wa + wb > 0.0)
    {
        result.displacement = (da * wa + db * wb) / (wa + wb);
        result.sigma = min(hasA ? ca.sigma : merged.sigmaNormal,
            hasB ? cb.sigma : merged.sigmaNormal);
        result.support = 0.5 * (wa + wb);
        result.coverage = max(hasA ? ca.coverage : 0.0,
            hasB ? cb.coverage : 0.0);
        result.bestPrecision = max(hasA ? ca.bestPrecision : 0.0,
            hasB ? cb.bestPrecision : 0.0);
        result.bestFootprint = min(hasA ? ca.bestFootprint : 3.402823466e+38,
            hasB ? cb.bestFootprint : 3.402823466e+38);
        result.residualVariance = (hasA ? ca.residualVariance : 0.0) +
            (hasB ? cb.residualVariance : 0.0);
        result.revision = 1u;
    }
    uint target = record.mergedBasePage * BASE_CELLS_PER_PAGE + localCell;
    _BaseDisplacementCells[target] = result;
    _BaseChildPages[target] = 0u;
    _DisplacementCellDirtyFlags[target] = 0u;
    uint accumulator = target * WORDS_PER_CELL;
    [unroll] for (uint word = 0u; word < WORDS_PER_CELL; ++word)
        _DisplacementCellAccumulator[accumulator + word] =
            word == 6u ? 0x7f7fffff : 0;
    InterlockedMin(_DisplacementPages[record.mergedBasePage].bestFootprintBits,
        asuint(max(result.bestFootprint, 1e-12)));
    InterlockedMax(_DisplacementPages[record.mergedBasePage].maximumVarianceBits,
        asuint(max(result.residualVariance, 0.0)));
    InterlockedAdd(_DisplacementPages[record.mergedBasePage].supportFixed,
        (uint)max(0.0, round(result.support * 4096.0)));
    if (localCell == 0u)
        _DisplacementPages[record.mergedBasePage].revision = 1u;
}
