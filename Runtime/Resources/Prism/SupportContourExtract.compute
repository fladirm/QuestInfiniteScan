#pragma kernel InitializeSupportContourAtlas
#pragma kernel BuildFilmDirtyImportArguments
#pragma kernel ImportFilmDirtyTopology
#pragma kernel BuildFilmDirtyTailArguments
#pragma kernel ImportFilmDirtyTopologyTail
#pragma kernel BuildSupportContourArguments
#pragma kernel CountSupportContourSegments
#pragma kernel PreflightSupportContourPages
#pragma kernel CommitSupportContourPages
#pragma kernel WriteSupportContourSegments
#pragma kernel FinalizeTopologyDirtyFlags
#pragma kernel ResetTopologyDirtyQueue
#pragma kernel QueueElasticTopologyChanges
#pragma kernel ResetRestoredTopologyTransient

#include "PressureManifoldAtlasAbi.hlsl"

struct DisplacementPageHeader
{
    uint id; uint generation; uint filmId; uint filmGeneration;
    uint level; uint parentPage; uint parentCell; uint flags;
    float4 uvBounds;
    uint bestFootprintBits; uint maximumVarianceBits; uint supportFixed; uint revision;
};

struct DisplacementCell
{
    float displacement; float sigma; float support; float coverage;
    float bestPrecision; float bestFootprint; float residualVariance;
    float preHitPressure; uint preHitPressureViewMask; uint revision;
};

StructuredBuffer<AtlasContactFilmHeader> _FilmHeaders;
StructuredBuffer<uint> _FilmAllocator;
StructuredBuffer<uint> _DirtyFilmIndices;
StructuredBuffer<uint> _ActiveFilmIndices;
StructuredBuffer<DisplacementPageHeader> _DisplacementPages;
StructuredBuffer<DisplacementCell> _BaseDisplacementCells;
StructuredBuffer<AtlasFilmMembership> _FilmMemberships;
RWStructuredBuffer<SupportContourPage> _SupportContourPages;
RWStructuredBuffer<SupportContourSegment> _SupportContours;
RWStructuredBuffer<uint4> _FilmTopologyRanges;
RWStructuredBuffer<uint4> _ContourPlans;
RWStructuredBuffer<uint> _AtlasAllocator;
RWStructuredBuffer<uint> _DirtyTopologyFilms;
RWStructuredBuffer<uint> _TopologyDirtyFlags;
RWStructuredBuffer<ElasticChartState> _ElasticChartStates;
RWStructuredBuffer<uint3> _AtlasDispatchArguments;
RWStructuredBuffer<uint> _ManifoldDiagnostics;

uint _FilmCapacity;
uint _BasePageCapacity;
uint _ContourPageCapacity;
uint _ContourSegmentCapacity;
float _CoverageThreshold;

static const uint FILM_ACTIVE = 1u;
static const uint FILM_HAS_DISPLACEMENT = 1u << 5u;
static const uint PAGE_ACTIVE = 1u;
static const uint PAGE_BASE = 1u << 1u;
static const uint CONTOUR_PAGE_ACTIVE = 1u;
static const uint CONTOUR_ACTIVE = 1u;
static const uint CONTOUR_MEASURED = 1u << 1u;
static const uint SEGMENTS_PER_PAGE = 64u;
static const uint GRID = 16u;
static const uint CELLS = 15u;
static const uint ELASTIC_TOPOLOGY_DIRTY = 1u << 1u;

groupshared uint sSegmentCount[256];

uint DirtyCount() { return min(_AtlasAllocator[7], _FilmCapacity); }

void EnqueueTopologyFilm(uint filmIndex)
{
    if (filmIndex >= _FilmCapacity) return;
    AtlasContactFilmHeader film = _FilmHeaders[filmIndex];
    if (film.id != filmIndex + 1u || (film.flags & FILM_ACTIVE) == 0u) return;
    uint previous;
    InterlockedCompareExchange(_TopologyDirtyFlags[filmIndex], 0u, 1u, previous);
    if (previous != 0u) return;
    uint ordinal;
    InterlockedAdd(_AtlasAllocator[7], 1u, ordinal);
    if (ordinal < _FilmCapacity) _DirtyTopologyFilms[ordinal] = filmIndex;
    else
    {
        _TopologyDirtyFlags[filmIndex] = 0u;
        InterlockedAdd(_AtlasAllocator[2], 1u);
        InterlockedAdd(_ManifoldDiagnostics[15], 1u);
    }
}

float BootstrapCoverage(AtlasContactFilmHeader film, uint2 node)
{
    uint2 coarse = min(node >> 1u, 7u);
    uint bit = coarse.y * 8u + coarse.x;
    uint supported = bit < 32u ? (film.supportMaskLow >> bit) & 1u :
        (film.supportMaskHigh >> (bit - 32u)) & 1u;
    return (float)supported;
}

float Coverage(AtlasContactFilmHeader film, uint2 node)
{
    if ((film.flags & FILM_HAS_DISPLACEMENT) != 0u &&
        film.displacementPage > 0u)
    {
        uint pageIndex = film.displacementPage - 1u;
        if (pageIndex < _BasePageCapacity)
        {
            DisplacementPageHeader page = _DisplacementPages[pageIndex];
            if ((page.flags & (PAGE_ACTIVE | PAGE_BASE)) ==
                    (PAGE_ACTIVE | PAGE_BASE) &&
                page.filmId == film.id && page.filmGeneration == film.generation)
                return saturate(_BaseDisplacementCells[
                    pageIndex * GRID * GRID + node.y * GRID + node.x].coverage);
        }
    }
    return BootstrapCoverage(film, node);
}

uint CaseSegmentCount(uint code)
{
    if (code == 0u || code == 15u) return 0u;
    return code == 5u || code == 10u ? 2u : 1u;
}

float2 EdgePoint(uint edge, uint2 cell, float values[4])
{
    uint a = edge == 0u ? 0u : edge == 1u ? 1u : edge == 2u ? 2u : 3u;
    uint b = edge == 0u ? 1u : edge == 1u ? 2u : edge == 2u ? 3u : 0u;
    float2 corners[4] = {
        float2(0, 0), float2(1, 0), float2(1, 1), float2(0, 1)
    };
    float denominator = values[b] - values[a];
    float t = abs(denominator) > 1e-6
        ? saturate((_CoverageThreshold - values[a]) / denominator) : 0.5;
    return (float2(cell) + lerp(corners[a], corners[b], t)) / (float)(GRID - 1u);
}

uint2 CaseEdges(uint code, uint segment, bool centreInside)
{
    if (code == 1u) return uint2(3, 0);
    if (code == 2u) return uint2(0, 1);
    if (code == 3u) return uint2(3, 1);
    if (code == 4u) return uint2(1, 2);
    if (code == 5u)
    {
        if (centreInside) return segment == 0u ? uint2(3, 2) : uint2(0, 1);
        return segment == 0u ? uint2(3, 0) : uint2(1, 2);
    }
    if (code == 6u) return uint2(0, 2);
    if (code == 7u) return uint2(3, 2);
    if (code == 8u) return uint2(2, 3);
    if (code == 9u) return uint2(2, 0);
    if (code == 10u)
    {
        if (centreInside) return segment == 0u ? uint2(0, 3) : uint2(1, 2);
        return segment == 0u ? uint2(0, 1) : uint2(2, 3);
    }
    if (code == 11u) return uint2(2, 1);
    if (code == 12u) return uint2(1, 3);
    if (code == 13u) return uint2(1, 0);
    return uint2(0, 3);
}

uint ContourSlot(uint firstPage, uint ordinal)
{
    uint pageId = firstPage;
    uint pageOffset = ordinal / SEGMENTS_PER_PAGE;
    [loop]
    for (uint page = 0u; page < pageOffset && pageId != 0u; ++page)
    {
        SupportContourPage header = _SupportContourPages[pageId - 1u];
        pageId = header.nextPageId;
    }
    if (pageId == 0u || pageId > _ContourPageCapacity) return ATLAS_INVALID;
    return (pageId - 1u) * SEGMENTS_PER_PAGE + ordinal % SEGMENTS_PER_PAGE;
}

[numthreads(64, 1, 1)]
void InitializeSupportContourAtlas(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index < _FilmCapacity)
    {
        _FilmTopologyRanges[index] = 0u;
        _ContourPlans[index] = 0u;
        _DirtyTopologyFilms[index] = 0u;
        _TopologyDirtyFlags[index] = 0u;
    }
    if (index < 16u) _AtlasAllocator[index] = index == 3u ? 1u : 0u;
    if (index < 8u) _AtlasDispatchArguments[index] = uint3(0u, 1u, 1u);
}

[numthreads(1, 1, 1)]
void BuildFilmDirtyImportArguments(uint3 id : SV_DispatchThreadID)
{
    uint dirty = min(_FilmAllocator[7], _FilmCapacity);
    _AtlasAllocator[8] = dirty;
    _AtlasAllocator[9] = 0u;
    _AtlasDispatchArguments[7] = uint3((dirty + 63u) / 64u, 1u, 1u);
}

[numthreads(64, 1, 1)]
void ImportFilmDirtyTopology(uint3 id : SV_DispatchThreadID)
{
    uint ordinal = id.x;
    if (ordinal >= _AtlasAllocator[8]) return;
    EnqueueTopologyFilm(_DirtyFilmIndices[ordinal]);
}

[numthreads(1, 1, 1)]
void BuildFilmDirtyTailArguments(uint3 id : SV_DispatchThreadID)
{
    uint dirty = min(_FilmAllocator[7], _FilmCapacity);
    uint baseOrdinal = min(_AtlasAllocator[8], dirty);
    _AtlasAllocator[9] = baseOrdinal;
    _AtlasAllocator[8] = dirty;
    uint count = dirty - baseOrdinal;
    _AtlasDispatchArguments[7] = uint3((count + 63u) / 64u, 1u, 1u);
}

[numthreads(64, 1, 1)]
void ImportFilmDirtyTopologyTail(uint3 id : SV_DispatchThreadID)
{
    uint ordinal = _AtlasAllocator[9] + id.x;
    if (ordinal >= _AtlasAllocator[8]) return;
    EnqueueTopologyFilm(_DirtyFilmIndices[ordinal]);
}

[numthreads(1, 1, 1)]
void BuildSupportContourArguments(uint3 id : SV_DispatchThreadID)
{
    uint dirty = DirtyCount();
    _AtlasDispatchArguments[0] = uint3(dirty, 1u, 1u);
    _AtlasDispatchArguments[1] = uint3((dirty + 63u) / 64u, 1u, 1u);
    _AtlasDispatchArguments[2] = uint3(dirty, 1u, 1u);
}

[numthreads(256, 1, 1)]
void CountSupportContourSegments(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint dirtyOrdinal = groupId.x;
    uint dirty = DirtyCount();
    uint local = threadId.x;
    sSegmentCount[local] = 0u;
    if (dirtyOrdinal < dirty)
    {
        uint filmIndex = _DirtyTopologyFilms[dirtyOrdinal];
        if (filmIndex < _FilmCapacity)
        {
            AtlasContactFilmHeader film = _FilmHeaders[filmIndex];
            if (film.id == filmIndex + 1u && (film.flags & FILM_ACTIVE) != 0u &&
                local < CELLS * CELLS)
            {
                uint2 cell = uint2(local % CELLS, local / CELLS);
                float c0 = Coverage(film, cell);
                float c1 = Coverage(film, cell + uint2(1, 0));
                float c2 = Coverage(film, cell + uint2(1, 1));
                float c3 = Coverage(film, cell + uint2(0, 1));
                uint code = (c0 >= _CoverageThreshold ? 1u : 0u) |
                    (c1 >= _CoverageThreshold ? 2u : 0u) |
                    (c2 >= _CoverageThreshold ? 4u : 0u) |
                    (c3 >= _CoverageThreshold ? 8u : 0u);
                sSegmentCount[local] = CaseSegmentCount(code);
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint stride = 128u; stride > 0u; stride >>= 1u)
    {
        if (local < stride) sSegmentCount[local] += sSegmentCount[local + stride];
        GroupMemoryBarrierWithGroupSync();
    }
    if (local != 0u || dirtyOrdinal >= dirty) return;
    uint filmIndex = _DirtyTopologyFilms[dirtyOrdinal];
    if (filmIndex >= _FilmCapacity) return;
    uint segmentCount = sSegmentCount[0];
    uint requiredPages = (segmentCount + SEGMENTS_PER_PAGE - 1u) /
        SEGMENTS_PER_PAGE;
    _ContourPlans[filmIndex] = uint4(segmentCount, requiredPages, 0u, 1u);
}

// One bounded planning pass reserves all additional pages atomically as one batch.
// If capacity is insufficient, no film range or page chain is modified.
[numthreads(1, 1, 1)]
void PreflightSupportContourPages(uint3 id : SV_DispatchThreadID)
{
    uint dirty = DirtyCount();
    if (dirty == 0u)
    {
        _AtlasAllocator[4] = _AtlasAllocator[0];
        _AtlasAllocator[5] = 0u;
        _AtlasAllocator[6] = 0u;
        return;
    }
    uint additional = 0u;
    [loop]
    for (uint ordinal = 0u; ordinal < dirty; ++ordinal)
    {
        uint filmIndex = _DirtyTopologyFilms[ordinal];
        if (filmIndex >= _FilmCapacity) continue;
        uint4 plan = _ContourPlans[filmIndex];
        uint existingPages = _FilmTopologyRanges[filmIndex].y;
        uint add = plan.y > existingPages ? plan.y - existingPages : 0u;
        plan.z = additional;
        _ContourPlans[filmIndex] = plan;
        additional += add;
    }
    uint basePage = _AtlasAllocator[0];
    bool valid = basePage <= _ContourPageCapacity &&
        additional <= _ContourPageCapacity - basePage;
    _AtlasAllocator[4] = basePage;
    _AtlasAllocator[5] = additional;
    _AtlasAllocator[6] = valid ? 1u : 0u;
    if (valid) _AtlasAllocator[0] = basePage + additional;
    else
    {
        _AtlasAllocator[2] += additional;
        _ManifoldDiagnostics[15] += additional;
    }
}

[numthreads(64, 1, 1)]
void CommitSupportContourPages(uint3 id : SV_DispatchThreadID)
{
    uint ordinal = id.x; uint dirty = DirtyCount();
    if (ordinal >= dirty || _AtlasAllocator[6] == 0u) return;
    uint filmIndex = _DirtyTopologyFilms[ordinal];
    if (filmIndex >= _FilmCapacity) return;
    AtlasContactFilmHeader film = _FilmHeaders[filmIndex];
    uint4 plan = _ContourPlans[filmIndex];
    uint4 range = _FilmTopologyRanges[filmIndex];
    uint required = plan.y;
    uint existing = range.y;
    uint firstPage = range.x;
    uint lastPage = firstPage;
    [loop]
    for (uint pageOrdinal = 1u; pageOrdinal < existing && lastPage != 0u;
        ++pageOrdinal)
        lastPage = _SupportContourPages[lastPage - 1u].nextPageId;

    if (required > existing)
    {
        uint newFirst = _AtlasAllocator[4] + plan.z + 1u;
        if (firstPage == 0u) firstPage = newFirst;
        else if (lastPage != 0u)
        {
            SupportContourPage tail = _SupportContourPages[lastPage - 1u];
            tail.nextPageId = newFirst;
            tail.nextPageGeneration = max(1u, _AtlasAllocator[3]);
            _SupportContourPages[lastPage - 1u] = tail;
        }
        uint additional = required - existing;
        [loop]
        for (uint add = 0u; add < additional; ++add)
        {
            uint pageIndex = _AtlasAllocator[4] + plan.z + add;
            SupportContourPage page = (SupportContourPage)0;
            page.id = pageIndex + 1u;
            page.generation = max(1u, _AtlasAllocator[3]);
            page.filmId = film.id; page.filmGeneration = film.generation;
            page.nextPageId = add + 1u < additional ? page.id + 1u : 0u;
            page.nextPageGeneration = add + 1u < additional ? page.generation : 0u;
            page.flags = CONTOUR_PAGE_ACTIVE;
            _SupportContourPages[pageIndex] = page;
        }
    }
    // y is reserved page capacity for this film, not current topology size. Keeping
    // peak pages attached makes repeated support refinement allocation-stable.
    range.x = firstPage;
    range.y = max(existing, required);
    range.z = plan.x;
    range.w = range.w == 0xffffffffu ? 1u : range.w + 1u;
    _FilmTopologyRanges[filmIndex] = range;

    uint pageId = range.x;
    [loop]
    for (uint pageOrdinal = 0u; pageOrdinal < range.y && pageId != 0u;
        ++pageOrdinal)
    {
        SupportContourPage page = _SupportContourPages[pageId - 1u];
        page.filmId = film.id; page.filmGeneration = film.generation;
        // Reserved pages beyond the current contour stay attached for allocation
        // stability, but they must expose no topology from an older revision.
        page.segmentCount = pageOrdinal < required
            ? min(SEGMENTS_PER_PAGE,
                plan.x > pageOrdinal * SEGMENTS_PER_PAGE
                    ? plan.x - pageOrdinal * SEGMENTS_PER_PAGE : 0u)
            : 0u;
        page.flags = CONTOUR_PAGE_ACTIVE;
        _SupportContourPages[pageId - 1u] = page;
        pageId = page.nextPageId;
    }
}

[numthreads(256, 1, 1)]
void WriteSupportContourSegments(uint3 groupId : SV_GroupID,
    uint3 threadId : SV_GroupThreadID)
{
    uint dirtyOrdinal = groupId.x; uint dirty = DirtyCount(); uint local = threadId.x;
    if (dirtyOrdinal >= dirty || _AtlasAllocator[6] == 0u) return;
    uint filmIndex = _DirtyTopologyFilms[dirtyOrdinal];
    if (filmIndex >= _FilmCapacity) return;
    AtlasContactFilmHeader film = _FilmHeaders[filmIndex];
    uint4 range = _FilmTopologyRanges[filmIndex];
    uint count = 0u; uint code = 0u; uint2 cell = 0u; float values[4];
    if (local < CELLS * CELLS)
    {
        cell = uint2(local % CELLS, local / CELLS);
        values[0] = Coverage(film, cell);
        values[1] = Coverage(film, cell + uint2(1, 0));
        values[2] = Coverage(film, cell + uint2(1, 1));
        values[3] = Coverage(film, cell + uint2(0, 1));
        code = (values[0] >= _CoverageThreshold ? 1u : 0u) |
            (values[1] >= _CoverageThreshold ? 2u : 0u) |
            (values[2] >= _CoverageThreshold ? 4u : 0u) |
            (values[3] >= _CoverageThreshold ? 8u : 0u);
        count = CaseSegmentCount(code);
    }
    sSegmentCount[local] = count;
    GroupMemoryBarrierWithGroupSync();
    // Inclusive Hillis-Steele scan; 256 cells is fixed and branch deterministic.
    [unroll]
    for (uint offset = 1u; offset < 256u; offset <<= 1u)
    {
        uint add = local >= offset ? sSegmentCount[local - offset] : 0u;
        GroupMemoryBarrierWithGroupSync();
        sSegmentCount[local] += add;
        GroupMemoryBarrierWithGroupSync();
    }
    if (count == 0u) return;
    uint firstOrdinal = sSegmentCount[local] - count;
    float centre = 0.25 * (values[0] + values[1] + values[2] + values[3]);
    float2 gradient = float2(values[1] + values[2] - values[0] - values[3],
        values[2] + values[3] - values[0] - values[1]);
    AtlasFilmMembership membership = _FilmMemberships[filmIndex];
    [loop]
    for (uint segment = 0u; segment < count; ++segment)
    {
        uint ordinal = firstOrdinal + segment;
        uint slot = ContourSlot(range.x, ordinal);
        if (slot == ATLAS_INVALID || slot >= _ContourSegmentCapacity) continue;
        uint2 edges = CaseEdges(code, segment, centre >= _CoverageThreshold);
        float2 a = EdgePoint(edges.x, cell, values);
        float2 b = EdgePoint(edges.y, cell, values);
        float2 direction = b - a;
        float2 left = float2(-direction.y, direction.x);
        if (dot(left, gradient) < 0.0) { float2 swap = a; a = b; b = swap; }
        uint pageIndex = slot / SEGMENTS_PER_PAGE;
        SupportContourPage page = _SupportContourPages[pageIndex];
        SupportContourSegment output = (SupportContourSegment)0;
        output.id = slot + 1u; output.generation = page.generation;
        output.filmId = film.id; output.filmGeneration = film.generation;
        output.manifoldId = membership.manifoldId;
        output.manifoldGeneration = membership.manifoldGeneration;
        output.cellKey = cell.y * CELLS + cell.x;
        output.flags = CONTOUR_ACTIVE | CONTOUR_MEASURED;
        output.uv01 = float4(a, b);
        output.sigma = film.sigmaNormal;
        output.support = film.supportTotal;
        output.confidence = film.confidence;
        output.bandwidth = max(2.0 * film.extentU, 2.0 * film.extentV) / GRID;
        _SupportContours[slot] = output;
    }
}

[numthreads(64, 1, 1)]
void FinalizeTopologyDirtyFlags(uint3 id : SV_DispatchThreadID)
{
    uint ordinal = id.x;
    uint dirty = DirtyCount();
    if (ordinal >= dirty) return;
    uint filmIndex = _DirtyTopologyFilms[ordinal];
    if (filmIndex < _FilmCapacity) _TopologyDirtyFlags[filmIndex] = 0u;
}

[numthreads(1, 1, 1)]
void ResetTopologyDirtyQueue(uint3 id : SV_DispatchThreadID)
{
    _AtlasAllocator[7] = 0u;
    _AtlasAllocator[6] = 0u;
}

[numthreads(64, 1, 1)]
void QueueElasticTopologyChanges(uint3 id : SV_DispatchThreadID)
{
    uint ordinal = id.x;
    uint active = min(_FilmAllocator[6], _FilmCapacity);
    if (ordinal >= active) return;
    uint filmIndex = _ActiveFilmIndices[ordinal];
    if (filmIndex >= _FilmCapacity) return;
    uint previous;
    InterlockedAnd(_ElasticChartStates[filmIndex].flags,
        ~ELASTIC_TOPOLOGY_DIRTY, previous);
    if ((previous & ELASTIC_TOPOLOGY_DIRTY) != 0u)
        EnqueueTopologyFilm(filmIndex);
}

[numthreads(64, 1, 1)]
void ResetRestoredTopologyTransient(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index < _FilmCapacity)
    {
        _ContourPlans[index] = 0u;
        _DirtyTopologyFilms[index] = 0u;
        _TopologyDirtyFlags[index] = 0u;
    }
    if (index < 8u) _AtlasDispatchArguments[index] = uint3(0u, 1u, 1u);
    if (index == 0u)
    {
        // Preserve canonical page count/generation and persisted portal count.
        [unroll] for (uint word = 4u; word <= 9u; ++word)
            _AtlasAllocator[word] = 0u;
    }
}
