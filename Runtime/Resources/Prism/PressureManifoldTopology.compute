static const uint FILM_ACTIVE = 1u;
static const uint FILM_SPLIT_PARENT = 1u << 6u;
static const uint FILM_RETIRED = 1u << 7u;
static const uint FILM_TOPOLOGY_LOCKED = 1u << 8u;
static const uint MANIFOLD_ACTIVE = 1u;
static const uint MANIFOLD_CLOSED = 2u;
static const uint MANIFOLD_DIRTY = 4u;
static const uint MEMBERSHIP_ACTIVE = 1u;
static const uint MEMBERSHIP_MEASURED = 2u;
static const uint LINK_SMOOTH = 1u;
static const uint LINK_CREASE = 2u;
static const uint LINK_ACTIVE = 1u;
static const uint LINK_MULTIVIEW = 2u;
static const uint LINK_RETIRED = 8u;
static const uint INCIDENCE_ACTIVE = 1u;
static const uint FRONTIER_ACTIVE = 1u;
static const uint FRONTIER_OUTER = 2u;
static const uint FRONTIER_ORDERED = 4u;
static const uint FRONTIER_RETIRED = 8u;
static const uint BOUNDARY_ACTIVE = 1u;
static const uint BOUNDARY_RETIRED = 16u;
static const uint BOUNDARY_INFORMATION_RECORDS = 8u;
static const uint INVALID_INDEX = 0xffffffffu;
static const uint SLOT_FREE = 8u;
static const uint SLOT_ALLOCATED = 1u;
static const uint SPLIT_TRANSACTION_RESERVED = 1u;
static const uint SPLIT_TRANSACTION_COMMITTED = 2u;

uint SplitChildIndex(TopologySplitRecord record, uint child)
{
    if (child == 0u) return record.childFilmIndex0;
    if (child == 1u) return record.childFilmIndex1;
    if (child == 2u) return record.childFilmIndex2;
    return record.childFilmIndex3;
}

uint HashCell(int3 cell)
{
    uint value = asuint(cell.x) * 0x8da6b343u;
    value ^= asuint(cell.y) * 0xd8163841u;
    value ^= asuint(cell.z) * 0xcb1ab31fu;
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    return max(1u, value);
}

uint HashPair(uint filmA, uint generationA, uint filmB, uint generationB)
{
    uint a = filmA;
    uint b = filmB;
    uint ga = generationA;
    uint gb = generationB;
    if (a > b)
    {
        uint swap = a; a = b; b = swap;
        swap = ga; ga = gb; gb = swap;
    }
    uint value = a * 0x9e3779b9u ^ b * 0x85ebca6bu;
    value ^= ga * 0xc2b2ae35u ^ gb * 0x27d4eb2fu;
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    return max(1u, value & 0x7fffffffu);
}

float Height(ContactFilmHeader film, float u, float v)
{
    return film.quadratic0123.x + film.quadratic0123.y * u +
        film.quadratic0123.z * v + film.quadratic0123.w * u * u +
        film.quadratic45.x * u * v + film.quadratic45.y * v * v;
}

float3 FilmPoint(ContactFilmHeader film, float2 uv)
{
    uv = saturate(uv);
    float u = lerp(-film.extentU, film.extentU, uv.x);
    float v = lerp(-film.extentV, film.extentV, uv.y);
    return film.origin + u * film.tangentU + v * film.tangentV +
        Height(film, u, v) * film.normal;
}

float2 ProjectUv(ContactFilmHeader film, float3 surfacePoint)
{
    float3 delta = surfacePoint - film.origin;
    return float2(dot(delta, film.tangentU) /
            max(2.0 * film.extentU, 0.002) + 0.5,
        dot(delta, film.tangentV) /
            max(2.0 * film.extentV, 0.002) + 0.5);
}

float BootstrapCoverage(ContactFilmHeader film, float2 uv)
{
    uint2 cell = min((uint2)(saturate(uv) * 8.0), 7u);
    uint bit = cell.y * 8u + cell.x;
    return bit < 32u ?
        (float)((film.supportMaskLow >> bit) & 1u) :
        (float)((film.supportMaskHigh >> (bit - 32u)) & 1u);
}

bool ValidMembership(uint filmIndex, ContactFilmHeader film,
    out FilmMembership membership)
{
    membership = _FilmMemberships[filmIndex];
    if ((membership.flags & MEMBERSHIP_ACTIVE) == 0u ||
        membership.filmId != film.id ||
        membership.filmGeneration != film.generation ||
        membership.manifoldId == 0u ||
        membership.manifoldId > _ManifoldCapacity) return false;
    PressureManifoldHeader manifold =
        _ManifoldHeaders[membership.manifoldId - 1u];
    return manifold.id == membership.manifoldId &&
        manifold.generation == membership.manifoldGeneration &&
        (manifold.flags & MANIFOLD_ACTIVE) != 0u;
}

bool ValidMembershipRead(uint filmIndex, ContactFilmHeader film,
    out FilmMembership membership)
{
    membership = _FilmMemberships[filmIndex];
    if ((membership.flags & MEMBERSHIP_ACTIVE) == 0u ||
        membership.filmId != film.id ||
        membership.filmGeneration != film.generation ||
        membership.manifoldId == 0u ||
        membership.manifoldId > _ManifoldCapacity) return false;
    PressureManifoldHeader manifold =
        _ManifoldHeadersRead[membership.manifoldId - 1u];
    return manifold.id == membership.manifoldId &&
        manifold.generation == membership.manifoldGeneration &&
        (manifold.flags & MANIFOLD_ACTIVE) != 0u;
}

bool ResolveContinuation(ContactFilmHeader a, ContactFilmHeader b,
    out uint linkType, out float4 uvA01, out float4 uvB01,
    out float separation)
{
    linkType = 0u;
    uvA01 = uvB01 = 0.0;
    separation = 1e9;
    float normalDot = dot(a.normal, b.normal);
    if (normalDot < -0.2) return false; // opposite side is a separate contact layer

    float2 uvA = saturate(ProjectUv(a, b.origin));
    float3 pointA = FilmPoint(a, uvA);
    float2 uvB = saturate(ProjectUv(b, pointA));
    float3 pointB = FilmPoint(b, uvB);
    uvA = saturate(ProjectUv(a, pointB));
    pointA = FilmPoint(a, uvA);
    separation = distance(pointA, pointB);
    float gate = min(0.015, max(0.004,
        2.5 * max(a.sigmaNormal, b.sigmaNormal)));
    if (separation > gate || BootstrapCoverage(a, uvA) < 0.5 ||
        BootstrapCoverage(b, uvB) < 0.5) return false;

    float4 distanceA = float4(uvA.y, 1.0 - uvA.x, 1.0 - uvA.y, uvA.x);
    float4 distanceB = float4(uvB.y, 1.0 - uvB.x, 1.0 - uvB.y, uvB.x);
    uint edgeA = 0u;
    uint edgeB = 0u;
    float closestA = distanceA.x;
    float closestB = distanceB.x;
    if (distanceA.y < closestA) { closestA = distanceA.y; edgeA = 1u; }
    if (distanceA.z < closestA) { closestA = distanceA.z; edgeA = 2u; }
    if (distanceA.w < closestA) { closestA = distanceA.w; edgeA = 3u; }
    if (distanceB.y < closestB) { closestB = distanceB.y; edgeB = 1u; }
    if (distanceB.z < closestB) { closestB = distanceB.z; edgeB = 2u; }
    if (distanceB.w < closestB) { closestB = distanceB.w; edgeB = 3u; }
    if (closestA > 0.16 || closestB > 0.16) return false;
    uvA01 = edgeA == 0u ? float4(0, 0, 1, 0) :
        edgeA == 1u ? float4(1, 0, 1, 1) :
        edgeA == 2u ? float4(1, 1, 0, 1) : float4(0, 1, 0, 0);
    uvB01 = edgeB == 0u ? float4(0, 0, 1, 0) :
        edgeB == 1u ? float4(1, 0, 1, 1) :
        edgeB == 2u ? float4(1, 1, 0, 1) : float4(0, 1, 0, 0);
    float3 a0 = FilmPoint(a, uvA01.xy);
    float3 a1 = FilmPoint(a, uvA01.zw);
    float3 b0 = FilmPoint(b, uvB01.xy);
    float3 b1 = FilmPoint(b, uvB01.zw);
    float direct = max(distance(a0, b0), distance(a1, b1));
    float reversed = max(distance(a0, b1), distance(a1, b0));
    if (reversed < direct)
    {
        uvB01 = uvB01.zwxy;
        direct = reversed;
    }
    // A canonical link owns the complete matched chart edge. Partial proximity is
    // boundary evidence, never permission to retire an unmatched latent interval.
    if (direct > gate * 1.5) return false;
    linkType = normalDot > 0.9961947 ? LINK_SMOOTH : LINK_CREASE;
    return true;
}

bool SameLinkPair(ManifoldLink link, uint filmA, uint generationA,
    uint filmB, uint generationB)
{
    return (link.filmA == filmA && link.filmAGeneration == generationA &&
            link.filmB == filmB && link.filmBGeneration == generationB) ||
        (link.filmA == filmB && link.filmAGeneration == generationB &&
         link.filmB == filmA && link.filmBGeneration == generationA);
}

bool ClaimLinkPair(uint hash, uint filmA, uint generationA, uint filmB,
    uint generationB, out uint slot, out uint existingLink)
{
    slot = 0u;
    existingLink = 0u;
    [loop]
    for (uint probe = 0u; probe < 32u; ++probe)
    {
        uint candidate = (hash + probe * 0x9e3779b9u) & _LinkHashMask;
        uint observed;
        InterlockedCompareExchange(_LinkHash[candidate].hash, 0u, hash, observed);
        if (observed == 0u)
        {
            slot = candidate;
            return true;
        }
        if (observed == hash)
        {
            uint candidateLink = _LinkHash[candidate].linkId;
            if (candidateLink != 0u && candidateLink <= _LinkCapacity)
            {
                ManifoldLink link = _ManifoldLinks[candidateLink - 1u];
                if ((link.flags & (LINK_ACTIVE | LINK_RETIRED)) == LINK_ACTIVE &&
                    SameLinkPair(link, filmA, generationA, filmB, generationB))
                {
                    existingLink = candidateLink;
                    return false;
                }
            }
        }
    }
    return false;
}

uint ClosestActiveFrontier(FilmMembership membership, float2 uv)
{
    uint bestId = 0u;
    float bestDistance = 1e9;
    uint incidenceId = membership.firstFrontier;
    uint count = min(membership.frontierCount, _FrontierCapacity);
    [loop]
    for (uint i = 0u; i < count; ++i)
    {
        if (incidenceId == 0u || incidenceId > _FrontierCapacity) break;
        ManifoldFrontierIncidence incidence =
            _ManifoldFrontierIncidences[incidenceId - 1u];
        incidenceId = incidence.nextId;
        if ((incidence.flags & FRONTIER_ACTIVE) == 0u ||
            incidence.filmId != membership.filmId ||
            incidence.filmGeneration != membership.filmGeneration ||
            incidence.frontierId == 0u ||
            incidence.frontierId > _FrontierCapacity) continue;
        LatentFrontierSegment segment =
            _LatentFrontiers[incidence.frontierId - 1u];
        if (segment.id != incidence.frontierId ||
            segment.generation != incidence.frontierGeneration ||
            (segment.flags & (FRONTIER_ACTIVE | FRONTIER_RETIRED)) !=
                FRONTIER_ACTIVE) continue;
        float2 a = segment.uv01.xy;
        float2 b = segment.uv01.zw;
        float2 ab = b - a;
        float t = saturate(dot(uv - a, ab) / max(dot(ab, ab), 1e-8));
        float d = distance(uv, lerp(a, b, t));
        if (d < bestDistance)
        {
            bestDistance = d;
            bestId = incidence.frontierId;
        }
    }
    return bestDistance < 0.22 ? bestId : 0u;
}

void RetireAndSpliceFrontiers(uint frontierA, uint frontierB)
{
    if (frontierA == 0u || frontierB == 0u || frontierA > _FrontierCapacity ||
        frontierB > _FrontierCapacity) return;
    LatentFrontierSegment a = _LatentFrontiers[frontierA - 1u];
    LatentFrontierSegment b = _LatentFrontiers[frontierB - 1u];
    if ((a.flags & (FRONTIER_ACTIVE | FRONTIER_RETIRED)) != FRONTIER_ACTIVE ||
        (b.flags & (FRONTIER_ACTIVE | FRONTIER_RETIRED)) != FRONTIER_ACTIVE)
        return;
    if (a.previousId == 0u || a.nextId == 0u || b.previousId == 0u ||
        b.nextId == 0u || a.previousId > _FrontierCapacity ||
        a.nextId > _FrontierCapacity || b.previousId > _FrontierCapacity ||
        b.nextId > _FrontierCapacity) return;
    LatentFrontierSegment previousA = _LatentFrontiers[a.previousId - 1u];
    LatentFrontierSegment nextA = _LatentFrontiers[a.nextId - 1u];
    LatentFrontierSegment previousB = _LatentFrontiers[b.previousId - 1u];
    LatentFrontierSegment nextB = _LatentFrontiers[b.nextId - 1u];
    previousA.nextId = b.nextId; previousA.nextGeneration = nextB.generation;
    nextB.previousId = a.previousId; nextB.previousGeneration = previousA.generation;
    previousB.nextId = a.nextId; previousB.nextGeneration = nextA.generation;
    nextA.previousId = b.previousId; nextA.previousGeneration = previousB.generation;
    previousA.revision++; nextA.revision++; previousB.revision++; nextB.revision++;
    _LatentFrontiers[a.previousId - 1u] = previousA;
    _LatentFrontiers[a.nextId - 1u] = nextA;
    _LatentFrontiers[b.previousId - 1u] = previousB;
    _LatentFrontiers[b.nextId - 1u] = nextB;
    a.flags &= ~FRONTIER_ACTIVE; a.flags |= FRONTIER_RETIRED; a.revision++;
    b.flags &= ~FRONTIER_ACTIVE; b.flags |= FRONTIER_RETIRED; b.revision++;
    _LatentFrontiers[frontierA - 1u] = a;
    _LatentFrontiers[frontierB - 1u] = b;
    ManifoldFrontierIncidence incidenceA =
        _ManifoldFrontierIncidences[frontierA - 1u];
    ManifoldFrontierIncidence incidenceB =
        _ManifoldFrontierIncidences[frontierB - 1u];
    incidenceA.flags &= ~FRONTIER_ACTIVE;
    incidenceA.flags |= FRONTIER_RETIRED;
    incidenceB.flags &= ~FRONTIER_ACTIVE;
    incidenceB.flags |= FRONTIER_RETIRED;
    _ManifoldFrontierIncidences[frontierA - 1u] = incidenceA;
    _ManifoldFrontierIncidences[frontierB - 1u] = incidenceB;
    InterlockedAdd(_ManifoldAllocator[9], 0xfffffffeu);
}

void PushLinkIncidence(uint filmIndex, ManifoldLink link, uint endpoint)
{
    if (filmIndex >= _FilmCapacity || link.id == 0u ||
        link.id > _LinkCapacity) return;
    uint incidenceIndex = (link.id - 1u) * 2u + min(endpoint, 1u);
    ManifoldLinkIncidence incidence = (ManifoldLinkIncidence)0;
    incidence.id = incidenceIndex + 1u;
    incidence.generation = link.generation;
    incidence.linkId = link.id;
    incidence.linkGeneration = link.generation;
    incidence.filmId = endpoint == 0u ? link.filmA : link.filmB;
    incidence.filmGeneration = endpoint == 0u ? link.filmAGeneration :
        link.filmBGeneration;
    incidence.endpoint = endpoint;
    incidence.flags = INCIDENCE_ACTIVE;
    _ManifoldLinkIncidences[incidenceIndex] = incidence;
    DeviceMemoryBarrier();
    uint previous;
    InterlockedExchange(_FilmMemberships[filmIndex].firstLink,
        incidence.id, previous);
    incidence.nextId = previous;
    incidence.nextGeneration = previous != 0u &&
        previous <= _LinkCapacity * 2u ?
        _ManifoldLinkIncidences[previous - 1u].generation : 0u;
    _ManifoldLinkIncidences[incidenceIndex] = incidence;
    InterlockedAdd(_FilmMemberships[filmIndex].linkCount, 1u);
    InterlockedAdd(_FilmMemberships[filmIndex].revision, 1u);
}

bool AllocateTypedLink(ContactFilmHeader filmA, ContactFilmHeader filmB, uint type,
    float4 uvA01, float4 uvB01, float separation, uint flags)
{
    FilmMembership membershipA = _FilmMemberships[filmA.id - 1u];
    FilmMembership membershipB = _FilmMemberships[filmB.id - 1u];
    if ((membershipA.flags & MEMBERSHIP_ACTIVE) == 0u ||
        (membershipB.flags & MEMBERSHIP_ACTIVE) == 0u ||
        membershipA.filmGeneration != filmA.generation ||
        membershipB.filmGeneration != filmB.generation ||
        membershipA.manifoldId != membershipB.manifoldId ||
        membershipA.manifoldGeneration != membershipB.manifoldGeneration)
        return false;
    uint hash = HashPair(filmA.id, filmA.generation,
        filmB.id, filmB.generation);
    uint hashSlot, existingLink;
    if (!ClaimLinkPair(hash, filmA.id, filmA.generation, filmB.id,
        filmB.generation, hashSlot, existingLink)) return existingLink != 0u;
    uint linkIndex;
    InterlockedAdd(_ManifoldAllocator[4], 1u, linkIndex);
    if (linkIndex >= _LinkCapacity)
    {
        InterlockedAdd(_ManifoldAllocator[6], 1u);
        _LinkHash[hashSlot] = (LinkHashEntry)0;
        return false;
    }
    ManifoldLink link = (ManifoldLink)0;
    link.id = linkIndex + 1u;
    link.generation = max(1u, _ManifoldAllocator[7]);
    link.manifoldId = membershipA.manifoldId;
    link.manifoldGeneration = membershipA.manifoldGeneration;
    link.filmA = filmA.id; link.filmAGeneration = filmA.generation;
    link.filmB = filmB.id; link.filmBGeneration = filmB.generation;
    link.type = type;
    link.flags = LINK_ACTIVE | flags;
    link.revision = 1u;
    link.uvA01 = uvA01;
    link.uvB01 = uvB01;
    link.sigma = max(max(filmA.sigmaNormal, filmB.sigmaNormal), separation);
    link.support = min(filmA.supportTotal, filmB.supportTotal);
    link.confidence = min(filmA.confidence, filmB.confidence);
    _ManifoldLinks[linkIndex] = link;
    _LinkHash[hashSlot].linkId = link.id;
    PushLinkIncidence(filmA.id - 1u, link, 0u);
    PushLinkIncidence(filmB.id - 1u, link, 1u);
    RetireAndSpliceFrontiers(
        ClosestActiveFrontier(membershipA, 0.5 * (uvA01.xy + uvA01.zw)),
        ClosestActiveFrontier(membershipB, 0.5 * (uvB01.xy + uvB01.zw)));
    InterlockedAdd(_ManifoldAllocator[5], 1u);
    InterlockedAdd(_ManifoldDiagnostics[6], 1u);
    return true;
}

bool WriteReservedTypedLink(uint linkIndex, ContactFilmHeader filmA,
    ContactFilmHeader filmB, uint type, float4 uvA01, float4 uvB01,
    float separation, uint flags)
{
    if (linkIndex >= _LinkCapacity) return false;
    FilmMembership membershipA = _FilmMemberships[filmA.id - 1u];
    FilmMembership membershipB = _FilmMemberships[filmB.id - 1u];
    if ((membershipA.flags & MEMBERSHIP_ACTIVE) == 0u ||
        (membershipB.flags & MEMBERSHIP_ACTIVE) == 0u ||
        membershipA.filmGeneration != filmA.generation ||
        membershipB.filmGeneration != filmB.generation ||
        membershipA.manifoldId != membershipB.manifoldId ||
        membershipA.manifoldGeneration != membershipB.manifoldGeneration)
        return false;
    ManifoldLink link = (ManifoldLink)0;
    link.id = linkIndex + 1u;
    link.generation = max(1u, _ManifoldAllocator[7]);
    link.manifoldId = membershipA.manifoldId;
    link.manifoldGeneration = membershipA.manifoldGeneration;
    link.filmA = filmA.id;
    link.filmAGeneration = filmA.generation;
    link.filmB = filmB.id;
    link.filmBGeneration = filmB.generation;
    link.type = type;
    link.flags = LINK_ACTIVE | flags;
    link.revision = 1u;
    link.uvA01 = uvA01;
    link.uvB01 = uvB01;
    link.sigma = max(max(filmA.sigmaNormal, filmB.sigmaNormal), separation);
    link.support = min(filmA.supportTotal, filmB.supportTotal);
    link.confidence = min(filmA.confidence, filmB.confidence);
    _ManifoldLinks[linkIndex] = link;
    PushLinkIncidence(filmA.id - 1u, link, 0u);
    PushLinkIncidence(filmB.id - 1u, link, 1u);
    InterlockedAdd(_ManifoldAllocator[5], 1u);
    InterlockedAdd(_ManifoldDiagnostics[6], 1u);
    return true;
}

[numthreads(64, 1, 1)]
void InitializeManifoldTopology(uint3 id : SV_DispatchThreadID)
{
    if (id.x <= _LinkHashMask) _LinkHash[id.x] = (LinkHashEntry)0;
    if (id.x <= _FilmHashMask) _FilmHashHeads[id.x] = INVALID_INDEX;
    if (id.x < _FilmCapacity) _FilmHashEntries[id.x] = (FilmHashEntry)0;
}

[numthreads(1, 1, 1)]
void BuildManifoldDispatchArguments(uint3 id : SV_DispatchThreadID)
{
    uint films = min(_FilmAllocator[6], _FilmCapacity);
    uint links = min(_ManifoldAllocator[4], _LinkCapacity);
    uint splits = min(_AdaptState[0], _FilmCapacity);
    _ManifoldDispatchArguments[0] = uint3((films + 63u) / 64u, 1u, 1u);
    _ManifoldDispatchArguments[1] = uint3((links + 63u) / 64u, 1u, 1u);
    _ManifoldDispatchArguments[2] = uint3(splits, 1u, 1u);
    _ManifoldDispatchArguments[3] = uint3(
        ((_FilmHashMask + 1u) + 63u) / 64u, 1u, 1u);
    _ManifoldDispatchArguments[4] = uint3(
        ((_LinkHashMask + 1u) + 63u) / 64u, 1u, 1u);
}

float2 ParentToChildUv(float2 parentUv, uint child)
{
    float2 offset = float2((child & 1u) != 0u ? 1.0 : 0.0,
        (child & 2u) != 0u ? 1.0 : 0.0);
    return saturate(parentUv * 2.0 - offset);
}

float4 ParentToChildSegment(float4 parentSegment, uint child)
{
    return float4(ParentToChildUv(parentSegment.xy, child),
        ParentToChildUv(parentSegment.zw, child));
}

bool ParentOuterSegment(float4 segment, out uint edge,
    out float coordinateA, out float coordinateB)
{
    const float epsilon = 0.025;
    float2 a = saturate(segment.xy);
    float2 b = saturate(segment.zw);
    edge = 0u;
    coordinateA = coordinateB = 0.0;
    if (abs(a.y) <= epsilon && abs(b.y) <= epsilon)
    { edge = 0u; coordinateA = a.x; coordinateB = b.x; return true; }
    if (abs(a.x - 1.0) <= epsilon && abs(b.x - 1.0) <= epsilon)
    { edge = 1u; coordinateA = a.y; coordinateB = b.y; return true; }
    if (abs(a.y - 1.0) <= epsilon && abs(b.y - 1.0) <= epsilon)
    { edge = 2u; coordinateA = a.x; coordinateB = b.x; return true; }
    if (abs(a.x) <= epsilon && abs(b.x) <= epsilon)
    { edge = 3u; coordinateA = a.y; coordinateB = b.y; return true; }
    return false;
}

uint ChildOnParentEdge(uint edge, float coordinate)
{
    bool upper = coordinate >= 0.5;
    if (edge == 0u) return upper ? 1u : 0u;
    if (edge == 1u) return upper ? 3u : 1u;
    if (edge == 2u) return upper ? 3u : 2u;
    return upper ? 2u : 0u;
}

uint SegmentChild(uint edge, float coordinateA, float coordinateB)
{
    return ChildOnParentEdge(edge, 0.5 * (coordinateA + coordinateB));
}

bool SegmentCrossesChildBoundary(float coordinateA, float coordinateB,
    out float splitT)
{
    float minimum = min(coordinateA, coordinateB);
    float maximum = max(coordinateA, coordinateB);
    bool crosses = minimum < 0.5 - 1e-6 && maximum > 0.5 + 1e-6;
    splitT = crosses ? saturate((0.5 - coordinateA) /
        (coordinateB - coordinateA)) : 0.0;
    return crosses;
}

bool SplitEligible(ContactFilmHeader parent, ContactTopologyEvidence evidence)
{
    if ((parent.flags & FILM_ACTIVE) == 0u ||
        (parent.flags & (FILM_SPLIT_PARENT | FILM_RETIRED |
            FILM_TOPOLOGY_LOCKED)) != 0u ||
        parent.reserved2 >= _MaximumSplitDepth ||
        min(parent.extentU, parent.extentV) < _MinimumSplitExtent)
        return false;
    float positiveMean = evidence.positiveSupport > 0.0 ?
        evidence.positiveMoment / evidence.positiveSupport : 0.0;
    float negativeMean = evidence.negativeSupport > 0.0 ?
        evidence.negativeMoment / evidence.negativeSupport : 0.0;
    float separation = positiveMean - negativeMean;
    bool bimodal = evidence.positiveSupport >= 4.0 &&
        evidence.negativeSupport >= 4.0 &&
        separation >= max(_BimodalSeparation, 4.0 * parent.sigmaNormal);
    bool boundarySplit = parent.boundaryCount > 0u &&
        evidence.boundarySupport >= _SplitBoundarySupport;
    bool nonSingle = evidence.totalSupport >= 8.0 &&
        evidence.residualVariance >= _SplitVariance &&
        parent.contradiction >= 0.35;
    return bimodal || boundarySplit || nonSingle;
}

bool PlannedFilm(uint filmIndex, uint acceptedCount)
{
    [loop]
    for (uint split = 0u; split < acceptedCount; ++split)
        if (_SplitRecordsWrite[split].parentFilmIndex == filmIndex)
            return true;
    return false;
}

float2 BoundaryFilmAUv(ContactBoundaryHeader boundary, float t)
{
    float s = 1.0 - t;
    return s * s * s * boundary.controlUv01.xy +
        3.0 * s * s * t * boundary.controlUv01.zw +
        3.0 * s * t * t * boundary.controlUv23.xy +
        t * t * t * boundary.controlUv23.zw;
}

float3 BoundaryWorldPoint(uint boundaryIndex, float t)
{
    uint information = boundaryIndex * BOUNDARY_INFORMATION_RECORDS;
    float3 p0 = _BoundaryInformationRead[information + 3u].xyz;
    float3 p1 = _BoundaryInformationRead[information + 4u].xyz;
    float3 p2 = _BoundaryInformationRead[information + 5u].xyz;
    float3 p3 = _BoundaryInformationRead[information + 6u].xyz;
    float s = 1.0 - t;
    return s * s * s * p0 + 3.0 * s * s * t * p1 +
        3.0 * s * t * t * p2 + t * t * t * p3;
}

float2 BoundaryEndpointUv(uint boundaryIndex, ContactBoundaryHeader boundary,
    ContactFilmHeader parent, uint endpoint, float t)
{
    return endpoint == 0u ? BoundaryFilmAUv(boundary, t) :
        ProjectUv(parent, BoundaryWorldPoint(boundaryIndex, t));
}

uint BoundaryUvQuadrant(float2 uv)
{
    return (uv.x >= 0.5 ? 1u : 0u) | (uv.y >= 0.5 ? 2u : 0u);
}

uint CountBoundarySegments(uint boundaryIndex, ContactBoundaryHeader boundary,
    ContactFilmHeader parent, uint endpoint)
{
    uint segmentCount = 1u;
    uint previousQuadrant = BoundaryUvQuadrant(
        BoundaryEndpointUv(boundaryIndex, boundary, parent, endpoint, 0.0));
    [unroll]
    for (uint sample = 1u; sample <= 32u; ++sample)
    {
        uint quadrant = BoundaryUvQuadrant(BoundaryEndpointUv(boundaryIndex,
            boundary, parent, endpoint, (float)sample / 32.0));
        if (quadrant != previousQuadrant) segmentCount++;
        previousQuadrant = quadrant;
    }
    return segmentCount;
}

bool BoundaryTouchesParent(ContactBoundaryHeader boundary,
    ContactFilmHeader parent, out uint endpoint, out uint otherFilm,
    out uint otherGeneration)
{
    bool parentIsA = boundary.filmA == parent.id &&
        boundary.filmAGeneration == parent.generation;
    bool parentIsB = boundary.filmB == parent.id &&
        boundary.filmBGeneration == parent.generation;
    if (parentIsA == parentIsB)
    {
        endpoint = 0u; otherFilm = 0u; otherGeneration = 0u;
        return false;
    }
    endpoint = parentIsB ? 1u : 0u;
    otherFilm = parentIsA ? boundary.filmB : boundary.filmA;
    otherGeneration = parentIsA ? boundary.filmBGeneration :
        boundary.filmAGeneration;
    return true;
}

bool CountSplitBoundaries(uint parentIndex, ContactFilmHeader parent,
    uint acceptedCount, out uint additionalBoundaryCount)
{
    additionalBoundaryCount = 0u;
    uint boundaryCount = min(_BoundaryAllocatorWrite[0], _BoundaryCapacity);
    [loop]
    for (uint boundaryIndex = 0u; boundaryIndex < boundaryCount;
        ++boundaryIndex)
    {
        ContactBoundaryHeader boundary = _BoundaryHeadersRead[boundaryIndex];
        if ((boundary.flags & (BOUNDARY_ACTIVE | BOUNDARY_RETIRED)) !=
                BOUNDARY_ACTIVE || boundary.id != boundaryIndex + 1u)
            continue;
        uint endpoint, otherFilm, otherGeneration;
        if (!BoundaryTouchesParent(boundary, parent, endpoint, otherFilm,
                otherGeneration)) continue;
        if (otherFilm != 0u)
        {
            if (otherFilm > _FilmCapacity || otherFilm == parent.id ||
                PlannedFilm(otherFilm - 1u, acceptedCount)) return false;
            ContactFilmHeader other = _FilmHeadersRead[otherFilm - 1u];
            if (other.id != otherFilm || other.generation != otherGeneration ||
                (other.flags & FILM_ACTIVE) == 0u) return false;
        }
        uint segments = CountBoundarySegments(boundaryIndex, boundary, parent,
            endpoint);
        if (segments == 0u || additionalBoundaryCount > 0xffffffffu -
            (segments - 1u)) return false;
        additionalBoundaryCount += segments - 1u;
    }
    return true;
}

bool WriteSplitBoundaryPlans(uint parentIndex, ContactFilmHeader parent,
    uint splitRecordIndex, uint reservedStart, uint reservedCount)
{
    uint cursor = 0u;
    uint boundaryCount = min(_BoundaryAllocatorWrite[0], _BoundaryCapacity);
    // The planner has not advanced boundary high-water yet, so this loop only
    // visits the immutable pre-transaction source set.
    [loop]
    for (uint boundaryIndex = 0u; boundaryIndex < boundaryCount;
        ++boundaryIndex)
    {
        ContactBoundaryHeader boundary = _BoundaryHeadersRead[boundaryIndex];
        if ((boundary.flags & (BOUNDARY_ACTIVE | BOUNDARY_RETIRED)) !=
                BOUNDARY_ACTIVE || boundary.id != boundaryIndex + 1u)
            continue;
        uint endpoint, otherFilm, otherGeneration;
        if (!BoundaryTouchesParent(boundary, parent, endpoint, otherFilm,
                otherGeneration)) continue;
        uint segments = CountBoundarySegments(boundaryIndex, boundary, parent,
            endpoint);
        uint extras = segments - 1u;
        if (cursor > reservedCount || extras > reservedCount - cursor)
            return false;
        TopologyBoundarySplitPlan plan = (TopologyBoundarySplitPlan)0;
        plan.boundaryIndex = boundaryIndex;
        plan.boundaryGeneration = boundary.generation;
        plan.splitRecordIndex = splitRecordIndex;
        plan.parentFilmIndex = parentIndex;
        plan.parentFilmGeneration = parent.generation;
        plan.parentEndpoint = endpoint;
        plan.reservedStart = reservedStart + cursor;
        plan.segmentCount = segments;
        _BoundarySplitPlansWrite[boundaryIndex] = plan;
        cursor += extras;
    }
    return cursor == reservedCount;
}

bool ReserveFilmSlot(out uint slot)
{
    slot = INVALID_INDEX;
    uint head = _FilmAllocatorWrite[4];
    FilmSlotState state = (FilmSlotState)0;
    if (head != 0u)
    {
        uint candidate = head - 1u;
        if (candidate >= _FilmCapacity || _FilmAllocatorWrite[5] == 0u)
            return false;
        state = _FilmSlotStates[candidate];
        _FilmAllocatorWrite[4] = state.nextFree;
        _FilmAllocatorWrite[5] = _FilmAllocatorWrite[5] - 1u;
        slot = candidate;
    }
    else
    {
        slot = _FilmAllocatorWrite[0];
        if (slot >= _FilmCapacity)
        { slot = INVALID_INDEX; return false; }
        _FilmAllocatorWrite[0] = slot + 1u;
        state = _FilmSlotStates[slot];
    }
    state.generation = state.generation + 1u;
    if (state.generation == 0u) state.generation = 1u;
    state.activeOrdinal = INVALID_INDEX;
    state.nextFree = 0u;
    state.flags = SLOT_ALLOCATED;
    _FilmSlotStates[slot] = state;
    return true;
}

void ReturnReservedFilmSlot(uint slot)
{
    if (slot == INVALID_INDEX || slot >= _FilmCapacity) return;
    FilmSlotState state = _FilmSlotStates[slot];
    state.activeOrdinal = INVALID_INDEX;
    state.nextFree = _FilmAllocatorWrite[4];
    state.flags = SLOT_FREE;
    _FilmSlotStates[slot] = state;
    _FilmAllocatorWrite[4] = slot + 1u;
    _FilmAllocatorWrite[5] = _FilmAllocatorWrite[5] + 1u;
}

bool CountSplitTopology(uint parentIndex, ContactFilmHeader parent,
    FilmMembership membership, uint acceptedCount,
    out uint externalLinkSplits, out uint frontierSplits)
{
    externalLinkSplits = 0u;
    frontierSplits = 0u;
    if ((membership.flags & MEMBERSHIP_ACTIVE) == 0u ||
        membership.filmId != parent.id ||
        membership.filmGeneration != parent.generation ||
        membership.manifoldId == 0u ||
        membership.manifoldId > _ManifoldCapacity ||
        (membership.linkCount == 0u && membership.frontierCount == 0u))
        return false;

    uint incidenceId = membership.firstLink;
    uint visitedLinks = 0u;
    [loop]
    while (incidenceId != 0u && visitedLinks < membership.linkCount)
    {
        if (incidenceId > _LinkCapacity * 2u) return false;
        ManifoldLinkIncidence incidence =
            _ManifoldLinkIncidencesRead[incidenceId - 1u];
        if (incidence.id != incidenceId ||
            (incidence.flags & INCIDENCE_ACTIVE) == 0u ||
            incidence.filmId != parent.id ||
            incidence.filmGeneration != parent.generation ||
            incidence.linkId == 0u || incidence.linkId > _LinkCapacity)
            return false;
        ManifoldLink link = _ManifoldLinksRead[incidence.linkId - 1u];
        bool parentIsA = incidence.endpoint == 0u &&
            link.filmA == parent.id &&
            link.filmAGeneration == parent.generation;
        bool parentIsB = incidence.endpoint == 1u &&
            link.filmB == parent.id &&
            link.filmBGeneration == parent.generation;
        if (incidence.linkGeneration != link.generation ||
            (link.flags & (LINK_ACTIVE | LINK_RETIRED)) != LINK_ACTIVE ||
            (!parentIsA && !parentIsB)) return false;
        uint otherFilm = parentIsA ? link.filmB : link.filmA;
        if (otherFilm == 0u || otherFilm > _FilmCapacity ||
            PlannedFilm(otherFilm - 1u, acceptedCount))
            return false;
        float4 own = parentIsA ? link.uvA01 : link.uvB01;
        uint edge;
        float coordinateA, coordinateB, splitT;
        if (!ParentOuterSegment(own, edge, coordinateA, coordinateB))
            return false;
        if (SegmentCrossesChildBoundary(coordinateA, coordinateB, splitT))
            externalLinkSplits++;
        incidenceId = incidence.nextId;
        visitedLinks++;
    }
    if (visitedLinks != membership.linkCount || incidenceId != 0u)
        return false;

    uint frontierIncidenceId = membership.firstFrontier;
    uint visitedFrontiers = 0u;
    [loop]
    while (frontierIncidenceId != 0u &&
        visitedFrontiers < membership.frontierCount)
    {
        if (frontierIncidenceId > _FrontierCapacity) return false;
        ManifoldFrontierIncidence incidence =
            _ManifoldFrontierIncidencesRead[frontierIncidenceId - 1u];
        if (incidence.id != frontierIncidenceId ||
            (incidence.flags & FRONTIER_ACTIVE) == 0u ||
            incidence.filmId != parent.id ||
            incidence.filmGeneration != parent.generation ||
            incidence.frontierId == 0u ||
            incidence.frontierId > _FrontierCapacity)
            return false;
        LatentFrontierSegment frontier =
            _LatentFrontiersRead[incidence.frontierId - 1u];
        if (frontier.id != incidence.frontierId ||
            frontier.generation != incidence.frontierGeneration ||
            frontier.filmId != parent.id ||
            frontier.filmGeneration != parent.generation ||
            (frontier.flags & (FRONTIER_ACTIVE | FRONTIER_RETIRED |
                FRONTIER_OUTER | FRONTIER_ORDERED)) !=
                (FRONTIER_ACTIVE | FRONTIER_OUTER | FRONTIER_ORDERED) ||
            frontier.nextId == 0u || frontier.nextId > _FrontierCapacity ||
            frontier.previousId == 0u ||
            frontier.previousId > _FrontierCapacity)
            return false;
        uint edge;
        float coordinateA, coordinateB, splitT;
        if (!ParentOuterSegment(frontier.uv01, edge, coordinateA,
                coordinateB)) return false;
        if (SegmentCrossesChildBoundary(coordinateA, coordinateB, splitT))
            frontierSplits++;
        frontierIncidenceId = incidence.nextId;
        visitedFrontiers++;
    }
    return visitedFrontiers == membership.frontierCount &&
        frontierIncidenceId == 0u;
}

[numthreads(1, 1, 1)]
void PlanSplitTransactions(uint3 id : SV_DispatchThreadID)
{
    uint dirtyCount = min(_TopologyState[0], _FilmCapacity);
    uint acceptedCount = 0u;
    _AdaptStateWrite[3] = min(_BoundaryAllocatorWrite[0], _BoundaryCapacity);
    [loop]
    for (uint dirtyOrdinal = 0u; dirtyOrdinal < dirtyCount; ++dirtyOrdinal)
    {
        uint parentIndex = _DirtyTopologyIndices[dirtyOrdinal];
        if (parentIndex >= _FilmCapacity ||
            PlannedFilm(parentIndex, acceptedCount)) continue;
        ContactFilmHeader parent = _FilmHeadersRead[parentIndex];
        ContactTopologyEvidence evidence = _TopologyEvidenceRead[parentIndex];
        if (!SplitEligible(parent, evidence)) continue;
        FilmSlotState parentState = _FilmSlotStates[parentIndex];
        if (parentState.generation != parent.generation ||
            parentState.activeOrdinal >= _FilmCapacity ||
            _ActiveFilmIndices[parentState.activeOrdinal] != parentIndex)
        { _AdaptStateWrite[1]++; continue; }
        FilmMembership membership = _FilmMembershipsRead[parentIndex];
        uint externalLinkSplits, frontierSplits;
        if (!CountSplitTopology(parentIndex, parent, membership, acceptedCount,
                externalLinkSplits, frontierSplits))
        { _AdaptStateWrite[2]++; continue; }
        uint additionalBoundaries;
        if (!CountSplitBoundaries(parentIndex, parent, acceptedCount,
                additionalBoundaries))
        { _AdaptStateWrite[2]++; continue; }

        uint requiredLinks = externalLinkSplits + 4u;
        uint filmHighWater = _FilmAllocatorWrite[0];
        uint availableFilms = _FilmAllocatorWrite[5] +
            (_FilmCapacity > filmHighWater ? _FilmCapacity - filmHighWater : 0u);
        uint activeCount = _FilmAllocatorWrite[6];
        uint dirtyFilmCount = _FilmAllocatorWrite[7];
        uint firstPage = _DisplacementAllocatorWrite[0];
        uint linkStart = _ManifoldAllocator[4];
        uint frontierStart = _ManifoldAllocator[8];
        uint boundaryStart = _BoundaryAllocatorWrite[0];
        bool capacityValid = acceptedCount < _FilmCapacity &&
            availableFilms >= 4u && activeCount <= _FilmCapacity - 3u &&
            dirtyFilmCount <= _FilmCapacity - 4u &&
            firstPage <= _BasePageCapacity - 4u &&
            requiredLinks <= _LinkCapacity &&
            linkStart <= _LinkCapacity - requiredLinks &&
            frontierSplits <= _FrontierCapacity &&
            frontierStart <= _FrontierCapacity - frontierSplits &&
            additionalBoundaries <= _BoundaryCapacity &&
            boundaryStart <= _BoundaryCapacity - additionalBoundaries;
        if (!capacityValid)
        {
            _AdaptStateWrite[1]++;
            _FilmAllocatorWrite[2]++;
            if (additionalBoundaries > _BoundaryCapacity ||
                boundaryStart > _BoundaryCapacity -
                    min(additionalBoundaries, _BoundaryCapacity))
                _BoundaryAllocatorWrite[2]++;
            continue;
        }

        if (!WriteSplitBoundaryPlans(parentIndex, parent, acceptedCount,
                boundaryStart, additionalBoundaries))
        {
            _AdaptStateWrite[2]++;
            continue;
        }

        uint childIndices[4] = { INVALID_INDEX, INVALID_INDEX,
            INVALID_INDEX, INVALID_INDEX };
        bool slotsReserved = true;
        [unroll]
        for (uint child = 0u; child < 4u; ++child)
            slotsReserved = ReserveFilmSlot(childIndices[child]) &&
                slotsReserved;
        if (!slotsReserved)
        {
            [unroll]
            for (uint child = 0u; child < 4u; ++child)
                ReturnReservedFilmSlot(childIndices[child]);
            _AdaptStateWrite[1]++;
            continue;
        }

        TopologySplitRecord record = (TopologySplitRecord)0;
        record.parentFilmIndex = parentIndex;
        record.parentFilmGeneration = parent.generation;
        record.childFilmIndex0 = childIndices[0];
        record.childFilmIndex1 = childIndices[1];
        record.childFilmIndex2 = childIndices[2];
        record.childFilmIndex3 = childIndices[3];
        record.firstChildBasePage = firstPage;
        record.childCount = 4u;
        record.parentActiveOrdinal = parentState.activeOrdinal;
        record.firstNewActiveOrdinal = activeCount;
        record.firstDirtyOrdinal = dirtyFilmCount;
        record.reservedLinkStart = linkStart;
        record.reservedExternalLinkCount = externalLinkSplits;
        record.reservedLinkCount = requiredLinks;
        record.reservedFrontierStart = frontierStart;
        record.reservedFrontierCount = frontierSplits;
        record.reservedBoundaryStart = boundaryStart;
        record.reservedBoundaryCount = additionalBoundaries;
        record.transactionState = SPLIT_TRANSACTION_RESERVED;
        _SplitRecordsWrite[acceptedCount] = record;

        _DisplacementAllocatorWrite[0] = firstPage + 4u;
        _ManifoldAllocator[4] = linkStart + requiredLinks;
        _ManifoldAllocator[8] = frontierStart + frontierSplits;
        _BoundaryAllocatorWrite[0] = boundaryStart + additionalBoundaries;
        _BoundaryAllocatorWrite[1] += additionalBoundaries;
        _FilmAllocatorWrite[1] += 3u;
        _FilmAllocatorWrite[6] = activeCount + 3u;
        _FilmAllocatorWrite[7] = dirtyFilmCount + 4u;
        acceptedCount++;
    }
    _AdaptStateWrite[0] = acceptedCount;
}

void PushFrontierIncidence(uint filmIndex, LatentFrontierSegment segment)
{
    if (filmIndex >= _FilmCapacity || segment.id == 0u ||
        segment.id > _FrontierCapacity) return;
    ManifoldFrontierIncidence incidence = (ManifoldFrontierIncidence)0;
    incidence.id = segment.id;
    incidence.generation = segment.generation;
    incidence.frontierId = segment.id;
    incidence.frontierGeneration = segment.generation;
    incidence.filmId = segment.filmId;
    incidence.filmGeneration = segment.filmGeneration;
    incidence.flags = FRONTIER_ACTIVE;
    uint previous = _FilmMemberships[filmIndex].firstFrontier;
    incidence.nextId = previous;
    incidence.nextGeneration = previous != 0u &&
        previous <= _FrontierCapacity ?
        _ManifoldFrontierIncidences[previous - 1u].generation : 0u;
    _ManifoldFrontierIncidences[segment.id - 1u] = incidence;
    _FilmMemberships[filmIndex].firstFrontier = incidence.id;
    _FilmMemberships[filmIndex].frontierCount++;
    _FilmMemberships[filmIndex].revision++;
}

void InitializeSplitMembership(uint filmIndex, FilmMembership parentMembership)
{
    ContactFilmHeader film = _FilmHeaders[filmIndex];
    FilmMembership membership = (FilmMembership)0;
    membership.filmId = film.id;
    membership.filmGeneration = film.generation;
    membership.manifoldId = parentMembership.manifoldId;
    membership.manifoldGeneration = parentMembership.manifoldGeneration;
    membership.flags = MEMBERSHIP_ACTIVE | MEMBERSHIP_MEASURED;
    membership.revision = 1u;
    _FilmMemberships[filmIndex] = membership;
}

bool WriteReservedSplitLink(uint linkIndex, ManifoldLink source,
    bool parentIsA, ContactFilmHeader child, float4 childUv, float4 otherUv)
{
    if (linkIndex >= _LinkCapacity)
    {
        InterlockedAdd(_ManifoldDiagnostics[9], 1u);
        return false;
    }
    ManifoldLink link = source;
    link.id = linkIndex + 1u;
    link.generation = max(1u, _ManifoldAllocator[7]);
    link.revision = source.revision + 1u;
    if (parentIsA)
    {
        link.filmA = child.id;
        link.filmAGeneration = child.generation;
        link.uvA01 = childUv;
        link.uvB01 = otherUv;
    }
    else
    {
        link.filmB = child.id;
        link.filmBGeneration = child.generation;
        link.uvB01 = childUv;
        link.uvA01 = otherUv;
    }
    _ManifoldLinks[linkIndex] = link;
    PushLinkIncidence(child.id - 1u, link, parentIsA ? 0u : 1u);
    uint otherFilm = parentIsA ? link.filmB : link.filmA;
    if (otherFilm == 0u || otherFilm > _FilmCapacity)
    {
        InterlockedAdd(_ManifoldDiagnostics[9], 1u);
        return false;
    }
    PushLinkIncidence(otherFilm - 1u, link, parentIsA ? 1u : 0u);
    InterlockedAdd(_ManifoldAllocator[5], 1u);
    InterlockedAdd(_ManifoldDiagnostics[6], 1u);
    return true;
}

void RemapOneSplit(TopologySplitRecord record)
{
    if (record.transactionState != SPLIT_TRANSACTION_COMMITTED ||
        record.parentFilmIndex >= _FilmCapacity || record.childCount != 4u)
        return;
    ContactFilmHeader parentFilm = _FilmHeaders[record.parentFilmIndex];
    FilmMembership parentMembership = _FilmMemberships[record.parentFilmIndex];
    if ((parentMembership.flags & MEMBERSHIP_ACTIVE) == 0u) return;

    [unroll]
    for (uint child = 0u; child < 4u; ++child)
    {
        uint filmIndex = SplitChildIndex(record, child);
        if (filmIndex >= _FilmCapacity)
        {
            InterlockedAdd(_ManifoldDiagnostics[9], 1u);
            return;
        }
        InitializeSplitMembership(filmIndex, parentMembership);
    }

    // Preserve the existing ordered outer loop. A segment remains the same
    // generation-tagged node when it maps to one child; if it crosses the split
    // midpoint it is spliced into two ordered nodes in-place. No child receives an
    // independent rectangular cap.
    uint parentFrontierCount = min(parentMembership.frontierCount,
        _FrontierCapacity);
    uint parentIncidenceId = parentMembership.firstFrontier;
    uint reservedFrontierCursor = 0u;
    [loop]
    for (uint frontierOrdinal = 0u; frontierOrdinal < parentFrontierCount;
        ++frontierOrdinal)
    {
        if (parentIncidenceId == 0u ||
            parentIncidenceId > _FrontierCapacity) break;
        ManifoldFrontierIncidence oldIncidence =
            _ManifoldFrontierIncidences[parentIncidenceId - 1u];
        parentIncidenceId = oldIncidence.nextId;
        uint frontierId = oldIncidence.frontierId;
        if (frontierId == 0u || frontierId > _FrontierCapacity) continue;
        LatentFrontierSegment oldFrontier = _LatentFrontiers[frontierId - 1u];
        if ((oldFrontier.flags & (FRONTIER_ACTIVE | FRONTIER_RETIRED)) !=
            FRONTIER_ACTIVE || oldFrontier.filmId != parentFilm.id ||
            oldFrontier.filmGeneration != parentFilm.generation) continue;
        uint edge;
        float coordinateA, coordinateB;
        if (!ParentOuterSegment(oldFrontier.uv01, edge, coordinateA,
                coordinateB))
        {
            InterlockedAdd(_ManifoldDiagnostics[9], 1u);
            continue;
        }
        float splitT;
        bool crosses = SegmentCrossesChildBoundary(coordinateA, coordinateB,
            splitT);
        float4 parentFirst = oldFrontier.uv01;
        float4 parentSecond = 0.0;
        if (crosses)
        {
            float2 midpoint = lerp(oldFrontier.uv01.xy,
                oldFrontier.uv01.zw, splitT);
            parentFirst.zw = midpoint;
            parentSecond = float4(midpoint, oldFrontier.uv01.zw);
        }
        uint childFirst = SegmentChild(edge,
            edge == 0u || edge == 2u ? parentFirst.x : parentFirst.y,
            edge == 0u || edge == 2u ? parentFirst.z : parentFirst.w);
        uint childFirstIndex = SplitChildIndex(record, childFirst);
        ContactFilmHeader firstFilm = _FilmHeaders[childFirstIndex];
        uint oldNextId = oldFrontier.nextId;
        uint oldNextGeneration = oldFrontier.nextGeneration;
        oldFrontier.filmId = firstFilm.id;
        oldFrontier.filmGeneration = firstFilm.generation;
        oldFrontier.uv01 = ParentToChildSegment(parentFirst, childFirst);
        oldFrontier.revision++;

        if (crosses)
        {
            if (reservedFrontierCursor >= record.reservedFrontierCount)
            {
                InterlockedAdd(_ManifoldDiagnostics[9], 1u);
                return;
            }
            uint newIndex = record.reservedFrontierStart +
                reservedFrontierCursor++;
            uint childSecond = SegmentChild(edge,
                edge == 0u || edge == 2u ? parentSecond.x : parentSecond.y,
                edge == 0u || edge == 2u ? parentSecond.z : parentSecond.w);
            uint childSecondIndex = SplitChildIndex(record, childSecond);
            ContactFilmHeader secondFilm = _FilmHeaders[childSecondIndex];
            LatentFrontierSegment second = oldFrontier;
            second.id = newIndex + 1u;
            second.generation = max(1u, _ManifoldAllocator[11]);
            second.filmId = secondFilm.id;
            second.filmGeneration = secondFilm.generation;
            second.uv01 = ParentToChildSegment(parentSecond, childSecond);
            second.previousId = oldFrontier.id;
            second.previousGeneration = oldFrontier.generation;
            second.nextId = oldNextId;
            second.nextGeneration = oldNextGeneration;
            second.revision++;
            oldFrontier.nextId = second.id;
            oldFrontier.nextGeneration = second.generation;
            if (oldNextId == 0u || oldNextId > _FrontierCapacity)
            {
                InterlockedAdd(_ManifoldDiagnostics[9], 1u);
                continue;
            }
            LatentFrontierSegment oldNext =
                _LatentFrontiers[oldNextId - 1u];
            if (oldNext.generation != oldNextGeneration)
            {
                InterlockedAdd(_ManifoldDiagnostics[9], 1u);
                continue;
            }
            oldNext.previousId = second.id;
            oldNext.previousGeneration = second.generation;
            oldNext.revision++;
            _LatentFrontiers[oldNextId - 1u] = oldNext;
            _LatentFrontiers[newIndex] = second;
            PushFrontierIncidence(childSecondIndex, second);
            InterlockedAdd(_ManifoldAllocator[9], 1u);
            InterlockedAdd(_ManifoldDiagnostics[7], 1u);
        }
        _LatentFrontiers[oldFrontier.id - 1u] = oldFrontier;
        PushFrontierIncidence(childFirstIndex, oldFrontier);
    }

    // Partition every incident external link at the same parent-edge midpoint.
    // Partial dyadic intervals are first-class canonical links; the edge validator
    // proves their exact non-overlapping union instead of forcing a fake full edge.
    uint parentLinkCount = min(parentMembership.linkCount, _LinkCapacity * 2u);
    uint incidenceId = parentMembership.firstLink;
    uint reservedExternalLinkCursor = 0u;
    [loop]
    for (uint ordinal = 0u; ordinal < parentLinkCount; ++ordinal)
    {
        if (incidenceId == 0u || incidenceId > _LinkCapacity * 2u)
        { InterlockedAdd(_ManifoldDiagnostics[9], 1u); break; }
        ManifoldLinkIncidence incidence =
            _ManifoldLinkIncidences[incidenceId - 1u];
        uint nextIncidence = incidence.nextId;
        if (incidence.linkId == 0u || incidence.linkId > _LinkCapacity)
        { incidenceId = nextIncidence; continue; }
        ManifoldLink link = _ManifoldLinks[incidence.linkId - 1u];
        bool parentIsA = link.filmA == parentFilm.id &&
            link.filmAGeneration == parentFilm.generation;
        bool parentIsB = link.filmB == parentFilm.id &&
            link.filmBGeneration == parentFilm.generation;
        if ((link.flags & (LINK_ACTIVE | LINK_RETIRED)) != LINK_ACTIVE ||
            (!parentIsA && !parentIsB))
        { incidenceId = nextIncidence; continue; }
        float4 own = parentIsA ? link.uvA01 : link.uvB01;
        float4 other = parentIsA ? link.uvB01 : link.uvA01;
        uint edge;
        float coordinateA, coordinateB;
        if (!ParentOuterSegment(own, edge, coordinateA, coordinateB))
        {
            InterlockedAdd(_ManifoldDiagnostics[9], 1u);
            incidenceId = nextIncidence;
            continue;
        }
        float splitT;
        bool crosses = SegmentCrossesChildBoundary(coordinateA, coordinateB,
            splitT);
        float4 ownFirst = own;
        float4 ownSecond = 0.0;
        float4 otherFirst = other;
        float4 otherSecond = 0.0;
        if (crosses)
        {
            float2 ownMidpoint = lerp(own.xy, own.zw, splitT);
            float2 otherMidpoint = lerp(other.xy, other.zw, splitT);
            ownFirst.zw = ownMidpoint;
            ownSecond = float4(ownMidpoint, own.zw);
            otherFirst.zw = otherMidpoint;
            otherSecond = float4(otherMidpoint, other.zw);
        }
        uint childFirst = SegmentChild(edge,
            edge == 0u || edge == 2u ? ownFirst.x : ownFirst.y,
            edge == 0u || edge == 2u ? ownFirst.z : ownFirst.w);
        uint childFirstIndex = SplitChildIndex(record, childFirst);
        ContactFilmHeader firstFilm = _FilmHeaders[childFirstIndex];
        if (parentIsA)
        {
            link.filmA = firstFilm.id;
            link.filmAGeneration = firstFilm.generation;
            link.uvA01 = ParentToChildSegment(ownFirst, childFirst);
            link.uvB01 = otherFirst;
        }
        else
        {
            link.filmB = firstFilm.id;
            link.filmBGeneration = firstFilm.generation;
            link.uvB01 = ParentToChildSegment(ownFirst, childFirst);
            link.uvA01 = otherFirst;
        }
        link.revision++;
        _ManifoldLinks[incidence.linkId - 1u] = link;
        PushLinkIncidence(childFirstIndex, link, parentIsA ? 0u : 1u);
        if (crosses)
        {
            if (reservedExternalLinkCursor >=
                record.reservedExternalLinkCount)
            {
                InterlockedAdd(_ManifoldDiagnostics[9], 1u);
                return;
            }
            uint childSecond = SegmentChild(edge,
                edge == 0u || edge == 2u ? ownSecond.x : ownSecond.y,
                edge == 0u || edge == 2u ? ownSecond.z : ownSecond.w);
            uint childSecondIndex = SplitChildIndex(record, childSecond);
            ContactFilmHeader secondFilm = _FilmHeaders[childSecondIndex];
            WriteReservedSplitLink(record.reservedLinkStart +
                reservedExternalLinkCursor++, link, parentIsA, secondFilm,
                ParentToChildSegment(ownSecond, childSecond), otherSecond);
        }
        incidenceId = nextIncidence;
    }
    if (reservedFrontierCursor != record.reservedFrontierCount ||
        reservedExternalLinkCursor != record.reservedExternalLinkCount)
    {
        InterlockedAdd(_ManifoldDiagnostics[9], 1u);
        return;
    }
    parentMembership.flags = 0u;
    parentMembership.linkCount = 0u;
    parentMembership.frontierCount = 0u;
    parentMembership.revision++;
    _FilmMemberships[record.parentFilmIndex] = parentMembership;
    InterlockedAdd(_ManifoldAllocator[12], 3u);
    InterlockedAdd(_ManifoldDiagnostics[11], 1u);
}

[numthreads(1, 1, 1)]
void RemapSplitMemberships(uint3 id : SV_DispatchThreadID)
{
    if (id.x != 0u) return;
    uint splitCount = min(_AdaptState[0], _FilmCapacity);
    [loop]
    for (uint split = 0u; split < splitCount; ++split)
        RemapOneSplit(_SplitRecords[split]);
}

[numthreads(1, 1, 1)]
void LinkSplitChildren(uint3 id : SV_DispatchThreadID)
{
    uint splitCount = min(_AdaptState[0], _FilmCapacity);
    if (id.x >= splitCount) return;
    TopologySplitRecord record = _SplitRecords[id.x];
    if (record.transactionState != SPLIT_TRANSACTION_COMMITTED ||
        record.childCount != 4u ||
        record.reservedLinkCount != record.reservedExternalLinkCount + 4u)
        return;
    uint child0 = SplitChildIndex(record, 0u);
    uint child1 = SplitChildIndex(record, 1u);
    uint child2 = SplitChildIndex(record, 2u);
    uint child3 = SplitChildIndex(record, 3u);
    if (child0 >= _FilmCapacity || child1 >= _FilmCapacity ||
        child2 >= _FilmCapacity || child3 >= _FilmCapacity) return;
    ContactFilmHeader c0 = _FilmHeadersRead[child0];
    ContactFilmHeader c1 = _FilmHeadersRead[child1];
    ContactFilmHeader c2 = _FilmHeadersRead[child2];
    ContactFilmHeader c3 = _FilmHeadersRead[child3];
    uint linkStart = record.reservedLinkStart +
        record.reservedExternalLinkCount;
    bool valid = WriteReservedTypedLink(linkStart + 0u, c0, c1, LINK_SMOOTH,
        float4(1, 0, 1, 1),
        float4(0, 0, 0, 1), 0.0, LINK_MULTIVIEW);
    valid = WriteReservedTypedLink(linkStart + 1u, c0, c2, LINK_SMOOTH,
        float4(0, 1, 1, 1),
        float4(0, 0, 1, 0), 0.0, LINK_MULTIVIEW) && valid;
    valid = WriteReservedTypedLink(linkStart + 2u, c1, c3, LINK_SMOOTH,
        float4(0, 1, 1, 1),
        float4(0, 0, 1, 0), 0.0, LINK_MULTIVIEW) && valid;
    valid = WriteReservedTypedLink(linkStart + 3u, c2, c3, LINK_SMOOTH,
        float4(1, 0, 1, 1), float4(0, 0, 0, 1), 0.0,
        LINK_MULTIVIEW) && valid;
    if (!valid) InterlockedAdd(_ManifoldDiagnostics[9], 1u);
}

[numthreads(1, 1, 1)]
void ReleaseSplitParents(uint3 id : SV_DispatchThreadID)
{
    uint splitCount = min(_AdaptState[0], _FilmCapacity);
    if (id.x >= splitCount) return;
    TopologySplitRecord record = _SplitRecords[id.x];
    if (record.transactionState != SPLIT_TRANSACTION_COMMITTED ||
        record.parentFilmIndex >= _FilmCapacity) return;
    ContactFilmHeader parent = _FilmHeaders[record.parentFilmIndex];
    FilmMembership membership = _FilmMemberships[record.parentFilmIndex];
    FilmSlotState state = _FilmSlotStates[record.parentFilmIndex];
    if (parent.generation != record.parentFilmGeneration ||
        (parent.flags & FILM_RETIRED) == 0u ||
        (membership.flags & MEMBERSHIP_ACTIVE) != 0u ||
        state.generation != record.parentFilmGeneration) return;
    state.activeOrdinal = INVALID_INDEX;
    state.flags = SLOT_FREE;
    [loop]
    for (uint attempt = 0u; attempt < 128u; ++attempt)
    {
        uint head = _FilmAllocatorWrite[4];
        state.nextFree = head;
        _FilmSlotStates[record.parentFilmIndex] = state;
        uint observed;
        InterlockedCompareExchange(_FilmAllocatorWrite[4], head,
            record.parentFilmIndex + 1u, observed);
        if (observed != head) continue;
        InterlockedAdd(_FilmAllocatorWrite[5], 1u);
        return;
    }
    InterlockedAdd(_FilmAllocatorWrite[2], 1u);
}

[numthreads(64, 1, 1)]
void ClearCanonicalLinkHash(uint3 id : SV_DispatchThreadID)
{
    if (id.x <= _LinkHashMask) _LinkHash[id.x] = (LinkHashEntry)0;
}

[numthreads(64, 1, 1)]
void BuildCanonicalLinkHash(uint3 id : SV_DispatchThreadID)
{
    uint count = min(_ManifoldAllocator[4], _LinkCapacity);
    if (id.x >= count) return;
    ManifoldLink link = _ManifoldLinks[id.x];
    if ((link.flags & (LINK_ACTIVE | LINK_RETIRED)) != LINK_ACTIVE) return;
    uint hash = HashPair(link.filmA, link.filmAGeneration,
        link.filmB, link.filmBGeneration);
    [loop]
    for (uint probe = 0u; probe < 32u; ++probe)
    {
        uint slot = (hash + probe * 0x9e3779b9u) & _LinkHashMask;
        uint observed;
        InterlockedCompareExchange(_LinkHash[slot].hash, 0u, hash, observed);
        if (observed == 0u)
        {
            _LinkHash[slot].linkId = link.id;
            return;
        }
        if (observed == hash)
        {
            uint existingId = _LinkHash[slot].linkId;
            if (existingId == 0u) continue;
            ManifoldLink existing = _ManifoldLinks[existingId - 1u];
            if (SameLinkPair(existing, link.filmA, link.filmAGeneration,
                link.filmB, link.filmBGeneration)) return;
        }
    }
    InterlockedAdd(_ManifoldDiagnostics[10], 1u);
}

[numthreads(64, 1, 1)]
void ClearFilmContinuationHash(uint3 id : SV_DispatchThreadID)
{
    if (id.x <= _FilmHashMask) _FilmHashHeads[id.x] = INVALID_INDEX;
}

[numthreads(64, 1, 1)]
void BuildFilmContinuationHash(uint3 id : SV_DispatchThreadID)
{
    uint count = min(_FilmAllocator[6], _FilmCapacity);
    uint ordinal = id.x;
    if (ordinal >= count) return;
    uint index = _ActiveFilmIndices[ordinal];
    if (index >= _FilmCapacity) return;
    ContactFilmHeader film = _FilmHeaders[index];
    FilmMembership membership;
    if ((film.flags & FILM_ACTIVE) == 0u ||
        !ValidMembership(index, film, membership)) return;
    uint hash = HashCell((int3)floor(film.origin / 0.25));
    uint bucket = hash & _FilmHashMask;
    uint previous;
    InterlockedExchange(_FilmHashHeads[bucket], index, previous);
    FilmHashEntry entry;
    entry.hash = hash;
    entry.filmId = film.id;
    entry.filmGeneration = film.generation;
    entry.next = previous;
    _FilmHashEntries[index] = entry;
}

[numthreads(64, 1, 1)]
void ProveMeasuredContinuationLinks(uint3 id : SV_DispatchThreadID)
{
    uint count = min(_FilmAllocator[6], _FilmCapacity);
    uint ordinalA = id.x;
    if (ordinalA >= count) return;
    uint indexA = _ActiveFilmIndices[ordinalA];
    if (indexA >= _FilmCapacity) return;
    ContactFilmHeader filmA = _FilmHeadersRead[indexA];
    FilmMembership membershipA;
    if ((filmA.flags & FILM_ACTIVE) == 0u || filmA.confidence < 0.25 ||
        !ValidMembershipRead(indexA, filmA, membershipA)) return;
    int3 centre = (int3)floor(filmA.origin / 0.25);
    [unroll]
    for (int z = -1; z <= 1; ++z)
    [unroll]
    for (int y = -1; y <= 1; ++y)
    [unroll]
    for (int x = -1; x <= 1; ++x)
    {
        uint hash = HashCell(centre + int3(x, y, z));
        uint other = _FilmHashHeadsRead[hash & _FilmHashMask];
        [loop]
        for (uint chain = 0u; chain < 128u && other != INVALID_INDEX; ++chain)
        {
            FilmHashEntry entry = (FilmHashEntry)0;
            if (other < _FilmCapacity)
                entry = _FilmHashEntriesRead[other];
            if (other > indexA && entry.hash == hash)
            {
                ContactFilmHeader filmB = _FilmHeadersRead[other];
                FilmMembership membershipB;
                if ((filmB.flags & FILM_ACTIVE) != 0u && filmB.confidence >= 0.25 &&
                    ValidMembershipRead(other, filmB, membershipB) &&
                    membershipA.manifoldId == membershipB.manifoldId &&
                    membershipA.manifoldGeneration ==
                        membershipB.manifoldGeneration)
                {
                    uint type;
                    float4 uvA01, uvB01;
                    float separation;
                    if (ResolveContinuation(filmA, filmB, type, uvA01, uvB01,
                        separation))
                        AllocateTypedLink(filmA, filmB, type, uvA01, uvB01,
                            separation, LINK_MULTIVIEW);
                }
            }
            other = entry.next;
        }
    }
}

[numthreads(1, 1, 1)]
void ClearManifoldValidation(uint3 id : SV_DispatchThreadID)
{
    _ManifoldDiagnostics[5] = _ManifoldAllocator[1];
    _ManifoldDiagnostics[6] = _ManifoldAllocator[5];
    _ManifoldDiagnostics[7] = _ManifoldAllocator[9];
    _ManifoldDiagnostics[8] = 0u;
    _ManifoldDiagnostics[9] = 0u;
    _ManifoldAllocator[14] = 0u;
}

bool OuterEdgeCoverage(float4 uv01, out uint edgeIndex, out uint coverageMask)
{
    const float edgeEpsilon = 0.025;
    const uint coverageBins = 32u;
    float2 a = saturate(uv01.xy);
    float2 b = saturate(uv01.zw);
    edgeIndex = 0u;
    coverageMask = 0u;
    float ca = 0.0;
    float cb = 0.0;
    if (abs(a.y) <= edgeEpsilon && abs(b.y) <= edgeEpsilon &&
        abs(a.x - b.x) > 1e-5)
    { edgeIndex = 0u; ca = a.x; cb = b.x; }
    else if (abs(a.x - 1.0) <= edgeEpsilon &&
        abs(b.x - 1.0) <= edgeEpsilon && abs(a.y - b.y) > 1e-5)
    { edgeIndex = 1u; ca = a.y; cb = b.y; }
    else if (abs(a.y - 1.0) <= edgeEpsilon &&
        abs(b.y - 1.0) <= edgeEpsilon && abs(a.x - b.x) > 1e-5)
    { edgeIndex = 2u; ca = a.x; cb = b.x; }
    else if (abs(a.x) <= edgeEpsilon && abs(b.x) <= edgeEpsilon &&
        abs(a.y - b.y) > 1e-5)
    { edgeIndex = 3u; ca = a.y; cb = b.y; }
    else return false;

    uint first = min((uint)round(min(ca, cb) * (float)coverageBins),
        coverageBins);
    uint last = min((uint)round(max(ca, cb) * (float)coverageBins),
        coverageBins);
    if (last <= first) return false;
    uint length = last - first;
    coverageMask = length >= 32u ? 0xffffffffu :
        ((1u << length) - 1u) << first;
    return coverageMask != 0u;
}

[numthreads(64, 1, 1)]
void ValidateFilmMemberships(uint3 id : SV_DispatchThreadID)
{
    uint count = min(_FilmAllocator[6], _FilmCapacity);
    uint ordinal = id.x;
    if (ordinal >= count) return;
    uint filmIndex = _ActiveFilmIndices[ordinal];
    if (filmIndex >= _FilmCapacity) return;
    ContactFilmHeader film = _FilmHeaders[filmIndex];
    if ((film.flags & FILM_ACTIVE) == 0u) return;
    FilmMembership membership;
    if (!ValidMembership(filmIndex, film, membership))
    {
        InterlockedAdd(_ManifoldDiagnostics[9], 1u);
        return;
    }
    if (membership.linkCount == 0u && membership.frontierCount == 0u)
    {
        InterlockedAdd(_ManifoldDiagnostics[8], 1u);
        return;
    }
    uint incidenceId = membership.firstLink;
    uint visited = 0u;
    uint classifiedEdges[4] = { 0u, 0u, 0u, 0u };
    bool invalid = false;
    [loop]
    while (incidenceId != 0u && visited < min(membership.linkCount,
        _LinkCapacity * 2u))
    {
        if (incidenceId > _LinkCapacity * 2u) break;
        ManifoldLinkIncidence incidence =
            _ManifoldLinkIncidences[incidenceId - 1u];
        if (incidence.id != incidenceId ||
            (incidence.flags & INCIDENCE_ACTIVE) == 0u ||
            incidence.filmId != film.id ||
            incidence.filmGeneration != film.generation ||
            incidence.linkId == 0u || incidence.linkId > _LinkCapacity)
        { invalid = true; break; }
        ManifoldLink link = _ManifoldLinks[incidence.linkId - 1u];
        bool endpointValid = incidence.linkGeneration == link.generation &&
            ((incidence.endpoint == 0u && link.filmA == film.id &&
                link.filmAGeneration == film.generation) ||
             (incidence.endpoint == 1u && link.filmB == film.id &&
                link.filmBGeneration == film.generation));
        if (!endpointValid || (link.flags & (LINK_ACTIVE | LINK_RETIRED)) !=
                LINK_ACTIVE || link.manifoldId != membership.manifoldId ||
            link.manifoldGeneration != membership.manifoldGeneration)
        { invalid = true; break; }
        uint edgeIndex, edgeCoverage;
        if (!OuterEdgeCoverage(incidence.endpoint == 0u ?
                link.uvA01 : link.uvB01, edgeIndex, edgeCoverage) ||
            (classifiedEdges[edgeIndex] & edgeCoverage) != 0u)
            invalid = true;
        else classifiedEdges[edgeIndex] |= edgeCoverage;
        incidenceId = incidence.nextId;
        visited++;
    }
    if (visited != membership.linkCount || incidenceId != 0u)
        invalid = true;

    uint frontierIncidenceId = membership.firstFrontier;
    uint visitedFrontiers = 0u;
    [loop]
    while (frontierIncidenceId != 0u && visitedFrontiers <
        min(membership.frontierCount, _FrontierCapacity))
    {
        if (frontierIncidenceId > _FrontierCapacity)
        { invalid = true; break; }
        ManifoldFrontierIncidence incidence =
            _ManifoldFrontierIncidences[frontierIncidenceId - 1u];
        if (incidence.id != frontierIncidenceId ||
            incidence.filmId != film.id ||
            incidence.filmGeneration != film.generation)
        { invalid = true; break; }
        if ((incidence.flags & FRONTIER_ACTIVE) != 0u)
        {
            if (incidence.frontierId == 0u ||
                incidence.frontierId > _FrontierCapacity)
            { invalid = true; break; }
            LatentFrontierSegment frontier =
                _LatentFrontiers[incidence.frontierId - 1u];
            bool frontierValid = frontier.id == incidence.frontierId &&
                frontier.generation == incidence.frontierGeneration &&
                frontier.filmId == film.id &&
                frontier.filmGeneration == film.generation &&
                frontier.manifoldId == membership.manifoldId &&
                frontier.manifoldGeneration == membership.manifoldGeneration &&
                (frontier.flags & (FRONTIER_ACTIVE | FRONTIER_RETIRED |
                    FRONTIER_OUTER | FRONTIER_ORDERED)) ==
                    (FRONTIER_ACTIVE | FRONTIER_OUTER | FRONTIER_ORDERED) &&
                frontier.nextId > 0u && frontier.nextId <= _FrontierCapacity &&
                frontier.previousId > 0u &&
                frontier.previousId <= _FrontierCapacity;
            if (frontierValid)
            {
                LatentFrontierSegment next =
                    _LatentFrontiers[frontier.nextId - 1u];
                LatentFrontierSegment previous =
                    _LatentFrontiers[frontier.previousId - 1u];
                frontierValid = next.generation == frontier.nextGeneration &&
                    previous.generation == frontier.previousGeneration &&
                    next.previousId == frontier.id &&
                    next.previousGeneration == frontier.generation &&
                    previous.nextId == frontier.id &&
                    previous.nextGeneration == frontier.generation;
            }
            uint edgeIndex, edgeCoverage;
            if (!frontierValid || !OuterEdgeCoverage(frontier.uv01,
                    edgeIndex, edgeCoverage) ||
                (classifiedEdges[edgeIndex] & edgeCoverage) != 0u)
                invalid = true;
            else classifiedEdges[edgeIndex] |= edgeCoverage;
        }
        frontierIncidenceId = incidence.nextId;
        visitedFrontiers++;
    }
    if (visitedFrontiers != membership.frontierCount ||
        frontierIncidenceId != 0u) invalid = true;
    uint missingEdges = 0u;
    [unroll]
    for (uint edge = 0u; edge < 4u; ++edge)
        if (classifiedEdges[edge] != 0xffffffffu) missingEdges++;
    if (missingEdges != 0u)
    {
        InterlockedAdd(_ManifoldDiagnostics[8], missingEdges);
        invalid = true;
    }
    if (invalid)
        InterlockedAdd(_ManifoldDiagnostics[9], 1u);
}

[numthreads(64, 1, 1)]
void ValidateManifoldLinks(uint3 id : SV_DispatchThreadID)
{
    uint count = min(_ManifoldAllocator[4], _LinkCapacity);
    if (id.x >= count) return;
    ManifoldLink link = _ManifoldLinks[id.x];
    if ((link.flags & LINK_ACTIVE) == 0u || (link.flags & LINK_RETIRED) != 0u)
        return;
    if (link.filmA == 0u || link.filmB == 0u || link.filmA > _FilmCapacity ||
        link.filmB > _FilmCapacity)
    {
        InterlockedAdd(_ManifoldDiagnostics[9], 1u);
        return;
    }
    ContactFilmHeader a = _FilmHeaders[link.filmA - 1u];
    ContactFilmHeader b = _FilmHeaders[link.filmB - 1u];
    if (a.id != link.filmA || a.generation != link.filmAGeneration ||
        b.id != link.filmB || b.generation != link.filmBGeneration ||
        (a.flags & FILM_ACTIVE) == 0u || (b.flags & FILM_ACTIVE) == 0u ||
        (link.type != LINK_SMOOTH && link.type != LINK_CREASE))
    {
        InterlockedAdd(_ManifoldDiagnostics[9], 1u);
        return;
    }
    uint edgeA, coverageA, edgeB, coverageB;
    if (!OuterEdgeCoverage(link.uvA01, edgeA, coverageA) ||
        !OuterEdgeCoverage(link.uvB01, edgeB, coverageB))
    {
        InterlockedAdd(_ManifoldDiagnostics[9], 1u);
        return;
    }
    uint incidenceBase = id.x * 2u;
    ManifoldLinkIncidence incidenceA = _ManifoldLinkIncidences[incidenceBase];
    ManifoldLinkIncidence incidenceB =
        _ManifoldLinkIncidences[incidenceBase + 1u];
    bool incidenceValid = incidenceA.linkId == link.id &&
        incidenceA.linkGeneration == link.generation &&
        incidenceA.filmId == link.filmA &&
        incidenceA.filmGeneration == link.filmAGeneration &&
        incidenceA.endpoint == 0u &&
        (incidenceA.flags & INCIDENCE_ACTIVE) != 0u &&
        incidenceB.linkId == link.id &&
        incidenceB.linkGeneration == link.generation &&
        incidenceB.filmId == link.filmB &&
        incidenceB.filmGeneration == link.filmBGeneration &&
        incidenceB.endpoint == 1u &&
        (incidenceB.flags & INCIDENCE_ACTIVE) != 0u;
    if (!incidenceValid) InterlockedAdd(_ManifoldDiagnostics[9], 1u);
}

[numthreads(1, 1, 1)]
void FinalizeManifoldValidation(uint3 id : SV_DispatchThreadID)
{
    uint manifoldId = _CurrentManifold[0];
    uint generation = _CurrentManifold[1];
    if (manifoldId == 0u || manifoldId > _ManifoldCapacity) return;
    PressureManifoldHeader manifold = _ManifoldHeaders[manifoldId - 1u];
    if (manifold.id != manifoldId || manifold.generation != generation) return;
    manifold.membershipCount = _ManifoldAllocator[12];
    manifold.linkCount = _ManifoldAllocator[5];
    manifold.frontierCount = _ManifoldAllocator[9];
    if (_ManifoldDiagnostics[8] == 0u && _ManifoldDiagnostics[9] == 0u)
    {
        manifold.flags |= MANIFOLD_CLOSED;
        manifold.flags &= ~MANIFOLD_DIRTY;
    }
    else
    {
        manifold.flags &= ~MANIFOLD_CLOSED;
        manifold.flags |= MANIFOLD_DIRTY;
    }
    _ManifoldAllocator[14] = _ManifoldDiagnostics[8] +
        _ManifoldDiagnostics[9];
    manifold.revision++;
    _ManifoldHeaders[manifoldId - 1u] = manifold;
}
