struct ContactFilmHeader
{
    uint id; uint generation; uint chunkId; uint flags;
    float3 origin; float supportTotal;
    float3 normal; float sigmaNormal;
    float3 tangentU; float extentU;
    float3 tangentV; float extentV;
    float4 quadratic0123; float2 quadratic45;
    float confidence; float contradiction;
    uint revision; uint displacementPage; uint appearancePage;
    uint boundaryStart; uint boundaryCount;
    uint supportMaskLow; uint supportMaskHigh;
    uint reserved0; uint reserved1; uint reserved2;
};

struct PressureManifoldHeader
{
    uint id; uint generation; uint chunkId; uint flags;
    float3 opticalSeed; float seedSigma;
    uint membershipStart; uint membershipCount; uint linkStart; uint linkCount;
    uint frontierStart; uint frontierCount; uint revision; uint calibrationEpochLow;
    uint calibrationEpochHigh; uint reserved0; uint reserved1; uint reserved2;
};

struct FilmMembership
{
    uint filmId; uint filmGeneration; uint manifoldId; uint manifoldGeneration;
    uint firstLink; uint linkCount; uint firstFrontier; uint frontierCount;
    uint flags; uint revision;
};

struct ManifoldLink
{
    uint id; uint generation; uint manifoldId; uint manifoldGeneration;
    uint filmA; uint filmAGeneration; uint filmB; uint filmBGeneration;
    uint type; uint flags; uint boundaryId; uint revision;
    float4 uvA01; float4 uvB01;
    float sigma; float support; float confidence; float reserved;
};

struct ManifoldLinkIncidence
{
    uint id; uint generation; uint linkId; uint linkGeneration;
    uint filmId; uint filmGeneration; uint nextId; uint nextGeneration;
    uint endpoint; uint flags;
};

struct ManifoldFrontierIncidence
{
    uint id; uint generation; uint frontierId; uint frontierGeneration;
    uint filmId; uint filmGeneration; uint nextId; uint nextGeneration;
    uint flags; uint reserved;
};

struct LatentFrontierSegment
{
    uint id; uint generation; uint manifoldId; uint manifoldGeneration;
    uint filmId; uint filmGeneration; uint nextId; uint nextGeneration;
    uint previousId; uint previousGeneration; uint flags; uint revision;
    float4 uv01;
    float sigma; float support; float confidence; float reserved;
};

struct TopologySplitRecord
{
    uint parentFilmIndex; uint parentFilmGeneration;
    uint childFilmIndex0; uint childFilmIndex1;
    uint childFilmIndex2; uint childFilmIndex3;
    uint firstChildBasePage; uint childCount;
    uint parentActiveOrdinal; uint firstNewActiveOrdinal;
    uint firstDirtyOrdinal; uint reservedLinkStart;
    uint reservedExternalLinkCount; uint reservedLinkCount;
    uint reservedFrontierStart; uint reservedFrontierCount;
    uint reservedBoundaryStart; uint reservedBoundaryCount;
    uint transactionState;
};

struct ContactBoundaryHeader
{
    uint id; uint generation; uint chunkId; uint flags;
    uint filmA; uint filmAGeneration; uint filmB; uint filmBGeneration;
    float4 controlUv01; float4 controlUv23;
    float sigma; float support; float confidence; float contradiction;
    uint revision; uint cellKey; uint viewBinMask; uint lastSeenSequence;
};

struct TopologyBoundarySplitPlan
{
    uint boundaryIndex; uint boundaryGeneration;
    uint splitRecordIndex; uint parentFilmIndex;
    uint parentFilmGeneration; uint parentEndpoint;
    uint reservedStart; uint segmentCount;
};

struct FilmSlotState
{
    uint generation; uint activeOrdinal; uint nextFree; uint flags;
};

struct ContactTopologyEvidence
{
    float positiveMoment; float positiveSupport;
    float negativeMoment; float negativeSupport;
    float residualVariance; float boundarySupport; float totalSupport;
    uint revision;
};

struct FilmHashEntry
{
    uint hash; uint filmId; uint filmGeneration; uint next;
};

struct LinkHashEntry { uint hash; uint linkId; };

