#pragma kernel CreateEvidenceAlignedChildren

#include "PressureManifoldAtlasAbi.hlsl"

struct ContactTopologyEvidence
{
    float positiveMoment; float positiveSupport;
    float negativeMoment; float negativeSupport;
    float residualVariance; float boundarySupport; float totalSupport;
    uint revision;
};

RWStructuredBuffer<AtlasContactFilmHeader> _FilmHeaders;
RWStructuredBuffer<float4> _FilmInformation;
RWStructuredBuffer<AtlasFilmMembership> _FilmMemberships;
RWStructuredBuffer<ContactTopologyEvidence> _TopologyEvidence;
RWStructuredBuffer<ElasticChartState> _ElasticChartStates;
StructuredBuffer<EvidenceAlignedSplitPlan> _SplitPlans;
StructuredBuffer<uint> _SplitRecordIndices;

uint _FilmCapacity;

static const uint FILM_ACTIVE = 1u;
static const uint FILM_ONE_SIDED = 1u << 1u;
static const uint FILM_UNCERTAIN = 1u << 2u;
static const uint FILM_DIRTY_GEOMETRY = 1u << 3u;
static const uint FILM_DIRTY_MESHLET = 1u << 4u;
static const uint FILM_HAS_DISPLACEMENT = 1u << 5u;
static const uint FILM_PRESSURE_MANIFOLD_MEMBER = 1u << 9u;
static const uint SPLIT_RESERVED = 2u;

uint UpperIndex(uint row, uint column)
{
    return row * 6u - (row * (row - 1u)) / 2u + (column - row);
}

float LoadH(uint information, uint row, uint column)
{
    uint packed = UpperIndex(min(row, column), max(row, column));
    float4 data = _FilmInformation[information + (packed >> 2u)];
    uint lane = packed & 3u;
    return lane == 0u ? data.x : lane == 1u ? data.y :
        lane == 2u ? data.z : data.w;
}

float LoadG(uint information, uint index)
{
    float4 low = _FilmInformation[information + 6u];
    if (index < 4u) return index == 0u ? low.x : index == 1u ? low.y :
        index == 2u ? low.z : low.w;
    float4 high = _FilmInformation[information + 7u];
    return index == 4u ? high.x : high.y;
}

void StoreH(uint information, uint packed, float value)
{
    uint record = packed >> 2u; uint lane = packed & 3u;
    float4 data = _FilmInformation[information + record];
    if (lane == 0u) data.x = value;
    else if (lane == 1u) data.y = value;
    else if (lane == 2u) data.z = value;
    else data.w = value;
    _FilmInformation[information + record] = data;
}

void StoreG(uint information, uint index, float value)
{
    uint record = index < 4u ? 6u : 7u;
    uint lane = index < 4u ? index : index - 4u;
    float4 data = _FilmInformation[information + record];
    if (lane == 0u) data.x = value;
    else if (lane == 1u) data.y = value;
    else if (lane == 2u) data.z = value;
    else data.w = value;
    _FilmInformation[information + record] = data;
}

void PartitionSupportMask(AtlasContactFilmHeader parent, float4 separator,
    bool positive, out uint low, out uint high)
{
    low = high = 0u;
    [unroll] for (uint bit = 0u; bit < 64u; ++bit)
    {
        bool parentSupported = bit < 32u ?
            ((parent.supportMaskLow >> bit) & 1u) != 0u :
            ((parent.supportMaskHigh >> (bit - 32u)) & 1u) != 0u;
        if (!parentSupported) continue;
        float2 uv = (float2(bit & 7u, bit >> 3u) + 0.5) / 8.0;
        bool side = dot(separator.xy, uv) + separator.z >= 0.0;
        if (side != positive) continue;
        if (bit < 32u) low |= 1u << bit;
        else high |= 1u << (bit - 32u);
    }
}

void PartitionInformation(uint parentIndex, uint childIndex, float fraction,
    float heightOffset)
{
    uint parent = parentIndex * 10u;
    uint child = childIndex * 10u;
    [unroll] for (uint record = 0u; record < 10u; ++record)
        _FilmInformation[child + record] = 0.0;
    [unroll]
    for (uint packed = 0u; packed < 21u; ++packed)
    {
        float4 source = _FilmInformation[parent + (packed >> 2u)];
        uint lane = packed & 3u;
        float value = lane == 0u ? source.x : lane == 1u ? source.y :
            lane == 2u ? source.z : source.w;
        StoreH(child, packed, fraction * value);
    }
    [unroll]
    for (uint row = 0u; row < 6u; ++row)
    {
        float shifted = LoadG(parent, row) -
            LoadH(parent, row, 0u) * heightOffset;
        StoreG(child, row, fraction * shifted);
    }
    float4 freeState = _FilmInformation[parent + 5u];
    float4 childFree = _FilmInformation[child + 5u];
    childFree.y = freeState.y * fraction;
    childFree.z = freeState.z;
    childFree.w = freeState.w;
    _FilmInformation[child + 5u] = childFree;
    float4 support = _FilmInformation[parent + 7u];
    float4 childSupport = _FilmInformation[child + 7u];
    childSupport.z = support.z * fraction;
    childSupport.w = support.w * fraction;
    _FilmInformation[child + 7u] = childSupport;
    _FilmInformation[child + 8u] = _FilmInformation[parent + 8u];
    _FilmInformation[child + 9u] = _FilmInformation[parent + 9u];
}

void CreateChild(EvidenceAlignedSplitPlan plan, AtlasContactFilmHeader parent,
    AtlasFilmMembership parentMembership, ContactTopologyEvidence parentEvidence,
    ElasticChartState parentElastic, uint childIndex, uint childGeneration,
    uint childPage, bool positive, float fraction, float heightOffset)
{
    AtlasContactFilmHeader child = parent;
    child.id = childIndex + 1u;
    child.generation = childGeneration;
    child.flags = FILM_ACTIVE | FILM_ONE_SIDED | FILM_UNCERTAIN |
        FILM_DIRTY_GEOMETRY | FILM_DIRTY_MESHLET | FILM_HAS_DISPLACEMENT |
        FILM_PRESSURE_MANIFOLD_MEMBER;
    child.quadratic0123.x += heightOffset;
    child.supportTotal = parent.supportTotal * fraction;
    child.displacementPage = childPage + 1u;
    child.boundaryStart = 0u; child.boundaryCount = 0u;
    PartitionSupportMask(parent, plan.separatorUv, positive,
        child.supportMaskLow, child.supportMaskHigh);
    child.reserved0 = parent.id;
    child.reserved1 = parent.generation;
    child.reserved2 = min((parent.reserved2 & 0x3fffffffu) + 1u,
        0x3fffffffu) |
        (positive ? 0x80000000u : 0u);
    child.revision = parent.revision + 1u;
    _FilmHeaders[childIndex] = child;
    PartitionInformation(plan.parentFilmIndex, childIndex, fraction,
        heightOffset);

    AtlasFilmMembership membership = parentMembership;
    membership.filmId = child.id;
    membership.filmGeneration = child.generation;
    membership.firstHalfEdge = 0u; membership.halfEdgeCount = 0u;
    membership.firstFrontierLoop = 0u; membership.frontierLoopCount = 0u;
    membership.flags = MEMBERSHIP_ACTIVE | MEMBERSHIP_MEASURED;
    membership.revision = parentMembership.revision + 1u;
    _FilmMemberships[childIndex] = membership;

    ContactTopologyEvidence evidence = parentEvidence;
    evidence.positiveMoment *= fraction;
    evidence.positiveSupport *= fraction;
    evidence.negativeMoment *= fraction;
    evidence.negativeSupport *= fraction;
    evidence.boundarySupport *= fraction;
    evidence.totalSupport *= fraction;
    evidence.revision = 1u;
    _TopologyEvidence[childIndex] = evidence;

    ElasticChartState elastic = parentElastic;
    elastic.filmId = child.id; elastic.filmGeneration = child.generation;
    elastic.revision = max(1u, parentElastic.revision + 1u);
    _ElasticChartStates[childIndex] = elastic;
}

[numthreads(1, 1, 1)]
void CreateEvidenceAlignedChildren(uint3 id : SV_DispatchThreadID)
{
    uint parentIndex = _SplitRecordIndices[id.x];
    if (parentIndex >= _FilmCapacity) return;
    EvidenceAlignedSplitPlan plan = _SplitPlans[parentIndex];
    AtlasContactFilmHeader parent = _FilmHeaders[parentIndex];
    if (plan.transactionState != SPLIT_RESERVED ||
        parent.generation != plan.parentFilmGeneration ||
        plan.childFilmIndex0 >= _FilmCapacity ||
        plan.childFilmIndex1 >= _FilmCapacity) return;
    AtlasFilmMembership membership = _FilmMemberships[parentIndex];
    ContactTopologyEvidence evidence = _TopologyEvidence[parentIndex];
    ElasticChartState elastic = _ElasticChartStates[parentIndex];
    float positiveOffset = 0.0, negativeOffset = 0.0;
    if (plan.splitKind == 2u)
    {
        positiveOffset = evidence.positiveSupport > 0.0 ?
            evidence.positiveMoment / evidence.positiveSupport : 0.0;
        negativeOffset = evidence.negativeSupport > 0.0 ?
            evidence.negativeMoment / evidence.negativeSupport : 0.0;
    }
    CreateChild(plan, parent, membership, evidence, elastic,
        plan.childFilmIndex0, plan.childGeneration0, plan.childBasePage0,
        true, plan.childFractions.x, positiveOffset);
    CreateChild(plan, parent, membership, evidence, elastic,
        plan.childFilmIndex1, plan.childGeneration1, plan.childBasePage1,
        false, plan.childFractions.y, negativeOffset);
}
