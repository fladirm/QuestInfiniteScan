#pragma kernel ClearDisplacementFrame
#pragma kernel InitializeDisplacementState
#pragma kernel AllocateBasePages
#pragma kernel AllocateBasePagesBehind
#pragma kernel AllocateBasePagesOccluder
#pragma kernel BuildDisplacementArguments
#pragma kernel InitializeBasePages
#pragma kernel AccumulateDisplacement
#pragma kernel AccumulateTopologyEvidence
#pragma kernel AccumulatePreHitPressure
#pragma kernel AccumulateOccluderPreHitPressure
#pragma kernel SolveDirtyDisplacement
#pragma kernel AllocateMicrotiles
#pragma kernel InitializeMicroPages
#pragma kernel SolveTopologyEvidence

struct ConeEvent
{
    uint pixelLinear;
    uint packedPixel;
    uint classification;
    uint flags;
    float measuredRange;
    float predictedRange;
    float combinedSigma;
    float confidence;
    float3 measuredNormal;
    float boundaryEvidence;
    uint filmId;
    uint filmGeneration;
    float2 predictedUv;
    float footprintArea;
    float incidence;
    float pressurePrecision;
    uint occluderFilmId;
    uint occluderGeneration;
    float2 occluderUv;
};

struct ContactFilmHeader
{
    uint id;
    uint generation;
    uint chunkId;
    uint flags;
    float3 origin;
    float supportTotal;
    float3 normal;
    float sigmaNormal;
    float3 tangentU;
    float extentU;
    float3 tangentV;
    float extentV;
    float4 quadratic0123;
    float2 quadratic45;
    float confidence;
    float contradiction;
    uint revision;
    uint displacementPage;
    uint appearancePage;
    uint boundaryStart;
    uint boundaryCount;
    uint supportMaskLow;
    uint supportMaskHigh;
    uint reserved0;
    uint reserved1;
    uint reserved2;
};

struct DisplacementPageHeader
{
    uint id;
    uint generation;
    uint filmId;
    uint filmGeneration;
    uint level;
    uint parentPage;
    uint parentCell;
    uint flags;
    float4 uvBounds;
    uint bestFootprintBits;
    uint maximumVarianceBits;
    uint supportFixed;
    uint revision;
};

struct DisplacementCell
{
    float displacement;
    float sigma;
    float support;
    float coverage;
    float bestPrecision;
    float bestFootprint;
    float residualVariance;
    float preHitPressure;
    uint preHitPressureViewMask;
    uint revision;
};

struct ContactTopologyEvidence
{
    float positiveMoment;
    float positiveSupport;
    float negativeMoment;
    float negativeSupport;
    float residualVariance;
    float boundarySupport;
    float totalSupport;
    uint revision;
};

StructuredBuffer<ConeEvent> _ConeEvents;
StructuredBuffer<uint> _ClassifiedIndices;
StructuredBuffer<uint> _ClassCounters;
StructuredBuffer<ContactFilmHeader> _FilmHeadersRead;
StructuredBuffer<float4> _FilmInformationRead;
StructuredBuffer<DisplacementPageHeader> _DisplacementPagesRead;
StructuredBuffer<DisplacementCell> _BaseDisplacementCellsRead;
StructuredBuffer<DisplacementCell> _MicroDisplacementCellsRead;
StructuredBuffer<uint> _BaseChildPagesRead;
StructuredBuffer<uint> _MicroChildPagesRead;
StructuredBuffer<uint> _NewBasePagesRead;
StructuredBuffer<uint> _NewMicroPagesRead;
StructuredBuffer<uint> _DisplacementPageStateRead;
StructuredBuffer<uint> _DirtyDisplacementCellIndicesRead;
StructuredBuffer<uint> _DisplacementDirtyStateRead;
RWStructuredBuffer<ContactFilmHeader> _FilmHeaders;
RWStructuredBuffer<float4> _FilmInformation;
RWStructuredBuffer<DisplacementPageHeader> _DisplacementPages;
RWStructuredBuffer<DisplacementCell> _BaseDisplacementCells;
RWStructuredBuffer<DisplacementCell> _MicroDisplacementCells;
RWStructuredBuffer<uint> _BaseChildPages;
RWStructuredBuffer<uint> _MicroChildPages;
RWStructuredBuffer<uint> _DisplacementAllocator;
RWStructuredBuffer<int> _BaseDisplacementCellAccumulator;
RWStructuredBuffer<int> _MicroDisplacementCellAccumulator;
RWStructuredBuffer<uint> _DisplacementCellDirtyFlags;
RWStructuredBuffer<uint> _DirtyDisplacementCellIndices;
RWStructuredBuffer<uint> _DisplacementDirtyState;
RWStructuredBuffer<uint> _NewBasePages;
RWStructuredBuffer<uint> _NewMicroPages;
RWStructuredBuffer<uint> _DisplacementPageState;
RWStructuredBuffer<uint3> _DisplacementDispatchArguments;
RWStructuredBuffer<ContactTopologyEvidence> _TopologyEvidence;
RWStructuredBuffer<int> _TopologyAccumulator;
RWStructuredBuffer<uint> _TopologyDirtyFlags;
RWStructuredBuffer<uint> _DirtyTopologyIndices;
RWStructuredBuffer<uint> _TopologyState;

Texture2D<float4> _DepthRayCenterLeft;
Texture2D<float4> _DepthRayCenterRight;

uint _FilmCapacity;
uint _EventCapacity;
uint _BasePageCapacity;
uint _MicroPageCapacity;
uint _BaseCellCapacity;
uint _MicroCellCapacity;
uint _MaximumMicroLevels;
float _QualityFloor;
float _MinimumSigma;
float _MinimumHuber;
float _RefinementFootprintRatio;
float _RefinementVariance;
float4x4 _ChunkFromDepth[2];

static const uint CLASS_MATCH = 1u;
static const uint CLASS_BEHIND = 3u;
static const uint FILM_ACTIVE = 1u;
static const uint FILM_DIRTY_GEOMETRY = 8u;
static const uint FILM_DIRTY_MESHLET = 16u;
static const uint FILM_HAS_DISPLACEMENT = 32u;
static const uint PAGE_ACTIVE = 1u;
static const uint PAGE_BASE = 2u;
static const uint PAGE_MICRO = 4u;
static const uint PAGE_DIRTY = 8u;
static const uint BASE_GRID = 16u;
static const uint MICRO_GRID = 8u;
static const uint BASE_CELLS_PER_PAGE = 256u;
static const uint MICRO_CELLS_PER_PAGE = 64u;
// contact W/sum/sum2, observed coverage, pressure view mask, best precision,
// best footprint, support, then opposing-pressure W/sum/sum2.  Opposing evidence
// deforms the elastic manifold; it never subtracts topology/coverage.
static const uint WORDS_PER_CELL = 11u;
static const uint WORDS_PER_FILM = 8u;
static const uint ALLOCATION_CLAIM = 0xffffffffu;
static const float WEIGHT_SCALE = 4096.0;
static const float VALUE_SCALE = 1048576.0;

float3 LoadRay(uint2 pixel, uint eye)
{
    return eye == 0u ? _DepthRayCenterLeft[pixel].xyz :
        _DepthRayCenterRight[pixel].xyz;
}

uint PreHitPressureViewBit(ContactFilmHeader film, uint eye)
{
    float3 cameraChunk = mul(_ChunkFromDepth[eye],
        float4(0.0, 0.0, 0.0, 1.0)).xyz;
    float3 toCamera = normalize(cameraChunk - film.origin);
    float2 tangent = float2(dot(toCamera, film.tangentU),
        dot(toCamera, film.tangentV));
    uint bin = dot(tangent, tangent) < 0.04 ? 0u :
        1u + (tangent.x >= 0.0 ? 1u : 0u) +
        (tangent.y >= 0.0 ? 2u : 0u);
    return 1u << (bin + min(eye, 1u) * 5u);
}

float Height(ContactFilmHeader film, float u, float v)
{
    return film.quadratic0123.x + film.quadratic0123.y * u +
        film.quadratic0123.z * v + film.quadratic0123.w * u * u +
        film.quadratic45.x * u * v + film.quadratic45.y * v * v;
}

uint AccumulatorBaseWordCapacity()
{
    return _BaseCellCapacity * WORDS_PER_CELL;
}

int LoadAccumulator(uint address)
{
    uint baseWords = AccumulatorBaseWordCapacity();
    return address < baseWords ? _BaseDisplacementCellAccumulator[address] :
        _MicroDisplacementCellAccumulator[address - baseWords];
}

void StoreAccumulator(uint address, int value)
{
    uint baseWords = AccumulatorBaseWordCapacity();
    if (address < baseWords)
        _BaseDisplacementCellAccumulator[address] = value;
    else
        _MicroDisplacementCellAccumulator[address - baseWords] = value;
}

void InterlockedAddAccumulator(uint address, int value)
{
    uint baseWords = AccumulatorBaseWordCapacity();
    if (address < baseWords)
        InterlockedAdd(_BaseDisplacementCellAccumulator[address], value);
    else
        InterlockedAdd(_MicroDisplacementCellAccumulator[address - baseWords], value);
}

void InterlockedMaxAccumulator(uint address, int value)
{
    uint baseWords = AccumulatorBaseWordCapacity();
    if (address < baseWords)
        InterlockedMax(_BaseDisplacementCellAccumulator[address], value);
    else
        InterlockedMax(_MicroDisplacementCellAccumulator[address - baseWords], value);
}

void InterlockedMinAccumulator(uint address, int value)
{
    uint baseWords = AccumulatorBaseWordCapacity();
    if (address < baseWords)
        InterlockedMin(_BaseDisplacementCellAccumulator[address], value);
    else
        InterlockedMin(_MicroDisplacementCellAccumulator[address - baseWords], value);
}

void InterlockedOrAccumulator(uint address, int value)
{
    uint baseWords = AccumulatorBaseWordCapacity();
    if (address < baseWords)
        InterlockedOr(_BaseDisplacementCellAccumulator[address], value);
    else
        InterlockedOr(_MicroDisplacementCellAccumulator[address - baseWords], value);
}

void AtomicAddScaled(uint address, float value, float scale)
{
    int quantized = (int)round(clamp(value * scale,
        -2140000000.0, 2140000000.0));
    if (quantized != 0)
        InterlockedAddAccumulator(address, quantized);
}

void AtomicAddTopologyScaled(uint address, float value, float scale)
{
    int quantized = (int)round(clamp(value * scale,
        -2140000000.0, 2140000000.0));
    if (quantized != 0)
        InterlockedAdd(_TopologyAccumulator[address], quantized);
}

DisplacementCell EmptyCell(float sigma)
{
    DisplacementCell cell = (DisplacementCell)0;
    cell.sigma = max(_MinimumSigma, sigma);
    cell.bestFootprint = 3.402823466e+38;
    return cell;
}

bool IsMicroCell(uint globalCell) { return globalCell >= _BaseCellCapacity; }

bool BootstrapSupport(ContactFilmHeader film, float2 uv)
{
    uint2 cell = min((uint2)(saturate(uv) * 8.0), 7u);
    uint bit = cell.y * 8u + cell.x;
    return bit < 32u ? ((film.supportMaskLow >> bit) & 1u) != 0u :
        ((film.supportMaskHigh >> (bit - 32u)) & 1u) != 0u;
}

DisplacementCell LoadCell(uint globalCell)
{
    // Vulkan's HLSL lowering cannot select structured-buffer struct lvalues
    // through ?: even though scalar backends accept it.
    if (IsMicroCell(globalCell))
        return _MicroDisplacementCells[globalCell - _BaseCellCapacity];
    return _BaseDisplacementCells[globalCell];
}

DisplacementCell LoadCellRead(uint globalCell)
{
    if (IsMicroCell(globalCell))
        return _MicroDisplacementCellsRead[globalCell - _BaseCellCapacity];
    return _BaseDisplacementCellsRead[globalCell];
}

void StoreCell(uint globalCell, DisplacementCell cell)
{
    if (IsMicroCell(globalCell))
        _MicroDisplacementCells[globalCell - _BaseCellCapacity] = cell;
    else
        _BaseDisplacementCells[globalCell] = cell;
}

uint LoadChild(uint globalCell)
{
    if (IsMicroCell(globalCell))
        return _MicroChildPages[globalCell - _BaseCellCapacity];
    return _BaseChildPages[globalCell];
}

uint LoadChildRead(uint globalCell)
{
    if (IsMicroCell(globalCell))
        return _MicroChildPagesRead[globalCell - _BaseCellCapacity];
    return _BaseChildPagesRead[globalCell];
}

void StoreChild(uint globalCell, uint child)
{
    if (IsMicroCell(globalCell))
        _MicroChildPages[globalCell - _BaseCellCapacity] = child;
    else
        _BaseChildPages[globalCell] = child;
}

uint PageHeaderIndex(bool micro, uint pageIndex)
{
    return micro ? _BasePageCapacity + pageIndex : pageIndex;
}

uint CellForPage(bool micro, uint pageIndex, uint localCell)
{
    return micro
        ? _BaseCellCapacity + pageIndex * MICRO_CELLS_PER_PAGE + localCell
        : pageIndex * BASE_CELLS_PER_PAGE + localCell;
}

bool ResolveBaseCell(ContactFilmHeader film, float2 uv, out uint globalCell,
    out DisplacementPageHeader page)
{
    globalCell = 0u;
    page = (DisplacementPageHeader)0;
    if (film.displacementPage == 0u || film.displacementPage == ALLOCATION_CLAIM)
        return false;
    uint basePage = film.displacementPage - 1u;
    if (basePage >= _BasePageCapacity) return false;
    page = _DisplacementPages[basePage];
    if (page.filmId != film.id || page.filmGeneration != film.generation ||
        (page.flags & PAGE_ACTIVE) == 0u) return false;
    float2 normalized = saturate(uv);
    uint2 baseCell = min((uint2)(normalized * (float)BASE_GRID), BASE_GRID - 1u);
    globalCell = CellForPage(false, basePage,
        baseCell.y * BASE_GRID + baseCell.x);
    return true;
}

bool ResolveBaseCellRead(ContactFilmHeader film, float2 uv,
    out uint globalCell, out DisplacementPageHeader page)
{
    globalCell = 0u;
    page = (DisplacementPageHeader)0;
    if (film.displacementPage == 0u || film.displacementPage == ALLOCATION_CLAIM)
        return false;
    uint basePage = film.displacementPage - 1u;
    if (basePage >= _BasePageCapacity) return false;
    page = _DisplacementPagesRead[basePage];
    if (page.filmId != film.id || page.filmGeneration != film.generation ||
        (page.flags & PAGE_ACTIVE) == 0u) return false;
    float2 normalized = saturate(uv);
    uint2 baseCell = min((uint2)(normalized * (float)BASE_GRID), BASE_GRID - 1u);
    globalCell = CellForPage(false, basePage,
        baseCell.y * BASE_GRID + baseCell.x);
    return true;
}

bool ResolveLeaf(ContactFilmHeader film, float2 uv, out uint globalCell,
    out DisplacementPageHeader page)
{
    if (!ResolveBaseCell(film, uv, globalCell, page)) return false;
    float2 normalized = saturate(uv);

    [loop]
    for (uint level = 0u; level < _MaximumMicroLevels; ++level)
    {
        uint childHandle = LoadChild(globalCell);
        if (childHandle == 0u || childHandle == ALLOCATION_CLAIM) break;
        uint microPage = childHandle - 1u;
        if (microPage >= _MicroPageCapacity) break;
        DisplacementPageHeader child =
            _DisplacementPages[PageHeaderIndex(true, microPage)];
        if ((child.flags & PAGE_ACTIVE) == 0u || child.filmId != film.id ||
            child.filmGeneration != film.generation) break;
        float2 span = max(child.uvBounds.zw - child.uvBounds.xy, 1e-8);
        float2 localUv = saturate((normalized - child.uvBounds.xy) / span);
        uint2 microCell = min((uint2)(localUv * (float)MICRO_GRID),
            MICRO_GRID - 1u);
        globalCell = CellForPage(true, microPage,
            microCell.y * MICRO_GRID + microCell.x);
        page = child;
    }
    return true;
}

bool ResolveLeafRead(ContactFilmHeader film, float2 uv, out uint globalCell,
    out DisplacementPageHeader page)
{
    if (!ResolveBaseCellRead(film, uv, globalCell, page)) return false;
    float2 normalized = saturate(uv);

    [loop]
    for (uint level = 0u; level < _MaximumMicroLevels; ++level)
    {
        uint childHandle = LoadChildRead(globalCell);
        if (childHandle == 0u || childHandle == ALLOCATION_CLAIM) break;
        uint microPage = childHandle - 1u;
        if (microPage >= _MicroPageCapacity) break;
        DisplacementPageHeader child =
            _DisplacementPagesRead[PageHeaderIndex(true, microPage)];
        if ((child.flags & PAGE_ACTIVE) == 0u || child.filmId != film.id ||
            child.filmGeneration != film.generation) break;
        float2 span = max(child.uvBounds.zw - child.uvBounds.xy, 1e-8);
        float2 localUv = saturate((normalized - child.uvBounds.xy) / span);
        uint2 microCell = min((uint2)(localUv * (float)MICRO_GRID),
            MICRO_GRID - 1u);
        globalCell = CellForPage(true, microPage,
            microCell.y * MICRO_GRID + microCell.x);
        page = child;
    }
    return true;
}

void MarkCellDirty(uint globalCell)
{
    uint prior;
    InterlockedCompareExchange(_DisplacementCellDirtyFlags[globalCell],
        0u, 1u, prior);
    if (prior != 0u) return;
    uint slot;
    InterlockedAdd(_DisplacementDirtyState[0], 1u, slot);
    uint capacity = _BaseCellCapacity + _MicroCellCapacity;
    if (slot < capacity)
        _DirtyDisplacementCellIndices[slot] = globalCell;
    else
        InterlockedAdd(_DisplacementDirtyState[1], 1u);
}

void MarkTopologyDirty(uint filmIndex)
{
    uint prior;
    InterlockedCompareExchange(_TopologyDirtyFlags[filmIndex], 0u, 1u, prior);
    if (prior != 0u) return;
    uint slot;
    InterlockedAdd(_TopologyState[0], 1u, slot);
    if (slot < _FilmCapacity) _DirtyTopologyIndices[slot] = filmIndex;
    else InterlockedAdd(_TopologyState[1], 1u);
}

[numthreads(64, 1, 1)]
void InitializeDisplacementState(uint3 id : SV_DispatchThreadID)
{
    uint filmIndex = id.x;
    if (filmIndex >= _FilmCapacity) return;
    _TopologyEvidence[filmIndex] = (ContactTopologyEvidence)0;
    _TopologyDirtyFlags[filmIndex] = 0u;
    _DirtyTopologyIndices[filmIndex] = 0u;
    uint baseWord = filmIndex * WORDS_PER_FILM;
    [unroll] for (uint word = 0u; word < WORDS_PER_FILM; ++word)
        _TopologyAccumulator[baseWord + word] = 0;
    if (filmIndex == 0u)
    {
        [unroll] for (uint state = 0u; state < 4u; ++state)
            _TopologyState[state] = 0u;
    }
}

[numthreads(1, 1, 1)]
void ClearDisplacementFrame(uint3 id : SV_DispatchThreadID)
{
    [unroll] for (uint index = 0u; index < 4u; ++index)
    {
        _DisplacementDirtyState[index] = 0u;
        _DisplacementPageState[index] = 0u;
        _TopologyState[index] = 0u;
    }
    [unroll] for (uint index = 0u; index < 3u; ++index)
        _DisplacementDispatchArguments[index] = uint3(0u, 1u, 1u);
}

[numthreads(64, 1, 1)]
void AllocateBasePages(uint3 id : SV_DispatchThreadID)
{
    uint matchCount = min(_ClassCounters[CLASS_MATCH], _EventCapacity);
    if (id.x >= matchCount) return;
    uint eventIndex = _ClassifiedIndices[CLASS_MATCH * _EventCapacity + id.x];
    ConeEvent eventData = _ConeEvents[eventIndex];
    if (eventData.classification != CLASS_MATCH || eventData.filmId == 0u) return;
    uint filmIndex = eventData.filmId - 1u;
    if (filmIndex >= _FilmCapacity) return;
    ContactFilmHeader film = _FilmHeaders[filmIndex];
    if (film.id != eventData.filmId || film.generation != eventData.filmGeneration ||
        (film.flags & FILM_ACTIVE) == 0u || film.displacementPage != 0u) return;

    uint prior;
    InterlockedCompareExchange(_FilmHeaders[filmIndex].displacementPage,
        0u, ALLOCATION_CLAIM, prior);
    if (prior != 0u) return;
    uint pageIndex;
    InterlockedAdd(_DisplacementAllocator[0], 1u, pageIndex);
    if (pageIndex >= _BasePageCapacity)
    {
        InterlockedAdd(_DisplacementAllocator[2], 1u);
        _FilmHeaders[filmIndex].displacementPage = 0u;
        return;
    }

    DisplacementPageHeader page = (DisplacementPageHeader)0;
    page.id = pageIndex + 1u;
    page.generation = max(1u, _DisplacementAllocator[4]);
    page.filmId = film.id;
    page.filmGeneration = film.generation;
    page.level = 0u;
    page.flags = PAGE_ACTIVE | PAGE_BASE | PAGE_DIRTY;
    page.uvBounds = float4(0, 0, 1, 1);
    page.bestFootprintBits = asuint(3.402823466e+38);
    _DisplacementPages[pageIndex] = page;
    uint queueSlot;
    InterlockedAdd(_DisplacementPageState[0], 1u, queueSlot);
    if (queueSlot < _BasePageCapacity)
        _NewBasePages[queueSlot] = pageIndex;
    else
        InterlockedAdd(_DisplacementPageState[2], 1u);
    _FilmHeaders[filmIndex].flags |= FILM_HAS_DISPLACEMENT |
        FILM_DIRTY_GEOMETRY | FILM_DIRTY_MESHLET;
    DeviceMemoryBarrier();
    _FilmHeaders[filmIndex].displacementPage = pageIndex + 1u;
}

[numthreads(64, 1, 1)]
void AllocateBasePagesBehind(uint3 id : SV_DispatchThreadID)
{
    uint behindCount = min(_ClassCounters[CLASS_BEHIND], _EventCapacity);
    if (id.x >= behindCount) return;
    uint eventIndex = _ClassifiedIndices[
        CLASS_BEHIND * _EventCapacity + id.x];
    ConeEvent eventData = _ConeEvents[eventIndex];
    if (eventData.classification != CLASS_BEHIND || eventData.filmId == 0u)
        return;
    uint filmIndex = eventData.filmId - 1u;
    if (filmIndex >= _FilmCapacity) return;
    ContactFilmHeader film = _FilmHeaders[filmIndex];
    if (film.id != eventData.filmId ||
        film.generation != eventData.filmGeneration ||
        (film.flags & FILM_ACTIVE) == 0u || film.displacementPage != 0u) return;

    uint prior;
    InterlockedCompareExchange(_FilmHeaders[filmIndex].displacementPage,
        0u, ALLOCATION_CLAIM, prior);
    if (prior != 0u) return;
    uint pageIndex;
    InterlockedAdd(_DisplacementAllocator[0], 1u, pageIndex);
    if (pageIndex >= _BasePageCapacity)
    {
        InterlockedAdd(_DisplacementAllocator[2], 1u);
        _FilmHeaders[filmIndex].displacementPage = 0u;
        return;
    }
    DisplacementPageHeader page = (DisplacementPageHeader)0;
    page.id = pageIndex + 1u;
    page.generation = max(1u, _DisplacementAllocator[4]);
    page.filmId = film.id;
    page.filmGeneration = film.generation;
    page.level = 0u;
    page.flags = PAGE_ACTIVE | PAGE_BASE | PAGE_DIRTY;
    page.uvBounds = float4(0, 0, 1, 1);
    page.bestFootprintBits = asuint(3.402823466e+38);
    _DisplacementPages[pageIndex] = page;
    uint queueSlot;
    InterlockedAdd(_DisplacementPageState[0], 1u, queueSlot);
    if (queueSlot < _BasePageCapacity)
        _NewBasePages[queueSlot] = pageIndex;
    else InterlockedAdd(_DisplacementPageState[2], 1u);
    _FilmHeaders[filmIndex].flags |= FILM_HAS_DISPLACEMENT |
        FILM_DIRTY_GEOMETRY | FILM_DIRTY_MESHLET;
    DeviceMemoryBarrier();
    _FilmHeaders[filmIndex].displacementPage = pageIndex + 1u;
}

[numthreads(64, 1, 1)]
void AllocateBasePagesOccluder(uint3 id : SV_DispatchThreadID)
{
    uint matchCount = min(_ClassCounters[CLASS_MATCH], _EventCapacity);
    if (id.x >= matchCount) return;
    uint eventIndex = _ClassifiedIndices[CLASS_MATCH * _EventCapacity + id.x];
    ConeEvent eventData = _ConeEvents[eventIndex];
    if (eventData.classification != CLASS_MATCH ||
        eventData.occluderFilmId == 0u) return;
    uint filmIndex = eventData.occluderFilmId - 1u;
    if (filmIndex >= _FilmCapacity) return;
    ContactFilmHeader film = _FilmHeaders[filmIndex];
    if (film.id != eventData.occluderFilmId ||
        film.generation != eventData.occluderGeneration ||
        (film.flags & FILM_ACTIVE) == 0u || film.displacementPage != 0u) return;

    uint prior;
    InterlockedCompareExchange(_FilmHeaders[filmIndex].displacementPage,
        0u, ALLOCATION_CLAIM, prior);
    if (prior != 0u) return;
    uint pageIndex;
    InterlockedAdd(_DisplacementAllocator[0], 1u, pageIndex);
    if (pageIndex >= _BasePageCapacity)
    {
        InterlockedAdd(_DisplacementAllocator[2], 1u);
        _FilmHeaders[filmIndex].displacementPage = 0u;
        return;
    }
    DisplacementPageHeader page = (DisplacementPageHeader)0;
    page.id = pageIndex + 1u;
    page.generation = max(1u, _DisplacementAllocator[4]);
    page.filmId = film.id;
    page.filmGeneration = film.generation;
    page.level = 0u;
    page.flags = PAGE_ACTIVE | PAGE_BASE | PAGE_DIRTY;
    page.uvBounds = float4(0, 0, 1, 1);
    page.bestFootprintBits = asuint(3.402823466e+38);
    _DisplacementPages[pageIndex] = page;
    uint queueSlot;
    InterlockedAdd(_DisplacementPageState[0], 1u, queueSlot);
    if (queueSlot < _BasePageCapacity)
        _NewBasePages[queueSlot] = pageIndex;
    else InterlockedAdd(_DisplacementPageState[2], 1u);
    _FilmHeaders[filmIndex].flags |= FILM_HAS_DISPLACEMENT |
        FILM_DIRTY_GEOMETRY | FILM_DIRTY_MESHLET;
    DeviceMemoryBarrier();
    _FilmHeaders[filmIndex].displacementPage = pageIndex + 1u;
}

[numthreads(1, 1, 1)]
void BuildDisplacementArguments(uint3 id : SV_DispatchThreadID)
{
    uint newBase = min(_DisplacementPageState[0], _BasePageCapacity);
    uint dirty = min(_DisplacementDirtyState[0],
        _BaseCellCapacity + _MicroCellCapacity);
    uint newMicro = min(_DisplacementPageState[1], _MicroPageCapacity);
    _DisplacementDispatchArguments[0] =
        uint3((newBase * BASE_CELLS_PER_PAGE + 63u) / 64u, 1u, 1u);
    _DisplacementDispatchArguments[1] = uint3((dirty + 63u) / 64u, 1u, 1u);
    _DisplacementDispatchArguments[2] =
        uint3((newMicro * MICRO_CELLS_PER_PAGE + 63u) / 64u, 1u, 1u);
    uint topologyDirty = min(_TopologyState[0], _FilmCapacity);
    _DisplacementDispatchArguments[3] =
        uint3((topologyDirty + 63u) / 64u, 1u, 1u);
}

[numthreads(64, 1, 1)]
void InitializeBasePages(uint3 id : SV_DispatchThreadID)
{
    uint pageListIndex = id.x / BASE_CELLS_PER_PAGE;
    uint localCell = id.x % BASE_CELLS_PER_PAGE;
    uint pageCount = min(_DisplacementPageStateRead[0], _BasePageCapacity);
    if (pageListIndex >= pageCount) return;
    uint pageIndex = _NewBasePagesRead[pageListIndex];
    if (pageIndex >= _BasePageCapacity) return;
    DisplacementPageHeader page = _DisplacementPages[pageIndex];
    ContactFilmHeader film = _FilmHeadersRead[page.filmId - 1u];
    uint globalCell = CellForPage(false, pageIndex, localCell);
    DisplacementCell initial = EmptyCell(film.sigmaNormal);
    uint x = localCell & 15u;
    uint y = localCell >> 4u;
    float2 uv = (float2(x, y) + 0.5) / 16.0;
    if (BootstrapSupport(film, uv))
    {
        uint supportCells = max(1u,
            countbits(film.supportMaskLow) + countbits(film.supportMaskHigh));
        float4 quality = _FilmInformationRead[(page.filmId - 1u) * 10u + 8u];
        initial.coverage = 1.0;
        initial.support = max(0.25,
            film.supportTotal / max(1.0, (float)supportCells * 4.0));
        initial.bestPrecision = max(quality.w, 0.0);
        initial.bestFootprint = max(quality.z, 1e-12);
        initial.revision = 1u;
        InterlockedAdd(_DisplacementPages[pageIndex].supportFixed,
            (uint)round(initial.support * WEIGHT_SCALE));
        InterlockedMin(_DisplacementPages[pageIndex].bestFootprintBits,
            asuint(initial.bestFootprint));
    }
    _BaseDisplacementCells[globalCell] = initial;
    _BaseChildPages[globalCell] = 0u;
    _DisplacementCellDirtyFlags[globalCell] = 0u;
    uint baseWord = globalCell * WORDS_PER_CELL;
    [unroll] for (uint word = 0u; word < WORDS_PER_CELL; ++word)
        _BaseDisplacementCellAccumulator[baseWord + word] =
            word == 6u ? 0x7f7fffff : 0;
}

[numthreads(64, 1, 1)]
void AccumulateDisplacement(uint3 id : SV_DispatchThreadID)
{
    uint matchCount = min(_ClassCounters[CLASS_MATCH], _EventCapacity);
    if (id.x >= matchCount) return;
    uint eventIndex = _ClassifiedIndices[CLASS_MATCH * _EventCapacity + id.x];
    ConeEvent eventData = _ConeEvents[eventIndex];
    if (eventData.classification != CLASS_MATCH || eventData.filmId == 0u ||
        eventData.measuredRange <= 0.0 || eventData.pressurePrecision <= 0.0)
        return;
    uint filmIndex = eventData.filmId - 1u;
    if (filmIndex >= _FilmCapacity) return;
    ContactFilmHeader film = _FilmHeaders[filmIndex];
    if (film.id != eventData.filmId || film.generation != eventData.filmGeneration ||
        (film.flags & FILM_ACTIVE) == 0u) return;

    uint2 pixel = uint2(eventData.packedPixel & 0xffffu,
        (eventData.packedPixel >> 16u) & 0x7fffu);
    uint eye = eventData.packedPixel >> 31u;
    float3 measuredDepth = LoadRay(pixel, eye) * eventData.measuredRange;
    float3 measuredChunk = mul(_ChunkFromDepth[eye],
        float4(measuredDepth, 1.0)).xyz;
    float3 delta = measuredChunk - film.origin;
    float u = dot(delta, film.tangentU);
    float v = dot(delta, film.tangentV);
    float z = dot(delta, film.normal);
    float2 uv = float2(u / max(2.0 * film.extentU, 0.002) + 0.5,
        v / max(2.0 * film.extentV, 0.002) + 0.5);
    if (any(uv < 0.0) || any(uv > 1.0)) return;
    uint globalCell;
    DisplacementPageHeader page;
    if (!ResolveLeafRead(film, uv, globalCell, page)) return;
    DisplacementCell cell = LoadCellRead(globalCell);
    float target = z - Height(film, u, v);
    float innovation = target - cell.displacement;
    float bestPressure = max(cell.bestPrecision, eventData.pressurePrecision);
    float ratio = saturate(eventData.pressurePrecision / max(bestPressure, 1e-8));
    float gate = saturate((ratio - _QualityFloor) /
        max(1.0 - _QualityFloor, 1e-4));
    gate = gate * gate * (3.0 - 2.0 * gate);
    if (cell.support <= 0.0) gate = 1.0;
    float huberDelta = max(_MinimumHuber, 2.0 * eventData.combinedSigma);
    float robust = abs(innovation) <= huberDelta ? 1.0 :
        huberDelta / max(abs(innovation), 1e-8);
    float weight = saturate(eventData.confidence) * gate * robust;
    if (weight <= 0.0) return;

    MarkCellDirty(globalCell);
    uint baseWord = globalCell * WORDS_PER_CELL;
    AtomicAddScaled(baseWord + 0u, weight, WEIGHT_SCALE);
    AtomicAddScaled(baseWord + 1u, weight * target, VALUE_SCALE);
    AtomicAddScaled(baseWord + 2u, weight * target * target, VALUE_SCALE);
    float2 uvSpan = max(page.uvBounds.zw - page.uvBounds.xy, 1e-8);
    float grid = page.level == 0u ? (float)BASE_GRID : (float)MICRO_GRID;
    float metricCellArea = max(4.0 * film.extentU * film.extentV *
        uvSpan.x * uvSpan.y / (grid * grid), 1e-10);
    float covered = saturate(eventData.footprintArea / metricCellArea);
    AtomicAddScaled(baseWord + 3u, covered, WEIGHT_SCALE);
    InterlockedMaxAccumulator(baseWord + 5u,
        asint(eventData.pressurePrecision));
    InterlockedMinAccumulator(baseWord + 6u,
        asint(max(eventData.footprintArea, 1e-12)));
    AtomicAddScaled(baseWord + 7u,
        saturate(eventData.confidence) * max(0.05, ratio), WEIGHT_SCALE);

    // The Grid16 base page owns the film's canonical connected support domain.
    // Microtiles refine geometry but never become disconnected display patches.
    // Deposit contact coverage at the base scale as well as at the resolved leaf.
    uint supportCell;
    DisplacementPageHeader supportPage;
    if (ResolveBaseCellRead(film, uv, supportCell, supportPage) &&
        supportCell != globalCell)
    {
        float baseMetricCellArea = max(4.0 * film.extentU * film.extentV /
            ((float)BASE_GRID * (float)BASE_GRID), 1e-10);
        float baseCovered = saturate(eventData.footprintArea / baseMetricCellArea);
        MarkCellDirty(supportCell);
        AtomicAddScaled(supportCell * WORDS_PER_CELL + 3u, baseCovered,
            WEIGHT_SCALE);
    }
    _FilmHeaders[filmIndex].flags |= FILM_DIRTY_GEOMETRY |
        FILM_DIRTY_MESHLET;
}

// Topology evidence is a separate GPU pass over the same MATCH indirect list.
// This keeps every Adreno kernel below eight UAVs and, critically, keeps the
// topology moments in their own arena instead of aliasing displacement cells.
[numthreads(64, 1, 1)]
void AccumulateTopologyEvidence(uint3 id : SV_DispatchThreadID)
{
    uint matchCount = min(_ClassCounters[CLASS_MATCH], _EventCapacity);
    if (id.x >= matchCount) return;
    uint eventIndex = _ClassifiedIndices[CLASS_MATCH * _EventCapacity + id.x];
    ConeEvent eventData = _ConeEvents[eventIndex];
    if (eventData.classification != CLASS_MATCH || eventData.filmId == 0u ||
        eventData.measuredRange <= 0.0 || eventData.pressurePrecision <= 0.0)
        return;
    uint filmIndex = eventData.filmId - 1u;
    if (filmIndex >= _FilmCapacity) return;
    ContactFilmHeader film = _FilmHeadersRead[filmIndex];
    if (film.id != eventData.filmId ||
        film.generation != eventData.filmGeneration ||
        (film.flags & FILM_ACTIVE) == 0u) return;

    uint2 pixel = uint2(eventData.packedPixel & 0xffffu,
        (eventData.packedPixel >> 16u) & 0x7fffu);
    uint eye = eventData.packedPixel >> 31u;
    float3 measuredDepth = LoadRay(pixel, eye) * eventData.measuredRange;
    float3 measuredChunk = mul(_ChunkFromDepth[eye],
        float4(measuredDepth, 1.0)).xyz;
    float3 delta = measuredChunk - film.origin;
    float u = dot(delta, film.tangentU);
    float v = dot(delta, film.tangentV);
    float z = dot(delta, film.normal);
    float2 uv = float2(u / max(2.0 * film.extentU, 0.002) + 0.5,
        v / max(2.0 * film.extentV, 0.002) + 0.5);
    if (any(uv < 0.0) || any(uv > 1.0)) return;
    uint globalCell;
    DisplacementPageHeader page;
    if (!ResolveLeafRead(film, uv, globalCell, page)) return;
    DisplacementCell cell = LoadCellRead(globalCell);
    float target = z - Height(film, u, v);
    float innovation = target - cell.displacement;
    float bestPressure = max(cell.bestPrecision, eventData.pressurePrecision);
    float ratio = saturate(eventData.pressurePrecision / max(bestPressure, 1e-8));
    float gate = saturate((ratio - _QualityFloor) /
        max(1.0 - _QualityFloor, 1e-4));
    gate = gate * gate * (3.0 - 2.0 * gate);
    if (cell.support <= 0.0) gate = 1.0;
    float huberDelta = max(_MinimumHuber, 2.0 * eventData.combinedSigma);
    float robust = abs(innovation) <= huberDelta ? 1.0 :
        huberDelta / max(abs(innovation), 1e-8);
    float weight = saturate(eventData.confidence) * gate * robust;
    if (weight <= 0.0) return;

    MarkTopologyDirty(filmIndex);
    uint topologyWord = filmIndex * WORDS_PER_FILM;
    if (innovation >= 0.0)
    {
        AtomicAddTopologyScaled(topologyWord + 0u, weight * innovation,
            VALUE_SCALE);
        AtomicAddTopologyScaled(topologyWord + 1u, weight, WEIGHT_SCALE);
    }
    else
    {
        AtomicAddTopologyScaled(topologyWord + 2u, weight * innovation,
            VALUE_SCALE);
        AtomicAddTopologyScaled(topologyWord + 3u, weight, WEIGHT_SCALE);
    }
    AtomicAddTopologyScaled(topologyWord + 4u,
        weight * innovation * innovation, VALUE_SCALE);
    AtomicAddTopologyScaled(topologyWord + 5u, weight, WEIGHT_SCALE);
    AtomicAddTopologyScaled(topologyWord + 6u,
        weight * saturate(eventData.boundaryEvidence), WEIGHT_SCALE);
    InterlockedAdd(_TopologyAccumulator[topologyWord + 7u], 1);
}

[numthreads(64, 1, 1)]
void AccumulatePreHitPressure(uint3 id : SV_DispatchThreadID)
{
    uint behindCount = min(_ClassCounters[CLASS_BEHIND], _EventCapacity);
    if (id.x >= behindCount) return;
    uint eventIndex = _ClassifiedIndices[
        CLASS_BEHIND * _EventCapacity + id.x];
    ConeEvent eventData = _ConeEvents[eventIndex];
    if (eventData.classification != CLASS_BEHIND || eventData.filmId == 0u ||
        eventData.pressurePrecision <= 0.0 || eventData.confidence <= 0.0)
        return;
    uint filmIndex = eventData.filmId - 1u;
    if (filmIndex >= _FilmCapacity) return;
    ContactFilmHeader film = _FilmHeaders[filmIndex];
    if (film.id != eventData.filmId ||
        film.generation != eventData.filmGeneration ||
        (film.flags & FILM_ACTIVE) == 0u) return;
    uint globalCell;
    DisplacementPageHeader page;
    if (!ResolveBaseCellRead(film, saturate(eventData.predictedUv),
        globalCell, page))
        return;
    DisplacementCell cell = LoadCellRead(globalCell);
    float bestPressure = max(cell.bestPrecision,
        max(_FilmInformationRead[filmIndex * 10u + 8u].w, 1e-8));
    float pressureRatio = saturate(eventData.pressurePrecision / bestPressure);
    float preHitPressureWeight = saturate(eventData.confidence) *
        pressureRatio * pressureRatio;
    if (preHitPressureWeight <= 0.0) return;
    MarkCellDirty(globalCell);
    uint baseWord = globalCell * WORDS_PER_CELL;
    AtomicAddScaled(baseWord + 3u, -preHitPressureWeight, WEIGHT_SCALE);
    uint2 pixel = uint2(eventData.packedPixel & 0xffffu,
        (eventData.packedPixel >> 16u) & 0x7fffu);
    uint eye = eventData.packedPixel >> 31u;
    InterlockedOrAccumulator(baseWord + 4u,
        (int)PreHitPressureViewBit(film, eye));
    float3 rayChunk = normalize(mul((float3x3)_ChunkFromDepth[eye],
        LoadRay(pixel, eye)));
    float normalProjection = dot(rayChunk, film.normal);
    if (abs(normalProjection) > 0.12 && eventData.measuredRange >
        eventData.predictedRange)
    {
        float normalMotion = (eventData.measuredRange -
            eventData.predictedRange) / normalProjection;
        float target = cell.displacement + normalMotion;
        AtomicAddScaled(baseWord + 8u, preHitPressureWeight, WEIGHT_SCALE);
        AtomicAddScaled(baseWord + 9u, preHitPressureWeight * target, VALUE_SCALE);
        AtomicAddScaled(baseWord + 10u, preHitPressureWeight * target * target,
            VALUE_SCALE);
    }
    _FilmHeaders[filmIndex].flags |= FILM_DIRTY_GEOMETRY |
        FILM_DIRTY_MESHLET;
}

[numthreads(64, 1, 1)]
void AccumulateOccluderPreHitPressure(uint3 id : SV_DispatchThreadID)
{
    uint matchCount = min(_ClassCounters[CLASS_MATCH], _EventCapacity);
    if (id.x >= matchCount) return;
    uint eventIndex = _ClassifiedIndices[CLASS_MATCH * _EventCapacity + id.x];
    ConeEvent eventData = _ConeEvents[eventIndex];
    if (eventData.classification != CLASS_MATCH ||
        eventData.occluderFilmId == 0u || eventData.pressurePrecision <= 0.0 ||
        eventData.confidence <= 0.0) return;
    uint filmIndex = eventData.occluderFilmId - 1u;
    if (filmIndex >= _FilmCapacity) return;
    ContactFilmHeader film = _FilmHeaders[filmIndex];
    if (film.id != eventData.occluderFilmId ||
        film.generation != eventData.occluderGeneration ||
        (film.flags & FILM_ACTIVE) == 0u) return;
    uint globalCell;
    DisplacementPageHeader page;
    if (!ResolveBaseCellRead(film, saturate(eventData.occluderUv),
        globalCell, page))
        return;
    DisplacementCell cell = LoadCellRead(globalCell);
    float bestPressure = max(cell.bestPrecision,
        max(_FilmInformationRead[filmIndex * 10u + 8u].w, 1e-8));
    float pressureRatio = saturate(eventData.pressurePrecision / bestPressure);
    float preHitPressureWeight = saturate(eventData.confidence) *
        pressureRatio * pressureRatio;
    if (preHitPressureWeight <= 0.0) return;
    MarkCellDirty(globalCell);
    uint baseWord = globalCell * WORDS_PER_CELL;
    AtomicAddScaled(baseWord + 3u, -preHitPressureWeight, WEIGHT_SCALE);
    uint eye = eventData.packedPixel >> 31u;
    InterlockedOrAccumulator(baseWord + 4u,
        (int)PreHitPressureViewBit(film, eye));
    uint2 pixel = uint2(eventData.packedPixel & 0xffffu,
        (eventData.packedPixel >> 16u) & 0x7fffu);
    float3 rayChunk = normalize(mul((float3x3)_ChunkFromDepth[eye],
        LoadRay(pixel, eye)));
    float normalProjection = dot(rayChunk, film.normal);
    float u = (saturate(eventData.occluderUv.x) - 0.5) *
        2.0 * film.extentU;
    float v = (saturate(eventData.occluderUv.y) - 0.5) *
        2.0 * film.extentV;
    float3 surface = film.origin + u * film.tangentU + v * film.tangentV +
        (Height(film, u, v) + cell.displacement) * film.normal;
    float3 cameraChunk = mul(_ChunkFromDepth[eye],
        float4(0.0, 0.0, 0.0, 1.0)).xyz;
    float occluderRange = length(surface - cameraChunk);
    if (abs(normalProjection) > 0.12 && eventData.measuredRange > occluderRange)
    {
        float normalMotion = (eventData.measuredRange - occluderRange) /
            normalProjection;
        float target = cell.displacement + normalMotion;
        AtomicAddScaled(baseWord + 8u, preHitPressureWeight, WEIGHT_SCALE);
        AtomicAddScaled(baseWord + 9u, preHitPressureWeight * target, VALUE_SCALE);
        AtomicAddScaled(baseWord + 10u, preHitPressureWeight * target * target,
            VALUE_SCALE);
    }
    _FilmHeaders[filmIndex].flags |= FILM_DIRTY_GEOMETRY |
        FILM_DIRTY_MESHLET;
}

[numthreads(64, 1, 1)]
void SolveDirtyDisplacement(uint3 id : SV_DispatchThreadID)
{
    uint dirtyCount = min(_DisplacementDirtyState[0],
        _BaseCellCapacity + _MicroCellCapacity);
    if (id.x >= dirtyCount) return;
    uint globalCell = _DirtyDisplacementCellIndices[id.x];
    if (globalCell >= _BaseCellCapacity + _MicroCellCapacity) return;
    uint baseWord = globalCell * WORDS_PER_CELL;
    float weight = max(0.0,
        (float)LoadAccumulator(baseWord + 0u) / WEIGHT_SCALE);
    float signedCoverage =
        (float)LoadAccumulator(baseWord + 3u) / WEIGHT_SCALE;
    uint preHitViewMask =
        (uint)LoadAccumulator(baseWord + 4u);
    float framePressureWeight = max(0.0,
        (float)LoadAccumulator(baseWord + 8u) / WEIGHT_SCALE);
    DisplacementCell cell = LoadCell(globalCell);
    bool changed = false;
    if (weight > 0.0)
    {
        float mean = (float)LoadAccumulator(baseWord + 1u) /
            VALUE_SCALE / weight;
        float secondMoment = (float)LoadAccumulator(baseWord + 2u) /
            VALUE_SCALE / weight;
        float frameVariance = max(0.0, secondMoment - mean * mean);
        float previousSupport = max(0.0, cell.support);
        float totalSupport = previousSupport + weight;
        float delta = mean - cell.displacement;
        float updated = previousSupport > 0.0
            ? cell.displacement + delta * weight / max(totalSupport, 1e-8)
            : mean;
        float combinedVariance = previousSupport > 0.0
            ? (previousSupport * cell.residualVariance + weight * frameVariance +
                previousSupport * weight / max(totalSupport, 1e-8) * delta * delta) /
                max(totalSupport, 1e-8)
            : frameVariance;
        float candidateSigma = max(_MinimumSigma,
            sqrt(max(combinedVariance, _MinimumSigma * _MinimumSigma)) /
            sqrt(max(1.0, totalSupport * 0.25)));
        cell.displacement = updated;
        cell.sigma = previousSupport > 0.0
            ? min(cell.sigma, candidateSigma)
            : candidateSigma;
        cell.support = totalSupport;
        cell.bestPrecision = max(cell.bestPrecision,
            asfloat(LoadAccumulator(baseWord + 5u)));
        cell.bestFootprint = min(cell.bestFootprint,
            asfloat(LoadAccumulator(baseWord + 6u)));
        cell.residualVariance = combinedVariance;
        changed = true;
    }

    if (signedCoverage > 0.0)
    {
        float contactCoverage = saturate(signedCoverage);
        cell.coverage = saturate(cell.coverage +
            contactCoverage * (1.0 - cell.coverage));
        // Confirmed contact pushes back against stale pre-hit pressure. Strong
        // close contact clears weak contradiction quickly, while a genuinely moved
        // surface still wins through repeated independent first-hit cones.
        cell.preHitPressure = max(0.0,
            cell.preHitPressure - 2.0 * contactCoverage);
        if (cell.preHitPressure < 0.25) cell.preHitPressureViewMask = 0u;
        changed = true;
    }
    else if (signedCoverage < 0.0)
    {
        float framePreHitPressure = -signedCoverage;
        cell.preHitPressure = min(65535.0,
            cell.preHitPressure * 0.995 + framePreHitPressure);
        cell.preHitPressureViewMask |= preHitViewMask;

        // Pressure does work by displacing the elastic film through the proven
        // pre-hit interval toward its first-hit mould. It never reduces coverage or
        // deletes triangles. Resistance is
        // the baked information state: accumulated support times the best (usually
        // closest) precision, so weak distant/grazing cones cannot move a close bake.
        float bakedResistance = 1.0 + 0.06 *
            sqrt(max(cell.bestPrecision, 1.0)) *
            sqrt(max(cell.support, 1.0));
        if (countbits(cell.preHitPressureViewMask) >= 2u &&
            cell.preHitPressure > bakedResistance && framePressureWeight > 0.0)
        {
            float excess = cell.preHitPressure - bakedResistance;
            float target = (float)LoadAccumulator(baseWord + 9u) /
                VALUE_SCALE / max(framePressureWeight, 1e-8);
            float response = saturate(excess /
                max(bakedResistance + framePressureWeight, 1.0));
            float measuredScale = isfinite(cell.bestFootprint)
                ? sqrt(max(cell.bestFootprint, 1e-10)) : 0.0;
            float maximumStep = max(_MinimumSigma,
                min(0.05, max(2.0 * cell.sigma, measuredScale)));
            float pressureStep = clamp((target - cell.displacement) * response,
                -maximumStep, maximumStep);
            cell.displacement += pressureStep;
            // Work is consumed by actual elastic motion, so a stale pressure packet
            // cannot keep moving the sheet after the originating views disappear.
            float workFraction = saturate(abs(pressureStep) /
                max(abs(target - cell.displacement) + abs(pressureStep), 1e-8));
            cell.preHitPressure = max(0.0,
                cell.preHitPressure - max(framePressureWeight,
                    workFraction * bakedResistance));
            changed = changed || abs(pressureStep) > 0.0;
        }
        changed = true;
    }

    if (changed)
    {
        cell.revision = cell.revision == 0xffffffffu ? 1u :
            cell.revision + 1u;
        StoreCell(globalCell, cell);
        bool micro = IsMicroCell(globalCell);
        uint localIndex = micro ? globalCell - _BaseCellCapacity : globalCell;
        uint pageIndex = micro ? localIndex / MICRO_CELLS_PER_PAGE :
            localIndex / BASE_CELLS_PER_PAGE;
        uint headerIndex = PageHeaderIndex(micro, pageIndex);
        InterlockedMin(_DisplacementPages[headerIndex].bestFootprintBits,
            asuint(max(cell.bestFootprint, 1e-12)));
        InterlockedMax(_DisplacementPages[headerIndex].maximumVarianceBits,
            asuint(max(cell.residualVariance, 0.0)));
        if (weight > 0.0)
            InterlockedAdd(_DisplacementPages[headerIndex].supportFixed,
                (uint)max(0.0, round(weight * WEIGHT_SCALE)));
        InterlockedAdd(_DisplacementPages[headerIndex].revision, 1u);
        _DisplacementPages[headerIndex].flags |= PAGE_DIRTY;
    }

    [unroll] for (uint word = 0u; word < WORDS_PER_CELL; ++word)
        StoreAccumulator(baseWord + word,
            word == 6u ? 0x7f7fffff : 0);
}

[numthreads(64, 1, 1)]
void AllocateMicrotiles(uint3 id : SV_DispatchThreadID)
{
    uint dirtyCount = min(_DisplacementDirtyStateRead[0],
        _BaseCellCapacity + _MicroCellCapacity);
    if (id.x >= dirtyCount) return;
    uint globalCell = _DirtyDisplacementCellIndicesRead[id.x];
    if (globalCell >= _BaseCellCapacity + _MicroCellCapacity) return;
    bool sourceMicro = IsMicroCell(globalCell);
    uint sourceIndex = sourceMicro ? globalCell - _BaseCellCapacity : globalCell;
    uint sourcePage = sourceMicro ? sourceIndex / MICRO_CELLS_PER_PAGE :
        sourceIndex / BASE_CELLS_PER_PAGE;
    uint localCell = sourceMicro ? sourceIndex % MICRO_CELLS_PER_PAGE :
        sourceIndex % BASE_CELLS_PER_PAGE;
    uint headerIndex = PageHeaderIndex(sourceMicro, sourcePage);
    DisplacementPageHeader parent = _DisplacementPages[headerIndex];
    DisplacementCell cell = LoadCellRead(globalCell);
    if ((parent.flags & PAGE_ACTIVE) == 0u ||
        parent.level >= _MaximumMicroLevels || cell.support < 2.0 ||
        !isfinite(cell.bestFootprint))
    {
        _DisplacementCellDirtyFlags[globalCell] = 0u;
        return;
    }
    ContactFilmHeader film = _FilmHeadersRead[parent.filmId - 1u];
    uint grid = sourceMicro ? MICRO_GRID : BASE_GRID;
    uint cellX = localCell % grid;
    uint cellY = localCell / grid;
    float2 parentSpan = parent.uvBounds.zw - parent.uvBounds.xy;
    float2 cellSpan = parentSpan / (float)grid;
    float metricWidth = length(float2(2.0 * film.extentU * cellSpan.x,
        2.0 * film.extentV * cellSpan.y));
    bool footprintSupports = sqrt(max(cell.bestFootprint, 0.0)) <
        metricWidth * _RefinementFootprintRatio;
    bool shapeSupports = cell.residualVariance >= _RefinementVariance ||
        (film.boundaryCount > 0u &&
         cell.residualVariance >= _RefinementVariance * 0.25);
    if (!footprintSupports || !shapeSupports)
    {
        _DisplacementCellDirtyFlags[globalCell] = 0u;
        return;
    }

    uint prior;
    if (sourceMicro)
        InterlockedCompareExchange(_MicroChildPages[sourceIndex], 0u,
            ALLOCATION_CLAIM, prior);
    else
        InterlockedCompareExchange(_BaseChildPages[sourceIndex], 0u,
            ALLOCATION_CLAIM, prior);
    if (prior != 0u)
    {
        _DisplacementCellDirtyFlags[globalCell] = 0u;
        return;
    }
    uint microPage;
    InterlockedAdd(_DisplacementAllocator[1], 1u, microPage);
    if (microPage >= _MicroPageCapacity)
    {
        InterlockedAdd(_DisplacementAllocator[3], 1u);
        StoreChild(globalCell, 0u);
        _DisplacementCellDirtyFlags[globalCell] = 0u;
        return;
    }

    DisplacementPageHeader child = (DisplacementPageHeader)0;
    child.id = microPage + 1u;
    child.generation = max(1u, _DisplacementAllocator[4]);
    child.filmId = parent.filmId;
    child.filmGeneration = parent.filmGeneration;
    child.level = parent.level + 1u;
    child.parentPage = headerIndex + 1u;
    child.parentCell = localCell;
    child.flags = PAGE_ACTIVE | PAGE_MICRO | PAGE_DIRTY;
    child.uvBounds = float4(
        parent.uvBounds.xy + float2(cellX, cellY) * cellSpan,
        parent.uvBounds.xy + float2(cellX + 1u, cellY + 1u) * cellSpan);
    child.bestFootprintBits = asuint(3.402823466e+38);
    _DisplacementPages[PageHeaderIndex(true, microPage)] = child;
    uint queueSlot;
    InterlockedAdd(_DisplacementPageState[1], 1u, queueSlot);
    if (queueSlot < _MicroPageCapacity)
        _NewMicroPages[queueSlot] = microPage;
    else
        InterlockedAdd(_DisplacementPageState[3], 1u);
    DeviceMemoryBarrier();
    StoreChild(globalCell, microPage + 1u);
    _DisplacementCellDirtyFlags[globalCell] = 0u;
}

[numthreads(64, 1, 1)]
void InitializeMicroPages(uint3 id : SV_DispatchThreadID)
{
    uint pageListIndex = id.x / MICRO_CELLS_PER_PAGE;
    uint localCell = id.x % MICRO_CELLS_PER_PAGE;
    uint pageCount = min(_DisplacementPageStateRead[1], _MicroPageCapacity);
    if (pageListIndex >= pageCount) return;
    uint pageIndex = _NewMicroPagesRead[pageListIndex];
    if (pageIndex >= _MicroPageCapacity) return;
    DisplacementPageHeader page =
        _DisplacementPagesRead[PageHeaderIndex(true, pageIndex)];
    ContactFilmHeader film = _FilmHeadersRead[page.filmId - 1u];
    uint microCell = pageIndex * MICRO_CELLS_PER_PAGE + localCell;
    uint globalCell = _BaseCellCapacity + microCell;
    DisplacementCell inherited = EmptyCell(film.sigmaNormal);
    if (page.parentPage > 0u)
    {
        uint parentHeaderIndex = page.parentPage - 1u;
        bool parentMicro = parentHeaderIndex >= _BasePageCapacity;
        uint parentPage = parentMicro ? parentHeaderIndex - _BasePageCapacity :
            parentHeaderIndex;
        uint parentGlobalCell = CellForPage(parentMicro, parentPage,
            page.parentCell);
        if (IsMicroCell(parentGlobalCell))
            inherited = _MicroDisplacementCells[
                parentGlobalCell - _BaseCellCapacity];
        else
            inherited = _BaseDisplacementCellsRead[parentGlobalCell];
        // The parent posterior is a spatial prior for the 8x8 children, not
        // 64 independent copies of the same evidence.  Partition support so
        // refinement cannot manufacture information merely by allocating a page.
        inherited.support /= (float)MICRO_CELLS_PER_PAGE;
        inherited.coverage = 0.0;
        inherited.preHitPressure = 0.0;
        inherited.preHitPressureViewMask = 0u;
        inherited.revision = 0u;
    }
    _MicroDisplacementCells[microCell] = inherited;
    _MicroChildPages[microCell] = 0u;
    _DisplacementCellDirtyFlags[globalCell] = 0u;
    uint baseWord = microCell * WORDS_PER_CELL;
    [unroll] for (uint word = 0u; word < WORDS_PER_CELL; ++word)
        _MicroDisplacementCellAccumulator[baseWord + word] =
            word == 6u ? 0x7f7fffff : 0;
}

[numthreads(64, 1, 1)]
void SolveTopologyEvidence(uint3 id : SV_DispatchThreadID)
{
    uint dirtyCount = min(_TopologyState[0], _FilmCapacity);
    if (id.x >= dirtyCount) return;
    uint filmIndex = _DirtyTopologyIndices[id.x];
    if (filmIndex >= _FilmCapacity) return;
    uint baseWord = filmIndex * WORDS_PER_FILM;
    float positiveWeight = max(0.0,
        (float)_TopologyAccumulator[baseWord + 1u] / WEIGHT_SCALE);
    float negativeWeight = max(0.0,
        (float)_TopologyAccumulator[baseWord + 3u] / WEIGHT_SCALE);
    float frameWeight = max(0.0,
        (float)_TopologyAccumulator[baseWord + 5u] / WEIGHT_SCALE);
    ContactTopologyEvidence evidence = _TopologyEvidence[filmIndex];
    if (positiveWeight > 0.0)
    {
        float mean = (float)_TopologyAccumulator[baseWord + 0u] /
            VALUE_SCALE / positiveWeight;
        evidence.positiveMoment += mean * positiveWeight;
        evidence.positiveSupport += positiveWeight;
    }
    if (negativeWeight > 0.0)
    {
        float mean = (float)_TopologyAccumulator[baseWord + 2u] /
            VALUE_SCALE / negativeWeight;
        evidence.negativeMoment += mean * negativeWeight;
        evidence.negativeSupport += negativeWeight;
    }
    if (frameWeight > 0.0)
    {
        float secondMoment = (float)_TopologyAccumulator[baseWord + 4u] /
            VALUE_SCALE / frameWeight;
        float previous = evidence.totalSupport;
        evidence.residualVariance = previous > 0.0
            ? (evidence.residualVariance * previous + secondMoment * frameWeight) /
                max(previous + frameWeight, 1e-8)
            : secondMoment;
        evidence.boundarySupport +=
            (float)_TopologyAccumulator[baseWord + 6u] / WEIGHT_SCALE;
        evidence.totalSupport += frameWeight;
        evidence.revision = evidence.revision == 0xffffffffu ? 1u :
            evidence.revision + 1u;
        // Cap old evidence without changing its means.  This lets topology react
        // to sustained new contacts while retaining a durable multi-view prior.
        if (evidence.totalSupport > 256.0)
        {
            const float decay = 0.75;
            evidence.positiveMoment *= decay;
            evidence.positiveSupport *= decay;
            evidence.negativeMoment *= decay;
            evidence.negativeSupport *= decay;
            evidence.boundarySupport *= decay;
            evidence.totalSupport *= decay;
        }
        _TopologyEvidence[filmIndex] = evidence;
    }
    [unroll] for (uint word = 0u; word < WORDS_PER_FILM; ++word)
        _TopologyAccumulator[baseWord + word] = 0;
    _TopologyDirtyFlags[filmIndex] = 0u;
}
