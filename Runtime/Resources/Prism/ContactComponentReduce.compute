#pragma kernel PrepareComponentReduction
#pragma kernel ClearComponentProducts
#pragma kernel BuildComponentHash
#pragma kernel HookComponentGraph
#pragma kernel ShortcutComponentParents
#pragma kernel CompactComponentRoots
#pragma kernel BuildComponentDispatchArguments
#pragma kernel AccumulateComponentMoments
#pragma kernel FinalizeComponentFrames
#pragma kernel AccumulateComponentExtents
#pragma kernel FinalizeComponentExtents
#pragma kernel ClearComponentPosterior
#pragma kernel AccumulateComponentPosterior
#pragma kernel SolveComponentPosterior
#pragma kernel EvaluateComponentModel
#pragma kernel ExpandRejectedComponents

// Q3-15.6 contact-posterior reduction. 8x8 tiles are measurement work blocks only.
// This pass converges their graph, selects one component frame, and rebuilds every
// quadratic equation directly from the original finite-cone samples in that frame.
// No numerically privileged DSU root posterior survives publication.

struct ConeEvent
{
    uint pixelLinear; uint packedPixel; uint classification; uint flags;
    float measuredRange; float predictedRange; float combinedSigma; float confidence;
    float3 measuredNormal; float boundaryEvidence;
    uint filmId; uint filmGeneration; float2 predictedUv;
    float footprintArea; float incidence; float pressurePrecision;
    uint occluderFilmId; uint occluderGeneration; float2 occluderUv;
};

struct ContactFilmHeader
{
    uint id; uint generation; uint chunkId; uint flags;
    float3 origin; float supportTotal;
    float3 normal; float sigmaNormal;
    float3 tangentU; float extentU;
    float3 tangentV; float extentV;
    float4 quadratic0123; float2 quadratic45;
    float confidence; float contradiction;
    uint revision; uint displacementPage; uint appearancePage;
    uint boundaryStart; uint boundaryCount;
    uint supportMaskLow; uint supportMaskHigh;
    uint reserved0; uint reserved1; uint reserved2;
};

StructuredBuffer<ConeEvent> _ConeEvents;
Texture2D<float4> _DepthRayCenterLeft;
Texture2D<float4> _DepthRayCenterRight;

RWStructuredBuffer<ContactFilmHeader> _CandidateHeaders;
RWStructuredBuffer<float4> _CandidateInformation;
RWStructuredBuffer<uint> _CandidateParents;
RWStructuredBuffer<uint> _CandidateHashHeads;
RWStructuredBuffer<uint> _CandidateHashNext;
RWStructuredBuffer<uint> _CandidateHashKeys;
RWStructuredBuffer<uint> _CandidateRepresentatives;
RWStructuredBuffer<uint> _CandidateState;
RWStructuredBuffer<uint3> _CandidateDispatchArguments;
RWStructuredBuffer<int4> _ComponentMoments;
RWStructuredBuffer<ContactFilmHeader> _ComponentFrames;
RWStructuredBuffer<int> _ComponentPosterior;
RWStructuredBuffer<uint> _ComponentModelFlags;
StructuredBuffer<uint> _CandidatePixelOwners;

uint2 _Resolution;
uint _CandidateCapacity;
uint _CandidateHashCapacity;
uint _EventCapacity;
float _PrecisionUnit;
float _ModelResidualFloor;
float _ComponentNormalCosine;
float4x4 _ChunkFromDepth[2];
uint _PosteriorPass;
uint _CommitPosterior;

static const uint INVALID_INDEX = 0xffffffffu;
static const uint MOMENT_RECORDS = 8u;
static const uint POSTERIOR_WORDS = 36u;
static const uint FILM_ACTIVE = 1u;
static const float MOMENT_POSITION_SCALE = 100000.0;
static const float MOMENT_NORMAL_SCALE = 100000.0;
static const float MOMENT_SIGMA_SCALE = 1000000.0;
static const float EXTENT_SCALE = 100000.0;
static const float POSTERIOR_SCALE = 16384.0;

uint CandidateCount() { return min(_CandidateState[0], _CandidateCapacity); }

float3 SafeNormalize(float3 value, float3 fallback)
{
    float n2 = dot(value, value);
    if (!(n2 > 1e-12) || !(n2 < 1e12)) value = fallback;
    return value * rsqrt(max(dot(value, value), 1e-12));
}

uint HashCell(int3 cell)
{
    uint value = asuint(cell.x) * 0x8da6b343u;
    value ^= asuint(cell.y) * 0xd8163841u;
    value ^= asuint(cell.z) * 0xcb1ab31fu;
    value ^= value >> 16u; value *= 0x7feb352du; value ^= value >> 15u;
    return max(1u, value);
}

int3 CandidateCell(float3 position) { return (int3)floor(position / 0.20); }

bool Compatible(ContactFilmHeader a, ContactFilmHeader b)
{
    if (a.chunkId != b.chunkId) return false;
    float normalAgreement = dot(a.normal, b.normal);
    if (normalAgreement < 0.94) return false;
    float3 delta = b.origin - a.origin;
    float footprintA = sqrt(max(a.quadratic0123.w == a.quadratic0123.w
        ? max(a.sigmaNormal * a.sigmaNormal, 1e-8) : 1e-8, 1e-8));
    float footprintB = sqrt(max(b.sigmaNormal * b.sigmaNormal, 1e-8));
    float planeGate = 3.0 * sqrt(a.sigmaNormal * a.sigmaNormal +
        b.sigmaNormal * b.sigmaNormal) + footprintA + footprintB + 0.002;
    if (abs(dot(delta, a.normal)) > planeGate) return false;
    float margin = footprintA + footprintB + 0.004;
    float u = abs(dot(delta, a.tangentU));
    float v = abs(dot(delta, a.tangentV));
    return u <= a.extentU + b.extentU + margin &&
        v <= a.extentV + b.extentV + margin;
}

uint Parent(uint index)
{
    return index < _CandidateCapacity ? _CandidateParents[index] : index;
}

uint RootAfterConvergence(uint index)
{
    uint parent = Parent(index);
    uint grand = Parent(parent);
    return min(parent, grand);
}

uint UpperIndex(uint row, uint column)
{
    return row * 6u - (row * (row - 1u)) / 2u + (column - row);
}

void AtomicAddPosterior(uint address, float value)
{
    int quantized = (int)round(clamp(value * POSTERIOR_SCALE,
        -2140000000.0, 2140000000.0));
    if (quantized != 0) InterlockedAdd(_ComponentPosterior[address], quantized);
}

float PosteriorValue(uint address)
{
    return (float)_ComponentPosterior[address] / POSTERIOR_SCALE;
}

float InformationH(uint info, uint packed)
{
    float4 value = _CandidateInformation[info + (packed >> 2u)];
    uint lane = packed & 3u;
    return lane == 0u ? value.x : lane == 1u ? value.y :
        lane == 2u ? value.z : value.w;
}

void SetInformationH(uint info, uint packed, float value)
{
    uint record = packed >> 2u; uint lane = packed & 3u;
    float4 data = _CandidateInformation[info + record];
    if (lane == 0u) data.x = value;
    else if (lane == 1u) data.y = value;
    else if (lane == 2u) data.z = value;
    else data.w = value;
    _CandidateInformation[info + record] = data;
}

void SetInformationG(uint info, uint index, float value)
{
    uint record = index < 4u ? 6u : 7u;
    uint lane = index < 4u ? index : index - 4u;
    float4 data = _CandidateInformation[info + record];
    if (lane == 0u) data.x = value;
    else if (lane == 1u) data.y = value;
    else if (lane == 2u) data.z = value;
    else data.w = value;
    _CandidateInformation[info + record] = data;
}

bool CholeskySolve(float coefficientMatrix[36], float rhs[6],
    out float solution[6])
{
    float lower[36];
    [unroll] for (uint i = 0u; i < 36u; ++i) lower[i] = 0.0;
    [unroll]
    for (uint row = 0u; row < 6u; ++row)
    {
        [unroll]
        for (uint column = 0u; column <= row; ++column)
        {
            float sum = coefficientMatrix[row * 6u + column];
            [unroll] for (uint k = 0u; k < column; ++k)
                sum -= lower[row * 6u + k] * lower[column * 6u + k];
            if (row == column)
            {
                if (!(sum > 1e-10) || !isfinite(sum)) return false;
                lower[row * 6u + column] = sqrt(sum);
            }
            else lower[row * 6u + column] = sum /
                max(lower[column * 6u + column], 1e-8);
        }
    }
    float y[6];
    [unroll]
    for (uint row = 0u; row < 6u; ++row)
    {
        float sum = rhs[row];
        [unroll] for (uint k = 0u; k < row; ++k)
            sum -= lower[row * 6u + k] * y[k];
        y[row] = sum / max(lower[row * 6u + row], 1e-8);
    }
    [unroll] for (uint i = 0u; i < 6u; ++i) solution[i] = 0.0;
    for (int row = 5; row >= 0; --row)
    {
        float sum = y[row];
        for (int k = row + 1; k < 6; ++k)
            sum -= lower[k * 6 + row] * solution[k];
        solution[row] = sum / max(lower[row * 6 + row], 1e-8);
    }
    return true;
}

[numthreads(1, 1, 1)]
void PrepareComponentReduction(uint3 id : SV_DispatchThreadID)
{
    _CandidateState[2] = 0u;
    _CandidateState[3] = 0u;
    _CandidateState[6] = 0u;
    _CandidateState[7] = 0u;
    uint count = CandidateCount();
    _CandidateDispatchArguments[0] = uint3((count + 63u) / 64u, 1u, 1u);
    _CandidateDispatchArguments[1] = uint3(0u, 1u, 1u);
    _CandidateDispatchArguments[2] = uint3((count + 63u) / 64u, 1u, 1u);
}

[numthreads(64, 1, 1)]
void ClearComponentProducts(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index < _CandidateCapacity)
    {
        _CandidateRepresentatives[index] = 0u;
        _ComponentFrames[index] = (ContactFilmHeader)0;
        _ComponentModelFlags[index] = 0u;
        uint baseMoment = index * MOMENT_RECORDS;
        [unroll] for (uint r = 0u; r < MOMENT_RECORDS; ++r)
            _ComponentMoments[baseMoment + r] = 0;
        _ComponentMoments[baseMoment + 4u] = int4(
            0x7fffffff, 0x7fffffff, -2147483647, -2147483647);
    }
    if (index < _CandidateHashCapacity) _CandidateHashHeads[index] = INVALID_INDEX;
}

[numthreads(64, 1, 1)]
void BuildComponentHash(uint3 id : SV_DispatchThreadID)
{
    uint candidate = id.x; if (candidate >= CandidateCount()) return;
    ContactFilmHeader film = _CandidateHeaders[candidate];
    uint key = HashCell(CandidateCell(film.origin));
    uint bucket = key & (_CandidateHashCapacity - 1u);
    uint previous;
    InterlockedExchange(_CandidateHashHeads[bucket], candidate, previous);
    _CandidateHashNext[candidate] = previous;
    _CandidateHashKeys[candidate] = key;
}

[numthreads(64, 1, 1)]
void HookComponentGraph(uint3 id : SV_DispatchThreadID)
{
    uint count = CandidateCount(); uint candidate = id.x;
    if (candidate >= count) return;
    ContactFilmHeader film = _CandidateHeaders[candidate];
    int3 centre = CandidateCell(film.origin);
    [unroll] for (int z = -1; z <= 1; ++z)
    [unroll] for (int y = -1; y <= 1; ++y)
    [unroll] for (int x = -1; x <= 1; ++x)
    {
        uint key = HashCell(centre + int3(x, y, z));
        uint other = _CandidateHashHeads[key & (_CandidateHashCapacity - 1u)];
        [loop]
        for (uint chain = 0u; chain < 128u && other != INVALID_INDEX; ++chain)
        {
            if (other < count && other != candidate &&
                _CandidateHashKeys[other] == key &&
                Compatible(film, _CandidateHeaders[other]))
            {
                uint rootA = RootAfterConvergence(candidate);
                uint rootB = RootAfterConvergence(other);
                uint high = max(rootA, rootB); uint low = min(rootA, rootB);
                if (high != low)
                {
                    uint previous;
                    InterlockedMin(_CandidateParents[high], low, previous);
                    if (previous > low) InterlockedAdd(_CandidateState[2], 1u);
                }
            }
            other = other < count ? _CandidateHashNext[other] : INVALID_INDEX;
        }
    }
}

[numthreads(64, 1, 1)]
void ShortcutComponentParents(uint3 id : SV_DispatchThreadID)
{
    uint candidate = id.x; if (candidate >= CandidateCount()) return;
    uint parent = Parent(candidate); uint grand = Parent(parent);
    if (grand < parent)
    {
        _CandidateParents[candidate] = grand;
        InterlockedAdd(_CandidateState[6], 1u);
    }
}

[numthreads(64, 1, 1)]
void CompactComponentRoots(uint3 id : SV_DispatchThreadID)
{
    uint candidate = id.x; if (candidate >= CandidateCount()) return;
    uint root = RootAfterConvergence(candidate);
    _CandidateParents[candidate] = root;
    if (root != candidate) return;
    uint ordinal; InterlockedAdd(_CandidateState[3], 1u, ordinal);
    if (ordinal < _CandidateCapacity) _CandidateRepresentatives[ordinal] = candidate;
}

[numthreads(1, 1, 1)]
void BuildComponentDispatchArguments(uint3 id : SV_DispatchThreadID)
{
    uint reps = min(_CandidateState[3], _CandidateCapacity);
    _CandidateDispatchArguments[1] = uint3(reps, 1u, 1u);
}

[numthreads(64, 1, 1)]
void AccumulateComponentMoments(uint3 id : SV_DispatchThreadID)
{
    uint candidate = id.x; if (candidate >= CandidateCount()) return;
    uint root = _CandidateParents[candidate];
    ContactFilmHeader film = _CandidateHeaders[candidate];
    ContactFilmHeader anchor = _CandidateHeaders[root];
    uint baseMoment = root * MOMENT_RECORDS;
    int weight = clamp((int)round(sqrt(max(film.supportTotal, 1.0))), 1, 16);
    float3 delta = film.origin - anchor.origin;
    InterlockedAdd(_ComponentMoments[baseMoment + 0u].x, 1);
    InterlockedAdd(_ComponentMoments[baseMoment + 0u].y, weight);
    InterlockedAdd(_ComponentMoments[baseMoment + 0u].z,
        (int)round(film.confidence * 10000.0) * weight);
    InterlockedAdd(_ComponentMoments[baseMoment + 0u].w,
        (int)round(film.sigmaNormal * MOMENT_SIGMA_SCALE) * weight);
    InterlockedAdd(_ComponentMoments[baseMoment + 1u].x,
        (int)round(delta.x * MOMENT_POSITION_SCALE) * weight);
    InterlockedAdd(_ComponentMoments[baseMoment + 1u].y,
        (int)round(delta.y * MOMENT_POSITION_SCALE) * weight);
    InterlockedAdd(_ComponentMoments[baseMoment + 1u].z,
        (int)round(delta.z * MOMENT_POSITION_SCALE) * weight);
    InterlockedAdd(_ComponentMoments[baseMoment + 2u].x,
        (int)round(film.normal.x * MOMENT_NORMAL_SCALE) * weight);
    InterlockedAdd(_ComponentMoments[baseMoment + 2u].y,
        (int)round(film.normal.y * MOMENT_NORMAL_SCALE) * weight);
    InterlockedAdd(_ComponentMoments[baseMoment + 2u].z,
        (int)round(film.normal.z * MOMENT_NORMAL_SCALE) * weight);
    InterlockedAdd(_ComponentMoments[baseMoment + 2u].w,
        (int)round(min(film.supportTotal, 4096.0) * 256.0));
}

[numthreads(1, 1, 1)]
void FinalizeComponentFrames(uint3 id : SV_DispatchThreadID)
{
    uint ordinal = id.x; uint reps = min(_CandidateState[3], _CandidateCapacity);
    if (ordinal >= reps) return;
    uint root = _CandidateRepresentatives[ordinal];
    ContactFilmHeader anchor = _CandidateHeaders[root];
    uint baseMoment = root * MOMENT_RECORDS;
    int weight = max(1, _ComponentMoments[baseMoment + 0u].y);
    float3 delta = float3(_ComponentMoments[baseMoment + 1u].xyz) /
        (MOMENT_POSITION_SCALE * (float)weight);
    float3 normal = float3(_ComponentMoments[baseMoment + 2u].xyz) /
        (MOMENT_NORMAL_SCALE * (float)weight);
    normal = SafeNormalize(normal, anchor.normal);
    if (dot(normal, anchor.normal) < 0.0) normal = -normal;
    float3 axis = abs(normal.x) <= abs(normal.y) && abs(normal.x) <= abs(normal.z)
        ? float3(1, 0, 0) : abs(normal.y) <= abs(normal.z)
        ? float3(0, 1, 0) : float3(0, 0, 1);
    float3 tangentU = SafeNormalize(cross(axis, normal), anchor.tangentU);
    float3 tangentV = SafeNormalize(cross(normal, tangentU), anchor.tangentV);
    ContactFilmHeader frame = anchor;
    frame.origin = anchor.origin + delta;
    frame.normal = normal; frame.tangentU = tangentU; frame.tangentV = tangentV;
    frame.extentU = 0.001; frame.extentV = 0.001;
    frame.sigmaNormal = clamp(
        (float)_ComponentMoments[baseMoment + 0u].w /
        (MOMENT_SIGMA_SCALE * (float)weight), 0.00035, 0.1);
    frame.confidence = saturate(
        (float)_ComponentMoments[baseMoment + 0u].z /
        (10000.0 * (float)weight));
    frame.supportTotal = (float)_ComponentMoments[baseMoment + 2u].w / 256.0;
    frame.quadratic0123 = 0.0; frame.quadratic45 = 0.0;
    frame.supportMaskLow = 0u; frame.supportMaskHigh = 0u;
    _ComponentFrames[root] = frame;
}

[numthreads(64, 1, 1)]
void AccumulateComponentExtents(uint3 id : SV_DispatchThreadID)
{
    uint candidate = id.x; if (candidate >= CandidateCount()) return;
    uint root = _CandidateParents[candidate];
    ContactFilmHeader film = _CandidateHeaders[candidate];
    ContactFilmHeader frame = _ComponentFrames[root];
    uint baseMoment = root * MOMENT_RECORDS;
    [unroll] for (uint corner = 0u; corner < 4u; ++corner)
    {
        float su = (corner & 1u) != 0u ? 1.0 : -1.0;
        float sv = (corner & 2u) != 0u ? 1.0 : -1.0;
        float3 cornerPosition = film.origin +
            su * film.extentU * film.tangentU +
            sv * film.extentV * film.tangentV;
        float3 delta = cornerPosition - frame.origin;
        int u = (int)round(dot(delta, frame.tangentU) * EXTENT_SCALE);
        int v = (int)round(dot(delta, frame.tangentV) * EXTENT_SCALE);
        InterlockedMin(_ComponentMoments[baseMoment + 4u].x, u);
        InterlockedMin(_ComponentMoments[baseMoment + 4u].y, v);
        InterlockedMax(_ComponentMoments[baseMoment + 4u].z, u);
        InterlockedMax(_ComponentMoments[baseMoment + 4u].w, v);
    }
}

[numthreads(1, 1, 1)]
void FinalizeComponentExtents(uint3 id : SV_DispatchThreadID)
{
    uint ordinal = id.x; uint reps = min(_CandidateState[3], _CandidateCapacity);
    if (ordinal >= reps) return;
    uint root = _CandidateRepresentatives[ordinal];
    uint baseMoment = root * MOMENT_RECORDS;
    int4 bounds = _ComponentMoments[baseMoment + 4u];
    ContactFilmHeader frame = _ComponentFrames[root];
    float minU = (float)bounds.x / EXTENT_SCALE;
    float minV = (float)bounds.y / EXTENT_SCALE;
    float maxU = (float)bounds.z / EXTENT_SCALE;
    float maxV = (float)bounds.w / EXTENT_SCALE;
    float centreU = 0.5 * (minU + maxU); float centreV = 0.5 * (minV + maxV);
    frame.origin += centreU * frame.tangentU + centreV * frame.tangentV;
    frame.extentU = max(0.001, 0.5 * (maxU - minU));
    frame.extentV = max(0.001, 0.5 * (maxV - minV));
    _ComponentFrames[root] = frame;
}

[numthreads(64, 1, 1)]
void ClearComponentPosterior(uint3 id : SV_DispatchThreadID)
{
    uint candidate = id.x; if (candidate >= _CandidateCapacity) return;
    uint baseWord = candidate * POSTERIOR_WORDS;
    [unroll] for (uint word = 0u; word < POSTERIOR_WORDS; ++word)
        _ComponentPosterior[baseWord + word] = 0;
}

[numthreads(64, 1, 1)]
void AccumulateComponentPosterior(uint3 id : SV_DispatchThreadID)
{
    uint eventIndex = id.x; if (eventIndex >= _EventCapacity) return;
    uint ownerHandle = _CandidatePixelOwners[eventIndex];
    if (ownerHandle == 0u || ownerHandle > _CandidateCapacity) return;
    uint owner = ownerHandle - 1u; if (owner >= CandidateCount()) return;
    uint root = _CandidateParents[owner];
    ContactFilmHeader frame = _ComponentFrames[root];
    ConeEvent eventData = _ConeEvents[eventIndex];
    if (!(eventData.measuredRange > 0.0) || !isfinite(eventData.measuredRange)) return;
    uint pixelsPerEye = _Resolution.x * _Resolution.y;
    uint eye = eventIndex / pixelsPerEye;
    uint local = eventIndex - eye * pixelsPerEye;
    uint2 pixel = uint2(local % _Resolution.x, local / _Resolution.x);
    float3 ray = SafeNormalize(eye == 0u ? _DepthRayCenterLeft[pixel].xyz :
        _DepthRayCenterRight[pixel].xyz, float3(0, 0, 1));
    float3 position = mul(_ChunkFromDepth[eye],
        float4(ray * eventData.measuredRange, 1.0)).xyz;
    float3 delta = position - frame.origin;
    float U = dot(delta, frame.tangentU) / max(frame.extentU, 0.001);
    float V = dot(delta, frame.tangentV) / max(frame.extentV, 0.001);
    float z = dot(delta, frame.normal);
    if (abs(U) > 1.25 || abs(V) > 1.25 || !isfinite(z)) return;
    float basis[6] = { 1.0, U, V, U * U, U * V, V * V };
    float robust = 1.0;
    if (_PosteriorPass != 0u)
    {
        float predicted = frame.quadratic0123.x + frame.quadratic0123.y *
            (U * frame.extentU) + frame.quadratic0123.z * (V * frame.extentV) +
            frame.quadratic0123.w * U * U * frame.extentU * frame.extentU +
            frame.quadratic45.x * U * V * frame.extentU * frame.extentV +
            frame.quadratic45.y * V * V * frame.extentV * frame.extentV;
        float residual = z - predicted;
        float huber = max(_ModelResidualFloor, 2.0 * eventData.combinedSigma);
        robust = abs(residual) <= huber ? 1.0 : huber / max(abs(residual), 1e-8);
        AtomicAddPosterior(root * POSTERIOR_WORDS + 32u, residual);
        AtomicAddPosterior(root * POSTERIOR_WORDS + 33u, residual * residual);
    }
    float weight = robust * clamp(eventData.pressurePrecision /
        max(_PrecisionUnit, 1.0), 0.0, 4.0);
    uint baseWord = root * POSTERIOR_WORDS;
    [unroll] for (uint row = 0u; row < 6u; ++row)
    {
        [unroll] for (uint column = row; column < 6u; ++column)
            AtomicAddPosterior(baseWord + UpperIndex(row, column),
                weight * basis[row] * basis[column]);
        AtomicAddPosterior(baseWord + 21u + row, weight * basis[row] * z);
    }
    InterlockedAdd(_ComponentPosterior[baseWord + 27u], 1);
    AtomicAddPosterior(baseWord + 28u, weight);
    uint2 cell = min((uint2)(saturate(float2(U, V) * 0.5 + 0.5) * 8.0), 7u);
    uint bit = cell.y * 8u + cell.x;
    if (bit < 32u) InterlockedOr(_ComponentPosterior[baseWord + 29u],
        (int)(1u << bit));
    else InterlockedOr(_ComponentPosterior[baseWord + 30u],
        (int)(1u << (bit - 32u)));
    // Preserve independent sensor evidence explicitly. Continuation links may
    // consume this mask; they must never manufacture MULTIVIEW from proximity.
    InterlockedOr(_ComponentPosterior[baseWord + 34u], (int)(1u << eye));
}

[numthreads(1, 1, 1)]
void SolveComponentPosterior(uint3 id : SV_DispatchThreadID)
{
    uint ordinal = id.x; uint reps = min(_CandidateState[3], _CandidateCapacity);
    if (ordinal >= reps) return;
    uint root = _CandidateRepresentatives[ordinal]; uint baseWord = root * POSTERIOR_WORDS;
    float coefficientMatrix[36]; float rhs[6];
    [unroll] for (uint i = 0u; i < 36u; ++i) coefficientMatrix[i] = 0.0;
    [unroll] for (uint row = 0u; row < 6u; ++row)
    {
        rhs[row] = PosteriorValue(baseWord + 21u + row);
        [unroll] for (uint column = row; column < 6u; ++column)
        {
            float value = PosteriorValue(baseWord + UpperIndex(row, column));
            coefficientMatrix[row * 6u + column] = value;
            coefficientMatrix[column * 6u + row] = value;
        }
    }
    float trace = 0.0;
    [unroll] for (uint d = 0u; d < 6u; ++d)
        trace += coefficientMatrix[d * 6u + d];
    float regularizer = max(1e-7, trace * 1e-6);
    [unroll] for (uint d = 0u; d < 6u; ++d)
        coefficientMatrix[d * 6u + d] +=
            regularizer * (d >= 3u ? 4.0 : 1.0);
    float theta[6];
    if (!CholeskySolve(coefficientMatrix, rhs, theta))
    {
        InterlockedOr(_ComponentModelFlags[root], 1u);
        return;
    }
    ContactFilmHeader frame = _ComponentFrames[root];
    frame.quadratic0123 = float4(theta[0], theta[1] / frame.extentU,
        theta[2] / frame.extentV, theta[3] / (frame.extentU * frame.extentU));
    frame.quadratic45 = float2(theta[4] / (frame.extentU * frame.extentV),
        theta[5] / (frame.extentV * frame.extentV));
    frame.supportMaskLow = (uint)_ComponentPosterior[baseWord + 29u];
    frame.supportMaskHigh = (uint)_ComponentPosterior[baseWord + 30u];
    frame.supportTotal = PosteriorValue(baseWord + 28u);
    frame.revision = max(1u, frame.revision);
    _ComponentFrames[root] = frame;
    if (_PosteriorPass != 0u)
    {
        float sampleCount = max(1.0,
            (float)_ComponentPosterior[baseWord + 27u]);
        float rms = sqrt(max(0.0,
            PosteriorValue(baseWord + 33u) / sampleCount));
        if (rms > max(_ModelResidualFloor, 3.0 * frame.sigmaNormal))
            InterlockedOr(_ComponentModelFlags[root], 2u);
    }
    if (_CommitPosterior == 0u) return;
    _CandidateHeaders[root] = frame;
    uint info = root * 10u;
    [unroll] for (uint packed = 0u; packed < 21u; ++packed)
        SetInformationH(info, packed, PosteriorValue(baseWord + packed));
    [unroll] for (uint g = 0u; g < 6u; ++g)
        SetInformationG(info, g, rhs[g]);
    float4 record7 = _CandidateInformation[info + 7u];
    record7.z = (float)max(0, _ComponentPosterior[baseWord + 27u]);
    record7.w = frame.supportTotal;
    _CandidateInformation[info + 7u] = record7;
    float4 quality = _CandidateInformation[info + 8u];
    quality.x = frame.sigmaNormal; quality.y = frame.confidence;
    _CandidateInformation[info + 8u] = quality;
    float4 viewState = _CandidateInformation[info + 9u];
    viewState.x = asfloat((uint)_ComponentPosterior[baseWord + 34u]);
    _CandidateInformation[info + 9u] = viewState;
}

[numthreads(64, 1, 1)]
void EvaluateComponentModel(uint3 id : SV_DispatchThreadID)
{
    uint candidate = id.x; if (candidate >= CandidateCount()) return;
    uint root = _CandidateParents[candidate];
    ContactFilmHeader film = _CandidateHeaders[candidate];
    ContactFilmHeader frame = _ComponentFrames[root];
    if (dot(film.normal, frame.normal) < _ComponentNormalCosine)
        InterlockedOr(_ComponentModelFlags[root], 4u);
    float planeResidual = abs(dot(film.origin - frame.origin, frame.normal));
    if (planeResidual > max(_ModelResidualFloor, 4.0 * film.sigmaNormal))
        InterlockedOr(_ComponentModelFlags[root], 8u);
}

[numthreads(64, 1, 1)]
void ExpandRejectedComponents(uint3 id : SV_DispatchThreadID)
{
    uint candidate = id.x; if (candidate >= CandidateCount()) return;
    uint root = _CandidateParents[candidate];
    if (_ComponentModelFlags[root] == 0u) return;
    _CandidateParents[candidate] = candidate;
    InterlockedAdd(_CandidateState[7], 1u);
}
