#pragma kernel InitializePhotometricState
#pragma kernel ClearPhotometricFrame
#pragma kernel ClearRefinementClaims
#pragma kernel NarrowStereoPressure
#pragma kernel TemporalFocusPressure
#pragma kernel BuildPhotometricArguments
#pragma kernel BuildTemporalViewArguments
#pragma kernel SelectTemporalViews

Texture2D<float4> _RgbLeft;
Texture2D<float4> _RgbRight;
Texture2DArray<float4> _ConsensusDepth;
Texture2D<float4> _DepthRayCenterLeft;
Texture2D<float4> _DepthRayCenterRight;
Texture2DArray<float4> _TemporalRgb;

struct ConeEvent
{
    uint pixelLinear;
    uint packedPixel;
    uint classification;
    uint flags;
    float measuredRange;
    float predictedRange;
    float combinedSigma;
    float confidence;
    float3 measuredNormal;
    float boundaryEvidence;
    uint filmId;
    uint filmGeneration;
    float2 predictedUv;
    float footprintArea;
    float incidence;
    float pressurePrecision;
    uint occluderFilmId;
    uint occluderGeneration;
    float2 occluderUv;
};

struct ContactFilmHeader
{
    uint id;
    uint generation;
    uint chunkId;
    uint flags;
    float3 origin;
    float supportTotal;
    float3 normal;
    float sigmaNormal;
    float3 tangentU;
    float extentU;
    float3 tangentV;
    float extentV;
    float4 quadratic0123;
    float2 quadratic45;
    float confidence;
    float contradiction;
    uint revision;
    uint displacementPage;
    uint appearancePage;
    uint boundaryStart;
    uint boundaryCount;
    uint supportMaskLow;
    uint supportMaskHigh;
    uint reserved0;
    uint reserved1;
    uint reserved2;
};

struct PhotometricPressure
{
    uint filmId;
    uint generation;
    float2 uv;
    float normalResidual;
    float precision;
    float confidence;
    float bestCost;
    float secondCost;
    float footprintArea;
    uint sourceMask;
    uint validViews;
};

struct TemporalRgbView
{
    float4x4 rgbFromChunk;
    float4 intrinsics;
    float4 cameraOriginChunk;
    uint generation;
    uint sourceSequence;
    uint eye;
    uint active;
};

StructuredBuffer<ConeEvent> _ConeEvents;
StructuredBuffer<uint> _ClassifiedIndices;
StructuredBuffer<uint> _ClassCounters;
StructuredBuffer<ContactFilmHeader> _FilmHeaders;
StructuredBuffer<uint> _FilmAllocator;
StructuredBuffer<uint> _CanonicalActiveFilmIndices;
StructuredBuffer<uint> _KeyframeIngressState;
StructuredBuffer<uint> _KeyframeFilmGain;
RWStructuredBuffer<PhotometricPressure> _PhotometricPressures;
RWStructuredBuffer<uint> _PhotometricState;
RWStructuredBuffer<uint> _RefinementClaims;
RWStructuredBuffer<uint3> _PhotometricDispatchArguments;
RWStructuredBuffer<TemporalRgbView> _TemporalViews;
RWStructuredBuffer<uint> _FilmViewRefs;
RWStructuredBuffer<float> _FilmViewScores;
RWStructuredBuffer<uint> _FilmViewOwnerGeneration;
RWStructuredBuffer<uint3> _ViewSelectDispatchArguments;

uint _EventCapacity;
uint _FilmCapacity;
uint _PressureCapacity;
uint _TemporalViewCapacity;
uint _CurrentSequence;
uint2 _RgbResolution;
uint2 _DepthResolution;
float4 _RgbIntrinsics[2];
float4 _DepthIntrinsics[2];
float4x4 _ChunkFromDepth[2];
float4x4 _RgbFromChunk[2];
float4x4 _DepthFromChunk[2];
float _MaximumNormalSearch;
float _MinimumRefineSigma;
float _AmbiguityMargin;
float _MinimumTextureEnergy;

static const uint CLASS_MATCH = 1u;
static const uint FILM_ACTIVE = 1u;
static const uint FILM_ONE_SIDED = 2u;
static const uint VIEWS_PER_FILM = 8u;
static const uint CLAIM_WORDS_PER_FILM = 4u;
static const uint SOURCE_STEREO = 3u;
static const uint SOURCE_TEMPORAL = 4u;
static const uint KEYFRAME_CAPTURE_COUNT = 1u;
static const uint KEYFRAME_CURRENT_LEFT = 3u;
static const uint KEYFRAME_CURRENT_RIGHT = 4u;
static const uint KEYFRAME_CURRENT_GENERATION = 5u;
static const uint KEYFRAME_ACCEPTED = 6u;

float Luma(float3 rgb)
{
    return dot(rgb, float3(0.2126, 0.7152, 0.0722));
}

float4 LoadCurrentRgb(int2 pixel, uint eye)
{
    pixel = clamp(pixel, int2(0, 0), (int2)_RgbResolution - 1);
    if (eye == 0u) return _RgbLeft.Load(int3(pixel, 0));
    return _RgbRight.Load(int3(pixel, 0));
}

float CurrentLuma(float2 pixel, uint eye)
{
    float2 bounded = clamp(pixel, 0.0, (float2)_RgbResolution - 1.001);
    int2 basePixel = (int2)floor(bounded);
    float2 fraction = bounded - (float2)basePixel;
    float l00 = Luma(LoadCurrentRgb(basePixel, eye).rgb);
    float l10 = Luma(LoadCurrentRgb(basePixel + int2(1, 0), eye).rgb);
    float l01 = Luma(LoadCurrentRgb(basePixel + int2(0, 1), eye).rgb);
    float l11 = Luma(LoadCurrentRgb(basePixel + int2(1, 1), eye).rgb);
    return lerp(lerp(l00, l10, fraction.x),
        lerp(l01, l11, fraction.x), fraction.y);
}

float TemporalLuma(float2 pixel, uint viewIndex)
{
    float2 bounded = clamp(pixel, 0.0, (float2)_RgbResolution - 1.001);
    int2 basePixel = (int2)floor(bounded);
    float2 fraction = bounded - (float2)basePixel;
    float l00 = Luma(_TemporalRgb.Load(int4(basePixel, viewIndex, 0)).rgb);
    float l10 = Luma(_TemporalRgb.Load(int4(basePixel + int2(1, 0),
        viewIndex, 0)).rgb);
    float l01 = Luma(_TemporalRgb.Load(int4(basePixel + int2(0, 1),
        viewIndex, 0)).rgb);
    float l11 = Luma(_TemporalRgb.Load(int4(basePixel + int2(1, 1),
        viewIndex, 0)).rgb);
    return lerp(lerp(l00, l10, fraction.x),
        lerp(l01, l11, fraction.x), fraction.y);
}

bool ProjectPoint(float3 pointChunk, float4x4 cameraFromChunk,
    float4 intrinsics, out float2 pixel, out float rangeMeters)
{
    float3 pointCamera = mul(cameraFromChunk, float4(pointChunk, 1.0)).xyz;
    rangeMeters = length(pointCamera);
    if (pointCamera.z <= 1e-5 || !all(isfinite(pointCamera)))
    {
        pixel = 0.0;
        return false;
    }
    pixel = float2(pointCamera.x / pointCamera.z * intrinsics.x + intrinsics.z,
        pointCamera.y / pointCamera.z * intrinsics.y + intrinsics.w);
    return all(pixel >= 2.0) && all(pixel < (float2)_RgbResolution - 3.0);
}

bool ProjectCurrentRgb(float3 pointChunk, uint eye, out float2 pixel,
    out float rangeMeters)
{
    if (eye == 0u)
        return ProjectPoint(pointChunk, _RgbFromChunk[0], _RgbIntrinsics[0],
            pixel, rangeMeters);
    return ProjectPoint(pointChunk, _RgbFromChunk[1], _RgbIntrinsics[1],
        pixel, rangeMeters);
}

bool ProjectTemporalRgb(float3 pointChunk, uint viewIndex, out float2 pixel,
    out float rangeMeters)
{
    if (viewIndex >= _TemporalViewCapacity)
    {
        pixel = 0.0;
        rangeMeters = 0.0;
        return false;
    }
    TemporalRgbView viewData = _TemporalViews[viewIndex];
    if (viewData.active == 0u) return false;
    return ProjectPoint(pointChunk, viewData.rgbFromChunk,
        viewData.intrinsics, pixel, rangeMeters);
}

float3 LoadDepthRay(uint2 pixel, uint eye)
{
    if (eye == 0u) return _DepthRayCenterLeft[pixel].xyz;
    return _DepthRayCenterRight[pixel].xyz;
}

bool DepthFirstHitCompatible(float3 pointChunk, uint sourceEye,
    float expectedSigma)
{
    uint agreeingEyes = 0u;
    [unroll]
    for (uint eye = 0u; eye < 2u; ++eye)
    {
        float3 pointDepth = mul(_DepthFromChunk[eye],
            float4(pointChunk, 1.0)).xyz;
        if (pointDepth.z <= 1e-5) continue;
        float4 intrinsics = _DepthIntrinsics[eye];
        int2 pixel = (int2)floor(float2(
            pointDepth.x / pointDepth.z * intrinsics.x + intrinsics.z,
            pointDepth.y / pointDepth.z * intrinsics.y + intrinsics.w));
        if (any(pixel < 0) || any(pixel >= (int2)_DepthResolution)) continue;
        float4 measured = _ConsensusDepth[uint3((uint2)pixel, eye)];
        if (measured.x <= 0.0) continue;
        float candidateRange = length(pointDepth);
        float gate = 3.0 * sqrt(expectedSigma * expectedSigma +
            measured.z * measured.z) + 0.002;
        float residual = candidateRange - measured.x;
        // A candidate behind a nearer first hit is occluded. A candidate clearly in
        // measured free space is equally invalid. Neither may exert film pressure.
        if (abs(residual) > gate)
        {
            if (eye == sourceEye) return false;
            continue;
        }
        agreeingEyes++;
    }
    return agreeingEyes > 0u;
}

float DescriptorCostCurrent(float2 leftPixel, float2 rightPixel,
    out float textureEnergy)
{
    static const int2 offsets[8] = {
        int2(-2, 0), int2(2, 0), int2(0, -2), int2(0, 2),
        int2(-1, -1), int2(1, -1), int2(-1, 1), int2(1, 1)
    };
    float leftCenter = CurrentLuma(leftPixel, 0u);
    float rightCenter = CurrentLuma(rightPixel, 1u);
    float census = 0.0;
    [unroll]
    for (uint sampleIndex = 0u; sampleIndex < 8u; ++sampleIndex)
    {
        float leftNeighbour = CurrentLuma(leftPixel + offsets[sampleIndex], 0u);
        float rightNeighbour = CurrentLuma(rightPixel + offsets[sampleIndex], 1u);
        bool leftBit = leftNeighbour > leftCenter;
        bool rightBit = rightNeighbour > rightCenter;
        census += leftBit == rightBit ? 0.0 : 1.0;
    }
    census *= 0.125;
    float2 leftGradient = float2(
        CurrentLuma(leftPixel + float2(1, 0), 0u) -
            CurrentLuma(leftPixel - float2(1, 0), 0u),
        CurrentLuma(leftPixel + float2(0, 1), 0u) -
            CurrentLuma(leftPixel - float2(0, 1), 0u));
    float2 rightGradient = float2(
        CurrentLuma(rightPixel + float2(1, 0), 1u) -
            CurrentLuma(rightPixel - float2(1, 0), 1u),
        CurrentLuma(rightPixel + float2(0, 1), 1u) -
            CurrentLuma(rightPixel - float2(0, 1), 1u));
    float leftEnergy = length(leftGradient);
    float rightEnergy = length(rightGradient);
    textureEnergy = min(leftEnergy, rightEnergy);
    float directionCost = 0.5;
    if (leftEnergy > 1e-5 && rightEnergy > 1e-5)
        directionCost = 0.5 * (1.0 - dot(leftGradient / leftEnergy,
            rightGradient / rightEnergy));
    float magnitudeCost = abs(log2((leftEnergy + 0.01) /
        (rightEnergy + 0.01))) * 0.2;
    return saturate(0.6 * census + 0.4 *
        min(1.0, directionCost + magnitudeCost));
}

bool StereoCandidateCost(float3 pointChunk, out float cost,
    out float textureEnergy)
{
    float2 leftPixel, rightPixel;
    float leftRange, rightRange;
    if (!ProjectCurrentRgb(pointChunk, 0u, leftPixel, leftRange) ||
        !ProjectCurrentRgb(pointChunk, 1u, rightPixel, rightRange))
    {
        cost = 1.0;
        textureEnergy = 0.0;
        return false;
    }
    cost = DescriptorCostCurrent(leftPixel, rightPixel, textureEnergy);
    return isfinite(cost);
}

float DescriptorCostTemporal(float2 currentPixel, uint currentEye,
    float2 historicalPixel, uint historicalView, out float textureEnergy)
{
    static const int2 offsets[8] = {
        int2(-2, 0), int2(2, 0), int2(0, -2), int2(0, 2),
        int2(-1, -1), int2(1, -1), int2(-1, 1), int2(1, 1)
    };
    float currentCenter = CurrentLuma(currentPixel, currentEye);
    float historyCenter = TemporalLuma(historicalPixel, historicalView);
    float census = 0.0;
    [unroll]
    for (uint sampleIndex = 0u; sampleIndex < 8u; ++sampleIndex)
    {
        float currentNeighbour = CurrentLuma(currentPixel + offsets[sampleIndex],
            currentEye);
        float historyNeighbour = TemporalLuma(historicalPixel + offsets[sampleIndex],
            historicalView);
        bool currentBit = currentNeighbour > currentCenter;
        bool historyBit = historyNeighbour > historyCenter;
        census += currentBit == historyBit ? 0.0 : 1.0;
    }
    census *= 0.125;
    float2 currentGradient = float2(
        CurrentLuma(currentPixel + float2(1, 0), currentEye) -
            CurrentLuma(currentPixel - float2(1, 0), currentEye),
        CurrentLuma(currentPixel + float2(0, 1), currentEye) -
            CurrentLuma(currentPixel - float2(0, 1), currentEye));
    float2 historyGradient = float2(
        TemporalLuma(historicalPixel + float2(1, 0), historicalView) -
            TemporalLuma(historicalPixel - float2(1, 0), historicalView),
        TemporalLuma(historicalPixel + float2(0, 1), historicalView) -
            TemporalLuma(historicalPixel - float2(0, 1), historicalView));
    float currentEnergy = length(currentGradient);
    float historyEnergy = length(historyGradient);
    textureEnergy = min(currentEnergy, historyEnergy);
    float directionCost = 0.5;
    if (currentEnergy > 1e-5 && historyEnergy > 1e-5)
        directionCost = 0.5 * (1.0 - dot(currentGradient / currentEnergy,
            historyGradient / historyEnergy));
    float magnitudeCost = abs(log2((currentEnergy + 0.01) /
        (historyEnergy + 0.01))) * 0.2;
    return saturate(0.6 * census + 0.4 *
        min(1.0, directionCost + magnitudeCost));
}

bool DecodeViewReference(uint packedReference, out uint viewIndex,
    out uint generation)
{
    uint encodedIndex = packedReference & 0xffu;
    viewIndex = encodedIndex == 0u ? 0u : encodedIndex - 1u;
    generation = packedReference >> 8u;
    if (encodedIndex == 0u || viewIndex >= _TemporalViewCapacity) return false;
    TemporalRgbView viewData = _TemporalViews[viewIndex];
    return viewData.active != 0u &&
        (viewData.generation & 0x00ffffffu) == generation;
}

bool TemporalCandidateCost(float3 pointChunk, uint filmIndex, uint currentEye,
    out float cost, out float textureEnergy, out uint validViews)
{
    float2 currentPixel;
    float currentRange;
    if (!ProjectCurrentRgb(pointChunk, currentEye, currentPixel, currentRange))
    {
        cost = 1.0;
        textureEnergy = 0.0;
        validViews = 0u;
        return false;
    }
    float costSum = 0.0;
    float energySum = 0.0;
    validViews = 0u;
    uint referenceBase = filmIndex * VIEWS_PER_FILM;
    [loop]
    for (uint referenceIndex = 0u; referenceIndex < VIEWS_PER_FILM;
        ++referenceIndex)
    {
        uint viewIndex, generation;
        if (!DecodeViewReference(_FilmViewRefs[referenceBase + referenceIndex],
                viewIndex, generation)) continue;
        TemporalRgbView viewData = _TemporalViews[viewIndex];
        if (viewData.sourceSequence == _CurrentSequence) continue;
        float2 historicalPixel;
        float historicalRange;
        if (!ProjectTemporalRgb(pointChunk, viewIndex, historicalPixel,
                historicalRange)) continue;
        float localEnergy;
        float localCost = DescriptorCostTemporal(currentPixel, currentEye,
            historicalPixel, viewIndex, localEnergy);
        // Truncation keeps one lighting/outlier view from steering the film.
        costSum += min(localCost, 0.65);
        energySum += localEnergy;
        validViews++;
    }
    if (validViews < 2u)
    {
        cost = 1.0;
        textureEnergy = 0.0;
        return false;
    }
    cost = costSum / (float)validViews;
    textureEnergy = energySum / (float)validViews;
    return isfinite(cost);
}

void EmitPressure(ConeEvent eventData, float correction, float bestCost,
    float secondCost, float textureEnergy, uint sourceMask, uint validViews)
{
    float ambiguity = saturate((secondCost - bestCost) /
        max(secondCost, 0.05));
    float focusConfidence = saturate(ambiguity /
        max(_AmbiguityMargin, 1e-4)) * exp2(-4.0 * bestCost);
    float textureConfidence = saturate(textureEnergy /
        max(_MinimumTextureEnergy, 1e-4));
    float confidence = saturate(eventData.confidence) * focusConfidence *
        textureConfidence;
    if (confidence <= 0.05 || !isfinite(correction)) return;

    // Cone precision already includes range, footprint and incidence. Photometric
    // focus may sharpen it, but cannot detach from that physical evidence; therefore
    // a distant/grazing view cannot overpower a close compressed film posterior.
    float precisionBoost = lerp(0.5, 4.0, confidence);
    float precision = max(0.0, eventData.pressurePrecision) * precisionBoost;
    if (!isfinite(precision) || precision <= 0.0) return;

    uint pressureIndex;
    InterlockedAdd(_PhotometricState[0], 1u, pressureIndex);
    if (pressureIndex >= _PressureCapacity)
    {
        InterlockedAdd(_PhotometricState[1], 1u);
        return;
    }
    PhotometricPressure pressure;
    pressure.filmId = eventData.filmId;
    pressure.generation = eventData.filmGeneration;
    pressure.uv = saturate(eventData.predictedUv);
    pressure.normalResidual = correction;
    pressure.precision = precision;
    pressure.confidence = confidence;
    pressure.bestCost = bestCost;
    pressure.secondCost = secondCost;
    pressure.footprintArea = max(eventData.footprintArea, 1e-12);
    pressure.sourceMask = sourceMask;
    pressure.validViews = validViews;
    _PhotometricPressures[pressureIndex] = pressure;
    InterlockedAdd(_PhotometricState[sourceMask == SOURCE_STEREO ? 2u : 3u], 1u);
}

[numthreads(64, 1, 1)]
void InitializePhotometricState(uint3 id : SV_DispatchThreadID)
{
    uint linearIndex = id.x;
    if (linearIndex < _FilmCapacity * VIEWS_PER_FILM)
    {
        _FilmViewRefs[linearIndex] = 0u;
        _FilmViewScores[linearIndex] = 0.0;
    }
    if (linearIndex < _FilmCapacity)
        _FilmViewOwnerGeneration[linearIndex] = 0u;
    if (linearIndex < _TemporalViewCapacity)
    {
        TemporalRgbView emptyView;
        emptyView.rgbFromChunk = 0.0;
        emptyView.intrinsics = 0.0;
        emptyView.cameraOriginChunk = 0.0;
        emptyView.generation = 0u;
        emptyView.sourceSequence = 0u;
        emptyView.eye = 0u;
        emptyView.active = 0u;
        _TemporalViews[linearIndex] = emptyView;
    }
    if (linearIndex == 0u)
    {
        [unroll] for (uint stateIndex = 0u; stateIndex < 4u; ++stateIndex)
            _PhotometricState[stateIndex] = 0u;
        _PhotometricDispatchArguments[0] = uint3(0u, 1u, 1u);
        _ViewSelectDispatchArguments[0] = uint3(0u, 1u, 1u);
    }
}

[numthreads(1, 1, 1)]
void ClearPhotometricFrame(uint3 id : SV_DispatchThreadID)
{
    [unroll] for (uint stateIndex = 0u; stateIndex < 4u; ++stateIndex)
        _PhotometricState[stateIndex] = 0u;
    _PhotometricDispatchArguments[0] = uint3(0u, 1u, 1u);
}

[numthreads(64, 1, 1)]
void ClearRefinementClaims(uint3 id : SV_DispatchThreadID)
{
    uint capacity = _FilmCapacity * CLAIM_WORDS_PER_FILM;
    if (id.x < capacity) _RefinementClaims[id.x] = 0u;
}

bool ClaimSurfaceCell(uint filmIndex, float2 uv, uint passIndex)
{
    uint2 cell = min((uint2)(saturate(uv) * 8.0), uint2(7u, 7u));
    uint linearCell = cell.y * 8u + cell.x;
    uint word = passIndex * 2u + (linearCell >> 5u);
    uint bit = 1u << (linearCell & 31u);
    uint previous;
    InterlockedOr(_RefinementClaims[
        filmIndex * CLAIM_WORDS_PER_FILM + word], bit, previous);
    return (previous & bit) == 0u;
}

[numthreads(64, 1, 1)]
void NarrowStereoPressure(uint3 id : SV_DispatchThreadID)
{
    uint matchCount = min(_ClassCounters[CLASS_MATCH], _EventCapacity);
    if (id.x >= matchCount) return;
    uint eventIndex = _ClassifiedIndices[CLASS_MATCH * _EventCapacity + id.x];
    ConeEvent eventData = _ConeEvents[eventIndex];
    if (eventData.classification != CLASS_MATCH || eventData.filmId == 0u ||
        eventData.predictedRange <= 0.0 || eventData.pressurePrecision <= 0.0)
        return;
    uint2 depthPixel = uint2(eventData.packedPixel & 0xffffu,
        (eventData.packedPixel >> 16u) & 0x7fffu);
    uint phase = (depthPixel.x & 1u) | ((depthPixel.y & 1u) << 1u);
    if (phase != (_CurrentSequence & 3u)) return;
    uint depthEye = eventData.packedPixel >> 31u;
    uint filmIndex = eventData.filmId - 1u;
    if (filmIndex >= _FilmCapacity) return;
    ContactFilmHeader film = _FilmHeaders[filmIndex];
    if (film.id != eventData.filmId || film.generation != eventData.filmGeneration ||
        (film.flags & (FILM_ACTIVE | FILM_ONE_SIDED)) !=
            (FILM_ACTIVE | FILM_ONE_SIDED)) return;
    if (film.sigmaNormal <= _MinimumRefineSigma && film.confidence >= 0.97)
        return;
    if (!ClaimSurfaceCell(filmIndex, eventData.predictedUv, 0u)) return;

    float3 depthContact = LoadDepthRay(depthPixel, depthEye) *
        eventData.predictedRange;
    float3 basePoint = mul(_ChunkFromDepth[depthEye],
        float4(depthContact, 1.0)).xyz;
    float3 normal = normalize(film.normal);
    float3 depthOrigin = mul(_ChunkFromDepth[depthEye],
        float4(0.0, 0.0, 0.0, 1.0)).xyz;
    if (dot(normal, depthOrigin - basePoint) <= 0.0) return;

    float searchRadius = min(_MaximumNormalSearch,
        max(3.0 * max(film.sigmaNormal, eventData.combinedSigma), 0.0015));
    float coarseStep = searchRadius * 0.25;
    float bestCost = 1e9;
    float secondCost = 1e9;
    float bestCorrection = 0.0;
    float bestEnergy = 0.0;
    [loop]
    for (int candidateIndex = -4; candidateIndex <= 4; ++candidateIndex)
    {
        float correction = (float)candidateIndex * coarseStep;
        float candidateCost, candidateEnergy;
        if (!StereoCandidateCost(basePoint + normal * correction,
                candidateCost, candidateEnergy)) continue;
        if (candidateCost < bestCost)
        {
            secondCost = bestCost;
            bestCost = candidateCost;
            bestCorrection = correction;
            bestEnergy = candidateEnergy;
        }
        else if (candidateCost < secondCost) secondCost = candidateCost;
    }
    float fineStep = max(0.00015, coarseStep * 0.25);
    [loop]
    for (int fineIndex = -2; fineIndex <= 2; ++fineIndex)
    {
        float correction = clamp(bestCorrection + (float)fineIndex * fineStep,
            -searchRadius, searchRadius);
        float candidateCost, candidateEnergy;
        if (!StereoCandidateCost(basePoint + normal * correction,
                candidateCost, candidateEnergy)) continue;
        if (candidateCost < bestCost)
        {
            secondCost = bestCost;
            bestCost = candidateCost;
            bestCorrection = correction;
            bestEnergy = candidateEnergy;
        }
        else if (candidateCost < secondCost &&
            abs(correction - bestCorrection) > fineStep * 0.5)
            secondCost = candidateCost;
    }
    float minusCost, plusCost, unusedEnergy;
    bool hasMinus = StereoCandidateCost(basePoint + normal *
        (bestCorrection - fineStep), minusCost, unusedEnergy);
    bool hasPlus = StereoCandidateCost(basePoint + normal *
        (bestCorrection + fineStep), plusCost, unusedEnergy);
    if (hasMinus && hasPlus)
    {
        float curvature = minusCost - 2.0 * bestCost + plusCost;
        if (curvature > 1e-5)
            bestCorrection += clamp(0.5 * (minusCost - plusCost) /
                curvature, -1.0, 1.0) * fineStep;
    }
    if (bestEnergy < _MinimumTextureEnergy ||
        secondCost - bestCost < _AmbiguityMargin * max(secondCost, 0.05) ||
        !DepthFirstHitCompatible(basePoint + normal * bestCorrection,
            depthEye, eventData.combinedSigma)) return;
    EmitPressure(eventData, bestCorrection, bestCost, secondCost, bestEnergy,
        SOURCE_STEREO, 2u);
}

[numthreads(64, 1, 1)]
void TemporalFocusPressure(uint3 id : SV_DispatchThreadID)
{
    if (_KeyframeIngressState[KEYFRAME_CAPTURE_COUNT] == 0u) return;
    uint matchCount = min(_ClassCounters[CLASS_MATCH], _EventCapacity);
    if (id.x >= matchCount) return;
    uint eventIndex = _ClassifiedIndices[CLASS_MATCH * _EventCapacity + id.x];
    ConeEvent eventData = _ConeEvents[eventIndex];
    if (eventData.classification != CLASS_MATCH || eventData.filmId == 0u ||
        eventData.predictedRange <= 0.0 || eventData.pressurePrecision <= 0.0)
        return;
    uint2 depthPixel = uint2(eventData.packedPixel & 0xffffu,
        (eventData.packedPixel >> 16u) & 0x7fffu);
    uint phase = (depthPixel.x & 3u) | ((depthPixel.y & 3u) << 2u);
    if (phase != (_CurrentSequence & 15u)) return;
    uint depthEye = eventData.packedPixel >> 31u;
    uint filmIndex = eventData.filmId - 1u;
    if (filmIndex >= _FilmCapacity) return;
    ContactFilmHeader film = _FilmHeaders[filmIndex];
    if (film.id != eventData.filmId || film.generation != eventData.filmGeneration ||
        _FilmViewOwnerGeneration[filmIndex] != film.generation ||
        (film.flags & (FILM_ACTIVE | FILM_ONE_SIDED)) !=
            (FILM_ACTIVE | FILM_ONE_SIDED)) return;
    if (film.sigmaNormal <= _MinimumRefineSigma && film.confidence >= 0.985)
        return;
    if (!ClaimSurfaceCell(filmIndex, eventData.predictedUv, 1u)) return;

    float3 depthContact = LoadDepthRay(depthPixel, depthEye) *
        eventData.predictedRange;
    float3 basePoint = mul(_ChunkFromDepth[depthEye],
        float4(depthContact, 1.0)).xyz;
    float3 normal = normalize(film.normal);
    float searchRadius = min(_MaximumNormalSearch,
        max(3.0 * max(film.sigmaNormal, eventData.combinedSigma), 0.0015));
    float coarseStep = searchRadius * 0.25;
    float bestCost = 1e9;
    float secondCost = 1e9;
    float bestCorrection = 0.0;
    float bestEnergy = 0.0;
    uint bestValidViews = 0u;
    [loop]
    for (int candidateIndex = -4; candidateIndex <= 4; ++candidateIndex)
    {
        float correction = (float)candidateIndex * coarseStep;
        float candidateCost, candidateEnergy;
        uint candidateViews;
        if (!TemporalCandidateCost(basePoint + normal * correction, filmIndex,
                depthEye, candidateCost, candidateEnergy, candidateViews)) continue;
        if (candidateCost < bestCost)
        {
            secondCost = bestCost;
            bestCost = candidateCost;
            bestCorrection = correction;
            bestEnergy = candidateEnergy;
            bestValidViews = candidateViews;
        }
        else if (candidateCost < secondCost) secondCost = candidateCost;
    }
    float fineStep = max(0.00015, coarseStep * 0.25);
    [loop]
    for (int fineIndex = -2; fineIndex <= 2; ++fineIndex)
    {
        float correction = clamp(bestCorrection + (float)fineIndex * fineStep,
            -searchRadius, searchRadius);
        float candidateCost, candidateEnergy;
        uint candidateViews;
        if (!TemporalCandidateCost(basePoint + normal * correction, filmIndex,
                depthEye, candidateCost, candidateEnergy, candidateViews)) continue;
        if (candidateCost < bestCost)
        {
            secondCost = bestCost;
            bestCost = candidateCost;
            bestCorrection = correction;
            bestEnergy = candidateEnergy;
            bestValidViews = candidateViews;
        }
        else if (candidateCost < secondCost &&
            abs(correction - bestCorrection) > fineStep * 0.5)
            secondCost = candidateCost;
    }
    float minusCost, plusCost, unusedEnergy;
    uint unusedViews;
    bool hasMinus = TemporalCandidateCost(basePoint + normal *
        (bestCorrection - fineStep), filmIndex, depthEye, minusCost,
        unusedEnergy, unusedViews);
    bool hasPlus = TemporalCandidateCost(basePoint + normal *
        (bestCorrection + fineStep), filmIndex, depthEye, plusCost,
        unusedEnergy, unusedViews);
    if (hasMinus && hasPlus)
    {
        float curvature = minusCost - 2.0 * bestCost + plusCost;
        if (curvature > 1e-5)
            bestCorrection += clamp(0.5 * (minusCost - plusCost) /
                curvature, -1.0, 1.0) * fineStep;
    }
    if (bestValidViews < 2u || bestEnergy < _MinimumTextureEnergy ||
        secondCost - bestCost < _AmbiguityMargin * max(secondCost, 0.05) ||
        !DepthFirstHitCompatible(basePoint + normal * bestCorrection,
            depthEye, eventData.combinedSigma)) return;
    EmitPressure(eventData, bestCorrection, bestCost, secondCost, bestEnergy,
        SOURCE_TEMPORAL, bestValidViews + 1u);
}

[numthreads(1, 1, 1)]
void BuildPhotometricArguments(uint3 id : SV_DispatchThreadID)
{
    uint pressureCount = min(_PhotometricState[0], _PressureCapacity);
    _PhotometricDispatchArguments[0] = uint3((pressureCount + 63u) / 64u,
        1u, 1u);
}

[numthreads(1, 1, 1)]
void BuildTemporalViewArguments(uint3 id : SV_DispatchThreadID)
{
    uint filmCount = min(_FilmAllocator[6], _FilmCapacity);
    _ViewSelectDispatchArguments[0] = _KeyframeIngressState[KEYFRAME_ACCEPTED] != 0u ?
        uint3((filmCount + 63u) / 64u, 1u, 1u) : uint3(0u, 1u, 1u);
}

float ViewInformationScore(ContactFilmHeader film, TemporalRgbView candidate,
    uint referenceBase)
{
    float3 surfacePoint = film.origin + film.normal * film.quadratic0123.x;
    float3 toCamera = candidate.cameraOriginChunk.xyz - surfacePoint;
    float distanceSquared = dot(toCamera, toCamera);
    if (distanceSquared <= 1e-6) return 0.0;
    float3 direction = toCamera * rsqrt(distanceSquared);
    float frontality = dot(normalize(film.normal), direction);
    if (frontality <= 0.15) return 0.0;
    float projectedArea = candidate.intrinsics.x * candidate.intrinsics.y *
        max(film.extentU * film.extentV * 4.0, 1e-6) * frontality /
        distanceSquared;
    float closestDirection = -1.0;
    [loop]
    for (uint referenceIndex = 0u; referenceIndex < VIEWS_PER_FILM;
        ++referenceIndex)
    {
        uint existingIndex, existingGeneration;
        if (!DecodeViewReference(_FilmViewRefs[referenceBase + referenceIndex],
                existingIndex, existingGeneration)) continue;
        TemporalRgbView existing = _TemporalViews[existingIndex];
        float3 existingDirection = normalize(existing.cameraOriginChunk.xyz -
            surfacePoint);
        closestDirection = max(closestDirection, dot(direction, existingDirection));
    }
    float angularNovelty = closestDirection < -0.5 ? 1.0 :
        saturate((1.0 - closestDirection) / 0.12);
    // Keep some high-resolution frontal revisits even when the angle is similar.
    return projectedArea * frontality * frontality *
        lerp(0.25, 1.0, angularNovelty);
}

void InsertViewForFilm(uint filmIndex, ContactFilmHeader film, uint viewIndex,
    uint acceptedGeneration)
{
    if (viewIndex >= _TemporalViewCapacity) return;
    TemporalRgbView candidate = _TemporalViews[viewIndex];
    if (candidate.active == 0u ||
        candidate.generation != acceptedGeneration) return;
    uint referenceBase = filmIndex * VIEWS_PER_FILM;
    float candidateScore = ViewInformationScore(film, candidate, referenceBase);
    if (candidateScore <= 0.0 || !isfinite(candidateScore)) return;

    uint destination = 0xffffffffu;
    float weakestScore = 1e30;
    [unroll]
    for (uint referenceIndex = 0u; referenceIndex < VIEWS_PER_FILM;
        ++referenceIndex)
    {
        uint existingIndex, existingGeneration;
        uint address = referenceBase + referenceIndex;
        if (!DecodeViewReference(_FilmViewRefs[address], existingIndex,
                existingGeneration))
        {
            destination = referenceIndex;
            break;
        }
        float score = _FilmViewScores[address];
        if (score < weakestScore)
        {
            weakestScore = score;
            destination = referenceIndex;
        }
    }
    if (destination == 0xffffffffu ||
        (weakestScore < 1e29 && candidateScore <= weakestScore * 1.05)) return;
    uint packedGeneration = candidate.generation & 0x00ffffffu;
    _FilmViewRefs[referenceBase + destination] =
        (packedGeneration << 8u) | (viewIndex + 1u);
    _FilmViewScores[referenceBase + destination] = candidateScore;
}

[numthreads(64, 1, 1)]
void SelectTemporalViews(uint3 id : SV_DispatchThreadID)
{
    if (_KeyframeIngressState[KEYFRAME_ACCEPTED] == 0u) return;
    uint filmCount = min(_FilmAllocator[6], _FilmCapacity);
    uint activeOrdinal = id.x;
    if (activeOrdinal >= filmCount) return;
    uint filmIndex = _CanonicalActiveFilmIndices[activeOrdinal];
    if (filmIndex >= _FilmCapacity || _KeyframeFilmGain[filmIndex] == 0u) return;
    ContactFilmHeader film = _FilmHeaders[filmIndex];
    if ((film.flags & (FILM_ACTIVE | FILM_ONE_SIDED)) !=
        (FILM_ACTIVE | FILM_ONE_SIDED) || film.id != filmIndex + 1u) return;
    uint referenceBase = filmIndex * VIEWS_PER_FILM;
    if (_FilmViewOwnerGeneration[filmIndex] != film.generation)
    {
        [unroll]
        for (uint referenceIndex = 0u; referenceIndex < VIEWS_PER_FILM;
            ++referenceIndex)
        {
            _FilmViewRefs[referenceBase + referenceIndex] = 0u;
            _FilmViewScores[referenceBase + referenceIndex] = 0.0;
        }
        _FilmViewOwnerGeneration[filmIndex] = film.generation;
    }
    uint acceptedGeneration =
        _KeyframeIngressState[KEYFRAME_CURRENT_GENERATION];
    InsertViewForFilm(filmIndex, film,
        _KeyframeIngressState[KEYFRAME_CURRENT_LEFT], acceptedGeneration);
    InsertViewForFilm(filmIndex, film,
        _KeyframeIngressState[KEYFRAME_CURRENT_RIGHT], acceptedGeneration);
}
