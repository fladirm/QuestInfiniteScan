struct ContactFilmHeader
{
    uint id;
    uint generation;
    uint chunkId;
    uint flags;
    float3 origin;
    float supportTotal;
    float3 normal;
    float sigmaNormal;
    float3 tangentU;
    float extentU;
    float3 tangentV;
    float extentV;
    float4 quadratic0123;
    float2 quadratic45;
    float confidence;
    float contradiction;
    uint revision;
    uint displacementPage;
    uint appearancePage;
    uint boundaryStart;
    uint boundaryCount;
    uint supportMaskLow;
    uint supportMaskHigh;
    uint reserved0;
    uint reserved1;
    uint reserved2;
};

struct ContactMeshletVertex
{
    float3 position;
    uint filmId;
    float3 normal;
    uint generation;
    float2 uv;
    float sigma;
    float confidence;
    uint sidedness;
    uint flags;
    uint appearancePage;
    uint coverageBits;
    uint boundarySampleId;
    uint reserved;
};

struct ContactMeshletDescriptor
{
    uint filmId;
    uint generation;
    uint vertexBase;
    uint maximumSegments;
    float3 center;
    float radius;
    float4 uvBounds;
    float geometricError;
    float detailFootprint;
    float confidence;
    uint appearancePage;
    uint flags;
    uint sourceIndexBase;
    uint sourceIndexCount;
    uint reserved;
};

struct ContactBoundaryHeader
{
    uint id;
    uint generation;
    uint chunkId;
    uint flags;
    uint filmA;
    uint filmAGeneration;
    uint filmB;
    uint filmBGeneration;
    float4 controlUv01;
    float4 controlUv23;
    float sigma;
    float support;
    float confidence;
    float contradiction;
    uint revision;
    uint cellKey;
    uint viewBinMask;
    uint lastSeenSequence;
};

struct FilmMembership
{
    uint filmId; uint filmGeneration; uint manifoldId; uint manifoldGeneration;
    uint firstLink; uint linkCount; uint firstFrontier; uint frontierCount;
    uint flags; uint revision;
};

struct ManifoldLink
{
    uint id; uint generation; uint manifoldId; uint manifoldGeneration;
    uint filmA; uint filmAGeneration; uint filmB; uint filmBGeneration;
    uint type; uint flags; uint boundaryId; uint revision;
    float4 uvA01; float4 uvB01;
    float sigma; float support; float confidence; float reserved;
};

struct ManifoldLinkIncidence
{
    uint id; uint generation; uint linkId; uint linkGeneration;
    uint filmId; uint filmGeneration; uint nextId; uint nextGeneration;
    uint endpoint; uint flags;
};

struct BoundaryHashEntry
{
    uint hash;
    uint filmId;
    uint filmGeneration;
    uint cellKey;
    uint boundaryId;
};

struct DisplacementPageHeader
{
    uint id;
    uint generation;
    uint filmId;
    uint filmGeneration;
    uint level;
    uint parentPage;
    uint parentCell;
    uint flags;
    float4 uvBounds;
    uint bestFootprintBits;
    uint maximumVarianceBits;
    uint supportFixed;
    uint revision;
};

struct DisplacementCell
{
    float displacement;
    float sigma;
    float support;
    float coverage;
    float bestPrecision;
    float bestFootprint;
    float residualVariance;
    float preHitPressure;
    uint preHitPressureViewMask;
    uint revision;
};

struct MeshletBuildPlan
{
    uint filmIndex;
    uint segments;
    uint rowVertices;
    uint vertexCount;
    uint triangleCount;
    uint indexCount;
    uint descriptorCount;
    uint valid;
    uint vertexOffset;
    uint indexOffset;
    uint descriptorOffset;
    uint reserved0;
    uint measuredIndexCount;
    uint latentIndexCount;
    uint reserved1;
    uint reserved2;
};

struct FilmMeshletRange
{
    uint filmId; uint filmGeneration; uint filmRevision; uint flags;
    uint vertexOffset; uint vertexCapacity;
    uint indexOffset; uint indexCapacity;
    uint descriptorOffset; uint descriptorCapacity;
    uint maximumSegments; uint reserved;
};

struct FilmSlotState
{
    uint generation; uint activeOrdinal; uint nextFree; uint flags;
};

