static const uint FILM_ACTIVE = 1u;
static const uint FILM_DIRTY_GEOMETRY = 1u << 3u;
static const uint FILM_DIRTY_MESHLET = 1u << 4u;
static const uint SLOT_DIRTY = 1u << 2u;
static const uint BOUNDARY_ACTIVE = 1u;
static const uint BOUNDARY_PERSISTENT = 8u;
static const uint BOUNDARY_CACHE_ACTIVE = 1u;
// Derived ABI. Never alias or copy ContactFilm lifecycle bits into these values.
static const uint VERTEX_MEASURED_CONTACT = 1u << 0u;
static const uint VERTEX_BOUNDARY = 1u << 1u;
static const uint VERTEX_LATENT_CONNECTOR = 1u << 2u;
static const uint VERTEX_LATENT_FRONTIER = 1u << 3u;
static const uint MESHLET_MEASURED_SURFACE = 1u << 0u;
static const uint MESHLET_HAS_BOUNDARY = 1u << 1u;
static const uint MESHLET_EXACT_TOPOLOGY = 1u << 2u;
static const uint MESHLET_LATENT_CONNECTOR = 1u << 3u;
static const uint MESHLET_LATENT_FRONTIER = 1u << 4u;
static const uint EVIDENCE_COMMITTABLE = 1u << 8u;
static const uint CONTOUR_PAGE_ACTIVE = 1u;
static const uint CONTOUR_ACTIVE = 1u;
static const uint CONTOUR_MEASURED = 1u << 1u;
static const uint CONTOUR_SEGMENTS_PER_PAGE = 64u;
static const uint FILM_HAS_DISPLACEMENT = 1u << 5u;
static const uint PAGE_ACTIVE = 1u;
static const uint BASE_GRID = 16u;
static const uint MICRO_GRID = 8u;
static const uint BASE_CELLS_PER_PAGE = 256u;
static const uint MICRO_CELLS_PER_PAGE = 64u;
static const uint ALLOCATION_CLAIM = 0xffffffffu;

uint BuildFilmCount()
{
    uint allocatorWord = _BuildMode != 0u ? 7u : 6u;
    return min(_FilmAllocator[allocatorWord], _FilmCapacity);
}

uint BuildFilmIndex(uint ordinal)
{
    return _BuildMode != 0u ? _DirtyFilmIndices[ordinal] :
        _ActiveFilmIndices[ordinal];
}

bool FilmTopologyPublishable(uint filmIndex, ContactFilmHeader film)
{
    if (filmIndex >= _FilmCapacity) return false;
    AtlasFilmMembership membership = _FilmMemberships[filmIndex];
    return membership.filmId == film.id &&
        membership.filmGeneration == film.generation &&
        (membership.flags & (MEMBERSHIP_ACTIVE | MEMBERSHIP_MEASURED |
            MEMBERSHIP_TOPOLOGY_VALID)) ==
        (MEMBERSHIP_ACTIVE | MEMBERSHIP_MEASURED |
            MEMBERSHIP_TOPOLOGY_VALID) &&
        (membership.flags & MEMBERSHIP_TOPOLOGY_OPEN) == 0u;
}

bool OwnedConfirmedSeam(uint edgeIndex, ContactFilmHeader film,
    out SurfaceHalfEdge edge, out SurfaceHalfEdge twin,
    out SupportContourSegment segmentA, out SupportContourSegment segmentB,
    out ContinuationEvidence evidence)
{
    edge = (SurfaceHalfEdge)0;
    twin = (SurfaceHalfEdge)0;
    segmentA = (SupportContourSegment)0;
    segmentB = (SupportContourSegment)0;
    evidence = (ContinuationEvidence)0;
    if (edgeIndex >= _HalfEdgeCapacity) return false;
    edge = _HalfEdges[edgeIndex];
    if ((edge.flags & (HALF_EDGE_ACTIVE | HALF_EDGE_MEASURED |
            HALF_EDGE_TWIN_CONFIRMED)) !=
        (HALF_EDGE_ACTIVE | HALF_EDGE_MEASURED |
            HALF_EDGE_TWIN_CONFIRMED) || edge.filmId != film.id ||
        edge.filmGeneration != film.generation || edge.twinId == 0u ||
        edge.twinId > _HalfEdgeCapacity || edge.id >= edge.twinId ||
        (edge.relation != HALF_EDGE_SMOOTH &&
            edge.relation != HALF_EDGE_CREASE)) return false;
    twin = _HalfEdges[edge.twinId - 1u];
    if ((twin.flags & (HALF_EDGE_ACTIVE | HALF_EDGE_MEASURED |
            HALF_EDGE_TWIN_CONFIRMED)) !=
        (HALF_EDGE_ACTIVE | HALF_EDGE_MEASURED |
            HALF_EDGE_TWIN_CONFIRMED) || twin.twinId != edge.id ||
        twin.twinGeneration != edge.generation ||
        edge.twinGeneration != twin.generation || twin.filmId == 0u ||
        twin.filmId > _FilmCapacity || edge.contourSegmentId == 0u ||
        twin.contourSegmentId == 0u ||
        edge.contourSegmentId > _ContourSegmentCapacity ||
        twin.contourSegmentId > _ContourSegmentCapacity ||
        edge.evidenceId == 0u || edge.evidenceId > _HalfEdgeCapacity)
        return false;
    AtlasFilmMembership twinMembership = _FilmMemberships[twin.filmId - 1u];
    if (twinMembership.filmId != twin.filmId ||
        twinMembership.filmGeneration != twin.filmGeneration ||
        (twinMembership.flags & (MEMBERSHIP_ACTIVE | MEMBERSHIP_MEASURED |
            MEMBERSHIP_TOPOLOGY_VALID)) !=
        (MEMBERSHIP_ACTIVE | MEMBERSHIP_MEASURED |
            MEMBERSHIP_TOPOLOGY_VALID) ||
        (twinMembership.flags & MEMBERSHIP_TOPOLOGY_OPEN) != 0u) return false;
    evidence = _ContinuationEvidence[edge.evidenceId - 1u];
    if (evidence.id != edge.evidenceId ||
        evidence.generation != edge.evidenceGeneration ||
        (evidence.flags & EVIDENCE_COMMITTABLE) == 0u ||
        countbits(evidence.independentViewMask) < 2u) return false;
    segmentA = _SupportContours[edge.contourSegmentId - 1u];
    segmentB = _SupportContours[twin.contourSegmentId - 1u];
    return segmentA.id == edge.contourSegmentId &&
        segmentA.generation == edge.contourSegmentGeneration &&
        segmentA.filmId == edge.filmId &&
        segmentA.filmGeneration == edge.filmGeneration &&
        segmentB.id == twin.contourSegmentId &&
        segmentB.generation == twin.contourSegmentGeneration &&
        segmentB.filmId == twin.filmId &&
        segmentB.filmGeneration == twin.filmGeneration &&
        (segmentA.flags & (CONTOUR_ACTIVE | CONTOUR_MEASURED)) ==
            (CONTOUR_ACTIVE | CONTOUR_MEASURED) &&
        (segmentB.flags & (CONTOUR_ACTIVE | CONTOUR_MEASURED)) ==
            (CONTOUR_ACTIVE | CONTOUR_MEASURED);
}

DisplacementCell LoadDisplacementCell(bool micro, uint pageIndex, uint localCell)
{
    DisplacementCell value = (DisplacementCell)0;
    if (micro)
        value = _MicroDisplacementCells[
            pageIndex * MICRO_CELLS_PER_PAGE + localCell];
    else
        value = _BaseDisplacementCells[
            pageIndex * BASE_CELLS_PER_PAGE + localCell];
    return value;
}

uint LoadDisplacementChild(bool micro, uint pageIndex, uint localCell)
{
    uint child = 0u;
    if (micro)
        child = _MicroChildPages[pageIndex * MICRO_CELLS_PER_PAGE + localCell];
    else
        child = _BaseChildPages[pageIndex * BASE_CELLS_PER_PAGE + localCell];
    return child;
}

bool ResolveDisplacementPage(ContactFilmHeader film, float2 uv,
    out bool micro, out uint pageIndex, out DisplacementPageHeader page)
{
    micro = false;
    pageIndex = 0u;
    page = (DisplacementPageHeader)0;
    if (_HasDisplacement == 0u ||
        (film.flags & FILM_HAS_DISPLACEMENT) == 0u ||
        film.displacementPage == 0u ||
        film.displacementPage == ALLOCATION_CLAIM)
        return false;
    pageIndex = film.displacementPage - 1u;
    if (pageIndex >= _BasePageCapacity) return false;
    page = _DisplacementPages[pageIndex];
    if ((page.flags & PAGE_ACTIVE) == 0u || page.filmId != film.id ||
        page.filmGeneration != film.generation) return false;

    float2 normalized = saturate(uv);
    [loop]
    for (uint level = 0u; level < _MaximumMicroLevels; ++level)
    {
        float2 span = max(page.uvBounds.zw - page.uvBounds.xy, 1e-8);
        float2 localUv = saturate((normalized - page.uvBounds.xy) / span);
        uint grid = micro ? MICRO_GRID : BASE_GRID;
        uint2 cell = min((uint2)(localUv * (float)grid), grid - 1u);
        uint childHandle = LoadDisplacementChild(micro, pageIndex,
            cell.y * grid + cell.x);
        if (childHandle == 0u || childHandle == ALLOCATION_CLAIM) break;
        uint childIndex = childHandle - 1u;
        if (childIndex >= _MicroPageCapacity) break;
        DisplacementPageHeader child = (DisplacementPageHeader)0;
        child = _DisplacementPages[_BasePageCapacity + childIndex];
        if ((child.flags & PAGE_ACTIVE) == 0u || child.filmId != film.id ||
            child.filmGeneration != film.generation) break;
        micro = true;
        pageIndex = childIndex;
        page = child;
    }
    return true;
}

void DisplacementMetrics(ContactFilmHeader film, out float bestFootprint,
    out float maximumVariance, out uint deepestLevel)
{
    bestFootprint = max(2.0 * film.extentU, 2.0 * film.extentV);
    maximumVariance = 0.0;
    deepestLevel = 0u;
    if (_HasDisplacement == 0u ||
        (film.flags & FILM_HAS_DISPLACEMENT) == 0u ||
        film.displacementPage == 0u ||
        film.displacementPage == ALLOCATION_CLAIM) return;
    uint pageIndex = film.displacementPage - 1u;
    if (pageIndex >= _BasePageCapacity) return;
    DisplacementPageHeader page = _DisplacementPages[pageIndex];
    if ((page.flags & PAGE_ACTIVE) == 0u || page.filmId != film.id ||
        page.filmGeneration != film.generation) return;
    // Displacement pages persist cone footprint area in square metres. Meshlet
    // tessellation and screen LOD require a linear metric sampling diameter.
    bestFootprint = sqrt(max(asfloat(page.bestFootprintBits), 1e-10));
    maximumVariance = max(asfloat(page.maximumVarianceBits), 0.0);

    // Page headers retain aggregate quality for every resident descendant. Sampling
    // the centre path provides a conservative hierarchy-depth signal without a CPU
    // traversal; variance and footprint still force detail outside that path.
    bool micro = false;
    float2 uv = 0.5;
    [loop]
    for (uint level = 0u; level < _MaximumMicroLevels; ++level)
    {
        float2 span = max(page.uvBounds.zw - page.uvBounds.xy, 1e-8);
        float2 localUv = saturate((uv - page.uvBounds.xy) / span);
        uint grid = micro ? MICRO_GRID : BASE_GRID;
        uint2 cell = min((uint2)(localUv * (float)grid), grid - 1u);
        uint childHandle = LoadDisplacementChild(micro, pageIndex,
            cell.y * grid + cell.x);
        if (childHandle == 0u || childHandle == ALLOCATION_CLAIM) break;
        uint childIndex = childHandle - 1u;
        if (childIndex >= _MicroPageCapacity) break;
        DisplacementPageHeader child =
            _DisplacementPages[_BasePageCapacity + childIndex];
        if ((child.flags & PAGE_ACTIVE) == 0u || child.filmId != film.id ||
            child.filmGeneration != film.generation) break;
        micro = true;
        pageIndex = childIndex;
        page = child;
        deepestLevel = max(deepestLevel, child.level);
        bestFootprint = min(bestFootprint,
            sqrt(max(asfloat(child.bestFootprintBits), 1e-10)));
        maximumVariance = max(maximumVariance,
            max(asfloat(child.maximumVarianceBits), 0.0));
    }
}

float SampleDisplacement(ContactFilmHeader film, float2 uv)
{
    bool micro = false;
    uint pageIndex = 0u;
    DisplacementPageHeader page = (DisplacementPageHeader)0;
    if (!ResolveDisplacementPage(film, uv, micro, pageIndex, page)) return 0.0;
    uint rootIndex = film.displacementPage - 1u;
    DisplacementPageHeader root = _DisplacementPages[rootIndex];
    uint selectedGrid = micro ? MICRO_GRID : BASE_GRID;
    float2 selectedSpan = max(page.uvBounds.zw - page.uvBounds.xy, 1e-8);
    float2 selectedUv = saturate((uv - page.uvBounds.xy) / selectedSpan);
    uint2 selectedCell = min((uint2)(selectedUv * (float)selectedGrid),
        selectedGrid - 1u);
    DisplacementCell selected = LoadDisplacementCell(micro, pageIndex,
        selectedCell.y * selectedGrid + selectedCell.x);
    if (selected.revision == 0u && root.parentPage != 0u)
    {
        uint lineage = root.parentPage;
        [loop]
        for (uint lineageDepth = 0u; lineageDepth < 8u && lineage != 0u;
            ++lineageDepth)
        {
            uint lineageRootIndex = lineage - 1u;
            if (lineageRootIndex >= _BasePageCapacity) break;
            DisplacementPageHeader lineageRoot =
                _DisplacementPages[lineageRootIndex];
            if ((lineageRoot.flags & PAGE_ACTIVE) == 0u) break;
            bool lineageMicro = false;
            uint lineagePageIndex = lineageRootIndex;
            DisplacementPageHeader lineagePage = lineageRoot;
            [loop]
            for (uint level = 0u; level < _MaximumMicroLevels; ++level)
            {
                uint lineageGrid = lineageMicro ? MICRO_GRID : BASE_GRID;
                float2 lineageSpan = max(lineagePage.uvBounds.zw -
                    lineagePage.uvBounds.xy, 1e-8);
                float2 lineageUv = saturate((uv - lineagePage.uvBounds.xy) /
                    lineageSpan);
                uint2 lineageCell = min((uint2)(lineageUv *
                    (float)lineageGrid), lineageGrid - 1u);
                uint childHandle = LoadDisplacementChild(lineageMicro,
                    lineagePageIndex,
                    lineageCell.y * lineageGrid + lineageCell.x);
                if (childHandle == 0u || childHandle == ALLOCATION_CLAIM) break;
                uint childIndex = childHandle - 1u;
                if (childIndex >= _MicroPageCapacity) break;
                DisplacementPageHeader child =
                    _DisplacementPages[_BasePageCapacity + childIndex];
                if ((child.flags & PAGE_ACTIVE) == 0u) break;
                lineageMicro = true;
                lineagePageIndex = childIndex;
                lineagePage = child;
            }
            uint lineageGrid = lineageMicro ? MICRO_GRID : BASE_GRID;
            float2 lineageSpan = max(lineagePage.uvBounds.zw -
                lineagePage.uvBounds.xy, 1e-8);
            float2 lineageUv = saturate((uv - lineagePage.uvBounds.xy) /
                lineageSpan);
            uint2 lineageCell = min((uint2)(lineageUv *
                (float)lineageGrid), lineageGrid - 1u);
            DisplacementCell lineageSelected = LoadDisplacementCell(
                lineageMicro, lineagePageIndex,
                lineageCell.y * lineageGrid + lineageCell.x);
            if (lineageSelected.revision != 0u ||
                lineageRoot.parentPage == 0u)
            {
                micro = lineageMicro;
                pageIndex = lineagePageIndex;
                page = lineagePage;
                break;
            }
            lineage = lineageRoot.parentPage;
        }
    }
    uint grid = micro ? MICRO_GRID : BASE_GRID;
    float2 span = max(page.uvBounds.zw - page.uvBounds.xy, 1e-8);
    float2 localUv = saturate((uv - page.uvBounds.xy) / span);
    float2 samplePosition = localUv * (float)grid - 0.5;
    int2 lower = (int2)floor(samplePosition);
    float2 fraction = frac(samplePosition);
    uint2 p00 = (uint2)clamp(lower, 0, (int)grid - 1);
    uint2 p10 = uint2(min(p00.x + 1u, grid - 1u), p00.y);
    uint2 p01 = uint2(p00.x, min(p00.y + 1u, grid - 1u));
    uint2 p11 = min(p00 + 1u, grid - 1u);
    float d00 = LoadDisplacementCell(micro, pageIndex,
        p00.y * grid + p00.x).displacement;
    float d10 = LoadDisplacementCell(micro, pageIndex,
        p10.y * grid + p10.x).displacement;
    float d01 = LoadDisplacementCell(micro, pageIndex,
        p01.y * grid + p01.x).displacement;
    float d11 = LoadDisplacementCell(micro, pageIndex,
        p11.y * grid + p11.x).displacement;
    return lerp(lerp(d00, d10, fraction.x),
        lerp(d01, d11, fraction.x), fraction.y);
}

float BootstrapCoverageCell(ContactFilmHeader film, int2 cell)
{
    uint2 clamped = (uint2)clamp(cell, int2(0, 0), int2(7, 7));
    uint bit = clamped.y * 8u + clamped.x;
    bool covered = bit < 32u ?
        ((film.supportMaskLow >> bit) & 1u) != 0u :
        ((film.supportMaskHigh >> (bit - 32u)) & 1u) != 0u;
    return covered ? 1.0 : 0.0;
}

float BootstrapCoverage(ContactFilmHeader film, float2 uv)
{
    // Treat the conservative 8x8 spawn mask as samples at cell centres. Bilinear
    // reconstruction turns it into a continuous canonical support field instead
    // of exposing the storage cells as square pieces of geometry.
    float2 coordinate = saturate(uv) * 8.0 - 0.5;
    int2 lower = (int2)floor(coordinate);
    float2 fraction = frac(coordinate);
    float c00 = BootstrapCoverageCell(film, lower);
    float c10 = BootstrapCoverageCell(film, lower + int2(1, 0));
    float c01 = BootstrapCoverageCell(film, lower + int2(0, 1));
    float c11 = BootstrapCoverageCell(film, lower + int2(1, 1));
    return lerp(lerp(c00, c10, fraction.x),
        lerp(c01, c11, fraction.x), fraction.y);
}

float SurfaceCoverage(ContactFilmHeader film, float2 uv)
{
    // The 16x16 base page is the canonical continuous support domain. Micro pages
    // refine position/normal inside it, while ContactBoundaries refine its contour.
    // Keeping support at the base level makes this hot tessellation query O(1)
    // instead of traversing the displacement hierarchy for every candidate vertex.
    float domainWindow = saturate(min(min(uv.x, uv.y),
        min(1.0 - uv.x, 1.0 - uv.y)) * (float)(BASE_GRID - 1u));
    if (_HasDisplacement == 0u ||
        (film.flags & FILM_HAS_DISPLACEMENT) == 0u ||
        film.displacementPage == 0u ||
        film.displacementPage == ALLOCATION_CLAIM)
        return BootstrapCoverage(film, uv) * domainWindow;
    uint pageIndex = film.displacementPage - 1u;
    if (pageIndex >= _BasePageCapacity)
        return BootstrapCoverage(film, uv) * domainWindow;
    DisplacementPageHeader page = (DisplacementPageHeader)0;
    page = _DisplacementPages[pageIndex];
    if ((page.flags & PAGE_ACTIVE) == 0u || page.filmId != film.id ||
        page.filmGeneration != film.generation)
        return BootstrapCoverage(film, uv) * domainWindow;
    const uint grid = BASE_GRID;
    float2 localUv = saturate(uv);
    // Coverage is an intensive surface-domain field. Reconstruct it continuously
    // from cell-centred samples so tessellation density cannot expose page cells.
    float2 coordinate = localUv * (float)grid - 0.5;
    int2 lower = (int2)floor(coordinate);
    float2 fraction = frac(coordinate);
    int upper = (int)grid - 1;
    uint2 p00 = (uint2)clamp(lower, int2(0, 0), int2(upper, upper));
    uint2 p10 = (uint2)clamp(lower + int2(1, 0), int2(0, 0),
        int2(upper, upper));
    uint2 p01 = (uint2)clamp(lower + int2(0, 1), int2(0, 0),
        int2(upper, upper));
    uint2 p11 = (uint2)clamp(lower + int2(1, 1), int2(0, 0),
        int2(upper, upper));
    float c00 = LoadDisplacementCell(false, pageIndex,
        p00.y * grid + p00.x).coverage;
    float c10 = LoadDisplacementCell(false, pageIndex,
        p10.y * grid + p10.x).coverage;
    float c01 = LoadDisplacementCell(false, pageIndex,
        p01.y * grid + p01.x).coverage;
    float c11 = LoadDisplacementCell(false, pageIndex,
        p11.y * grid + p11.x).coverage;
    return saturate(lerp(lerp(c00, c10, fraction.x),
        lerp(c01, c11, fraction.x), fraction.y)) * domainWindow;
}

uint BoundaryHashKey(uint filmId, uint generation, uint cellKey)
{
    uint value = filmId * 0x9e3779b9u;
    value ^= generation + 0x85ebca6bu + (value << 6u) + (value >> 2u);
    value ^= cellKey + 0xc2b2ae35u + (value << 6u) + (value >> 2u);
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    return max(1u, value & 0x7fffffffu);
}

float4 CachedBoundarySegment(BoundaryCurveCache cache, bool sideA, uint index)
{
    if (sideA)
        return index == 0u ? cache.segmentA0 : index == 1u ? cache.segmentA1 :
            index == 2u ? cache.segmentA2 : cache.segmentA3;
    return index == 0u ? cache.segmentB0 : index == 1u ? cache.segmentB1 :
        index == 2u ? cache.segmentB2 : cache.segmentB3;
}

bool CachedBoundarySide(BoundaryCurveCache cache, ContactFilmHeader film,
    out bool sideA)
{
    sideA = cache.filmA == film.id && cache.filmAGeneration == film.generation;
    bool sideB = cache.filmB == film.id &&
        cache.filmBGeneration == film.generation;
    return (cache.flags & BOUNDARY_CACHE_ACTIVE) != 0u && (sideA || sideB);
}

float2 ClosestPointOnUvSegment(float2 uv, float4 segment, out float distanceValue)
{
    float2 edge = segment.zw - segment.xy;
    float t = saturate(dot(uv - segment.xy, edge) /
        max(dot(edge, edge), 1e-12));
    float2 closestPosition = lerp(segment.xy, segment.zw, t);
    distanceValue = distance(uv, closestPosition);
    return closestPosition;
}

bool ClosestBoundaryPoint(ContactFilmHeader film, float2 uv,
    out float2 closestUv)
{
    closestUv = uv;
    if (_HasBoundaries == 0u || film.boundaryCount == 0u) return false;
    uint cells = max(_BoundaryCellsPerAxis, 1u);
    int2 center = (int2)min((uint2)(saturate(uv) * (float)cells), cells - 1u);
    float bestDistance = 1e9;
    [loop]
    for (int cellY = -1; cellY <= 1; ++cellY)
    [loop]
    for (int cellX = -1; cellX <= 1; ++cellX)
    {
        int2 cell = center + int2(cellX, cellY);
        if (any(cell < 0) || any(cell >= (int)cells)) continue;
        uint cellKey = (uint)cell.x | ((uint)cell.y << 16u);
        uint hash = BoundaryHashKey(film.id, film.generation, cellKey);
        [loop]
        for (uint probe = 0u; probe < 16u; ++probe)
        {
            uint slot = (hash + probe * 0x9e3779b9u) & _BoundaryHashMask;
            BoundaryHashEntry entry = (BoundaryHashEntry)0;
            entry = _BoundaryHash[slot];
            if (entry.hash == 0u) break;
            if (entry.hash != hash || entry.filmId != film.id ||
                entry.filmGeneration != film.generation ||
                entry.cellKey != cellKey || entry.boundaryId == 0u) continue;
            ContactBoundaryHeader boundary = _BoundaryHeaders[entry.boundaryId - 1u];
            BoundaryCurveCache cache = _BoundaryCurveCache[entry.boundaryId - 1u];
            bool sideA;
            if (cache.boundaryId != boundary.id ||
                cache.boundaryGeneration != boundary.generation ||
                (boundary.flags & (BOUNDARY_ACTIVE | BOUNDARY_PERSISTENT)) !=
                    (BOUNDARY_ACTIVE | BOUNDARY_PERSISTENT) ||
                !CachedBoundarySide(cache, film, sideA)) continue;
            [unroll]
            for (uint segmentIndex = 0u; segmentIndex < 4u; ++segmentIndex)
            {
                float distanceValue;
                float2 candidate = ClosestPointOnUvSegment(uv,
                    CachedBoundarySegment(cache, sideA, segmentIndex),
                    distanceValue);
                if (distanceValue < bestDistance)
                {
                    bestDistance = distanceValue;
                    closestUv = candidate;
                }
            }
        }
    }
    return bestDistance <= 0.55 / (float)cells;
}

bool CellTouchesPersistentBoundary(ContactFilmHeader film, float2 uvMinimum,
    float2 uvMaximum)
{
    if (_HasBoundaries == 0u || film.boundaryCount == 0u) return false;
    float2 centre = 0.5 * (uvMinimum + uvMaximum);
    float2 closest = centre;
    if (!ClosestBoundaryPoint(film, centre, closest)) return false;
    float2 halfSpan = 0.5 * (uvMaximum - uvMinimum);
    // This predicate is telemetry/topology evidence only. Geometry remains a
    // connected support manifold; vertices near the persistent curve are snapped by
    // ClosestBoundaryPoint rather than deleting a complete grid cell.
    return all(abs(closest - centre) <= halfSpan * 1.05 + 1e-6);
}

bool BoundarySignedDistance(ContactFilmHeader film, float2 uv,
    out float signedDistance, out uint boundaryId)
{
    signedDistance = 0.0;
    boundaryId = 0u;
    if (_HasBoundaries == 0u || film.boundaryCount == 0u) return false;
    uint cells = max(_BoundaryCellsPerAxis, 1u);
    int2 center = (int2)min((uint2)(saturate(uv) * (float)cells), cells - 1u);
    float bestDistance = 1e9;
    float2 bestPoint = uv;
    float2 bestTangent = float2(1.0, 0.0);
    [loop]
    for (int cellY = -1; cellY <= 1; ++cellY)
    [loop]
    for (int cellX = -1; cellX <= 1; ++cellX)
    {
        int2 cell = center + int2(cellX, cellY);
        if (any(cell < 0) || any(cell >= (int)cells)) continue;
        uint cellKey = (uint)cell.x | ((uint)cell.y << 16u);
        uint hash = BoundaryHashKey(film.id, film.generation, cellKey);
        [loop]
        for (uint probe = 0u; probe < 16u; ++probe)
        {
            uint slot = (hash + probe * 0x9e3779b9u) & _BoundaryHashMask;
            BoundaryHashEntry entry = _BoundaryHash[slot];
            if (entry.hash == 0u) break;
            if (entry.hash != hash || entry.filmId != film.id ||
                entry.filmGeneration != film.generation ||
                entry.cellKey != cellKey || entry.boundaryId == 0u) continue;
            ContactBoundaryHeader boundary = _BoundaryHeaders[entry.boundaryId - 1u];
            BoundaryCurveCache cache = _BoundaryCurveCache[entry.boundaryId - 1u];
            bool sideA;
            if (cache.boundaryId != boundary.id ||
                cache.boundaryGeneration != boundary.generation ||
                (boundary.flags & (BOUNDARY_ACTIVE | BOUNDARY_PERSISTENT)) !=
                    (BOUNDARY_ACTIVE | BOUNDARY_PERSISTENT) ||
                !CachedBoundarySide(cache, film, sideA)) continue;
            [unroll]
            for (uint sample = 0u; sample < 4u; ++sample)
            {
                float4 cachedSegment = CachedBoundarySegment(cache, sideA, sample);
                float2 segment = cachedSegment.zw - cachedSegment.xy;
                float t = saturate(dot(uv - cachedSegment.xy, segment) /
                    max(dot(segment, segment), 1e-10));
                float2 closestPoint = lerp(cachedSegment.xy, cachedSegment.zw, t);
                float distanceToCurve = distance(closestPoint, uv);
                if (distanceToCurve < bestDistance)
                {
                    bestDistance = distanceToCurve;
                    bestPoint = closestPoint;
                    bestTangent = segment;
                    boundaryId = boundary.id;
                }
            }
        }
    }
    if (boundaryId == 0u || bestDistance > 1.5 / (float)cells) return false;
    float tangentLength = length(bestTangent);
    if (tangentLength <= 1e-8) return false;
    bestTangent /= tangentLength;
    float2 delta = uv - bestPoint;
    signedDistance = bestTangent.x * delta.y - bestTangent.y * delta.x;
    if (abs(signedDistance) < 1e-7)
        signedDistance = signedDistance < 0.0 ? -1e-7 : 1e-7;
    return true;
}

uint TriangleMask(float3 scalar)
{
    return (scalar.x >= 0.0 ? 1u : 0u) |
        (scalar.y >= 0.0 ? 2u : 0u) |
        (scalar.z >= 0.0 ? 4u : 0u);
}

uint3 MaterialClassCounts(uint triangleClass)
{
    // x = clipped-fragment slot, y = measured triangles, z = latent triangles.
    if (triangleClass == 1u) return uint3(0u, 1u, 0u);
    if (triangleClass == 2u) return uint3(1u, 1u, 2u);
    if (triangleClass == 3u) return uint3(1u, 2u, 1u);
    if (triangleClass == 4u) return uint3(1u, 3u, 0u);
    return uint3(0u, 0u, 1u);
}

float3 NonDegenerateCutScalar(float3 scalar)
{
    scalar.x = abs(scalar.x) < 1e-6 ? 1e-6 : scalar.x;
    scalar.y = abs(scalar.y) < 1e-6 ? 1e-6 : scalar.y;
    scalar.z = abs(scalar.z) < 1e-6 ? 1e-6 : scalar.z;
    return scalar;
}

bool TriangleBoundaryCut(ContactFilmHeader film, float2 uv0, float2 uv1,
    float2 uv2, out float3 signedDistance)
{
    uint id0, id1, id2;
    bool b0 = BoundarySignedDistance(film, uv0, signedDistance.x, id0);
    bool b1 = BoundarySignedDistance(film, uv1, signedDistance.y, id1);
    bool b2 = BoundarySignedDistance(film, uv2, signedDistance.z, id2);
    if (!b0 || !b1 || !b2 || id0 == 0u || id0 != id1 || id0 != id2)
        return false;
    uint mask = TriangleMask(signedDistance);
    return mask != 0u && mask != 7u;
}

void ClassifyMaterialTriangle(ContactFilmHeader film, float2 uv0, float2 uv1,
    float2 uv2, out uint measuredTriangles, out uint latentTriangles,
    out uint mixedTriangles, out uint triangleClass)
{
    float3 support = NonDegenerateCutScalar(float3(SurfaceCoverage(film, uv0),
        SurfaceCoverage(film, uv1), SurfaceCoverage(film, uv2)) - 0.5);
    uint mask = TriangleMask(support);
    measuredTriangles = latentTriangles = mixedTriangles = triangleClass = 0u;
    if (mask == 0u) { latentTriangles = 1u; return; }
    if (mask != 7u)
    {
        uint positive = countbits(mask);
        measuredTriangles = positive == 1u ? 1u : 2u;
        latentTriangles = 3u - measuredTriangles;
        mixedTriangles = 1u;
        triangleClass = positive == 1u ? 2u : 3u;
        return;
    }
    float3 boundarySigned;
    if (TriangleBoundaryCut(film, uv0, uv1, uv2, boundarySigned))
    {
        measuredTriangles = 3u;
        mixedTriangles = 1u;
        triangleClass = 4u;
        return;
    }
    measuredTriangles = 1u;
    triangleClass = 1u;
}

float Height(ContactFilmHeader film, float u, float v, float2 uv)
{
    ElasticChartState elastic = _ElasticChartStates[film.id - 1u];
    bool validElastic = elastic.filmId == film.id &&
        elastic.filmGeneration == film.generation;
    float2 normalized = uv * 2.0 - 1.0;
    float elasticHeight = validElastic ? elastic.normalOffset +
        elastic.normalizedTiltU * normalized.x +
        elastic.normalizedTiltV * normalized.y : 0.0;
    return film.quadratic0123.x + film.quadratic0123.y * u +
        film.quadratic0123.z * v + film.quadratic0123.w * u * u +
        film.quadratic45.x * u * v + film.quadratic45.y * v * v +
        SampleDisplacement(film, uv) + elasticHeight;
}

float3 SurfaceNormal(ContactFilmHeader film, float u, float v, float2 uv)
{
    float dhdu = film.quadratic0123.y + 2.0 * film.quadratic0123.w * u +
        film.quadratic45.x * v;
    float dhdv = film.quadratic0123.z + film.quadratic45.x * u +
        2.0 * film.quadratic45.y * v;
    ElasticChartState elastic = _ElasticChartStates[film.id - 1u];
    if (elastic.filmId == film.id && elastic.filmGeneration == film.generation)
    {
        dhdu += elastic.normalizedTiltU / max(film.extentU, 1e-6);
        dhdv += elastic.normalizedTiltV / max(film.extentV, 1e-6);
    }
    const float epsilon = 1.0 / 1024.0;
    float left = SampleDisplacement(film,
        float2(max(0.0, uv.x - epsilon), uv.y));
    float right = SampleDisplacement(film,
        float2(min(1.0, uv.x + epsilon), uv.y));
    float down = SampleDisplacement(film,
        float2(uv.x, max(0.0, uv.y - epsilon)));
    float up = SampleDisplacement(film,
        float2(uv.x, min(1.0, uv.y + epsilon)));
    dhdu += (right - left) /
        max(4.0 * film.extentU * epsilon, 1e-8);
    dhdv += (up - down) /
        max(4.0 * film.extentV * epsilon, 1e-8);
    float3 du = film.tangentU + dhdu * film.normal;
    float3 dv = film.tangentV + dhdv * film.normal;
    float3 n = normalize(cross(du, dv));
    return dot(n, film.normal) >= 0.0 ? n : -n;
}

float3 SurfacePosition(ContactFilmHeader film, float2 uv)
{
    uv = saturate(uv);
    float u = lerp(-film.extentU, film.extentU, uv.x);
    float v = lerp(-film.extentV, film.extentV, uv.y);
    return film.origin + u * film.tangentU + v * film.tangentV +
        Height(film, u, v, uv) * film.normal;
}

bool Reserve(uint counter, uint amount, uint capacity, out uint baseOffset)
{
    baseOffset = 0u;
    [loop]
    for (uint attempt = 0u; attempt < 64u; ++attempt)
    {
        uint current = _MeshletAllocator[counter];
        if (amount > capacity || current > capacity - amount) return false;
        uint observed = 0u;
        InterlockedCompareExchange(_MeshletAllocator[counter], current,
            current + amount, observed);
        if (observed == current)
        {
            baseOffset = current;
            return true;
        }
    }
    return false;
}

uint ChooseSubdivision(ContactFilmHeader film)
{
    float curvatureSag = abs(film.quadratic0123.w) * film.extentU * film.extentU +
        abs(film.quadratic45.x) * film.extentU * film.extentV +
        abs(film.quadratic45.y) * film.extentV * film.extentV;
    float bestFootprint;
    float displacementVariance;
    uint deepestLevel;
    DisplacementMetrics(film, bestFootprint, displacementVariance, deepestLevel);
    float targetError = max(_MinimumTessellationError,
        min(0.01, film.sigmaNormal * lerp(0.8, 0.35, saturate(film.confidence))));
    float displacementError = sqrt(max(displacementVariance, 0.0));
    float physicalSpan = max(2.0 * film.extentU, 2.0 * film.extentV);
    float footprintRequired = physicalSpan / max(bestFootprint, targetError);
    float required = max(sqrt(max(1.0,
        (curvatureSag + displacementError) / targetError)), footprintRequired);
    // Observed coverage carries measurement detail even though it no longer cuts
    // topology. Preserve at least the bootstrap sampling where cone footprints have
    // deposited information.
    if ((film.supportMaskLow | film.supportMaskHigh) != 0u ||
        (film.flags & FILM_HAS_DISPLACEMENT) != 0u)
        required = max(required, 8.0);
    if (film.boundaryCount > 0u) required = max(required, 4.0);
    if (deepestLevel > 0u)
        required = max(required, exp2(min(deepestLevel + 3u, 6u)));
    uint segments = 1u;
    [loop]
    while ((float)segments < required && segments < _MaximumSubdivision)
        segments <<= 1u;
    return min(segments, _MaximumSubdivision);
}

uint ReservedSubdivision(uint segments)
{
    uint next = segments < _MaximumSubdivision ? segments << 1u : segments;
    return min(max(1u, next), _MaximumSubdivision);
}

uint ReservedVertexCount(uint segments)
{
    uint row = segments + 1u;
    // Explicit measured/latent lattices plus the worst seven vertices produced by
    // each clipped source triangle. This preserves the conserved sheet without
    // allowing latent fragments into first-hit prediction.
    return 2u * row * row + 14u * segments * segments;
}

uint ReservedIndexCount(uint segments)
{
    // A supported BoundaryCurve can divide one source triangle into three measured
    // output triangles (triangle + quad).
    return 18u * segments * segments;
}

[numthreads(1, 1, 1)]
void ClearMeshletBuild(uint3 id : SV_DispatchThreadID)
{
    _MeshletAllocator[0] = 0u; // vertices
    _MeshletAllocator[1] = 0u; // indices
    _MeshletAllocator[2] = 0u; // overflowed films
    _MeshletAllocator[3] = 0u; // emitted films
    _MeshletAllocator[4] = 0u; // descriptors
    _MeshletAllocator[5] = 0u; // boundary-clipped cells
    _MeshletAllocator[6] = 0u; // transaction valid
    _MeshletAllocator[7] = 0u; // publication revision
    [unroll] for (uint argument = 0u; argument < 5u; ++argument)
        _MeshDispatchArguments[argument] = uint3(0u, 1u, 1u);
    _CullDispatchArguments[0] = uint3(0u, 1u, 1u);
    _DrawArguments[0] = uint4(0u, 1u, 0u, 0u);
    _ManifoldDiagnostics[14] = 0u;
    _ManifoldDiagnostics[15] = 0u;
}

[numthreads(1, 1, 1)]
void BuildMeshDispatchArguments(uint3 id : SV_DispatchThreadID)
{
    uint filmCount = BuildFilmCount();
    _MeshDispatchArguments[0] = uint3(filmCount, 1u, 1u);
    _MeshDispatchArguments[1] = uint3((filmCount + 255u) / 256u, 1u, 1u);
    _MeshDispatchArguments[2] = uint3((filmCount + 63u) / 64u, 1u, 1u);
}

// Transaction state:
// 0 dirty-range incompatibility/full-repack request
// 1 dirty count captured for this publication
// 2..4 validated full-repack vertex/index/descriptor totals
// 5 publication transaction valid
// 6 number of dirty entries whose canonical flags were finalized
// 7 reserved telemetry
[numthreads(1, 1, 1)]
void PrepareDirtyMeshletBuild(uint3 id : SV_DispatchThreadID)
{
    uint dirtyCount = min(_FilmAllocator[7], _FilmCapacity);
    [unroll] for (uint word = 0u; word < 8u; ++word)
        _TransactionState[word] = 0u;
    _TransactionState[1] = dirtyCount;
    _TransactionState[5] = dirtyCount == 0u ? 1u : 0u;
    _IncrementalDispatchArguments[0] = uint3(dirtyCount, 1u, 1u);
    _IncrementalDispatchArguments[1] = uint3((dirtyCount + 63u) / 64u, 1u, 1u);
    _IncrementalDispatchArguments[2] = uint3(0u, 1u, 1u);
    _IncrementalDispatchArguments[3] = uint3(0u, 1u, 1u);
    _IncrementalDispatchArguments[4] = uint3(0u, 1u, 1u);
}

[numthreads(64, 1, 1)]
void ValidateDirtyMeshletBuild(uint3 id : SV_DispatchThreadID)
{
    uint dirtyCount = min(_TransactionState[1], _FilmCapacity);
    uint ordinal = id.x;
    if (ordinal >= dirtyCount || ordinal >= _BuildPlanCapacity) return;
    uint filmIndex = _DirtyFilmIndices[ordinal];
    MeshletBuildPlan plan = _MeshletBuildPlans[ordinal];
    bool valid = filmIndex < _FilmCapacity && plan.filmIndex == filmIndex &&
        plan.valid != 0u && (plan.reserved0 & 0x80000000u) == 0u;
    if (valid)
    {
        ContactFilmHeader film = _FilmHeaders[filmIndex];
        FilmMeshletRange range = _FilmMeshletRanges[filmIndex];
        valid = (film.flags & FILM_ACTIVE) != 0u && range.flags != 0u &&
            range.filmId == film.id &&
            range.filmGeneration == film.generation &&
            plan.vertexOffset == range.vertexOffset &&
            plan.indexOffset == range.indexOffset &&
            plan.descriptorOffset == range.descriptorOffset &&
            plan.vertexCount <= range.vertexCapacity &&
            plan.indexCount <= range.indexCapacity &&
            plan.descriptorCount <= range.descriptorCapacity;
    }
    if (!valid) InterlockedOr(_TransactionState[0], 1u);
}

[numthreads(1, 1, 1)]
void CommitDirtyMeshletBuild(uint3 id : SV_DispatchThreadID)
{
    uint dirtyCount = min(_TransactionState[1], _FilmCapacity);
    // Second invocation occurs after FinalizeDirtyMeshletFilms. Only then may the
    // canonical dirty queue be reset; a failed transaction retains every entry.
    if (_TransactionState[5] != 0u && _TransactionState[6] >= dirtyCount)
    {
        _FilmAllocatorWrite[7] = 0u;
        _TransactionState[6] = 0u;
        return;
    }
    // Topology eligibility is resolved per generation-tagged FilmMembership in
    // CountMeshletBuildPlans. One provisional/open contour must never freeze every
    // already valid manifold component in the world.
    bool valid = _TransactionState[0] == 0u;
    _TransactionState[5] = valid ? 1u : 0u;
    _IncrementalDispatchArguments[2] = uint3(valid ? dirtyCount : 0u, 1u, 1u);
    _IncrementalDispatchArguments[3] = uint3(
        valid ? (dirtyCount + 63u) / 64u : 0u, 1u, 1u);
}

[numthreads(1, 1, 1)]
void PrepareFullMeshletRepack(uint3 id : SV_DispatchThreadID)
{
    [unroll] for (uint argument = 0u; argument < 5u; ++argument)
        _MeshDispatchArguments[argument] = uint3(0u, 1u, 1u);
    if (_TransactionState[0] == 0u) return;
    uint filmCount = min(_FilmAllocator[6], _FilmCapacity);
    _TransactionState[5] = 0u;
    _MeshDispatchArguments[0] = uint3(filmCount, 1u, 1u);
    _MeshDispatchArguments[1] = uint3((filmCount + 255u) / 256u, 1u, 1u);
    _MeshDispatchArguments[2] = uint3((filmCount + 63u) / 64u, 1u, 1u);
}

groupshared uint sCountSegments;
groupshared uint sCountMeasuredTriangles;
groupshared uint sCountLatentTriangles;
groupshared uint sCountMixedTriangles;
groupshared uint sCountSeams;
groupshared uint sCountValid;
groupshared uint3 sTriangleBlockPrefix[64];

[numthreads(64, 1, 1)]
void CountMeshletBuildPlans(uint3 groupId : SV_GroupID,
    uint groupIndex : SV_GroupIndex)
{
    uint activeCount = BuildFilmCount();
    uint activeOrdinal = groupId.x;
    if (activeOrdinal >= activeCount || activeOrdinal >= _BuildPlanCapacity) return;
    uint filmIndex = BuildFilmIndex(activeOrdinal);
    if (groupIndex == 0u)
    {
        sCountSegments = 0u;
        sCountMeasuredTriangles = 0u;
        sCountLatentTriangles = 0u;
        sCountMixedTriangles = 0u;
        sCountSeams = 0u;
        sCountValid = 0u;
        if (filmIndex < _FilmCapacity)
        {
            ContactFilmHeader candidate = _FilmHeaders[filmIndex];
            if ((candidate.flags & FILM_ACTIVE) != 0u &&
                FilmTopologyPublishable(filmIndex, candidate))
            {
                sCountSegments = ChooseSubdivision(candidate);
                sCountValid = 1u;
            }
        }
    }
    uint triangleWorkBase = filmIndex * TRIANGLE_WORK_WORDS_PER_FILM;
    if (filmIndex < _FilmCapacity)
    {
        _TriangleClasses[triangleWorkBase + groupIndex] = 0u;
        _TriangleClasses[triangleWorkBase + TRIANGLE_CLASS_WORDS_PER_FILM +
            groupIndex] = 0u;
    }
    GroupMemoryBarrierWithGroupSync();
    if (sCountValid == 0u)
    {
        if (groupIndex == 0u)
        {
            MeshletBuildPlan empty = (MeshletBuildPlan)0;
            empty.filmIndex = filmIndex;
            _MeshletBuildPlans[activeOrdinal] = empty;
        }
        return;
    }
    ContactFilmHeader film = _FilmHeaders[filmIndex];
    uint segments = sCountSegments;
    uint baseTriangles = segments * segments * 2u;
    for (uint triangleOrdinal = groupIndex; triangleOrdinal < baseTriangles;
        triangleOrdinal += 64u)
    {
        uint cell = triangleOrdinal >> 1u;
        uint cellX = cell % segments;
        uint cellY = cell / segments;
        float2 uv00 = float2((float)cellX, (float)cellY) / (float)segments;
        float2 uv10 = float2((float)(cellX + 1u), (float)cellY) /
            (float)segments;
        float2 uv01 = float2((float)cellX, (float)(cellY + 1u)) /
            (float)segments;
        float2 uv11 = float2((float)(cellX + 1u), (float)(cellY + 1u)) /
            (float)segments;
        float2 a = triangleOrdinal & 1u ? uv01 : uv00;
        float2 b = uv10;
        float2 c = triangleOrdinal & 1u ? uv11 : uv01;
        uint measured, ignoredLatent, mixed, triangleClass;
        ClassifyMaterialTriangle(film, a, b, c, measured, ignoredLatent,
            mixed, triangleClass);
        uint classWord = triangleWorkBase +
            (triangleOrdinal >> 3u);
        uint classShift = (triangleOrdinal & 7u) << 2u;
        InterlockedOr(_TriangleClasses[classWord], triangleClass << classShift);
        InterlockedAdd(sCountMeasuredTriangles, measured);
        InterlockedAdd(sCountLatentTriangles, ignoredLatent);
        InterlockedAdd(sCountMixedTriangles, mixed);
    }
    GroupMemoryBarrierWithGroupSync();

    // A seam belongs to exactly one chart: the lower canonical half-edge id owns
    // its derived connector. Pages are traversed directly, avoiding an O(n^2)
    // contour-slot lookup in this hot planning pass.
    uint4 topologyRange = _FilmTopologyRanges[filmIndex];
    uint pageId = topologyRange.x;
    [loop]
    for (uint pageOrdinal = 0u;
        pageOrdinal < topologyRange.y && pageId != 0u; ++pageOrdinal)
    {
        if (pageId > _ContourPageCapacity) break;
        SupportContourPage page = _SupportContourPages[pageId - 1u];
        if ((page.flags & CONTOUR_PAGE_ACTIVE) != 0u &&
            page.filmId == film.id && page.filmGeneration == film.generation)
        {
            [loop]
            for (uint local = groupIndex; local < page.segmentCount;
                local += 64u)
            {
                uint edgeIndex = (pageId - 1u) *
                    CONTOUR_SEGMENTS_PER_PAGE + local;
                SurfaceHalfEdge edge, twin;
                SupportContourSegment segmentA, segmentB;
                ContinuationEvidence evidence;
                if (OwnedConfirmedSeam(edgeIndex, film, edge, twin,
                    segmentA, segmentB, evidence))
                    InterlockedAdd(sCountSeams, 1u);
            }
        }
        pageId = page.nextPageId;
    }
    GroupMemoryBarrierWithGroupSync();
    uint packedClasses = _TriangleClasses[triangleWorkBase + groupIndex];
    uint3 blockCount = 0u;
    [unroll]
    for (uint localTriangle = 0u; localTriangle < 8u; ++localTriangle)
        blockCount += MaterialClassCounts(
            (packedClasses >> (localTriangle << 2u)) & 15u);
    sTriangleBlockPrefix[groupIndex] = blockCount;
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint offset = 1u; offset < 64u; offset <<= 1u)
    {
        uint3 add = groupIndex >= offset ?
            sTriangleBlockPrefix[groupIndex - offset] : 0u;
        GroupMemoryBarrierWithGroupSync();
        sTriangleBlockPrefix[groupIndex] += add;
        GroupMemoryBarrierWithGroupSync();
    }
    uint3 exclusiveBlockPrefix = sTriangleBlockPrefix[groupIndex] - blockCount;
    _TriangleClasses[triangleWorkBase + TRIANGLE_CLASS_WORDS_PER_FILM +
        groupIndex] = min(exclusiveBlockPrefix.x, 1023u) |
        (min(exclusiveBlockPrefix.y, 2047u) << 10u) |
        (min(exclusiveBlockPrefix.z, 2047u) << 21u);
    if (groupIndex != 0u) return;
    MeshletBuildPlan plan = (MeshletBuildPlan)0;
    plan.filmIndex = filmIndex;
    plan.segments = segments;
    plan.rowVertices = segments + 1u;
    uint latticeVertices = plan.rowVertices * plan.rowVertices;
    plan.vertexCount = 2u * latticeVertices + sCountMixedTriangles * 7u +
        sCountSeams * 4u;
    plan.triangleCount = sCountMeasuredTriangles + sCountLatentTriangles +
        sCountSeams * 2u;
    plan.measuredIndexCount = sCountMeasuredTriangles * 3u;
    plan.latentIndexCount = sCountLatentTriangles * 3u;
    plan.indexCount = plan.measuredIndexCount + plan.latentIndexCount +
        sCountSeams * 6u;
    // Stable measured/latent descriptor slots prevent material ranges from
    // shifting when confidence crosses the measured-support threshold.
    plan.descriptorCount = plan.indexCount > 0u ? 2u : 0u;
    plan.reserved0 = sCountMixedTriangles;
    // Reserve the complete topology envelope of the current measured resolution,
    // not the next LOD for every film.  Growth remains lossless: an incompatible
    // dirty range requests the existing transactional full repack.  The previous
    // policy consumed ~3,873 vertices even for an empty 8-segment film and could
    // make the first publication fail before a single vertex became visible.
    uint reservedSeams = topologyRange.y * CONTOUR_SEGMENTS_PER_PAGE;
    plan.reserved1 = plan.indexCount > 0u ?
        ReservedVertexCount(segments) + reservedSeams * 4u : 0u;
    plan.reserved2 = plan.indexCount > 0u ?
        ReservedIndexCount(segments) + reservedSeams * 6u : 0u;
    plan.valid = plan.indexCount > 0u ? 1u : 0u;
    if (_BuildMode != 0u)
    {
        FilmMeshletRange range = _FilmMeshletRanges[filmIndex];
        bool compatible = range.flags != 0u && range.filmId == film.id &&
            range.filmGeneration == film.generation &&
            range.maximumSegments >= segments &&
            plan.vertexCount <= range.vertexCapacity &&
            plan.indexCount <= range.indexCapacity &&
            range.descriptorCapacity >= 2u;
        if (compatible)
        {
            plan.vertexOffset = range.vertexOffset;
            plan.indexOffset = range.indexOffset;
            plan.descriptorOffset = range.descriptorOffset;
            plan.reserved1 = range.vertexCapacity;
            plan.reserved2 = range.indexCapacity;
        }
        else
        {
            plan.valid = 0u;
            plan.reserved0 |= 0x80000000u;
        }
    }
    _MeshletBuildPlans[activeOrdinal] = plan;
}

groupshared uint4 sPlanScan[256];

[numthreads(256, 1, 1)]
void ScanMeshletBuildPlans(uint3 groupId : SV_GroupID,
    uint groupIndex : SV_GroupIndex)
{
    uint activeCount = BuildFilmCount();
    uint ordinal = groupId.x * 256u + groupIndex;
    uint4 value = 0u;
    if (ordinal < activeCount && ordinal < _BuildPlanCapacity)
    {
        MeshletBuildPlan plan = _MeshletBuildPlans[ordinal];
        value = plan.valid != 0u ? uint4(plan.reserved1, plan.reserved2,
            plan.descriptorCount, 1u) : 0u;
    }
    sPlanScan[groupIndex] = value;
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint offset = 1u; offset < 256u; offset <<= 1u)
    {
        uint4 add = groupIndex >= offset ? sPlanScan[groupIndex - offset] : 0u;
        GroupMemoryBarrierWithGroupSync();
        sPlanScan[groupIndex] += add;
        GroupMemoryBarrierWithGroupSync();
    }
    if (ordinal < activeCount && ordinal < _BuildPlanCapacity)
    {
        MeshletBuildPlan plan = _MeshletBuildPlans[ordinal];
        uint4 exclusive = sPlanScan[groupIndex] - value;
        plan.vertexOffset = exclusive.x;
        plan.indexOffset = exclusive.y;
        plan.descriptorOffset = exclusive.z;
        _MeshletBuildPlans[ordinal] = plan;
    }
    if (groupIndex == 255u && groupId.x < _BuildGroupCapacity)
        _MeshletBuildGroupSums[groupId.x] = sPlanScan[255u];
}

[numthreads(256, 1, 1)]
void ScanMeshletBuildGroups(uint3 groupId : SV_GroupID,
    uint groupIndex : SV_GroupIndex)
{
    uint activeCount = BuildFilmCount();
    uint groupCount = min((activeCount + 255u) / 256u, _BuildGroupCapacity);
    uint4 value = groupIndex < groupCount ?
        _MeshletBuildGroupSums[groupIndex] : 0u;
    sPlanScan[groupIndex] = value;
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint offset = 1u; offset < 256u; offset <<= 1u)
    {
        uint4 add = groupIndex >= offset ? sPlanScan[groupIndex - offset] : 0u;
        GroupMemoryBarrierWithGroupSync();
        sPlanScan[groupIndex] += add;
        GroupMemoryBarrierWithGroupSync();
    }
    if (groupIndex < groupCount)
        _MeshletBuildGroupSums[groupIndex] = sPlanScan[groupIndex] - value;
}

[numthreads(64, 1, 1)]
void AddMeshletBuildGroupOffsets(uint3 id : SV_DispatchThreadID)
{
    uint activeCount = BuildFilmCount();
    uint ordinal = id.x;
    if (ordinal >= activeCount || ordinal >= _BuildPlanCapacity) return;
    uint group = ordinal >> 8u;
    uint4 offset = _MeshletBuildGroupSums[group];
    MeshletBuildPlan plan = _MeshletBuildPlans[ordinal];
    plan.vertexOffset += offset.x;
    plan.indexOffset += offset.y;
    plan.descriptorOffset += offset.z;
    _MeshletBuildPlans[ordinal] = plan;
}

[numthreads(1, 1, 1)]
void ValidateMeshletBuild(uint3 id : SV_DispatchThreadID)
{
    uint activeCount = BuildFilmCount();
    uint vertices = 0u, indices = 0u, descriptors = 0u;
    if (activeCount > 0u && activeCount <= _BuildPlanCapacity)
    {
        MeshletBuildPlan last = _MeshletBuildPlans[activeCount - 1u];
        vertices = last.vertexOffset + last.reserved1;
        indices = last.indexOffset + last.reserved2;
        descriptors = last.descriptorOffset + last.descriptorCount;
    }
    bool capacityValid = activeCount <= _BuildPlanCapacity &&
        vertices <= _VertexCapacity && indices <= _IndexCapacity &&
        descriptors <= _DescriptorCapacity;
    bool valid = capacityValid;
    _ManifoldDiagnostics[15] = capacityValid ? 0u : 1u;
    if (_InPlacePublication != 0u)
    {
        if (_TransactionState[0] == 0u) return;
        _TransactionState[2] = vertices;
        _TransactionState[3] = indices;
        _TransactionState[4] = descriptors;
        _TransactionState[5] = valid ? 1u : 0u;
        _MeshDispatchArguments[3] = uint3(valid ? activeCount : 0u, 1u, 1u);
        return;
    }
    if (valid)
    {
        _MeshletAllocator[0] = vertices;
        _MeshletAllocator[1] = indices;
        _MeshletAllocator[3] = activeCount;
        _MeshletAllocator[4] = descriptors;
        _MeshletAllocator[6] = 1u;
        _MeshDispatchArguments[3] = uint3(activeCount, 1u, 1u);
    }
    else
    {
        _MeshletAllocator[2] = 1u;
        _MeshletAllocator[6] = 0u;
        uint previousWork = max(min(_PreviousMeshletAllocator[0],
                _PreviousVertexCapacity),
            max(min(_PreviousMeshletAllocator[1], _PreviousIndexCapacity),
                max(min(_PreviousMeshletAllocator[4], _PreviousDescriptorCapacity),
                    _FilmCapacity)));
        _MeshDispatchArguments[4] = uint3((previousWork + 63u) / 64u, 1u, 1u);
    }
}

[numthreads(1, 1, 1)]
void CommitFullMeshletRepack(uint3 id : SV_DispatchThreadID)
{
    if (_TransactionState[0] == 0u || _TransactionState[5] == 0u) return;
    uint vertices = min(_TransactionState[2], _VertexCapacity);
    uint indices = min(_TransactionState[3], _IndexCapacity);
    uint descriptors = min(_TransactionState[4], _DescriptorCapacity);
    _MeshletAllocator[0] = vertices;
    _MeshletAllocator[1] = indices;
    _MeshletAllocator[2] = 0u;
    _MeshletAllocator[3] = min(_FilmAllocator[6], _FilmCapacity);
    _MeshletAllocator[4] = descriptors;
    _MeshletAllocator[6] = 1u;
    _MeshletAllocator[7] += 1u;
    _DrawArguments[0] = uint4(indices, 1u, 0u, 0u);
    _CullDispatchArguments[0] = uint3((descriptors + 63u) / 64u, 1u, 1u);
    uint dirtyCount = min(_TransactionState[1], _FilmCapacity);
    _IncrementalDispatchArguments[3] = uint3(
        (dirtyCount + 63u) / 64u, 1u, 1u);
}

[numthreads(64, 1, 1)]
void FinalizeDirtyMeshletFilms(uint3 id : SV_DispatchThreadID)
{
    if (_TransactionState[5] == 0u) return;
    uint dirtyCount = min(_TransactionState[1], _FilmCapacity);
    uint ordinal = id.x;
    if (ordinal >= dirtyCount) return;
    uint filmIndex = _DirtyFilmIndices[ordinal];
    if (filmIndex < _FilmCapacity)
    {
        FilmSlotState slot = _FilmSlotStates[filmIndex];
        ContactFilmHeader film = _FilmHeadersWrite[filmIndex];
        film.flags &= ~(FILM_DIRTY_GEOMETRY | FILM_DIRTY_MESHLET);
        slot.flags &= ~SLOT_DIRTY;
        _FilmHeadersWrite[filmIndex] = film;
        _FilmSlotStates[filmIndex] = slot;
    }
    InterlockedAdd(_TransactionState[6], 1u);
}

static const uint MAXIMUM_MESHLET_SEGMENTS = 16u;

uint StableSurfaceSampleId(ContactFilmHeader film, float2 uv)
{
    uint2 quantized = min((uint2)round(saturate(uv) * 65535.0), 65535u);
    uint value = film.id * 0x9e3779b9u ^ film.generation * 0x85ebca6bu;
    value ^= quantized.x * 0xc2b2ae35u ^ quantized.y * 0x27d4eb2fu;
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    return max(1u, value);
}

ContactMeshletVertex BuildSurfaceVertex(ContactFilmHeader film, float2 uv,
    bool measuredContact, bool boundarySample)
{
    float2 surfaceUv = uv;
    float3 sharedPosition = SurfacePosition(film, uv);
    float u = lerp(-film.extentU, film.extentU, surfaceUv.x);
    float v = lerp(-film.extentV, film.extentV, surfaceUv.y);
    ContactMeshletVertex vertex = (ContactMeshletVertex)0;
    vertex.position = sharedPosition;
    vertex.packedNormal = PackContactMeshletNormal(
        SurfaceNormal(film, u, v, uv));
    vertex.generation = measuredContact ? film.generation : 0u;
    vertex.packedUv = PackContactMeshletHalf2(surfaceUv);
    float coverage = saturate(SurfaceCoverage(film, uv));
    float confidence = measuredContact ? film.confidence * coverage :
        max(0.02, 0.25 * film.confidence * (1.0 - coverage));
    vertex.packedSigmaConfidence = PackContactMeshletHalf2(
        float2(film.sigmaNormal, confidence));
    uint flags = (measuredContact ? VERTEX_MEASURED_CONTACT :
        VERTEX_LATENT_FRONTIER) |
        (boundarySample ? VERTEX_BOUNDARY : 0u);
    vertex.packedFilmMaterial = PackContactMeshletFilmMaterial(
        measuredContact ? film.id : 0u, 1u, flags, coverage);
    return vertex;
}

float2 CutIntersection(float2 a, float2 b, float scalarA, float scalarB)
{
    float denominator = scalarA - scalarB;
    float t = abs(denominator) > 1e-10 ?
        saturate(scalarA / denominator) : 0.5;
    return lerp(a, b, t);
}

void StoreTriangle(uint indexOffset, uint a, uint b, uint c)
{
    _ContactIndices[indexOffset] = a;
    _ContactIndices[indexOffset + 1u] = b;
    _ContactIndices[indexOffset + 2u] = c;
}

bool LoadMeshletBuildContext(uint activeOrdinal, out MeshletBuildPlan plan,
    out ContactFilmHeader film)
{
    plan = (MeshletBuildPlan)0;
    film = (ContactFilmHeader)0;
    if (activeOrdinal < _BuildPlanCapacity)
        plan = _MeshletBuildPlans[activeOrdinal];
    uint filmIndex = plan.filmIndex;
    if (activeOrdinal >= BuildFilmCount() || filmIndex >= _FilmCapacity ||
        plan.valid == 0u || plan.segments == 0u ||
        plan.segments > MAXIMUM_MESHLET_SEGMENTS ||
        (_InPlacePublication != 0u ? _TransactionState[5] == 0u :
            _MeshletAllocator[6] == 0u))
        return false;
    film = _FilmHeaders[filmIndex];
    return (film.flags & FILM_ACTIVE) != 0u;
}

[numthreads(64, 1, 1)]
void BuildFilmMeshletVertices(uint3 groupId : SV_GroupID,
    uint groupIndex : SV_GroupIndex)
{
    // Canonical UNKNOWN closure remains topology-only. The derived latent lattice
    // below carries FilmID zero and is isolated from first-hit prediction, ordinary
    // preview, collision and export; it only preserves materialization continuity.
    MeshletBuildPlan plan;
    ContactFilmHeader film;
    if (!LoadMeshletBuildContext(groupId.x, plan, film)) return;
    uint segments = plan.segments;
    uint rowVertices = plan.rowVertices;
    uint vertexCount = rowVertices * rowVertices;
    for (uint vertexOrdinal = groupIndex;
        vertexOrdinal < vertexCount; vertexOrdinal += 64u)
    {
        uint x = vertexOrdinal % rowVertices;
        uint y = vertexOrdinal / rowVertices;
        float2 uv = float2((float)x, (float)y) / (float)segments;
        float2 surfaceUv = uv;
        bool onBoundary = ClosestBoundaryPoint(film, uv, surfaceUv);
        float u = lerp(-film.extentU, film.extentU, surfaceUv.x);
        float v = lerp(-film.extentV, film.extentV, surfaceUv.y);
        ContactMeshletVertex measured = (ContactMeshletVertex)0;
        measured.position = SurfacePosition(film, surfaceUv);
        measured.packedNormal = PackContactMeshletNormal(
            SurfaceNormal(film, u, v, surfaceUv));
        measured.generation = film.generation;
        measured.packedUv = PackContactMeshletHalf2(surfaceUv);
        float coverage = SurfaceCoverage(film, uv);
        float observedConfidence = isfinite(coverage) ?
            saturate(coverage) : 0.0;
        measured.packedSigmaConfidence = PackContactMeshletHalf2(float2(
            film.sigmaNormal, film.confidence * observedConfidence));
        uint flags = VERTEX_MEASURED_CONTACT |
            (onBoundary ? VERTEX_BOUNDARY : 0u);
        measured.packedFilmMaterial = PackContactMeshletFilmMaterial(
            film.id, 1u, flags, observedConfidence);
        _ContactVertices[plan.vertexOffset + vertexOrdinal] = measured;

        ContactMeshletVertex latent = measured;
        latent.generation = 0u;
        latent.packedSigmaConfidence = PackContactMeshletHalf2(float2(
            film.sigmaNormal, max(0.02, 0.25 * film.confidence *
                (1.0 - observedConfidence))));
        latent.packedFilmMaterial = PackContactMeshletFilmMaterial(
            0u, 1u, VERTEX_LATENT_FRONTIER |
                (onBoundary ? VERTEX_BOUNDARY : 0u), observedConfidence);
        _ContactVertices[plan.vertexOffset + vertexCount + vertexOrdinal] = latent;
    }
}

uint TriangleClassAt(uint filmIndex, uint triangleOrdinal)
{
    uint packed = _TriangleClasses[filmIndex * TRIANGLE_WORK_WORDS_PER_FILM +
        (triangleOrdinal >> 3u)];
    return (packed >> ((triangleOrdinal & 7u) << 2u)) & 15u;
}

uint3 TrianglePrefixAt(uint filmIndex, uint triangleOrdinal)
{
    uint workBase = filmIndex * TRIANGLE_WORK_WORDS_PER_FILM;
    uint classWordIndex = triangleOrdinal >> 3u;
    uint packedPrefix = _TriangleClasses[workBase +
        TRIANGLE_CLASS_WORDS_PER_FILM + classWordIndex];
    uint3 prefix = uint3(packedPrefix & 1023u,
        (packedPrefix >> 10u) & 2047u,
        (packedPrefix >> 21u) & 2047u);
    uint packedClasses = _TriangleClasses[workBase + classWordIndex];
    uint withinWord = triangleOrdinal & 7u;
    [unroll]
    for (uint localTriangle = 0u; localTriangle < 8u; ++localTriangle)
    {
        if (localTriangle >= withinWord) break;
        prefix += MaterialClassCounts(
            (packedClasses >> (localTriangle << 2u)) & 15u);
    }
    return prefix;
}

void TriangleCoordinates(uint segments, uint triangleOrdinal,
    out uint3 localVertex, out float2 uv0, out float2 uv1, out float2 uv2)
{
    uint rowVertices = segments + 1u;
    uint cell = triangleOrdinal >> 1u;
    uint cellX = cell % segments;
    uint cellY = cell / segments;
    uint local00 = cellY * rowVertices + cellX;
    uint local10 = local00 + 1u;
    uint local01 = local00 + rowVertices;
    uint local11 = local01 + 1u;
    localVertex = (triangleOrdinal & 1u) == 0u ?
        uint3(local00, local10, local01) :
        uint3(local01, local10, local11);
    uint3 x = localVertex % rowVertices;
    uint3 y = localVertex / rowVertices;
    uv0 = float2((float)x.x, (float)y.x) / (float)segments;
    uv1 = float2((float)x.y, (float)y.y) / (float)segments;
    uv2 = float2((float)x.z, (float)y.z) / (float)segments;
}

void ClipTriangle(float2 triangleUv[3], float scalar[3], bool keepPositive,
    out float2 polygon[4], out uint polygonCount)
{
    polygonCount = 0u;
    uint previous = 2u;
    [unroll]
    for (uint current = 0u; current < 3u; ++current)
    {
        bool previousInside = keepPositive ? scalar[previous] >= 0.0 :
            scalar[previous] <= 0.0;
        bool currentInside = keepPositive ? scalar[current] >= 0.0 :
            scalar[current] <= 0.0;
        if (previousInside != currentInside)
        {
            float denominator = scalar[previous] - scalar[current];
            float t = abs(denominator) > 1e-10 ?
                saturate(scalar[previous] / denominator) : 0.5;
            polygon[polygonCount++] = lerp(triangleUv[previous],
                triangleUv[current], t);
        }
        if (currentInside) polygon[polygonCount++] = triangleUv[current];
        previous = current;
    }
}

void StorePolygonIndices(uint indexBase, uint vertexBase, uint vertexCount)
{
    [unroll]
    for (uint outputTriangle = 0u; outputTriangle < 2u; ++outputTriangle)
    {
        if (outputTriangle + 2u >= vertexCount) break;
        StoreTriangle(indexBase + outputTriangle * 3u, vertexBase,
            vertexBase + outputTriangle + 1u,
            vertexBase + outputTriangle + 2u);
    }
}

void EmitRegularMaterialTriangle(ContactFilmHeader film, MeshletBuildPlan plan,
    uint triangleOrdinal, uint triangleClass, uint3 prefix)
{
    uint3 localVertex;
    float2 uv0, uv1, uv2;
    TriangleCoordinates(plan.segments, triangleOrdinal, localVertex,
        uv0, uv1, uv2);
    uint latticeVertices = plan.rowVertices * plan.rowVertices;
    uint measuredIndexCursor = plan.indexOffset + prefix.y * 3u;
    uint latentIndexCursor = plan.indexOffset + plan.measuredIndexCount +
        prefix.z * 3u;
    if (triangleClass == 0u)
    {
        StoreTriangle(latentIndexCursor,
            plan.vertexOffset + latticeVertices + localVertex.x,
            plan.vertexOffset + latticeVertices + localVertex.y,
            plan.vertexOffset + latticeVertices + localVertex.z);
        return;
    }
    if (triangleClass == 1u)
    {
        StoreTriangle(measuredIndexCursor,
            plan.vertexOffset + localVertex.x,
            plan.vertexOffset + localVertex.y,
            plan.vertexOffset + localVertex.z);
        return;
    }
    float3 support = NonDegenerateCutScalar(float3(
        SurfaceCoverage(film, uv0), SurfaceCoverage(film, uv1),
        SurfaceCoverage(film, uv2)) - 0.5);
    uint mask = TriangleMask(support);
    if (mask == 0u || mask == 7u) return;
    uint vertexBase = plan.vertexOffset + 2u * latticeVertices +
        prefix.x * 7u;
    float2 triangleUv[3] = { uv0, uv1, uv2 };
    float scalar[3] = { support.x, support.y, support.z };
    float2 measuredPolygon[4];
    float2 latentPolygon[4];
    uint measuredCount;
    uint latentCount;
    ClipTriangle(triangleUv, scalar, true, measuredPolygon, measuredCount);
    ClipTriangle(triangleUv, scalar, false, latentPolygon, latentCount);
    [loop]
    for (uint outputVertex = 0u; outputVertex < measuredCount;
        ++outputVertex)
        _ContactVertices[vertexBase + outputVertex] =
            BuildSurfaceVertex(film, measuredPolygon[outputVertex], true, true);
    uint latentVertexBase = vertexBase + measuredCount;
    [loop]
    for (uint outputVertex = 0u; outputVertex < latentCount; ++outputVertex)
        _ContactVertices[latentVertexBase + outputVertex] =
            BuildSurfaceVertex(film, latentPolygon[outputVertex], false, true);
    StorePolygonIndices(measuredIndexCursor, vertexBase, measuredCount);
    StorePolygonIndices(latentIndexCursor, latentVertexBase, latentCount);
}

void EmitBoundaryMaterialTriangle(ContactFilmHeader film, MeshletBuildPlan plan,
    uint triangleOrdinal, float3 boundaryScalar, uint3 prefix)
{
    uint3 ignoredLocalVertex;
    float2 uv0, uv1, uv2;
    TriangleCoordinates(plan.segments, triangleOrdinal, ignoredLocalVertex,
        uv0, uv1, uv2);
    boundaryScalar = NonDegenerateCutScalar(boundaryScalar);
    uint mask = TriangleMask(boundaryScalar);
    if (mask == 0u || mask == 7u) return;
    uint vertexBase = plan.vertexOffset +
        2u * plan.rowVertices * plan.rowVertices +
        prefix.x * 7u;
    uint indexCursor = plan.indexOffset + prefix.y * 3u;
    float2 cutA = 0.0;
    float2 cutB = 0.0;
    if (mask == 1u || mask == 6u)
    {
        cutA = CutIntersection(uv0, uv1, boundaryScalar.x,
            boundaryScalar.y);
        cutB = CutIntersection(uv2, uv0, boundaryScalar.z,
            boundaryScalar.x);
    }
    else if (mask == 2u || mask == 5u)
    {
        cutA = CutIntersection(uv0, uv1, boundaryScalar.x,
            boundaryScalar.y);
        cutB = CutIntersection(uv1, uv2, boundaryScalar.y,
            boundaryScalar.z);
    }
    else
    {
        cutA = CutIntersection(uv1, uv2, boundaryScalar.y,
            boundaryScalar.z);
        cutB = CutIntersection(uv2, uv0, boundaryScalar.z,
            boundaryScalar.x);
    }
    [loop]
    for (uint outputVertex = 0u; outputVertex < 5u; ++outputVertex)
    {
        float2 outputUv = outputVertex == 0u ? uv0 :
            (outputVertex == 1u ? uv1 :
                (outputVertex == 2u ? uv2 :
                    (outputVertex == 3u ? cutA : cutB)));
        _ContactVertices[vertexBase + outputVertex] =
            BuildSurfaceVertex(film, outputUv, true, true);
    }
    if (mask == 1u || mask == 6u)
    {
        StoreTriangle(indexCursor, vertexBase, vertexBase + 3u,
            vertexBase + 4u);
        StoreTriangle(indexCursor + 3u, vertexBase + 1u, vertexBase + 2u,
            vertexBase + 4u);
        StoreTriangle(indexCursor + 6u, vertexBase + 1u, vertexBase + 4u,
            vertexBase + 3u);
    }
    else if (mask == 2u || mask == 5u)
    {
        StoreTriangle(indexCursor, vertexBase + 3u, vertexBase + 1u,
            vertexBase + 4u);
        StoreTriangle(indexCursor + 3u, vertexBase, vertexBase + 3u,
            vertexBase + 4u);
        StoreTriangle(indexCursor + 6u, vertexBase, vertexBase + 4u,
            vertexBase + 2u);
    }
    else
    {
        StoreTriangle(indexCursor, vertexBase + 3u, vertexBase + 2u,
            vertexBase + 4u);
        StoreTriangle(indexCursor + 3u, vertexBase, vertexBase + 1u,
            vertexBase + 3u);
        StoreTriangle(indexCursor + 6u, vertexBase, vertexBase + 3u,
            vertexBase + 4u);
    }
    InterlockedAdd(_MeshletAllocator[5], 1u);
}

[numthreads(256, 1, 1)]
void BuildFilmMeshletRegularTriangles(uint3 groupId : SV_GroupID,
    uint groupIndex : SV_GroupIndex)
{
    MeshletBuildPlan plan;
    ContactFilmHeader film;
    bool buildValid = LoadMeshletBuildContext(groupId.x, plan, film);
    uint baseTriangleCount = buildValid ?
        plan.segments * plan.segments * 2u : 0u;
    if (!buildValid) return;
    [loop]
    for (uint laneItem = 0u; laneItem < 2u; ++laneItem)
    {
        uint triangleOrdinal = groupIndex + laneItem * 256u;
        if (triangleOrdinal >= baseTriangleCount) continue;
        uint triangleClass = TriangleClassAt(plan.filmIndex, triangleOrdinal);
        if (triangleClass > 3u) continue;
        EmitRegularMaterialTriangle(film, plan, triangleOrdinal,
            triangleClass, TrianglePrefixAt(plan.filmIndex, triangleOrdinal));
    }
}

groupshared uint sSeamLanePrefix[64];
groupshared MeshletBuildPlan sSeamPlan;
groupshared ContactFilmHeader sSeamFilm;
groupshared uint sSeamBuildValid;

ContactMeshletVertex BuildSeamVertex(float3 position, float3 normal,
    float sigma, float confidence, float2 uv, uint generation)
{
    ContactMeshletVertex vertex = (ContactMeshletVertex)0;
    vertex.position = position;
    vertex.packedNormal = PackContactMeshletNormal(normalize(normal));
    vertex.generation = generation;
    vertex.packedUv = PackContactMeshletHalf2(saturate(uv));
    vertex.packedSigmaConfidence = PackContactMeshletHalf2(float2(
        sigma, confidence));
    vertex.packedFilmMaterial = PackContactMeshletFilmMaterial(0u, 1u,
        VERTEX_LATENT_CONNECTOR | VERTEX_BOUNDARY, 0.0);
    return vertex;
}

[numthreads(64, 1, 1)]
void BuildFilmMeshletSeams(uint3 groupId : SV_GroupID,
    uint groupIndex : SV_GroupIndex)
{
    if (groupIndex == 0u)
    {
        MeshletBuildPlan candidatePlan;
        ContactFilmHeader candidateFilm;
        bool valid = LoadMeshletBuildContext(groupId.x, candidatePlan,
            candidateFilm);
        sSeamPlan = candidatePlan;
        sSeamFilm = candidateFilm;
        sSeamBuildValid = valid ? 1u : 0u;
    }
    GroupMemoryBarrierWithGroupSync();
    if (sSeamBuildValid == 0u) return;
    MeshletBuildPlan plan = sSeamPlan;
    ContactFilmHeader film = sSeamFilm;
    uint4 topologyRange = _FilmTopologyRanges[plan.filmIndex];
    uint ownedCount = 0u;
    uint pageId = topologyRange.x;
    [loop]
    for (uint pageOrdinal = 0u;
        pageOrdinal < topologyRange.y && pageId != 0u; ++pageOrdinal)
    {
        if (pageId > _ContourPageCapacity) break;
        SupportContourPage page = _SupportContourPages[pageId - 1u];
        if ((page.flags & CONTOUR_PAGE_ACTIVE) != 0u &&
            page.filmId == film.id && page.filmGeneration == film.generation)
        {
            [loop]
            for (uint local = groupIndex; local < page.segmentCount;
                local += 64u)
            {
                uint edgeIndex = (pageId - 1u) *
                    CONTOUR_SEGMENTS_PER_PAGE + local;
                SurfaceHalfEdge edge, twin;
                SupportContourSegment segmentA, segmentB;
                ContinuationEvidence evidence;
                if (OwnedConfirmedSeam(edgeIndex, film, edge, twin,
                    segmentA, segmentB, evidence)) ownedCount++;
            }
        }
        pageId = page.nextPageId;
    }
    sSeamLanePrefix[groupIndex] = ownedCount;
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint offset = 1u; offset < 64u; offset <<= 1u)
    {
        uint add = groupIndex >= offset ?
            sSeamLanePrefix[groupIndex - offset] : 0u;
        GroupMemoryBarrierWithGroupSync();
        sSeamLanePrefix[groupIndex] += add;
        GroupMemoryBarrierWithGroupSync();
    }
    uint seamOrdinal = sSeamLanePrefix[groupIndex] - ownedCount;
    uint expectedSeams = (plan.indexCount - plan.measuredIndexCount -
        plan.latentIndexCount) / 6u;
    uint latticeVertices = plan.rowVertices * plan.rowVertices;
    uint seamVertexBase = plan.vertexOffset + 2u * latticeVertices +
        (plan.reserved0 & 0x7fffffffu) * 7u;
    uint seamIndexBase = plan.indexOffset + plan.measuredIndexCount +
        plan.latentIndexCount;

    pageId = topologyRange.x;
    [loop]
    for (uint pageOrdinal = 0u;
        pageOrdinal < topologyRange.y && pageId != 0u; ++pageOrdinal)
    {
        if (pageId > _ContourPageCapacity) break;
        SupportContourPage page = _SupportContourPages[pageId - 1u];
        if ((page.flags & CONTOUR_PAGE_ACTIVE) != 0u &&
            page.filmId == film.id && page.filmGeneration == film.generation)
        {
            [loop]
            for (uint local = groupIndex; local < page.segmentCount;
                local += 64u)
            {
                uint edgeIndex = (pageId - 1u) *
                    CONTOUR_SEGMENTS_PER_PAGE + local;
                SurfaceHalfEdge edge, twin;
                SupportContourSegment a, b;
                ContinuationEvidence evidence;
                if (!OwnedConfirmedSeam(edgeIndex, film, edge, twin, a, b,
                    evidence)) continue;
                uint outputOrdinal = seamOrdinal++;
                if (outputOrdinal >= expectedSeams || twin.filmId == 0u ||
                    twin.filmId > _FilmCapacity) continue;
                ContactFilmHeader filmB = _FilmHeaders[twin.filmId - 1u];
                if ((filmB.flags & FILM_ACTIVE) == 0u ||
                    filmB.id != twin.filmId ||
                    filmB.generation != twin.filmGeneration) continue;

                float3 pA0 = SurfacePosition(film, a.uv01.xy);
                float3 pA1 = SurfacePosition(film, a.uv01.zw);
                float3 pB0 = SurfacePosition(filmB, b.uv01.xy);
                float3 pB1 = SurfacePosition(filmB, b.uv01.zw);
                float3 nA0 = SurfaceNormal(film,
                    lerp(-film.extentU, film.extentU, a.uv01.x),
                    lerp(-film.extentV, film.extentV, a.uv01.y), a.uv01.xy);
                float3 nA1 = SurfaceNormal(film,
                    lerp(-film.extentU, film.extentU, a.uv01.z),
                    lerp(-film.extentV, film.extentV, a.uv01.w), a.uv01.zw);
                float3 nB0 = SurfaceNormal(filmB,
                    lerp(-filmB.extentU, filmB.extentU, b.uv01.x),
                    lerp(-filmB.extentV, filmB.extentV, b.uv01.y), b.uv01.xy);
                float3 nB1 = SurfaceNormal(filmB,
                    lerp(-filmB.extentU, filmB.extentU, b.uv01.z),
                    lerp(-filmB.extentV, filmB.extentV, b.uv01.w), b.uv01.zw);
                bool smooth = edge.relation == HALF_EDGE_SMOOTH;
                float3 shared0 = normalize(nA0 + nB1);
                float3 shared1 = normalize(nA1 + nB0);
                float sigma = max(max(a.sigma, b.sigma),
                    max(film.sigmaNormal, filmB.sigmaNormal));
                float confidence = saturate(min(min(a.confidence, b.confidence),
                    min(film.confidence, filmB.confidence)) *
                    evidence.poseCalibrationQuality);
                uint vertexBase = seamVertexBase + outputOrdinal * 4u;
                _ContactVertices[vertexBase] = BuildSeamVertex(pA0,
                    smooth ? shared0 : nA0, sigma, confidence, a.uv01.xy,
                    evidence.generation);
                _ContactVertices[vertexBase + 1u] = BuildSeamVertex(pA1,
                    smooth ? shared1 : nA1, sigma, confidence, a.uv01.zw,
                    evidence.generation);
                _ContactVertices[vertexBase + 2u] = BuildSeamVertex(pB0,
                    smooth ? shared1 : nB0, sigma, confidence, b.uv01.xy,
                    evidence.generation);
                _ContactVertices[vertexBase + 3u] = BuildSeamVertex(pB1,
                    smooth ? shared0 : nB1, sigma, confidence, b.uv01.zw,
                    evidence.generation);
                uint indexBase = seamIndexBase + outputOrdinal * 6u;
                StoreTriangle(indexBase, vertexBase, vertexBase + 1u,
                    vertexBase + 2u);
                StoreTriangle(indexBase + 3u, vertexBase,
                    vertexBase + 2u, vertexBase + 3u);
            }
        }
        pageId = page.nextPageId;
    }
}

[numthreads(256, 1, 1)]
void BuildFilmMeshletBoundaryTriangles(uint3 groupId : SV_GroupID,
    uint groupIndex : SV_GroupIndex)
{
    MeshletBuildPlan plan;
    ContactFilmHeader film;
    bool buildValid = LoadMeshletBuildContext(groupId.x, plan, film);
    uint baseTriangleCount = buildValid ?
        plan.segments * plan.segments * 2u : 0u;
    if (!buildValid) return;
    [loop]
    for (uint laneItem = 0u; laneItem < 2u; ++laneItem)
    {
        uint triangleOrdinal = groupIndex + laneItem * 256u;
        if (triangleOrdinal >= baseTriangleCount ||
            TriangleClassAt(plan.filmIndex, triangleOrdinal) != 4u) continue;
        uint3 ignoredLocalVertex;
        float2 uv0, uv1, uv2;
        TriangleCoordinates(plan.segments, triangleOrdinal,
            ignoredLocalVertex, uv0, uv1, uv2);
        float3 boundaryScalar = 0.0;
        if (!TriangleBoundaryCut(film, uv0, uv1, uv2, boundaryScalar)) continue;
        EmitBoundaryMaterialTriangle(film, plan, triangleOrdinal, boundaryScalar,
            TrianglePrefixAt(plan.filmIndex, triangleOrdinal));
    }
}

[numthreads(1, 1, 1)]
void FinalizeFilmMeshletDescriptors(uint3 groupId : SV_GroupID)
{
    MeshletBuildPlan plan;
    ContactFilmHeader film;
    if (!LoadMeshletBuildContext(groupId.x, plan, film)) return;
    uint filmIndex = plan.filmIndex;
    uint segments = plan.segments;
    float bestFootprint;
    float displacementVariance;
    uint deepestLevel;
    DisplacementMetrics(film, bestFootprint, displacementVariance, deepestLevel);
    float curvatureSag = abs(film.quadratic0123.w) * film.extentU * film.extentU +
        abs(film.quadratic45.x) * film.extentU * film.extentV +
        abs(film.quadratic45.y) * film.extentV * film.extentV;
    float2 centreUv = 0.5;
    float centreU = 0.0;
    float centreV = 0.0;
    ContactMeshletDescriptor descriptor;
    descriptor.filmId = film.id;
    descriptor.generation = film.generation;
    descriptor.vertexBase = plan.vertexOffset;
    descriptor.maximumSegments = segments;
    descriptor.center = film.origin + Height(film, centreU, centreV, centreUv) *
        film.normal;
    descriptor.radius = sqrt(film.extentU * film.extentU +
        film.extentV * film.extentV) + abs(curvatureSag) +
        3.0 * film.sigmaNormal;
    descriptor.uvBounds = float4(0.0, 0.0, 1.0, 1.0);
    descriptor.geometricError = max(_MinimumTessellationError,
        max(curvatureSag, sqrt(max(displacementVariance, 0.0))));
    descriptor.detailFootprint = max(bestFootprint, _MinimumTessellationError);
    descriptor.confidence = film.confidence;
    descriptor.appearancePage = film.appearancePage;
    descriptor.flags = MESHLET_MEASURED_SURFACE | MESHLET_EXACT_TOPOLOGY |
        (film.boundaryCount > 0u ? MESHLET_HAS_BOUNDARY : 0u);
    descriptor.sourceIndexBase = plan.indexOffset;
    descriptor.sourceIndexCount = plan.measuredIndexCount;
    descriptor.reserved = filmIndex;
    ContactMeshletDescriptor emptyDescriptor = (ContactMeshletDescriptor)0;
    _MeshletDescriptors[plan.descriptorOffset] = emptyDescriptor;
    _MeshletDescriptors[plan.descriptorOffset + 1u] = emptyDescriptor;
    if (plan.measuredIndexCount > 0u)
        _MeshletDescriptors[plan.descriptorOffset] = descriptor;

    ContactMeshletDescriptor latentDescriptor = descriptor;
    latentDescriptor.filmId = 0u;
    latentDescriptor.generation = 0u;
    latentDescriptor.vertexBase = plan.vertexOffset +
        plan.rowVertices * plan.rowVertices;
    latentDescriptor.confidence = max(0.02, 0.25 * film.confidence);
    latentDescriptor.appearancePage = 0u;
    latentDescriptor.flags = MESHLET_EXACT_TOPOLOGY |
        MESHLET_LATENT_FRONTIER | MESHLET_LATENT_CONNECTOR |
        (film.boundaryCount > 0u ? MESHLET_HAS_BOUNDARY : 0u);
    latentDescriptor.sourceIndexBase = plan.indexOffset +
        plan.measuredIndexCount;
    latentDescriptor.sourceIndexCount = plan.indexCount -
        plan.measuredIndexCount;
    latentDescriptor.reserved = filmIndex;
    if (latentDescriptor.sourceIndexCount > 0u)
        _MeshletDescriptors[plan.descriptorOffset + 1u] = latentDescriptor;

    FilmMeshletRange range = (FilmMeshletRange)0;
    range.filmId = film.id;
    range.filmGeneration = film.generation;
    range.filmRevision = film.revision;
    range.flags = 1u;
    range.vertexOffset = plan.vertexOffset;
    range.vertexCapacity = plan.reserved1;
    range.indexOffset = plan.indexOffset;
    range.indexCapacity = plan.reserved2;
    range.descriptorOffset = plan.descriptorOffset;
    range.descriptorCapacity = 2u;
    range.maximumSegments = segments;
    _FilmMeshletRanges[filmIndex] = range;
}

[numthreads(64, 1, 1)]
void RecoverPreviousMeshletGeneration(uint3 id : SV_DispatchThreadID)
{
    if (_MeshletAllocator[6] != 0u) return;
    uint vertexCount = min(_PreviousMeshletAllocator[0],
        _PreviousVertexCapacity);
    uint indexCount = min(_PreviousMeshletAllocator[1],
        _PreviousIndexCapacity);
    uint descriptorCount = min(_PreviousMeshletAllocator[4],
        _PreviousDescriptorCapacity);
    if (id.x < vertexCount)
        _ContactVertices[id.x] = _PreviousContactVertices[id.x];
    if (id.x < indexCount)
        _ContactIndices[id.x] = _PreviousContactIndices[id.x];
    if (id.x < descriptorCount)
        _MeshletDescriptors[id.x] = _PreviousMeshletDescriptors[id.x];
    if (id.x < _FilmCapacity)
        _FilmMeshletRanges[id.x] = _PreviousFilmMeshletRanges[id.x];
    if (id.x == 0u)
    {
        [unroll] for (uint word = 0u; word < 8u; ++word)
            _MeshletAllocator[word] = _PreviousMeshletAllocator[word];
        _DrawArguments[0] = _PreviousDrawArguments[0];
        _CullDispatchArguments[0] = _PreviousCullDispatchArguments[0];
    }
}

[numthreads(1, 1, 1)]
void FinalizeMeshletDrawArguments(uint3 id : SV_DispatchThreadID)
{
    if (_MeshletAllocator[6] == 0u) return;
    _DrawArguments[0] = uint4(min(_MeshletAllocator[1], _IndexCapacity),
        1u, 0u, 0u);
    _CullDispatchArguments[0] = uint3(
        (min(_MeshletAllocator[4], _DescriptorCapacity) + 63u) / 64u,
        1u, 1u);
}
