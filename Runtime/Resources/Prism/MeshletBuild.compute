#pragma kernel ClearMeshletBuild
#pragma kernel BuildMeshDispatchArguments
#pragma kernel BuildAdaptiveFilmMeshlets
#pragma kernel BuildElasticBoundaryMeshlets
#pragma kernel FinalizeMeshletDrawArguments

struct ContactFilmHeader
{
    uint id;
    uint generation;
    uint chunkId;
    uint flags;
    float3 origin;
    float supportTotal;
    float3 normal;
    float sigmaNormal;
    float3 tangentU;
    float extentU;
    float3 tangentV;
    float extentV;
    float4 quadratic0123;
    float2 quadratic45;
    float confidence;
    float contradiction;
    uint revision;
    uint displacementPage;
    uint appearancePage;
    uint boundaryStart;
    uint boundaryCount;
    uint supportMaskLow;
    uint supportMaskHigh;
    uint reserved0;
    uint reserved1;
    uint reserved2;
};

struct ContactMeshletVertex
{
    float3 position;
    uint filmId;
    float3 normal;
    uint generation;
    float2 uv;
    float sigma;
    float confidence;
    uint sidedness;
    uint flags;
    uint reserved0;
    uint reserved1;
};

struct ContactMeshletDescriptor
{
    uint filmId;
    uint generation;
    uint vertexBase;
    uint maximumSegments;
    float3 center;
    float radius;
    float4 uvBounds;
    float geometricError;
    float detailFootprint;
    float confidence;
    uint appearancePage;
    uint flags;
    uint sourceIndexBase;
    uint sourceIndexCount;
    uint reserved;
};

struct ContactBoundaryHeader
{
    uint id;
    uint generation;
    uint chunkId;
    uint flags;
    uint filmA;
    uint filmAGeneration;
    uint filmB;
    uint filmBGeneration;
    float4 controlUv01;
    float4 controlUv23;
    float sigma;
    float support;
    float confidence;
    float contradiction;
    uint revision;
    uint cellKey;
    uint viewBinMask;
    uint lastSeenSequence;
};

struct BoundaryHashEntry
{
    uint hash;
    uint filmId;
    uint filmGeneration;
    uint cellKey;
    uint boundaryId;
};

struct DisplacementPageHeader
{
    uint id;
    uint generation;
    uint filmId;
    uint filmGeneration;
    uint level;
    uint parentPage;
    uint parentCell;
    uint flags;
    float4 uvBounds;
    uint bestFootprintBits;
    uint maximumVarianceBits;
    uint supportFixed;
    uint revision;
};

struct DisplacementCell
{
    float displacement;
    float sigma;
    float support;
    float coverage;
    float bestPrecision;
    float bestFootprint;
    float residualVariance;
    float preHitPressure;
    uint preHitPressureViewMask;
    uint revision;
};

StructuredBuffer<ContactFilmHeader> _FilmHeaders;
StructuredBuffer<uint> _FilmAllocator;
StructuredBuffer<ContactBoundaryHeader> _BoundaryHeaders;
StructuredBuffer<float4> _BoundaryInformation;
StructuredBuffer<uint> _BoundaryAllocator;
StructuredBuffer<BoundaryHashEntry> _BoundaryHash;
StructuredBuffer<DisplacementPageHeader> _DisplacementPages;
StructuredBuffer<DisplacementCell> _BaseDisplacementCells;
StructuredBuffer<DisplacementCell> _MicroDisplacementCells;
StructuredBuffer<uint> _BaseChildPages;
StructuredBuffer<uint> _MicroChildPages;
RWStructuredBuffer<ContactMeshletVertex> _ContactVertices;
RWStructuredBuffer<uint> _ContactIndices;
RWStructuredBuffer<ContactMeshletDescriptor> _MeshletDescriptors;
RWStructuredBuffer<uint4> _DrawArguments;
RWStructuredBuffer<uint3> _MeshDispatchArguments;
RWStructuredBuffer<uint3> _CullDispatchArguments;
RWStructuredBuffer<uint> _MeshletAllocator;
uint _FilmCapacity;
uint _VertexCapacity;
uint _IndexCapacity;
uint _DescriptorCapacity;
uint _MaximumSubdivision;
float _MinimumTessellationError;
uint _HasBoundaries;
uint _BoundaryHashMask;
uint _BoundaryCellsPerAxis;
uint _HasDisplacement;
uint _BasePageCapacity;
uint _MicroPageCapacity;
uint _BaseCellCapacity;
uint _MaximumMicroLevels;

static const uint FILM_ACTIVE = 1u;
static const uint BOUNDARY_ACTIVE = 1u;
static const uint BOUNDARY_PERSISTENT = 8u;
static const uint BOUNDARY_MULTIVIEW = 32u;
static const uint BOUNDARY_ELASTIC_MANIFOLD_LINK = 64u;
static const uint VERTEX_BOUNDARY = 1u << 8u;
static const uint VERTEX_LATENT_CONNECTOR = 1u << 9u;
static const uint MESHLET_HAS_BOUNDARY = 1u << 20u;
static const uint MESHLET_ELASTIC_CONNECTOR = 1u << 21u;
static const uint FILM_HAS_DISPLACEMENT = 1u << 5u;
static const uint PAGE_ACTIVE = 1u;
static const uint BASE_GRID = 16u;
static const uint MICRO_GRID = 8u;
static const uint BASE_CELLS_PER_PAGE = 256u;
static const uint MICRO_CELLS_PER_PAGE = 64u;
static const uint ALLOCATION_CLAIM = 0xffffffffu;

DisplacementCell LoadDisplacementCell(bool micro, uint pageIndex, uint localCell)
{
    DisplacementCell value = (DisplacementCell)0;
    if (micro)
        value = _MicroDisplacementCells[
            pageIndex * MICRO_CELLS_PER_PAGE + localCell];
    else
        value = _BaseDisplacementCells[
            pageIndex * BASE_CELLS_PER_PAGE + localCell];
    return value;
}

uint LoadDisplacementChild(bool micro, uint pageIndex, uint localCell)
{
    uint child = 0u;
    if (micro)
        child = _MicroChildPages[pageIndex * MICRO_CELLS_PER_PAGE + localCell];
    else
        child = _BaseChildPages[pageIndex * BASE_CELLS_PER_PAGE + localCell];
    return child;
}

bool ResolveDisplacementPage(ContactFilmHeader film, float2 uv,
    out bool micro, out uint pageIndex, out DisplacementPageHeader page)
{
    micro = false;
    pageIndex = 0u;
    page = (DisplacementPageHeader)0;
    if (_HasDisplacement == 0u ||
        (film.flags & FILM_HAS_DISPLACEMENT) == 0u ||
        film.displacementPage == 0u ||
        film.displacementPage == ALLOCATION_CLAIM)
        return false;
    pageIndex = film.displacementPage - 1u;
    if (pageIndex >= _BasePageCapacity) return false;
    page = _DisplacementPages[pageIndex];
    if ((page.flags & PAGE_ACTIVE) == 0u || page.filmId != film.id ||
        page.filmGeneration != film.generation) return false;

    float2 normalized = saturate(uv);
    [loop]
    for (uint level = 0u; level < _MaximumMicroLevels; ++level)
    {
        float2 span = max(page.uvBounds.zw - page.uvBounds.xy, 1e-8);
        float2 localUv = saturate((normalized - page.uvBounds.xy) / span);
        uint grid = micro ? MICRO_GRID : BASE_GRID;
        uint2 cell = min((uint2)(localUv * (float)grid), grid - 1u);
        uint childHandle = LoadDisplacementChild(micro, pageIndex,
            cell.y * grid + cell.x);
        if (childHandle == 0u || childHandle == ALLOCATION_CLAIM) break;
        uint childIndex = childHandle - 1u;
        if (childIndex >= _MicroPageCapacity) break;
        DisplacementPageHeader child = (DisplacementPageHeader)0;
        child = _DisplacementPages[_BasePageCapacity + childIndex];
        if ((child.flags & PAGE_ACTIVE) == 0u || child.filmId != film.id ||
            child.filmGeneration != film.generation) break;
        micro = true;
        pageIndex = childIndex;
        page = child;
    }
    return true;
}

void DisplacementMetrics(ContactFilmHeader film, out float bestFootprint,
    out float maximumVariance, out uint deepestLevel)
{
    bestFootprint = max(2.0 * film.extentU, 2.0 * film.extentV);
    maximumVariance = 0.0;
    deepestLevel = 0u;
    if (_HasDisplacement == 0u ||
        (film.flags & FILM_HAS_DISPLACEMENT) == 0u ||
        film.displacementPage == 0u ||
        film.displacementPage == ALLOCATION_CLAIM) return;
    uint pageIndex = film.displacementPage - 1u;
    if (pageIndex >= _BasePageCapacity) return;
    DisplacementPageHeader page = _DisplacementPages[pageIndex];
    if ((page.flags & PAGE_ACTIVE) == 0u || page.filmId != film.id ||
        page.filmGeneration != film.generation) return;
    // Displacement pages persist cone footprint area in square metres. Meshlet
    // tessellation and screen LOD require a linear metric sampling diameter.
    bestFootprint = sqrt(max(asfloat(page.bestFootprintBits), 1e-10));
    maximumVariance = max(asfloat(page.maximumVarianceBits), 0.0);

    // Page headers retain aggregate quality for every resident descendant. Sampling
    // the centre path provides a conservative hierarchy-depth signal without a CPU
    // traversal; variance and footprint still force detail outside that path.
    bool micro = false;
    float2 uv = 0.5;
    [loop]
    for (uint level = 0u; level < _MaximumMicroLevels; ++level)
    {
        float2 span = max(page.uvBounds.zw - page.uvBounds.xy, 1e-8);
        float2 localUv = saturate((uv - page.uvBounds.xy) / span);
        uint grid = micro ? MICRO_GRID : BASE_GRID;
        uint2 cell = min((uint2)(localUv * (float)grid), grid - 1u);
        uint childHandle = LoadDisplacementChild(micro, pageIndex,
            cell.y * grid + cell.x);
        if (childHandle == 0u || childHandle == ALLOCATION_CLAIM) break;
        uint childIndex = childHandle - 1u;
        if (childIndex >= _MicroPageCapacity) break;
        DisplacementPageHeader child =
            _DisplacementPages[_BasePageCapacity + childIndex];
        if ((child.flags & PAGE_ACTIVE) == 0u || child.filmId != film.id ||
            child.filmGeneration != film.generation) break;
        micro = true;
        pageIndex = childIndex;
        page = child;
        deepestLevel = max(deepestLevel, child.level);
        bestFootprint = min(bestFootprint,
            sqrt(max(asfloat(child.bestFootprintBits), 1e-10)));
        maximumVariance = max(maximumVariance,
            max(asfloat(child.maximumVarianceBits), 0.0));
    }
}

float SampleDisplacement(ContactFilmHeader film, float2 uv)
{
    bool micro = false;
    uint pageIndex = 0u;
    DisplacementPageHeader page = (DisplacementPageHeader)0;
    if (!ResolveDisplacementPage(film, uv, micro, pageIndex, page)) return 0.0;
    uint grid = micro ? MICRO_GRID : BASE_GRID;
    float2 span = max(page.uvBounds.zw - page.uvBounds.xy, 1e-8);
    float2 localUv = saturate((uv - page.uvBounds.xy) / span);
    float2 samplePosition = localUv * (float)grid - 0.5;
    int2 lower = (int2)floor(samplePosition);
    float2 fraction = frac(samplePosition);
    uint2 p00 = (uint2)clamp(lower, 0, (int)grid - 1);
    uint2 p10 = uint2(min(p00.x + 1u, grid - 1u), p00.y);
    uint2 p01 = uint2(p00.x, min(p00.y + 1u, grid - 1u));
    uint2 p11 = min(p00 + 1u, grid - 1u);
    float d00 = LoadDisplacementCell(micro, pageIndex,
        p00.y * grid + p00.x).displacement;
    float d10 = LoadDisplacementCell(micro, pageIndex,
        p10.y * grid + p10.x).displacement;
    float d01 = LoadDisplacementCell(micro, pageIndex,
        p01.y * grid + p01.x).displacement;
    float d11 = LoadDisplacementCell(micro, pageIndex,
        p11.y * grid + p11.x).displacement;
    return lerp(lerp(d00, d10, fraction.x),
        lerp(d01, d11, fraction.x), fraction.y);
}

float BootstrapCoverageCell(ContactFilmHeader film, int2 cell)
{
    uint2 clamped = (uint2)clamp(cell, int2(0, 0), int2(7, 7));
    uint bit = clamped.y * 8u + clamped.x;
    bool covered = bit < 32u ?
        ((film.supportMaskLow >> bit) & 1u) != 0u :
        ((film.supportMaskHigh >> (bit - 32u)) & 1u) != 0u;
    return covered ? 1.0 : 0.0;
}

float BootstrapCoverage(ContactFilmHeader film, float2 uv)
{
    // Treat the conservative 8x8 spawn mask as samples at cell centres. Bilinear
    // reconstruction turns it into a continuous canonical support field instead
    // of exposing the storage cells as square pieces of geometry.
    float2 coordinate = saturate(uv) * 8.0 - 0.5;
    int2 lower = (int2)floor(coordinate);
    float2 fraction = frac(coordinate);
    float c00 = BootstrapCoverageCell(film, lower);
    float c10 = BootstrapCoverageCell(film, lower + int2(1, 0));
    float c01 = BootstrapCoverageCell(film, lower + int2(0, 1));
    float c11 = BootstrapCoverageCell(film, lower + int2(1, 1));
    return lerp(lerp(c00, c10, fraction.x),
        lerp(c01, c11, fraction.x), fraction.y);
}

float SurfaceCoverage(ContactFilmHeader film, float2 uv)
{
    // The 16x16 base page is the canonical continuous support domain. Micro pages
    // refine position/normal inside it, while ContactBoundaries refine its contour.
    // Keeping support at the base level makes this hot tessellation query O(1)
    // instead of traversing the displacement hierarchy for every candidate vertex.
    if (_HasDisplacement == 0u ||
        (film.flags & FILM_HAS_DISPLACEMENT) == 0u ||
        film.displacementPage == 0u ||
        film.displacementPage == ALLOCATION_CLAIM)
        return BootstrapCoverage(film, uv);
    uint pageIndex = film.displacementPage - 1u;
    if (pageIndex >= _BasePageCapacity) return BootstrapCoverage(film, uv);
    DisplacementPageHeader page = (DisplacementPageHeader)0;
    page = _DisplacementPages[pageIndex];
    if ((page.flags & PAGE_ACTIVE) == 0u || page.filmId != film.id ||
        page.filmGeneration != film.generation)
        return BootstrapCoverage(film, uv);
    const uint grid = BASE_GRID;
    float2 localUv = saturate(uv);
    // Coverage is an intensive surface-domain field. Reconstruct it continuously
    // from cell-centred samples so tessellation density cannot expose page cells.
    float2 coordinate = localUv * (float)grid - 0.5;
    int2 lower = (int2)floor(coordinate);
    float2 fraction = frac(coordinate);
    int upper = (int)grid - 1;
    uint2 p00 = (uint2)clamp(lower, int2(0, 0), int2(upper, upper));
    uint2 p10 = (uint2)clamp(lower + int2(1, 0), int2(0, 0),
        int2(upper, upper));
    uint2 p01 = (uint2)clamp(lower + int2(0, 1), int2(0, 0),
        int2(upper, upper));
    uint2 p11 = (uint2)clamp(lower + int2(1, 1), int2(0, 0),
        int2(upper, upper));
    float c00 = LoadDisplacementCell(false, pageIndex,
        p00.y * grid + p00.x).coverage;
    float c10 = LoadDisplacementCell(false, pageIndex,
        p10.y * grid + p10.x).coverage;
    float c01 = LoadDisplacementCell(false, pageIndex,
        p01.y * grid + p01.x).coverage;
    float c11 = LoadDisplacementCell(false, pageIndex,
        p11.y * grid + p11.x).coverage;
    return saturate(lerp(lerp(c00, c10, fraction.x),
        lerp(c01, c11, fraction.x), fraction.y));
}

uint BoundaryHashKey(uint filmId, uint generation, uint cellKey)
{
    uint value = filmId * 0x9e3779b9u;
    value ^= generation + 0x85ebca6bu + (value << 6u) + (value >> 2u);
    value ^= cellKey + 0xc2b2ae35u + (value << 6u) + (value >> 2u);
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    return max(1u, value & 0x7fffffffu);
}

float2 BoundaryCubic(ContactBoundaryHeader boundary, float t)
{
    float s = 1.0 - t;
    return s * s * s * boundary.controlUv01.xy +
        3.0 * s * s * t * boundary.controlUv01.zw +
        3.0 * s * t * t * boundary.controlUv23.xy +
        t * t * t * boundary.controlUv23.zw;
}

bool ClosestBoundaryPoint(ContactFilmHeader film, float2 uv,
    out float2 closestUv)
{
    closestUv = uv;
    if (_HasBoundaries == 0u || film.boundaryCount == 0u) return false;
    uint cells = max(_BoundaryCellsPerAxis, 1u);
    int2 center = (int2)min((uint2)(saturate(uv) * (float)cells), cells - 1u);
    float bestDistance = 1e9;
    [unroll]
    for (int cellY = -1; cellY <= 1; ++cellY)
    [unroll]
    for (int cellX = -1; cellX <= 1; ++cellX)
    {
        int2 cell = center + int2(cellX, cellY);
        if (any(cell < 0) || any(cell >= (int)cells)) continue;
        uint cellKey = (uint)cell.x | ((uint)cell.y << 16u);
        uint hash = BoundaryHashKey(film.id, film.generation, cellKey);
        [loop]
        for (uint probe = 0u; probe < 16u; ++probe)
        {
            uint slot = (hash + probe * 0x9e3779b9u) & _BoundaryHashMask;
            BoundaryHashEntry entry = (BoundaryHashEntry)0;
            entry = _BoundaryHash[slot];
            if (entry.hash == 0u) break;
            if (entry.hash != hash || entry.filmId != film.id ||
                entry.filmGeneration != film.generation ||
                entry.cellKey != cellKey || entry.boundaryId == 0u) continue;
            ContactBoundaryHeader boundary = (ContactBoundaryHeader)0;
            boundary = _BoundaryHeaders[entry.boundaryId - 1u];
            if (boundary.filmA != film.id ||
                boundary.filmAGeneration != film.generation ||
                (boundary.flags & (BOUNDARY_ACTIVE | BOUNDARY_PERSISTENT)) !=
                    (BOUNDARY_ACTIVE | BOUNDARY_PERSISTENT)) continue;
            [unroll]
            for (uint sampleIndex = 0u; sampleIndex <= 16u; ++sampleIndex)
            {
                float2 candidate = uv;
                candidate = BoundaryCubic(boundary,
                    (float)sampleIndex / 16.0);
                float distance = length(candidate - uv);
                if (distance < bestDistance)
                {
                    bestDistance = distance;
                    closestUv = candidate;
                }
            }
        }
    }
    return bestDistance <= 0.55 / (float)cells;
}

bool CellTouchesPersistentBoundary(ContactFilmHeader film, float2 uvMinimum,
    float2 uvMaximum)
{
    if (_HasBoundaries == 0u || film.boundaryCount == 0u) return false;
    float2 centre = 0.5 * (uvMinimum + uvMaximum);
    float2 closest = centre;
    if (!ClosestBoundaryPoint(film, centre, closest)) return false;
    float2 halfSpan = 0.5 * (uvMaximum - uvMinimum);
    // This predicate is telemetry/topology evidence only. Geometry remains a
    // connected support manifold; vertices near the persistent curve are snapped by
    // ClosestBoundaryPoint rather than deleting a complete grid cell.
    return all(abs(closest - centre) <= halfSpan * 1.05 + 1e-6);
}

float Height(ContactFilmHeader film, float u, float v, float2 uv)
{
    return film.quadratic0123.x + film.quadratic0123.y * u +
        film.quadratic0123.z * v + film.quadratic0123.w * u * u +
        film.quadratic45.x * u * v + film.quadratic45.y * v * v +
        SampleDisplacement(film, uv);
}

float3 SurfaceNormal(ContactFilmHeader film, float u, float v, float2 uv)
{
    float dhdu = film.quadratic0123.y + 2.0 * film.quadratic0123.w * u +
        film.quadratic45.x * v;
    float dhdv = film.quadratic0123.z + film.quadratic45.x * u +
        2.0 * film.quadratic45.y * v;
    const float epsilon = 1.0 / 1024.0;
    float left = SampleDisplacement(film,
        float2(max(0.0, uv.x - epsilon), uv.y));
    float right = SampleDisplacement(film,
        float2(min(1.0, uv.x + epsilon), uv.y));
    float down = SampleDisplacement(film,
        float2(uv.x, max(0.0, uv.y - epsilon)));
    float up = SampleDisplacement(film,
        float2(uv.x, min(1.0, uv.y + epsilon)));
    dhdu += (right - left) /
        max(4.0 * film.extentU * epsilon, 1e-8);
    dhdv += (up - down) /
        max(4.0 * film.extentV * epsilon, 1e-8);
    float3 du = film.tangentU + dhdu * film.normal;
    float3 dv = film.tangentV + dhdv * film.normal;
    float3 n = normalize(cross(du, dv));
    return dot(n, film.normal) >= 0.0 ? n : -n;
}

bool Reserve(uint counter, uint amount, uint capacity, out uint baseOffset)
{
    baseOffset = 0u;
    [loop]
    for (uint attempt = 0u; attempt < 64u; ++attempt)
    {
        uint current = _MeshletAllocator[counter];
        if (amount > capacity || current > capacity - amount) return false;
        uint observed = 0u;
        InterlockedCompareExchange(_MeshletAllocator[counter], current,
            current + amount, observed);
        if (observed == current)
        {
            baseOffset = current;
            return true;
        }
    }
    return false;
}

uint ChooseSubdivision(ContactFilmHeader film)
{
    float curvatureSag = abs(film.quadratic0123.w) * film.extentU * film.extentU +
        abs(film.quadratic45.x) * film.extentU * film.extentV +
        abs(film.quadratic45.y) * film.extentV * film.extentV;
    float bestFootprint;
    float displacementVariance;
    uint deepestLevel;
    DisplacementMetrics(film, bestFootprint, displacementVariance, deepestLevel);
    float targetError = max(_MinimumTessellationError,
        min(0.01, film.sigmaNormal * lerp(0.8, 0.35, saturate(film.confidence))));
    float displacementError = sqrt(max(displacementVariance, 0.0));
    float physicalSpan = max(2.0 * film.extentU, 2.0 * film.extentV);
    float footprintRequired = physicalSpan / max(bestFootprint, targetError);
    float required = max(sqrt(max(1.0,
        (curvatureSag + displacementError) / targetError)), footprintRequired);
    // Observed coverage carries measurement detail even though it no longer cuts
    // topology. Preserve at least the bootstrap sampling where cone footprints have
    // deposited information.
    if ((film.supportMaskLow | film.supportMaskHigh) != 0u ||
        (film.flags & FILM_HAS_DISPLACEMENT) != 0u)
        required = max(required, 8.0);
    if (film.boundaryCount > 0u) required = max(required, 4.0);
    if (deepestLevel > 0u)
        required = max(required, exp2(min(deepestLevel + 3u, 6u)));
    uint segments = 1u;
    [loop]
    while ((float)segments < required && segments < _MaximumSubdivision)
        segments <<= 1u;
    return min(segments, _MaximumSubdivision);
}

[numthreads(1, 1, 1)]
void ClearMeshletBuild(uint3 id : SV_DispatchThreadID)
{
    _MeshletAllocator[0] = 0u; // vertices
    _MeshletAllocator[1] = 0u; // indices
    _MeshletAllocator[2] = 0u; // overflowed films
    _MeshletAllocator[3] = 0u; // emitted films
    _MeshletAllocator[4] = 0u; // descriptors
    _MeshletAllocator[5] = 0u; // boundary-clipped cells
    _MeshletAllocator[6] = 0u; // reserved
    _MeshletAllocator[7] = 0u; // publication revision
    _MeshDispatchArguments[0] = uint3(0u, 1u, 1u);
    _MeshDispatchArguments[1] = uint3(0u, 1u, 1u);
    _CullDispatchArguments[0] = uint3(0u, 1u, 1u);
    _DrawArguments[0] = uint4(0u, 1u, 0u, 0u);
}

[numthreads(1, 1, 1)]
void BuildMeshDispatchArguments(uint3 id : SV_DispatchThreadID)
{
    uint filmCount = min(_FilmAllocator[0], _FilmCapacity);
    // One workgroup owns one film. Its 8x8 lanes cooperate on vertices and cells;
    // the old one-thread-per-film kernel serialized up to 289 vertex evaluations
    // and 512 triangle decisions in a single mobile-GPU lane.
    _MeshDispatchArguments[0] = uint3(filmCount, 1u, 1u);
    uint boundaryCount = _HasBoundaries != 0u ? _BoundaryAllocator[0] : 0u;
    _MeshDispatchArguments[1] = uint3((boundaryCount + 63u) / 64u, 1u, 1u);
}

groupshared uint sBuildValid;
groupshared uint sSegments;
groupshared uint sRowVertices;
groupshared uint sVertexCount;
groupshared uint sVertexBase;
groupshared uint sDescriptorIndex;
groupshared uint sIndexBase;
groupshared uint sTriangleCount;
groupshared uint sWriteTriangle;
groupshared float sCoverage[289]; // maximum (16 + 1)^2 chart vertices

[numthreads(8, 8, 1)]
void BuildAdaptiveFilmMeshlets(uint3 groupId : SV_GroupID,
    uint groupIndex : SV_GroupIndex)
{
    uint filmIndex = groupId.x;
    if (groupIndex == 0u)
    {
        sBuildValid = 0u;
        sTriangleCount = 0u;
        sWriteTriangle = 0u;
        sVertexBase = 0u;
        sDescriptorIndex = 0u;
        sIndexBase = 0u;
        uint filmCount = min(_FilmAllocator[0], _FilmCapacity);
        if (filmIndex < filmCount)
        {
            ContactFilmHeader candidate = _FilmHeaders[filmIndex];
            if ((candidate.flags & FILM_ACTIVE) != 0u)
            {
                sSegments = ChooseSubdivision(candidate);
                sRowVertices = sSegments + 1u;
                sVertexCount = sRowVertices * sRowVertices;
                sBuildValid = 1u;
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (sBuildValid == 0u) return;

    ContactFilmHeader film = _FilmHeaders[filmIndex];
    uint segments = sSegments;
    uint rowVertices = sRowVertices;
    uint vertexBase = 0u;

    // Resolve observation confidence first. The complete chart remains an elastic
    // sheet; coverage controls certainty/detail and never removes topology.
    for (uint coverageOrdinal = groupIndex;
        coverageOrdinal < sVertexCount; coverageOrdinal += 64u)
    {
        uint x = coverageOrdinal % rowVertices;
        uint y = coverageOrdinal / rowVertices;
        float2 uv = float2((float)x, (float)y) / (float)segments;
        sCoverage[coverageOrdinal] = SurfaceCoverage(film, uv);
    }
    GroupMemoryBarrierWithGroupSync();

    uint cellCount = segments * segments;
    // Every logical chart cell owns two triangles. Coverage is measurement
    // information only; even a non-finite/corrupt confidence sample must not turn
    // into a topology deletion. Vertex confidence sanitizes that field separately.
    if (groupIndex == 0u) sTriangleCount = cellCount * 2u;
    GroupMemoryBarrierWithGroupSync();

    if (groupIndex == 0u)
    {
        if (sTriangleCount == 0u)
            sBuildValid = 0u;
        else if (!Reserve(0u, sVertexCount, _VertexCapacity, sVertexBase))
        {
            InterlockedAdd(_MeshletAllocator[2], 1u);
            sBuildValid = 0u;
        }
        else if (!Reserve(4u, 1u, _DescriptorCapacity, sDescriptorIndex))
        {
            InterlockedAdd(_MeshletAllocator[2], 1u);
            sBuildValid = 0u;
        }
        else
        {
            _MeshletDescriptors[sDescriptorIndex] = (ContactMeshletDescriptor)0;
            uint indexCount = sTriangleCount * 3u;
            if (!Reserve(1u, indexCount, _IndexCapacity, sIndexBase))
            {
                InterlockedAdd(_MeshletAllocator[2], 1u);
                sBuildValid = 0u;
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (sBuildValid == 0u) return;

    vertexBase = sVertexBase;
    // Materialize the complete connected chart lattice in parallel. Contact support
    // modulates posterior confidence while latent cells remain deformable material.
    for (uint vertexOrdinal = groupIndex;
        vertexOrdinal < sVertexCount; vertexOrdinal += 64u)
    {
        uint x = vertexOrdinal % rowVertices;
        uint y = vertexOrdinal / rowVertices;
        float2 uv = float2((float)x, (float)y) / (float)segments;
        float2 surfaceUv;
        bool onBoundary = ClosestBoundaryPoint(film, uv, surfaceUv);
        if (!onBoundary) surfaceUv = uv;
        float u = lerp(-film.extentU, film.extentU, surfaceUv.x);
        float v = lerp(-film.extentV, film.extentV, surfaceUv.y);
        ContactMeshletVertex vertex;
        vertex.position = film.origin + u * film.tangentU + v * film.tangentV +
            Height(film, u, v, surfaceUv) * film.normal;
        vertex.filmId = film.id;
        vertex.normal = SurfaceNormal(film, u, v, surfaceUv);
        vertex.generation = film.generation;
        vertex.uv = surfaceUv;
        vertex.sigma = film.sigmaNormal;
        float observedConfidence = isfinite(sCoverage[vertexOrdinal]) ?
            saturate(sCoverage[vertexOrdinal]) : 0.0;
        vertex.confidence = film.confidence * lerp(0.2, 1.0,
            observedConfidence);
        vertex.sidedness = 1u;
        vertex.flags = film.flags | (onBoundary ? VERTEX_BOUNDARY : 0u);
        vertex.reserved0 = film.appearancePage;
        vertex.reserved1 = asuint(observedConfidence);
        _ContactVertices[vertexBase + vertexOrdinal] = vertex;
    }

    for (uint emitCellOrdinal = groupIndex; emitCellOrdinal < cellCount;
        emitCellOrdinal += 64u)
    {
        uint cellX = emitCellOrdinal % segments;
        uint cellY = emitCellOrdinal / segments;
        float2 uvMinimum = float2((float)cellX, (float)cellY) /
            (float)segments;
        float2 uvMaximum = float2((float)(cellX + 1u),
            (float)(cellY + 1u)) / (float)segments;
        if (CellTouchesPersistentBoundary(film, uvMinimum, uvMaximum))
            InterlockedAdd(_MeshletAllocator[5], 1u);
        uint local00 = cellY * rowVertices + cellX;
        uint local10 = local00 + 1u;
        uint local01 = local00 + rowVertices;
        uint local11 = local01 + 1u;
        uint triangleSlot;
        InterlockedAdd(sWriteTriangle, 2u, triangleSlot);
        uint writeIndex = sIndexBase + triangleSlot * 3u;
        _ContactIndices[writeIndex + 0u] = vertexBase + local00;
        _ContactIndices[writeIndex + 1u] = vertexBase + local10;
        _ContactIndices[writeIndex + 2u] = vertexBase + local01;
        _ContactIndices[writeIndex + 3u] = vertexBase + local01;
        _ContactIndices[writeIndex + 4u] = vertexBase + local10;
        _ContactIndices[writeIndex + 5u] = vertexBase + local11;
    }
    GroupMemoryBarrierWithGroupSync();
    if (groupIndex != 0u) return;

    float bestFootprint;
    float displacementVariance;
    uint deepestLevel;
    DisplacementMetrics(film, bestFootprint, displacementVariance, deepestLevel);
    float curvatureSag = abs(film.quadratic0123.w) * film.extentU * film.extentU +
        abs(film.quadratic45.x) * film.extentU * film.extentV +
        abs(film.quadratic45.y) * film.extentV * film.extentV;
    float2 centreUv = 0.5;
    float centreU = 0.0;
    float centreV = 0.0;
    ContactMeshletDescriptor descriptor;
    descriptor.filmId = film.id;
    descriptor.generation = film.generation;
    descriptor.vertexBase = sVertexBase;
    descriptor.maximumSegments = segments;
    descriptor.center = film.origin + Height(film, centreU, centreV, centreUv) *
        film.normal;
    descriptor.radius = sqrt(film.extentU * film.extentU +
        film.extentV * film.extentV) + abs(curvatureSag) +
        3.0 * film.sigmaNormal;
    descriptor.uvBounds = float4(0.0, 0.0, 1.0, 1.0);
    descriptor.geometricError = max(_MinimumTessellationError,
        max(curvatureSag, sqrt(max(displacementVariance, 0.0))));
    descriptor.detailFootprint = max(bestFootprint, _MinimumTessellationError);
    descriptor.confidence = film.confidence;
    descriptor.appearancePage = film.appearancePage;
    descriptor.flags = film.flags | (deepestLevel << 24u) |
        (film.boundaryCount > 0u ? MESHLET_HAS_BOUNDARY : 0u);
    descriptor.sourceIndexBase = sIndexBase;
    descriptor.sourceIndexCount = sTriangleCount * 3u;
    descriptor.reserved = filmIndex;
    _MeshletDescriptors[sDescriptorIndex] = descriptor;
    InterlockedAdd(_MeshletAllocator[3], 1u);
}

// ContactFilm rectangles are only local coordinates on one conserved membrane.
// A multi-view-supported FilmA/FilmB ContactBoundary is the canonical adjacency edge between
// two such coordinates. Materialize that edge as a narrow elastic curtain/crease so
// internal chart borders can never become holes or independent plates. This strip is
// latent (FilmId=0): it is visible as connected membrane but cannot masquerade as a
// measured first-hit contact in the prediction raster.
static const uint CONNECTOR_SEGMENTS = 8u;
static const uint CONNECTOR_VERTICES = (CONNECTOR_SEGMENTS + 1u) * 2u;
static const uint CONNECTOR_INDICES = CONNECTOR_SEGMENTS * 6u;

float2 ProjectToFilmUv(ContactFilmHeader film, float3 point)
{
    float3 delta = point - film.origin;
    return float2(
        dot(delta, film.tangentU) / max(2.0 * film.extentU, 0.002) + 0.5,
        dot(delta, film.tangentV) / max(2.0 * film.extentV, 0.002) + 0.5);
}

float3 FilmPoint(ContactFilmHeader film, float2 uv)
{
    uv = saturate(uv);
    float u = lerp(-film.extentU, film.extentU, uv.x);
    float v = lerp(-film.extentV, film.extentV, uv.y);
    return film.origin + u * film.tangentU + v * film.tangentV +
        Height(film, u, v, uv) * film.normal;
}

float3 ConnectorNormal(ContactBoundaryHeader boundary,
    ContactFilmHeader filmA, ContactFilmHeader filmB, float t)
{
    float step = 1.0 / (float)CONNECTOR_SEGMENTS;
    float t0 = max(0.0, t - step);
    float t1 = min(1.0, t + step);
    float2 uvA0 = BoundaryCubic(boundary, t0);
    float2 uvA1 = BoundaryCubic(boundary, t1);
    float3 a0 = FilmPoint(filmA, uvA0);
    float3 a1 = FilmPoint(filmA, uvA1);
    float3 b0 = FilmPoint(filmB, ProjectToFilmUv(filmB, a0));
    float3 b1 = FilmPoint(filmB, ProjectToFilmUv(filmB, a1));
    float3 along = a1 + b1 - a0 - b0;
    float2 uvA = BoundaryCubic(boundary, t);
    float3 a = FilmPoint(filmA, uvA);
    float3 b = FilmPoint(filmB, ProjectToFilmUv(filmB, a));
    float3 across = b - a;
    float3 normal = cross(along, across);
    float normalLength = length(normal);
    float3 preferred = filmA.normal + filmB.normal;
    if (normalLength <= 1e-7 || !isfinite(normalLength))
        normal = length(preferred) > 1e-5 ? normalize(preferred) : filmA.normal;
    else
        normal /= normalLength;
    if (length(preferred) > 1e-5 && dot(normal, preferred) < 0.0)
        normal = -normal;
    return normal;
}

[numthreads(64, 1, 1)]
void BuildElasticBoundaryMeshlets(uint3 id : SV_DispatchThreadID)
{
    uint boundaryCount = _HasBoundaries != 0u ? _BoundaryAllocator[0] : 0u;
    uint boundaryIndex = id.x;
    if (boundaryIndex >= boundaryCount) return;
    ContactBoundaryHeader boundary = _BoundaryHeaders[boundaryIndex];
    uint required = BOUNDARY_ACTIVE | BOUNDARY_ELASTIC_MANIFOLD_LINK;
    bool topologySupported = (boundary.flags & (BOUNDARY_PERSISTENT |
        BOUNDARY_MULTIVIEW)) != 0u;
    if ((boundary.flags & required) != required || !topologySupported ||
        boundary.filmA == 0u ||
        boundary.filmB == 0u || boundary.filmA > _FilmCapacity ||
        boundary.filmB > _FilmCapacity) return;

    ContactFilmHeader filmA = _FilmHeaders[boundary.filmA - 1u];
    ContactFilmHeader filmB = _FilmHeaders[boundary.filmB - 1u];
    if (filmA.id != boundary.filmA ||
        filmA.generation != boundary.filmAGeneration ||
        filmB.id != boundary.filmB ||
        filmB.generation != boundary.filmBGeneration ||
        (filmA.flags & FILM_ACTIVE) == 0u ||
        (filmB.flags & FILM_ACTIVE) == 0u) return;

    uint vertexBase, descriptorIndex, indexBase;
    if (!Reserve(0u, CONNECTOR_VERTICES, _VertexCapacity, vertexBase) ||
        !Reserve(4u, 1u, _DescriptorCapacity, descriptorIndex) ||
        !Reserve(1u, CONNECTOR_INDICES, _IndexCapacity, indexBase))
    {
        InterlockedAdd(_MeshletAllocator[2], 1u);
        return;
    }

    float metricSigma = max(_BoundaryInformation[boundaryIndex * 8u + 3u].w,
        max(filmA.sigmaNormal, filmB.sigmaNormal));
    float confidence = 0.08 + 0.27 * saturate(boundary.confidence);
    float3 boundsCentre = 0.0;
    [unroll]
    for (uint sample = 0u; sample <= CONNECTOR_SEGMENTS; ++sample)
    {
        float t = (float)sample / (float)CONNECTOR_SEGMENTS;
        float2 uvA = BoundaryCubic(boundary, t);
        float3 pointA = FilmPoint(filmA, uvA);
        float2 uvB = saturate(ProjectToFilmUv(filmB, pointA));
        float3 pointB = FilmPoint(filmB, uvB);
        float3 normal = ConnectorNormal(boundary, filmA, filmB, t);
        float separation = length(pointB - pointA);
        float sigma = max(0.02, metricSigma + 0.5 * separation);

        ContactMeshletVertex vertexA = (ContactMeshletVertex)0;
        vertexA.position = pointA;
        vertexA.normal = normal;
        vertexA.uv = float2(t, 0.0);
        vertexA.sigma = sigma;
        vertexA.confidence = confidence;
        vertexA.sidedness = 1u;
        vertexA.flags = VERTEX_LATENT_CONNECTOR;
        ContactMeshletVertex vertexB = vertexA;
        vertexB.position = pointB;
        vertexB.uv.y = 1.0;
        _ContactVertices[vertexBase + sample * 2u] = vertexA;
        _ContactVertices[vertexBase + sample * 2u + 1u] = vertexB;
        boundsCentre += pointA + pointB;
    }
    boundsCentre /= (float)CONNECTOR_VERTICES;

    [unroll]
    for (uint segment = 0u; segment < CONNECTOR_SEGMENTS; ++segment)
    {
        uint a0 = vertexBase + segment * 2u;
        uint b0 = a0 + 1u;
        uint a1 = a0 + 2u;
        uint b1 = a0 + 3u;
        uint write = indexBase + segment * 6u;
        _ContactIndices[write + 0u] = a0;
        _ContactIndices[write + 1u] = a1;
        _ContactIndices[write + 2u] = b0;
        _ContactIndices[write + 3u] = b0;
        _ContactIndices[write + 4u] = a1;
        _ContactIndices[write + 5u] = b1;
    }

    float radius = metricSigma;
    [unroll]
    for (uint endpoint = 0u; endpoint < 4u; ++endpoint)
    {
        float t = endpoint < 2u ? 0.0 : 1.0;
        float3 pointA = FilmPoint(filmA, BoundaryCubic(boundary, t));
        float3 pointB = FilmPoint(filmB, ProjectToFilmUv(filmB, pointA));
        radius = max(radius, length(pointA - boundsCentre));
        radius = max(radius, length(pointB - boundsCentre));
    }
    ContactMeshletDescriptor descriptor = (ContactMeshletDescriptor)0;
    descriptor.filmId = boundary.filmA;
    descriptor.generation = boundary.filmAGeneration;
    descriptor.vertexBase = vertexBase;
    descriptor.maximumSegments = CONNECTOR_SEGMENTS;
    descriptor.center = boundsCentre;
    descriptor.radius = max(radius, 0.001);
    descriptor.uvBounds = float4(0, 0, 1, 1);
    descriptor.geometricError = metricSigma;
    descriptor.detailFootprint = max(metricSigma, 0.001);
    descriptor.confidence = confidence;
    descriptor.flags = MESHLET_HAS_BOUNDARY | MESHLET_ELASTIC_CONNECTOR;
    descriptor.sourceIndexBase = indexBase;
    descriptor.sourceIndexCount = CONNECTOR_INDICES;
    descriptor.reserved = boundaryIndex;
    _MeshletDescriptors[descriptorIndex] = descriptor;
    InterlockedAdd(_MeshletAllocator[3], 1u);
}

[numthreads(1, 1, 1)]
void FinalizeMeshletDrawArguments(uint3 id : SV_DispatchThreadID)
{
    _DrawArguments[0] = uint4(min(_MeshletAllocator[1], _IndexCapacity),
        1u, 0u, 0u);
    _CullDispatchArguments[0] = uint3(
        (min(_MeshletAllocator[4], _DescriptorCapacity) + 63u) / 64u,
        1u, 1u);
}
