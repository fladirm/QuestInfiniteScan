#pragma kernel ClearSplitPlanning
#pragma kernel AccumulateBoundarySplitProposals
#pragma kernel BuildEvidenceAlignedSplitPlans
#pragma kernel ReserveSplitTransactions

#include "PressureManifoldAtlasAbi.hlsl"
#include "BoundaryCurveAtlasAbi.hlsl"

struct DisplacementPageHeader
{
    uint id; uint generation; uint filmId; uint filmGeneration;
    uint level; uint parentPage; uint parentCell; uint flags;
    float4 uvBounds;
    uint bestFootprintBits; uint maximumVarianceBits; uint supportFixed; uint revision;
};

struct DisplacementCell
{
    float displacement; float sigma; float support; float coverage;
    float bestPrecision; float bestFootprint; float residualVariance;
    float preHitPressure; uint preHitPressureViewMask; uint revision;
};

struct ContactTopologyEvidence
{
    float positiveMoment; float positiveSupport;
    float negativeMoment; float negativeSupport;
    float residualVariance; float boundarySupport; float totalSupport;
    uint revision;
};

struct FilmSlotState
{
    uint generation; uint activeOrdinal; uint nextFree; uint flags;
};

StructuredBuffer<AtlasContactFilmHeader> _FilmHeaders;
StructuredBuffer<uint> _ActiveFilmIndices;
StructuredBuffer<ContactTopologyEvidence> _TopologyEvidence;
StructuredBuffer<DisplacementPageHeader> _DisplacementPages;
StructuredBuffer<DisplacementCell> _BaseDisplacementCells;
StructuredBuffer<AtlasContactBoundaryHeader> _BoundaryHeaders;
StructuredBuffer<BoundaryCurveTopology> _BoundaryCurveTopology;
StructuredBuffer<BoundaryCurveCache> _BoundaryCurveCache;
StructuredBuffer<uint> _BoundaryAllocator;
RWStructuredBuffer<uint> _SplitProposalKeys;
RWStructuredBuffer<EvidenceAlignedSplitPlan> _SplitPlans;
RWStructuredBuffer<uint> _SplitRecordIndices;
RWStructuredBuffer<uint> _SplitState;
RWStructuredBuffer<uint3> _SplitDispatchArguments;
RWStructuredBuffer<uint> _FilmAllocator;
RWStructuredBuffer<FilmSlotState> _FilmSlotStates;
RWStructuredBuffer<uint> _DisplacementAllocator;

uint _FilmCapacity;
uint _BoundaryCapacity;
uint _BasePageCapacity;
uint _MaximumSplitDepth;
uint _MaximumSplitsPerTick;
float _MinimumSplitExtent;
float _BimodalSeparation;
float _SplitVariance;
float _SplitBoundarySupport;

static const uint FILM_ACTIVE = 1u;
static const uint FILM_SPLIT_PARENT = 1u << 6u;
static const uint FILM_RETIRED = 1u << 7u;
static const uint FILM_TOPOLOGY_LOCKED = 1u << 8u;
static const uint SLOT_ALLOCATED = 1u;
static const uint SLOT_ACTIVE = 1u << 1u;
static const uint SLOT_DIRTY = 1u << 2u;
static const uint SLOT_FREE = 1u << 3u;
static const uint PAGE_ACTIVE = 1u;
static const uint PAGE_BASE = 1u << 1u;
static const uint BOUNDARY_ID_BITS = 18u;
static const uint BOUNDARY_ID_MASK = (1u << BOUNDARY_ID_BITS) - 1u;
static const uint SPLIT_ELIGIBLE = 1u;
static const uint SPLIT_RESERVED = 2u;
static const uint INVALID_INDEX = 0xffffffffu;
static const uint BASE_CELLS = 256u;

uint ActiveFilmCount() { return min(_FilmAllocator[6], _FilmCapacity); }

float4 BoundarySegment(BoundaryCurveCache cache, bool sideA, uint index)
{
    if (sideA)
        return index == 0u ? cache.segmentA0 : index == 1u ? cache.segmentA1 :
            index == 2u ? cache.segmentA2 : cache.segmentA3;
    return index == 0u ? cache.segmentB0 : index == 1u ? cache.segmentB1 :
        index == 2u ? cache.segmentB2 : cache.segmentB3;
}

float Coverage(AtlasContactFilmHeader film, float2 uv)
{
    if (film.displacementPage != 0u)
    {
        uint pageIndex = film.displacementPage - 1u;
        if (pageIndex < _BasePageCapacity)
        {
            DisplacementPageHeader page = _DisplacementPages[pageIndex];
            if ((page.flags & (PAGE_ACTIVE | PAGE_BASE)) ==
                    (PAGE_ACTIVE | PAGE_BASE) && page.filmId == film.id &&
                page.filmGeneration == film.generation)
            {
                uint2 cell = min((uint2)(saturate(uv) * 16.0), 15u);
                return saturate(_BaseDisplacementCells[
                    pageIndex * BASE_CELLS + cell.y * 16u + cell.x].coverage);
            }
        }
    }
    uint2 coarse = min((uint2)(saturate(uv) * 8.0), 7u);
    uint bit = coarse.y * 8u + coarse.x;
    return (float)(bit < 32u ? (film.supportMaskLow >> bit) & 1u :
        (film.supportMaskHigh >> (bit - 32u)) & 1u);
}

bool ValidParent(AtlasContactFilmHeader film)
{
    return film.id > 0u && (film.flags & FILM_ACTIVE) != 0u &&
        (film.flags & (FILM_SPLIT_PARENT | FILM_RETIRED |
            FILM_TOPOLOGY_LOCKED)) == 0u &&
        min(film.extentU, film.extentV) >= _MinimumSplitExtent &&
        (film.reserved2 & 0x3fffffffu) < _MaximumSplitDepth;
}

void ProposeBoundary(uint filmId, uint filmGeneration, uint boundaryIndex,
    bool sideA, AtlasContactBoundaryHeader boundary,
    BoundaryCurveTopology topology, BoundaryCurveCache cache)
{
    if (filmId == 0u || filmId > _FilmCapacity ||
        boundaryIndex > BOUNDARY_ID_MASK ||
        boundary.support < _SplitBoundarySupport) return;
    AtlasContactFilmHeader film = _FilmHeaders[filmId - 1u];
    if (film.generation != filmGeneration || !ValidParent(film)) return;
    float4 first = BoundarySegment(cache, sideA, 0u);
    float4 last = BoundarySegment(cache, sideA, 3u);
    float2 start = first.xy;
    float2 end = last.zw;
    float2 tangent = end - start;
    float lengthUv = length(tangent);
    if (lengthUv < 0.12) return;
    float2 normal = float2(-tangent.y, tangent.x) / max(lengthUv, 1e-6);
    float2 middle = 0.5 * (start + end);
    bool interior = middle.x > 0.04 && middle.x < 0.96 &&
        middle.y > 0.04 && middle.y < 0.96;
    float probe = 0.04;
    float coveragePositive = Coverage(film, middle + normal * probe);
    float coverageNegative = Coverage(film, middle - normal * probe);
    if (!interior || min(coveragePositive, coverageNegative) < 0.25) return;
    float quality = saturate(boundary.confidence) *
        saturate(topology.visibilityScore) *
        saturate(topology.poseCalibrationQuality) *
        saturate((float)countbits(topology.independentViewMask) / 4.0) *
        saturate(lengthUv);
    if (quality <= 0.02) return;
    uint score = min(16383u, (uint)round(quality * 16383.0));
    uint tie = BOUNDARY_ID_MASK - boundaryIndex;
    uint key = (score << BOUNDARY_ID_BITS) | tie;
    InterlockedMax(_SplitProposalKeys[filmId - 1u], key);
}

[numthreads(64, 1, 1)]
void ClearSplitPlanning(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _FilmCapacity)
    {
        _SplitProposalKeys[id.x] = 0u;
        _SplitPlans[id.x] = (EvidenceAlignedSplitPlan)0;
        _SplitRecordIndices[id.x] = INVALID_INDEX;
    }
    if (id.x == 0u)
    {
        [unroll] for (uint word = 0u; word < 8u; ++word)
            _SplitState[word] = 0u;
        [unroll] for (uint argument = 0u; argument < 4u; ++argument)
            _SplitDispatchArguments[argument] = uint3(0u, 1u, 1u);
    }
}

[numthreads(64, 1, 1)]
void AccumulateBoundarySplitProposals(uint3 id : SV_DispatchThreadID)
{
    uint boundaryIndex = id.x;
    uint count = min(_BoundaryAllocator[0], _BoundaryCapacity);
    if (boundaryIndex >= count) return;
    AtlasContactBoundaryHeader boundary = _BoundaryHeaders[boundaryIndex];
    BoundaryCurveTopology topology = _BoundaryCurveTopology[boundaryIndex];
    BoundaryCurveCache cache = _BoundaryCurveCache[boundaryIndex];
    if (boundary.id != boundaryIndex + 1u ||
        (boundary.flags & (BOUNDARY_ACTIVE | BOUNDARY_PERSISTENT |
            BOUNDARY_MULTIVIEW)) != (BOUNDARY_ACTIVE | BOUNDARY_PERSISTENT |
            BOUNDARY_MULTIVIEW) ||
        (topology.flags & (BOUNDARY_TOPOLOGY_ACTIVE |
            BOUNDARY_TOPOLOGY_MULTIVIEW)) != (BOUNDARY_TOPOLOGY_ACTIVE |
            BOUNDARY_TOPOLOGY_MULTIVIEW) ||
        (cache.flags & BOUNDARY_TOPOLOGY_ACTIVE) == 0u) return;
    ProposeBoundary(boundary.filmA, boundary.filmAGeneration, boundaryIndex,
        true, boundary, topology, cache);
    if ((cache.flags & BOUNDARY_TOPOLOGY_SHARED) != 0u)
        ProposeBoundary(boundary.filmB, boundary.filmBGeneration,
            boundaryIndex, false, boundary, topology, cache);
}

float SignedLine(float4 separator, float2 uv)
{
    return dot(separator.xy, uv) + separator.z;
}

void ComponentFractions(AtlasContactFilmHeader film, float4 separator,
    out float2 fractions)
{
    float2 weights = 0.0;
    if (film.displacementPage != 0u && film.displacementPage - 1u <
        _BasePageCapacity)
    {
        uint page = film.displacementPage - 1u;
        [loop] for (uint cell = 0u; cell < BASE_CELLS; ++cell)
        {
            float2 uv = (float2(cell & 15u, cell >> 4u) + 0.5) / 16.0;
            float support = max(_BaseDisplacementCells[
                page * BASE_CELLS + cell].coverage, 0.0);
            if (SignedLine(separator, uv) >= 0.0) weights.x += support;
            else weights.y += support;
        }
    }
    float total = weights.x + weights.y;
    fractions = total > 1e-5 ? weights / total : 0.5;
}

bool BimodalSeparator(AtlasContactFilmHeader film,
    ContactTopologyEvidence evidence, out float4 separator,
    out float separation)
{
    separator = float4(0.0, 0.0, 0.0, 0.0); separation = 0.0;
    if (film.displacementPage == 0u || film.displacementPage - 1u >=
        _BasePageCapacity || evidence.totalSupport < 8.0 ||
        evidence.residualVariance < _SplitVariance) return false;
    float positiveMean = evidence.positiveSupport > 0.0 ?
        evidence.positiveMoment / evidence.positiveSupport : 0.0;
    float negativeMean = evidence.negativeSupport > 0.0 ?
        evidence.negativeMoment / evidence.negativeSupport : 0.0;
    separation = positiveMean - negativeMean;
    if (evidence.positiveSupport < 4.0 || evidence.negativeSupport < 4.0 ||
        separation < max(_BimodalSeparation, 4.0 * film.sigmaNormal))
        return false;
    uint page = film.displacementPage - 1u;
    float weightPositive = 0.0, weightNegative = 0.0;
    float2 centrePositive = 0.0, centreNegative = 0.0;
    [loop] for (uint cell = 0u; cell < BASE_CELLS; ++cell)
    {
        DisplacementCell sample = _BaseDisplacementCells[
            page * BASE_CELLS + cell];
        float2 uv = (float2(cell & 15u, cell >> 4u) + 0.5) / 16.0;
        float weight = max(sample.support * sample.coverage, 0.0);
        if (sample.displacement >= 0.0)
        { centrePositive += uv * weight; weightPositive += weight; }
        else
        { centreNegative += uv * weight; weightNegative += weight; }
    }
    if (min(weightPositive, weightNegative) < 1.0) return false;
    centrePositive /= weightPositive; centreNegative /= weightNegative;
    float2 direction = centrePositive - centreNegative;
    float domainSeparation = length(direction);
    if (domainSeparation < 0.10) return false;
    float2 normal = direction / domainSeparation;
    float2 middle = 0.5 * (centrePositive + centreNegative);
    separator = float4(normal, -dot(normal, middle), 1.0);
    return true;
}

[numthreads(64, 1, 1)]
void BuildEvidenceAlignedSplitPlans(uint3 id : SV_DispatchThreadID)
{
    uint ordinal = id.x;
    if (ordinal >= ActiveFilmCount()) return;
    uint filmIndex = _ActiveFilmIndices[ordinal];
    if (filmIndex >= _FilmCapacity) return;
    AtlasContactFilmHeader film = _FilmHeaders[filmIndex];
    if (!ValidParent(film)) return;
    EvidenceAlignedSplitPlan plan = (EvidenceAlignedSplitPlan)0;
    plan.parentFilmIndex = filmIndex;
    plan.parentFilmGeneration = film.generation;
    plan.parentActiveOrdinal = ordinal;
    uint proposal = _SplitProposalKeys[filmIndex];
    uint score = proposal >> BOUNDARY_ID_BITS;
    if (score > 0u)
    {
        uint boundaryIndex = BOUNDARY_ID_MASK - (proposal & BOUNDARY_ID_MASK);
        if (boundaryIndex >= _BoundaryCapacity) return;
        AtlasContactBoundaryHeader boundary = _BoundaryHeaders[boundaryIndex];
        BoundaryCurveCache cache = _BoundaryCurveCache[boundaryIndex];
        bool sideA = boundary.filmA == film.id &&
            boundary.filmAGeneration == film.generation;
        bool sideB = boundary.filmB == film.id &&
            boundary.filmBGeneration == film.generation;
        if (sideA == sideB) return;
        float4 first = BoundarySegment(cache, sideA, 0u);
        float4 last = BoundarySegment(cache, sideA, 3u);
        float2 start = first.xy; float2 end = last.zw;
        float2 tangent = end - start;
        float lengthUv = length(tangent);
        if (lengthUv < 0.12) return;
        float2 normal = float2(-tangent.y, tangent.x) / lengthUv;
        float2 middle = 0.5 * (start + end);
        plan.separatorUv = float4(normal, -dot(normal, middle),
            (float)score / 16383.0);
        plan.boundaryId = boundary.id;
        plan.boundaryGeneration = boundary.generation;
        plan.splitKind = 1u;
        plan.confidence = plan.separatorUv.w;
    }
    else
    {
        float separation;
        if (!BimodalSeparator(film, _TopologyEvidence[filmIndex],
            plan.separatorUv, separation)) return;
        plan.splitKind = 2u;
        plan.separation = separation;
        plan.confidence = saturate(separation /
            max(8.0 * film.sigmaNormal, 0.001));
    }
    ComponentFractions(film, plan.separatorUv, plan.childFractions);
    if (min(plan.childFractions.x, plan.childFractions.y) < 0.12) return;
    plan.transactionState = SPLIT_ELIGIBLE;
    _SplitPlans[filmIndex] = plan;
}

bool ReserveFilmSlot(out uint slot, out uint generation)
{
    slot = INVALID_INDEX; generation = 0u;
    uint head = _FilmAllocator[4];
    FilmSlotState state = (FilmSlotState)0;
    if (head != 0u)
    {
        uint candidate = head - 1u;
        if (candidate >= _FilmCapacity || _FilmAllocator[5] == 0u) return false;
        state = _FilmSlotStates[candidate];
        if ((state.flags & SLOT_FREE) == 0u) return false;
        _FilmAllocator[4] = state.nextFree;
        _FilmAllocator[5]--;
        slot = candidate;
    }
    else
    {
        slot = _FilmAllocator[0];
        if (slot >= _FilmCapacity) { slot = INVALID_INDEX; return false; }
        _FilmAllocator[0] = slot + 1u;
        state = _FilmSlotStates[slot];
    }
    generation = state.generation + 1u;
    if (generation == 0u) generation = 1u;
    state.generation = generation; state.activeOrdinal = INVALID_INDEX;
    state.nextFree = 0u; state.flags = SLOT_ALLOCATED;
    _FilmSlotStates[slot] = state;
    return true;
}

void ReturnFilmSlot(uint slot)
{
    if (slot == INVALID_INDEX || slot >= _FilmCapacity) return;
    FilmSlotState state = _FilmSlotStates[slot];
    state.activeOrdinal = INVALID_INDEX;
    state.nextFree = _FilmAllocator[4];
    state.flags = SLOT_FREE;
    _FilmSlotStates[slot] = state;
    _FilmAllocator[4] = slot + 1u;
    _FilmAllocator[5]++;
}

[numthreads(1, 1, 1)]
void ReserveSplitTransactions(uint3 id : SV_DispatchThreadID)
{
    uint activeBefore = ActiveFilmCount();
    uint dirtyBefore = min(_FilmAllocator[7], _FilmCapacity);
    uint displacementBefore = _DisplacementAllocator[0];
    uint accepted = 0u;
    [loop]
    for (uint ordinal = 0u; ordinal < activeBefore &&
        accepted < _MaximumSplitsPerTick; ++ordinal)
    {
        uint filmIndex = _ActiveFilmIndices[ordinal];
        if (filmIndex >= _FilmCapacity) continue;
        EvidenceAlignedSplitPlan plan = _SplitPlans[filmIndex];
        AtlasContactFilmHeader film = _FilmHeaders[filmIndex];
        FilmSlotState parentState = _FilmSlotStates[filmIndex];
        if (plan.transactionState != SPLIT_ELIGIBLE ||
            film.generation != plan.parentFilmGeneration ||
            parentState.generation != film.generation ||
            parentState.activeOrdinal != ordinal ||
            activeBefore + accepted >= _FilmCapacity ||
            dirtyBefore + (accepted + 1u) * 2u > _FilmCapacity ||
            displacementBefore + (accepted + 1u) * 2u > _BasePageCapacity)
            continue;
        uint child0, child1, generation0, generation1;
        if (!ReserveFilmSlot(child0, generation0)) continue;
        if (!ReserveFilmSlot(child1, generation1))
        { ReturnFilmSlot(child0); continue; }
        plan.childFilmIndex0 = child0; plan.childFilmIndex1 = child1;
        plan.childGeneration0 = generation0; plan.childGeneration1 = generation1;
        plan.childBasePage0 = displacementBefore + accepted * 2u;
        plan.childBasePage1 = plan.childBasePage0 + 1u;
        plan.parentActiveOrdinal = ordinal;
        plan.newActiveOrdinal = activeBefore + accepted;
        plan.firstDirtyOrdinal = dirtyBefore + accepted * 2u;
        plan.transactionState = SPLIT_RESERVED;
        _SplitPlans[filmIndex] = plan;
        _SplitRecordIndices[accepted] = filmIndex;
        accepted++;
    }
    // Reserved displacement pages remain invisible until the batch commit. Film
    // slots are likewise ALLOCATED but not ACTIVE, so no live pass can observe a
    // partially created child.
    _DisplacementAllocator[0] = displacementBefore + accepted * 2u;
    _SplitState[0] = accepted;
    _SplitState[1] = 0u;
    _SplitState[2] = displacementBefore;
    _SplitState[3] = activeBefore;
    _SplitState[4] = dirtyBefore;
    _SplitState[5] = _FilmAllocator[1];
    _SplitDispatchArguments[0] = uint3(accepted, 1u, 1u);
    _SplitDispatchArguments[1] = uint3(
        (accepted * 2u * BASE_CELLS + 63u) / 64u, 1u, 1u);
    _SplitDispatchArguments[2] = uint3(accepted, 1u, 1u);
    _SplitDispatchArguments[3] = uint3(accepted > 0u ? 1u : 0u, 1u, 1u);
}
