.debug-root {
    width: 760px;
    min-height: 930px;
    padding: 24px;
    flex-direction: column;
    background-color: rgba(7, 11, 18, 0.96);
    border-width: 2px;
    border-color: rgba(38, 202, 255, 0.48);
    border-radius: 18px;
}

.header-row {
    height: 74px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 14px;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(38, 202, 255, 0.28);
}

.title-stack { flex-direction: column; }
.title {
    font-size: 25px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(218, 247, 255);
}
.subtitle {
    margin-top: 4px;
    font-size: 11px;
    letter-spacing: 3px;
    color: rgba(38, 202, 255, 0.72);
}
.fps {
    min-width: 100px;
    font-size: 14px;
    -unity-text-align: middle-right;
    color: rgba(193, 214, 230, 0.75);
}
.section-title {
    margin-top: 8px;
    margin-bottom: 6px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgba(38, 202, 255, 0.74);
}
.status-card {
    padding: 8px 13px;
    margin-bottom: 6px;
    background-color: rgba(18, 27, 41, 0.84);
    border-width: 1px;
    border-color: rgba(100, 142, 177, 0.24);
    border-radius: 9px;
}
.status-row {
    min-height: 31px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(100, 142, 177, 0.12);
}
.status-row--last { border-bottom-width: 0; }
.status-key { min-width: 220px; font-size: 13px; color: rgb(150, 171, 190); }
.status-val {
    flex-grow: 1;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(224, 234, 244);
}
.status-val--small { font-size: 11px; -unity-font-style: normal; }
.status-val--good { color: rgb(92, 244, 177); }
.status-val--warning { color: rgb(255, 207, 91); }
.status-val--error { color: rgb(255, 101, 101); }
.opacity-row {
    min-height: 52px;
    padding: 7px 13px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(18, 27, 41, 0.84);
    border-width: 1px;
    border-color: rgba(100, 142, 177, 0.24);
    border-radius: 9px;
}
.opacity-slider { flex-grow: 1; margin-left: 14px; margin-right: 14px; }
.opacity-slider #unity-drag-container { height: 8px; }
.opacity-slider #unity-tracker {
    background-color: rgba(55, 84, 109, 0.95);
    border-radius: 4px;
}
.opacity-slider #unity-dragger {
    width: 22px;
    height: 22px;
    background-color: rgb(38, 202, 255);
    border-width: 2px;
    border-color: rgb(218, 247, 255);
    border-radius: 11px;
}
.opacity-value {
    width: 52px;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(218, 247, 255);
}
.display-toggle-row {
    margin-top: 7px;
    flex-direction: row;
}
.display-toggle {
    height: 42px;
    flex-grow: 1;
    background-color: rgba(0, 116, 166, 0.6);
    border-width: 1px;
    border-color: rgba(70, 224, 255, 0.72);
    border-radius: 8px;
    color: rgb(230, 251, 255);
    -unity-font-style: bold;
}
.display-toggle--first { margin-right: 7px; }
.checker-toggle {
    width: 42px;
    min-width: 42px;
    height: 42px;
    margin-left: 7px;
    padding: 11px;
    align-items: center;
    justify-content: center;
    background-color: rgba(37, 51, 72, 0.96);
    border-width: 1px;
    border-color: rgba(100, 142, 177, 0.52);
    border-radius: 8px;
}
.checker-toggle--on {
    background-color: rgba(82, 76, 22, 0.9);
    border-color: rgb(255, 225, 0);
}
.checker-icon { width: 18px; height: 18px; flex-direction: column; }
.checker-icon-row { width: 18px; height: 9px; flex-direction: row; }
.checker-icon-yellow { width: 9px; height: 9px; background-color: rgb(255, 235, 0); }
.checker-icon-magenta { width: 9px; height: 9px; background-color: rgb(255, 0, 255); }
.fine-row {
    min-height: 108px;
    padding: 8px 13px;
    flex-direction: row;
    align-items: stretch;
    background-color: rgba(18, 27, 41, 0.84);
    border-width: 1px;
    border-color: rgba(100, 142, 177, 0.24);
    border-radius: 9px;
}
.fine-toggle {
    width: 142px;
    margin-right: 13px;
    background-color: rgba(0, 116, 166, 0.6);
    border-width: 1px;
    border-color: rgba(70, 224, 255, 0.72);
    border-radius: 8px;
    color: rgb(230, 251, 255);
    -unity-font-style: bold;
}
.fine-controls { flex-grow: 1; flex-direction: column; }
.fine-control-row {
    min-height: 44px;
    flex-direction: row;
    align-items: center;
}
.fine-key { width: 112px; font-size: 12px; color: rgb(150, 171, 190); }
.fine-slider { flex-grow: 1; margin-left: 7px; margin-right: 9px; }
.fine-value {
    width: 62px;
    font-size: 11px;
    -unity-text-align: middle-right;
    color: rgb(218, 247, 255);
}
.operation-panel {
    display: none;
    min-height: 72px;
    margin-top: 10px;
    padding: 9px 13px;
    background-color: rgba(0, 88, 126, 0.42);
    border-width: 1px;
    border-color: rgba(70, 224, 255, 0.65);
    border-radius: 9px;
}
.operation-title-row { flex-direction: row; align-items: center; }
.operation-spinner {
    width: 24px;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(70, 224, 255);
}
.operation-stage { font-size: 12px; color: rgb(218, 247, 255); }
.operation-progress { height: 22px; margin-top: 7px; }
.button-row { margin-top: 14px; flex-direction: row; }
.button-row--second { margin-top: 8px; }
.action-btn {
    height: 48px;
    flex-grow: 1;
    margin-right: 8px;
    background-color: rgba(37, 51, 72, 0.96);
    border-width: 1px;
    border-color: rgba(70, 175, 222, 0.52);
    border-radius: 8px;
    color: rgb(216, 232, 245);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}
.action-btn--last { margin-right: 0; }
.action-btn:hover { background-color: rgba(52, 78, 105, 0.98); border-color: rgb(38, 202, 255); }
.action-btn:active { background-color: rgba(23, 42, 62, 1); scale: 0.98; }
.action-btn:disabled { opacity: 0.38; }
.action-btn--primary {
    background-color: rgba(0, 116, 166, 0.72);
    border-color: rgba(70, 224, 255, 0.82);
    color: rgb(230, 251, 255);
}
.action-btn--danger {
    background-color: rgba(114, 38, 45, 0.72);
    border-color: rgba(255, 105, 111, 0.62);
}
.control-hint {
    margin-top: 14px;
    font-size: 11px;
    -unity-text-align: middle-center;
    color: rgba(191, 211, 226, 0.82);
}
.ontology-hint {
    margin-top: 7px;
    font-size: 10px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgba(126, 153, 176, 0.72);
}
