.workspace {
    width: 580px;
    min-height: 0;
    padding: 12px;
    flex-direction: column;
    background-color: rgba(14, 17, 22, 0.84);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 18px;
    color: rgb(236, 238, 241);
}
.top-bar {
    min-height: 54px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
    padding-bottom: 8px;
}
.session-heading { flex-direction: column; }
.session-name { font-size: 17px; -unity-font-style: bold; color: white; }
.session-state { margin-top: 2px; font-size: 11px; color: rgb(126, 220, 188); }
.save-state { font-size: 11px; -unity-text-align: middle-right; color: rgb(177, 183, 191); }
.history-actions { flex-direction: row; margin-left: auto; margin-right: 8px; }
.history-action {
    min-width: 64px;
    min-height: 44px;
    margin-right: 5px;
    background-color: rgba(52, 57, 65, 0.96);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    color: rgb(233, 235, 238);
    font-size: 11px;
    -unity-font-style: bold;
}
.history-action:hover { border-color: rgba(176, 239, 222, 0.72); }
.history-action:active { scale: 0.98; }
.history-action:disabled { opacity: 0.34; }
.mode-tabs, .segmented-row, .button-row, .tool-grid, .swatch-row { flex-direction: row; }
.mode-tabs {
    height: 46px;
    margin-bottom: 10px;
    padding: 3px;
    background-color: rgba(4, 5, 7, 0.56);
    border-radius: 13px;
}
.mode-tab, .segment {
    min-height: 40px;
    flex-grow: 1;
    margin-right: 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 10px;
    color: rgb(157, 163, 172);
    font-size: 11px;
    -unity-font-style: bold;
}
.mode-tab--selected, .segment--selected { background-color: rgba(80, 91, 107, 0.88); color: white; }
.segment--refine.segment--selected { background-color: rgba(24, 119, 92, 0.9); }
.segment--erase.segment--selected { background-color: rgba(151, 48, 55, 0.92); }
.mode-tab--last { margin-right: 0; }
.button-last { margin-right: 0; }
.mode-panel { flex-direction: column; }
.mode-panel--hidden { display: none; }
.operation-card {
    display: none;
    min-height: 62px;
    margin-bottom: 9px;
    padding: 10px 12px;
    background-color: rgba(40, 70, 77, 0.72);
    border-radius: 12px;
}
.operation-stage { font-size: 11px; color: white; }
.operation-progress { height: 18px; margin-top: 7px; }
.primary-action, .secondary-action, .quiet-action, .danger-action, .tool-button {
    min-height: 48px;
    flex-grow: 1;
    margin-right: 7px;
    border-width: 1px;
    border-radius: 11px;
    font-size: 10px;
    -unity-font-style: bold;
}
.primary-action { min-height: 54px; background-color: rgb(39, 130, 106); border-color: rgba(151, 245, 219, 0.48); color: white; }
.secondary-action, .tool-button { background-color: rgba(52, 57, 65, 0.96); border-color: rgba(255, 255, 255, 0.12); color: rgb(233, 235, 238); }
.quiet-action { min-height: 44px; background-color: rgba(38, 41, 47, 0.88); border-color: rgba(255, 255, 255, 0.08); color: rgb(191, 196, 203); }
.danger-action { min-height: 44px; background-color: rgba(104, 36, 42, 0.82); border-color: rgba(245, 115, 122, 0.35); color: rgb(255, 220, 222); }
.tool-button--selected { background-color: rgba(47, 127, 107, 0.9); border-color: rgba(151, 245, 219, 0.45); color: white; }
.primary-action:hover, .secondary-action:hover, .quiet-action:hover, .danger-action:hover, .tool-button:hover { border-color: rgba(176, 239, 222, 0.72); }
.primary-action:active, .secondary-action:active, .quiet-action:active, .danger-action:active, .tool-button:active { scale: 0.98; }
.primary-action:disabled, .secondary-action:disabled, .quiet-action:disabled, .danger-action:disabled, .tool-button:disabled { opacity: 0.34; }
.refine-action { margin-top: 9px; margin-right: 0; }
.section-title { margin-top: 12px; margin-bottom: 6px; font-size: 11px; -unity-font-style: bold; color: rgb(189, 194, 201); }
.mini-section { margin-top: 6px; font-size: 9px; color: rgb(149, 155, 164); }
.card, .color-card { padding: 10px; background-color: rgba(27, 32, 39, 0.76); border-width: 1px; border-color: rgba(255, 255, 255, 0.1); border-radius: 13px; }
.export-card { margin-top: 2px; }
.field { min-height: 44px; margin-bottom: 5px; font-size: 10px; color: rgb(238, 241, 245); }
.field > .unity-base-field__label { width: 112px; color: rgb(174, 182, 193); font-size: 10px; }
.field > .unity-base-text-field__input,
.field > .unity-base-popup-field__input,
.field .unity-text-field__input,
.field .unity-popup-field__input {
    min-height: 38px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(6, 8, 11, 0.56);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.13);
    border-radius: 9px;
    color: rgb(245, 247, 250);
    font-size: 10px;
}
.field > .unity-base-text-field__input:focus,
.field > .unity-base-popup-field__input:focus {
    border-color: rgba(126, 220, 188, 0.72);
}
.button-row { margin-top: 8px; }
.compact-row { margin-top: 5px; }
.proximity { margin-top: 7px; -unity-text-align: middle-center; font-size: 11px; color: rgb(245, 197, 93); }
.supporting-status, .help-text { margin-top: 7px; white-space: normal; font-size: 10px; color: rgb(159, 166, 176); }
.help-text { -unity-text-align: middle-center; }
.segmented-row { min-height: 46px; padding: 3px; background-color: rgba(4, 5, 7, 0.5); border-radius: 12px; }
.tool-card { margin-top: 9px; }
.control-row { min-height: 42px; flex-direction: row; align-items: center; }
.control-label { width: 85px; font-size: 11px; color: rgb(181, 186, 193); }
.mini-label { width: 58px; font-size: 10px; color: rgb(181, 186, 193); }
.control-slider { flex-grow: 1; margin-left: 6px; margin-right: 8px; }
.control-value { width: 64px; font-size: 11px; -unity-text-align: middle-right; color: white; }
.inline-toggle { min-height: 42px; font-size: 11px; color: rgb(222, 225, 229); }
.tool-grid { flex-wrap: wrap; }
.tool-button { min-width: 130px; margin-bottom: 6px; }
.paint-tool-strip {
    flex-wrap: nowrap;
    margin-top: 7px;
    padding: 3px;
    background-color: rgba(4, 5, 7, 0.46);
    border-radius: 12px;
}
.paint-tool-strip .tool-button {
    min-width: 0;
    min-height: 44px;
    margin-right: 3px;
    margin-bottom: 0;
    padding-left: 3px;
    padding-right: 3px;
    font-size: 9px;
}
.shape-row { flex-grow: 1; margin-top: 0; min-height: 38px; }
.color-card { margin-top: 10px; flex-direction: row; align-items: center; }
.paint-inspector { padding: 8px; align-items: flex-start; }
.paint-color-wheel { width: 196px; height: 196px; min-width: 196px; margin-right: 14px; border-width: 2px; border-color: rgba(255, 255, 255, 0.56); border-radius: 98px; }
.paint-color-cursor { position: absolute; width: 14px; height: 14px; border-width: 2px; border-color: white; border-radius: 7px; background-color: rgba(0, 0, 0, 0.44); }
.color-controls { flex-grow: 1; }
.paint-control-column { min-height: 196px; }
.paint-color-heading { min-height: 36px; flex-direction: row; align-items: center; }
.paint-color-swatch { width: 34px; height: 34px; margin-right: 7px; background-color: rgb(26, 204, 255); border-width: 2px; border-color: rgba(255, 255, 255, 0.82); border-radius: 17px; }
.compact-action { min-height: 34px; height: 34px; font-size: 9px; }
.paint-control-row { min-height: 27px; }
.paint-control-row .control-label,
.paint-control-row .mini-label { width: 62px; font-size: 9px; }
.paint-control-row .control-value { width: 47px; font-size: 9px; }
.paint-control-row .control-slider { margin-left: 3px; margin-right: 4px; }
.paint-control-row .shape-row { min-height: 28px; height: 28px; }
.paint-control-row .shape-row .segment { min-height: 26px; font-size: 9px; }
.palette-history {
    min-height: 34px;
    margin-top: 6px;
    flex-direction: row;
    align-items: center;
}
.palette-label { width: 38px; margin-top: 0; }
.palette-history .swatch-row { min-height: 28px; flex-grow: 1; }
.palette-history .color-swatch {
    width: 24px;
    height: 24px;
    margin-right: 3px;
    border-radius: 12px;
}
.swatch-row { min-height: 34px; margin-top: 3px; }
.color-swatch { width: 32px; height: 32px; margin-right: 6px; padding: 0; border-width: 2px; border-color: rgba(255, 255, 255, 0.38); border-radius: 16px; }
.diagnostics { margin-top: 11px; padding-top: 7px; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.08); font-size: 10px; color: rgb(139, 145, 154); }
.diagnostic-grid { margin-top: 5px; flex-direction: row; flex-wrap: wrap; }
.diagnostic-key { width: 145px; min-height: 24px; color: rgb(137, 143, 152); }
.diagnostic-value { width: 130px; min-height: 24px; -unity-text-align: middle-right; color: rgb(213, 217, 222); }
.status-val--good { color: rgb(112, 226, 183); }
.status-val--warning { color: rgb(244, 197, 91); }
.status-val--error { color: rgb(247, 112, 120); }
