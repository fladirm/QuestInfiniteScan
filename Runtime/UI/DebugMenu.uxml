<ui:UXML xmlns:ui="UnityEngine.UIElements"
    xsi="http://www.w3.org/2001/XMLSchema-instance"
    engine="UnityEngine.UIElements"
    noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
    editor-extension-mode="False">
    <Style src="DebugMenu.uss" />
    <ui:VisualElement name="debug-root" class="debug-root">
        <ui:VisualElement name="nav-panel" class="nav-panel">
            <ui:VisualElement class="nav-header">
                <ui:Label text="Σ-PRISM-16" class="nav-header-title" />
                <ui:Label text="CPQ4 / QUEST" class="nav-header-sub" />
            </ui:VisualElement>
            <ui:Label text="Scan" class="nav-btn nav-btn--active" />
            <ui:VisualElement class="nav-spacer" />
            <ui:Label name="val-fps" text="-- FPS" class="nav-fps" />
        </ui:VisualElement>
        <ui:VisualElement name="detail-panel" class="detail-panel">
            <ui:VisualElement class="detail-view">
                <ui:Label text="HOLISTIC SEDENION CARRIER" class="view-title" />
                <ui:VisualElement class="status-row">
                    <ui:Label text="Lifecycle" class="status-key" />
                    <ui:Label name="val-scanning" text="--" class="status-val" />
                </ui:VisualElement>
                <ui:VisualElement class="status-row">
                    <ui:Label text="Four-stream rig" class="status-key" />
                    <ui:Label name="val-rig" text="--" class="status-val status-val--small" />
                </ui:VisualElement>
                <ui:VisualElement class="status-row">
                    <ui:Label text="Pairing" class="status-key" />
                    <ui:Label name="val-pairing" text="--" class="status-val status-val--small" />
                </ui:VisualElement>
                <ui:VisualElement class="status-row">
                    <ui:Label text="Readout" class="status-key" />
                    <ui:Label name="val-render" text="--" class="status-val" />
                </ui:VisualElement>
                <ui:VisualElement class="status-row">
                    <ui:Label text="Gate" class="status-key" />
                    <ui:Label name="val-pipeline" text="--" class="status-val status-val--small" />
                </ui:VisualElement>
                <ui:VisualElement class="btn-group">
                    <ui:Button name="btn-toggle-scan" text="Start Scanning"
                        class="action-btn action-btn--primary" />
                    <ui:Button name="btn-render-mode" text="Readout: Carrier"
                        class="action-btn" />
                    <ui:Button name="btn-clear-all" text="Reset Session"
                        class="action-btn action-btn--danger" />
                </ui:VisualElement>
                <ui:Label text="One exact sparse Ψ:Σ₂→S₁₆ is the only physical world. Mesh, topology, appearance and export are readouts; no legacy mapper is active."
                    class="hint-label" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
