<ui:UXML xmlns:ui="UnityEngine.UIElements"
    xsi="http://www.w3.org/2001/XMLSchema-instance"
    engine="UnityEngine.UIElements"
    noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
    editor-extension-mode="False">
    <Style src="DebugMenu.uss" />
    <ui:VisualElement name="debug-root" class="debug-root">
        <ui:VisualElement class="header-row">
            <ui:VisualElement class="title-stack">
                <ui:Label text="QUEST INFINITE MERKABA" class="title" />
                <ui:Label text="5 CM SUPPORT · 2.5 CM GRID" class="subtitle" />
            </ui:VisualElement>
            <ui:Label name="val-fps" text="-- FPS" class="fps" />
        </ui:VisualElement>

        <ui:VisualElement class="mode-tab-row">
            <ui:Button name="btn-tab-scan" text="SCAN"
                class="mode-tab mode-tab--selected" />
            <ui:Button name="btn-tab-paint" text="PAINT"
                class="mode-tab mode-tab--last" />
        </ui:VisualElement>

        <ui:VisualElement name="operation-panel" class="operation-panel">
            <ui:VisualElement class="operation-title-row">
                <ui:Label name="operation-spinner" text="|" class="operation-spinner" />
                <ui:Label name="operation-stage" text="Working…" class="operation-stage" />
            </ui:VisualElement>
            <ui:ProgressBar name="operation-progress" value="0" low-value="0"
                high-value="100" title="0%" class="operation-progress" />
        </ui:VisualElement>

        <ui:VisualElement name="scan-panel" class="mode-panel">

        <ui:Label text="SCAN STATUS" class="section-title" />
        <ui:VisualElement class="status-card">
            <ui:VisualElement class="status-row">
                <ui:Label text="Scanning" class="status-key" />
                <ui:Label name="val-scanning" text="--" class="status-val" />
            </ui:VisualElement>
            <ui:VisualElement class="status-row">
                <ui:Label text="Active chunks" class="status-key" />
                <ui:Label name="val-chunks" text="0" class="status-val" />
            </ui:VisualElement>
            <ui:VisualElement class="status-row">
                <ui:Label text="Published triangles" class="status-key" />
                <ui:Label name="val-kernels" text="0" class="status-val" />
            </ui:VisualElement>
            <ui:VisualElement class="status-row">
                <ui:Label text="Visible chunks" class="status-key" />
                <ui:Label name="val-visible" text="0" class="status-val" />
            </ui:VisualElement>
            <ui:VisualElement class="status-row">
                <ui:Label text="Saved session" class="status-key" />
                <ui:Label name="val-saved" text="--" class="status-val status-val--small" />
            </ui:VisualElement>
            <ui:VisualElement class="status-row">
                <ui:Label text="Scan proximity" class="status-key" />
                <ui:Label name="val-proximity" text="--" class="status-val status-val--small" />
            </ui:VisualElement>
            <ui:VisualElement class="status-row">
                <ui:Label text="GLB export" class="status-key" />
                <ui:Label name="val-export" text="--" class="status-val status-val--small" />
            </ui:VisualElement>
            <ui:VisualElement class="status-row status-row--last">
                <ui:Label text="Controller pointer" class="status-key" />
                <ui:Label name="val-pointer" text="--" class="status-val status-val--small" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label text="DISPLAY" class="section-title" />
        <ui:VisualElement class="opacity-row">
            <ui:Label text="Scan opacity" class="status-key" />
            <ui:Slider name="scan-opacity" low-value="0" high-value="1" value="1"
                class="opacity-slider" />
            <ui:Label name="val-opacity" text="100%" class="opacity-value" />
        </ui:VisualElement>
        <ui:VisualElement class="display-toggle-row">
            <ui:Button name="btn-readout" text="READOUT  ON"
                class="display-toggle display-toggle--first" />
            <ui:Button name="btn-mesh" text="MESH  OFF"
                class="display-toggle" />
            <ui:Button name="btn-occlusion" text="OCCLUSION  ON"
                class="display-toggle" />
            <ui:Button name="btn-checker" tooltip="Coverage checker"
                class="checker-toggle">
                <ui:VisualElement picking-mode="Ignore" class="checker-icon">
                    <ui:VisualElement class="checker-icon-row">
                        <ui:VisualElement class="checker-icon-yellow" />
                        <ui:VisualElement class="checker-icon-magenta" />
                    </ui:VisualElement>
                    <ui:VisualElement class="checker-icon-row">
                        <ui:VisualElement class="checker-icon-magenta" />
                        <ui:VisualElement class="checker-icon-yellow" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:Button>
        </ui:VisualElement>

        <ui:Label text="EXPORT REVIEW" class="section-title" />
        <ui:VisualElement class="artifact-row">
            <ui:Button name="btn-artifact-view" text="GLB VIEW  OFF"
                class="artifact-button" />
            <ui:Button name="btn-artifact-load" text="LOAD MODEL"
                class="artifact-button" />
            <ui:Button name="btn-annotation-mode" text="NOTE  OFF"
                class="artifact-button" />
            <ui:Button name="btn-annotation-save" text="SAVE NOTES"
                class="artifact-button artifact-button--last" />
        </ui:VisualElement>
        <ui:VisualElement class="artifact-options-row">
            <ui:Toggle name="artifact-world-lock" label="WORLD LOCK"
                value="true" class="artifact-toggle" />
            <ui:Toggle name="artifact-room-align" label="ALIGN 1:1"
                value="false" class="artifact-toggle" />
            <ui:Button name="btn-annotation-delete" text="DELETE MARK"
                class="annotation-delete" />
        </ui:VisualElement>
        <ui:VisualElement class="annotation-note-row">
            <ui:TextField name="annotation-note" label="Selected note"
                class="annotation-note" />
            <ui:Button name="btn-annotation-edit" text="TYPE NOTE"
                class="annotation-edit" />
        </ui:VisualElement>
        <ui:Label name="val-artifact" text="GLB View closed"
            class="artifact-status" />

        <ui:Label text="MANUAL FINE" class="section-title" />
        <ui:VisualElement class="fine-row">
            <ui:Button name="btn-fine" text="FINE  OFF"
                class="fine-toggle" />
            <ui:VisualElement class="fine-controls">
                <ui:VisualElement class="fine-control-row">
                    <ui:Label text="Brush angle" class="fine-key" />
                    <ui:Slider name="fine-angle" low-value="5" high-value="45"
                        value="20" class="fine-slider" />
                    <ui:Label name="val-fine-angle" text="20°"
                        class="fine-value" />
                </ui:VisualElement>
                <ui:VisualElement class="fine-control-row">
                    <ui:Label text="Tool depth" class="fine-key" />
                    <ui:Slider name="fine-depth" low-value="0.25" high-value="4"
                        value="2" class="fine-slider" />
                    <ui:Label name="val-fine-depth" text="2.00 m"
                        class="fine-value" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="button-row">
            <ui:Button name="btn-start" text="START / RESUME"
                class="action-btn action-btn--primary" />
            <ui:Button name="btn-stop" text="STOP" class="action-btn" />
            <ui:Button name="btn-save" text="SAVE" class="action-btn action-btn--last" />
        </ui:VisualElement>
        <ui:VisualElement class="button-row button-row--second">
            <ui:Button name="btn-load" text="LOAD" class="action-btn" />
            <ui:Button name="btn-new" text="NEW / CLEAR"
                class="action-btn action-btn--danger" />
            <ui:Button name="btn-export" text="EXPORT GLB"
                class="action-btn action-btn--last" />
        </ui:VisualElement>
        <ui:VisualElement class="button-row button-row--second">
            <ui:Button name="btn-export-tiles" text="EXPORT 3D TILES"
                class="action-btn action-btn--primary action-btn--last" />
        </ui:VisualElement>

        <ui:Label text="GLB: right grip 6DoF · both grips scale/rotate · trigger place/edit · TYPE NOTE keyboard"
            class="control-hint" />
        <ui:Label text="One reversible Merkaba grid · clear viewpoints remove false geometry"
            class="ontology-hint" />
        </ui:VisualElement>

        <ui:VisualElement name="paint-panel"
            class="mode-panel mode-panel--hidden">
            <ui:Label text="MODEL PAINT" class="section-title" />
            <ui:Label text="Immediate export-local strokes · canonical M8 is unchanged"
                class="paint-description" />
            <ui:VisualElement class="paint-action-row">
                <ui:Button name="btn-paint-view" text="GLB VIEW  OFF"
                    class="artifact-button" />
                <ui:Button name="btn-paint-load" text="LOAD MODEL"
                    class="artifact-button" />
                <ui:Button name="btn-paint-save" text="SAVE PAINT"
                    class="artifact-button artifact-button--last" />
            </ui:VisualElement>
            <ui:Label name="val-paint-status" text="Open or load a model"
                class="artifact-status" />

            <ui:Label text="TOOL" class="section-title" />
            <ui:VisualElement class="paint-tool-row">
                <ui:Button name="btn-paint-line" text="LINE"
                    class="paint-tool paint-tool--selected" />
                <ui:Button name="btn-paint-surface" text="SURFACE"
                    class="paint-tool" />
                <ui:Button name="btn-paint-spatial" text="3D BRUSH"
                    class="paint-tool" />
                <ui:Button name="btn-paint-erase" text="ERASE"
                    class="paint-tool paint-tool--last" />
            </ui:VisualElement>

            <ui:Label text="RGBA" class="section-title" />
            <ui:VisualElement class="paint-color-card">
                <ui:VisualElement name="paint-color-swatch"
                    class="paint-color-swatch" />
                <ui:VisualElement class="paint-channel-stack">
                    <ui:VisualElement class="paint-channel-row">
                        <ui:Label text="R" class="paint-channel-label paint-r" />
                        <ui:Slider name="paint-red" low-value="0" high-value="1"
                            value="0.1" class="paint-channel-slider" />
                    </ui:VisualElement>
                    <ui:VisualElement class="paint-channel-row">
                        <ui:Label text="G" class="paint-channel-label paint-g" />
                        <ui:Slider name="paint-green" low-value="0" high-value="1"
                            value="0.8" class="paint-channel-slider" />
                    </ui:VisualElement>
                    <ui:VisualElement class="paint-channel-row">
                        <ui:Label text="B" class="paint-channel-label paint-b" />
                        <ui:Slider name="paint-blue" low-value="0" high-value="1"
                            value="1" class="paint-channel-slider" />
                    </ui:VisualElement>
                    <ui:VisualElement class="paint-channel-row">
                        <ui:Label text="A" class="paint-channel-label" />
                        <ui:Slider name="paint-alpha" low-value="0.05" high-value="1"
                            value="0.85" class="paint-channel-slider" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="paint-width-row">
                <ui:Label text="Stroke width" class="status-key" />
                <ui:Slider name="paint-width" low-value="0.002"
                    high-value="0.05" value="0.01"
                    class="paint-channel-slider" />
                <ui:Label name="val-paint-width" text="10 mm"
                    class="opacity-value" />
            </ui:VisualElement>
            <ui:Label text="Right trigger draws · SURFACE follows model · 3D BRUSH draws at a fixed ray depth · ERASE removes the touched stroke"
                class="control-hint" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
