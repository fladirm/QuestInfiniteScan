// Quest Infinite Merkaba - flat parallel dirty-chunk triangle publication.
#pragma kernel RebuildDirtyChunkRecords
#pragma kernel FinalizeDirtyChunkRecords
#pragma kernel MigratePublishedChunkRecords

#include "MerkabaCanonicalGeometry.generated.hlsl"

#define MERKABA_CHUNK_SIZE 32
#define MERKABA_KERNELS_PER_CHUNK 32768
#define MERKABA_OCCUPIED_FLAG 1u
#define MERKABA_BOUNDARY_BITS_PER_FACE 1024
#define MERKABA_BOUNDARY_WORD_COUNT 192

struct KernelState
{
    int evidence;
    uint packedColor;
    uint colorConfidence;
    uint flags;
};

struct PrimitiveRecord
{
    uint packedLocalPrimitive;
};

StructuredBuffer<KernelState> _MerkabaKernels;
StructuredBuffer<int4> _MerkabaPageCoords;
StructuredBuffer<int> _MerkabaPageNeighbours;
StructuredBuffer<int4> _MerkabaBoundarySummaryHash;
StructuredBuffer<uint> _MerkabaBoundarySummaryWords;
StructuredBuffer<uint> _MerkabaDirtySlotQueue;
RWStructuredBuffer<uint> _MerkabaPublicationDirtyChunks;
RWStructuredBuffer<uint> _MerkabaPublicationVersions;
RWStructuredBuffer<PrimitiveRecord> _MerkabaPrimitiveRecordBanks;
RWStructuredBuffer<uint> _MerkabaPrimitiveCounts;
RWStructuredBuffer<uint> _MerkabaPrimitiveBuildCounts;
RWStructuredBuffer<uint> _MerkabaPublicationOverflowCounts;
RWStructuredBuffer<uint> _MerkabaPublishedBanks;
RWStructuredBuffer<uint> _MerkabaPrimitiveDrawArgs;

StructuredBuffer<PrimitiveRecord> _MerkabaSourcePrimitiveRecordBanks;
StructuredBuffer<uint> _MerkabaSourcePublishedBanks;

int _MerkabaResidentSlotCapacity;
int _MerkabaPrimitiveCapacityPerChunk;
int _MerkabaSourcePrimitiveCapacityPerChunk;
int _MerkabaBoundarySummaryHashCapacity;

int3 UnflattenKernel(uint index)
{
    int x = index % MERKABA_CHUNK_SIZE;
    int yz = index / MERKABA_CHUNK_SIZE;
    return int3(x, yz % MERKABA_CHUNK_SIZE, yz / MERKABA_CHUNK_SIZE);
}

uint FlattenKernel(int3 localCoord)
{
    return (uint)(localCoord.x + MERKABA_CHUNK_SIZE *
        (localCoord.y + MERKABA_CHUNK_SIZE * localCoord.z));
}

int NeighbourPageSlot(int slot, int3 delta)
{
    int index = (delta.x + 1) + 3 * (delta.y + 1) + 9 * (delta.z + 1);
    return _MerkabaPageNeighbours[slot * 27 + index];
}

uint HashPageCoord(int3 coord)
{
    return (uint)coord.x * 73856093u ^ (uint)coord.y * 19349663u ^
        (uint)coord.z * 83492791u;
}

int FindBoundarySummary(int3 chunkCoord)
{
    if (_MerkabaBoundarySummaryHashCapacity <= 0) return -1;
    uint mask = (uint)(_MerkabaBoundarySummaryHashCapacity - 1);
    uint index = HashPageCoord(chunkCoord) & mask;
    [loop]
    for (int probe = 0; probe < _MerkabaBoundarySummaryHashCapacity; probe++)
    {
        int4 entry = _MerkabaBoundarySummaryHash[index];
        if (entry.w < 0) return -1;
        if (all(entry.xyz == chunkCoord)) return entry.w;
        index = (index + 1u) & mask;
    }
    return -1;
}

bool BoundarySummaryOccupied(int3 chunkCoord, int3 localCoord)
{
    int summary = FindBoundarySummary(chunkCoord);
    if (summary < 0) return false;

    int face = -1;
    int u = 0;
    int v = 0;
    if (localCoord.x == 0)
    {
        face = 0; u = localCoord.y; v = localCoord.z;
    }
    else if (localCoord.x == MERKABA_CHUNK_SIZE - 1)
    {
        face = 1; u = localCoord.y; v = localCoord.z;
    }
    else if (localCoord.y == 0)
    {
        face = 2; u = localCoord.x; v = localCoord.z;
    }
    else if (localCoord.y == MERKABA_CHUNK_SIZE - 1)
    {
        face = 3; u = localCoord.x; v = localCoord.z;
    }
    else if (localCoord.z == 0)
    {
        face = 4; u = localCoord.x; v = localCoord.y;
    }
    else if (localCoord.z == MERKABA_CHUNK_SIZE - 1)
    {
        face = 5; u = localCoord.x; v = localCoord.y;
    }
    if (face < 0) return false;

    uint bitIndex = (uint)(face * MERKABA_BOUNDARY_BITS_PER_FACE +
                           u + MERKABA_CHUNK_SIZE * v);
    uint wordIndex = (uint)summary * MERKABA_BOUNDARY_WORD_COUNT +
                     (bitIndex >> 5u);
    return (_MerkabaBoundarySummaryWords[wordIndex] &
            (1u << (bitIndex & 31u))) != 0u;
}

bool OccupiedOffset(int slot, int3 localCoord, int3 offset)
{
    localCoord += offset;
    int3 pageDelta = int3(0, 0, 0);
    if (localCoord.x < 0) { localCoord.x += MERKABA_CHUNK_SIZE; pageDelta.x = -1; }
    else if (localCoord.x >= MERKABA_CHUNK_SIZE) { localCoord.x -= MERKABA_CHUNK_SIZE; pageDelta.x = 1; }
    if (localCoord.y < 0) { localCoord.y += MERKABA_CHUNK_SIZE; pageDelta.y = -1; }
    else if (localCoord.y >= MERKABA_CHUNK_SIZE) { localCoord.y -= MERKABA_CHUNK_SIZE; pageDelta.y = 1; }
    if (localCoord.z < 0) { localCoord.z += MERKABA_CHUNK_SIZE; pageDelta.z = -1; }
    else if (localCoord.z >= MERKABA_CHUNK_SIZE) { localCoord.z -= MERKABA_CHUNK_SIZE; pageDelta.z = 1; }
    int targetSlot = NeighbourPageSlot(slot, pageDelta);
    if (targetSlot < 0)
        return BoundarySummaryOccupied(
            _MerkabaPageCoords[slot].xyz + pageDelta, localCoord);
    uint index = targetSlot * MERKABA_KERNELS_PER_CHUNK + FlattenKernel(localCoord);
    return (_MerkabaKernels[index].flags & MERKABA_OCCUPIED_FLAG) != 0u;
}

uint BuildBodyDiagonalNeighbourMask(int slot, int3 localCoord)
{
    uint mask = 0u;
    [unroll]
    for (uint direction = 0u; direction < MERKABA_DIRECTION_COUNT; direction++)
    {
        if (OccupiedOffset(slot, localCoord,
            kMerkabaBodyDiagonalOffsets[direction]))
            mask |= 1u << direction;
    }
    return mask;
}

void StorePrimitive(uint slot, uint localIndex, uint primitiveId,
    uint targetBank, uint recordIndex)
{
    if (recordIndex >= (uint)_MerkabaPrimitiveCapacityPerChunk) return;
    PrimitiveRecord record;
    record.packedLocalPrimitive = localIndex | (primitiveId << 15u);
    uint bankStride = (uint)_MerkabaResidentSlotCapacity *
        (uint)_MerkabaPrimitiveCapacityPerChunk;
    uint destination = targetBank * bankStride +
        slot * (uint)_MerkabaPrimitiveCapacityPerChunk + recordIndex;
    _MerkabaPrimitiveRecordBanks[destination] = record;
}

// Dispatch shape: (dirtyChunkCount, 512, 1), 64 threads. Each invocation owns
// exactly one lattice kernel; there is no serial 32^3 loop or group barrier.
[numthreads(64, 1, 1)]
void RebuildDirtyChunkRecords(uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint slot = _MerkabaDirtySlotQueue[groupId.x];
    if (slot >= (uint)_MerkabaResidentSlotCapacity ||
        _MerkabaPublicationDirtyChunks[slot] == 0u)
        return;

    uint localIndex = groupId.y * 64u + groupThreadId.x;
    if (localIndex >= MERKABA_KERNELS_PER_CHUNK) return;
    uint stateIndex = slot * MERKABA_KERNELS_PER_CHUNK + localIndex;
    KernelState state = _MerkabaKernels[stateIndex];
    if ((state.flags & MERKABA_OCCUPIED_FLAG) == 0u) return;

    uint neighbourMask = BuildBodyDiagonalNeighbourMask((int)slot,
        UnflattenKernel(localIndex));
    uint targetBank = 1u - (_MerkabaPublishedBanks[slot] & 1u);
    uint primitiveCount = MERKABA_DIRECTION_COUNT +
        2u * countbits(neighbourMask);
    uint recordIndex;
    // One atomic reservation per occupied kernel, not one per triangle.
    InterlockedAdd(_MerkabaPrimitiveBuildCounts[slot], primitiveCount,
        recordIndex);
    [unroll]
    for (uint direction = 0u; direction < MERKABA_DIRECTION_COUNT; direction++)
    {
        uint firstPrimitive = direction * MERKABA_PRIMITIVES_PER_DIRECTION;
        if ((neighbourMask & (1u << direction)) == 0u)
        {
            StorePrimitive(slot, localIndex, firstPrimitive,
                targetBank, recordIndex++);
        }
        else
        {
            StorePrimitive(slot, localIndex, firstPrimitive + 1u,
                targetBank, recordIndex++);
            StorePrimitive(slot, localIndex, firstPrimitive + 2u,
                targetBank, recordIndex++);
            StorePrimitive(slot, localIndex, firstPrimitive + 3u,
                targetBank, recordIndex++);
        }
    }
}

// One thread per dirty chunk. This dispatch follows the parallel rebuild, so all
// record writes are complete. Overflow leaves bank/count/args/version untouched.
[numthreads(1, 1, 1)]
void FinalizeDirtyChunkRecords(uint3 groupId : SV_GroupID)
{
    uint slot = _MerkabaDirtySlotQueue[groupId.x];
    if (slot >= (uint)_MerkabaResidentSlotCapacity ||
        _MerkabaPublicationDirtyChunks[slot] == 0u)
        return;

    uint required = _MerkabaPrimitiveBuildCounts[slot];
    if (required > (uint)_MerkabaPrimitiveCapacityPerChunk)
    {
        _MerkabaPublicationOverflowCounts[slot] = required;
        return;
    }

    uint nextBank = 1u - (_MerkabaPublishedBanks[slot] & 1u);
    uint argsOffset = slot * 4u;
    _MerkabaPublishedBanks[slot] = nextBank;
    _MerkabaPrimitiveCounts[slot] = required;
    _MerkabaPrimitiveDrawArgs[argsOffset] = MERKABA_VERTICES_PER_PRIMITIVE;
    _MerkabaPrimitiveDrawArgs[argsOffset + 1u] = required;
    _MerkabaPrimitiveDrawArgs[argsOffset + 2u] = 0u;
    _MerkabaPrimitiveDrawArgs[argsOffset + 3u] = 0u;
    _MerkabaPublicationOverflowCounts[slot] = 0u;
    _MerkabaPublicationVersions[slot] += 1u;
    _MerkabaPublicationDirtyChunks[slot] = 0u;
    _MerkabaPrimitiveBuildCounts[slot] = 0u;
}

// Exceptional resize migration. Existing published records are copied to bank A
// of the replacement while the renderer continues drawing the source buffers.
[numthreads(64, 1, 1)]
void MigratePublishedChunkRecords(uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint slot = groupId.x;
    if (slot >= (uint)_MerkabaResidentSlotCapacity) return;
    uint index = groupId.y * 64u + groupThreadId.x;
    uint count = min(_MerkabaPrimitiveCounts[slot],
        (uint)_MerkabaSourcePrimitiveCapacityPerChunk);
    if (index >= count) return;

    uint sourceBankStride = (uint)_MerkabaResidentSlotCapacity *
        (uint)_MerkabaSourcePrimitiveCapacityPerChunk;
    uint source = (_MerkabaSourcePublishedBanks[slot] & 1u) *
        sourceBankStride +
        slot * (uint)_MerkabaSourcePrimitiveCapacityPerChunk + index;
    uint destination = slot * (uint)_MerkabaPrimitiveCapacityPerChunk + index;
    _MerkabaPrimitiveRecordBanks[destination] =
        _MerkabaSourcePrimitiveRecordBanks[source];
}
