#pragma kernel ResetFrame
#pragma kernel QueryM8Frame
#pragma kernel PrepareFrameCompilerArgs
#pragma kernel CompileVisiblePrimitives
#pragma kernel FinalizeDrawArgs

#include "MerkabaCanonicalGeometry.generated.hlsl"
#include "MerkabaWorld.hlsl"

#define MERKABA_LATTICE_STEP 0.025
#define MERKABA_HALF_SUPPORT 0.025
#define MERKABA_OCCUPIED_FLAG 1u

struct VisiblePrimitiveRecord
{
    int3 globalKernelCoord;
    uint packed;
};

RWStructuredBuffer<uint> _M8VisibleTiles;
RWStructuredBuffer<VisiblePrimitiveRecord> _M8VisiblePrimitives;
RWStructuredBuffer<uint> _M8FrameDispatchArgs;
RWStructuredBuffer<uint> _M8DrawArgs;

float4x4 _MerkabaGridToWorld;
float4x4 _MerkabaWorldToGrid;
float4 _M8DrawPlanes[12];
float3 _M8EyePositions[2];
float3 _M8CameraWorld;
float _M8RenderDistance;
float _M8WarmDistance;
int3 _M8QueryCenterBlock;
int _M8QueryBlockRadius;
int _M8QueryBlockSide;

bool M8AabbIntersectsDistance(int3 globalMin, int span, float distance)
{
    return MerkabaM8AabbIntersectsDistance(globalMin, span, distance,
        _M8CameraWorld, _MerkabaGridToWorld, _MerkabaWorldToGrid,
        MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
}

uint M8DistanceChildMask(int3 parentMin, int parentSpan, float distance)
{
    return MerkabaM8DistanceChildMask(parentMin, parentSpan, distance,
        _M8CameraWorld, _MerkabaGridToWorld, _MerkabaWorldToGrid,
        MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
}

uint M8EyeFrustumChildMask(int3 parentMin, int parentSpan, uint eye)
{
    uint support = 255u;
    [unroll]
    for (uint plane = 0u; plane < 6u; plane++)
        support &= MerkabaM8PlaneChildMask(parentMin, parentSpan,
            _M8DrawPlanes[eye * 6u + plane], _MerkabaGridToWorld,
            MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
    return support;
}

uint M8DrawChildMask(int3 parentMin, int parentSpan)
{
    uint stereo = M8EyeFrustumChildMask(parentMin, parentSpan, 0u) |
        M8EyeFrustumChildMask(parentMin, parentSpan, 1u);
    return stereo & M8DistanceChildMask(parentMin, parentSpan,
        _M8RenderDistance);
}

void M8RequestWarmLoad(uint tileRefIndex, uint chunkIndex, uint tileLocal,
    bool lateDraw)
{
    M8QueueColdTileLoad(tileRefIndex, chunkIndex, tileLocal);
    if (lateDraw) M8CounterIncrement(M8_COUNTER_LATE_DRAW_COLD_MISSES);
}

[numthreads(1, 1, 1)]
void ResetFrame(uint id : SV_DispatchThreadID)
{
    _M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT] = 0u;
    _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES] = 0u;
    _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 0u;
    _M8Counters[M8_COUNTER_LATE_DRAW_COLD_MISSES] = 0u;
    _M8Counters[M8_COUNTER_CANDIDATE_BLOCKS] = 0u;
    _M8Counters[M8_COUNTER_HASH_HIT_BLOCKS] = 0u;
    _M8Counters[M8_COUNTER_VISIBLE_CHUNKS] = 0u;
    _M8Counters[M8_COUNTER_OCCUPIED_CONSIDERED] = 0u;
    _M8Counters[M8_COUNTER_PRIMITIVES_BEFORE_FACING] = 0u;
    _M8Counters[M8_COUNTER_PRIMITIVES_REJECTED] = 0u;
    _M8Counters[M8_COUNTER_FRAME_EPOCH] += 1u;
    _M8FrameDispatchArgs[0] = 0u;
    _M8FrameDispatchArgs[1] = 8u;
    _M8FrameDispatchArgs[2] = 1u;
    _M8DrawArgs[0] = 3u;
    _M8DrawArgs[1] = 0u;
    _M8DrawArgs[2] = 0u;
    _M8DrawArgs[3] = 0u;
}

[numthreads(1, 1, 1)]
void QueryM8Frame(uint3 groupId : SV_GroupID)
{
    uint linear = groupId.x;
    uint side = (uint)_M8QueryBlockSide;
    if (linear >= side * side * side) return;
    M8CounterIncrement(M8_COUNTER_CANDIDATE_BLOCKS);
    int3 offset;
    offset.x = (int)(linear % side) - _M8QueryBlockRadius;
    offset.y = (int)((linear / side) % side) - _M8QueryBlockRadius;
    offset.z = (int)(linear / (side * side)) - _M8QueryBlockRadius;
    int3 blockCoord = _M8QueryCenterBlock + offset;
    int3 blockMin = blockCoord * MERKABA_M8_BLOCK_KERNEL_SPAN;
    if (!M8AabbIntersectsDistance(blockMin,
        MERKABA_M8_BLOCK_KERNEL_SPAN, _M8WarmDistance)) return;
    uint blockIndex;
    if (!M8FindBlock(blockCoord, blockIndex)) return;
    M8CounterIncrement(M8_COUNTER_HASH_HIT_BLOCKS);

    uint warm4 = M8DistanceChildMask(blockMin, 256, _M8WarmDistance);
    uint draw4 = M8DrawChildMask(blockMin, 256);
    uint support4 = (_M8BlockPresenceL0[blockIndex] & 255u) & warm4;
    while (support4 != 0u)
    {
        uint d4 = (uint)firstbitlow(support4); support4 &= support4 - 1u;
        int3 min4 = blockMin + MerkabaM8OctantOffset(d4, 128);
        uint warm3 = M8DistanceChildMask(min4, 128, _M8WarmDistance);
        uint draw3 = M8DrawChildMask(min4, 128);
        uint support3 = (_M8BlockPresenceL1[blockIndex * 8u + d4] & 255u) &
            warm3;
        while (support3 != 0u)
        {
            uint d3 = (uint)firstbitlow(support3); support3 &= support3 - 1u;
            int3 min3 = min4 + MerkabaM8OctantOffset(d3, 64);
            uint warm2 = M8DistanceChildMask(min3, 64, _M8WarmDistance);
            uint draw2 = M8DrawChildMask(min3, 64);
            uint support2 = (_M8BlockPresenceL2[blockIndex * 64u +
                d4 * 8u + d3] & 255u) & warm2;
            while (support2 != 0u)
            {
                uint d2 = (uint)firstbitlow(support2); support2 &= support2 - 1u;
                uint chunkLocal = (d4 << 6u) | (d3 << 3u) | d2;
                uint chunkRef = _M8BlockChunkRefs[blockIndex * 512u + chunkLocal];
                if (chunkRef == 0u || chunkRef >= MERKABA_REF_EVICTING) continue;
                uint chunkIndex = chunkRef - 1u;
                int3 min2 = min3 + MerkabaM8OctantOffset(d2, 32);
                uint warm1 = M8DistanceChildMask(min2, 32, _M8WarmDistance);
                uint draw1 = M8DrawChildMask(min2, 32);
                uint support1 = (_M8ChunkPresenceL0[chunkIndex] & 255u) & warm1;
                bool visibleChunk = false;
                while (support1 != 0u)
                {
                    uint d1 = (uint)firstbitlow(support1); support1 &= support1 - 1u;
                    int3 min1 = min2 + MerkabaM8OctantOffset(d1, 16);
                    uint warm0 = M8DistanceChildMask(min1, 16, _M8WarmDistance);
                    uint draw0 = M8DrawChildMask(min1, 16);
                    uint support0 = (_M8ChunkPresenceL1[chunkIndex * 8u + d1] &
                        255u) & warm0;
                    while (support0 != 0u)
                    {
                        uint d0 = (uint)firstbitlow(support0); support0 &= support0 - 1u;
                        uint tileLocal = (d1 << 3u) | d0;
                        uint tileRefIndex = chunkIndex * 64u + tileLocal;
                        uint tileRef = _M8ChunkTileRefs[tileRefIndex];
                        bool inDraw = ((draw4 >> d4) & (draw3 >> d3) &
                            (draw2 >> d2) & (draw1 >> d1) & (draw0 >> d0) & 1u) != 0u;
                        if (tileRef == MERKABA_REF_COLD_ON_SSD)
                        {
                            M8RequestWarmLoad(tileRefIndex, chunkIndex, tileLocal,
                                inDraw);
                            continue;
                        }
                        if (!M8IsHotRef(tileRef))
                        {
                            if (inDraw)
                                M8CounterIncrement(M8_COUNTER_LATE_DRAW_COLD_MISSES);
                            continue;
                        }
                        uint physicalSlot = M8PhysicalSlot(tileRef);
                        _M8TileRuntime[physicalSlot].z =
                            _M8Counters[M8_COUNTER_FRAME_EPOCH];
                        if (!inDraw || _M8TileMeta[physicalSlot].z == 0u) continue;
                        uint visibleIndex;
                        InterlockedAdd(_M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT],
                            1u, visibleIndex);
                        if (visibleIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                            _M8VisibleTiles[visibleIndex] = physicalSlot;
                        visibleChunk = true;
                    }
                }
                if (visibleChunk) M8CounterIncrement(M8_COUNTER_VISIBLE_CHUNKS);
            }
        }
    }
}

[numthreads(1, 1, 1)]
void PrepareFrameCompilerArgs(uint id : SV_DispatchThreadID)
{
    _M8FrameDispatchArgs[0] = min(
        _M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    _M8FrameDispatchArgs[1] = 8u;
    _M8FrameDispatchArgs[2] = 1u;
}

bool PrimitiveFrontFacingEitherEye(int3 globalCoord, uint primitiveId)
{
    float3 kernelCenter = (float3)globalCoord * MERKABA_LATTICE_STEP;
    float3 a = kernelCenter + MerkabaCanonicalPrimitivePosition(primitiveId, 0u);
    float3 b = kernelCenter + MerkabaCanonicalPrimitivePosition(primitiveId, 1u);
    float3 c = kernelCenter + MerkabaCanonicalPrimitivePosition(primitiveId, 2u);
    float3 worldA = mul(_MerkabaGridToWorld, float4(a, 1.0)).xyz;
    float3 worldB = mul(_MerkabaGridToWorld, float4(b, 1.0)).xyz;
    float3 worldC = mul(_MerkabaGridToWorld, float4(c, 1.0)).xyz;
    float3 normal = cross(worldB - worldA, worldC - worldA);
    float3 center = (worldA + worldB + worldC) / 3.0;
    return dot(normal, _M8EyePositions[0] - center) > 0.0 ||
        dot(normal, _M8EyePositions[1] - center) > 0.0;
}

[numthreads(64, 1, 1)]
void CompileVisiblePrimitives(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint visibleCount = min(_M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    if (groupId.x >= visibleCount) return;
    uint physicalSlot = _M8VisibleTiles[groupId.x];
    uint kernelLocal = groupId.y * 64u + thread;
    uint word = physicalSlot * MERKABA_M8_TILE_WORDS +
        (kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    if ((_M8OccupiedBits[word] & bit) == 0u) return;
    M8CounterIncrement(M8_COUNTER_OCCUPIED_CONSIDERED);
    KernelState state = M8LoadKernelState(physicalSlot, kernelLocal);
    int3 globalCoord = M8GlobalKernelCoord(physicalSlot, kernelLocal);

    uint neighbourMask = 0u;
    [unroll]
    for (uint direction = 0u; direction < MERKABA_DIRECTION_COUNT; direction++)
    {
        bool occupied;
        if (!M8TryOccupiedExact(globalCoord +
            kMerkabaBodyDiagonalOffsets[direction], occupied))
        {
            M8CounterIncrement(M8_COUNTER_LATE_DRAW_COLD_MISSES);
            return;
        }
        if (occupied) neighbourMask |= 1u << direction;
    }

    uint activeMask = 0u;
    [unroll]
    for (uint direction = 0u; direction < MERKABA_DIRECTION_COUNT; direction++)
    {
        uint first = direction * MERKABA_PRIMITIVES_PER_DIRECTION;
        activeMask |= (neighbourMask & (1u << direction)) == 0u
            ? 1u << first : 14u << first;
    }
    uint beforeFacing = countbits(activeMask);
    uint ignored;
    InterlockedAdd(_M8Counters[M8_COUNTER_PRIMITIVES_BEFORE_FACING],
        beforeFacing, ignored);
    uint survivingMask = 0u;
    uint remaining = activeMask;
    while (remaining != 0u)
    {
        uint primitiveId = (uint)firstbitlow(remaining);
        remaining &= remaining - 1u;
        if (PrimitiveFrontFacingEitherEye(globalCoord, primitiveId))
            survivingMask |= 1u << primitiveId;
    }
    uint survivingCount = countbits(survivingMask);
    InterlockedAdd(_M8Counters[M8_COUNTER_PRIMITIVES_REJECTED],
        beforeFacing - survivingCount, ignored);
    if (survivingCount == 0u) return;

    uint baseIndex;
    InterlockedAdd(_M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES],
        survivingCount, baseIndex);
    if (baseIndex + survivingCount > MERKABA_M8_VISIBLE_PRIMITIVE_CAPACITY)
    {
        _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 1u;
        return;
    }
    uint rgb = state.packedColor & 0x00ffffffu;
    uint hasRgb = state.colorConfidence > 0u ? 1u : 0u;
    uint output = baseIndex;
    while (survivingMask != 0u)
    {
        uint primitiveId = (uint)firstbitlow(survivingMask);
        survivingMask &= survivingMask - 1u;
        VisiblePrimitiveRecord record;
        record.globalKernelCoord = globalCoord;
        record.packed = primitiveId | (hasRgb << 5u) | (rgb << 6u);
        _M8VisiblePrimitives[output++] = record;
    }
}

[numthreads(1, 1, 1)]
void FinalizeDrawArgs(uint id : SV_DispatchThreadID)
{
    uint logical = _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES];
    if (logical > MERKABA_M8_VISIBLE_PRIMITIVE_CAPACITY)
    {
        logical = MERKABA_M8_VISIBLE_PRIMITIVE_CAPACITY;
        _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 1u;
    }
    _M8DrawArgs[0] = 3u;
    _M8DrawArgs[1] = logical * 2u;
    _M8DrawArgs[2] = 0u;
    _M8DrawArgs[3] = 0u;
}
