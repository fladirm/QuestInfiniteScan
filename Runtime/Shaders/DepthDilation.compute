// Jump-flood support field derived from the one joint four-stream depth truth.
#include "DepthKit.hlsl"

RWTexture2D<float4> gsDilateDest;
RWTexture2D<float4> gsDilateSrc;
int gsDilateStepSize;

float gsVoxDist;
float gsVoxSize;

#pragma kernel InitDepthDilation

[numthreads(8, 8, 1)]
void InitDepthDilation(uint2 coord : SV_DispatchThreadID)
{
    if (coord.x >= gsDepthTexSize.x || coord.y >= gsDepthTexSize.y) return;

    float depth = gsDepthTex[coord];
    float4 value = float4((float2)coord, depth, 0);
    gsDilateSrc[coord] = value;
}

static const int2 kOffsets[8] =
{
    int2(1, 0),
    int2(1, 1),
    int2(0, 1),
    int2(-1, 1),
    int2(-1, 0),
    int2(-1, -1),
    int2(0, -1),
    int2(1, -1)
};

#pragma kernel DilateDepthStep

[numthreads(8, 8, 1)]
void DilateDepthStep(uint2 coord : SV_DispatchThreadID)
{
    if (coord.x >= gsDepthTexSize.x || coord.y >= gsDepthTexSize.y) return;

    float4 value = gsDilateSrc[coord];
    float focalLength = abs(gsDepthProj[0]._m00);
    int2 size = int2(gsDepthTexSize);
    int2 destinationCoord = int2(coord);

    [unroll]
    for (int index = 0; index < 8; index++)
    {
        int2 sourceCoord = destinationCoord +
            kOffsets[index] * gsDilateStepSize;
        if (sourceCoord.x < 0 || sourceCoord.y < 0 ||
            sourceCoord.x >= size.x || sourceCoord.y >= size.y)
            continue;

        // The signed coordinate is validated before conversion/read.
        float4 sourceValue = gsDilateSrc[sourceCoord];
        if (sourceValue.z <= 0.0 || sourceValue.z >= 1.0) continue;

        float sourceLinear = gsDepthNDCToLinear(sourceValue.z);
        float pixelSize = 2.0 * sourceLinear /
            max(focalLength * gsDepthTexSize.x, 1e-6);
        float radius = (gsVoxDist + gsVoxSize) / max(pixelSize, 1e-6);
        float2 difference = sourceValue.xy - (float2)destinationCoord;
        bool withinRadius = dot(difference, difference) < radius * radius;
        bool newMinimum = value.z <= 0.0 || sourceValue.z < value.z;
        if (withinRadius && newMinimum) value = sourceValue;
    }

    gsDilateDest[coord] = value;
}
