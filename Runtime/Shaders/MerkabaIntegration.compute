#define MERKABA_LATTICE_STEP 0.025
#define MERKABA_SUPPORT_SIZE 0.050
#define MERKABA_HALF_SUPPORT 0.025
#define MERKABA_OCCUPIED_ON 512
#define MERKABA_OCCUPIED_OFF 128
#define MERKABA_EVIDENCE_CONFIDENCE_LIMIT 2560
#define MERKABA_OCCUPIED_FLAG 1u
RWStructuredBuffer<uint4> _M8AttemptCompletion;

float4x4 _MerkabaGridToWorld;
float4x4 _MerkabaWorldToGrid;
float4 _M8PlaneErrorBounds;

uint _M8AttemptToken;
uint _M8WorldPublishingGeneration;
uint _M8WorldRetiredGeneration;

int3 _M8ScanCenterBlock;
int _M8ScanBlockRadius;
int _M8ScanBlockSide;
uint M8ObservationFailureReason()
{
    return _M8Counters[M8_COUNTER_OBSERVATION_FAILURE];
}

uint PackRgb(uint r, uint g, uint b)
{
    return r | (g << 8u) | (b << 16u) | (255u << 24u);
}

bool M8SupportInsideMutationScope(M8FlowerInterval3 support)
{
    [loop] for (int index=0; index<_MerkabaExclusionCount; ++index)
    {
        float3 head=_MerkabaExclusionHeads[index];
        M8FlowerInterval bottom=M8FlowerISub(M8FlowerI(head.y,head.y),
            M8FlowerI(EXCLUSION_BOTTOM,EXCLUSION_BOTTOM));
        M8FlowerInterval top=M8FlowerIAdd(M8FlowerI(head.y,head.y),
            M8FlowerI(EXCLUSION_TOP,EXCLUSION_TOP));
        M8FlowerInterval radial=M8FlowerIAdd(
            M8FlowerISquare(M8FlowerISub(support.x,M8FlowerI(head.x,head.x))),
            M8FlowerISquare(M8FlowerISub(support.z,M8FlowerI(head.z,head.z))));
        M8FlowerInterval radius=M8FlowerISquare(M8FlowerI(EXCLUSION_RADIUS,EXCLUSION_RADIUS));
        if (support.y.hi >= bottom.lo && support.y.lo <= top.hi && radial.lo <= radius.hi)
            return false;
    }
    if (_M8FineRefineActive == 0u) return true;
    M8FlowerInterval3 relative;
    relative.x=M8FlowerISub(support.x,M8FlowerI(_M8FineCursorPosition.x,_M8FineCursorPosition.x));
    relative.y=M8FlowerISub(support.y,M8FlowerI(_M8FineCursorPosition.y,_M8FineCursorPosition.y));
    relative.z=M8FlowerISub(support.z,M8FlowerI(_M8FineCursorPosition.z,_M8FineCursorPosition.z));
    M8FlowerInterval ax=M8FlowerI(_M8FineBrushAxis.x,_M8FineBrushAxis.x);
    M8FlowerInterval ay=M8FlowerI(_M8FineBrushAxis.y,_M8FineBrushAxis.y);
    M8FlowerInterval az=M8FlowerI(_M8FineBrushAxis.z,_M8FineBrushAxis.z);
    M8FlowerInterval axial=M8FlowerIAdd(M8FlowerIAdd(M8FlowerIMul(relative.x,ax),
        M8FlowerIMul(relative.y,ay)),M8FlowerIMul(relative.z,az));
    if (axial.lo < 0.0 || axial.hi > _M8FineLength) return false;
    M8FlowerInterval radial=M8FlowerIAdd(M8FlowerIAdd(
        M8FlowerISquare(M8FlowerISub(relative.x,M8FlowerIMul(axial,ax))),
        M8FlowerISquare(M8FlowerISub(relative.y,M8FlowerIMul(axial,ay)))),
        M8FlowerISquare(M8FlowerISub(relative.z,M8FlowerIMul(axial,az))));
    return radial.hi <= _M8FineRadiusSquared;
}


void UpdateOccupancy(uint physicalSlot, uint kernelLocal,
    inout KernelState state, int delta)
{
    bool occupiedBefore = (state.flags & MERKABA_OCCUPIED_FLAG) != 0u;
    state.evidence = clamp(state.evidence + delta,
        -MERKABA_EVIDENCE_CONFIDENCE_LIMIT,
        MERKABA_EVIDENCE_CONFIDENCE_LIMIT);
    bool occupiedAfter = occupiedBefore
        ? state.evidence > MERKABA_OCCUPIED_OFF
        : state.evidence >= MERKABA_OCCUPIED_ON;
    if (occupiedAfter) state.flags |= MERKABA_OCCUPIED_FLAG;
    else
    {
        state.flags &= ~MERKABA_OCCUPIED_FLAG;
        state.flags = M8FlowerClearPlane(state.flags);
    }
    if (occupiedBefore == occupiedAfter) return;

    uint wordIndex = M8TileWordIndex(physicalSlot, kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    uint ignored;
    if (occupiedAfter)
    {
        InterlockedOr(_M8TileBits[wordIndex].x, bit, ignored);
        InterlockedAdd(_M8TileRecords[M8TileMetaIndex(physicalSlot)].z,
            1u, ignored);
        InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_KERNEL_COUNT], 1u,
            ignored);
    }
    else
    {
        InterlockedAnd(_M8TileBits[wordIndex].x, ~bit, ignored);
        InterlockedAdd(_M8TileRecords[M8TileMetaIndex(physicalSlot)].z,
            0xffffffffu, ignored);
        InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_KERNEL_COUNT],
            0xffffffffu, ignored);
    }
}

void M8MarkR1Active(uint physicalSlot, uint kernelLocal)
{
    uint wordIndex = M8TileWordIndex(physicalSlot, kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    uint previous;
    InterlockedOr(_M8TileBits[wordIndex].y, bit, previous);
    if ((previous & bit) == 0u)
    {
        uint ignored;
        InterlockedAdd(_M8TileRecords[M8TileMetaIndex(physicalSlot)].w,
            1u, ignored);
    }
}

