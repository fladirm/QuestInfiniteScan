// GPU-authoritative M8 SURFACE DISCOVER/INTEGRATE and Q_SCAN carve.
#pragma kernel DiscoverSurfaceCandidates
#pragma kernel PrepareResolveArgs
#pragma kernel ResolveSurfaceBlocks
#pragma kernel ResolveSurfaceChunks
#pragma kernel ResolveSurfaceTiles
#pragma kernel QueueResolvedSurfaceCandidates
#pragma kernel RetryPendingNewTiles
#pragma kernel PrepareIntegrateArgs
#pragma kernel IntegrateSurfaceCandidates
#pragma kernel QueryCarveTiles
#pragma kernel PrepareCarveArgs
#pragma kernel IntegrateCarveTiles
#pragma kernel FinalizeObservation

#include "DepthKit.hlsl"
#include "MerkabaCanonicalGeometry.generated.hlsl"
#include "MerkabaStereoCamera.hlsl"
#include "MerkabaWorld.hlsl"

#define MERKABA_LATTICE_STEP 0.025
#define MERKABA_HALF_SUPPORT 0.025
#define MERKABA_OCCUPIED_ON 512
#define MERKABA_OCCUPIED_OFF 128
#define MERKABA_SURFACE_SCALE 640.0
#define MERKABA_FREE_SCALE 256.0
#define MERKABA_EVIDENCE_CONFIDENCE_LIMIT 2560
#define MERKABA_FREE_FULL_CLEARANCE 0.150
#define MERKABA_MIN_SURFACE_QUALITY 0.25
#define MERKABA_OCCUPIED_FLAG 1u
#define MERKABA_NORMAL_MIN 0.3
#define MERKABA_DEPTH_DISPARITY 0.5
#define MERKABA_SURFACE_QUEUE_CAPACITY 1048576u
#define MERKABA_MEASUREMENT_PIXEL_MASK 0x00000fffu

RWStructuredBuffer<int4> _M8SurfaceCandidates;
StructuredBuffer<int4> _M8SurfaceCandidatesRead;
RWStructuredBuffer<uint2> _M8SurfaceQueue;
StructuredBuffer<uint2> _M8SurfaceQueueRead;
RWStructuredBuffer<uint> _M8TouchedTileQueue;
RWStructuredBuffer<uint> _M8CarveTiles;
StructuredBuffer<uint> _M8CarveTilesRead;
RWStructuredBuffer<uint> _M8ObservationDispatchArgs;
RWStructuredBuffer<uint> _M8CarveDispatchArgs;

float4x4 _MerkabaGridToWorld;
float4x4 _MerkabaWorldToGrid;
float _MerkabaMaxUpdateDistance;

Texture2DArray<float4> gsDilatedDepth;

int _MerkabaExclusionCount;
float3 _MerkabaExclusionHeads[64];

#define EXCLUSION_TOP 0.25
#define EXCLUSION_BOTTOM 1.7
#define EXCLUSION_RADIUS 0.6

int _M8AbortObservation;
uint _M8AttemptToken;

float3 _M8ScanCameraWorld;
int3 _M8ScanCenterBlock;
int _M8ScanBlockRadius;
int _M8ScanBlockSide;

uint M8ObservationFailureReason()
{
    uint reason = _M8Counters[M8_COUNTER_OBSERVATION_FAILURE];
    if (_M8Counters[M8_COUNTER_SURFACE_CANDIDATE_OVERFLOW] != 0u)
        reason |= M8_OBSERVATION_FAILURE_SURFACE_CAPACITY;
    if (_M8AbortObservation != 0)
        reason |= M8_OBSERVATION_FAILURE_TIMEOUT;
    return reason;
}

uint PackRgb(uint r, uint g, uint b)
{
    return r | (g << 8u) | (b << 16u) | (255u << 24u);
}

void AccumulateColor(inout KernelState state, float3 observed, float quality)
{
    uint incomingWeight = (uint)clamp(round(quality * 256.0), 1.0, 256.0);
    uint oldWeight = min(state.colorConfidence, 65535u);
    uint3 observedRgb = (uint3)round(saturate(observed) * 255.0);
    if (oldWeight == 0u)
    {
        state.packedColor = PackRgb(observedRgb.r, observedRgb.g,
            observedRgb.b);
        state.colorConfidence = incomingWeight;
        return;
    }
    uint3 old = uint3(state.packedColor & 255u,
        (state.packedColor >> 8u) & 255u,
        (state.packedColor >> 16u) & 255u);
    uint divisor = oldWeight + incomingWeight;
    uint3 blended = (old * oldWeight + observedRgb * incomingWeight +
        divisor / 2u) / divisor;
    state.packedColor = PackRgb(blended.r, blended.g, blended.b);
    state.colorConfidence = min(65535u, divisor);
}

bool IsExcluded(float3 worldPosition)
{
    [loop]
    for (int exclusion = 0; exclusion < _MerkabaExclusionCount; exclusion++)
    {
        float3 head = _MerkabaExclusionHeads[exclusion];
        float2 difference = worldPosition.xz - head.xz;
        if (dot(difference, difference) < EXCLUSION_RADIUS * EXCLUSION_RADIUS &&
            worldPosition.y < head.y + EXCLUSION_TOP &&
            worldPosition.y > head.y - EXCLUSION_BOTTOM)
            return true;
    }
    return false;
}

uint PackSurfaceMeasurement(uint2 pixel, uint eye, float quality)
{
    uint quality7 = (uint)clamp(round(saturate(quality) * 127.0), 1.0,
        127.0);
    return (pixel.x & MERKABA_MEASUREMENT_PIXEL_MASK) |
        ((pixel.y & MERKABA_MEASUREMENT_PIXEL_MASK) << 12u) |
        ((eye & 1u) << 24u) | (quality7 << 25u);
}

void UnpackSurfaceMeasurement(uint packed, out uint2 pixel, out uint eye,
    out float quality)
{
    pixel.x = packed & MERKABA_MEASUREMENT_PIXEL_MASK;
    pixel.y = (packed >> 12u) & MERKABA_MEASUREMENT_PIXEL_MASK;
    eye = (packed >> 24u) & 1u;
    quality = (float)((packed >> 25u) & 127u) / 127.0;
}

int MerkabaRoundNearest(float value)
{
    return value >= 0.0 ? (int)floor(value + 0.5) : (int)ceil(value - 0.5);
}

int3 MerkabaNearestKernel(float3 gridPosition)
{
    return int3(MerkabaRoundNearest(gridPosition.x),
        MerkabaRoundNearest(gridPosition.y),
        MerkabaRoundNearest(gridPosition.z));
}

bool MerkabaStereoColorCoverage(float3 worldPosition)
{
    [unroll]
    for (uint cameraEye = 0u; cameraEye < 2u; cameraEye++)
    {
        float2 uv = MerkabaProjectCameraUv(cameraEye, worldPosition);
        if (uv.x <= 0.02 || uv.x >= 0.98 || uv.y <= 0.02 || uv.y >= 0.98)
            return false;
    }
    return true;
}

bool TrySurfaceMeasurement(uint eye, uint2 pixel, out float3 worldSurface,
    out int3 surfaceKernel, out float quality, out uint packedMeasurement)
{
    worldSurface = 0.0;
    surfaceKernel = 0;
    quality = 0.0;
    packedMeasurement = 0u;
    if (any(pixel >= gsDepthTexSize) || pixel.x >
        MERKABA_MEASUREMENT_PIXEL_MASK || pixel.y >
        MERKABA_MEASUREMENT_PIXEL_MASK)
        return false;

    float depthNdc = gsDepthTex.Load(int4(pixel, (int)eye, 0));
    if (depthNdc <= 0.0 || depthNdc >= 1.0) return false;
    float2 uv = ((float2)pixel + 0.5) / (float2)gsDepthTexSize;
    worldSurface = gsDepthNDCtoWorld(float3(uv, depthNdc), eye);
    if (IsExcluded(worldSurface) || !MerkabaStereoColorCoverage(worldSurface))
        return false;

    float3 eyeToSurface = worldSurface - gsDepthEyePos(eye);
    float measuredDistance = length(eyeToSurface);
    if (measuredDistance <= 0.05 ||
        measuredDistance > _MerkabaMaxUpdateDistance)
        return false;
    float3 depthNormal = gsDepthNormalTex.Load(
        int4(pixel, (int)eye, 0)).xyz;
    float normalFacing = -dot(eyeToSurface, depthNormal) / measuredDistance;
    if (normalFacing <= MERKABA_NORMAL_MIN) return false;

    float dilatedNdc = gsDilatedDepth.Load(int4(pixel, (int)eye, 0)).z;
    if (dilatedNdc <= 0.0 || dilatedNdc >= 1.0) return false;
    float measuredLinear = gsDepthNDCToLinear(depthNdc, eye);
    float dilatedLinear = gsDepthNDCToLinear(dilatedNdc, eye);
    if (measuredLinear >= dilatedLinear + MERKABA_DEPTH_DISPARITY)
        return false;

    float distanceFactor = saturate(1.0 - measuredDistance /
        _MerkabaMaxUpdateDistance);
    quality = distanceFactor * saturate(normalFacing);
    if (quality < MERKABA_MIN_SURFACE_QUALITY) return false;

    float3 gridSurface = mul(_MerkabaWorldToGrid,
        float4(worldSurface, 1.0)).xyz / MERKABA_LATTICE_STEP;
    surfaceKernel = MerkabaNearestKernel(gridSurface);
    packedMeasurement = PackSurfaceMeasurement(pixel, eye, quality);
    return true;
}

float MerkabaFreeDistanceWeight(float clearance)
{
    return saturate((clearance - MERKABA_HALF_SUPPORT) /
        (MERKABA_FREE_FULL_CLEARANCE - MERKABA_HALF_SUPPORT));
}

bool ObserveDepthEye(uint eye, int3 globalCoord, float3 worldPosition,
    out int kind, out float evidenceWeight, out int3 replacementCoord)
{
    kind = 0;
    evidenceWeight = 0.0;
    replacementCoord = 0;
    float3 viewPosition = mul(gsDepthView[eye],
        float4(worldPosition, 1.0)).xyz;
    if (viewPosition.z > -0.05) return false;
    float3 ndc = gsDepthWorldToNDC(worldPosition, eye);
    if (ndc.x < 0.01 || ndc.x > 0.99 || ndc.y < 0.01 || ndc.y > 0.99)
        return false;
    uint2 pixel = min((uint2)(ndc.xy * (float2)gsDepthTexSize),
        gsDepthTexSize - 1u);
    float3 worldSurface;
    int3 surfaceKernel;
    float quality;
    uint packedMeasurement;
    if (!TrySurfaceMeasurement(eye, pixel, worldSurface, surfaceKernel,
            quality, packedMeasurement))
        return false;

    float kernelDistance = distance(worldPosition, gsDepthEyePos(eye));
    float measuredDistance = distance(worldSurface, gsDepthEyePos(eye));
    float clearance = measuredDistance - kernelDistance;
    replacementCoord = surfaceKernel;
    if (all(globalCoord == surfaceKernel))
    {
        kind = 2;
        evidenceWeight = quality * quality;
    }
    else if (clearance > MERKABA_HALF_SUPPORT)
    {
        kind = 1;
        evidenceWeight = quality * quality *
            MerkabaFreeDistanceWeight(clearance);
    }
    else
        return false;

    // One exact kernel owns SURFACE. Other kernels receive only the transient
    // signed-clearance evidence of this validated four-stream endpoint.
    return true;
}

void FuseDepth(int3 globalCoord, float3 worldPosition, out int kind,
    out float evidenceWeight, out int3 replacementCoord)
{
    kind = 0;
    evidenceWeight = 0.0;
    replacementCoord = 0;
    [unroll]
    for (uint eye = 0u; eye < 2u; eye++)
    {
        int eyeKind = 0;
        float eyeEvidenceWeight = 0.0;
        int3 eyeReplacementCoord = 0;
        if (!ObserveDepthEye(eye, globalCoord, worldPosition, eyeKind,
                eyeEvidenceWeight, eyeReplacementCoord))
            continue;
        if (eyeKind == 2)
        {
            if (kind != 2 || eyeEvidenceWeight > evidenceWeight)
            {
                kind = 2;
                evidenceWeight = eyeEvidenceWeight;
                replacementCoord = eyeReplacementCoord;
            }
        }
        else if (kind == 0 || (kind == 1 &&
            eyeEvidenceWeight > evidenceWeight))
        {
            kind = 1;
            evidenceWeight = eyeEvidenceWeight;
            replacementCoord = eyeReplacementCoord;
        }
    }
}

bool M8TryOccupiedExactForCarve(int3 globalCoord, out bool occupied)
{
    occupied = false;
    MerkabaM8Address address = MerkabaAddressOf(globalCoord);
    uint blockIndex;
    if (!M8FindBlock(address.blockCoord, blockIndex)) return true;
    uint chunkRef = _M8BlockChunkRefsRead[blockIndex *
        MERKABA_M8_BLOCK_CHUNK_COUNT + address.chunkLocal];
    if (chunkRef == MERKABA_REF_EMPTY) return true;
    if (chunkRef == MERKABA_REF_CLAIMED_NEW) return false;
    uint chunkIndex = chunkRef - 1u;
    if (chunkIndex >= MERKABA_M8_CHUNK_CAPACITY) return false;
    uint tileRef = _M8ChunkTileRefsRead[chunkIndex *
        MERKABA_M8_TILES_PER_CHUNK + address.tileLocal];
    if (tileRef == MERKABA_REF_EMPTY) return true;
    if (!M8IsHotRef(tileRef)) return false;
    uint physicalSlot = M8PhysicalSlot(tileRef);
    uint word = M8TileWordIndex(physicalSlot, address.kernelLocal >> 5u);
    occupied = (_M8TileBits[word].x &
        (1u << (address.kernelLocal & 31u))) != 0u;
    return true;
}

void UpdateOccupancy(uint physicalSlot, uint kernelLocal,
    inout KernelState state, int delta)
{
    bool occupiedBefore = (state.flags & MERKABA_OCCUPIED_FLAG) != 0u;
    state.evidence = clamp(state.evidence + delta,
        -MERKABA_EVIDENCE_CONFIDENCE_LIMIT,
        MERKABA_EVIDENCE_CONFIDENCE_LIMIT);
    bool occupiedAfter = occupiedBefore
        ? state.evidence > MERKABA_OCCUPIED_OFF
        : state.evidence >= MERKABA_OCCUPIED_ON;
    if (occupiedAfter) state.flags |= MERKABA_OCCUPIED_FLAG;
    else state.flags &= ~MERKABA_OCCUPIED_FLAG;
    if (occupiedBefore == occupiedAfter) return;

    uint wordIndex = M8TileWordIndex(physicalSlot, kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    uint ignored;
    if (occupiedAfter)
    {
        InterlockedOr(_M8TileBits[wordIndex].x, bit, ignored);
        InterlockedAdd(_M8TileRecords[M8TileMetaIndex(physicalSlot)].z,
            1u, ignored);
        InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_KERNEL_COUNT], 1u,
            ignored);
    }
    else
    {
        InterlockedAnd(_M8TileBits[wordIndex].x, ~bit, ignored);
        InterlockedAdd(_M8TileRecords[M8TileMetaIndex(physicalSlot)].z,
            0xffffffffu, ignored);
        InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_KERNEL_COUNT],
            0xffffffffu, ignored);
    }
}

void EnsureCarveActive(uint physicalSlot, uint kernelLocal)
{
    uint wordIndex = M8TileWordIndex(physicalSlot, kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    uint previous;
    InterlockedOr(_M8TileBits[wordIndex].y, bit, previous);
    if ((previous & bit) == 0u)
    {
        uint ignored;
        InterlockedAdd(_M8TileRecords[M8TileMetaIndex(physicalSlot)].w,
            1u, ignored);
    }
}

void AppendSurfaceCandidate(int3 globalCoord, uint packedMeasurement)
{
    uint index;
    InterlockedAdd(_M8Counters[M8_COUNTER_SURFACE_CANDIDATE_COUNT], 1u,
        index);
    if (index < MERKABA_M8_SURFACE_CANDIDATE_CAPACITY)
    {
        _M8SurfaceCandidates[index] = int4(globalCoord,
            asint(packedMeasurement));
        M8CounterIncrement(M8_COUNTER_VALID_SURFACE_CANDIDATES);
    }
    else
        _M8Counters[M8_COUNTER_SURFACE_CANDIDATE_OVERFLOW] = 1u;
}

[numthreads(8, 8, 1)]
void DiscoverSurfaceCandidates(uint3 id : SV_DispatchThreadID)
{
    if (id.z >= 2u || id.x >= gsDepthTexSize.x || id.y >= gsDepthTexSize.y)
        return;
    float3 worldSurface;
    int3 surfaceKernel;
    float quality;
    uint packedMeasurement;
    if (!TrySurfaceMeasurement(id.z, id.xy, worldSurface, surfaceKernel,
            quality, packedMeasurement))
        return;
    AppendSurfaceCandidate(surfaceKernel, packedMeasurement);
}

[numthreads(1, 1, 1)]
void PrepareResolveArgs(uint id : SV_DispatchThreadID)
{
    _M8Counters[M8_COUNTER_ATTEMPT_TOKEN] = _M8AttemptToken;
    _M8Counters[M8_COUNTER_ATTEMPT_COMPLETED_TOKEN] = 0u;
    // CARVE discovery is attempt-local. Surface candidates remain latched for
    // the immutable observation until one fully-resident attempt commits it.
    _M8Counters[M8_COUNTER_CARVE_TILE_COUNT] = 0u;
    _M8Counters[M8_COUNTER_UNRESOLVED_CARVE_TILES] = 0u;
    uint count = min(_M8Counters[M8_COUNTER_SURFACE_CANDIDATE_COUNT],
        MERKABA_M8_SURFACE_CANDIDATE_CAPACITY);
    uint completed = _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED];
    uint failure = completed == 0u ? M8ObservationFailureReason() :
        _M8Counters[M8_COUNTER_OBSERVATION_FAILURE];
    _M8Counters[M8_COUNTER_OBSERVATION_FAILURE] = failure;
    _M8ObservationDispatchArgs[0] = completed == 0u && failure == 0u
        ? (count + 63u) / 64u : 0u;
    _M8ObservationDispatchArgs[1] = 1u;
    _M8ObservationDispatchArgs[2] = 1u;
}

bool RequestColdTile(uint tileRefIndex, uint chunkIndex, uint tileLocal,
    bool scanRequest)
{
    bool queued = M8QueueColdTileLoad(tileRefIndex, chunkIndex, tileLocal);
    if (scanRequest && queued)
        M8CounterIncrement(M8_COUNTER_SCAN_COLD_MISSES);
    return queued;
}

bool CandidateAt(uint id, out MerkabaM8Address address)
{
    uint count = min(_M8Counters[M8_COUNTER_SURFACE_CANDIDATE_COUNT],
        MERKABA_M8_SURFACE_CANDIDATE_CAPACITY);
    if (id >= count)
    {
        address = (MerkabaM8Address)0;
        return false;
    }
    address = MerkabaAddressOf(_M8SurfaceCandidatesRead[id].xyz);
    return true;
}

[numthreads(64, 1, 1)]
void ResolveSurfaceBlocks(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] != 0u) return;
    MerkabaM8Address address = (MerkabaM8Address)0;
    if (!CandidateAt(id, address)) return;
    uint blockIndex = 0u;
    uint failureReason = 0u;
    M8FindOrClaimBlock(address.blockCoord, blockIndex, failureReason);
    if (failureReason != 0u)
    {
        uint ignored;
        InterlockedOr(_M8Counters[M8_COUNTER_OBSERVATION_FAILURE],
            failureReason, ignored);
    }
}

[numthreads(64, 1, 1)]
void ResolveSurfaceChunks(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] != 0u) return;
    if (_M8Counters[M8_COUNTER_OBSERVATION_FAILURE] != 0u) return;
    MerkabaM8Address address = (MerkabaM8Address)0;
    if (!CandidateAt(id, address)) return;
    uint blockIndex = 0u;
    if (!M8FindBlock(address.blockCoord, blockIndex)) return;
    uint chunkIndex = 0u;
    uint failureReason = 0u;
    M8FindOrClaimChunk(blockIndex, address.chunkLocal, chunkIndex,
        failureReason);
    if (failureReason != 0u)
    {
        uint ignored;
        InterlockedOr(_M8Counters[M8_COUNTER_OBSERVATION_FAILURE],
            failureReason, ignored);
    }
}

[numthreads(64, 1, 1)]
void ResolveSurfaceTiles(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] != 0u) return;
    if (_M8Counters[M8_COUNTER_OBSERVATION_FAILURE] != 0u) return;
    MerkabaM8Address address = (MerkabaM8Address)0;
    if (!CandidateAt(id, address)) return;
    uint blockIndex = 0u;
    if (!M8FindBlock(address.blockCoord, blockIndex)) return;
    uint chunkRef = _M8BlockChunkRefsRead[blockIndex *
        MERKABA_M8_BLOCK_CHUNK_COUNT + address.chunkLocal];
    if (chunkRef == MERKABA_REF_EMPTY ||
        chunkRef >= MERKABA_REF_EVICTING) return;
    uint chunkIndex = chunkRef - 1u;
    uint tileRefIndex = chunkIndex * MERKABA_M8_TILES_PER_CHUNK +
        address.tileLocal;
    uint tileRef = _M8ChunkTileRefs[tileRefIndex];
    if (tileRef == MERKABA_REF_EMPTY)
    {
        uint prior;
        InterlockedCompareExchange(_M8ChunkTileRefs[tileRefIndex],
            MERKABA_REF_EMPTY, MERKABA_REF_CLAIMED_NEW, prior);
        if (prior == MERKABA_REF_EMPTY)
        {
            uint d1 = (address.tileLocal >> 3u) & 7u;
            uint d0 = address.tileLocal & 7u;
            uint ignored;
            InterlockedOr(
                _M8ChunkPresence[M8ChunkPresenceL0Index(chunkIndex)],
                1u << d1, ignored);
            InterlockedOr(
                _M8ChunkPresence[M8ChunkPresenceL1Index(chunkIndex, d1)],
                1u << d0, ignored);
            uint pendingIndex;
            InterlockedAdd(_M8Counters[M8_COUNTER_PENDING_NEW_TILE_COUNT],
                1u, pendingIndex);
            if (pendingIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                _M8PendingNewTileRefs[pendingIndex] = tileRefIndex;
            else
            {
                InterlockedCompareExchange(
                    _M8ChunkTileRefs[tileRefIndex],
                    MERKABA_REF_CLAIMED_NEW, MERKABA_REF_EMPTY, prior);
                InterlockedOr(_M8Counters[M8_COUNTER_OBSERVATION_FAILURE],
                    M8_OBSERVATION_FAILURE_PHYSICAL_CAPACITY, ignored);
            }
        }
        return;
    }
    if (tileRef == MERKABA_REF_COLD_ON_SSD)
    {
        RequestColdTile(tileRefIndex, chunkIndex, address.tileLocal, true);
        return;
    }
}

[numthreads(64, 1, 1)]
void QueueResolvedSurfaceCandidates(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] != 0u) return;
    if (_M8Counters[M8_COUNTER_OBSERVATION_FAILURE] != 0u) return;
    MerkabaM8Address address = (MerkabaM8Address)0;
    if (!CandidateAt(id, address)) return;
    uint blockIndex = 0u;
    if (!M8FindBlock(address.blockCoord, blockIndex))
    {
        M8CounterIncrement(M8_COUNTER_UNRESOLVED_SURFACE_TILES);
        return;
    }
    uint chunkRef = _M8BlockChunkRefsRead[blockIndex *
        MERKABA_M8_BLOCK_CHUNK_COUNT + address.chunkLocal];
    if (chunkRef == MERKABA_REF_EMPTY ||
        chunkRef >= MERKABA_REF_EVICTING)
    {
        M8CounterIncrement(M8_COUNTER_UNRESOLVED_SURFACE_TILES);
        return;
    }
    uint chunkIndex = chunkRef - 1u;
    uint tileRefIndex = chunkIndex * MERKABA_M8_TILES_PER_CHUNK +
        address.tileLocal;
    uint tileRef = _M8ChunkTileRefsRead[tileRefIndex];
    if (!M8IsHotRef(tileRef))
    {
        M8CounterIncrement(M8_COUNTER_UNRESOLVED_SURFACE_TILES);
        return;
    }
    uint physicalSlot = M8PhysicalSlot(tileRef);
    _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].z =
        _M8Counters[M8_COUNTER_FRAME_EPOCH];
    uint wordIndex = M8TileWordIndex(physicalSlot,
        address.kernelLocal >> 5u);
    uint bit = 1u << (address.kernelLocal & 31u);
    uint previous;
    InterlockedOr(_M8TileBits[wordIndex].z, bit, previous);
    if ((previous & bit) != 0u) return;

    uint touchedBefore;
    InterlockedCompareExchange(
        _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].x,
        0u, 1u, touchedBefore);
    if (touchedBefore == 0u)
    {
        uint touchedIndex;
        InterlockedAdd(_M8Counters[M8_COUNTER_TOUCHED_TILE_COUNT], 1u,
            touchedIndex);
        if (touchedIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
            _M8TouchedTileQueue[touchedIndex] = physicalSlot;
    }

    uint queueIndex;
    InterlockedAdd(_M8Counters[M8_COUNTER_SURFACE_QUEUE_COUNT], 1u,
        queueIndex);
    if (queueIndex < MERKABA_SURFACE_QUEUE_CAPACITY)
    {
        uint key = physicalSlot * MERKABA_M8_KERNELS_PER_TILE +
            address.kernelLocal;
        _M8SurfaceQueue[queueIndex] = uint2(key,
            asuint(_M8SurfaceCandidatesRead[id].w));
        M8CounterIncrement(M8_COUNTER_UNIQUE_SURFACE_KERNELS);
    }
    else
        _M8Counters[M8_COUNTER_SURFACE_CANDIDATE_OVERFLOW] = 1u;
}

[numthreads(64, 1, 1)]
void RetryPendingNewTiles(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] != 0u) return;
    if (_M8Counters[M8_COUNTER_OBSERVATION_FAILURE] != 0u) return;
    uint count = min(_M8Counters[M8_COUNTER_PENDING_NEW_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    if (id >= count) return;
    uint tileRefIndex = _M8PendingNewTileRefsRead[id];
    if (_M8ChunkTileRefsRead[tileRefIndex] != MERKABA_REF_CLAIMED_NEW) return;
    uint queueIndex;
    InterlockedAdd(_M8Counters[M8_COUNTER_NEW_TILE_QUEUE_COUNT], 1u,
        queueIndex);
    if (queueIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
        _M8ClaimQueue[MERKABA_M8_CLAIM_TILE_OFFSET + queueIndex] =
            uint2(tileRefIndex, 0u);
}

[numthreads(1, 1, 1)]
void PrepareIntegrateArgs(uint id : SV_DispatchThreadID)
{
    uint count = min(_M8Counters[M8_COUNTER_SURFACE_QUEUE_COUNT],
        MERKABA_SURFACE_QUEUE_CAPACITY);
    uint completed = _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED];
    uint failure = completed == 0u ? M8ObservationFailureReason() :
        _M8Counters[M8_COUNTER_OBSERVATION_FAILURE];
    _M8Counters[M8_COUNTER_OBSERVATION_FAILURE] = failure;
    _M8ObservationDispatchArgs[0] =
        _M8Counters[M8_COUNTER_UNRESOLVED_SURFACE_TILES] == 0u &&
        _M8Counters[M8_COUNTER_UNRESOLVED_CARVE_TILES] == 0u &&
        completed == 0u && failure == 0u
        ? (count + 63u) / 64u : 0u;
    _M8ObservationDispatchArgs[1] = 1u;
    _M8ObservationDispatchArgs[2] = 1u;
}

[numthreads(64, 1, 1)]
void IntegrateSurfaceCandidates(uint id : SV_DispatchThreadID)
{
    uint count = min(_M8Counters[M8_COUNTER_SURFACE_QUEUE_COUNT],
        MERKABA_SURFACE_QUEUE_CAPACITY);
    if (id >= count) return;
    uint2 queued = _M8SurfaceQueueRead[id];
    uint key = queued.x;
    uint physicalSlot = key / MERKABA_M8_KERNELS_PER_TILE;
    uint kernelLocal = key % MERKABA_M8_KERNELS_PER_TILE;
    uint2 sourcePixel;
    uint sourceEye;
    float quality;
    UnpackSurfaceMeasurement(queued.y, sourcePixel, sourceEye, quality);
    float depthNdc = gsDepthTex.Load(int4(sourcePixel, (int)sourceEye, 0));
    float2 sourceUv = ((float2)sourcePixel + 0.5) /
        (float2)gsDepthTexSize;
    float3 worldSurface = gsDepthNDCtoWorld(
        float3(sourceUv, depthNdc), sourceEye);

    KernelState state = M8LoadKernelState(physicalSlot, kernelLocal);
    UpdateOccupancy(physicalSlot, kernelLocal, state,
        max(1, (int)round(quality * quality * MERKABA_SURFACE_SCALE)));
    state.flags |= MERKABA_NEEDS_CARVE_FLAG;
    float2 leftUv = MerkabaProjectCameraUv(0u, worldSurface);
    float2 rightUv = MerkabaProjectCameraUv(1u, worldSurface);
    float3 observedRgb = (MerkabaSampleCameraRgb(0u, leftUv) +
        MerkabaSampleCameraRgb(1u, rightUv)) * 0.5;
    AccumulateColor(state, observedRgb, quality);
    M8StoreKernelState(physicalSlot, kernelLocal, state);
    EnsureCarveActive(physicalSlot, kernelLocal);
    _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].y = 1u;
}

uint M8ScanChildMask(int3 parentMin, int parentSpan)
{
    return MerkabaM8DistanceChildMask(parentMin, parentSpan,
        _MerkabaMaxUpdateDistance, _M8ScanCameraWorld, _MerkabaGridToWorld,
        _MerkabaWorldToGrid, MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
}

groupshared uint gScanBlockRef;
groupshared int3 gScanBlockMin;
groupshared uint gScanSupport4;
groupshared uint gScanSupport3[8];

[numthreads(64, 1, 1)]
void QueryCarveTiles(uint3 groupId : SV_GroupID, uint thread : SV_GroupIndex)
{
    uint linearBlockIndex = groupId.x;
    if (thread == 0u)
    {
        gScanBlockRef = 0u;
        gScanSupport4 = 0u;
        uint side = (uint)_M8ScanBlockSide;
        bool observationReady =
            _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] == 0u &&
            _M8Counters[M8_COUNTER_OBSERVATION_FAILURE] == 0u &&
            _M8Counters[M8_COUNTER_UNRESOLVED_SURFACE_TILES] == 0u;
        if (observationReady && linearBlockIndex < side * side * side)
        {
            int3 offset;
            offset.x = (int)(linearBlockIndex % side) - _M8ScanBlockRadius;
            offset.y = (int)((linearBlockIndex / side) % side) -
                _M8ScanBlockRadius;
            offset.z = (int)(linearBlockIndex / (side * side)) -
                _M8ScanBlockRadius;
            int3 blockCoord = _M8ScanCenterBlock + offset;
            gScanBlockMin = blockCoord * MERKABA_M8_BLOCK_KERNEL_SPAN;
            gScanSupport4 = M8ScanChildMask(gScanBlockMin, 256);
            if (gScanSupport4 != 0u)
            {
                uint blockIndex = 0u;
                if (M8FindBlock(blockCoord, blockIndex))
                {
                    gScanBlockRef = blockIndex + 1u;
                    M8CounterIncrement(M8_COUNTER_CARVE_QUERY_BLOCKS);
                }
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (thread < 8u)
    {
        uint d4ForMask = thread;
        gScanSupport3[d4ForMask] = 0u;
        if (gScanBlockRef != 0u)
        {
            uint maskBlockIndex = gScanBlockRef - 1u;
            if (((_M8BlockPresenceL0Read[maskBlockIndex] & gScanSupport4) &
                (1u << d4ForMask)) != 0u)
            {
                int3 min4ForMask = gScanBlockMin +
                    MerkabaM8OctantOffset(d4ForMask, 128);
                gScanSupport3[d4ForMask] = M8ScanChildMask(min4ForMask, 128);
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gScanBlockRef == 0u) return;

    uint blockIndex = gScanBlockRef - 1u;
    int3 blockMin = gScanBlockMin;
    uint d4 = thread >> 3u;
    uint d3 = thread & 7u;
    if (((gScanSupport4 >> d4) & 1u) == 0u ||
        (((_M8BlockPresenceL1Read[blockIndex * 8u + d4] &
        gScanSupport3[d4]) >> d3) & 1u) == 0u) return;

    int3 min4 = blockMin + MerkabaM8OctantOffset(d4, 128);
    int3 min3 = min4 + MerkabaM8OctantOffset(d3, 64);
    uint scan2 = M8ScanChildMask(min3, 64);
    uint support2 = (_M8BlockPresenceL2Read[blockIndex * 64u +
        d4 * 8u + d3] & 255u) & scan2;
    while (support2 != 0u)
    {
        uint d2 = (uint)firstbitlow(support2);
        support2 &= support2 - 1u;
        uint chunkLocal = (d4 << 6u) | (d3 << 3u) | d2;
        uint chunkRef = _M8BlockChunkRefsRead[blockIndex * 512u + chunkLocal];
        if (chunkRef == 0u || chunkRef >= MERKABA_REF_EVICTING) continue;
        uint chunkIndex = chunkRef - 1u;
        int3 min2 = min3 + MerkabaM8OctantOffset(d2, 32);
        uint scan1 = M8ScanChildMask(min2, 32);
        uint support1 =
            (_M8ChunkPresenceRead[M8ChunkPresenceL0Index(chunkIndex)] &
            255u) & scan1;
        while (support1 != 0u)
        {
            uint d1 = (uint)firstbitlow(support1);
            support1 &= support1 - 1u;
            int3 min1 = min2 + MerkabaM8OctantOffset(d1, 16);
            uint scan0 = M8ScanChildMask(min1, 16);
            uint support0 =
                (_M8ChunkPresenceRead[
                    M8ChunkPresenceL1Index(chunkIndex, d1)] & 255u) & scan0;
            while (support0 != 0u)
            {
                uint d0 = (uint)firstbitlow(support0);
                support0 &= support0 - 1u;
                uint tileLocal = (d1 << 3u) | d0;
                uint tileRefIndex = chunkIndex * 64u + tileLocal;
                uint tileRef = _M8ChunkTileRefs[tileRefIndex];
                if (tileRef == MERKABA_REF_COLD_ON_SSD)
                {
                    if (RequestColdTile(tileRefIndex, chunkIndex, tileLocal,
                        true))
                        M8CounterIncrement(
                            M8_COUNTER_COLD_CARVE_TILES_REQUESTED);
                    M8CounterIncrement(
                        M8_COUNTER_UNRESOLVED_CARVE_TILES);
                    continue;
                }
                if (!M8IsHotRef(tileRef))
                {
                    M8CounterIncrement(
                        M8_COUNTER_UNRESOLVED_CARVE_TILES);
                    continue;
                }
                uint physicalSlot = M8PhysicalSlot(tileRef);
                if (_M8TileRecords[M8TileMetaIndex(physicalSlot)].w == 0u)
                    continue;
                _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].z =
                    _M8Counters[M8_COUNTER_FRAME_EPOCH];
                uint queueIndex;
                InterlockedAdd(_M8Counters[M8_COUNTER_CARVE_TILE_COUNT],
                    1u, queueIndex);
                if (queueIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                    _M8CarveTiles[queueIndex] = physicalSlot;
                M8CounterIncrement(M8_COUNTER_CARVE_QUERY_TILES);
            }
        }
    }
}

[numthreads(1, 1, 1)]
void PrepareCarveArgs(uint id : SV_DispatchThreadID)
{
    uint count = min(_M8Counters[M8_COUNTER_CARVE_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    _M8CarveDispatchArgs[0] =
        _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] == 0u &&
        _M8Counters[M8_COUNTER_UNRESOLVED_SURFACE_TILES] == 0u &&
        _M8Counters[M8_COUNTER_UNRESOLVED_CARVE_TILES] == 0u &&
        _M8Counters[M8_COUNTER_OBSERVATION_FAILURE] == 0u
        ? count : 0u;
    _M8CarveDispatchArgs[1] = 8u;
    _M8CarveDispatchArgs[2] = 1u;
}

groupshared uint gCarveStats[7];

bool RetireCarveActive(uint physicalSlot, uint kernelLocal)
{
    uint wordIndex = M8TileWordIndex(physicalSlot, kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    uint previous;
    InterlockedAnd(_M8TileBits[wordIndex].y, ~bit, previous);
    if ((previous & bit) == 0u) return false;
    uint ignored;
    InterlockedAdd(_M8TileRecords[M8TileMetaIndex(physicalSlot)].w,
        0xffffffffu, ignored);
    return true;
}

void FlushCarveStat(uint counterIndex, uint value)
{
    if (value == 0u) return;
    uint ignored;
    InterlockedAdd(_M8Counters[counterIndex], value, ignored);
}

[numthreads(64, 1, 1)]
void IntegrateCarveTiles(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint physicalSlot = _M8CarveTilesRead[groupId.x];
    uint kernelLocal = groupId.y * 64u + thread;
    uint wordIndex = M8TileWordIndex(physicalSlot, kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    if (thread < 7u) gCarveStats[thread] = 0u;
    GroupMemoryBarrierWithGroupSync();

    if ((_M8TileBits[wordIndex].y & bit) != 0u)
    {
        uint ignored;
        InterlockedAdd(gCarveStats[0], 1u, ignored);
        KernelState state = M8LoadKernelState(physicalSlot, kernelLocal);
        bool occupiedBefore =
            (state.flags & MERKABA_OCCUPIED_FLAG) != 0u;
        bool alreadyStrongFree = !occupiedBefore &&
            state.evidence <= MERKABA_EXPORT_KNOWN_FREE;
        if (alreadyStrongFree)
        {
            if ((state.flags & MERKABA_NEEDS_CARVE_FLAG) != 0u)
            {
                state.flags &= ~MERKABA_NEEDS_CARVE_FLAG;
                M8StoreKernelState(physicalSlot, kernelLocal, state);
                _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].y = 1u;
            }
            if (RetireCarveActive(physicalSlot, kernelLocal))
                InterlockedAdd(gCarveStats[6], 1u, ignored);
        }
        else
        {
            int3 globalCoord = M8GlobalKernelCoord(physicalSlot, kernelLocal);
            float3 worldPosition = mul(_MerkabaGridToWorld,
                float4((float3)globalCoord * MERKABA_LATTICE_STEP, 1.0)).xyz;
            int observationKind = 0;
            float evidenceWeight = 0.0;
            int3 replacementCoord = 0;
            if (!IsExcluded(worldPosition))
                FuseDepth(globalCoord, worldPosition, observationKind,
                    evidenceWeight, replacementCoord);

            if (observationKind == 1)
            {
                InterlockedAdd(gCarveStats[1], 1u, ignored);
                int evidenceBefore = state.evidence;
                int decrement = max(1, (int)round(evidenceWeight *
                    MERKABA_FREE_SCALE));
                if (occupiedBefore && evidenceBefore - decrement <=
                    MERKABA_OCCUPIED_OFF)
                {
                    bool replacementOccupied = false;
                    bool replacementResolved = M8TryOccupiedExactForCarve(
                        replacementCoord, replacementOccupied);
                    if (!replacementResolved || !replacementOccupied)
                        decrement = min(decrement, max(0,
                            evidenceBefore - (MERKABA_OCCUPIED_OFF + 1)));
                }
                if (decrement > 0)
                    UpdateOccupancy(physicalSlot, kernelLocal, state,
                        -decrement);
                bool occupiedAfter =
                    (state.flags & MERKABA_OCCUPIED_FLAG) != 0u;
                if (state.evidence < evidenceBefore)
                    InterlockedAdd(gCarveStats[4], 1u, ignored);
                if (occupiedBefore && !occupiedAfter)
                    InterlockedAdd(gCarveStats[5], 1u, ignored);
                if (!occupiedAfter &&
                    state.evidence <= MERKABA_EXPORT_KNOWN_FREE)
                {
                    state.flags &= ~MERKABA_NEEDS_CARVE_FLAG;
                    if (RetireCarveActive(physicalSlot, kernelLocal))
                        InterlockedAdd(gCarveStats[6], 1u, ignored);
                }
                if (state.evidence != evidenceBefore)
                {
                    M8StoreKernelState(physicalSlot, kernelLocal, state);
                    _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].y = 1u;
                }
            }
            else if (observationKind == 2)
            {
                InterlockedAdd(gCarveStats[2], 1u, ignored);
                if ((state.flags & MERKABA_NEEDS_CARVE_FLAG) == 0u)
                {
                    state.flags |= MERKABA_NEEDS_CARVE_FLAG;
                    M8StoreKernelState(physicalSlot, kernelLocal, state);
                    _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].y = 1u;
                }
            }
            else
                InterlockedAdd(gCarveStats[3], 1u, ignored);
        }
    }

    GroupMemoryBarrierWithGroupSync();
    if (thread == 0u)
    {
        FlushCarveStat(M8_COUNTER_CARVE_ACTIVE_KERNELS, gCarveStats[0]);
        FlushCarveStat(M8_COUNTER_CARVE_CLASSIFIED_FREE, gCarveStats[1]);
        FlushCarveStat(M8_COUNTER_CARVE_CLASSIFIED_SURFACE, gCarveStats[2]);
        FlushCarveStat(M8_COUNTER_CARVE_CLASSIFIED_UNKNOWN, gCarveStats[3]);
        FlushCarveStat(M8_COUNTER_CARVE_EVIDENCE_DECREMENTS, gCarveStats[4]);
        FlushCarveStat(M8_COUNTER_CARVE_OCCUPIED_TO_FREE, gCarveStats[5]);
        FlushCarveStat(M8_COUNTER_CARVE_BITS_RETIRED, gCarveStats[6]);
    }
}

[numthreads(1, 1, 1)]
void FinalizeObservation(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] == 0u)
    {
        uint failure = M8ObservationFailureReason();
        _M8Counters[M8_COUNTER_OBSERVATION_FAILURE] = failure;
        if (failure != 0u)
        {
            _M8Counters[M8_COUNTER_FAILED_OBSERVATIONS] += 1u;
            _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] = 1u;
        }
        else if (_M8Counters[M8_COUNTER_UNRESOLVED_SURFACE_TILES] == 0u &&
            _M8Counters[M8_COUNTER_UNRESOLVED_CARVE_TILES] == 0u)
            _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] = 1u;
    }
    uint completed = _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED];
    uint failure = _M8Counters[M8_COUNTER_OBSERVATION_FAILURE];
    uint touchedCount = completed != 0u
        ? min(_M8Counters[M8_COUNTER_TOUCHED_TILE_COUNT],
            MERKABA_M8_PHYSICAL_TILE_CAPACITY) : 0u;
    uint pendingCount = completed != 0u && failure != 0u
        ? min(_M8Counters[M8_COUNTER_PENDING_NEW_TILE_COUNT],
            MERKABA_M8_PHYSICAL_TILE_CAPACITY) : 0u;
    _M8Counters[M8_COUNTER_CLEANUP_TOUCHED_COUNT] = touchedCount;
    _M8Counters[M8_COUNTER_CLEANUP_PENDING_COUNT] = pendingCount;
    _M8ObservationDispatchArgs[0] = max(touchedCount, pendingCount);
    _M8ObservationDispatchArgs[1] = 1u;
    _M8ObservationDispatchArgs[2] = 1u;
    _M8Counters[M8_COUNTER_ATTEMPT_COMPLETED_TOKEN] = _M8AttemptToken;
}
