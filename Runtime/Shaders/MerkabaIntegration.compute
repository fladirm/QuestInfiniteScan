// Quest Infinite Merkaba - sparse depth candidates + reversible occupancy evidence.
// The signed depth relation is transient classification only; no field is stored.
#pragma kernel GenerateSurfaceCandidates
#pragma kernel PrepareIndirectArgs
#pragma kernel IntegrateSurfaceCandidates
#pragma kernel GatherCarveCandidates
#pragma kernel IntegrateCarveCandidates

#include "DepthKit.hlsl"

#define MERKABA_CHUNK_SIZE 32
#define MERKABA_KERNELS_PER_CHUNK 32768
#define MERKABA_LATTICE_STEP 0.025
#define MERKABA_HALF_SUPPORT 0.025
#define MERKABA_EVIDENCE_MIN -32768
#define MERKABA_EVIDENCE_MAX 32767
#define MERKABA_OCCUPIED_ON 512
#define MERKABA_OCCUPIED_OFF 128
#define MERKABA_EXPORT_KNOWN_FREE -512
#define MERKABA_SURFACE_SCALE 640.0
#define MERKABA_FREE_SCALE 256.0
#define MERKABA_MIN_SURFACE_QUALITY 0.25
#define MERKABA_OCCUPIED_FLAG 1u
#define MERKABA_NORMAL_MIN 0.3
#define MERKABA_DEPTH_DISPARITY 0.5

struct KernelState
{
    int evidence;
    uint packedColor;
    uint colorConfidence;
    uint flags;
};

RWStructuredBuffer<KernelState> _MerkabaKernels;
StructuredBuffer<int4> _MerkabaPageCoords;
StructuredBuffer<int> _MerkabaPageNeighbours;
StructuredBuffer<int> _MerkabaIntegrationSlots;
StructuredBuffer<uint> _MerkabaIntegrationEnabledSlots;
RWStructuredBuffer<uint> _MerkabaKernelDirty;
StructuredBuffer<int4> _MerkabaPageHash;
int _MerkabaPageHashCapacity;

RWStructuredBuffer<uint> _MerkabaSurfaceCandidateBits;
RWStructuredBuffer<uint> _MerkabaSurfaceQueue;
RWStructuredBuffer<uint> _MerkabaSurfaceCount;
RWStructuredBuffer<uint> _MerkabaCarveListedBits;
RWStructuredBuffer<uint> _MerkabaCarveLocalIndices;
RWStructuredBuffer<uint> _MerkabaCarveCounts;
RWStructuredBuffer<uint> _MerkabaCarveQueue;
RWStructuredBuffer<uint> _MerkabaCarveCount;
StructuredBuffer<uint> _MerkabaWorkCount;
RWStructuredBuffer<uint> _MerkabaIndirectArgs;

int _MerkabaIntegrationChunkCount;
int _MerkabaWorkCapacity;
float4x4 _MerkabaGridToWorld;
float4x4 _MerkabaWorldToGrid;
float _MerkabaMaxUpdateDistance;

Texture2DArray<float4> gsDilatedDepth;

int _MerkabaExclusionCount;
float3 _MerkabaExclusionHeads[64];

#define EXCLUSION_TOP 0.25
#define EXCLUSION_BOTTOM 1.7
#define EXCLUSION_RADIUS 0.6

Texture2D<float4> _MerkabaCameraRgb;
int _MerkabaCameraAvailable;
float3 _MerkabaCameraPosition;
float4x4 _MerkabaCameraInverseRotation;
float2 _MerkabaCameraFocalLength;
float2 _MerkabaCameraPrincipalPoint;
float2 _MerkabaCameraSensorResolution;
float2 _MerkabaCameraCurrentResolution;
float _MerkabaCameraExposure;

int3 UnflattenKernel(uint index)
{
    int x = index % MERKABA_CHUNK_SIZE;
    int yz = index / MERKABA_CHUNK_SIZE;
    return int3(x, yz % MERKABA_CHUNK_SIZE, yz / MERKABA_CHUNK_SIZE);
}

uint FlattenKernel(int3 localCoord)
{
    return (uint)(localCoord.x + MERKABA_CHUNK_SIZE *
        (localCoord.y + MERKABA_CHUNK_SIZE * localCoord.z));
}

int FloorDivChunk(int value)
{
    return value >= 0 ? value / MERKABA_CHUNK_SIZE :
        -((-value + MERKABA_CHUNK_SIZE - 1) / MERKABA_CHUNK_SIZE);
}

int3 ChunkCoordOf(int3 globalCoord)
{
    return int3(FloorDivChunk(globalCoord.x), FloorDivChunk(globalCoord.y),
        FloorDivChunk(globalCoord.z));
}

int3 LocalCoordOf(int3 globalCoord, int3 chunkCoord)
{
    return globalCoord - chunkCoord * MERKABA_CHUNK_SIZE;
}

uint HashPageCoord(int3 coord)
{
    return (uint)coord.x * 73856093u ^ (uint)coord.y * 19349663u ^
        (uint)coord.z * 83492791u;
}

int FindIntegrationPage(int3 chunkCoord)
{
    uint mask = (uint)(_MerkabaPageHashCapacity - 1);
    uint index = HashPageCoord(chunkCoord) & mask;
    [loop]
    for (int probe = 0; probe < _MerkabaPageHashCapacity; probe++)
    {
        int4 entry = _MerkabaPageHash[index];
        if (entry.w < 0) return -1;
        if (all(entry.xyz == chunkCoord))
            return _MerkabaIntegrationEnabledSlots[entry.w] != 0u ? entry.w : -1;
        index = (index + 1u) & mask;
    }
    return -1;
}

void AppendSurfaceCandidate(int3 globalCoord)
{
    int3 chunkCoord = ChunkCoordOf(globalCoord);
    int slot = FindIntegrationPage(chunkCoord);
    if (slot < 0) return;
    int3 localCoord = LocalCoordOf(globalCoord, chunkCoord);
    uint stateIndex = (uint)slot * MERKABA_KERNELS_PER_CHUNK +
        FlattenKernel(localCoord);
    uint wordIndex = stateIndex >> 5u;
    uint bit = 1u << (stateIndex & 31u);
    uint previous;
    InterlockedOr(_MerkabaSurfaceCandidateBits[wordIndex], bit, previous);
    if ((previous & bit) != 0u) return;

    uint queueIndex;
    InterlockedAdd(_MerkabaSurfaceCount[0], 1u, queueIndex);
    if (queueIndex < (uint)_MerkabaWorkCapacity)
        _MerkabaSurfaceQueue[queueIndex] = stateIndex;
}

int NeighbourPageSlot(int slot, int3 delta)
{
    int index = (delta.x + 1) + 3 * (delta.y + 1) + 9 * (delta.z + 1);
    return _MerkabaPageNeighbours[slot * 27 + index];
}

void MarkKernelDirty(int slot, int3 localCoord)
{
    int3 pageDelta = int3(0, 0, 0);
    if (localCoord.x < 0) { localCoord.x += MERKABA_CHUNK_SIZE; pageDelta.x = -1; }
    else if (localCoord.x >= MERKABA_CHUNK_SIZE) { localCoord.x -= MERKABA_CHUNK_SIZE; pageDelta.x = 1; }
    if (localCoord.y < 0) { localCoord.y += MERKABA_CHUNK_SIZE; pageDelta.y = -1; }
    else if (localCoord.y >= MERKABA_CHUNK_SIZE) { localCoord.y -= MERKABA_CHUNK_SIZE; pageDelta.y = 1; }
    if (localCoord.z < 0) { localCoord.z += MERKABA_CHUNK_SIZE; pageDelta.z = -1; }
    else if (localCoord.z >= MERKABA_CHUNK_SIZE) { localCoord.z -= MERKABA_CHUNK_SIZE; pageDelta.z = 1; }

    int targetSlot = NeighbourPageSlot(slot, pageDelta);
    if (targetSlot < 0) return;
    uint target = targetSlot * MERKABA_KERNELS_PER_CHUNK + FlattenKernel(localCoord);
    InterlockedOr(_MerkabaKernelDirty[target], 1u);
}

void MarkLocalTopologyDirty(int slot, int3 localCoord)
{
    [unroll]
    for (int z = -1; z <= 1; z++)
    [unroll]
    for (int y = -1; y <= 1; y++)
    [unroll]
    for (int x = -1; x <= 1; x++)
        MarkKernelDirty(slot, localCoord + int3(x, y, z));
}

float2 ProjectCameraUv(float3 worldPosition)
{
    float3 local = mul(_MerkabaCameraInverseRotation,
        float4(worldPosition - _MerkabaCameraPosition, 1.0)).xyz;
    if (local.z <= 0.001) return float2(-1, -1);
    float2 sensorPoint = float2(
        local.x / local.z * _MerkabaCameraFocalLength.x + _MerkabaCameraPrincipalPoint.x,
        local.y / local.z * _MerkabaCameraFocalLength.y + _MerkabaCameraPrincipalPoint.y);
    float2 scale = _MerkabaCameraCurrentResolution / _MerkabaCameraSensorResolution;
    scale /= max(scale.x, scale.y);
    float2 cropMin = _MerkabaCameraSensorResolution * (1.0 - scale) * 0.5;
    float2 cropSize = _MerkabaCameraSensorResolution * scale;
    return (sensorPoint - cropMin) / cropSize;
}

uint PackRgb(uint r, uint g, uint b)
{
    return r | (g << 8) | (b << 16) | (255u << 24);
}

void AccumulateColor(inout KernelState state, float3 observed, float quality)
{
    uint incomingWeight = (uint)clamp(round(quality * 256.0), 1.0, 256.0);
    uint oldWeight = min(state.colorConfidence, 65535u);
    uint3 sample = (uint3)round(saturate(observed) * 255.0);
    if (oldWeight == 0u)
    {
        state.packedColor = PackRgb(sample.r, sample.g, sample.b);
        state.colorConfidence = incomingWeight;
        return;
    }
    uint3 old = uint3(state.packedColor & 255u,
        (state.packedColor >> 8) & 255u, (state.packedColor >> 16) & 255u);
    uint divisor = oldWeight + incomingWeight;
    uint3 blended = (old * oldWeight + sample * incomingWeight + divisor / 2u) / divisor;
    state.packedColor = PackRgb(blended.r, blended.g, blended.b);
    state.colorConfidence = min(65535u, divisor);
}

bool ObserveDepthEye(uint eye, float3 worldPosition, out int kind,
    out float quality)
{
    kind = 0;
    quality = 0.0;
    float3 viewPosition = mul(gsDepthView[eye],
        float4(worldPosition, 1.0)).xyz;
    if (viewPosition.z > -0.05) return false;

    float3 ndc = gsDepthWorldToNDC(worldPosition, eye);
    if (ndc.x < 0.01 || ndc.x > 0.99 || ndc.y < 0.01 || ndc.y > 0.99)
        return false;

    float depthNdc = gsDepthSample(ndc.xy, eye);
    if (depthNdc <= 0.0 || depthNdc >= 1.0) return false;
    float3 depthNormal = gsDepthNormalSample(ndc.xy, eye).xyz;
    float3 depthPosition = gsDepthNDCtoWorld(float3(ndc.xy, depthNdc), eye);
    float3 eyePosition = gsDepthEyePos(eye);
    float3 eyeToKernel = worldPosition - eyePosition;
    float3 eyeToDepth = depthPosition - eyePosition;
    float kernelDistance = length(eyeToKernel);
    float measuredDistance = length(eyeToDepth);
    if (kernelDistance <= 0.0 || measuredDistance <= 0.0) return false;
    float relation = measuredDistance - kernelDistance;

    if (relation > MERKABA_HALF_SUPPORT) kind = 1; // FREE
    else if (abs(relation) <= MERKABA_HALF_SUPPORT) kind = 2; // SURFACE
    else return false; // UNKNOWN / BEHIND

    float normalFacing = -dot(eyeToKernel, depthNormal) / kernelDistance;
    float measuredLinear = gsDepthNDCToLinear(depthNdc, eye);
    float dilatedNdc = gsDilatedDepth.SampleLevel(gsPointClampSampler,
        float3(ndc.xy, eye), 0).z;
    if (dilatedNdc <= 0.0 || dilatedNdc >= 1.0) return false;
    float dilatedLinear = gsDepthNDCToLinear(dilatedNdc, eye);
    bool acceptableDisparity = measuredLinear <
        dilatedLinear + MERKABA_DEPTH_DISPARITY;
    bool unoccluded = abs(viewPosition.z) < dilatedLinear ||
        acceptableDisparity;
    bool validNormal = kind == 1 || normalFacing > MERKABA_NORMAL_MIN;
    if (!unoccluded || !validNormal) return false;

    float distanceFactor = saturate(1.0 -
        kernelDistance / _MerkabaMaxUpdateDistance);
    float angleFactor = saturate(normalFacing);
    if (kind == 1) angleFactor = max(angleFactor, 0.5);
    quality = distanceFactor * angleFactor;
    return kind != 2 || quality >= MERKABA_MIN_SURFACE_QUALITY;
}

bool IsExcluded(float3 worldPosition)
{
    [loop]
    for (int exclusion = 0; exclusion < _MerkabaExclusionCount; exclusion++)
    {
        float3 head = _MerkabaExclusionHeads[exclusion];
        float2 difference = worldPosition.xz - head.xz;
        if (dot(difference, difference) < EXCLUSION_RADIUS * EXCLUSION_RADIUS &&
            worldPosition.y < head.y + EXCLUSION_TOP &&
            worldPosition.y > head.y - EXCLUSION_BOTTOM)
            return true;
    }
    return false;
}

void FuseDepth(float3 worldPosition, out int kind, out float quality)
{
    kind = 0;
    quality = 0.0;
    [unroll]
    for (uint eye = 0u; eye < 2u; eye++)
    {
        int eyeKind;
        float eyeQuality;
        if (!ObserveDepthEye(eye, worldPosition, eyeKind, eyeQuality)) continue;
        // A valid surface wins over destructive FREE at stereo occlusion boundaries.
        if (eyeKind == 2)
        {
            if (kind != 2 || eyeQuality > quality)
            {
                kind = 2;
                quality = eyeQuality;
            }
        }
        else if (kind == 0 || (kind == 1 && eyeQuality > quality))
        {
            kind = 1;
            quality = eyeQuality;
        }
    }
}

void EnsureCarveListed(uint stateIndex, int slot, uint localIndex)
{
    uint wordIndex = stateIndex >> 5u;
    uint bit = 1u << (stateIndex & 31u);
    uint previous;
    InterlockedOr(_MerkabaCarveListedBits[wordIndex], bit, previous);
    if ((previous & bit) != 0u) return;
    uint listIndex;
    InterlockedAdd(_MerkabaCarveCounts[slot], 1u, listIndex);
    if (listIndex < MERKABA_KERNELS_PER_CHUNK)
        _MerkabaCarveLocalIndices[(uint)slot * MERKABA_KERNELS_PER_CHUNK +
            listIndex] = localIndex;
}

void UpdateOccupancy(inout KernelState state, int delta, out bool transitioned)
{
    bool occupiedBefore = (state.flags & MERKABA_OCCUPIED_FLAG) != 0u;
    state.evidence = clamp(state.evidence + delta,
        MERKABA_EVIDENCE_MIN, MERKABA_EVIDENCE_MAX);
    bool occupiedAfter = occupiedBefore
        ? state.evidence > MERKABA_OCCUPIED_OFF
        : state.evidence >= MERKABA_OCCUPIED_ON;
    if (occupiedAfter) state.flags |= MERKABA_OCCUPIED_FLAG;
    else state.flags &= ~MERKABA_OCCUPIED_FLAG;
    if (!occupiedAfter && occupiedBefore)
    {
        state.packedColor = 0u;
        state.colorConfidence = 0u;
    }
    transitioned = occupiedBefore != occupiedAfter;
}

[numthreads(8, 8, 1)]
void GenerateSurfaceCandidates(uint3 id : SV_DispatchThreadID)
{
    if (id.z >= 2u || id.x >= gsDepthTexSize.x || id.y >= gsDepthTexSize.y)
        return;
    float depthNdc = gsDepthTex[id];
    if (depthNdc <= 0.0 || depthNdc >= 1.0) return;
    float2 uv = ((float2)id.xy + 0.5) / (float2)gsDepthTexSize;
    float3 worldSurface = gsDepthNDCtoWorld(float3(uv, depthNdc), id.z);
    float3 eyeToSurface = worldSurface - gsDepthEyePos(id.z);
    float distance = length(eyeToSurface);
    if (distance <= 0.05 || distance > _MerkabaMaxUpdateDistance) return;
    float3 ray = eyeToSurface / distance;

    // Preserve the isotropic ray-derived support band. These are only work
    // candidates: IntegrateSurfaceCandidates re-runs the complete depth,
    // normal, dilation/disparity, and quality classification before evidence.
    [unroll]
    for (int layer = -1; layer <= 1; layer++)
    {
        float3 worldCandidate = worldSurface + ray *
            ((float)layer * MERKABA_HALF_SUPPORT);
        float3 gridCandidate = mul(_MerkabaWorldToGrid,
            float4(worldCandidate, 1.0)).xyz;
        AppendSurfaceCandidate((int3)round(
            gridCandidate / MERKABA_LATTICE_STEP));
    }

    // Integer boundary guards prevent half-step rounding from omitting one side
    // of a chunk boundary. The shared bitset deduplicates this union with the
    // ray-derived candidates above.
    float3 gridSurface = mul(_MerkabaWorldToGrid,
        float4(worldSurface, 1.0)).xyz / MERKABA_LATTICE_STEP;
    float3 gridRay = mul((float3x3)_MerkabaWorldToGrid, ray);
    float3 absoluteRay = abs(gridRay);
    int3 stepCoord = int3(0, 0, 0);
    if (absoluteRay.x >= absoluteRay.y && absoluteRay.x >= absoluteRay.z)
        stepCoord.x = gridRay.x >= 0.0 ? 1 : -1;
    else if (absoluteRay.y >= absoluteRay.z)
        stepCoord.y = gridRay.y >= 0.0 ? 1 : -1;
    else
        stepCoord.z = gridRay.z >= 0.0 ? 1 : -1;

    int3 nearest = (int3)round(gridSurface);
    AppendSurfaceCandidate(nearest - stepCoord);
    AppendSurfaceCandidate(nearest);
    AppendSurfaceCandidate(nearest + stepCoord);
}

[numthreads(1, 1, 1)]
void PrepareIndirectArgs(uint id : SV_DispatchThreadID)
{
    uint count = min(_MerkabaWorkCount[0], (uint)_MerkabaWorkCapacity);
    _MerkabaIndirectArgs[0] = (count + 63u) / 64u;
    _MerkabaIndirectArgs[1] = 1u;
    _MerkabaIndirectArgs[2] = 1u;
}

[numthreads(64, 1, 1)]
void IntegrateSurfaceCandidates(uint id : SV_DispatchThreadID)
{
    uint count = min(_MerkabaSurfaceCount[0], (uint)_MerkabaWorkCapacity);
    if (id >= count) return;
    uint stateIndex = _MerkabaSurfaceQueue[id];
    uint wordIndex = stateIndex >> 5u;
    uint bit = 1u << (stateIndex & 31u);
    InterlockedAnd(_MerkabaSurfaceCandidateBits[wordIndex], ~bit);

    int slot = (int)(stateIndex / MERKABA_KERNELS_PER_CHUNK);
    uint localIndex = stateIndex % MERKABA_KERNELS_PER_CHUNK;
    int3 localCoord = UnflattenKernel(localIndex);
    int3 globalCoord = _MerkabaPageCoords[slot].xyz * MERKABA_CHUNK_SIZE +
        localCoord;
    float3 worldPosition = mul(_MerkabaGridToWorld,
        float4((float3)globalCoord * MERKABA_LATTICE_STEP, 1.0)).xyz;
    if (IsExcluded(worldPosition)) return;

    float quality = 0.0;
    [unroll]
    for (uint eye = 0u; eye < 2u; eye++)
    {
        int eyeKind;
        float eyeQuality;
        if (ObserveDepthEye(eye, worldPosition, eyeKind, eyeQuality) &&
            eyeKind == 2 && eyeQuality > quality)
            quality = eyeQuality;
    }
    if (quality < MERKABA_MIN_SURFACE_QUALITY) return;

    KernelState state = _MerkabaKernels[stateIndex];
    bool transitioned;
    UpdateOccupancy(state, max(1, (int)round(quality * quality *
        MERKABA_SURFACE_SCALE)), transitioned);
    if (_MerkabaCameraAvailable != 0)
    {
        float2 cameraUv = ProjectCameraUv(worldPosition);
        if (cameraUv.x > 0.02 && cameraUv.x < 0.98 &&
            cameraUv.y > 0.02 && cameraUv.y < 0.98)
        {
            float3 rgb = _MerkabaCameraRgb.SampleLevel(gsBilinearClampSampler,
                cameraUv, 0).rgb * _MerkabaCameraExposure;
            AccumulateColor(state, rgb, quality);
        }
    }
    _MerkabaKernels[stateIndex] = state;
    EnsureCarveListed(stateIndex, slot, localIndex);
    if (transitioned) MarkLocalTopologyDirty(slot, localCoord);
}

[numthreads(64, 1, 1)]
void GatherCarveCandidates(uint threadIndex : SV_GroupIndex,
    uint3 groupId : SV_GroupID)
{
    if (groupId.x >= (uint)_MerkabaIntegrationChunkCount) return;
    int slot = _MerkabaIntegrationSlots[groupId.x];
    uint count = min(_MerkabaCarveCounts[slot],
        (uint)MERKABA_KERNELS_PER_CHUNK);
    for (uint listIndex = threadIndex; listIndex < count; listIndex += 64u)
    {
        uint localIndex = _MerkabaCarveLocalIndices[(uint)slot *
            MERKABA_KERNELS_PER_CHUNK + listIndex];
        uint stateIndex = (uint)slot * MERKABA_KERNELS_PER_CHUNK + localIndex;
        KernelState state = _MerkabaKernels[stateIndex];
        if (state.evidence <= MERKABA_EXPORT_KNOWN_FREE &&
            (state.flags & MERKABA_OCCUPIED_FLAG) == 0u)
            continue;
        uint queueIndex;
        InterlockedAdd(_MerkabaCarveCount[0], 1u, queueIndex);
        if (queueIndex < (uint)_MerkabaWorkCapacity)
            _MerkabaCarveQueue[queueIndex] = stateIndex;
    }
}

[numthreads(64, 1, 1)]
void IntegrateCarveCandidates(uint id : SV_DispatchThreadID)
{
    uint count = min(_MerkabaCarveCount[0], (uint)_MerkabaWorkCapacity);
    if (id >= count) return;
    uint stateIndex = _MerkabaCarveQueue[id];
    KernelState state = _MerkabaKernels[stateIndex];
    if (state.evidence <= MERKABA_EXPORT_KNOWN_FREE &&
        (state.flags & MERKABA_OCCUPIED_FLAG) == 0u)
        return;

    int slot = (int)(stateIndex / MERKABA_KERNELS_PER_CHUNK);
    uint localIndex = stateIndex % MERKABA_KERNELS_PER_CHUNK;
    int3 localCoord = UnflattenKernel(localIndex);
    int3 globalCoord = _MerkabaPageCoords[slot].xyz * MERKABA_CHUNK_SIZE +
        localCoord;
    float3 worldPosition = mul(_MerkabaGridToWorld,
        float4((float3)globalCoord * MERKABA_LATTICE_STEP, 1.0)).xyz;
    if (IsExcluded(worldPosition)) return;

    int kind;
    float quality;
    FuseDepth(worldPosition, kind, quality);
    if (kind != 1) return;
    bool transitioned;
    UpdateOccupancy(state, -max(1, (int)round(quality * quality *
        MERKABA_FREE_SCALE)), transitioned);
    _MerkabaKernels[stateIndex] = state;
    if (transitioned) MarkLocalTopologyDirty(slot, localCoord);
}
