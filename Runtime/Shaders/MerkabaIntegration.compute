// GPU-authoritative M8 SURFACE DISCOVER/INTEGRATE and Q_SCAN carve.
#pragma kernel DiscoverSurfaceCandidates
#pragma kernel PrepareResolveArgs
#pragma kernel ResolveSurfaceBlocks
#pragma kernel ResolveSurfaceChunks
#pragma kernel ResolveSurfaceTiles
#pragma kernel QueueResolvedSurfaceCandidates
#pragma kernel RetryPendingNewTiles
#pragma kernel PrepareIntegrateArgs
#pragma kernel IntegrateSurfaceCandidates
#pragma kernel QueryCarveTiles
#pragma kernel PrepareCarveArgs
#pragma kernel IntegrateCarveTiles
#pragma kernel FinalizeObservation

#include "DepthKit.hlsl"
#include "MerkabaCanonicalGeometry.generated.hlsl"
#include "MerkabaWorld.hlsl"

#define MERKABA_LATTICE_STEP 0.025
#define MERKABA_HALF_SUPPORT 0.025
#define MERKABA_EVIDENCE_MIN -32768
#define MERKABA_EVIDENCE_MAX 32767
#define MERKABA_OCCUPIED_ON 512
#define MERKABA_OCCUPIED_OFF 128
#define MERKABA_SURFACE_SCALE 640.0
#define MERKABA_FREE_SCALE 256.0
#define MERKABA_MIN_SURFACE_QUALITY 0.25
#define MERKABA_OCCUPIED_FLAG 1u
#define MERKABA_NORMAL_MIN 0.3
#define MERKABA_DEPTH_DISPARITY 0.5
#define MERKABA_SURFACE_CANDIDATE_CAPACITY 2097152u
#define MERKABA_SURFACE_QUEUE_CAPACITY 1048576u

RWStructuredBuffer<int4> _M8SurfaceCandidates;
RWStructuredBuffer<uint> _M8SurfaceQueue;
RWStructuredBuffer<uint> _M8TouchedTileQueue;
RWStructuredBuffer<uint> _M8CarveTiles;
RWStructuredBuffer<uint> _M8ObservationDispatchArgs;
RWStructuredBuffer<uint> _M8CarveDispatchArgs;

float4x4 _MerkabaGridToWorld;
float4x4 _MerkabaWorldToGrid;
float _MerkabaMaxUpdateDistance;

Texture2DArray<float4> gsDilatedDepth;

int _MerkabaExclusionCount;
float3 _MerkabaExclusionHeads[64];

#define EXCLUSION_TOP 0.25
#define EXCLUSION_BOTTOM 1.7
#define EXCLUSION_RADIUS 0.6

Texture2D<float4> _MerkabaCameraRgb;
int _MerkabaCameraAvailable;
float3 _MerkabaCameraPosition;
float4x4 _MerkabaCameraInverseRotation;
float2 _MerkabaCameraFocalLength;
float2 _MerkabaCameraPrincipalPoint;
float2 _MerkabaCameraSensorResolution;
float2 _MerkabaCameraCurrentResolution;
float _MerkabaCameraExposure;

float4 _M8ScanPlanes[12];
float3 _M8ScanCameraWorld;
int3 _M8ScanCenterBlock;
int _M8ScanBlockRadius;
int _M8ScanBlockSide;

float2 ProjectCameraUv(float3 worldPosition)
{
    float3 local = mul(_MerkabaCameraInverseRotation,
        float4(worldPosition - _MerkabaCameraPosition, 1.0)).xyz;
    if (local.z <= 0.001) return float2(-1, -1);
    float2 sensorPoint = float2(
        local.x / local.z * _MerkabaCameraFocalLength.x + _MerkabaCameraPrincipalPoint.x,
        local.y / local.z * _MerkabaCameraFocalLength.y + _MerkabaCameraPrincipalPoint.y);
    float2 scale = _MerkabaCameraCurrentResolution / _MerkabaCameraSensorResolution;
    scale /= max(scale.x, scale.y);
    float2 cropMin = _MerkabaCameraSensorResolution * (1.0 - scale) * 0.5;
    float2 cropSize = _MerkabaCameraSensorResolution * scale;
    return (sensorPoint - cropMin) / cropSize;
}

uint PackRgb(uint r, uint g, uint b)
{
    return r | (g << 8u) | (b << 16u) | (255u << 24u);
}

void AccumulateColor(inout KernelState state, float3 observed, float quality)
{
    uint incomingWeight = (uint)clamp(round(quality * 256.0), 1.0, 256.0);
    uint oldWeight = min(state.colorConfidence, 65535u);
    uint3 sample = (uint3)round(saturate(observed) * 255.0);
    if (oldWeight == 0u)
    {
        state.packedColor = PackRgb(sample.r, sample.g, sample.b);
        state.colorConfidence = incomingWeight;
        return;
    }
    uint3 old = uint3(state.packedColor & 255u,
        (state.packedColor >> 8u) & 255u,
        (state.packedColor >> 16u) & 255u);
    uint divisor = oldWeight + incomingWeight;
    uint3 blended = (old * oldWeight + sample * incomingWeight + divisor / 2u) /
        divisor;
    state.packedColor = PackRgb(blended.r, blended.g, blended.b);
    state.colorConfidence = min(65535u, divisor);
}

bool ObserveDepthEye(uint eye, float3 worldPosition, out int kind,
    out float quality)
{
    kind = 0;
    quality = 0.0;
    float3 viewPosition = mul(gsDepthView[eye], float4(worldPosition, 1.0)).xyz;
    if (viewPosition.z > -0.05) return false;
    float3 ndc = gsDepthWorldToNDC(worldPosition, eye);
    if (ndc.x < 0.01 || ndc.x > 0.99 || ndc.y < 0.01 || ndc.y > 0.99)
        return false;
    float depthNdc = gsDepthSample(ndc.xy, eye);
    if (depthNdc <= 0.0 || depthNdc >= 1.0) return false;
    float3 depthNormal = gsDepthNormalSample(ndc.xy, eye).xyz;
    float3 depthPosition = gsDepthNDCtoWorld(float3(ndc.xy, depthNdc), eye);
    float3 eyePosition = gsDepthEyePos(eye);
    float3 eyeToKernel = worldPosition - eyePosition;
    float3 eyeToDepth = depthPosition - eyePosition;
    float kernelDistance = length(eyeToKernel);
    float measuredDistance = length(eyeToDepth);
    if (kernelDistance <= 0.0 || measuredDistance <= 0.0) return false;
    float relation = measuredDistance - kernelDistance;
    if (relation > MERKABA_HALF_SUPPORT) kind = 1;
    else if (abs(relation) <= MERKABA_HALF_SUPPORT) kind = 2;
    else return false;

    float normalFacing = -dot(eyeToKernel, depthNormal) / kernelDistance;
    float measuredLinear = gsDepthNDCToLinear(depthNdc, eye);
    float dilatedNdc = gsDilatedDepth.SampleLevel(gsPointClampSampler,
        float3(ndc.xy, eye), 0).z;
    if (dilatedNdc <= 0.0 || dilatedNdc >= 1.0) return false;
    float dilatedLinear = gsDepthNDCToLinear(dilatedNdc, eye);
    bool acceptableDisparity = measuredLinear < dilatedLinear +
        MERKABA_DEPTH_DISPARITY;
    bool unoccluded = abs(viewPosition.z) < dilatedLinear || acceptableDisparity;
    bool validNormal = kind == 1 || normalFacing > MERKABA_NORMAL_MIN;
    if (!unoccluded || !validNormal) return false;
    float distanceFactor = saturate(1.0 - kernelDistance /
        _MerkabaMaxUpdateDistance);
    float angleFactor = saturate(normalFacing);
    if (kind == 1) angleFactor = max(angleFactor, 0.5);
    quality = distanceFactor * angleFactor;
    return kind != 2 || quality >= MERKABA_MIN_SURFACE_QUALITY;
}

void FuseDepth(float3 worldPosition, out int kind, out float quality)
{
    kind = 0;
    quality = 0.0;
    [unroll]
    for (uint eye = 0u; eye < 2u; eye++)
    {
        int eyeKind;
        float eyeQuality;
        if (!ObserveDepthEye(eye, worldPosition, eyeKind, eyeQuality)) continue;
        if (eyeKind == 2)
        {
            if (kind != 2 || eyeQuality > quality)
            {
                kind = 2;
                quality = eyeQuality;
            }
        }
        else if (kind == 0 || (kind == 1 && eyeQuality > quality))
        {
            kind = 1;
            quality = eyeQuality;
        }
    }
}

bool IsExcluded(float3 worldPosition)
{
    [loop]
    for (int exclusion = 0; exclusion < _MerkabaExclusionCount; exclusion++)
    {
        float3 head = _MerkabaExclusionHeads[exclusion];
        float2 difference = worldPosition.xz - head.xz;
        if (dot(difference, difference) < EXCLUSION_RADIUS * EXCLUSION_RADIUS &&
            worldPosition.y < head.y + EXCLUSION_TOP &&
            worldPosition.y > head.y - EXCLUSION_BOTTOM)
            return true;
    }
    return false;
}

void UpdateOccupancy(uint physicalSlot, uint kernelLocal,
    inout KernelState state, int delta)
{
    bool occupiedBefore = (state.flags & MERKABA_OCCUPIED_FLAG) != 0u;
    state.evidence = clamp(state.evidence + delta,
        MERKABA_EVIDENCE_MIN, MERKABA_EVIDENCE_MAX);
    bool occupiedAfter = occupiedBefore
        ? state.evidence > MERKABA_OCCUPIED_OFF
        : state.evidence >= MERKABA_OCCUPIED_ON;
    if (occupiedAfter) state.flags |= MERKABA_OCCUPIED_FLAG;
    else state.flags &= ~MERKABA_OCCUPIED_FLAG;
    if (occupiedBefore == occupiedAfter) return;

    uint wordIndex = physicalSlot * MERKABA_M8_TILE_WORDS +
        (kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    uint ignored;
    if (occupiedAfter)
    {
        InterlockedOr(_M8OccupiedBits[wordIndex], bit, ignored);
        InterlockedAdd(_M8TileMeta[physicalSlot].z, 1u, ignored);
        InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_KERNEL_COUNT], 1u,
            ignored);
    }
    else
    {
        InterlockedAnd(_M8OccupiedBits[wordIndex], ~bit, ignored);
        InterlockedAdd(_M8TileMeta[physicalSlot].z, 0xffffffffu, ignored);
        InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_KERNEL_COUNT],
            0xffffffffu, ignored);
    }
}

void EnsureCarveActive(uint physicalSlot, uint kernelLocal)
{
    uint wordIndex = physicalSlot * MERKABA_M8_TILE_WORDS +
        (kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    uint previous;
    InterlockedOr(_M8CarveActiveBits[wordIndex], bit, previous);
    if ((previous & bit) == 0u)
    {
        uint ignored;
        InterlockedAdd(_M8TileMeta[physicalSlot].w, 1u, ignored);
    }
}

void AppendValidatedSurfaceCandidate(int3 globalCoord)
{
    float3 worldPosition = mul(_MerkabaGridToWorld,
        float4((float3)globalCoord * MERKABA_LATTICE_STEP, 1.0)).xyz;
    if (IsExcluded(worldPosition)) return;
    float quality = 0.0;
    [unroll]
    for (uint eye = 0u; eye < 2u; eye++)
    {
        int kind;
        float candidateQuality;
        if (ObserveDepthEye(eye, worldPosition, kind, candidateQuality) &&
            kind == 2 && candidateQuality > quality)
            quality = candidateQuality;
    }
    if (quality < MERKABA_MIN_SURFACE_QUALITY) return;

    uint index;
    InterlockedAdd(_M8Counters[M8_COUNTER_SURFACE_CANDIDATE_COUNT], 1u,
        index);
    if (index < MERKABA_SURFACE_CANDIDATE_CAPACITY)
    {
        _M8SurfaceCandidates[index] = int4(globalCoord, 0);
        M8CounterIncrement(M8_COUNTER_VALID_SURFACE_CANDIDATES);
    }
    else
        _M8Counters[M8_COUNTER_SURFACE_CANDIDATE_OVERFLOW] = 1u;
}

[numthreads(8, 8, 1)]
void DiscoverSurfaceCandidates(uint3 id : SV_DispatchThreadID)
{
    if (id.z >= 2u || id.x >= gsDepthTexSize.x || id.y >= gsDepthTexSize.y)
        return;
    float depthNdc = gsDepthTex[id];
    if (depthNdc <= 0.0 || depthNdc >= 1.0) return;
    float2 uv = ((float2)id.xy + 0.5) / (float2)gsDepthTexSize;
    float3 worldSurface = gsDepthNDCtoWorld(float3(uv, depthNdc), id.z);
    float3 eyeToSurface = worldSurface - gsDepthEyePos(id.z);
    float distance = length(eyeToSurface);
    if (distance <= 0.05 || distance > _MerkabaMaxUpdateDistance) return;
    float3 ray = eyeToSurface / distance;

    [unroll]
    for (int layer = -1; layer <= 1; layer++)
    {
        float3 worldCandidate = worldSurface + ray *
            ((float)layer * MERKABA_HALF_SUPPORT);
        float3 gridCandidate = mul(_MerkabaWorldToGrid,
            float4(worldCandidate, 1.0)).xyz;
        AppendValidatedSurfaceCandidate((int3)round(gridCandidate /
            MERKABA_LATTICE_STEP));
    }

    float3 gridSurface = mul(_MerkabaWorldToGrid,
        float4(worldSurface, 1.0)).xyz / MERKABA_LATTICE_STEP;
    float3 gridRay = mul((float3x3)_MerkabaWorldToGrid, ray);
    float3 absoluteRay = abs(gridRay);
    int3 stepCoord = 0;
    if (absoluteRay.x >= absoluteRay.y && absoluteRay.x >= absoluteRay.z)
        stepCoord.x = gridRay.x >= 0.0 ? 1 : -1;
    else if (absoluteRay.y >= absoluteRay.z)
        stepCoord.y = gridRay.y >= 0.0 ? 1 : -1;
    else
        stepCoord.z = gridRay.z >= 0.0 ? 1 : -1;
    int3 nearest = (int3)round(gridSurface);
    AppendValidatedSurfaceCandidate(nearest - stepCoord);
    AppendValidatedSurfaceCandidate(nearest);
    AppendValidatedSurfaceCandidate(nearest + stepCoord);
}

[numthreads(1, 1, 1)]
void PrepareResolveArgs(uint id : SV_DispatchThreadID)
{
    uint count = min(_M8Counters[M8_COUNTER_SURFACE_CANDIDATE_COUNT],
        MERKABA_SURFACE_CANDIDATE_CAPACITY);
    _M8ObservationDispatchArgs[0] = (count + 63u) / 64u;
    _M8ObservationDispatchArgs[1] = 1u;
    _M8ObservationDispatchArgs[2] = 1u;
}

void RequestColdTile(uint tileRefIndex, uint chunkIndex, uint tileLocal,
    bool scanRequest)
{
    M8QueueColdTileLoad(tileRefIndex, chunkIndex, tileLocal);
    if (scanRequest) M8CounterIncrement(M8_COUNTER_SCAN_COLD_MISSES);
}

bool CandidateAt(uint id, out MerkabaM8Address address)
{
    uint count = min(_M8Counters[M8_COUNTER_SURFACE_CANDIDATE_COUNT],
        MERKABA_SURFACE_CANDIDATE_CAPACITY);
    if (id >= count)
    {
        address = (MerkabaM8Address)0;
        return false;
    }
    address = MerkabaAddressOf(_M8SurfaceCandidates[id].xyz);
    return true;
}

[numthreads(64, 1, 1)]
void ResolveSurfaceBlocks(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_INTEGRATED] != 0u) return;
    MerkabaM8Address address;
    if (!CandidateAt(id, address)) return;
    uint blockIndex;
    M8FindOrClaimBlock(address.blockCoord, blockIndex);
}

[numthreads(64, 1, 1)]
void ResolveSurfaceChunks(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_INTEGRATED] != 0u) return;
    MerkabaM8Address address;
    if (!CandidateAt(id, address)) return;
    uint blockIndex;
    if (!M8FindBlock(address.blockCoord, blockIndex)) return;
    uint chunkIndex;
    M8FindOrClaimChunk(blockIndex, address.chunkLocal, chunkIndex);
}

[numthreads(64, 1, 1)]
void ResolveSurfaceTiles(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_INTEGRATED] != 0u) return;
    MerkabaM8Address address;
    if (!CandidateAt(id, address)) return;
    uint blockIndex;
    if (!M8FindBlock(address.blockCoord, blockIndex)) return;
    uint chunkRef = _M8BlockChunkRefs[blockIndex *
        MERKABA_M8_BLOCK_CHUNK_COUNT + address.chunkLocal];
    if (chunkRef == MERKABA_REF_EMPTY ||
        chunkRef >= MERKABA_REF_EVICTING) return;
    uint chunkIndex = chunkRef - 1u;
    uint tileRefIndex = chunkIndex * MERKABA_M8_TILES_PER_CHUNK +
        address.tileLocal;
    uint tileRef = _M8ChunkTileRefs[tileRefIndex];
    if (tileRef == MERKABA_REF_EMPTY)
    {
        uint prior;
        InterlockedCompareExchange(_M8ChunkTileRefs[tileRefIndex],
            MERKABA_REF_EMPTY, MERKABA_REF_CLAIMED_NEW, prior);
        if (prior == MERKABA_REF_EMPTY)
        {
            uint physicalSlot;
            if (M8TryPopPhysicalTile(physicalSlot))
            {
                uint queueIndex;
                InterlockedAdd(_M8Counters[M8_COUNTER_NEW_TILE_QUEUE_COUNT],
                    1u, queueIndex);
                if (queueIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                    _M8NewTileQueue[queueIndex] = uint2(tileRefIndex,
                        physicalSlot);
            }
            else
            {
                uint pendingIndex;
                InterlockedAdd(_M8Counters[M8_COUNTER_PENDING_NEW_TILE_COUNT],
                    1u, pendingIndex);
                if (pendingIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                    _M8PendingNewTileRefs[pendingIndex] = tileRefIndex;
                _M8Counters[M8_COUNTER_TILE_STARVATION] = 1u;
            }
        }
        return;
    }
    if (tileRef == MERKABA_REF_COLD_ON_SSD)
    {
        RequestColdTile(tileRefIndex, chunkIndex, address.tileLocal, true);
        return;
    }
}

[numthreads(64, 1, 1)]
void QueueResolvedSurfaceCandidates(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_INTEGRATED] != 0u) return;
    MerkabaM8Address address;
    if (!CandidateAt(id, address)) return;
    uint blockIndex;
    if (!M8FindBlock(address.blockCoord, blockIndex))
    {
        M8CounterIncrement(M8_COUNTER_UNRESOLVED_SURFACE_TILES);
        return;
    }
    uint chunkRef = _M8BlockChunkRefs[blockIndex *
        MERKABA_M8_BLOCK_CHUNK_COUNT + address.chunkLocal];
    if (chunkRef == MERKABA_REF_EMPTY ||
        chunkRef >= MERKABA_REF_EVICTING)
    {
        M8CounterIncrement(M8_COUNTER_UNRESOLVED_SURFACE_TILES);
        return;
    }
    uint chunkIndex = chunkRef - 1u;
    uint tileRefIndex = chunkIndex * MERKABA_M8_TILES_PER_CHUNK +
        address.tileLocal;
    uint tileRef = _M8ChunkTileRefs[tileRefIndex];
    if (!M8IsHotRef(tileRef))
    {
        M8CounterIncrement(M8_COUNTER_UNRESOLVED_SURFACE_TILES);
        return;
    }
    uint physicalSlot = M8PhysicalSlot(tileRef);
    _M8TileRuntime[physicalSlot].z =
        _M8Counters[M8_COUNTER_FRAME_EPOCH];
    uint wordIndex = physicalSlot * MERKABA_M8_TILE_WORDS +
        (address.kernelLocal >> 5u);
    uint bit = 1u << (address.kernelLocal & 31u);
    uint previous;
    InterlockedOr(_M8SurfaceCandidateBits[wordIndex], bit, previous);
    if ((previous & bit) != 0u) return;

    uint touchedBefore;
    InterlockedCompareExchange(_M8TileRuntime[physicalSlot].x, 0u, 1u,
        touchedBefore);
    if (touchedBefore == 0u)
    {
        uint touchedIndex;
        InterlockedAdd(_M8Counters[M8_COUNTER_TOUCHED_TILE_COUNT], 1u,
            touchedIndex);
        if (touchedIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
            _M8TouchedTileQueue[touchedIndex] = physicalSlot;
    }

    uint queueIndex;
    InterlockedAdd(_M8Counters[M8_COUNTER_SURFACE_QUEUE_COUNT], 1u,
        queueIndex);
    if (queueIndex < MERKABA_SURFACE_QUEUE_CAPACITY)
    {
        _M8SurfaceQueue[queueIndex] = physicalSlot *
            MERKABA_M8_KERNELS_PER_TILE + address.kernelLocal;
        M8CounterIncrement(M8_COUNTER_UNIQUE_SURFACE_KERNELS);
    }
    else
        _M8Counters[M8_COUNTER_SURFACE_CANDIDATE_OVERFLOW] = 1u;
}

[numthreads(64, 1, 1)]
void RetryPendingNewTiles(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_INTEGRATED] != 0u) return;
    uint count = min(_M8Counters[M8_COUNTER_PENDING_NEW_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    if (id >= count) return;
    uint tileRefIndex = _M8PendingNewTileRefs[id];
    if (_M8ChunkTileRefs[tileRefIndex] != MERKABA_REF_CLAIMED_NEW) return;
    uint physicalSlot;
    if (!M8TryPopPhysicalTile(physicalSlot)) return;
    uint queueIndex;
    InterlockedAdd(_M8Counters[M8_COUNTER_NEW_TILE_QUEUE_COUNT], 1u,
        queueIndex);
    if (queueIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
        _M8NewTileQueue[queueIndex] = uint2(tileRefIndex, physicalSlot);
}

[numthreads(1, 1, 1)]
void PrepareIntegrateArgs(uint id : SV_DispatchThreadID)
{
    uint count = min(_M8Counters[M8_COUNTER_SURFACE_QUEUE_COUNT],
        MERKABA_SURFACE_QUEUE_CAPACITY);
    _M8ObservationDispatchArgs[0] =
        _M8Counters[M8_COUNTER_UNRESOLVED_SURFACE_TILES] == 0u &&
        _M8Counters[M8_COUNTER_OBSERVATION_INTEGRATED] == 0u
        ? (count + 63u) / 64u : 0u;
    _M8ObservationDispatchArgs[1] = 1u;
    _M8ObservationDispatchArgs[2] = 1u;
}

[numthreads(64, 1, 1)]
void IntegrateSurfaceCandidates(uint id : SV_DispatchThreadID)
{
    uint count = min(_M8Counters[M8_COUNTER_SURFACE_QUEUE_COUNT],
        MERKABA_SURFACE_QUEUE_CAPACITY);
    if (id >= count) return;
    uint key = _M8SurfaceQueue[id];
    uint physicalSlot = key / MERKABA_M8_KERNELS_PER_TILE;
    uint kernelLocal = key % MERKABA_M8_KERNELS_PER_TILE;
    int3 globalCoord = M8GlobalKernelCoord(physicalSlot, kernelLocal);
    float3 worldPosition = mul(_MerkabaGridToWorld,
        float4((float3)globalCoord * MERKABA_LATTICE_STEP, 1.0)).xyz;

    float quality = 0.0;
    [unroll]
    for (uint eye = 0u; eye < 2u; eye++)
    {
        int kind;
        float eyeQuality;
        if (ObserveDepthEye(eye, worldPosition, kind, eyeQuality) &&
            kind == 2 && eyeQuality > quality)
            quality = eyeQuality;
    }
    if (quality < MERKABA_MIN_SURFACE_QUALITY) return;

    KernelState state = M8LoadKernelState(physicalSlot, kernelLocal);
    UpdateOccupancy(physicalSlot, kernelLocal, state,
        max(1, (int)round(quality * quality * MERKABA_SURFACE_SCALE)));
    if (_MerkabaCameraAvailable != 0)
    {
        float2 cameraUv = ProjectCameraUv(worldPosition);
        if (cameraUv.x > 0.02 && cameraUv.x < 0.98 &&
            cameraUv.y > 0.02 && cameraUv.y < 0.98)
        {
            float3 rgb = _MerkabaCameraRgb.SampleLevel(gsBilinearClampSampler,
                cameraUv, 0).rgb * _MerkabaCameraExposure;
            AccumulateColor(state, rgb, quality);
        }
    }
    M8StoreKernelState(physicalSlot, kernelLocal, state);
    EnsureCarveActive(physicalSlot, kernelLocal);
    _M8TileRuntime[physicalSlot].y = 1u;
}

uint M8ScanEyeChildMask(int3 parentMin, int parentSpan, uint eye)
{
    uint support = 255u;
    [unroll]
    for (uint plane = 0u; plane < 6u; plane++)
        support &= MerkabaM8PlaneChildMask(parentMin, parentSpan,
            _M8ScanPlanes[eye * 6u + plane], _MerkabaGridToWorld,
            MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
    return support;
}

uint M8ScanChildMask(int3 parentMin, int parentSpan)
{
    uint stereo = M8ScanEyeChildMask(parentMin, parentSpan, 0u) |
        M8ScanEyeChildMask(parentMin, parentSpan, 1u);
    uint distance = MerkabaM8DistanceChildMask(parentMin, parentSpan,
        _MerkabaMaxUpdateDistance, _M8ScanCameraWorld, _MerkabaGridToWorld,
        _MerkabaWorldToGrid, MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
    return stereo & distance;
}

[numthreads(1, 1, 1)]
void QueryCarveTiles(uint3 groupId : SV_GroupID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_INTEGRATED] != 0u) return;
    if (_M8Counters[M8_COUNTER_UNRESOLVED_SURFACE_TILES] != 0u) return;
    uint linear = groupId.x;
    uint side = (uint)_M8ScanBlockSide;
    if (linear >= side * side * side) return;
    int3 offset;
    offset.x = (int)(linear % side) - _M8ScanBlockRadius;
    offset.y = (int)((linear / side) % side) - _M8ScanBlockRadius;
    offset.z = (int)(linear / (side * side)) - _M8ScanBlockRadius;
    int3 blockCoord = _M8ScanCenterBlock + offset;
    int3 blockMin = blockCoord * MERKABA_M8_BLOCK_KERNEL_SPAN;
    uint scan4 = M8ScanChildMask(blockMin, 256);
    if (scan4 == 0u) return;
    uint blockIndex;
    if (!M8FindBlock(blockCoord, blockIndex)) return;
    M8CounterIncrement(M8_COUNTER_CARVE_QUERY_BLOCKS);

    uint l0 = (_M8BlockPresenceL0[blockIndex] & 255u) & scan4;
    while (l0 != 0u)
    {
        uint d4 = (uint)firstbitlow(l0); l0 &= l0 - 1u;
        int3 min4 = blockMin + MerkabaM8OctantOffset(d4, 128);
        uint scan3 = M8ScanChildMask(min4, 128);
        uint l1 = (_M8BlockPresenceL1[blockIndex * 8u + d4] & 255u) &
            scan3;
        while (l1 != 0u)
        {
            uint d3 = (uint)firstbitlow(l1); l1 &= l1 - 1u;
            int3 min3 = min4 + MerkabaM8OctantOffset(d3, 64);
            uint scan2 = M8ScanChildMask(min3, 64);
            uint l2 = (_M8BlockPresenceL2[blockIndex * 64u +
                d4 * 8u + d3] & 255u) & scan2;
            while (l2 != 0u)
            {
                uint d2 = (uint)firstbitlow(l2); l2 &= l2 - 1u;
                uint chunkLocal = (d4 << 6u) | (d3 << 3u) | d2;
                uint chunkRef = _M8BlockChunkRefs[blockIndex * 512u + chunkLocal];
                if (chunkRef == 0u || chunkRef >= MERKABA_REF_EVICTING) continue;
                uint chunkIndex = chunkRef - 1u;
                int3 min2 = min3 + MerkabaM8OctantOffset(d2, 32);
                uint scan1 = M8ScanChildMask(min2, 32);
                uint c0 = (_M8ChunkPresenceL0[chunkIndex] & 255u) & scan1;
                while (c0 != 0u)
                {
                    uint d1 = (uint)firstbitlow(c0); c0 &= c0 - 1u;
                    int3 min1 = min2 + MerkabaM8OctantOffset(d1, 16);
                    uint scan0 = M8ScanChildMask(min1, 16);
                    uint c1 = (_M8ChunkPresenceL1[chunkIndex * 8u + d1] &
                        255u) & scan0;
                    while (c1 != 0u)
                    {
                        uint d0 = (uint)firstbitlow(c1); c1 &= c1 - 1u;
                        uint tileLocal = (d1 << 3u) | d0;
                        uint tileRefIndex = chunkIndex * 64u + tileLocal;
                        uint tileRef = _M8ChunkTileRefs[tileRefIndex];
                        if (tileRef == MERKABA_REF_COLD_ON_SSD)
                        {
                            RequestColdTile(tileRefIndex, chunkIndex, tileLocal, true);
                            continue;
                        }
                        if (!M8IsHotRef(tileRef)) continue;
                        uint physicalSlot = M8PhysicalSlot(tileRef);
                        _M8TileRuntime[physicalSlot].z =
                            _M8Counters[M8_COUNTER_FRAME_EPOCH];
                        if (_M8TileMeta[physicalSlot].w == 0u) continue;
                        uint queueIndex;
                        InterlockedAdd(_M8Counters[M8_COUNTER_CARVE_TILE_COUNT],
                            1u, queueIndex);
                        if (queueIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                            _M8CarveTiles[queueIndex] = physicalSlot;
                        M8CounterIncrement(M8_COUNTER_CARVE_QUERY_TILES);
                    }
                }
            }
        }
    }
}

[numthreads(1, 1, 1)]
void PrepareCarveArgs(uint id : SV_DispatchThreadID)
{
    uint count = min(_M8Counters[M8_COUNTER_CARVE_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    _M8CarveDispatchArgs[0] =
        _M8Counters[M8_COUNTER_OBSERVATION_INTEGRATED] == 0u
        ? count : 0u;
    _M8CarveDispatchArgs[1] = 8u;
    _M8CarveDispatchArgs[2] = 1u;
}

[numthreads(64, 1, 1)]
void IntegrateCarveTiles(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint tileCount = min(_M8Counters[M8_COUNTER_CARVE_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    if (groupId.x >= tileCount) return;
    uint physicalSlot = _M8CarveTiles[groupId.x];
    uint kernelLocal = groupId.y * 64u + thread;
    uint wordIndex = physicalSlot * MERKABA_M8_TILE_WORDS +
        (kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    if ((_M8CarveActiveBits[wordIndex] & bit) == 0u) return;
    M8CounterIncrement(M8_COUNTER_CARVE_ACTIVE_KERNELS);

    KernelState state = M8LoadKernelState(physicalSlot, kernelLocal);
    if (state.evidence <= MERKABA_EXPORT_KNOWN_FREE &&
        (state.flags & MERKABA_OCCUPIED_FLAG) == 0u)
    {
        uint previous;
        InterlockedAnd(_M8CarveActiveBits[wordIndex], ~bit, previous);
        if ((previous & bit) != 0u)
        {
            uint ignored;
            InterlockedAdd(_M8TileMeta[physicalSlot].w, 0xffffffffu, ignored);
        }
        return;
    }

    int3 globalCoord = M8GlobalKernelCoord(physicalSlot, kernelLocal);
    float3 worldPosition = mul(_MerkabaGridToWorld,
        float4((float3)globalCoord * MERKABA_LATTICE_STEP, 1.0)).xyz;
    if (IsExcluded(worldPosition)) return;
    int kind;
    float quality;
    FuseDepth(worldPosition, kind, quality);
    if (kind != 1) return;
    UpdateOccupancy(physicalSlot, kernelLocal, state,
        -max(1, (int)round(quality * quality * MERKABA_FREE_SCALE)));
    M8StoreKernelState(physicalSlot, kernelLocal, state);
    _M8TileRuntime[physicalSlot].y = 1u;
    if (state.evidence <= MERKABA_EXPORT_KNOWN_FREE &&
        (state.flags & MERKABA_OCCUPIED_FLAG) == 0u)
    {
        uint previous;
        InterlockedAnd(_M8CarveActiveBits[wordIndex], ~bit, previous);
        if ((previous & bit) != 0u)
        {
            uint ignored;
            InterlockedAdd(_M8TileMeta[physicalSlot].w, 0xffffffffu, ignored);
        }
    }
}

[numthreads(1, 1, 1)]
void FinalizeObservation(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_UNRESOLVED_SURFACE_TILES] == 0u)
        _M8Counters[M8_COUNTER_OBSERVATION_INTEGRATED] = 1u;
    _M8ObservationDispatchArgs[0] = min(
        _M8Counters[M8_COUNTER_TOUCHED_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    _M8ObservationDispatchArgs[1] = 1u;
    _M8ObservationDispatchArgs[2] = 1u;
}
