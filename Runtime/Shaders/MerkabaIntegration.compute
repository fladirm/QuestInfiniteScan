bool RequestColdTile(uint tileRefIndex, uint chunkIndex, uint tileLocal,
    bool scanRequest)
{
    bool queued = M8QueueColdTileLoad(tileRefIndex, chunkIndex, tileLocal);
    if (scanRequest && queued)
        M8CounterIncrement(M8_COUNTER_SCAN_COLD_MISSES);
    return queued;
}

void M8FinalizeObservationCompletion()
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] == 0u)
    {
        uint failure = M8ObservationFailureReason();
        _M8Counters[M8_COUNTER_OBSERVATION_FAILURE] = failure;
        // A snapshot is one bounded synchronous scan transaction. Its stage
        // barriers already ran inside this command graph, so there is nothing
        // left to schedule here and nothing to hold the frame for. COLD and
        // AMBIGUOUS dependencies were skipped locally. All reached resident
        // work has run; no cursor or semantic work survives this transaction.
        if (failure != 0u)
            _M8Counters[M8_COUNTER_FAILED_OBSERVATIONS] += 1u;
        _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] = 1u;
    }
    uint completed = _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED];
    uint failure = _M8Counters[M8_COUNTER_OBSERVATION_FAILURE];
    uint touchedCount = completed != 0u
        ? min(_M8Counters[M8_COUNTER_TOUCHED_TILE_COUNT],
            MERKABA_M8_PHYSICAL_TILE_CAPACITY) : 0u;
    bool readoutChanged =
        _M8Counters[M8_COUNTER_OBSERVATION_CHANGE_MASK] != 0u;
    _M8Counters[M8_COUNTER_CLEANUP_TOUCHED_COUNT] = touchedCount;
    _M8Counters[M8_COUNTER_CLEANUP_PENDING_COUNT] = 0u;
    _M8ObservationDispatchArgs[0] = touchedCount;
    _M8ObservationDispatchArgs[1] = 1u;
    _M8ObservationDispatchArgs[2] = 1u;
    _M8AttemptCompletion[0] = uint4(_M8AttemptToken,
        completed != 0u ?
            _M8Counters[M8_COUNTER_OBSERVATION_TOKEN] : 0u,
        failure | (readoutChanged ?
            M8_ATTEMPT_COMPLETION_READOUT_CHANGED : 0u) |
            (_M8Counters[M8_COUNTER_REFINEMENT_WORK_PROGRESS] != 0u ?
                M8_ATTEMPT_COMPLETION_REFINEMENT_PROGRESS : 0u),
        _M8Counters[M8_COUNTER_RESIDENCY_EPOCH]);
}


groupshared uint gFlowerFinalizeSourceReady;
groupshared uint gFlowerFinalizeTouchedCount;

[numthreads(128, 1, 1)]
void FinalizeObservation(uint lane : SV_GroupIndex)
{
    if (lane == 0u)
    {
        gFlowerFinalizeSourceReady = M8FlowerPageSourceReady(_M8WorldPublishingGeneration) ? 1u : 0u;
        M8FinalizeObservationCompletion();
        // Every actual R1/R2/RGB/V change invalidates its consumers before
        // this snapshot's packets and touched stamps are retired.
        gFlowerFinalizeTouchedCount = _M8Counters[M8_COUNTER_OBSERVATION_CHANGE_MASK] != 0u ?
            min(_M8Counters[M8_COUNTER_TOUCHED_TILE_COUNT], MERKABA_M8_PHYSICAL_TILE_CAPACITY) : 0u;
    }
    GroupMemoryBarrierWithGroupSync();
    if (gFlowerFinalizeSourceReady != 0u)
    {
        [loop] for (uint index = lane; index < gFlowerFinalizeTouchedCount; index += 128u)
            M8FlowerMarkTileNeighborhoodDirty(_M8TouchedTileQueueRead[index],
                _M8WorldPublishingGeneration, true, true, false);
    }
    DeviceMemoryBarrierWithGroupSync();
    M8FlowerRetireObservation(lane,128u);
}

uint M8FineEraseChildMask(int3 parentMin, int parentSpan)
{
    float halfLength = _M8FineLength * 0.5;
    float3 boundsCenter = _M8FineCursorPosition +
        _M8FineBrushAxis * halfLength;
    float boundsRadius = sqrt(max(0.0,
        _M8FineRadiusSquared + halfLength * halfLength));
    return MerkabaM8DistanceChildMask(parentMin, parentSpan,
        boundsRadius, boundsCenter,
        _MerkabaGridToWorld, _MerkabaWorldToGrid, MERKABA_LATTICE_STEP,
        MERKABA_HALF_SUPPORT);
}

groupshared uint gFineEraseBlockRef;
groupshared int3 gFineEraseBlockMin;
groupshared uint gFineEraseSupport4;
groupshared uint gFineEraseSupport3[8];

[numthreads(64, 1, 1)]
void QueryFineEraseTiles(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint linearBlockIndex = groupId.x;
    if (thread == 0u)
    {
        gFineEraseBlockRef = 0u;
        gFineEraseSupport4 = 0u;
        uint side = (uint)_M8ScanBlockSide;
        if (linearBlockIndex < side * side * side)
        {
            int3 offset;
            offset.x = (int)(linearBlockIndex % side) - _M8ScanBlockRadius;
            offset.y = (int)((linearBlockIndex / side) % side) -
                _M8ScanBlockRadius;
            offset.z = (int)(linearBlockIndex / (side * side)) -
                _M8ScanBlockRadius;
            int3 blockCoord = _M8ScanCenterBlock + offset;
            gFineEraseBlockMin = blockCoord *
                MERKABA_M8_BLOCK_KERNEL_SPAN;
            gFineEraseSupport4 = M8FineEraseChildMask(
                gFineEraseBlockMin, 256);
            if (gFineEraseSupport4 != 0u)
            {
                uint blockIndex;
                if (M8FindBlock(blockCoord, blockIndex))
                    gFineEraseBlockRef = blockIndex + 1u;
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (thread < 8u)
    {
        gFineEraseSupport3[thread] = 0u;
        if (gFineEraseBlockRef != 0u &&
            ((_M8BlockPresenceL0Read[gFineEraseBlockRef - 1u] &
              gFineEraseSupport4) & (1u << thread)) != 0u)
        {
            int3 childMin = gFineEraseBlockMin +
                MerkabaM8OctantOffset(thread, 128);
            gFineEraseSupport3[thread] =
                M8FineEraseChildMask(childMin, 128);
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gFineEraseBlockRef == 0u) return;

    uint blockIndex = gFineEraseBlockRef - 1u;
    uint d4 = thread >> 3u;
    uint d3 = thread & 7u;
    if (((gFineEraseSupport4 >> d4) & 1u) == 0u ||
        (((_M8BlockPresenceL1Read[blockIndex * 8u + d4] &
           gFineEraseSupport3[d4]) >> d3) & 1u) == 0u) return;

    int3 min4 = gFineEraseBlockMin + MerkabaM8OctantOffset(d4, 128);
    int3 min3 = min4 + MerkabaM8OctantOffset(d3, 64);
    uint support2 = (_M8BlockPresenceL2Read[blockIndex * 64u +
        d4 * 8u + d3] & 255u) & M8FineEraseChildMask(min3, 64);
    while (support2 != 0u)
    {
        uint d2 = (uint)firstbitlow(support2);
        support2 &= support2 - 1u;
        uint chunkLocal = (d4 << 6u) | (d3 << 3u) | d2;
        uint chunkRef = _M8BlockChunkRefsRead[blockIndex * 512u +
            chunkLocal];
        if (chunkRef == MERKABA_REF_EMPTY) continue;
        if (chunkRef >= MERKABA_REF_EVICTING)
        {
            M8CounterIncrement(M8_COUNTER_UNRESOLVED_OBSERVATION_TILES);
            continue;
        }
        uint chunkIndex = chunkRef - 1u;
        int3 min2 = min3 + MerkabaM8OctantOffset(d2, 32);
        uint support1 = (_M8ChunkPresenceRead[
            M8ChunkPresenceL0Index(chunkIndex)] & 255u) &
            M8FineEraseChildMask(min2, 32);
        while (support1 != 0u)
        {
            uint d1 = (uint)firstbitlow(support1);
            support1 &= support1 - 1u;
            int3 min1 = min2 + MerkabaM8OctantOffset(d1, 16);
            uint support0 = (_M8ChunkPresenceRead[
                M8ChunkPresenceL1Index(chunkIndex, d1)] & 255u) &
                M8FineEraseChildMask(min1, 16);
            while (support0 != 0u)
            {
                uint d0 = (uint)firstbitlow(support0);
                support0 &= support0 - 1u;
                uint tileLocal = (d1 << 3u) | d0;
                uint tileRefIndex = chunkIndex * 64u + tileLocal;
                uint tileRef = _M8ChunkTileRefs[tileRefIndex];
                if (tileRef == MERKABA_REF_EMPTY) continue;
                if (tileRef == MERKABA_REF_COLD_ON_SSD)
                {
                    RequestColdTile(tileRefIndex, chunkIndex, tileLocal,
                        false);
                    M8CounterIncrement(
                        M8_COUNTER_UNRESOLVED_OBSERVATION_TILES);
                    continue;
                }
                if (!M8IsHotRef(tileRef))
                {
                    M8CounterIncrement(
                        M8_COUNTER_UNRESOLVED_OBSERVATION_TILES);
                    continue;
                }
                uint queueIndex;
                InterlockedAdd(_M8Counters[M8_COUNTER_FINE_ERASE_TILE_COUNT],
                    1u, queueIndex);
                if (queueIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                {
                    _M8TouchedTileQueue[queueIndex] = M8PhysicalSlot(tileRef);
                    // Publish the bounded prefix as each real queue entry is
                    // produced. The existing dispatch barrier publishes both
                    // the queue and final unresolved state to EraseFineTiles.
                    uint ignored;
                    InterlockedMax(_M8ObservationDispatchArgs[0], queueIndex + 1u, ignored);
                }
                else M8CounterIncrement(M8_COUNTER_UNRESOLVED_OBSERVATION_TILES);
            }
        }
    }
}

void M8EraseFineKernel(uint slot,uint local)
{
    KernelState before=M8LoadKernelStateRead(slot,local);
    if(all(uint4(asuint(before.evidence),before.packedColor,before.colorConfidence,before.flags)==0u))return;
    float3 grid=float3(M8GlobalKernelCoord(slot,local))*MERKABA_LATTICE_STEP;
    if((before.flags&M8_FLOWER_OCCUPIED_FLAG)!=0u && M8FlowerHasPlane(before.flags))
    {
        float3 normal;float offset;
        M8FlowerUnpackPlane(before.flags,normal,offset);
        grid+=normal*offset;
    }
    if(!M8FineContains(mul(_MerkabaGridToWorld,float4(grid,1.0)).xyz))return;
    // Prepare only: failed source/peer preflight changes neither M8 nor its
    // epoch. The same GPU transaction cuts it before publishing zero M8.
    M8FlowerPrepareR1(slot,local,before,uint4(0u,0u,0u,0u),true,true);
}

[numthreads(128,1,1)]
void EraseFineTiles(uint3 group:SV_GroupID,uint lane:SV_GroupIndex)
{
    if(group.x>=min(_M8Counters[M8_COUNTER_FINE_ERASE_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY))return;
    uint slot=_M8TouchedTileQueueRead[group.x];
    if(slot>=MERKABA_M8_PHYSICAL_TILE_CAPACITY)return;
    uint4 runtime=_M8TileRecords[M8TileRuntimeIndex(slot)];
    uint4 meta=_M8TileRecords[M8TileMetaIndex(slot)];
    if(runtime.w==0u || meta.x>=MERKABA_M8_CHUNK_CAPACITY || meta.y>=64u ||
        _M8ChunkTileRefs[meta.x*64u+meta.y]!=slot+1u)
    {
        if(lane==0u)M8FlowerBinFailure(M8_OBSERVATION_FAILURE_MEASUREMENT_IDENTITY);
        return;
    }
    if(lane==0u)m8FlowerR1Changed=0u;
    M8FlowerCacheTileHalo(slot,lane,false,true,true);
    // COLD query results do not veto unrelated resident brush targets.
    [loop]for(uint local=lane;local<512u;local+=128u)M8EraseFineKernel(slot,local);
    DeviceMemoryBarrierWithGroupSync();
    if(lane==0u)
    {
        M8FlowerPublishR1Change(slot);
        _M8TileRecords[M8TileRuntimeIndex(slot)].x=_M8ObservationToken;
    }
}

[numthreads(128,1,1)]
void FinalizeFineErase(uint lane:SV_GroupIndex)
{
    if(lane==0u)
    {
        gFlowerFinalizeSourceReady=M8FlowerPageSourceReady(_M8WorldPublishingGeneration)?1u:0u;
        gFlowerFinalizeTouchedCount=min(_M8FlowerSignalItems.Load(M8_FLOWER_CHANGE_TILE_COUNT),
            MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    }
    GroupMemoryBarrierWithGroupSync();
    if(gFlowerFinalizeSourceReady!=0u)
    {
        [loop]for(uint index=lane;index<gFlowerFinalizeTouchedCount;index+=128u)
        {
            uint slot=_M8FlowerSignalItems.Load(M8_FLOWER_CHANGE_TILE_QUEUE+4u*index);
            M8FlowerMarkTileNeighborhoodDirty(slot,_M8WorldPublishingGeneration,true,true,false);
        }
    }
    DeviceMemoryBarrierWithGroupSync();
    if(lane==0u)
    {
        uint status=_M8Counters[M8_COUNTER_OBSERVATION_FAILURE];
        if(gFlowerFinalizeSourceReady==0u)status|=M8_OBSERVATION_FAILURE_MEASUREMENT_IDENTITY;
        if(_M8Counters[M8_COUNTER_OBSERVATION_CHANGE_MASK]!=0u)
            status|=M8_ATTEMPT_COMPLETION_READOUT_CHANGED;
        _M8AttemptCompletion[0]=uint4(_M8AttemptToken,_M8ObservationToken,status,
            _M8Counters[M8_COUNTER_RESIDENCY_EPOCH]);
    }
    // No pending epoch bits, descriptor retry or packet survives this job.
    if(lane<16u)_M8FlowerSignalItems.Store(4u*lane,0u);
}
