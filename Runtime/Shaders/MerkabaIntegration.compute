#define MERKABA_LATTICE_STEP 0.025
#define MERKABA_SUPPORT_SIZE 0.050
#define MERKABA_HALF_SUPPORT 0.025
#define MERKABA_OCCUPIED_ON 512
#define MERKABA_OCCUPIED_OFF 128
#define MERKABA_SURFACE_SCALE 640.0
#define MERKABA_FREE_SCALE 256.0
#define MERKABA_EVIDENCE_CONFIDENCE_LIMIT 2560
#define MERKABA_FREE_FULL_CLEARANCE 0.150
#define MERKABA_REVISION_MIN_INCIDENCE 0.3
// Frozen from the Quest 3S centre/mid/edge calibration on 2026-08-30:
// full authority in the central third, deterministic fade to zero at 2/3.
#define MERKABA_MUTATION_INNER_RADIUS (1.0 / 3.0)
#define MERKABA_OCCUPIED_FLAG 1u
#define MERKABA_DEPTH_DISPARITY 0.5
#define MERKABA_SURFACE_QUEUE_CAPACITY 1048576u
#define MERKABA_MEASUREMENT_PIXEL_MASK 0x00000fffu
#define MERKABA_MEASUREMENT_PACKED_MASK 0x00ffffffu
#define MERKABA_SURFACE_ROUTE_SHIFT 24u
#define MERKABA_SURFACE_ROUTE_UNROUTED 0
#define MERKABA_SURFACE_ROUTE_VALID 1
#define MERKABA_SURFACE_ROUTE_UNRESOLVED 2
#define MERKABA_SURFACE_ROUTE_INVALID 3
#define MERKABA_SURFACE_ROUTE_MASK 3
#define MERKABA_SURFACE_AUTHORITY_SHIFT 26u
#define MERKABA_SURFACE_AUTHORITY_MASK 3
#define MERKABA_SURFACE_AUTHORITY_NONE 0
#define MERKABA_SURFACE_AUTHORITY_DISCOVERY 1
#define MERKABA_SURFACE_AUTHORITY_SUPPORT 2
#define MERKABA_SURFACE_AUTHORITY_REVISION 3
#define MERKABA_SURFACE_FLAG_OFF_AXIS_BLOCKED 0x10000000u
#define MERKABA_SURFACE_FLAG_REPLACEMENT 0x20000000u
#define MERKABA_SURFACE_FLAG_STRICT 0x40000000u
#define MERKABA_SURFACE_WINNER_EMPTY 0xffffffffu

RWStructuredBuffer<int4> _M8SurfaceCandidates;
StructuredBuffer<int4> _M8SurfaceCandidatesRead;
RWStructuredBuffer<uint2> _M8SurfaceQueue;
StructuredBuffer<uint2> _M8SurfaceQueueRead;
RWStructuredBuffer<uint> _M8SurfaceWinnerRanks0;
RWStructuredBuffer<uint> _M8SurfaceWinnerRanks1;
RWStructuredBuffer<uint> _M8SurfaceWinnerRanks2;
RWStructuredBuffer<uint> _M8SurfaceWinnerRanks3;
StructuredBuffer<uint> _M8SurfaceWinnerRanks0Read;
StructuredBuffer<uint> _M8SurfaceWinnerRanks1Read;
StructuredBuffer<uint> _M8SurfaceWinnerRanks2Read;
StructuredBuffer<uint> _M8SurfaceWinnerRanks3Read;
RWStructuredBuffer<uint> _M8TouchedTileQueue;
RWStructuredBuffer<uint> _M8CarveTiles;
StructuredBuffer<uint> _M8CarveTilesRead;
RWStructuredBuffer<uint> _M8ObservationDispatchArgs;
RWStructuredBuffer<uint> _M8CarveDispatchArgs;
RWStructuredBuffer<uint4> _M8AttemptCompletion;

float4x4 _MerkabaGridToWorld;
float4x4 _MerkabaWorldToGrid;
float _MerkabaMaxUpdateDistance;
float _MerkabaMutationOuterRadius;

Texture2D<float4> gsDilatedDepth;

int _MerkabaExclusionCount;
float3 _MerkabaExclusionHeads[64];

#define EXCLUSION_TOP 0.25
#define EXCLUSION_BOTTOM 1.7
#define EXCLUSION_RADIUS 0.6

int _M8AbortObservation;
uint _M8AttemptToken;

float3 _M8ScanCameraWorld;
int3 _M8ScanCenterBlock;
int _M8ScanBlockRadius;
int _M8ScanBlockSide;
float4 _M8ScanCoveragePlanes[8];
uint _M8FineRefineActive;
float3 _M8FineEyeOrigin;
float3 _M8FineBrushAxis;
float _M8FineCosHalfAngleSquared;
float _M8FineToolDepthSquared;

bool M8FineContains(float3 worldPosition)
{
    float3 relative = worldPosition - _M8FineEyeOrigin;
    float distanceSquared = dot(relative, relative);
    float axial = dot(relative, _M8FineBrushAxis);
    return distanceSquared <= _M8FineToolDepthSquared && axial >= 0.0 &&
        axial * axial >= distanceSquared * _M8FineCosHalfAngleSquared;
}

float M8FineWeight(float3 worldPosition)
{
    float3 relative = worldPosition - _M8FineEyeOrigin;
    float distanceSquared = dot(relative, relative);
    float axial = dot(relative, _M8FineBrushAxis);
    if (distanceSquared > _M8FineToolDepthSquared || axial < 0.0 ||
        axial * axial < distanceSquared * _M8FineCosHalfAngleSquared)
        return 0.0;
    if (distanceSquared <= 1.0e-12) return 1.0;
    float cosineSquared = axial * axial / distanceSquared;
    return saturate((cosineSquared - _M8FineCosHalfAngleSquared) /
        max(1.0e-6, 1.0 - _M8FineCosHalfAngleSquared));
}

uint M8ObservationFailureReason()
{
    uint reason = _M8Counters[M8_COUNTER_OBSERVATION_FAILURE];
    if (_M8Counters[M8_COUNTER_SURFACE_CANDIDATE_OVERFLOW] != 0u)
        reason |= M8_OBSERVATION_FAILURE_SURFACE_CAPACITY;
    if (_M8AbortObservation != 0)
        reason |= M8_OBSERVATION_FAILURE_TIMEOUT;
    return reason;
}

uint PackRgb(uint r, uint g, uint b)
{
    return r | (g << 8u) | (b << 16u) | (255u << 24u);
}

void AccumulateColor(inout KernelState state, float3 observed, float quality)
{
    uint incomingWeight = (uint)clamp(round(quality * 256.0), 1.0, 256.0);
    uint oldWeight = min(state.colorConfidence, 65535u);
    uint3 observedRgb = (uint3)round(saturate(observed) * 255.0);
    if (oldWeight == 0u)
    {
        state.packedColor = PackRgb(observedRgb.r, observedRgb.g,
            observedRgb.b);
        state.colorConfidence = incomingWeight;
        return;
    }
    uint3 old = uint3(state.packedColor & 255u,
        (state.packedColor >> 8u) & 255u,
        (state.packedColor >> 16u) & 255u);
    uint divisor = oldWeight + incomingWeight;
    uint3 blended = (old * oldWeight + observedRgb * incomingWeight +
        divisor / 2u) / divisor;
    state.packedColor = PackRgb(blended.r, blended.g, blended.b);
    state.colorConfidence = min(65535u, divisor);
}

bool IsExcluded(float3 worldPosition)
{
    [loop]
    for (int exclusion = 0; exclusion < _MerkabaExclusionCount; exclusion++)
    {
        float3 head = _MerkabaExclusionHeads[exclusion];
        float2 difference = worldPosition.xz - head.xz;
        if (dot(difference, difference) < EXCLUSION_RADIUS * EXCLUSION_RADIUS &&
            worldPosition.y < head.y + EXCLUSION_TOP &&
            worldPosition.y > head.y - EXCLUSION_BOTTOM)
            return true;
    }
    return false;
}

int MerkabaRoundNearest(float value)
{
    return value >= 0.0 ? (int)floor(value + 0.5) : (int)ceil(value - 0.5);
}

int3 MerkabaNearestKernel(float3 gridPosition)
{
    return int3(MerkabaRoundNearest(gridPosition.x),
        MerkabaRoundNearest(gridPosition.y),
        MerkabaRoundNearest(gridPosition.z));
}

bool TrySurfaceMeasurement(uint2 pixel, out float3 worldSurface,
    out int3 surfaceKernel, out float3 surfaceNormal, out float quality,
    out float measurementConfidence)
{
    worldSurface = 0.0;
    surfaceKernel = 0;
    surfaceNormal = 0.0;
    quality = 0.0;
    measurementConfidence = 0.0;
    if (any(pixel >= gsDepthTexSize) || pixel.x >
        MERKABA_MEASUREMENT_PIXEL_MASK || pixel.y >
        MERKABA_MEASUREMENT_PIXEL_MASK)
        return false;

    float depthNdc = gsDepthTex.Load(int3(pixel, 0));
    if (depthNdc <= 0.0 || depthNdc >= 1.0) return false;
    float2 uv = ((float2)pixel + 0.5) / (float2)gsDepthTexSize;
    worldSurface = gsDepthNDCtoWorld(float3(uv, depthNdc));
    if (IsExcluded(worldSurface)) return false;

    float3 eyeToSurface = worldSurface - gsDepthEyePos();
    float measuredDistance = length(eyeToSurface);
    if (measuredDistance <= 0.05 ||
        measuredDistance > _MerkabaMaxUpdateDistance)
        return false;
    float4 normalSample = gsDepthNormalTex.Load(int3(pixel, 0));
    surfaceNormal = normalSample.xyz;
    measurementConfidence = normalSample.w;
    if (dot(surfaceNormal, surfaceNormal) < 0.25) return false;
    if (measurementConfidence <= 0.0) return false;
    float normalFacing = -dot(eyeToSurface, surfaceNormal) / measuredDistance;

    float distanceFactor = saturate(1.0 - measuredDistance /
        _MerkabaMaxUpdateDistance);
    quality = distanceFactor * saturate(normalFacing);

    float3 gridSurface = mul(_MerkabaWorldToGrid,
        float4(worldSurface, 1.0)).xyz / MERKABA_LATTICE_STEP;
    surfaceKernel = MerkabaNearestKernel(gridSurface);
    return true;
}

bool TryMerkabaDepthRadialPosition(float3 worldPosition,
    out float radialPosition)
{
    radialPosition = 0.0;
    [unroll]
    for (uint eye = 0u; eye < 2u; eye++)
    {
        float4 hcs = mul(gsDepthProj[eye], mul(gsDepthView[eye],
            float4(worldPosition, 1.0)));
        if (hcs.w <= 0.0) return false;
        float2 uv = gsDepthHCStoNDC(hcs).xy;
        if (any(uv < 0.0) || any(uv > 1.0)) return false;
        radialPosition = max(radialPosition,
            max(abs(uv.x * 2.0 - 1.0), abs(uv.y * 2.0 - 1.0)));
    }
    return true;
}

float3 MerkabaDepthEyePosition(uint eye)
{
    return float3(gsDepthViewInv[eye][0][3],
        gsDepthViewInv[eye][1][3], gsDepthViewInv[eye][2][3]);
}

float MerkabaMutationAttentionFromRadial(float3 worldSurface,
    float3 surfaceNormal, float radialPosition)
{
    float3 origin = (MerkabaDepthEyePosition(0u) +
        MerkabaDepthEyePosition(1u)) * 0.5;
    float3 ray = worldSurface - origin;
    float rayLength = length(ray);
    if (rayLength <= 0.001) return 0.0;
    float incidence = -dot(ray / rayLength, surfaceNormal);
    if (incidence < MERKABA_REVISION_MIN_INCIDENCE)
        return 0.0;
    if (_M8FineRefineActive != 0u)
        return M8FineWeight(worldSurface);
    if (radialPosition >= _MerkabaMutationOuterRadius) return 0.0;
    float transition = saturate((_MerkabaMutationOuterRadius -
        radialPosition) / (_MerkabaMutationOuterRadius -
        MERKABA_MUTATION_INNER_RADIUS));
    return transition * transition * (3.0 - 2.0 * transition);
}

float MerkabaMutationAttention(float3 worldSurface, float3 surfaceNormal,
    out float radialPosition)
{
    if (_M8FineRefineActive != 0u)
    {
        radialPosition = 0.0;
        return MerkabaMutationAttentionFromRadial(worldSurface,
            surfaceNormal, radialPosition);
    }
    if (!TryMerkabaDepthRadialPosition(worldSurface, radialPosition))
        return 0.0;
    return MerkabaMutationAttentionFromRadial(worldSurface, surfaceNormal,
        radialPosition);
}

uint MerkabaPackMeasurementPixel(uint2 pixel)
{
    return (pixel.x & MERKABA_MEASUREMENT_PIXEL_MASK) |
        ((pixel.y & MERKABA_MEASUREMENT_PIXEL_MASK) << 12u);
}

uint2 MerkabaSurfacePixel(int packedMetadata)
{
    uint metadata = asuint(packedMetadata);
    return uint2(metadata & MERKABA_MEASUREMENT_PIXEL_MASK,
        (metadata >> 12u) & MERKABA_MEASUREMENT_PIXEL_MASK);
}

int MerkabaPackSurfaceMetadata(uint2 pixel, int route, int authority,
    bool offAxisBlocked, bool replacement, bool strictMeasurement)
{
    uint metadata = MerkabaPackMeasurementPixel(pixel) |
        ((uint)route << MERKABA_SURFACE_ROUTE_SHIFT) |
        ((uint)authority << MERKABA_SURFACE_AUTHORITY_SHIFT) |
        (offAxisBlocked ? MERKABA_SURFACE_FLAG_OFF_AXIS_BLOCKED : 0u) |
        (replacement ? MERKABA_SURFACE_FLAG_REPLACEMENT : 0u) |
        (strictMeasurement ? MERKABA_SURFACE_FLAG_STRICT : 0u);
    return asint(metadata);
}

int MerkabaSurfaceRoute(int packedRoute)
{
    return (int)((asuint(packedRoute) >> MERKABA_SURFACE_ROUTE_SHIFT) &
        MERKABA_SURFACE_ROUTE_MASK);
}

int MerkabaSurfaceAuthority(int packedRoute)
{
    return (int)((asuint(packedRoute) >> MERKABA_SURFACE_AUTHORITY_SHIFT) &
        MERKABA_SURFACE_AUTHORITY_MASK);
}

int3 MerkabaNearestNormalStep(float3 worldNormal)
{
    return MerkabaNearestGridNormalStep(mul(
        (float3x3)_MerkabaWorldToGrid, worldNormal));
}

bool M8FindSurfaceBlock(int3 blockCoord, out uint blockIndex)
{
    blockIndex = 0u;
    uint2 buckets = MerkabaHashBucketSearchOrder(blockCoord);
    [unroll]
    for (uint bucketOrder = 0u; bucketOrder < 2u; bucketOrder++)
    {
        uint bucket = bucketOrder == 0u ? buckets.x : buckets.y;
        [unroll]
        for (uint slot = 0u; slot < MERKABA_M8_HASH_SLOTS_PER_BUCKET; slot++)
        {
            M8HashEntry entry = _M8HashEntries[
                M8HashEntryIndex(bucket, slot)];
            if (entry.blockRef != MERKABA_REF_EMPTY &&
                entry.blockRef != MERKABA_REF_CLAIMED_NEW &&
                all(entry.blockCoord == blockCoord))
            {
                blockIndex = entry.blockRef - 1u;
                return blockIndex < MERKABA_M8_BLOCK_CAPACITY;
            }
        }
    }
    return false;
}

int M8InspectSurfaceOwner(int3 globalCoord,
    MerkabaM8Address nearestAddress, bool nearestBlockReady,
    uint nearestBlockIndex, out bool occupied, out uint flags)
{
    occupied = false;
    flags = 0u;
    MerkabaM8Address address = MerkabaAddressOf(globalCoord);
    bool sameBlock = all(address.blockCoord == nearestAddress.blockCoord);
    uint blockIndex = nearestBlockIndex;
    if (sameBlock)
    {
        if (!nearestBlockReady) return 0;
    }
    else if (!M8FindSurfaceBlock(address.blockCoord, blockIndex)) return 0;
    uint chunkRef = _M8BlockChunkRefsRead[blockIndex *
        MERKABA_M8_BLOCK_CHUNK_COUNT + address.chunkLocal];
    if (chunkRef == MERKABA_REF_EMPTY) return 0;
    if (chunkRef == MERKABA_REF_CLAIMED_NEW) return 2;
    uint chunkIndex = chunkRef - 1u;
    if (chunkIndex >= MERKABA_M8_CHUNK_CAPACITY) return 2;
    uint tileRefIndex = chunkIndex * MERKABA_M8_TILES_PER_CHUNK +
        address.tileLocal;
    uint tileRef = _M8ChunkTileRefsRead[tileRefIndex];
    if (tileRef == MERKABA_REF_EMPTY) return 0;
    if (!M8IsHotRef(tileRef)) return 2;
    uint physicalSlot = M8PhysicalSlot(tileRef);
    uint word = M8TileWordIndex(physicalSlot, address.kernelLocal >> 5u);
    occupied = (_M8TileBitsRead[word].x &
        (1u << (address.kernelLocal & 31u))) != 0u;
    if (occupied)
        flags = M8LoadKernelStateRead(physicalSlot,
            address.kernelLocal).flags;
    return occupied ? 1 : 0;
}

bool M8HasBootstrapSheetNeighbour(int3 targetCoord, int3 measuredStep,
    MerkabaM8Address nearestAddress, bool nearestBlockReady,
    uint nearestBlockIndex, out bool unresolved,
    out int3 unresolvedCoord)
{
    unresolved = false;
    unresolvedCoord = targetCoord;
    [unroll]
    for (uint neighbourIndex = 0u; neighbourIndex < 26u;
         neighbourIndex++)
    {
        uint encoded = neighbourIndex < 13u
            ? neighbourIndex : neighbourIndex + 1u;
        int3 offset = int3(encoded % 3u,
            (encoded / 3u) % 3u, encoded / 9u) - 1;
        int3 neighbourCoord = targetCoord + offset;
        bool occupied;
        uint flags;
        int status = M8InspectSurfaceOwner(neighbourCoord, nearestAddress,
            nearestBlockReady, nearestBlockIndex, occupied, flags);
        if (status == 2)
        {
            if (!unresolved) unresolvedCoord = neighbourCoord;
            unresolved = true;
            continue;
        }
        if (!occupied || !M8HasSurfacePlane(flags)) continue;
        float3 neighbourNormal;
        float neighbourOffset;
        M8DecodeSurfacePlane(flags, neighbourNormal, neighbourOffset);
        int3 neighbourStep = MerkabaNearestGridNormalStep(neighbourNormal);
        if (all(neighbourStep == measuredStep) ||
            all(neighbourStep == -measuredStep))
            return true;
    }
    return false;
}

bool MerkabaOwnerCompatible(int3 ownerCoord, float3 worldSurface,
    float3 worldNormal, float3 rayOrigin, float3 rayDirection,
    float endpointDistance, out float alongError,
    out float perpendicularError)
{
    float3 ownerWorld = mul(_MerkabaGridToWorld,
        float4((float3)ownerCoord * MERKABA_LATTICE_STEP, 1.0)).xyz;
    float3 originToOwner = ownerWorld - rayOrigin;
    float ownerDistance = dot(originToOwner, rayDirection);
    float3 closestOnRay = rayOrigin + rayDirection * ownerDistance;
    alongError = abs(endpointDistance - ownerDistance);
    perpendicularError = distance(ownerWorld, closestOnRay);
    float ownerPlaneOffset = dot(worldSurface - ownerWorld, worldNormal);
    return ownerDistance > 0.0 &&
        alongError <= MERKABA_SUPPORT_SIZE &&
        perpendicularError <= MERKABA_HALF_SUPPORT &&
        abs(ownerPlaneOffset) <=
            MERKABA_SURFACE_PLANE_OFFSET_RANGE + 1.0e-6;
}

bool MerkabaLexicographicallyLess(int3 left, int3 right)
{
    return left.x < right.x ||
        (left.x == right.x && (left.y < right.y ||
        (left.y == right.y && left.z < right.z)));
}

int RouteSurfaceCandidate(int3 seedCoord, uint2 sourcePixel,
    out int3 targetCoord)
{
    targetCoord = seedCoord;
    float3 worldSurface;
    int3 nearestKernel;
    float3 surfaceNormal;
    float quality;
    float measurementConfidence;
    if (!TrySurfaceMeasurement(sourcePixel, worldSurface, nearestKernel,
            surfaceNormal, quality, measurementConfidence))
        return MerkabaPackSurfaceMetadata(sourcePixel,
            MERKABA_SURFACE_ROUTE_INVALID, MERKABA_SURFACE_AUTHORITY_NONE,
            false, false, false);
    bool strictMeasurement = measurementConfidence >= 1.0;
    if (!strictMeasurement && quality <= 0.0)
        return MerkabaPackSurfaceMetadata(sourcePixel,
            MERKABA_SURFACE_ROUTE_INVALID, MERKABA_SURFACE_AUTHORITY_NONE,
            false, false, false);
    if (_M8FineRefineActive != 0u && !strictMeasurement)
        return MerkabaPackSurfaceMetadata(sourcePixel,
            MERKABA_SURFACE_ROUTE_INVALID, MERKABA_SURFACE_AUTHORITY_NONE,
            false, false, false);

    float3 rayOrigin = (MerkabaDepthEyePosition(0u) +
        MerkabaDepthEyePosition(1u)) * 0.5;
    float3 ray = worldSurface - rayOrigin;
    float endpointDistance = length(ray);
    if (endpointDistance <= 0.001)
        return MerkabaPackSurfaceMetadata(sourcePixel,
            MERKABA_SURFACE_ROUTE_INVALID, MERKABA_SURFACE_AUTHORITY_NONE,
            false, false, strictMeasurement);
    ray /= endpointDistance;
    float3 worldNormal = normalize(surfaceNormal);
    int3 normalStep = MerkabaNearestNormalStep(surfaceNormal);
    MerkabaM8Address nearestAddress = MerkabaAddressOf(nearestKernel);
    uint nearestBlockIndex = 0u;
    bool nearestBlockReady = M8FindSurfaceBlock(nearestAddress.blockCoord,
        nearestBlockIndex);
    if (!strictMeasurement)
    {
        bool targetOccupied;
        uint targetFlags;
        int targetState = M8InspectSurfaceOwner(nearestKernel,
            nearestAddress, nearestBlockReady, nearestBlockIndex,
            targetOccupied, targetFlags);
        if (targetState == 2)
        {
            targetCoord = nearestKernel;
            return MerkabaPackSurfaceMetadata(sourcePixel,
                MERKABA_SURFACE_ROUTE_UNRESOLVED,
                MERKABA_SURFACE_AUTHORITY_NONE, false, false, false);
        }
        if (targetOccupied)
            return MerkabaPackSurfaceMetadata(sourcePixel,
                MERKABA_SURFACE_ROUTE_INVALID,
                MERKABA_SURFACE_AUTHORITY_NONE, false, false, false);
        bool bootstrapUnresolved;
        int3 bootstrapUnresolvedCoord;
        bool supported = M8HasBootstrapSheetNeighbour(nearestKernel,
            normalStep, nearestAddress, nearestBlockReady,
            nearestBlockIndex, bootstrapUnresolved,
            bootstrapUnresolvedCoord);
        if (supported)
        {
            targetCoord = nearestKernel;
            return MerkabaPackSurfaceMetadata(sourcePixel,
                MERKABA_SURFACE_ROUTE_VALID,
                MERKABA_SURFACE_AUTHORITY_DISCOVERY, false, false, false);
        }
        if (bootstrapUnresolved)
        {
            targetCoord = bootstrapUnresolvedCoord;
            return MerkabaPackSurfaceMetadata(sourcePixel,
                MERKABA_SURFACE_ROUTE_UNRESOLVED,
                MERKABA_SURFACE_AUTHORITY_NONE, false, false, false);
        }
        return MerkabaPackSurfaceMetadata(sourcePixel,
            MERKABA_SURFACE_ROUTE_INVALID, MERKABA_SURFACE_AUTHORITY_NONE,
            false, false, false);
    }
    int3 ownerCandidates[3] =
    {
        nearestKernel,
        nearestKernel + normalStep,
        nearestKernel - normalStep
    };
    bool foundOwner = false;
    bool unresolved = false;
    int3 unresolvedOwner = nearestKernel;
    int3 bestOwner = nearestKernel;
    float bestAlong = 1.0e20;
    float bestPerpendicular = 1.0e20;
    [unroll]
    for (uint candidateIndex = 0u; candidateIndex < 3u; candidateIndex++)
    {
        int3 ownerCoord = ownerCandidates[candidateIndex];
        float alongError;
        float perpendicularError;
        if (!MerkabaOwnerCompatible(ownerCoord, worldSurface, worldNormal,
                rayOrigin, ray, endpointDistance, alongError,
                perpendicularError))
            continue;
        bool occupied;
        uint ownerFlags;
        int state = M8InspectSurfaceOwner(ownerCoord, nearestAddress,
            nearestBlockReady, nearestBlockIndex, occupied, ownerFlags);
        if (state == 2)
        {
            if (!unresolved) unresolvedOwner = ownerCoord;
            unresolved = true;
            continue;
        }
        if (!occupied) continue;
        bool better = !foundOwner || alongError < bestAlong - 1.0e-6 ||
            (abs(alongError - bestAlong) <= 1.0e-6 &&
            (perpendicularError < bestPerpendicular - 1.0e-6 ||
            (abs(perpendicularError - bestPerpendicular) <= 1.0e-6 &&
            MerkabaLexicographicallyLess(ownerCoord, bestOwner))));
        if (better)
        {
            foundOwner = true;
            bestOwner = ownerCoord;
            bestAlong = alongError;
            bestPerpendicular = perpendicularError;
        }
    }
    if (unresolved)
    {
        targetCoord = unresolvedOwner;
        return MerkabaPackSurfaceMetadata(sourcePixel,
            MERKABA_SURFACE_ROUTE_UNRESOLVED,
            MERKABA_SURFACE_AUTHORITY_NONE, false, false,
            strictMeasurement);
    }
    if (!foundOwner)
    {
        targetCoord = nearestKernel;
        return MerkabaPackSurfaceMetadata(sourcePixel,
            MERKABA_SURFACE_ROUTE_VALID,
            MERKABA_SURFACE_AUTHORITY_DISCOVERY, false, false,
            strictMeasurement);
    }

    float radialPosition;
    float attention = MerkabaMutationAttention(worldSurface, surfaceNormal,
        radialPosition);
    bool revision = attention > 0.0;
    targetCoord = revision ? nearestKernel : bestOwner;
    bool replacement = revision && any(nearestKernel != bestOwner);
    return MerkabaPackSurfaceMetadata(sourcePixel,
        MERKABA_SURFACE_ROUTE_VALID,
        revision ? MERKABA_SURFACE_AUTHORITY_REVISION :
            MERKABA_SURFACE_AUTHORITY_SUPPORT,
        !revision, replacement, true);
}

float MerkabaFreeDistanceWeight(float clearance)
{
    return saturate((clearance - MERKABA_HALF_SUPPORT) /
        (MERKABA_FREE_FULL_CLEARANCE - MERKABA_HALF_SUPPORT));
}

#define MERKABA_CHEAP_RAY_CANDIDATE 0u
#define MERKABA_CHEAP_RAY_INVALID_PROJECTION_DEPTH 1u
#define MERKABA_CHEAP_RAY_NOT_IN_FRONT 2u
#define MERKABA_CHEAP_RAY_OUTSIDE_TUBE 3u
#define MERKABA_CHEAP_RAY_OUTSIDE_OUTER_ATTENTION 4u

#define MERKABA_EXACT_REJECT_NONE 0u
#define MERKABA_EXACT_REJECT_INCIDENCE 1u
#define MERKABA_EXACT_REJECT_DILATION 2u
#define MERKABA_EXACT_REJECT_OTHER 3u

uint CheapFrozenRayGate(int3 globalCoord, float3 worldPosition,
    out uint2 pixel, out float3 worldSurface, out int3 surfaceKernel,
    out float radialPosition, out bool surfaceEndpoint)
{
    pixel = 0u;
    worldSurface = 0.0;
    surfaceKernel = 0;
    radialPosition = 2.0;
    surfaceEndpoint = false;
    if (IsExcluded(worldPosition))
        return MERKABA_CHEAP_RAY_INVALID_PROJECTION_DEPTH;
    float3 viewPosition = mul(gsDepthView[0],
        float4(worldPosition, 1.0)).xyz;
    if (viewPosition.z > -0.05)
        return MERKABA_CHEAP_RAY_NOT_IN_FRONT;
    float3 ndc = gsDepthWorldToNDC(worldPosition);
    if (ndc.x < 0.01 || ndc.x > 0.99 || ndc.y < 0.01 || ndc.y > 0.99)
        return MERKABA_CHEAP_RAY_INVALID_PROJECTION_DEPTH;
    pixel = min((uint2)(ndc.xy * (float2)gsDepthTexSize),
        gsDepthTexSize - 1u);
    if (pixel.x > MERKABA_MEASUREMENT_PIXEL_MASK ||
        pixel.y > MERKABA_MEASUREMENT_PIXEL_MASK)
        return MERKABA_CHEAP_RAY_INVALID_PROJECTION_DEPTH;
    float depthNdc = gsDepthTex.Load(int3(pixel, 0));
    if (depthNdc <= 0.0 || depthNdc >= 1.0)
        return MERKABA_CHEAP_RAY_INVALID_PROJECTION_DEPTH;
    float2 uv = ((float2)pixel + 0.5) / (float2)gsDepthTexSize;
    worldSurface = gsDepthNDCtoWorld(float3(uv, depthNdc));
    if (IsExcluded(worldSurface))
        return MERKABA_CHEAP_RAY_INVALID_PROJECTION_DEPTH;
    float3 eyeToSurface = worldSurface - gsDepthEyePos();
    float measuredDistance = length(eyeToSurface);
    if (measuredDistance <= 0.05 ||
        measuredDistance > _MerkabaMaxUpdateDistance)
        return MERKABA_CHEAP_RAY_INVALID_PROJECTION_DEPTH;
    float3 gridSurface = mul(_MerkabaWorldToGrid,
        float4(worldSurface, 1.0)).xyz / MERKABA_LATTICE_STEP;
    surfaceKernel = MerkabaNearestKernel(gridSurface);
    surfaceEndpoint = all(globalCoord == surfaceKernel);

    // gsDepthTex is defined on the frozen reference depth-eye raster. The
    // endpoint is joint four-stream truth, but its exact ray origin is eye 0.
    float3 rayOrigin = MerkabaDepthEyePosition(0u);
    float3 measuredRay = worldSurface - rayOrigin;
    float rayDistance = length(measuredRay);
    if (rayDistance <= 0.001)
        return MERKABA_CHEAP_RAY_INVALID_PROJECTION_DEPTH;
    if (!surfaceEndpoint)
    {
        float3 rayDirection = measuredRay / rayDistance;
        float3 originToKernel = worldPosition - rayOrigin;
        float kernelDistance = dot(originToKernel, rayDirection);
        if (kernelDistance <= 0.0)
            return MERKABA_CHEAP_RAY_NOT_IN_FRONT;
        float3 closestOnRay = rayOrigin + rayDirection * kernelDistance;
        float perpendicularDistance = distance(worldPosition, closestOnRay);
        if (perpendicularDistance > MERKABA_HALF_SUPPORT ||
            kernelDistance >= rayDistance - MERKABA_HALF_SUPPORT)
            return MERKABA_CHEAP_RAY_OUTSIDE_TUBE;
    }

    if (_M8FineRefineActive != 0u)
    {
        radialPosition = 0.0;
        if (!M8FineContains(worldSurface))
            return MERKABA_CHEAP_RAY_OUTSIDE_OUTER_ATTENTION;
    }
    else if (!TryMerkabaDepthRadialPosition(worldSurface, radialPosition) ||
             radialPosition >= _MerkabaMutationOuterRadius)
        return MERKABA_CHEAP_RAY_OUTSIDE_OUTER_ATTENTION;
    return MERKABA_CHEAP_RAY_CANDIDATE;
}

bool ExactFrozenRayClassify(int3 globalCoord, float3 worldPosition,
    uint2 pixel, float3 worldSurface, int3 surfaceKernel,
    float radialPosition, out int kind, out float evidenceWeight,
    out int3 replacementCoord, out uint rejection)
{
    kind = 0;
    evidenceWeight = 0.0;
    replacementCoord = surfaceKernel;
    rejection = MERKABA_EXACT_REJECT_OTHER;
    float4 normalSample = gsDepthNormalTex.Load(int3(pixel, 0));
    float3 surfaceNormal = normalSample.xyz;
    if (dot(surfaceNormal, surfaceNormal) < 0.25) return false;
    float3 eyeToSurface = worldSurface - gsDepthEyePos();
    float measuredEyeDistance = length(eyeToSurface);
    if (measuredEyeDistance <= 0.05 ||
        measuredEyeDistance > _MerkabaMaxUpdateDistance)
        return false;
    float normalFacing = -dot(eyeToSurface, surfaceNormal) /
        measuredEyeDistance;
    float distanceFactor = saturate(1.0 - measuredEyeDistance /
        _MerkabaMaxUpdateDistance);
    float quality = distanceFactor * saturate(normalFacing);
    float attention = MerkabaMutationAttentionFromRadial(worldSurface,
        surfaceNormal, radialPosition);
    if (attention <= 0.0)
    {
        rejection = MERKABA_EXACT_REJECT_INCIDENCE;
        return false;
    }

    float3 rayOrigin = MerkabaDepthEyePosition(0u);
    float3 measuredRay = worldSurface - rayOrigin;
    float measuredDistance = length(measuredRay);
    if (measuredDistance <= 0.001) return false;
    float3 rayDirection = measuredRay / measuredDistance;
    float3 originToKernel = worldPosition - rayOrigin;
    float kernelDistance = dot(originToKernel, rayDirection);
    if (kernelDistance <= 0.0) return false;
    float3 closestOnRay = rayOrigin + rayDirection * kernelDistance;
    float perpendicularDistance = distance(worldPosition, closestOnRay);
    if (perpendicularDistance > MERKABA_HALF_SUPPORT) return false;
    float clearance = measuredDistance - kernelDistance;
    if (all(globalCoord == surfaceKernel))
    {
        kind = 2;
        evidenceWeight = quality * quality;
        rejection = MERKABA_EXACT_REJECT_NONE;
    }
    else if (kernelDistance < measuredDistance - MERKABA_HALF_SUPPORT)
    {
        // Bootstrap joint hits may create a first DISCOVERY surface, but
        // never weaken the exact foreground-protected FREE classifier.
        if (normalSample.w < 1.0) return false;
        float jointDepth = gsDepthTex.Load(int3(pixel, 0));
        float dilatedDepth = gsDilatedDepth.Load(int3(pixel, 0)).z;
        if (dilatedDepth <= 0.0 || dilatedDepth >= 1.0 ||
            gsDepthNDCToLinear(jointDepth) >=
            gsDepthNDCToLinear(dilatedDepth) + MERKABA_DEPTH_DISPARITY)
        {
            rejection = MERKABA_EXACT_REJECT_DILATION;
            return false;
        }
        kind = 1;
        evidenceWeight = quality * quality *
            MerkabaFreeDistanceWeight(clearance) * attention;
        rejection = MERKABA_EXACT_REJECT_NONE;
    }
    else
        return false;

    // One exact kernel owns SURFACE. Other kernels receive only the transient
    // signed-clearance evidence of this validated four-stream endpoint.
    return true;
}

bool M8TryOccupiedExactForCarve(int3 globalCoord, out bool occupied)
{
    occupied = false;
    MerkabaM8Address address = MerkabaAddressOf(globalCoord);
    uint blockIndex;
    if (!M8FindBlock(address.blockCoord, blockIndex)) return true;
    uint chunkRef = _M8BlockChunkRefsRead[blockIndex *
        MERKABA_M8_BLOCK_CHUNK_COUNT + address.chunkLocal];
    if (chunkRef == MERKABA_REF_EMPTY) return true;
    if (chunkRef == MERKABA_REF_CLAIMED_NEW) return false;
    uint chunkIndex = chunkRef - 1u;
    if (chunkIndex >= MERKABA_M8_CHUNK_CAPACITY) return false;
    uint tileRef = _M8ChunkTileRefsRead[chunkIndex *
        MERKABA_M8_TILES_PER_CHUNK + address.tileLocal];
    if (tileRef == MERKABA_REF_EMPTY) return true;
    if (!M8IsHotRef(tileRef)) return false;
    uint physicalSlot = M8PhysicalSlot(tileRef);
    uint word = M8TileWordIndex(physicalSlot, address.kernelLocal >> 5u);
    occupied = (_M8TileBits[word].x &
        (1u << (address.kernelLocal & 31u))) != 0u;
    return true;
}

void UpdateOccupancy(uint physicalSlot, uint kernelLocal,
    inout KernelState state, int delta)
{
    bool occupiedBefore = (state.flags & MERKABA_OCCUPIED_FLAG) != 0u;
    state.evidence = clamp(state.evidence + delta,
        -MERKABA_EVIDENCE_CONFIDENCE_LIMIT,
        MERKABA_EVIDENCE_CONFIDENCE_LIMIT);
    bool occupiedAfter = occupiedBefore
        ? state.evidence > MERKABA_OCCUPIED_OFF
        : state.evidence >= MERKABA_OCCUPIED_ON;
    if (occupiedAfter) state.flags |= MERKABA_OCCUPIED_FLAG;
    else
    {
        state.flags &= ~MERKABA_OCCUPIED_FLAG;
        state.flags = M8ClearSurfacePlane(state.flags);
    }
    if (occupiedBefore == occupiedAfter) return;

    uint wordIndex = M8TileWordIndex(physicalSlot, kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    uint ignored;
    if (occupiedAfter)
    {
        InterlockedOr(_M8TileBits[wordIndex].x, bit, ignored);
        InterlockedAdd(_M8TileRecords[M8TileMetaIndex(physicalSlot)].z,
            1u, ignored);
        InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_KERNEL_COUNT], 1u,
            ignored);
    }
    else
    {
        InterlockedAnd(_M8TileBits[wordIndex].x, ~bit, ignored);
        InterlockedAdd(_M8TileRecords[M8TileMetaIndex(physicalSlot)].z,
            0xffffffffu, ignored);
        InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_KERNEL_COUNT],
            0xffffffffu, ignored);
    }
}

void EnsureCarveActive(uint physicalSlot, uint kernelLocal)
{
    uint wordIndex = M8TileWordIndex(physicalSlot, kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    uint previous;
    InterlockedOr(_M8TileBits[wordIndex].y, bit, previous);
    if ((previous & bit) == 0u)
    {
        uint ignored;
        InterlockedAdd(_M8TileRecords[M8TileMetaIndex(physicalSlot)].w,
            1u, ignored);
    }
}

void AppendSurfaceCandidate(int3 globalCoord, uint2 sourcePixel)
{
    uint index;
    InterlockedAdd(_M8Counters[M8_COUNTER_SURFACE_CANDIDATE_COUNT], 1u,
        index);
    if (index < MERKABA_M8_SURFACE_CANDIDATE_CAPACITY)
    {
        _M8SurfaceCandidates[index] = int4(globalCoord,
            MerkabaPackSurfaceMetadata(sourcePixel,
                MERKABA_SURFACE_ROUTE_UNROUTED,
                MERKABA_SURFACE_AUTHORITY_NONE, false, false, false));
        M8CounterIncrement(M8_COUNTER_VALID_SURFACE_CANDIDATES);
    }
    else
        _M8Counters[M8_COUNTER_SURFACE_CANDIDATE_OVERFLOW] = 1u;
}

groupshared uint gJointAcceptedRadial[3];

[numthreads(8, 8, 1)]
void DiscoverSurfaceCandidates(uint3 id : SV_DispatchThreadID,
    uint thread : SV_GroupIndex)
{
    if (thread < 3u) gJointAcceptedRadial[thread] = 0u;
    GroupMemoryBarrierWithGroupSync();

    if (id.x < gsDepthTexSize.x && id.y < gsDepthTexSize.y)
    {
        float3 worldSurface;
        int3 surfaceKernel;
        float3 surfaceNormal;
        float quality;
        float measurementConfidence;
        if (TrySurfaceMeasurement(id.xy, worldSurface, surfaceKernel,
                surfaceNormal, quality, measurementConfidence))
        {
            float radialPosition;
            if (TryMerkabaDepthRadialPosition(worldSurface, radialPosition))
            {
                uint radialBand = radialPosition < (1.0 / 3.0) ? 0u :
                    (radialPosition < (2.0 / 3.0) ? 1u : 2u);
                uint ignored;
                InterlockedAdd(gJointAcceptedRadial[radialBand], 1u,
                    ignored);
            }
            AppendSurfaceCandidate(surfaceKernel, id.xy);
        }
    }

    GroupMemoryBarrierWithGroupSync();
    if (thread < 3u && gJointAcceptedRadial[thread] != 0u)
    {
        uint ignored;
        InterlockedAdd(
            _M8Counters[M8_COUNTER_JOINT_ACCEPTED_CENTER + thread],
            gJointAcceptedRadial[thread], ignored);
    }
}

[numthreads(1, 1, 1)]
void PrepareResolveArgs(uint id : SV_DispatchThreadID)
{
    // CARVE discovery is attempt-local. Surface candidates remain latched for
    // the immutable observation until one fully-resident attempt commits it.
    _M8Counters[M8_COUNTER_CARVE_TILE_COUNT] = 0u;
    _M8Counters[M8_COUNTER_UNRESOLVED_CARVE_TILES] = 0u;
    uint count = min(_M8Counters[M8_COUNTER_SURFACE_CANDIDATE_COUNT],
        MERKABA_M8_SURFACE_CANDIDATE_CAPACITY);
    uint completed = _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED];
    uint failure = completed == 0u ? M8ObservationFailureReason() :
        _M8Counters[M8_COUNTER_OBSERVATION_FAILURE];
    _M8Counters[M8_COUNTER_OBSERVATION_FAILURE] = failure;
    _M8ObservationDispatchArgs[0] = completed == 0u && failure == 0u
        ? (count + 63u) / 64u : 0u;
    _M8ObservationDispatchArgs[1] = 1u;
    _M8ObservationDispatchArgs[2] = 1u;
}

bool RequestColdTile(uint tileRefIndex, uint chunkIndex, uint tileLocal,
    bool scanRequest)
{
    bool queued = M8QueueColdTileLoad(tileRefIndex, chunkIndex, tileLocal);
    if (scanRequest && queued)
        M8CounterIncrement(M8_COUNTER_SCAN_COLD_MISSES);
    return queued;
}

void RequestSurfaceOwnerLoad(int3 globalCoord)
{
    MerkabaM8Address address = MerkabaAddressOf(globalCoord);
    uint blockIndex;
    if (!M8FindBlock(address.blockCoord, blockIndex)) return;
    uint chunkRef = _M8BlockChunkRefsRead[blockIndex *
        MERKABA_M8_BLOCK_CHUNK_COUNT + address.chunkLocal];
    if (chunkRef == MERKABA_REF_EMPTY ||
        chunkRef == MERKABA_REF_CLAIMED_NEW) return;
    uint chunkIndex = chunkRef - 1u;
    uint tileRefIndex = chunkIndex * MERKABA_M8_TILES_PER_CHUNK +
        address.tileLocal;
    if (_M8ChunkTileRefs[tileRefIndex] == MERKABA_REF_COLD_ON_SSD)
        RequestColdTile(tileRefIndex, chunkIndex, address.tileLocal, true);
}

bool CandidateAt(uint id, out MerkabaM8Address address)
{
    uint count = min(_M8Counters[M8_COUNTER_SURFACE_CANDIDATE_COUNT],
        MERKABA_M8_SURFACE_CANDIDATE_CAPACITY);
    if (id >= count)
    {
        address = (MerkabaM8Address)0;
        return false;
    }
    int4 candidate = _M8SurfaceCandidatesRead[id];
    address = MerkabaAddressOf(candidate.xyz);
    return MerkabaSurfaceRoute(candidate.w) ==
        MERKABA_SURFACE_ROUTE_VALID;
}

[numthreads(64, 1, 1)]
void ResolveSurfaceBlocks(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] != 0u) return;
    uint count = min(_M8Counters[M8_COUNTER_SURFACE_CANDIDATE_COUNT],
        MERKABA_M8_SURFACE_CANDIDATE_CAPACITY);
    if (id >= count) return;
    int4 candidate = _M8SurfaceCandidates[id];
    int3 targetCoord;
    int metadata = RouteSurfaceCandidate(candidate.xyz,
        MerkabaSurfacePixel(candidate.w), targetCoord);
    _M8SurfaceCandidates[id] = int4(targetCoord, metadata);
    if (MerkabaSurfaceRoute(metadata) != MERKABA_SURFACE_ROUTE_VALID) return;
    MerkabaM8Address address = MerkabaAddressOf(targetCoord);
    uint blockIndex = 0u;
    uint failureReason = 0u;
    M8FindOrClaimBlock(address.blockCoord, blockIndex, failureReason);
    if (failureReason != 0u)
    {
        uint ignored;
        InterlockedOr(_M8Counters[M8_COUNTER_OBSERVATION_FAILURE],
            failureReason, ignored);
    }
}

[numthreads(64, 1, 1)]
void ResolveSurfaceChunks(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] != 0u) return;
    if (_M8Counters[M8_COUNTER_OBSERVATION_FAILURE] != 0u) return;
    MerkabaM8Address address = (MerkabaM8Address)0;
    if (!CandidateAt(id, address)) return;
    uint blockIndex = 0u;
    if (!M8FindBlock(address.blockCoord, blockIndex)) return;
    uint chunkIndex = 0u;
    uint failureReason = 0u;
    M8FindOrClaimChunk(blockIndex, address.chunkLocal, chunkIndex,
        failureReason);
    if (failureReason != 0u)
    {
        uint ignored;
        InterlockedOr(_M8Counters[M8_COUNTER_OBSERVATION_FAILURE],
            failureReason, ignored);
    }
}

[numthreads(64, 1, 1)]
void ResolveSurfaceTiles(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] != 0u) return;
    if (_M8Counters[M8_COUNTER_OBSERVATION_FAILURE] != 0u) return;
    MerkabaM8Address address = (MerkabaM8Address)0;
    if (!CandidateAt(id, address)) return;
    uint blockIndex = 0u;
    if (!M8FindBlock(address.blockCoord, blockIndex)) return;
    uint chunkRef = _M8BlockChunkRefsRead[blockIndex *
        MERKABA_M8_BLOCK_CHUNK_COUNT + address.chunkLocal];
    if (chunkRef == MERKABA_REF_EMPTY ||
        chunkRef >= MERKABA_REF_EVICTING) return;
    uint chunkIndex = chunkRef - 1u;
    uint tileRefIndex = chunkIndex * MERKABA_M8_TILES_PER_CHUNK +
        address.tileLocal;
    uint tileRef = _M8ChunkTileRefs[tileRefIndex];
    if (tileRef == MERKABA_REF_EMPTY)
    {
        uint prior;
        InterlockedCompareExchange(_M8ChunkTileRefs[tileRefIndex],
            MERKABA_REF_EMPTY, MERKABA_REF_CLAIMED_NEW, prior);
        if (prior == MERKABA_REF_EMPTY)
        {
            uint d1 = (address.tileLocal >> 3u) & 7u;
            uint d0 = address.tileLocal & 7u;
            uint ignored;
            InterlockedOr(
                _M8ChunkPresence[M8ChunkPresenceL0Index(chunkIndex)],
                1u << d1, ignored);
            InterlockedOr(
                _M8ChunkPresence[M8ChunkPresenceL1Index(chunkIndex, d1)],
                1u << d0, ignored);
            uint pendingIndex;
            InterlockedAdd(_M8Counters[M8_COUNTER_PENDING_NEW_TILE_COUNT],
                1u, pendingIndex);
            if (pendingIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                _M8PendingNewTileRefs[pendingIndex] = tileRefIndex;
            else
            {
                InterlockedCompareExchange(
                    _M8ChunkTileRefs[tileRefIndex],
                    MERKABA_REF_CLAIMED_NEW, MERKABA_REF_EMPTY, prior);
                InterlockedOr(_M8Counters[M8_COUNTER_OBSERVATION_FAILURE],
                    M8_OBSERVATION_FAILURE_PHYSICAL_CAPACITY, ignored);
            }
        }
        return;
    }
    if (tileRef == MERKABA_REF_COLD_ON_SSD)
    {
        RequestColdTile(tileRefIndex, chunkIndex, address.tileLocal, true);
        return;
    }
}

bool M8TrySurfaceTargetHot(int3 globalCoord, out uint physicalSlot,
    out uint kernelLocal)
{
    physicalSlot = 0u;
    kernelLocal = 0u;
    MerkabaM8Address address = MerkabaAddressOf(globalCoord);
    uint blockIndex = 0u;
    if (!M8FindBlock(address.blockCoord, blockIndex)) return false;
    uint chunkRef = _M8BlockChunkRefsRead[blockIndex *
        MERKABA_M8_BLOCK_CHUNK_COUNT + address.chunkLocal];
    if (chunkRef == MERKABA_REF_EMPTY ||
        chunkRef >= MERKABA_REF_EVICTING) return false;
    uint chunkIndex = chunkRef - 1u;
    uint tileRefIndex = chunkIndex * MERKABA_M8_TILES_PER_CHUNK +
        address.tileLocal;
    uint tileRef = _M8ChunkTileRefsRead[tileRefIndex];
    if (!M8IsHotRef(tileRef)) return false;
    physicalSlot = M8PhysicalSlot(tileRef);
    kernelLocal = address.kernelLocal;
    return true;
}

// InitializeSurfaceWinners can also queue a COLD load and therefore uses the
// writable tile-ref authority. Selection/queue use the read-only helper above.
bool M8TrySurfaceTargetHotForLoad(int3 globalCoord, out uint physicalSlot,
    out uint kernelLocal)
{
    physicalSlot = 0u;
    kernelLocal = 0u;
    MerkabaM8Address address = MerkabaAddressOf(globalCoord);
    uint blockIndex = 0u;
    if (!M8FindBlock(address.blockCoord, blockIndex)) return false;
    uint chunkRef = _M8BlockChunkRefsRead[blockIndex *
        MERKABA_M8_BLOCK_CHUNK_COUNT + address.chunkLocal];
    if (chunkRef == MERKABA_REF_EMPTY ||
        chunkRef >= MERKABA_REF_EVICTING) return false;
    uint chunkIndex = chunkRef - 1u;
    uint tileRef = _M8ChunkTileRefs[chunkIndex *
        MERKABA_M8_TILES_PER_CHUNK + address.tileLocal];
    if (!M8IsHotRef(tileRef)) return false;
    physicalSlot = M8PhysicalSlot(tileRef);
    kernelLocal = address.kernelLocal;
    return true;
}

void M8ResetSurfaceWinner(uint physicalSlot, uint kernelLocal)
{
    uint index = M8BankStateIndex(physicalSlot, kernelLocal);
    uint bank = physicalSlot >> MERKABA_M8_TILE_BANK_SHIFT;
    if (bank == 0u) _M8SurfaceWinnerRanks0[index] =
        MERKABA_SURFACE_WINNER_EMPTY;
    else if (bank == 1u) _M8SurfaceWinnerRanks1[index] =
        MERKABA_SURFACE_WINNER_EMPTY;
    else if (bank == 2u) _M8SurfaceWinnerRanks2[index] =
        MERKABA_SURFACE_WINNER_EMPTY;
    else _M8SurfaceWinnerRanks3[index] = MERKABA_SURFACE_WINNER_EMPTY;
}

void M8SelectSurfaceWinner(uint physicalSlot, uint kernelLocal, uint rank)
{
    uint index = M8BankStateIndex(physicalSlot, kernelLocal);
    uint bank = physicalSlot >> MERKABA_M8_TILE_BANK_SHIFT;
    uint ignored;
    if (bank == 0u) InterlockedMin(_M8SurfaceWinnerRanks0[index], rank,
        ignored);
    else if (bank == 1u) InterlockedMin(_M8SurfaceWinnerRanks1[index], rank,
        ignored);
    else if (bank == 2u) InterlockedMin(_M8SurfaceWinnerRanks2[index], rank,
        ignored);
    else InterlockedMin(_M8SurfaceWinnerRanks3[index], rank, ignored);
}

uint M8LoadSurfaceWinner(uint physicalSlot, uint kernelLocal)
{
    uint index = M8BankStateIndex(physicalSlot, kernelLocal);
    uint bank = physicalSlot >> MERKABA_M8_TILE_BANK_SHIFT;
    if (bank == 0u) return _M8SurfaceWinnerRanks0Read[index];
    if (bank == 1u) return _M8SurfaceWinnerRanks1Read[index];
    if (bank == 2u) return _M8SurfaceWinnerRanks2Read[index];
    return _M8SurfaceWinnerRanks3Read[index];
}

bool ObserveFrozenSurfaceWinner(uint physicalSlot, uint kernelLocal,
    out int kind, out float evidenceWeight, out int3 replacementCoord,
    out float radialPosition)
{
    kind = 0;
    evidenceWeight = 0.0;
    replacementCoord = 0;
    radialPosition = 2.0;
    uint winnerRank = M8LoadSurfaceWinner(physicalSlot, kernelLocal);
    if (winnerRank == MERKABA_SURFACE_WINNER_EMPTY) return false;

    // S4 stores the deterministic winning immutable joint source pixel in
    // the low 24 bits of the rank. A kernel committed as SURFACE by this
    // observation must be classified from that exact measurement, never by
    // reprojecting center(K) to a different joint pixel.
    uint2 sourcePixel = MerkabaSurfacePixel(asint(
        winnerRank & MERKABA_MEASUREMENT_PACKED_MASK));
    float3 worldSurface;
    int3 measuredKernel;
    float3 surfaceNormal;
    float quality;
    float measurementConfidence;
    if (!TrySurfaceMeasurement(sourcePixel, worldSurface, measuredKernel,
            surfaceNormal, quality, measurementConfidence))
        return false;
    replacementCoord = measuredKernel;
    MerkabaMutationAttention(worldSurface, surfaceNormal, radialPosition);
    kind = 2;
    return true;
}

bool M8TrySurfaceWinnerRank(int3 targetCoord, int packedMetadata,
    out uint rank)
{
    rank = MERKABA_SURFACE_WINNER_EMPTY;
    uint2 sourcePixel = MerkabaSurfacePixel(packedMetadata);
    float3 worldSurface;
    int3 measuredKernel;
    float3 surfaceNormal;
    float quality;
    float measurementConfidence;
    if (!TrySurfaceMeasurement(sourcePixel, worldSurface, measuredKernel,
            surfaceNormal, quality, measurementConfidence))
        return false;

    int authority = MerkabaSurfaceAuthority(packedMetadata);
    uint authorityRank = authority == MERKABA_SURFACE_AUTHORITY_REVISION ? 0u :
        (authority == MERKABA_SURFACE_AUTHORITY_SUPPORT ? 1u :
        (authority == MERKABA_SURFACE_AUTHORITY_DISCOVERY ? 2u : 3u));
    if (authorityRank == 3u) return false;

    float3 targetWorld = mul(_MerkabaGridToWorld,
        float4((float3)targetCoord * MERKABA_LATTICE_STEP, 1.0)).xyz;
    float residual = distance(worldSurface, targetWorld);
    uint residualRank = min(15u, (uint)floor(saturate(
        residual / MERKABA_HALF_SUPPORT) * 16.0));
    float3 eyeToSurface = worldSurface - gsDepthEyePos();
    float eyeDistance = length(eyeToSurface);
    float incidence = eyeDistance > 0.001
        ? saturate(-dot(eyeToSurface / eyeDistance, surfaceNormal)) : 0.0;
    uint incidenceRank = min(3u, (uint)floor((1.0 - incidence) * 4.0));
    rank = (authorityRank << 30u) | (residualRank << 26u) |
        (incidenceRank << 24u) |
        (asuint(packedMetadata) & MERKABA_MEASUREMENT_PACKED_MASK);
    return true;
}

void M8TouchSurfaceTarget(uint physicalSlot)
{
    _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].z =
        _M8Counters[M8_COUNTER_FRAME_EPOCH];
    uint touchedBefore;
    InterlockedCompareExchange(
        _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].x,
        0u, 1u, touchedBefore);
    if (touchedBefore == 0u)
    {
        uint touchedIndex;
        InterlockedAdd(_M8Counters[M8_COUNTER_TOUCHED_TILE_COUNT], 1u,
            touchedIndex);
        if (touchedIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
            _M8TouchedTileQueue[touchedIndex] = physicalSlot;
    }
}

[numthreads(64, 1, 1)]
void InitializeSurfaceWinners(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] != 0u) return;
    if (_M8Counters[M8_COUNTER_OBSERVATION_FAILURE] != 0u) return;
    uint candidateCount = min(
        _M8Counters[M8_COUNTER_SURFACE_CANDIDATE_COUNT],
        MERKABA_M8_SURFACE_CANDIDATE_CAPACITY);
    if (id >= candidateCount) return;
    int4 candidate = _M8SurfaceCandidatesRead[id];
    int route = MerkabaSurfaceRoute(candidate.w);
    if (route == MERKABA_SURFACE_ROUTE_UNRESOLVED)
    {
        RequestSurfaceOwnerLoad(candidate.xyz);
        M8CounterIncrement(M8_COUNTER_UNRESOLVED_SURFACE_TILES);
        return;
    }
    if (route != MERKABA_SURFACE_ROUTE_VALID) return;
    uint physicalSlot;
    uint kernelLocal;
    if (!M8TrySurfaceTargetHotForLoad(candidate.xyz, physicalSlot,
            kernelLocal))
    {
        RequestSurfaceOwnerLoad(candidate.xyz);
        M8CounterIncrement(M8_COUNTER_UNRESOLVED_SURFACE_TILES);
        return;
    }
    M8ResetSurfaceWinner(physicalSlot, kernelLocal);
}

[numthreads(64, 1, 1)]
void SelectSurfaceWinners(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] != 0u) return;
    if (_M8Counters[M8_COUNTER_OBSERVATION_FAILURE] != 0u) return;
    uint candidateCount = min(
        _M8Counters[M8_COUNTER_SURFACE_CANDIDATE_COUNT],
        MERKABA_M8_SURFACE_CANDIDATE_CAPACITY);
    if (id >= candidateCount) return;
    int4 candidate = _M8SurfaceCandidatesRead[id];
    if (MerkabaSurfaceRoute(candidate.w) != MERKABA_SURFACE_ROUTE_VALID)
        return;
    uint physicalSlot;
    uint kernelLocal;
    if (!M8TrySurfaceTargetHot(candidate.xyz, physicalSlot, kernelLocal))
        return;
    uint rank;
    if (!M8TrySurfaceWinnerRank(candidate.xyz, candidate.w, rank))
    {
        uint ignored;
        InterlockedOr(_M8Counters[M8_COUNTER_OBSERVATION_FAILURE],
            M8_OBSERVATION_FAILURE_MEASUREMENT_IDENTITY, ignored);
        return;
    }
    M8SelectSurfaceWinner(physicalSlot, kernelLocal, rank);
}

[numthreads(64, 1, 1)]
void QueueResolvedSurfaceCandidates(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] != 0u) return;
    if (_M8Counters[M8_COUNTER_OBSERVATION_FAILURE] != 0u) return;
    uint candidateCount = min(
        _M8Counters[M8_COUNTER_SURFACE_CANDIDATE_COUNT],
        MERKABA_M8_SURFACE_CANDIDATE_CAPACITY);
    if (id >= candidateCount) return;
    int4 candidate = _M8SurfaceCandidatesRead[id];
    if (MerkabaSurfaceRoute(candidate.w) != MERKABA_SURFACE_ROUTE_VALID)
        return;
    uint physicalSlot;
    uint kernelLocal;
    if (!M8TrySurfaceTargetHot(candidate.xyz, physicalSlot, kernelLocal))
    {
        M8CounterIncrement(M8_COUNTER_UNRESOLVED_SURFACE_TILES);
        return;
    }
    uint winner = M8LoadSurfaceWinner(physicalSlot, kernelLocal);
    if (winner == MERKABA_SURFACE_WINNER_EMPTY) return;
    uint winnerPixel = winner & MERKABA_MEASUREMENT_PACKED_MASK;
    uint candidatePixel = asuint(candidate.w) &
        MERKABA_MEASUREMENT_PACKED_MASK;
    if (candidatePixel != winnerPixel) return;

    uint wordIndex = M8TileWordIndex(physicalSlot, kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    uint previous;
    InterlockedOr(_M8TileBits[wordIndex].z, bit, previous);
    if ((previous & bit) != 0u) return;
    M8TouchSurfaceTarget(physicalSlot);

    int authority = MerkabaSurfaceAuthority(candidate.w);
    if (authority == MERKABA_SURFACE_AUTHORITY_DISCOVERY)
        M8CounterIncrement(M8_COUNTER_AUTHORITY_DISCOVERY);
    else if (authority == MERKABA_SURFACE_AUTHORITY_SUPPORT)
        M8CounterIncrement(M8_COUNTER_AUTHORITY_SUPPORT);
    else if (authority == MERKABA_SURFACE_AUTHORITY_REVISION)
        M8CounterIncrement(M8_COUNTER_AUTHORITY_REVISION);
    uint metadata = asuint(candidate.w);
    if ((metadata & MERKABA_SURFACE_FLAG_OFF_AXIS_BLOCKED) != 0u)
        M8CounterIncrement(M8_COUNTER_OFF_AXIS_MUTATION_BLOCKED);
    if ((metadata & MERKABA_SURFACE_FLAG_REPLACEMENT) != 0u)
        M8CounterIncrement(M8_COUNTER_SURFACE_REPLACEMENT);

    uint queueIndex;
    InterlockedAdd(_M8Counters[M8_COUNTER_SURFACE_QUEUE_COUNT], 1u,
        queueIndex);
    if (queueIndex < MERKABA_SURFACE_QUEUE_CAPACITY)
    {
        uint key = physicalSlot * MERKABA_M8_KERNELS_PER_TILE +
            kernelLocal;
        _M8SurfaceQueue[queueIndex] = uint2(key, metadata);
        M8CounterIncrement(M8_COUNTER_UNIQUE_SURFACE_KERNELS);
    }
    else
        _M8Counters[M8_COUNTER_SURFACE_CANDIDATE_OVERFLOW] = 1u;
}

[numthreads(64, 1, 1)]
void RetryPendingNewTiles(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] != 0u) return;
    if (_M8Counters[M8_COUNTER_OBSERVATION_FAILURE] != 0u) return;
    uint count = min(_M8Counters[M8_COUNTER_PENDING_NEW_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    if (id >= count) return;
    uint tileRefIndex = _M8PendingNewTileRefsRead[id];
    if (_M8ChunkTileRefsRead[tileRefIndex] != MERKABA_REF_CLAIMED_NEW) return;
    uint queueIndex;
    InterlockedAdd(_M8Counters[M8_COUNTER_NEW_TILE_QUEUE_COUNT], 1u,
        queueIndex);
    if (queueIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
        _M8ClaimQueue[MERKABA_M8_CLAIM_TILE_OFFSET + queueIndex] =
            uint2(tileRefIndex, 0u);
}

[numthreads(1, 1, 1)]
void PrepareIntegrateArgs(uint id : SV_DispatchThreadID)
{
    uint count = min(_M8Counters[M8_COUNTER_SURFACE_QUEUE_COUNT],
        MERKABA_SURFACE_QUEUE_CAPACITY);
    uint completed = _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED];
    uint failure = completed == 0u ? M8ObservationFailureReason() :
        _M8Counters[M8_COUNTER_OBSERVATION_FAILURE];
    _M8Counters[M8_COUNTER_OBSERVATION_FAILURE] = failure;
    _M8ObservationDispatchArgs[0] =
        _M8Counters[M8_COUNTER_UNRESOLVED_SURFACE_TILES] == 0u &&
        _M8Counters[M8_COUNTER_UNRESOLVED_CARVE_TILES] == 0u &&
        completed == 0u && failure == 0u
        ? (count + 63u) / 64u : 0u;
    _M8ObservationDispatchArgs[1] = 1u;
    _M8ObservationDispatchArgs[2] = 1u;
}

[numthreads(64, 1, 1)]
void IntegrateSurfaceCandidates(uint id : SV_DispatchThreadID)
{
    uint count = min(_M8Counters[M8_COUNTER_SURFACE_QUEUE_COUNT],
        MERKABA_SURFACE_QUEUE_CAPACITY);
    if (id >= count) return;
    uint2 queued = _M8SurfaceQueueRead[id];
    uint key = queued.x;
    uint physicalSlot = key / MERKABA_M8_KERNELS_PER_TILE;
    uint kernelLocal = key % MERKABA_M8_KERNELS_PER_TILE;
    uint2 sourcePixel = MerkabaSurfacePixel(asint(queued.y));
    float3 worldSurface;
    int3 measuredKernel;
    float3 surfaceNormal;
    float quality;
    float measurementConfidence;
    if (!TrySurfaceMeasurement(sourcePixel, worldSurface, measuredKernel,
            surfaceNormal, quality, measurementConfidence))
        return;

    int3 targetKernel = M8GlobalKernelCoord(physicalSlot, kernelLocal);
    float3 targetWorld = mul(_MerkabaGridToWorld,
        float4((float3)targetKernel * MERKABA_LATTICE_STEP, 1.0)).xyz;
    if (_M8FineRefineActive != 0u && !M8FineContains(targetWorld)) return;

    KernelState state = M8LoadKernelState(physicalSlot, kernelLocal);
    int evidenceBefore = state.evidence;
    bool hadMeasuredPlaneBefore = M8HasSurfacePlane(state.flags);
    int authority = MerkabaSurfaceAuthority(asint(queued.y));
    bool strictMeasurement = (queued.y & MERKABA_SURFACE_FLAG_STRICT) != 0u;
    if (!strictMeasurement && authority !=
        MERKABA_SURFACE_AUTHORITY_DISCOVERY) return;
    float fineWeight = _M8FineRefineActive != 0u
        ? M8FineWeight(targetWorld) : 1.0;
    if (fineWeight <= 0.0) return;
    int surfaceDelta = max(1, (int)round(
        quality * quality * fineWeight * MERKABA_SURFACE_SCALE));
    if (!strictMeasurement)
        surfaceDelta = max(surfaceDelta,
            MERKABA_OCCUPIED_ON - max(state.evidence, 0));
    UpdateOccupancy(physicalSlot, kernelLocal, state, surfaceDelta);
    if ((state.flags & MERKABA_OCCUPIED_FLAG) != 0u)
    {
        float3 worldNormal = normalize(surfaceNormal);
        float3 newNormalGrid = normalize(mul(
            (float3x3)_MerkabaWorldToGrid, surfaceNormal));
        float newOffset = dot(worldSurface - targetWorld, worldNormal);
        bool storeExactPlane = authority !=
            MERKABA_SURFACE_AUTHORITY_SUPPORT || !hadMeasuredPlaneBefore;
        if (storeExactPlane)
            state.flags = M8SetSurfacePlane(state.flags, newNormalGrid,
                newOffset);
        else
        {
            float3 oldNormalGrid;
            float oldOffset;
            M8DecodeSurfacePlane(state.flags, oldNormalGrid, oldOffset);
            int3 oldStep = MerkabaNearestGridNormalStep(oldNormalGrid);
            int3 newStep = MerkabaNearestGridNormalStep(newNormalGrid);
            bool sameM8Sheet = all(oldStep == newStep) ||
                all(oldStep == -newStep);
            if (sameM8Sheet)
            {
                if (dot(oldNormalGrid, newNormalGrid) < 0.0)
                {
                    newNormalGrid = -newNormalGrid;
                    newOffset = -newOffset;
                }
                float oldWeight = max(1.0, (float)max(evidenceBefore, 0));
                float newWeight = (float)surfaceDelta;
                float3 weightedNormal = oldNormalGrid * oldWeight +
                    newNormalGrid * newWeight;
                float weightedOffset = oldOffset * oldWeight +
                    newOffset * newWeight;
                float normalLength = length(weightedNormal);
                if (normalLength > 1.0e-6)
                {
                    float3 fusedNormalGrid = weightedNormal / normalLength;
                    float fusedOffset = weightedOffset / normalLength;
                    if (abs(fusedOffset) <=
                        MERKABA_SURFACE_PLANE_OFFSET_RANGE + 1.0e-6)
                        state.flags = M8SetSurfacePlane(state.flags,
                            fusedNormalGrid, fusedOffset);
                    else
                        state.flags = M8SetSurfacePlane(state.flags,
                            newNormalGrid, newOffset);
                }
                else
                    state.flags = M8SetSurfacePlane(state.flags,
                        newNormalGrid, newOffset);
            }
        }
    }
    state.flags |= MERKABA_NEEDS_CARVE_FLAG;
    float2 leftUv = MerkabaProjectCameraUv(0u, worldSurface);
    float2 rightUv = MerkabaProjectCameraUv(1u, worldSurface);
    float3 observedRgb = (MerkabaSampleCameraRgb(0u, leftUv) +
        MerkabaSampleCameraRgb(1u, rightUv)) * 0.5;
    AccumulateColor(state, observedRgb,
        quality * measurementConfidence * fineWeight);
    M8StoreKernelState(physicalSlot, kernelLocal, state);
    EnsureCarveActive(physicalSlot, kernelLocal);
    _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].y = 1u;
}

uint M8ScanChildMask(int3 parentMin, int parentSpan)
{
    uint support = MerkabaM8DistanceChildMask(parentMin, parentSpan,
        _MerkabaMaxUpdateDistance, _M8ScanCameraWorld, _MerkabaGridToWorld,
        _MerkabaWorldToGrid, MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
    [unroll]
    for (uint plane = 0u; plane < 8u; plane++)
        support &= MerkabaM8KernelPlaneChildMask(parentMin, parentSpan,
            _M8ScanCoveragePlanes[plane]);
    return support;
}

groupshared uint gScanBlockRef;
groupshared int3 gScanBlockMin;
groupshared uint gScanSupport4;
groupshared uint gScanSupport3[8];

[numthreads(64, 1, 1)]
void QueryCarveTiles(uint3 groupId : SV_GroupID, uint thread : SV_GroupIndex)
{
    uint linearBlockIndex = groupId.x;
    if (thread == 0u)
    {
        gScanBlockRef = 0u;
        gScanSupport4 = 0u;
        uint side = (uint)_M8ScanBlockSide;
        bool observationReady =
            _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] == 0u &&
            _M8Counters[M8_COUNTER_OBSERVATION_FAILURE] == 0u &&
            _M8Counters[M8_COUNTER_UNRESOLVED_SURFACE_TILES] == 0u;
        if (observationReady && linearBlockIndex < side * side * side)
        {
            int3 offset;
            offset.x = (int)(linearBlockIndex % side) - _M8ScanBlockRadius;
            offset.y = (int)((linearBlockIndex / side) % side) -
                _M8ScanBlockRadius;
            offset.z = (int)(linearBlockIndex / (side * side)) -
                _M8ScanBlockRadius;
            int3 blockCoord = _M8ScanCenterBlock + offset;
            gScanBlockMin = blockCoord * MERKABA_M8_BLOCK_KERNEL_SPAN;
            gScanSupport4 = M8ScanChildMask(gScanBlockMin, 256);
            if (gScanSupport4 != 0u)
            {
                uint blockIndex = 0u;
                if (M8FindBlock(blockCoord, blockIndex))
                {
                    gScanBlockRef = blockIndex + 1u;
                    M8CounterIncrement(M8_COUNTER_CARVE_QUERY_BLOCKS);
                }
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (thread < 8u)
    {
        uint d4ForMask = thread;
        gScanSupport3[d4ForMask] = 0u;
        if (gScanBlockRef != 0u)
        {
            uint maskBlockIndex = gScanBlockRef - 1u;
            if (((_M8BlockPresenceL0Read[maskBlockIndex] & gScanSupport4) &
                (1u << d4ForMask)) != 0u)
            {
                int3 min4ForMask = gScanBlockMin +
                    MerkabaM8OctantOffset(d4ForMask, 128);
                gScanSupport3[d4ForMask] = M8ScanChildMask(min4ForMask, 128);
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gScanBlockRef == 0u) return;

    uint blockIndex = gScanBlockRef - 1u;
    int3 blockMin = gScanBlockMin;
    uint d4 = thread >> 3u;
    uint d3 = thread & 7u;
    if (((gScanSupport4 >> d4) & 1u) == 0u ||
        (((_M8BlockPresenceL1Read[blockIndex * 8u + d4] &
        gScanSupport3[d4]) >> d3) & 1u) == 0u) return;

    int3 min4 = blockMin + MerkabaM8OctantOffset(d4, 128);
    int3 min3 = min4 + MerkabaM8OctantOffset(d3, 64);
    uint scan2 = M8ScanChildMask(min3, 64);
    uint support2 = (_M8BlockPresenceL2Read[blockIndex * 64u +
        d4 * 8u + d3] & 255u) & scan2;
    while (support2 != 0u)
    {
        uint d2 = (uint)firstbitlow(support2);
        support2 &= support2 - 1u;
        uint chunkLocal = (d4 << 6u) | (d3 << 3u) | d2;
        uint chunkRef = _M8BlockChunkRefsRead[blockIndex * 512u + chunkLocal];
        if (chunkRef == 0u || chunkRef >= MERKABA_REF_EVICTING) continue;
        uint chunkIndex = chunkRef - 1u;
        int3 min2 = min3 + MerkabaM8OctantOffset(d2, 32);
        uint scan1 = M8ScanChildMask(min2, 32);
        uint support1 =
            (_M8ChunkPresenceRead[M8ChunkPresenceL0Index(chunkIndex)] &
            255u) & scan1;
        while (support1 != 0u)
        {
            uint d1 = (uint)firstbitlow(support1);
            support1 &= support1 - 1u;
            int3 min1 = min2 + MerkabaM8OctantOffset(d1, 16);
            uint scan0 = M8ScanChildMask(min1, 16);
            uint support0 =
                (_M8ChunkPresenceRead[
                    M8ChunkPresenceL1Index(chunkIndex, d1)] & 255u) & scan0;
            while (support0 != 0u)
            {
                uint d0 = (uint)firstbitlow(support0);
                support0 &= support0 - 1u;
                uint tileLocal = (d1 << 3u) | d0;
                uint tileRefIndex = chunkIndex * 64u + tileLocal;
                uint tileRef = _M8ChunkTileRefs[tileRefIndex];
                if (tileRef == MERKABA_REF_COLD_ON_SSD)
                {
                    if (RequestColdTile(tileRefIndex, chunkIndex, tileLocal,
                        true))
                        M8CounterIncrement(
                            M8_COUNTER_COLD_CARVE_TILES_REQUESTED);
                    M8CounterIncrement(
                        M8_COUNTER_UNRESOLVED_CARVE_TILES);
                    continue;
                }
                if (!M8IsHotRef(tileRef))
                {
                    M8CounterIncrement(
                        M8_COUNTER_UNRESOLVED_CARVE_TILES);
                    continue;
                }
                uint physicalSlot = M8PhysicalSlot(tileRef);
                if (_M8TileRecords[M8TileMetaIndex(physicalSlot)].w == 0u)
                    continue;
                _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].z =
                    _M8Counters[M8_COUNTER_FRAME_EPOCH];
                uint queueIndex;
                InterlockedAdd(_M8Counters[M8_COUNTER_CARVE_TILE_COUNT],
                    1u, queueIndex);
                if (queueIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                    _M8CarveTiles[queueIndex] = physicalSlot;
                M8CounterIncrement(M8_COUNTER_CARVE_QUERY_TILES);
            }
        }
    }
}

[numthreads(1, 1, 1)]
void PrepareCarveArgs(uint id : SV_DispatchThreadID)
{
    uint count = min(_M8Counters[M8_COUNTER_CARVE_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    _M8CarveDispatchArgs[0] =
        _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] == 0u &&
        _M8Counters[M8_COUNTER_UNRESOLVED_SURFACE_TILES] == 0u &&
        _M8Counters[M8_COUNTER_UNRESOLVED_CARVE_TILES] == 0u &&
        _M8Counters[M8_COUNTER_OBSERVATION_FAILURE] == 0u
        ? count : 0u;
    _M8CarveDispatchArgs[1] = 1u;
    _M8CarveDispatchArgs[2] = 1u;
}

groupshared uint gCarveWords[16];
groupshared uint gCarveStats[23];

bool RetireCarveActive(uint physicalSlot, uint kernelLocal)
{
    uint wordIndex = M8TileWordIndex(physicalSlot, kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    uint previous;
    InterlockedAnd(_M8TileBits[wordIndex].y, ~bit, previous);
    if ((previous & bit) == 0u) return false;
    uint ignored;
    InterlockedAdd(_M8TileRecords[M8TileMetaIndex(physicalSlot)].w,
        0xffffffffu, ignored);
    return true;
}

void FlushCarveStat(uint counterIndex, uint value)
{
    if (value == 0u) return;
    uint ignored;
    InterlockedAdd(_M8Counters[counterIndex], value, ignored);
}

void RecordCheapCarveResult(uint gate, bool surfaceEndpoint)
{
    uint ignored;
    if (gate == MERKABA_CHEAP_RAY_INVALID_PROJECTION_DEPTH)
        InterlockedAdd(gCarveStats[15], 1u, ignored);
    else if (gate == MERKABA_CHEAP_RAY_NOT_IN_FRONT)
        InterlockedAdd(gCarveStats[16], 1u, ignored);
    else if (gate == MERKABA_CHEAP_RAY_OUTSIDE_TUBE)
        InterlockedAdd(gCarveStats[17], 1u, ignored);
    else if (gate == MERKABA_CHEAP_RAY_OUTSIDE_OUTER_ATTENTION)
        InterlockedAdd(gCarveStats[18], 1u, ignored);
    if (surfaceEndpoint)
        InterlockedAdd(gCarveStats[19], 1u, ignored);
}

void IntegrateCarveKernel(uint physicalSlot, uint kernelLocal)
{
    uint wordIndex = M8TileWordIndex(physicalSlot, kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    uint ignored;
    InterlockedAdd(gCarveStats[0], 1u, ignored);
    int3 globalCoord = M8GlobalKernelCoord(physicalSlot, kernelLocal);
    float3 worldPosition = mul(_MerkabaGridToWorld,
        float4((float3)globalCoord * MERKABA_LATTICE_STEP, 1.0)).xyz;
    if (_M8FineRefineActive != 0u && !M8FineContains(worldPosition)) return;

    KernelState state = M8LoadKernelState(physicalSlot, kernelLocal);
    bool occupiedBefore = (state.flags & MERKABA_OCCUPIED_FLAG) != 0u;
    bool alreadyStrongFree = !occupiedBefore &&
        state.evidence <= MERKABA_EXPORT_KNOWN_FREE;
    if (alreadyStrongFree)
    {
        if ((state.flags & MERKABA_NEEDS_CARVE_FLAG) != 0u)
        {
            state.flags &= ~MERKABA_NEEDS_CARVE_FLAG;
            M8StoreKernelState(physicalSlot, kernelLocal, state);
            _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].y = 1u;
        }
        if (RetireCarveActive(physicalSlot, kernelLocal))
            InterlockedAdd(gCarveStats[6], 1u, ignored);
        return;
    }

    int observationKind = 0;
    float evidenceWeight = 0.0;
    int3 replacementCoord = 0;
    float radialPosition = 2.0;
    bool currentSurfaceCandidate = (_M8TileBits[wordIndex].z & bit) != 0u;
    if (currentSurfaceCandidate)
    {
        ObserveFrozenSurfaceWinner(physicalSlot, kernelLocal,
            observationKind, evidenceWeight, replacementCoord,
            radialPosition);
    }
    else
    {
        uint2 pixel;
        float3 worldSurface;
        int3 surfaceKernel;
        bool surfaceEndpoint;
        uint gate = CheapFrozenRayGate(globalCoord, worldPosition, pixel,
            worldSurface, surfaceKernel, radialPosition, surfaceEndpoint);
        RecordCheapCarveResult(gate, surfaceEndpoint);
        if (gate == MERKABA_CHEAP_RAY_CANDIDATE)
        {
            InterlockedAdd(gCarveStats[20], 1u, ignored);
            uint rejection;
            bool classified = ExactFrozenRayClassify(globalCoord,
                worldPosition, pixel,
                worldSurface, surfaceKernel, radialPosition,
                observationKind, evidenceWeight, replacementCoord,
                rejection);
            if (!classified)
            {
                InterlockedAdd(gCarveStats[3], 1u, ignored);
                if (rejection == MERKABA_EXACT_REJECT_INCIDENCE)
                    InterlockedAdd(gCarveStats[21], 1u, ignored);
                else if (rejection == MERKABA_EXACT_REJECT_DILATION)
                    InterlockedAdd(gCarveStats[22], 1u, ignored);
            }
        }
    }

    if (observationKind == 1)
    {
        if (_M8FineRefineActive != 0u)
            evidenceWeight *= M8FineWeight(worldPosition);
        InterlockedAdd(gCarveStats[1], 1u, ignored);
        uint radialBin = min(7u,
            (uint)floor(saturate(radialPosition) * 8.0));
        InterlockedAdd(gCarveStats[7u + radialBin], 1u, ignored);
        int evidenceBefore = state.evidence;
        int decrement = max(1, (int)round(evidenceWeight *
            MERKABA_FREE_SCALE));
        if (occupiedBefore && evidenceBefore - decrement <=
            MERKABA_OCCUPIED_OFF)
        {
            bool replacementOccupied = false;
            bool replacementResolved = M8TryOccupiedExactForCarve(
                replacementCoord, replacementOccupied);
            if (!replacementResolved || !replacementOccupied)
                decrement = min(decrement, max(0,
                    evidenceBefore - (MERKABA_OCCUPIED_OFF + 1)));
        }
        if (decrement > 0)
            UpdateOccupancy(physicalSlot, kernelLocal, state, -decrement);
        bool occupiedAfter = (state.flags & MERKABA_OCCUPIED_FLAG) != 0u;
        if (state.evidence < evidenceBefore)
            InterlockedAdd(gCarveStats[4], 1u, ignored);
        if (occupiedBefore && !occupiedAfter)
            InterlockedAdd(gCarveStats[5], 1u, ignored);
        if (!occupiedAfter && state.evidence <= MERKABA_EXPORT_KNOWN_FREE)
        {
            state.flags &= ~MERKABA_NEEDS_CARVE_FLAG;
            if (RetireCarveActive(physicalSlot, kernelLocal))
                InterlockedAdd(gCarveStats[6], 1u, ignored);
        }
        if (state.evidence != evidenceBefore)
        {
            M8StoreKernelState(physicalSlot, kernelLocal, state);
            _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].y = 1u;
        }
    }
    else if (observationKind == 2)
    {
        InterlockedAdd(gCarveStats[2], 1u, ignored);
        if ((state.flags & MERKABA_NEEDS_CARVE_FLAG) == 0u)
        {
            state.flags |= MERKABA_NEEDS_CARVE_FLAG;
            M8StoreKernelState(physicalSlot, kernelLocal, state);
            _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].y = 1u;
        }
    }
}

[numthreads(128, 1, 1)]
void IntegrateCarveTiles(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint physicalSlot = _M8CarveTilesRead[groupId.x];
    if (thread < 16u)
    {
        uint wordIndex = M8TileWordIndex(physicalSlot, thread);
        gCarveWords[thread] = _M8TileBits[wordIndex].y;
    }
    if (thread < 23u) gCarveStats[thread] = 0u;
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint batch = 0u; batch < 4u; batch++)
    {
        uint kernelLocal = thread + batch * 128u;
        uint word = gCarveWords[kernelLocal >> 5u];
        uint bit = 1u << (kernelLocal & 31u);
        if ((word & bit) != 0u)
            IntegrateCarveKernel(physicalSlot, kernelLocal);
    }

    GroupMemoryBarrierWithGroupSync();
    if (thread == 0u)
    {
        FlushCarveStat(M8_COUNTER_CARVE_ACTIVE_KERNELS, gCarveStats[0]);
        FlushCarveStat(M8_COUNTER_CARVE_CLASSIFIED_FREE, gCarveStats[1]);
        FlushCarveStat(M8_COUNTER_CARVE_CLASSIFIED_SURFACE, gCarveStats[2]);
        FlushCarveStat(M8_COUNTER_CARVE_CLASSIFIED_UNKNOWN, gCarveStats[3]);
        FlushCarveStat(M8_COUNTER_CARVE_EVIDENCE_DECREMENTS, gCarveStats[4]);
        FlushCarveStat(M8_COUNTER_CARVE_OCCUPIED_TO_FREE, gCarveStats[5]);
        FlushCarveStat(M8_COUNTER_CARVE_BITS_RETIRED, gCarveStats[6]);
        [unroll]
        for (uint radialBin = 0u; radialBin < 8u; radialBin++)
            FlushCarveStat(M8_COUNTER_CARVE_FREE_RADIAL_0 + radialBin,
                gCarveStats[7u + radialBin]);
        FlushCarveStat(M8_COUNTER_CARVE_CHEAP_INVALID_PROJECTION_DEPTH,
            gCarveStats[15]);
        FlushCarveStat(M8_COUNTER_CARVE_CHEAP_NOT_IN_FRONT,
            gCarveStats[16]);
        FlushCarveStat(M8_COUNTER_CARVE_CHEAP_OUTSIDE_RAY_TUBE,
            gCarveStats[17]);
        FlushCarveStat(M8_COUNTER_CARVE_CHEAP_OUTSIDE_OUTER_ATTENTION,
            gCarveStats[18]);
        FlushCarveStat(M8_COUNTER_CARVE_CHEAP_SURFACE_ENDPOINT,
            gCarveStats[19]);
        FlushCarveStat(M8_COUNTER_CARVE_EXACT_EVALUATIONS,
            gCarveStats[20]);
        FlushCarveStat(M8_COUNTER_CARVE_EXACT_INCIDENCE_REJECT,
            gCarveStats[21]);
        FlushCarveStat(M8_COUNTER_CARVE_EXACT_DILATION_REJECT,
            gCarveStats[22]);
    }
}

[numthreads(1, 1, 1)]
void FinalizeObservation(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] == 0u)
    {
        uint failure = M8ObservationFailureReason();
        _M8Counters[M8_COUNTER_OBSERVATION_FAILURE] = failure;
        if (failure != 0u)
        {
            _M8Counters[M8_COUNTER_FAILED_OBSERVATIONS] += 1u;
            _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] = 1u;
        }
        else if (_M8Counters[M8_COUNTER_UNRESOLVED_SURFACE_TILES] == 0u &&
            _M8Counters[M8_COUNTER_UNRESOLVED_CARVE_TILES] == 0u)
            _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] = 1u;
    }
    uint completed = _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED];
    uint failure = _M8Counters[M8_COUNTER_OBSERVATION_FAILURE];
    uint touchedCount = completed != 0u
        ? min(_M8Counters[M8_COUNTER_TOUCHED_TILE_COUNT],
            MERKABA_M8_PHYSICAL_TILE_CAPACITY) : 0u;
    uint pendingCount = completed != 0u && failure != 0u
        ? min(_M8Counters[M8_COUNTER_PENDING_NEW_TILE_COUNT],
            MERKABA_M8_PHYSICAL_TILE_CAPACITY) : 0u;
    bool readoutChanged = completed != 0u && failure == 0u &&
        (_M8Counters[M8_COUNTER_SURFACE_QUEUE_COUNT] != 0u ||
         _M8Counters[M8_COUNTER_CARVE_OCCUPIED_TO_FREE] != 0u);
    _M8Counters[M8_COUNTER_CLEANUP_TOUCHED_COUNT] = touchedCount;
    _M8Counters[M8_COUNTER_CLEANUP_PENDING_COUNT] = pendingCount;
    _M8ObservationDispatchArgs[0] = max(touchedCount, pendingCount);
    _M8ObservationDispatchArgs[1] = 1u;
    _M8ObservationDispatchArgs[2] = 1u;
    _M8AttemptCompletion[0] = uint4(_M8AttemptToken,
        completed != 0u ?
            _M8Counters[M8_COUNTER_OBSERVATION_TOKEN] : 0u,
        failure | (readoutChanged ?
            M8_ATTEMPT_COMPLETION_READOUT_CHANGED : 0u),
        _M8Counters[M8_COUNTER_RESIDENCY_EPOCH]);
}

[numthreads(1, 1, 1)]
void ResetFineErase(uint id : SV_DispatchThreadID)
{
    _M8Counters[M8_COUNTER_CARVE_TILE_COUNT] = 0u;
    _M8Counters[M8_COUNTER_UNRESOLVED_CARVE_TILES] = 0u;
    _M8CarveDispatchArgs[0] = 0u;
    _M8CarveDispatchArgs[1] = 1u;
    _M8CarveDispatchArgs[2] = 1u;
}

uint M8FineEraseChildMask(int3 parentMin, int parentSpan)
{
    return MerkabaM8DistanceChildMask(parentMin, parentSpan,
        sqrt(max(0.0, _M8FineToolDepthSquared)), _M8FineEyeOrigin,
        _MerkabaGridToWorld, _MerkabaWorldToGrid, MERKABA_LATTICE_STEP,
        MERKABA_HALF_SUPPORT);
}

groupshared uint gFineEraseBlockRef;
groupshared int3 gFineEraseBlockMin;
groupshared uint gFineEraseSupport4;
groupshared uint gFineEraseSupport3[8];

[numthreads(64, 1, 1)]
void QueryFineEraseTiles(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint linearBlockIndex = groupId.x;
    if (thread == 0u)
    {
        gFineEraseBlockRef = 0u;
        gFineEraseSupport4 = 0u;
        uint side = (uint)_M8ScanBlockSide;
        if (linearBlockIndex < side * side * side)
        {
            int3 offset;
            offset.x = (int)(linearBlockIndex % side) - _M8ScanBlockRadius;
            offset.y = (int)((linearBlockIndex / side) % side) -
                _M8ScanBlockRadius;
            offset.z = (int)(linearBlockIndex / (side * side)) -
                _M8ScanBlockRadius;
            int3 blockCoord = _M8ScanCenterBlock + offset;
            gFineEraseBlockMin = blockCoord *
                MERKABA_M8_BLOCK_KERNEL_SPAN;
            gFineEraseSupport4 = M8FineEraseChildMask(
                gFineEraseBlockMin, 256);
            if (gFineEraseSupport4 != 0u)
            {
                uint blockIndex;
                if (M8FindBlock(blockCoord, blockIndex))
                    gFineEraseBlockRef = blockIndex + 1u;
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (thread < 8u)
    {
        gFineEraseSupport3[thread] = 0u;
        if (gFineEraseBlockRef != 0u &&
            ((_M8BlockPresenceL0Read[gFineEraseBlockRef - 1u] &
              gFineEraseSupport4) & (1u << thread)) != 0u)
        {
            int3 childMin = gFineEraseBlockMin +
                MerkabaM8OctantOffset(thread, 128);
            gFineEraseSupport3[thread] =
                M8FineEraseChildMask(childMin, 128);
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gFineEraseBlockRef == 0u) return;

    uint blockIndex = gFineEraseBlockRef - 1u;
    uint d4 = thread >> 3u;
    uint d3 = thread & 7u;
    if (((gFineEraseSupport4 >> d4) & 1u) == 0u ||
        (((_M8BlockPresenceL1Read[blockIndex * 8u + d4] &
           gFineEraseSupport3[d4]) >> d3) & 1u) == 0u) return;

    int3 min4 = gFineEraseBlockMin + MerkabaM8OctantOffset(d4, 128);
    int3 min3 = min4 + MerkabaM8OctantOffset(d3, 64);
    uint support2 = (_M8BlockPresenceL2Read[blockIndex * 64u +
        d4 * 8u + d3] & 255u) & M8FineEraseChildMask(min3, 64);
    while (support2 != 0u)
    {
        uint d2 = (uint)firstbitlow(support2);
        support2 &= support2 - 1u;
        uint chunkLocal = (d4 << 6u) | (d3 << 3u) | d2;
        uint chunkRef = _M8BlockChunkRefsRead[blockIndex * 512u +
            chunkLocal];
        if (chunkRef == MERKABA_REF_EMPTY) continue;
        if (chunkRef >= MERKABA_REF_EVICTING)
        {
            M8CounterIncrement(M8_COUNTER_UNRESOLVED_CARVE_TILES);
            continue;
        }
        uint chunkIndex = chunkRef - 1u;
        int3 min2 = min3 + MerkabaM8OctantOffset(d2, 32);
        uint support1 = (_M8ChunkPresenceRead[
            M8ChunkPresenceL0Index(chunkIndex)] & 255u) &
            M8FineEraseChildMask(min2, 32);
        while (support1 != 0u)
        {
            uint d1 = (uint)firstbitlow(support1);
            support1 &= support1 - 1u;
            int3 min1 = min2 + MerkabaM8OctantOffset(d1, 16);
            uint support0 = (_M8ChunkPresenceRead[
                M8ChunkPresenceL1Index(chunkIndex, d1)] & 255u) &
                M8FineEraseChildMask(min1, 16);
            while (support0 != 0u)
            {
                uint d0 = (uint)firstbitlow(support0);
                support0 &= support0 - 1u;
                uint tileLocal = (d1 << 3u) | d0;
                uint tileRefIndex = chunkIndex * 64u + tileLocal;
                uint tileRef = _M8ChunkTileRefs[tileRefIndex];
                if (tileRef == MERKABA_REF_EMPTY) continue;
                if (tileRef == MERKABA_REF_COLD_ON_SSD)
                {
                    RequestColdTile(tileRefIndex, chunkIndex, tileLocal,
                        false);
                    M8CounterIncrement(
                        M8_COUNTER_UNRESOLVED_CARVE_TILES);
                    continue;
                }
                if (!M8IsHotRef(tileRef))
                {
                    M8CounterIncrement(
                        M8_COUNTER_UNRESOLVED_CARVE_TILES);
                    continue;
                }
                uint queueIndex;
                InterlockedAdd(_M8Counters[M8_COUNTER_CARVE_TILE_COUNT],
                    1u, queueIndex);
                if (queueIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                    _M8CarveTiles[queueIndex] = M8PhysicalSlot(tileRef);
            }
        }
    }
}

[numthreads(1, 1, 1)]
void PrepareFineEraseArgs(uint id : SV_DispatchThreadID)
{
    _M8CarveDispatchArgs[0] =
        _M8Counters[M8_COUNTER_UNRESOLVED_CARVE_TILES] == 0u
        ? min(_M8Counters[M8_COUNTER_CARVE_TILE_COUNT],
            MERKABA_M8_PHYSICAL_TILE_CAPACITY)
        : 0u;
    _M8CarveDispatchArgs[1] = 1u;
    _M8CarveDispatchArgs[2] = 1u;
}

void M8EraseFineKernel(uint physicalSlot, uint kernelLocal)
{
    int3 globalCoord = M8GlobalKernelCoord(physicalSlot, kernelLocal);
    uint wordIndex = M8TileWordIndex(physicalSlot, kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    uint occupiedWord = _M8TileBits[wordIndex].x;
    float3 gridPosition = (float3)globalCoord * MERKABA_LATTICE_STEP;
    float3 worldPosition = mul(_MerkabaGridToWorld,
        float4(gridPosition, 1.0)).xyz;
    KernelState state;
    bool stateLoaded = false;
    if ((occupiedWord & bit) != 0u)
    {
        state = M8LoadKernelState(physicalSlot, kernelLocal);
        stateLoaded = true;
        if (M8HasSurfacePlane(state.flags))
        {
            float3 normalGrid;
            float signedOffset;
            M8DecodeSurfacePlane(state.flags, normalGrid, signedOffset);
            worldPosition = mul(_MerkabaGridToWorld,
                float4(gridPosition + normalGrid * signedOffset, 1.0)).xyz;
        }
    }
    if (!M8FineContains(worldPosition)) return;

    uint previousOccupied;
    uint previousCarve;
    uint previousCandidate;
    InterlockedAnd(_M8TileBits[wordIndex].x, ~bit, previousOccupied);
    InterlockedAnd(_M8TileBits[wordIndex].y, ~bit, previousCarve);
    InterlockedAnd(_M8TileBits[wordIndex].z, ~bit, previousCandidate);

    if (!stateLoaded)
        state = M8LoadKernelState(physicalSlot, kernelLocal);
    bool stateChanged = state.evidence != 0 || state.packedColor != 0u ||
        state.colorConfidence != 0u || state.flags != 0u;
    bool occupied = (previousOccupied & bit) != 0u;
    bool carveActive = (previousCarve & bit) != 0u;
    if (occupied)
    {
        uint ignored;
        InterlockedAdd(_M8TileRecords[M8TileMetaIndex(physicalSlot)].z,
            0xffffffffu, ignored);
        InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_KERNEL_COUNT],
            0xffffffffu, ignored);
    }
    if (carveActive)
    {
        uint ignored;
        InterlockedAdd(_M8TileRecords[M8TileMetaIndex(physicalSlot)].w,
            0xffffffffu, ignored);
    }
    if (stateChanged)
        M8StoreKernelState(physicalSlot, kernelLocal, (KernelState)0);
    if (stateChanged || occupied || carveActive ||
        (previousCandidate & bit) != 0u)
        _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].y = 1u;
}

[numthreads(128, 1, 1)]
void EraseFineTiles(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint physicalSlot = _M8CarveTilesRead[groupId.x];
    [unroll]
    for (uint batch = 0u; batch < 4u; batch++)
        M8EraseFineKernel(physicalSlot, thread + batch * 128u);
}

[numthreads(1, 1, 1)]
void FinalizeFineErase(uint id : SV_DispatchThreadID)
{
    uint completed =
        _M8Counters[M8_COUNTER_UNRESOLVED_CARVE_TILES] == 0u ? 1u : 0u;
    _M8AttemptCompletion[0] = uint4(_M8AttemptToken,
        completed != 0u ? _M8AttemptToken : 0u, 0u,
        _M8Counters[M8_COUNTER_RESIDENCY_EPOCH]);
}
