#define MERKABA_LATTICE_STEP 0.025
#define MERKABA_SUPPORT_SIZE 0.050
#define MERKABA_HALF_SUPPORT 0.025
#define MERKABA_OCCUPIED_ON 512
#define MERKABA_OCCUPIED_OFF 128
#define MERKABA_EVIDENCE_CONFIDENCE_LIMIT 2560
#define MERKABA_OCCUPIED_FLAG 1u
RWStructuredBuffer<uint4> _M8AttemptCompletion;

float4x4 _MerkabaGridToWorld;
float4x4 _MerkabaWorldToGrid;
float4 _M8PlaneErrorBounds;

uint _M8AttemptToken;
uint _M8DualPublishingGeneration;
uint _M8DualRetiredGeneration;

float3 _M8ScanCameraWorld;
int3 _M8ScanCenterBlock;
int _M8ScanBlockRadius;
int _M8ScanBlockSide;
float4 _M8ScanCoveragePlanes[8];
uint M8ObservationFailureReason()
{
    return _M8Counters[M8_COUNTER_OBSERVATION_FAILURE];
}

uint PackRgb(uint r, uint g, uint b)
{
    return r | (g << 8u) | (b << 16u) | (255u << 24u);
}

bool M8SupportInsideMutationScope(M8FlowerInterval3 support)
{
    [loop] for (int index=0; index<_MerkabaExclusionCount; ++index)
    {
        float3 head=_MerkabaExclusionHeads[index];
        M8FlowerInterval bottom=M8FlowerISub(M8FlowerI(head.y,head.y),
            M8FlowerI(EXCLUSION_BOTTOM,EXCLUSION_BOTTOM));
        M8FlowerInterval top=M8FlowerIAdd(M8FlowerI(head.y,head.y),
            M8FlowerI(EXCLUSION_TOP,EXCLUSION_TOP));
        M8FlowerInterval radial=M8FlowerIAdd(
            M8FlowerISquare(M8FlowerISub(support.x,M8FlowerI(head.x,head.x))),
            M8FlowerISquare(M8FlowerISub(support.z,M8FlowerI(head.z,head.z))));
        M8FlowerInterval radius=M8FlowerISquare(M8FlowerI(EXCLUSION_RADIUS,EXCLUSION_RADIUS));
        if (support.y.hi >= bottom.lo && support.y.lo <= top.hi && radial.lo <= radius.hi)
            return false;
    }
    if (_M8FineRefineActive == 0u) return true;
    M8FlowerInterval3 relative;
    relative.x=M8FlowerISub(support.x,M8FlowerI(_M8FineCursorPosition.x,_M8FineCursorPosition.x));
    relative.y=M8FlowerISub(support.y,M8FlowerI(_M8FineCursorPosition.y,_M8FineCursorPosition.y));
    relative.z=M8FlowerISub(support.z,M8FlowerI(_M8FineCursorPosition.z,_M8FineCursorPosition.z));
    M8FlowerInterval ax=M8FlowerI(_M8FineBrushAxis.x,_M8FineBrushAxis.x);
    M8FlowerInterval ay=M8FlowerI(_M8FineBrushAxis.y,_M8FineBrushAxis.y);
    M8FlowerInterval az=M8FlowerI(_M8FineBrushAxis.z,_M8FineBrushAxis.z);
    M8FlowerInterval axial=M8FlowerIAdd(M8FlowerIAdd(M8FlowerIMul(relative.x,ax),
        M8FlowerIMul(relative.y,ay)),M8FlowerIMul(relative.z,az));
    if (axial.lo < 0.0 || axial.hi > _M8FineLength) return false;
    M8FlowerInterval radial=M8FlowerIAdd(M8FlowerIAdd(
        M8FlowerISquare(M8FlowerISub(relative.x,M8FlowerIMul(axial,ax))),
        M8FlowerISquare(M8FlowerISub(relative.y,M8FlowerIMul(axial,ay)))),
        M8FlowerISquare(M8FlowerISub(relative.z,M8FlowerIMul(axial,az))));
    return radial.hi <= _M8FineRadiusSquared;
}


bool M8SupportThrough(int3 firstOwner, uint ownerSpan)
{
    if (!isfinite(_MerkabaMaxUpdateDistance) ||
        !(_MerkabaMaxUpdateDistance > 0.0) || ownerSpan == 0u ||
        ownerSpan > MERKABA_M8_BLOCK_KERNEL_SPAN) return false;
    // The union of n consecutive owner supports is [first-1, first+n]
    // in each axis. Enclose that complete cube before projection; the same
    // certificate is valid for a kernel, tile, chunk or block. Integer to
    // float conversion is enclosed before adding the span, including at
    // negative and large signed coordinates.
    M8FlowerInterval3 gridSupport;
    float3 centre = float3(firstOwner);
    M8FlowerInterval extent = M8FlowerI(-1.0, (float)ownerSpan);
    M8FlowerInterval step = M8FlowerI(M8_FLOWER_LATTICE_STEP, M8_FLOWER_LATTICE_STEP);
    gridSupport.x = M8FlowerIMul(M8FlowerIAdd(M8FlowerI(
        M8FlowerPrevious(centre.x), M8FlowerNext(centre.x)),
        extent), step);
    gridSupport.y = M8FlowerIMul(M8FlowerIAdd(M8FlowerI(
        M8FlowerPrevious(centre.y), M8FlowerNext(centre.y)),
        extent), step);
    gridSupport.z = M8FlowerIMul(M8FlowerIAdd(M8FlowerI(
        M8FlowerPrevious(centre.z), M8FlowerNext(centre.z)),
        extent), step);
    M8FlowerInterval3 support;
    support.x = M8DepthIntervalRow(_MerkabaGridToWorld[0], gridSupport);
    support.y = M8DepthIntervalRow(_MerkabaGridToWorld[1], gridSupport);
    support.z = M8DepthIntervalRow(_MerkabaGridToWorld[2], gridSupport);
    if (!M8SupportInsideMutationScope(support)) return false;
    float3 minimum = float3(support.x.lo, support.y.lo, support.z.lo);
    float3 maximum = float3(support.x.hi, support.y.hi, support.z.hi);
    M8FlowerInterval rangeSquared = M8FlowerISquare(M8FlowerI(
        _MerkabaMaxUpdateDistance, _MerkabaMaxUpdateDistance));
    [unroll]
    for (uint eye = 0u; eye < 2u; ++eye)
    {
        float3 origin = float3(gsDepthViewInv[eye][0][3],
            gsDepthViewInv[eye][1][3], gsDepthViewInv[eye][2][3]);
        M8FlowerInterval distanceSquared = M8FlowerIAdd(M8FlowerIAdd(
            M8FlowerISquare(M8FlowerISub(support.x, M8FlowerI(origin.x,origin.x))),
            M8FlowerISquare(M8FlowerISub(support.y, M8FlowerI(origin.y,origin.y)))),
            M8FlowerISquare(M8FlowerISub(support.z, M8FlowerI(origin.z,origin.z))));
        if (distanceSquared.hi > rangeSquared.lo) continue;
        if (M8DepthCertificateEyeSupport(minimum, maximum, gsDepthView[eye],
                gsDepthProj[eye], (int2)gsDepthTexSize, eye))
            return true;
    }
    return false;
}

void UpdateOccupancy(uint physicalSlot, uint kernelLocal,
    inout KernelState state, int delta)
{
    bool occupiedBefore = (state.flags & MERKABA_OCCUPIED_FLAG) != 0u;
    state.evidence = clamp(state.evidence + delta,
        -MERKABA_EVIDENCE_CONFIDENCE_LIMIT,
        MERKABA_EVIDENCE_CONFIDENCE_LIMIT);
    bool occupiedAfter = occupiedBefore
        ? state.evidence > MERKABA_OCCUPIED_OFF
        : state.evidence >= MERKABA_OCCUPIED_ON;
    if (occupiedAfter) state.flags |= MERKABA_OCCUPIED_FLAG;
    else
    {
        state.flags &= ~MERKABA_OCCUPIED_FLAG;
        state.flags = M8FlowerClearPlane(state.flags);
    }
    if (occupiedBefore == occupiedAfter) return;

    uint wordIndex = M8TileWordIndex(physicalSlot, kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    uint ignored;
    if (occupiedAfter)
    {
        InterlockedOr(_M8TileBits[wordIndex].x, bit, ignored);
        InterlockedAdd(_M8TileRecords[M8TileMetaIndex(physicalSlot)].z,
            1u, ignored);
        InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_KERNEL_COUNT], 1u,
            ignored);
    }
    else
    {
        InterlockedAnd(_M8TileBits[wordIndex].x, ~bit, ignored);
        InterlockedAdd(_M8TileRecords[M8TileMetaIndex(physicalSlot)].z,
            0xffffffffu, ignored);
        InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_KERNEL_COUNT],
            0xffffffffu, ignored);
    }
}

void M8MarkR1Active(uint physicalSlot, uint kernelLocal)
{
    uint wordIndex = M8TileWordIndex(physicalSlot, kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    uint previous;
    InterlockedOr(_M8TileBits[wordIndex].y, bit, previous);
    if ((previous & bit) == 0u)
    {
        uint ignored;
        InterlockedAdd(_M8TileRecords[M8TileMetaIndex(physicalSlot)].w,
            1u, ignored);
    }
}

#include "MerkabaFlowerCommit.hlsl"
#include "MerkabaFlowerRefinement.hlsl"
#include "MerkabaFlowerPageInvalidation.hlsl"

bool RequestColdTile(uint tileRefIndex, uint chunkIndex, uint tileLocal,
    bool scanRequest)
{
    bool queued = M8QueueColdTileLoad(tileRefIndex, chunkIndex, tileLocal);
    if (scanRequest && queued)
        M8CounterIncrement(M8_COUNTER_SCAN_COLD_MISSES);
    return queued;
}

uint M8ScanChildMask(int3 parentMin, int parentSpan)
{
    uint support = MerkabaM8DistanceChildMask(parentMin, parentSpan,
        _MerkabaMaxUpdateDistance, _M8ScanCameraWorld, _MerkabaGridToWorld,
        _MerkabaWorldToGrid, MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
    [unroll]
    for (uint plane = 0u; plane < 8u; plane++)
        support &= MerkabaM8KernelPlaneChildMask(parentMin, parentSpan,
            _M8ScanCoveragePlanes[plane]);
    return support;
}

// One workgroup owns one existing signed M8 block. No second spatial
// index exists: allocation requests use the same block/chunk/tile barriers.
groupshared uint gScanBlockRef;
groupshared uint gScanBlockOrdinal;
groupshared int3 gScanBlockMin;
groupshared uint gScanSupport4;
groupshared uint gDualDirectChunks[16];
groupshared uint gDualHasDirect;
groupshared uint gDualBlockFinished;
groupshared uint gDualWholeCertificate;
groupshared uint gDualChanged;
groupshared uint gDualBeginStatus;

void M8DualObservationPending(uint status)
{
    if (status == M8_DUAL_WRITE_INVALID)
        M8FlowerBinFailure(M8_OBSERVATION_FAILURE_MEASUREMENT_IDENTITY);
    else
    {
        M8CounterIncrement(M8_COUNTER_UNRESOLVED_CARVE_TILES);
        if (status == M8_DUAL_WRITE_RETRY)
            _M8Counters[M8_COUNTER_STORAGE_BACKPRESSURE]=1u;
    }
}

void M8DualRequestStorage(uint kind, uint child, uint tile)
{
    // Count's claims have already been published. No allocation or geometry
    // is performed here; storage reconstructs this frozen domain address.
    [loop] for (uint attempt=0u; attempt<4u; ++attempt)
    {
        uint count=_M8Counters[M8_COUNTER_DUAL_STORAGE_INTENT_COUNT];
        if (count >= MERKABA_M8_BLOCK_CAPACITY) break;
        uint previous;
        InterlockedCompareExchange(_M8Counters[M8_COUNTER_DUAL_STORAGE_INTENT_COUNT],
            count,count+1u,previous);
        if (previous != count) continue;
        _M8ClaimQueue[MERKABA_M8_CLAIM_BLOCK_OFFSET+count]=
            uint2(gScanBlockOrdinal,(kind << 15u) | (tile << 9u) | child);
        return;
    }
    // A full bounded prefix drains normally. The same held observation
    // retries the unrecorded address; overflow never fabricates free space.
    _M8Counters[M8_COUNTER_STORAGE_BACKPRESSURE]=1u;
    M8CounterIncrement(M8_COUNTER_UNRESOLVED_CARVE_TILES);
}

// Emit has marked every accepted direct owner. Negative-only tiles only
// stamp their bin; the existing Reserve kernel publishes the touched queue.
void M8DualTouchObservationTile(uint slot)
{
    uint previous;
    InterlockedExchange(_M8ObservationTileBins[slot].x,_M8ObservationToken,previous);
    if (previous != _M8ObservationToken)
    {
        _M8ObservationTileBins[slot].y=0u;
        _M8ObservationTileBins[slot].z=0u;
        _M8ObservationTileBins[slot].w=0u;
    }
    _M8TileRecords[M8TileRuntimeIndex(slot)].z=_M8Counters[M8_COUNTER_FRAME_EPOCH];
}

bool M8DualChunkHasDirect(uint chunk)
{
    if (chunk >= MERKABA_M8_CHUNK_CAPACITY) return false;
    [loop] for (uint tile=0u; tile<64u; ++tile)
    {
        uint reference=_M8ChunkTileRefsRead[chunk*64u+tile];
        if (!M8IsHotRef(reference)) continue;
        uint slot=M8PhysicalSlot(reference);
        uint4 bin=_M8ObservationTileBins[slot];
        if (bin.x == _M8ObservationToken && bin.y != 0u) return true;
    }
    return false;
}

void M8DualTouchResidentChunk(uint chunk)
{
    [loop] for (uint tile=0u; tile<64u; ++tile)
    {
        uint reference=_M8ChunkTileRefsRead[chunk*64u+tile];
        if (!M8IsHotRef(reference)) continue;
        uint slot=M8PhysicalSlot(reference);
        if (_M8TileRecords[M8TileMetaIndex(slot)].w != 0u)
            M8DualTouchObservationTile(slot);
    }
}

void M8DualRequestChunkPayload(uint chunk, uint child)
{
    if (chunk >= MERKABA_M8_CHUNK_CAPACITY) return;
    [loop] for (uint tile=0u; tile<64u; ++tile)
    {
        uint index=chunk*64u+tile;
        if (_M8ChunkTileRefsRead[index] == MERKABA_REF_COLD_ON_SSD)
            M8DualRequestStorage(M8_DUAL_INTENT_TILE_COLD,child,tile);
    }
}

void M8DualProcessObservationChunk(uint block, uint child, int3 minimum)
{
    bool hasDirect=(gDualDirectChunks[child >> 5u] & (1u << (child & 31u))) != 0u;
    bool through=false;
    if (!hasDirect)
        through=gDualWholeCertificate != 0u || M8SupportThrough(minimum,32u);
    uint chunk;
    if (through)
    {
        uint result=M8DualWriteChunkUniform(block,child,M8_DUAL_THROUGH,
            _M8DualPublishingGeneration,_M8DualRetiredGeneration);
        if (result <= M8_DUAL_WRITE_COMMITTED)
        {
            if (result == M8_DUAL_WRITE_COMMITTED) InterlockedOr(gDualChanged,1u);
            if (M8DualResolveChunk(block,child,chunk)) M8DualTouchResidentChunk(chunk);
            return;
        }
        if (result == M8_DUAL_WRITE_INVALID)
        {
            M8DualObservationPending(result);
            return;
        }
        // A COLD child is not discarded even when the enclosing current
        // certificate succeeds. Descend to request its exact stored support.
    }

    if (!M8DualResolveChunk(block,child,chunk))
    {
        M8DualRequestStorage(M8_DUAL_INTENT_CHUNK,child,0u);
        M8DualObservationPending(M8_DUAL_WRITE_RETRY);
        return;
    }
    M8DualChunkPayload payload;
    uint result=M8DualBeginChunk(block,child,_M8DualPublishingGeneration,
        _M8DualRetiredGeneration,chunk,payload);
    if (result > M8_DUAL_WRITE_COMMITTED)
    {
        M8DualRequestChunkPayload(chunk,child);
        M8DualObservationPending(result);
        return;
    }

    uint firstMask=through ? 255u : M8ScanChildMask(minimum,32);
    [loop] while (firstMask != 0u)
    {
        uint d1=(uint)firstbitlow(firstMask);
        firstMask &= firstMask-1u;
        int3 firstMinimum=minimum+MerkabaM8OctantOffset(d1,16);
        uint secondMask=through ? 255u : M8ScanChildMask(firstMinimum,16);
        [loop] while (secondMask != 0u)
        {
            uint d0=(uint)firstbitlow(secondMask);
            secondMask &= secondMask-1u;
            uint tile=(d1 << 3u) | d0;
            int3 tileMinimum=firstMinimum+MerkabaM8OctantOffset(d0,8);
            uint referenceIndex=chunk*64u+tile;
            uint reference=_M8ChunkTileRefsRead[referenceIndex];
            bool hot=M8IsHotRef(reference);
            uint slot=hot ? M8PhysicalSlot(reference) : M8_DUAL_NO_REF;
            bool direct=false;
            if (hot)
            {
                uint4 bin=_M8ObservationTileBins[slot];
                direct=bin.x == _M8ObservationToken && bin.y != 0u;
            }
            uint words[16];
            uint previous=M8DualReadPreparedTileWords(chunk,payload,tile,words);
            if (previous == M8_DUAL_AMBIGUOUS)
            {
                if (reference == MERKABA_REF_COLD_ON_SSD)
                    M8DualRequestStorage(M8_DUAL_INTENT_TILE_COLD,child,tile);
                M8DualObservationPending(M8_DUAL_WRITE_COLD);
                continue;
            }

            bool entire=false;
            if (!direct) entire=through || M8SupportThrough(tileMinimum,8u);
            if (entire)
            {
                [unroll] for (uint word=0u; word<16u; ++word) words[word]=0xffffffffu;
            }
            else
            {
                [loop] for (uint word=0u; word<16u; ++word)
                {
                    uint endpoints=direct ? _M8TileBitsRead[M8TileWordIndex(slot,word)].z : 0u;
                    // Restore all strict direct supports before any possible
                    // canonical positive write, including incompatible owners.
                    words[word] &= ~endpoints;
                    [loop] for (uint bit=0u; bit<32u; ++bit)
                    {
                        uint mask=1u << bit;
                        if (((words[word] | endpoints) & mask) != 0u) continue;
                        uint local=word*32u+bit;
                        int3 owner=tileMinimum+int3(local & 7u,(local >> 3u) & 7u,local >> 6u);
                        if (M8SupportThrough(owner,1u)) words[word] |= mask;
                    }
                }
            }
            uint anyValue=0u, allValues=0xffffffffu;
            [unroll] for (uint word=0u; word<16u; ++word)
            { anyValue |= words[word]; allValues &= words[word]; }
            bool mixed=anyValue != 0u && allValues != 0xffffffffu;
            if (mixed && !hot)
            {
                if (reference == MERKABA_REF_EMPTY || reference == MERKABA_REF_COLD_ON_SSD)
                    M8DualRequestStorage(reference == MERKABA_REF_EMPTY ?
                        M8_DUAL_INTENT_TILE_EMPTY : M8_DUAL_INTENT_TILE_COLD,child,tile);
                M8DualObservationPending(M8_DUAL_WRITE_COLD);
                continue;
            }
            result=M8DualWriteTileWords(block,child,chunk,tile,slot,
                _M8DualPublishingGeneration,_M8DualRetiredGeneration,payload,words);
            if (result > M8_DUAL_WRITE_COMMITTED)
            {
                M8DualObservationPending(result);
                continue;
            }
            if (result == M8_DUAL_WRITE_COMMITTED)
            {
                InterlockedOr(gDualChanged,1u);
                if (hot) M8MarkTileDirty(slot);
            }
            if (hot && (direct || _M8TileRecords[M8TileMetaIndex(slot)].w != 0u))
                M8DualTouchObservationTile(slot);
        }
    }
}

[numthreads(64,1,1)]
void UpdateObservationDual(uint3 group : SV_GroupID, uint lane : SV_GroupIndex)
{
    if (lane == 0u)
    {
        gScanBlockRef=0u;
        gScanBlockOrdinal=group.x;
        gScanSupport4=0u;
        gDualHasDirect=0u;
        gDualBlockFinished=0u;
        gDualWholeCertificate=0u;
        gDualChanged=0u;
        gDualBeginStatus=M8_DUAL_WRITE_RETRY;
        if (group.x == 0u) _M8Counters[M8_COUNTER_DUAL_TOUCH_PUBLICATION]=1u;
        bool ready=_M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] == 0u &&
            _M8Counters[M8_COUNTER_OBSERVATION_FAILURE] == 0u &&
            _M8Counters[M8_COUNTER_UNRESOLVED_SURFACE_TILES] == 0u;
        if (ready && (_M8ObservationToken == 0u || _M8DualPublishingGeneration == 0u ||
            _M8DualPublishingGeneration > M8_DUAL_MAX_GENERATION ||
            _M8Counters[M8_COUNTER_NEW_BLOCK_QUEUE_COUNT] != 0u ||
            _M8Counters[M8_COUNTER_NEW_CHUNK_QUEUE_COUNT] != 0u ||
            _M8Counters[M8_COUNTER_NEW_TILE_QUEUE_COUNT] != 0u))
        {
            M8FlowerBinFailure(M8_OBSERVATION_FAILURE_MEASUREMENT_IDENTITY);
            ready=false;
        }
        int3 coordinate;
        if (ready && !M8ObservationBlockAddress(_M8ScanCenterBlock,
            _M8ScanBlockRadius,_M8ScanBlockSide,group.x,coordinate))
        {
            M8FlowerBinFailure(M8_OBSERVATION_FAILURE_MEASUREMENT_IDENTITY);
            ready=false;
        }
        if (ready)
        {
            gScanBlockMin=coordinate*MERKABA_M8_BLOCK_KERNEL_SPAN;
            gScanSupport4=M8ScanChildMask(gScanBlockMin,256);
            if (gScanSupport4 != 0u)
            {
                uint block;
                if (M8FindBlock(coordinate,block))
                {
                    gScanBlockRef=block+1u;
                    M8CounterIncrement(M8_COUNTER_CARVE_QUERY_BLOCKS);
                }
                else
                {
                    M8DualRequestStorage(M8_DUAL_INTENT_BLOCK,0u,0u);
                    M8DualObservationPending(M8_DUAL_WRITE_RETRY);
                }
            }
        }
    }
    if (lane < 16u) gDualDirectChunks[lane]=0u;
    GroupMemoryBarrierWithGroupSync();
    if (gScanBlockRef == 0u) return;
    uint block=gScanBlockRef-1u;

    // Direct exclusion is explicit at every uniform ancestor fast path.
    // Only existing M8 relations are inspected; an empty relation has no
    // accepted positive bin because Emit completed before this dispatch.
    [loop] for (uint child=lane; child<512u; child+=64u)
    {
        uint chunk;
        if (!M8DualResolveChunk(block,child,chunk)) continue;
        if (M8DualChunkHasDirect(chunk))
        {
            InterlockedOr(gDualDirectChunks[child >> 5u],1u << (child & 31u));
            InterlockedOr(gDualHasDirect,1u);
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (lane == 0u)
    {
        if (gDualHasDirect == 0u)
            gDualWholeCertificate=M8SupportThrough(gScanBlockMin,256u) ? 1u : 0u;
        if (gDualWholeCertificate != 0u)
        {
            uint result=M8DualWriteBlockUniform(block,M8_DUAL_THROUGH,
                _M8DualPublishingGeneration,_M8DualRetiredGeneration);
            if (result == M8_DUAL_WRITE_COMMITTED)
                InterlockedOr(_M8Counters[M8_COUNTER_OBSERVATION_CHANGE_MASK],
                    M8_OBSERVATION_CHANGED_DUAL);
            if (result <= M8_DUAL_WRITE_COMMITTED) gDualBlockFinished=1u;
            else if (result == M8_DUAL_WRITE_INVALID) M8DualObservationPending(result);
        }
        if (gDualBlockFinished == 0u)
        {
            gDualBeginStatus=M8DualBeginBlock(block,_M8DualPublishingGeneration,
                _M8DualRetiredGeneration);
            if (gDualBeginStatus > M8_DUAL_WRITE_COMMITTED)
                M8DualObservationPending(gDualBeginStatus);
        }
    }
    DeviceMemoryBarrierWithGroupSync();
    if (gDualBlockFinished != 0u)
    {
        [loop] for (uint child=lane; child<512u; child+=64u)
        {
            uint chunk;
            if (M8DualResolveChunk(block,child,chunk)) M8DualTouchResidentChunk(chunk);
        }
        return;
    }
    if (gDualBeginStatus > M8_DUAL_WRITE_COMMITTED) return;
    uint d4=lane >> 3u, d3=lane & 7u;
    if ((gScanSupport4 & (1u << d4)) != 0u)
    {
        int3 min4=gScanBlockMin+MerkabaM8OctantOffset(d4,128);
        uint second=M8ScanChildMask(min4,128);
        if ((second & (1u << d3)) != 0u)
        {
            int3 min3=min4+MerkabaM8OctantOffset(d3,64);
            uint children=M8ScanChildMask(min3,64);
            [loop] while (children != 0u)
            {
                uint d2=(uint)firstbitlow(children);
                children &= children-1u;
                M8DualProcessObservationChunk(block,(d4 << 6u) | (d3 << 3u) | d2,
                    min3+MerkabaM8OctantOffset(d2,32));
            }
        }
    }
    DeviceMemoryBarrierWithGroupSync();
    // Partial certified dual progress may publish, but the global pending
    // counter holds ALL R1/evidence writes until this observation can finish.
    if (lane == 0u && gDualChanged != 0u)
    {
        uint result=M8DualEndBlock(block,_M8DualPublishingGeneration);
        // Tile/chunk changes have already committed, even if a later
        // allocation fails or this observation needs another resident quantum.
        InterlockedOr(_M8Counters[M8_COUNTER_OBSERVATION_CHANGE_MASK],
            M8_OBSERVATION_CHANGED_DUAL);
        if (result > M8_DUAL_WRITE_COMMITTED) M8DualObservationPending(result);
    }
}

void M8FinalizeObservationCompletion()
{
    uint pendingRefinement = _M8Counters[M8_COUNTER_REFINEMENT_PENDING_TILES];
    if (_M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] == 0u)
    {
        uint failure = M8ObservationFailureReason();
        _M8Counters[M8_COUNTER_OBSERVATION_FAILURE] = failure;
        if (failure != 0u && pendingRefinement == 0u)
        {
            _M8Counters[M8_COUNTER_FAILED_OBSERVATIONS] += 1u;
            _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] = 1u;
        }
        else if (failure == 0u && pendingRefinement == 0u &&
            _M8Counters[M8_COUNTER_UNRESOLVED_SURFACE_TILES] == 0u &&
            _M8Counters[M8_COUNTER_UNRESOLVED_CARVE_TILES] == 0u)
            _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] = 1u;
    }
    uint completed = _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED];
    uint failure = _M8Counters[M8_COUNTER_OBSERVATION_FAILURE];
    uint touchedCount = completed != 0u
        ? min(_M8Counters[M8_COUNTER_TOUCHED_TILE_COUNT],
            MERKABA_M8_PHYSICAL_TILE_CAPACITY) : 0u;
    uint pendingCount = completed != 0u && failure != 0u
        ? min(_M8Counters[M8_COUNTER_PENDING_NEW_TILE_COUNT],
            MERKABA_M8_PHYSICAL_TILE_CAPACITY) : 0u;
    // A uniform dual node can change without touching any HOT R1 tile.
    // Report actual publication independently of successful observation
    // completion: failed/pending attempts may retain certified dual progress.
    bool readoutChanged =
        _M8Counters[M8_COUNTER_OBSERVATION_CHANGE_MASK] != 0u;
    _M8Counters[M8_COUNTER_CLEANUP_TOUCHED_COUNT] = touchedCount;
    _M8Counters[M8_COUNTER_CLEANUP_PENDING_COUNT] = pendingCount;
    _M8ObservationDispatchArgs[0] = max(touchedCount, pendingCount);
    _M8ObservationDispatchArgs[1] = 1u;
    _M8ObservationDispatchArgs[2] = 1u;
    _M8AttemptCompletion[0] = uint4(_M8AttemptToken,
        completed != 0u ?
            _M8Counters[M8_COUNTER_OBSERVATION_TOKEN] : 0u,
        failure | (readoutChanged ?
            M8_ATTEMPT_COMPLETION_READOUT_CHANGED : 0u) |
            (_M8Counters[M8_COUNTER_REFINEMENT_WORK_PROGRESS] != 0u ?
                M8_ATTEMPT_COMPLETION_REFINEMENT_PROGRESS : 0u),
        _M8Counters[M8_COUNTER_RESIDENCY_EPOCH]);
}

groupshared uint gFlowerFinalizeSourceReady;
groupshared uint gFlowerFinalizeTouchedCount;
groupshared uint gFlowerFinalizeNewTileCount;

[numthreads(128, 1, 1)]
void FinalizeObservation(uint lane : SV_GroupIndex)
{
    if (lane == 0u)
    {
        gFlowerFinalizeSourceReady = M8FlowerPageSourceReady(_M8DualPublishingGeneration) ? 1u : 0u;
        M8FinalizeObservationCompletion();
        // Pending quanta can commit real R2/RGB/V data without completing the
        // immutable observation. Invalidate those consumers before cleanup,
        // not only on the successful final observation quantum.
        gFlowerFinalizeTouchedCount = _M8Counters[M8_COUNTER_OBSERVATION_CHANGE_MASK] != 0u ?
            min(_M8Counters[M8_COUNTER_TOUCHED_TILE_COUNT], MERKABA_M8_PHYSICAL_TILE_CAPACITY) : 0u;
        // InitializeNewTiles already needs eight writable bindings. Its real
        // installed addresses remain in this existing bounded pending list
        // until the immediately following retirement barrier; no ninth UAV.
        gFlowerFinalizeNewTileCount = min(_M8Counters[M8_COUNTER_PENDING_NEW_TILE_COUNT],
            MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    }
    GroupMemoryBarrierWithGroupSync();
    if (gFlowerFinalizeSourceReady == 0u) return;
    [loop] for (uint index = lane; index < gFlowerFinalizeTouchedCount; index += 128u)
        M8FlowerMarkTileNeighborhoodDirty(_M8TouchedTileQueueRead[index],
            _M8DualPublishingGeneration);
    [loop] for (uint pending = lane; pending < gFlowerFinalizeNewTileCount; pending += 128u)
    {
        uint referenceIndex = _M8PendingNewTileRefsRead[pending];
        if (referenceIndex >= MERKABA_M8_CHUNK_CAPACITY * MERKABA_M8_TILES_PER_CHUNK) continue;
        uint reference = _M8ChunkTileRefsRead[referenceIndex];
        if (M8IsHotRef(reference))
            M8FlowerMarkTileNeighborhoodDirty(M8PhysicalSlot(reference),
                _M8DualPublishingGeneration);
    }
}

[numthreads(1, 1, 1)]
void ResetFineErase(uint id : SV_DispatchThreadID)
{
    _M8Counters[M8_COUNTER_CARVE_TILE_COUNT] = 0u;
    _M8Counters[M8_COUNTER_UNRESOLVED_CARVE_TILES] = 0u;
    _M8Counters[M8_COUNTER_OBSERVATION_CHANGE_MASK] = 0u;
    _M8ObservationDispatchArgs[0] = 0u;
    _M8ObservationDispatchArgs[1] = 1u;
    _M8ObservationDispatchArgs[2] = 1u;
}

uint M8FineEraseChildMask(int3 parentMin, int parentSpan)
{
    float halfLength = _M8FineLength * 0.5;
    float3 boundsCenter = _M8FineCursorPosition +
        _M8FineBrushAxis * halfLength;
    float boundsRadius = sqrt(max(0.0,
        _M8FineRadiusSquared + halfLength * halfLength));
    return MerkabaM8DistanceChildMask(parentMin, parentSpan,
        boundsRadius, boundsCenter,
        _MerkabaGridToWorld, _MerkabaWorldToGrid, MERKABA_LATTICE_STEP,
        MERKABA_HALF_SUPPORT);
}

groupshared uint gFineEraseBlockRef;
groupshared int3 gFineEraseBlockMin;
groupshared uint gFineEraseSupport4;
groupshared uint gFineEraseSupport3[8];

[numthreads(64, 1, 1)]
void QueryFineEraseTiles(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint linearBlockIndex = groupId.x;
    if (thread == 0u)
    {
        gFineEraseBlockRef = 0u;
        gFineEraseSupport4 = 0u;
        uint side = (uint)_M8ScanBlockSide;
        if (linearBlockIndex < side * side * side)
        {
            int3 offset;
            offset.x = (int)(linearBlockIndex % side) - _M8ScanBlockRadius;
            offset.y = (int)((linearBlockIndex / side) % side) -
                _M8ScanBlockRadius;
            offset.z = (int)(linearBlockIndex / (side * side)) -
                _M8ScanBlockRadius;
            int3 blockCoord = _M8ScanCenterBlock + offset;
            gFineEraseBlockMin = blockCoord *
                MERKABA_M8_BLOCK_KERNEL_SPAN;
            gFineEraseSupport4 = M8FineEraseChildMask(
                gFineEraseBlockMin, 256);
            if (gFineEraseSupport4 != 0u)
            {
                uint blockIndex;
                if (M8FindBlock(blockCoord, blockIndex))
                    gFineEraseBlockRef = blockIndex + 1u;
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (thread < 8u)
    {
        gFineEraseSupport3[thread] = 0u;
        if (gFineEraseBlockRef != 0u &&
            ((_M8BlockPresenceL0Read[gFineEraseBlockRef - 1u] &
              gFineEraseSupport4) & (1u << thread)) != 0u)
        {
            int3 childMin = gFineEraseBlockMin +
                MerkabaM8OctantOffset(thread, 128);
            gFineEraseSupport3[thread] =
                M8FineEraseChildMask(childMin, 128);
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gFineEraseBlockRef == 0u) return;

    uint blockIndex = gFineEraseBlockRef - 1u;
    uint d4 = thread >> 3u;
    uint d3 = thread & 7u;
    if (((gFineEraseSupport4 >> d4) & 1u) == 0u ||
        (((_M8BlockPresenceL1Read[blockIndex * 8u + d4] &
           gFineEraseSupport3[d4]) >> d3) & 1u) == 0u) return;

    int3 min4 = gFineEraseBlockMin + MerkabaM8OctantOffset(d4, 128);
    int3 min3 = min4 + MerkabaM8OctantOffset(d3, 64);
    uint support2 = (_M8BlockPresenceL2Read[blockIndex * 64u +
        d4 * 8u + d3] & 255u) & M8FineEraseChildMask(min3, 64);
    while (support2 != 0u)
    {
        uint d2 = (uint)firstbitlow(support2);
        support2 &= support2 - 1u;
        uint chunkLocal = (d4 << 6u) | (d3 << 3u) | d2;
        uint chunkRef = _M8BlockChunkRefsRead[blockIndex * 512u +
            chunkLocal];
        if (chunkRef == MERKABA_REF_EMPTY) continue;
        if (chunkRef >= MERKABA_REF_EVICTING)
        {
            M8CounterIncrement(M8_COUNTER_UNRESOLVED_CARVE_TILES);
            continue;
        }
        uint chunkIndex = chunkRef - 1u;
        int3 min2 = min3 + MerkabaM8OctantOffset(d2, 32);
        uint support1 = (_M8ChunkPresenceRead[
            M8ChunkPresenceL0Index(chunkIndex)] & 255u) &
            M8FineEraseChildMask(min2, 32);
        while (support1 != 0u)
        {
            uint d1 = (uint)firstbitlow(support1);
            support1 &= support1 - 1u;
            int3 min1 = min2 + MerkabaM8OctantOffset(d1, 16);
            uint support0 = (_M8ChunkPresenceRead[
                M8ChunkPresenceL1Index(chunkIndex, d1)] & 255u) &
                M8FineEraseChildMask(min1, 16);
            while (support0 != 0u)
            {
                uint d0 = (uint)firstbitlow(support0);
                support0 &= support0 - 1u;
                uint tileLocal = (d1 << 3u) | d0;
                uint tileRefIndex = chunkIndex * 64u + tileLocal;
                uint tileRef = _M8ChunkTileRefs[tileRefIndex];
                if (tileRef == MERKABA_REF_EMPTY) continue;
                if (tileRef == MERKABA_REF_COLD_ON_SSD)
                {
                    RequestColdTile(tileRefIndex, chunkIndex, tileLocal,
                        false);
                    M8CounterIncrement(
                        M8_COUNTER_UNRESOLVED_CARVE_TILES);
                    continue;
                }
                if (!M8IsHotRef(tileRef))
                {
                    M8CounterIncrement(
                        M8_COUNTER_UNRESOLVED_CARVE_TILES);
                    continue;
                }
                uint queueIndex;
                InterlockedAdd(_M8Counters[M8_COUNTER_CARVE_TILE_COUNT],
                    1u, queueIndex);
                if (queueIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                    _M8TouchedTileQueue[queueIndex] = M8PhysicalSlot(tileRef);
            }
        }
    }
}

[numthreads(1, 1, 1)]
void PrepareFineEraseArgs(uint id : SV_DispatchThreadID)
{
    _M8ObservationDispatchArgs[0] =
        _M8Counters[M8_COUNTER_UNRESOLVED_CARVE_TILES] == 0u
        ? min(_M8Counters[M8_COUNTER_CARVE_TILE_COUNT],
            MERKABA_M8_PHYSICAL_TILE_CAPACITY)
        : 0u;
    _M8ObservationDispatchArgs[1] = 1u;
    _M8ObservationDispatchArgs[2] = 1u;
}

void M8EraseFineKernel(uint physicalSlot, uint kernelLocal)
{
    int3 globalCoord = M8GlobalKernelCoord(physicalSlot, kernelLocal);
    uint wordIndex = M8TileWordIndex(physicalSlot, kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    uint occupiedWord = _M8TileBits[wordIndex].x;
    float3 gridPosition = (float3)globalCoord * MERKABA_LATTICE_STEP;
    float3 worldPosition = mul(_MerkabaGridToWorld,
        float4(gridPosition, 1.0)).xyz;
    KernelState state;
    bool stateLoaded = false;
    if ((occupiedWord & bit) != 0u)
    {
        state = M8LoadKernelState(physicalSlot, kernelLocal);
        stateLoaded = true;
        if (M8FlowerHasPlane(state.flags))
        {
            float3 normalGrid;
            float signedOffset;
            M8FlowerUnpackPlane(state.flags, normalGrid, signedOffset);
            worldPosition = mul(_MerkabaGridToWorld,
                float4(gridPosition + normalGrid * signedOffset, 1.0)).xyz;
        }
    }
    if (!M8FineContains(worldPosition)) return;

    uint previousOccupied;
    uint previousCarve;
    uint previousCandidate;
    InterlockedAnd(_M8TileBits[wordIndex].x, ~bit, previousOccupied);
    InterlockedAnd(_M8TileBits[wordIndex].y, ~bit, previousCarve);
    InterlockedAnd(_M8TileBits[wordIndex].z, ~bit, previousCandidate);

    if (!stateLoaded)
        state = M8LoadKernelState(physicalSlot, kernelLocal);
    bool stateChanged = state.evidence != 0 || state.packedColor != 0u ||
        state.colorConfidence != 0u || state.flags != 0u;
    bool occupied = (previousOccupied & bit) != 0u;
    bool carveActive = (previousCarve & bit) != 0u;
    if (occupied)
    {
        uint ignored;
        InterlockedAdd(_M8TileRecords[M8TileMetaIndex(physicalSlot)].z,
            0xffffffffu, ignored);
        InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_KERNEL_COUNT],
            0xffffffffu, ignored);
    }
    if (carveActive)
    {
        uint ignored;
        InterlockedAdd(_M8TileRecords[M8TileMetaIndex(physicalSlot)].w,
            0xffffffffu, ignored);
    }
    bool structuralChange = stateChanged || occupied || carveActive ||
        (previousCandidate & bit) != 0u;
    if (structuralChange)
    {
        // Match direct R1 structural mutation: storage cannot capture this
        // tile until the finalizer has committed the owner epoch and cleared
        // this bit. Keep the four-bank ERASE writer at eight UAVs.
        uint ignored;
        InterlockedOr(_M8TileBits[wordIndex].w, bit, ignored);
        DeviceMemoryBarrier();
        if (stateChanged)
            M8StoreKernelState(physicalSlot, kernelLocal, (KernelState)0);
        M8MarkTileDirty(physicalSlot);
        InterlockedOr(_M8Counters[M8_COUNTER_OBSERVATION_CHANGE_MASK],
            M8_OBSERVATION_CHANGED_R1, ignored);
    }
}

[numthreads(128, 1, 1)]
void EraseFineTiles(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint physicalSlot = _M8TouchedTileQueue[groupId.x];
    [unroll]
    for (uint batch = 0u; batch < 4u; batch++)
        M8EraseFineKernel(physicalSlot, thread + batch * 128u);
}

groupshared uint gFineEraseEpochProgress;

[numthreads(128, 1, 1)]
void FinalizeFineErase(uint lane : SV_GroupIndex)
{
    if (lane == 0u)
    {
        gFlowerFinalizeSourceReady = M8FlowerPageSourceReady(_M8DualPublishingGeneration) ? 1u : 0u;
        gFineEraseEpochProgress = 0u;
        gFlowerFinalizeTouchedCount = gFlowerFinalizeSourceReady != 0u ?
            min(_M8Counters[M8_COUNTER_CARVE_TILE_COUNT], MERKABA_M8_PHYSICAL_TILE_CAPACITY) : 0u;
    }
    GroupMemoryBarrierWithGroupSync();
    [loop] for (uint index = lane; index < gFlowerFinalizeTouchedCount; index += 128u)
    {
        uint slot = _M8TouchedTileQueueRead[index];
        if (slot >= MERKABA_M8_PHYSICAL_TILE_CAPACITY)
        {
            M8CounterIncrement(M8_COUNTER_UNRESOLVED_CARVE_TILES);
            continue;
        }
        uint slotGeneration = M8LoadTileRuntimeRead(slot).w;
        uint4 meta = M8LoadTileMetaRead(slot);
        if (slotGeneration == 0u || meta.x >= MERKABA_M8_CHUNK_CAPACITY ||
            meta.y >= MERKABA_M8_TILES_PER_CHUNK ||
            _M8ChunkTileRefsRead[meta.x * MERKABA_M8_TILES_PER_CHUNK + meta.y] != slot + 1u)
        {
            M8CounterIncrement(M8_COUNTER_UNRESOLVED_CARVE_TILES);
            continue;
        }
        bool unresolved = false;
        [loop] for (uint word = 0u; word < MERKABA_M8_TILE_WORDS; ++word)
        {
            uint wordIndex = M8TileWordIndex(slot, word);
            uint pending = _M8TileBits[wordIndex].w;
            [loop] while (pending != 0u)
            {
                uint bit = (uint)firstbitlow(pending);
                pending &= pending - 1u;
                uint result = M8FlowerInvalidateOwner(slot, word * 32u + bit,
                    slotGeneration, _M8DualPublishingGeneration, _M8DualRetiredGeneration);
                if (result == M8_FLOWER_ARENA_OK)
                {
                    DeviceMemoryBarrier();
                    uint ignored;
                    InterlockedAnd(_M8TileBits[wordIndex].w, ~(1u << bit), ignored);
                    InterlockedOr(gFineEraseEpochProgress, 1u);
                }
                else unresolved = true; // Preserve the exact pending bit for this frozen ERASE retry.
            }
        }
        if (unresolved) M8CounterIncrement(M8_COUNTER_UNRESOLVED_CARVE_TILES);
        // Even a pending epoch must invalidate presentation of the already
        // erased parent. Neither storage nor page synthesis may bypass .w.
        M8FlowerMarkTileNeighborhoodDirty(slot, _M8DualPublishingGeneration);
    }
    DeviceMemoryBarrierWithGroupSync();
    if (lane == 0u)
    {
        uint completed = gFlowerFinalizeSourceReady != 0u &&
            _M8Counters[M8_COUNTER_UNRESOLVED_CARVE_TILES] == 0u ? 1u : 0u;
        uint status = gFlowerFinalizeSourceReady != 0u ? 0u : M8_OBSERVATION_FAILURE_MEASUREMENT_IDENTITY;
        if (_M8Counters[M8_COUNTER_OBSERVATION_CHANGE_MASK] != 0u || gFineEraseEpochProgress != 0u)
            status |= M8_ATTEMPT_COMPLETION_READOUT_CHANGED;
        if (gFineEraseEpochProgress != 0u) status |= M8_ATTEMPT_COMPLETION_REFINEMENT_PROGRESS;
        _M8AttemptCompletion[0] = uint4(_M8AttemptToken,
            completed != 0u ? _M8AttemptToken : 0u,
            status,
            _M8Counters[M8_COUNTER_RESIDENCY_EPOCH]);
    }
}
