// Scanner-owned raw depth materialization. Joint normals are produced by the
// four-stream solve in StereoRgbdRefine.compute, not by a second erosion pass.
Texture2DArray<float> gsInputProjectionDepth;
RWTexture2DArray<float> gsDepthTexRW;
float4 gsDepthZParams;

#pragma kernel CopyProjectionDepthArray
#pragma kernel FineSurfaceTarget

// Quest Environment Depth is an external depth attachment with no portable
// colour GraphicsFormat. Materialize it while the AR frame is current by
// sampling the attachment into scanner-owned R32 stereo storage.
[numthreads(8, 8, 1)]
void CopyProjectionDepthArray(uint3 id : SV_DispatchThreadID)
{
    uint width, height, slices;
    gsInputProjectionDepth.GetDimensions(width, height, slices);
    if (id.x >= width || id.y >= height || id.z >= min(slices, 2u)) return;
    gsDepthTexRW[id] = gsInputProjectionDepth[id];
}

// Presentation-only controller-ray target on the latest immutable Environment
// Depth snapshot. The mutation brush uses the returned world hit; this kernel
// does not alter raw depth or canonical M8 state.
Texture2DArray<float> gsFineDepth;
RWStructuredBuffer<float4> gsFineTarget;
float4x4 gsFineDepthProj;
float4x4 gsFineDepthProjInv;
float4x4 gsFineDepthView;
float4x4 gsFineDepthViewInv;
float3 gsFineRayOrigin;
float gsFineMaxDistance;
float3 gsFineRayDirection;
uint2 gsFineDepthSize;

bool FineLoadWorld(int2 pixel, out float3 worldPosition)
{
    worldPosition = 0.0;
    if (pixel.x < 0 || pixel.y < 0 ||
        pixel.x >= (int)gsFineDepthSize.x ||
        pixel.y >= (int)gsFineDepthSize.y)
        return false;
    float depth = gsFineDepth.Load(int4(pixel, 0, 0));
    if (depth <= 0.0 || depth >= 1.0) return false;
    float2 uv = (float2(pixel) + 0.5) / float2(gsFineDepthSize);
    float4 clip = float4(float3(uv, depth) * 2.0 - 1.0, 1.0);
    float4 world = mul(gsFineDepthViewInv,
        mul(gsFineDepthProjInv, clip));
    worldPosition = world.xyz / world.w;
    return all(worldPosition == worldPosition) &&
        all(abs(worldPosition) < 1.0e20);
}

bool FineProjectPixel(float3 worldPosition, out float2 pixel)
{
    float4 view = mul(gsFineDepthView, float4(worldPosition, 1.0));
    float4 clip = mul(gsFineDepthProj, view);
    if (view.z >= -0.001 || clip.w <= 0.0)
    {
        pixel = -1.0;
        return false;
    }
    float2 uv = clip.xy / clip.w * 0.5 + 0.5;
    pixel = uv * float2(gsFineDepthSize) - 0.5;
    return all(uv > 0.0) && all(uv < 1.0);
}

bool FineDepthPlane(int2 pixel, out float3 centerWorld, out float3 normal)
{
    float3 x0, x1, y0, y1;
    if (!FineLoadWorld(pixel, centerWorld) ||
        !FineLoadWorld(pixel + int2(-1, 0), x0) ||
        !FineLoadWorld(pixel + int2(1, 0), x1) ||
        !FineLoadWorld(pixel + int2(0, -1), y0) ||
        !FineLoadWorld(pixel + int2(0, 1), y1))
    {
        normal = 0.0;
        return false;
    }
    normal = cross(x1 - x0, y1 - y0);
    float lengthSquared = dot(normal, normal);
    if (lengthSquared <= 1.0e-12) return false;
    normal *= rsqrt(lengthSquared);
    return true;
}

bool FineRayDepthDelta(float rayDistance, out float depthDelta,
    out int2 depthPixel)
{
    float3 rayPoint = gsFineRayOrigin +
        gsFineRayDirection * rayDistance;
    float2 projectedPixel;
    if (!FineProjectPixel(rayPoint, projectedPixel))
    {
        depthDelta = 0.0;
        depthPixel = 0;
        return false;
    }
    depthPixel = int2(floor(projectedPixel + 0.5));
    float3 depthWorld;
    if (!FineLoadWorld(depthPixel, depthWorld))
    {
        depthDelta = 0.0;
        return false;
    }

    // Negative means that the controller ray is in front of Environment
    // Depth. Non-negative means that it crossed the measured surface.
    float rayViewZ = mul(gsFineDepthView, float4(rayPoint, 1.0)).z;
    float depthViewZ = mul(gsFineDepthView, float4(depthWorld, 1.0)).z;
    depthDelta = depthViewZ - rayViewZ;
    return rayViewZ < -0.001 && depthViewZ < -0.001;
}

[numthreads(1, 1, 1)]
void FineSurfaceTarget(uint3 id : SV_DispatchThreadID)
{
    float lowerDistance = 0.0;
    float upperDistance = 0.0;
    float previousDistance = 0.0;
    float previousDelta = 0.0;
    bool previousValid = false;
    bool bracketed = false;

    // Locate the first actual front-to-behind crossing of the measured depth
    // field. A noisy local tangent plane is never extended toward the hand.
    [loop]
    for (uint step = 0u; step < 128u; step++)
    {
        float sampleDistance = gsFineMaxDistance *
            ((float(step) + 1.0) / 128.0);
        float sampleDelta;
        int2 ignoredPixel;
        if (!FineRayDepthDelta(sampleDistance, sampleDelta, ignoredPixel))
        {
            previousValid = false;
            continue;
        }
        if (previousValid && previousDelta < 0.0 && sampleDelta >= 0.0)
        {
            lowerDistance = previousDistance;
            upperDistance = sampleDistance;
            bracketed = true;
            break;
        }
        previousValid = true;
        previousDistance = sampleDistance;
        previousDelta = sampleDelta;
    }

    int2 targetPixel = 0;
    bool refined = bracketed;
    [unroll]
    for (uint iteration = 0u; iteration < 8u; iteration++)
    {
        if (!refined) break;
        float middleDistance = (lowerDistance + upperDistance) * 0.5;
        float middleDelta;
        int2 middlePixel;
        if (!FineRayDepthDelta(middleDistance, middleDelta, middlePixel))
        {
            refined = false;
            break;
        }
        if (middleDelta >= 0.0)
        {
            upperDistance = middleDistance;
            targetPixel = middlePixel;
        }
        else
            lowerDistance = middleDistance;
    }

    float finalDelta;
    refined = refined && FineRayDepthDelta(upperDistance, finalDelta,
        targetPixel);
    float3 ignoredCenter;
    float3 targetNormal;
    refined = refined && FineDepthPlane(targetPixel, ignoredCenter,
        targetNormal);
    float3 target = gsFineRayOrigin +
        gsFineRayDirection * upperDistance;
    gsFineTarget[0] = refined ? float4(target, 1.0) : 0.0;
    gsFineTarget[1] = refined ? float4(targetNormal, 0.0) : 0.0;
}

// Editor simulation: convert mono linear depth to stereo NDC depth.
Texture2D<float> gsInputRawMonoDepth;

#pragma kernel MonoRawDepthToStereo

[numthreads(8, 8, 1)]
void MonoRawDepthToStereo(uint2 id : SV_DispatchThreadID)
{
    uint width, height;
    gsInputRawMonoDepth.GetDimensions(width, height);
    if (id.x >= width || id.y >= height) return;

    float z = gsInputRawMonoDepth[id.xy];
    float near = gsDepthZParams.x;
    float far = gsDepthZParams.y;
    float depth = (far / (far - near)) -
        (far * near) / ((far - near) * max(z, 1e-6));

    gsDepthTexRW[uint3(id.xy, 0)] = depth;
    gsDepthTexRW[uint3(id.xy, 1)] = depth;
}
