#pragma kernel ClassifyHotFlowerPages
#pragma kernel PrepareDirtyFlowerBatch
#pragma kernel CompactDirtyFlowerSymbols
#pragma kernel ReserveDirtyFlowerBatch
#pragma kernel PublishDirtyFlowerPages
#pragma kernel CullFlowerPages
// Keep bounded generated loops intact in the Quest compiler, as in the
// procedural graphics pass. The FXC/HLSLcc route tries to unroll the exact
// codec through its callers and rejects its explicit loop attributes.
#pragma use_dxc vulkan

#include "MerkabaWorld.hlsl"
#define M8_FLOWER_THREAD_DRAW_WRITE
#define M8_FLOWER_PAGE_WRITE
#include "MerkabaFlowerPages.hlsl"
// Compaction may enqueue existing COLD tiles. All subsequent halo/dual reads
// therefore use the same descriptor as that publication, never an RW/SRV alias.
#define _M8ChunkTileRefsRead _M8ChunkTileRefs
#include "MerkabaFlowerTileHalo.hlsl"
#define M8_FLOWER_GEOMETRY_PACKET_READ
#define M8_FLOWER_GEOMETRY_BASE_PACKET_READ
#define M8_FLOWER_CARRIER_BATCH_READ
#define M8_FLOWER_SUPPORT_SCRATCH_WORDS 4368
#include "MerkabaFlowerGeometry.hlsl"
#include "MerkabaFlowerSupport.hlsl"
#include "MerkabaFlowerSkinReadout.hlsl"

#define MERKABA_LATTICE_STEP 0.025
#define MERKABA_HALF_SUPPORT 0.025

float3 _M8CameraGridMeters;
float3 _M8GridMetricDiagonal;
float3 _M8GridMetricCross;
float _M8RenderDistance;
float _M8WarmDistance;
float _M8ScanDistance;
uint _M8FlowerGraphicsRetiredGeneration;
uint _M8FlowerClassifySingleSlot;
uint _M8FlowerClassifySlot;
uint _M8FlowerViewInstanceCount;
float4 _M8FlowerCullPlanes[12];
float2 _M8FlowerPlaneErrorBounds;

groupshared uint2 m8FlowerPageOwnerSpans[512];
groupshared uint m8FlowerActiveOwners[16];
groupshared uint m8FlowerCompileSlot;
groupshared uint m8FlowerCompileGeneration;
groupshared uint m8FlowerCompileSlotGeneration;
groupshared uint m8FlowerCompileStatus;
groupshared uint m8FlowerCompileTriangles;
groupshared uint2 m8FlowerCompileTotal;
groupshared uint m8FlowerCompileItem;
groupshared uint m8FlowerCompilePhase;
groupshared uint4 m8FlowerReachedCarriers;
groupshared uint4 m8FlowerPendingCarriers;
// Each source sign is absent/provisional/ambiguous/direct: two bits. Both
// signs plus the 27-bit endpoint receipt fit one word, with no lost evidence.
groupshared uint m8FlowerDecodeAnchors[8 * 6 * 3];
groupshared uint m8FlowerDecodeTriples[8 * 6];
groupshared uint m8FlowerDecodeProofTags[8 * 14];
// Only Prepare uses these arrays. Compact retains its existing page-local
// scratch, not a 32-page groupshared packet.
groupshared uint m8FlowerDirtyWords[1024];
groupshared uint m8FlowerDirtyPrefix[1024];
groupshared uint m8FlowerDirtyRoot;
groupshared uint m8FlowerDirtyCursor;
groupshared uint m8FlowerDirtyBatchCount;

// Integer Blelloch exclusive prefix in canonical local-owner order. The same
// uint2 sums as the former scalar loop, with 256 lanes and nine tree levels.
void M8FlowerPrefixOwners(uint lane)
{
    [loop]for(uint stride=1u;stride<512u;stride<<=1u)
    {
        uint index=(lane+1u)*(stride*2u)-1u;
        if(index<512u)m8FlowerPageOwnerSpans[index]+=m8FlowerPageOwnerSpans[index-stride];
        GroupMemoryBarrierWithGroupSync();
    }
    if(lane==0u)
    {
        m8FlowerCompileTotal=m8FlowerPageOwnerSpans[511u];
        m8FlowerPageOwnerSpans[511u]=0u;
    }
    GroupMemoryBarrierWithGroupSync();
    [loop]for(uint stride=256u;stride!=0u;stride>>=1u)
    {
        uint index=(lane+1u)*(stride*2u)-1u;
        if(index<512u)
        {
            uint2 left=m8FlowerPageOwnerSpans[index-stride];
            m8FlowerPageOwnerSpans[index-stride]=m8FlowerPageOwnerSpans[index];
            m8FlowerPageOwnerSpans[index]+=left;
        }
        GroupMemoryBarrierWithGroupSync();
    }
}

// One ordered bitmap snapshot, not one racing pop per compaction WG. A word
// belongs to one lane; only claimed bits are atomically removed BEFORE work.
// Later dirtiness remains set through count/emit and prevents publication.
[numthreads(256,1,1)]
void PrepareDirtyFlowerBatch(uint lane:SV_GroupIndex)
{
    if(lane==0u)
    {
        m8FlowerDirtyBatchCount=_M8FlowerPageDirectory.Load(M8_FLOWER_BATCH_COUNT);
        _M8FlowerIndirectCommands.Store4(M8_FLOWER_BATCH_DISPATCH_ARGS,uint4(0u,1u,1u,0u));
        // An earlier BUSY publisher still owns its receipts. Do not overwrite
        // their only addresses: this turn retries retirement only.
        _M8FlowerPageDirectory.Store(M8_FLOWER_BATCH_PHASE,m8FlowerDirtyBatchCount==0u?0u:2u);
        m8FlowerDirtyRoot=_M8FlowerPageDirectory.Load(0u);
        m8FlowerDirtyCursor=(_M8FlowerPageDirectory.Load(M8_FLOWER_DIRTY_CURSOR)>>5u)&1023u;
        if(m8FlowerDirtyBatchCount==0u)
        {
            _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES]=0u;
            _M8Counters[M8_COUNTER_READOUT_EMITTED_VERTICES]=0u;
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if(m8FlowerDirtyBatchCount!=0u)return;
    [unroll]for(uint item=0u;item<4u;item++)
    {
        uint index=lane+item*256u,word=(m8FlowerDirtyCursor+index)&1023u;
        uint group=word>>5u,bits=0u;
        if((m8FlowerDirtyRoot&(1u<<group))!=0u)
        {
            uint summary=_M8FlowerPageDirectory.Load(M8_FLOWER_PAGE_DIRTY_SUMMARY+group*4u);
            if((summary&(1u<<(word&31u)))!=0u)
                bits=_M8FlowerPageDirectory.Load(M8_FLOWER_PAGE_DIRTY_BITS+word*4u);
        }
        m8FlowerDirtyWords[index]=bits;
        m8FlowerDirtyPrefix[index]=countbits(bits);
    }
    GroupMemoryBarrierWithGroupSync();
    [loop]for(uint stride=1u;stride<1024u;stride<<=1u)
    {
        [unroll]for(uint item=0u;item<2u;item++)
        {
            uint index=(lane+item*256u+1u)*(2u*stride)-1u;
            if(index<1024u)m8FlowerDirtyPrefix[index]+=m8FlowerDirtyPrefix[index-stride];
        }
        GroupMemoryBarrierWithGroupSync();
    }
    if(lane==0u)
    {
        uint dirty=m8FlowerDirtyPrefix[1023u];
        m8FlowerDirtyBatchCount=min(dirty,M8_FLOWER_BATCH_CAPACITY);
        _M8FlowerPageDirectory.Store(M8_FLOWER_BATCH_DIRTY_COUNT,dirty);
        _M8FlowerPageDirectory.Store4(M8_FLOWER_BATCH_CLAIMED,
            uint4(m8FlowerDirtyBatchCount,0u,0u,0u));
        _M8FlowerPageDirectory.Store(M8_FLOWER_BATCH_FAILED,0u);
        m8FlowerDirtyPrefix[1023u]=0u;
    }
    GroupMemoryBarrierWithGroupSync();
    [loop]for(uint stride=512u;stride!=0u;stride>>=1u)
    {
        [unroll]for(uint item=0u;item<2u;item++)
        {
            uint index=(lane+item*256u+1u)*(2u*stride)-1u;
            if(index<1024u)
            {
                uint left=m8FlowerDirtyPrefix[index-stride];
                m8FlowerDirtyPrefix[index-stride]=m8FlowerDirtyPrefix[index];
                m8FlowerDirtyPrefix[index]+=left;
            }
        }
        GroupMemoryBarrierWithGroupSync();
    }
    [unroll]for(uint item=0u;item<4u;item++)
    {
        uint index=lane+item*256u,first=m8FlowerDirtyPrefix[index];
        uint bits=m8FlowerDirtyWords[index];
        if(first>=m8FlowerDirtyBatchCount || bits==0u)continue;
        uint word=(m8FlowerDirtyCursor+index)&1023u,selected=0u,remaining=bits;
        uint accepted=min(countbits(bits),m8FlowerDirtyBatchCount-first);
        [loop]for(uint ordinal=0u;ordinal<accepted;ordinal++)
        {
            uint bit=(uint)firstbitlow(remaining);remaining&=remaining-1u;selected|=1u<<bit;
        }
        uint previous;
        _M8FlowerPageDirectory.InterlockedAnd(M8_FLOWER_PAGE_DIRTY_BITS+word*4u,~selected,previous);
        remaining=selected;
        [loop]for(uint ordinal=0u;ordinal<accepted;ordinal++)
        {
            uint bit=(uint)firstbitlow(remaining);remaining&=remaining-1u;
            uint slot=word*32u+bit,address=M8FlowerBatchRecord(first+ordinal);
            uint state=(previous&(1u<<bit))!=0u?M8_FLOWER_BATCH_ITEM_CLAIMED:M8_FLOWER_BATCH_ITEM_ABORT;
            _M8FlowerPageDirectory.Store4(address,uint4(slot,M8LoadTileRuntimeRead(slot).w,
                _M8FlowerPageDirectory.Load(M8_FLOWER_PAGE_AUX_BASE+slot*32u),state));
            _M8FlowerPageDirectory.Store4(address+16u,uint4(0u,0u,0u,0u));
            _M8FlowerPageDirectory.Store4(address+32u,uint4(0u,0u,0u,0u));
            _M8FlowerPageDirectory.Store4(address+48u,uint4(0u,0u,0u,0u));
        }
        if(first+accepted==m8FlowerDirtyBatchCount)
            _M8FlowerPageDirectory.Store(M8_FLOWER_DIRTY_CURSOR,((word+1u)&1023u)<<5u);
        // Clear a summary hint first, then recheck its leaf. Concurrent ORs
        // can produce stale-positive hints, never lose a live dirty leaf.
        uint ignored,group=word>>5u;
        _M8FlowerPageDirectory.InterlockedAnd(M8_FLOWER_PAGE_DIRTY_SUMMARY+group*4u,
            ~(1u<<(word&31u)),ignored);
        DeviceMemoryBarrier();
        if(_M8FlowerPageDirectory.Load(M8_FLOWER_PAGE_DIRTY_BITS+word*4u)!=0u)
            _M8FlowerPageDirectory.InterlockedOr(M8_FLOWER_PAGE_DIRTY_SUMMARY+group*4u,
                1u<<(word&31u),ignored);
    }
    DeviceMemoryBarrierWithGroupSync();
    if(lane<32u)
    {
        uint ignored;
        _M8FlowerPageDirectory.InterlockedAnd(0u,~(1u<<lane),ignored);
        DeviceMemoryBarrier();
        if(_M8FlowerPageDirectory.Load(M8_FLOWER_PAGE_DIRTY_SUMMARY+lane*4u)!=0u)
            _M8FlowerPageDirectory.InterlockedOr(0u,1u<<lane,ignored);
    }
    DeviceMemoryBarrierWithGroupSync();
    if(lane==0u)
    {
        _M8FlowerPageDirectory.Store(M8_FLOWER_BATCH_COUNT,m8FlowerDirtyBatchCount);
        _M8FlowerIndirectCommands.Store4(M8_FLOWER_BATCH_DISPATCH_ARGS,
            uint4(m8FlowerDirtyBatchCount,1u,1u,0u));
    }
}

// Translation classification and a newly installed page use the same metric
// and support AABB. This helper has no residency descriptor of its own: Compact
// validates its RW-backed ref while the translation pass uses the SRV view.
uint M8FlowerClassifyTileDistance(int3 minimum)
{
    bool warm=MerkabaM8GridAabbIntersectsDistance(minimum,8,_M8WarmDistance,
        _M8CameraGridMeters,_M8GridMetricDiagonal,_M8GridMetricCross,
        MERKABA_LATTICE_STEP,MERKABA_HALF_SUPPORT);
    bool draw=warm && MerkabaM8GridAabbIntersectsDistance(minimum,8,_M8RenderDistance,
        _M8CameraGridMeters,_M8GridMetricDiagonal,_M8GridMetricCross,
        MERKABA_LATTICE_STEP,MERKABA_HALF_SUPPORT);
    bool scan=draw && MerkabaM8GridAabbIntersectsDistance(minimum,8,_M8ScanDistance,
        _M8CameraGridMeters,_M8GridMetricDiagonal,_M8GridMetricCross,
        MERKABA_LATTICE_STEP,MERKABA_HALF_SUPPORT);
    return scan?3u:(draw?2u:(warm?1u:0u));
}

void M8FlowerClearRetiredPageResidency(uint slot)
{
    M8FlowerSetPageResidency(slot,0u);
    // A retired installation cannot retain FRONT's slot-lifetime receipt.
    // Allocation/source generations remain intact for normal page retirement.
    _M8FlowerPageDirectory.Store(M8_FLOWER_PAGE_AUX_BASE+32u*slot+28u,0u);
}

// This is a storage request after the cached geometry work, not a relation
// lookup in the knot loop. Only endpoints actually requested by the reader
// can hold this page for residency; unrelated COLD halo entries cannot.
void M8FlowerRequestPageEndpoints(uint lane)
{
    if(lane>=27u || (m8FlowerHaloUnresolvedReads&(1u<<lane))==0u)return;
    int3 tile=m8FlowerHaloTile+M8FlowerHaloDelta(lane);
    if(any(tile < -268435456) || any(tile > 268435455))return;
    MerkabaM8Address address=MerkabaAddressOf(tile*8);
    uint block;
    if(!M8FindBlock(address.blockCoord,block))return;
    uint chunkRef=_M8BlockChunkRefsRead[block*512u+address.chunkLocal];
    if(chunkRef==0u || chunkRef-1u>=MERKABA_M8_CHUNK_CAPACITY)return;
    uint chunk=chunkRef-1u;
    M8QueueColdTileLoad(chunk*64u+address.tileLocal,chunk,address.tileLocal);
}

// One owner / eight carrier requests at a time. These word ranges are a
// second lifetime of BuildFaces' cell scratch, not a maximum-page cache.
// Complete root records retain J, Tag, enclosure and Classification verbatim.
#define M8_FLOWER_PACKET_ORIGINAL 0u          // 52 * (9 + 9 + 1) words
#define M8_FLOWER_PACKET_SITES 988u           // 8 * 14 * (9 + receipt)
#define M8_FLOWER_PACKET_FOOTPRINTS 2108u     // 8 * 85 words
#define M8_FLOWER_PACKET_PEERS 2788u          // 48 * uint2
#define M8_FLOWER_PACKET_TASKS 2884u          // 8 * uint4
#define M8_FLOWER_PACKET_PREFIX 2916u         // 8 * uint2
#define M8_FLOWER_PACKET_CACHE 2932u          // address, ownerRef, flags, unused
#define M8_FLOWER_PACKET_DIRECT 2936u         // +/- seen planes, conflicts, failures
#define M8_FLOWER_PACKET_CANDIDATES 2952u     // 8 * (token, child proof, receipt)
#define M8_FLOWER_PACKET_CONTROL 2976
#define M8_FLOWER_PACKET_BASES 3072
// Reached L1 ancestor bases only. Original pure bases share the original
// cache's second field; the guard receipt preserves the public raw-base value.
#if M8_FLOWER_PACKET_CONTROL + 29 > M8_FLOWER_PACKET_BASES || M8_FLOWER_PACKET_BASES + 144 * 9 > M8_FLOWER_SUPPORT_SCRATCH_WORDS
#error Flower evidence packet exceeds its shared scratch lifetime.
#endif
#define m8PacketStage m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL]
#define m8PacketChild m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+2u]
#define m8PacketSelected m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+9u]
#define m8PacketAmbiguous m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+10u]
#define m8PacketCompletion m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+11u]
#define m8PacketTarget m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+16u]
#define m8PacketValid m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+17u]
#define m8PacketOwnerValid m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+18u]
#define m8PacketOriginalKnown m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+25u]
#define m8PacketOriginalRequired m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+26u]
#define m8PacketOriginalPending m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+27u]
#define m8PacketOriginalAbsent m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+28u]
#define M8_FLOWER_PACKET_RAW_GUARD 0x20000000u
#define M8_FLOWER_PACKET_DIRECT_STAGE 0u
#define M8_FLOWER_PACKET_PREPARE_STAGE 1u
#define M8_FLOWER_PACKET_CHILD_STAGE 2u
#define M8_FLOWER_PACKET_FINAL_STAGE 3u
#define M8_FLOWER_PACKET_PEER_STAGE 4u
#define M8_FLOWER_PACKET_COVERAGE_STAGE 5u
#define M8_FLOWER_PACKET_DONE 6u
#define M8_FLOWER_PACKET_DECODE_STAGE 7u

// Invocation-private cursors, explicitly reset before each packet use.
// A speculative site read collects its dependencies; only the classifier's
// subsequent read of that exact site publishes them to the page receipt.
static uint m8FlowerPacketTask;
static uint m8FlowerPacketEndpointReceipt;
static bool m8FlowerPacketCollectEndpoints;
static uint m8FlowerPacketRawElement;

uint2 M8FlowerPacketLoad2(uint address)
{
    return uint2(m8FlowerSupportScratch[address],m8FlowerSupportScratch[address+1u]);
}
void M8FlowerPacketStore2(uint address,uint2 value)
{
    m8FlowerSupportScratch[address]=value.x;m8FlowerSupportScratch[address+1u]=value.y;
}
uint M8FlowerPacketLoadWord(uint address) { return m8FlowerSupportScratch[address]; }
void M8FlowerPacketStoreWord(uint address,uint value) { m8FlowerSupportScratch[address]=value; }
#include "MerkabaFlowerEvidencePacket.hlsl"
void M8FlowerPacketStore3(uint address,uint3 value)
{
    m8FlowerSupportScratch[address]=value.x;
    m8FlowerSupportScratch[address+1u]=value.y;
    m8FlowerSupportScratch[address+2u]=value.z;
}
uint3 M8FlowerPacketLoad3(uint address)
{
    return uint3(m8FlowerSupportScratch[address],
        m8FlowerSupportScratch[address+1u],m8FlowerSupportScratch[address+2u]);
}
void M8FlowerPacketStorePosition(uint address,float3 position)
{
    M8FlowerPacketStore3(address,asuint(position));
}
float3 M8FlowerPacketLoadPosition(uint address)
{
    return asfloat(M8FlowerPacketLoad3(address));
}

uint M8FlowerReadOriginalBasePacket(uint ownerRef,int3 owner,uint flags,uint nodeIndex,
    bool plus,float normalError,float offsetError,out M8FlowerPhaseRootEvidence root)
{
    root=(M8FlowerPhaseRootEvidence)0;root.Classification=2u;
    uint packed=m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE];
    if(packed==0xffffffffu || nodeIndex>=26u)
    {InterlockedOr(m8FlowerCompileStatus,M8_FLOWER_ARENA_INVALID);return 2u;}
    int3 localOwner=M8FlowerEndpointOwner(packed&32767u,packed>>15u);
    bool valid=all(asuint(float2(normalError,offsetError))==asuint(_M8FlowerPlaneErrorBounds));
    uint address=0u;
    if(all(owner==localOwner))
    {
        valid=valid && flags==m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE+2u];
        valid=valid && ((m8PacketOriginalKnown|m8PacketOriginalPending)&(1u<<nodeIndex))!=0u;
        address=M8_FLOWER_PACKET_ORIGINAL+19u*(2u*nodeIndex+(plus?1u:0u))+9u;
    }
    else
    {
        uint element=m8FlowerPacketRawElement;
        if(element>=52u)
        {InterlockedOr(m8FlowerCompileStatus,M8_FLOWER_ARENA_INVALID);return 2u;}
        uint sourceNode=element>>1u;
        valid=valid && nodeIndex==(sourceNode^1u) &&
            (plus?1u:0u)==(element&1u) &&
            all(owner==localOwner+M8FlowerNodeAt(sourceNode).xyz);
        address=M8_FLOWER_PACKET_SITES+10u*element;
        valid=valid && flags==m8FlowerSupportScratch[address+9u];
    }
    if(!valid){InterlockedOr(m8FlowerCompileStatus,M8_FLOWER_ARENA_INVALID);return 2u;}
    root=M8FlowerPacketLoadRoot(address);return root.Classification;
}

bool M8FlowerReadGeometryBasePacket(int3 owner,uint flags,M8FlowerGeometryNode task,
    uint rootIndex,float normalError,float offsetError,out M8FlowerPhaseRootEvidence root)
{
    root=(M8FlowerPhaseRootEvidence)0;root.Classification=2u;
    uint packed=m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE];
    if(packed==0xffffffffu || task.Level>2u || rootIndex>task.Level || task.Strand>=72u)
    {InterlockedOr(m8FlowerCompileStatus,M8_FLOWER_ARENA_INVALID);return false;}
    bool valid=all(owner==M8FlowerEndpointOwner(packed&32767u,packed>>15u)) &&
        flags==m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE+2u] &&
        all(asuint(float2(normalError,offsetError))==asuint(_M8FlowerPlaneErrorBounds));
    uint address=0u;
    if(rootIndex==0u)
    {
        uint element=m8FlowerPacketRawElement;
        if(element>=112u)
        {InterlockedOr(m8FlowerCompileStatus,M8_FLOWER_ARENA_INVALID);return false;}
        uint packetTask=element/14u;
        uint carrier=m8FlowerSupportScratch[M8_FLOWER_PACKET_TASKS+4u*packetTask];
        M8FlowerGeometryNode expected=(M8FlowerGeometryNode)0;
        bool resolved=M8FlowerL2GeometryNode(
            M8FlowerL2CarrierKnot(carrier,(element%14u)>>1u),(element&1u)!=0u,expected);
        valid=valid && resolved;
        valid=valid && task.Level==expected.Level && task.Line==expected.Line &&
            all(task.Offset==expected.Offset) && task.Plus==expected.Plus;
        address=M8_FLOWER_PACKET_SITES+10u*element;
    }
    else
    {
        M8FlowerPhaseFamilyRule family=M8FlowerGetPhaseFamily(task.Strand);
        valid=valid && (uint)M8FlowerNodeAt(family.RootNode).w==task.Line;
        if(rootIndex==1u)
        {
            valid=valid && (m8PacketOriginalKnown&(1u<<family.RootNode))!=0u;
            address=M8_FLOWER_PACKET_ORIGINAL+19u*(2u*family.RootNode+(task.Plus?1u:0u))+9u;
        }
        else
        {
            valid=valid && (m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+22u+(task.Strand>>5u)]&
                (1u<<(task.Strand&31u)))!=0u;
            address=M8_FLOWER_PACKET_BASES+9u*(2u*task.Strand+(task.Plus?1u:0u));
        }
    }
    if(!valid){InterlockedOr(m8FlowerCompileStatus,M8_FLOWER_ARENA_INVALID);return false;}
    root=M8FlowerPacketLoadRoot(address);return root.Classification==1u;
}

uint M8FlowerReadOriginalPacket(uint ownerSlot,uint ownerRef,int3 owner,uint flags,
    uint nodeIndex,bool plus,float normalError,float offsetError,
    out M8FlowerPhaseRootEvidence root,out bool provisional,
    out M8FlowerPhaseRootEvidence rawLocalBase,out uint endpointReceipt)
{
    root=(M8FlowerPhaseRootEvidence)0;root.Classification=2u;
    rawLocalBase=root;provisional=false;endpointReceipt=0u;
    uint packed=m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE];
    if(nodeIndex>=26u || packed==0xffffffffu || ownerSlot!=(packed&32767u) ||
        ownerRef!=m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE+1u] ||
        flags!=m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE+2u] ||
        any(asuint(float2(normalError,offsetError))!=asuint(_M8FlowerPlaneErrorBounds)) ||
        any(owner!=M8FlowerEndpointOwner(packed&32767u,packed>>15u)) ||
        (m8PacketOriginalKnown&(1u<<nodeIndex))==0u)
    {InterlockedOr(m8FlowerCompileStatus,M8_FLOWER_ARENA_INVALID);return 2u;}
    uint address=M8_FLOWER_PACKET_ORIGINAL+19u*(2u*nodeIndex+(plus?1u:0u));
    uint status=M8FlowerPacketReadOriginal(address,root,rawLocalBase,provisional,endpointReceipt);
    uint control=m8FlowerSupportScratch[address+18u];
    if((control&M8_FLOWER_PACKET_RAW_GUARD)!=0u)
    {
        rawLocalBase=(M8FlowerPhaseRootEvidence)0;
        rawLocalBase.Classification=(control>>27u)&3u;
    }
    if(m8FlowerPacketCollectEndpoints)
    {
        m8FlowerPacketEndpointReceipt|=endpointReceipt;
        endpointReceipt=0u;
    }
    return status;
}

bool M8FlowerReadCarrierSitePacket(uint slot,uint local,uint ownerRef,int3 owner,uint flags,
    uint carrier,uint site,bool plus,float2 errors,out M8FlowerPhaseRootEvidence root)
{
    root=(M8FlowerPhaseRootEvidence)0;root.Classification=2u;
    uint task=m8FlowerPacketTask;
    if(task>=8u || site>=7u || (m8PacketValid&(1u<<task))==0u ||
        m8FlowerSupportScratch[M8_FLOWER_PACKET_TASKS+4u*task]!=carrier ||
        m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE]!=(slot|(local<<15u)) ||
        ownerRef!=m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE+1u] ||
        flags!=m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE+2u] ||
        any(asuint(errors)!=asuint(_M8FlowerPlaneErrorBounds)))
    {InterlockedOr(m8FlowerCompileStatus,M8_FLOWER_ARENA_INVALID);return false;}
    uint address=M8_FLOWER_PACKET_SITES+10u*(14u*task+2u*site+(plus?1u:0u));
    uint receipt;bool read=M8FlowerPacketReadSite(address,root,receipt);
    if(m8FlowerPacketCollectEndpoints)m8FlowerPacketEndpointReceipt|=receipt;
    else M8FlowerRequireEndpointReceipt(receipt);
    return read;
}

void M8FlowerReadCarrierAlternatives(uint slot,uint local,uint carrier,float2 errors,
    uint completion,out uint2 certain,out uint2 uncertain,out uint2 direct)
{
    certain=direct=0u;uncertain=uint2(0xffffffffu,65535u);
    uint task=m8FlowerPacketTask;
    if(task>=8u || (m8PacketValid&(1u<<task))==0u ||
        m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE]!=(slot|(local<<15u)) ||
        m8FlowerSupportScratch[M8_FLOWER_PACKET_TASKS+4u*task]!=carrier ||
        m8FlowerSupportScratch[M8_FLOWER_PACKET_TASKS+4u*task+1u]!=completion ||
        any(asuint(errors)!=asuint(_M8FlowerPlaneErrorBounds)))
    {InterlockedOr(m8FlowerCompileStatus,M8_FLOWER_ARENA_INVALID);return;}
    uint first=6u*task;
    certain=uint2(m8FlowerDecodeTriples[first],m8FlowerDecodeTriples[first+1u]);
    uncertain=uint2(m8FlowerDecodeTriples[first+2u],m8FlowerDecodeTriples[first+3u]);
    direct=uint2(m8FlowerDecodeTriples[first+4u],m8FlowerDecodeTriples[first+5u]);
}

bool M8FlowerReadCarrierSiteSupport(uint slot,uint local,uint ownerRef,int3 owner,uint flags,
    uint carrier,uint site,bool plus,float2 errors,out M8FlowerInterval3 bounds,
    out uint proofTag,out uint classification)
{
    bounds=(M8FlowerInterval3)0;proofTag=0u;classification=2u;
    M8FlowerPhaseRootEvidence root;
    bool read=M8FlowerReadCarrierSitePacket(slot,local,ownerRef,owner,flags,
        carrier,site,plus,errors,root);
    classification=root.Classification;
    if(!read)return false;
    uint index=14u*m8FlowerPacketTask+2u*site+(plus?1u:0u);
    if((m8FlowerSupportScratch[M8_FLOWER_PACKET_SITES+10u*index+9u]&0x40000000u)==0u)return false;
    uint2 x=m8FlowerPageOwnerSpans[3u*index],y=m8FlowerPageOwnerSpans[3u*index+1u],
        z=m8FlowerPageOwnerSpans[3u*index+2u];
    bounds.x=M8FlowerI(asfloat(x.x),asfloat(x.y));
    bounds.y=M8FlowerI(asfloat(y.x),asfloat(y.y));
    bounds.z=M8FlowerI(asfloat(z.x),asfloat(z.y));
    proofTag=m8FlowerDecodeProofTags[index];
    return true;
}

// The fan-out is invocation work, not a six-wedge/eight-sign loop on one
// carrier lane. All writes are exact integer unions. No camera or CPU input.
void M8FlowerDecodeCarrierBatch(uint lane)
{
    if(m8PacketValid==0u)return;
    uint packed=m8PacketTarget,slot=packed&32767u,local=packed>>15u;
    int3 owner=M8FlowerEndpointOwner(slot,local);
    uint ownerRef=m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE+1u];
    uint flags=m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE+2u];
    if(lane<48u)m8FlowerDecodeTriples[lane]=0u;
    if(lane<112u && (m8PacketValid&(1u<<(lane/14u)))!=0u)
    {
        uint task=lane/14u,site=(lane%14u)>>1u;
        uint carrier=m8FlowerSupportScratch[M8_FLOWER_PACKET_TASKS+4u*task];
        M8FlowerPhaseRootEvidence root;uint receipt;
        uint address=M8_FLOWER_PACKET_SITES+10u*lane;
        bool read=M8FlowerPacketReadSite(address,root,receipt);
        M8FlowerInterval3 bounds;uint tag;
        bool known=M8FlowerSiteSupport(M8FlowerL2CarrierKnot(carrier,site),root,read,bounds,tag);
        // Owner prefix and site-support intervals have disjoint lifetimes.
        // Cache these once, not once for each triple using the same knot.
        m8FlowerPageOwnerSpans[3u*lane]=asuint(float2(bounds.x.lo,bounds.x.hi));
        m8FlowerPageOwnerSpans[3u*lane+1u]=asuint(float2(bounds.y.lo,bounds.y.hi));
        m8FlowerPageOwnerSpans[3u*lane+2u]=asuint(float2(bounds.z.lo,bounds.z.hi));
        m8FlowerDecodeProofTags[lane]=tag;
        m8FlowerSupportScratch[address+9u]=(m8FlowerSupportScratch[address+9u]&~0x40000000u)|
            (known?0x40000000u:0u);
    }
    if(lane<144u && (m8PacketValid&(1u<<(lane/18u)))!=0u)
    {
        uint task=lane/18u,wedge=(lane/3u)%6u,anchor=lane%3u;
        uint carrier=m8FlowerSupportScratch[M8_FLOWER_PACKET_TASKS+4u*task];
        uint completion=m8FlowerSupportScratch[M8_FLOWER_PACKET_TASKS+4u*task+1u];
        uint petal=M8FlowerL2WedgeAt(6u*carrier+wedge).y>>4u;
        m8FlowerPacketCollectEndpoints=true;m8FlowerPacketEndpointReceipt=0u;
        uint available,uncertain,direct;
        M8FlowerSourceAnchorAlternatives(slot,ownerRef,owner,flags,petal,anchor,
            _M8FlowerPlaneErrorBounds,completion,available,uncertain,direct);
        m8FlowerPacketCollectEndpoints=false;
        uint high=uncertain|direct;
        m8FlowerDecodeAnchors[lane]=(available&1u)|((available&2u)<<1u)|
            ((high&1u)<<1u)|((high&2u)<<2u)|(m8FlowerPacketEndpointReceipt<<4u);
    }
    GroupMemoryBarrierWithGroupSync();
    if(lane<48u && (m8PacketValid&(1u<<(lane/6u)))!=0u)
    {
        uint task=lane/6u,wedge=lane%6u,receipt=0u;
        bool possible=true;
        [unroll]for(uint anchor=0u;anchor<3u;anchor++)
        {
            uint evidence=m8FlowerDecodeAnchors[3u*lane+anchor];
            if(possible)receipt|=evidence>>4u;
            possible=possible && (evidence&15u)!=0u;
        }
        if(possible)
        {
            uint3 sites=M8FlowerL2CarrierTriangle(wedge,false);
            [unroll]for(uint vertex=0u;vertex<3u;vertex++)
                [unroll]for(uint sign=0u;sign<2u;sign++)
                    receipt|=m8FlowerSupportScratch[M8_FLOWER_PACKET_SITES+
                        10u*(14u*task+2u*sites[vertex]+sign)+9u]&M8_FLOWER_PACKET_RECEIPT_MASK;
        }
        M8FlowerRequireEndpointReceipt(receipt);
    }
    float3 normal;float delta;M8FlowerUnpackPlane(flags,normal,delta);
    [loop]for(uint item=lane;item<8u*6u*8u;item+=256u)
    {
        uint task=item/48u,wedge=(item>>3u)%6u,triple=item&7u;
        if((m8PacketValid&(1u<<task))==0u)continue;
        uint first=(task*6u+wedge)*3u;
        uint3 anchor=uint3(m8FlowerDecodeAnchors[first],
            m8FlowerDecodeAnchors[first+1u],m8FlowerDecodeAnchors[first+2u]);
        uint3 available=(anchor&1u)|((anchor>>1u)&2u);
        uint3 high=((anchor>>1u)&1u)|((anchor>>2u)&2u);
        uint carrier=m8FlowerSupportScratch[M8_FLOWER_PACKET_TASKS+4u*task];
        m8FlowerPacketTask=task;
        m8FlowerPacketCollectEndpoints=true;m8FlowerPacketEndpointReceipt=0u;
        uint result=M8FlowerClassifyCarrierTriple(slot,local,ownerRef,owner,flags,
            carrier,wedge,triple,_M8FlowerPlaneErrorBounds,normal,
            available,high&~available,high&available);
        m8FlowerPacketCollectEndpoints=false;
        uint address=task*6u+(wedge>>2u),bit=1u<<(8u*(wedge&3u)+triple);
        if((result&1u)!=0u)InterlockedOr(m8FlowerDecodeTriples[address],bit);
        if((result&2u)!=0u)InterlockedOr(m8FlowerDecodeTriples[address+2u],bit);
        if((result&4u)!=0u)InterlockedOr(m8FlowerDecodeTriples[address+4u],bit);
    }
    GroupMemoryBarrierWithGroupSync();
}

uint M8FlowerSelectNode(uint mask,uint ordinal)
{
    [loop]for(uint i=0u;i<ordinal;i++)mask&=mask-1u;
    return (uint)firstbitlow(mask);
}

uint M8FlowerSelectStrand(uint ordinal)
{
    [unroll]for(uint word=0u;word<3u;word++)
    {
        uint bits=m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+22u+word];
        uint count=countbits(bits);
        if(ordinal<count)return 32u*word+M8FlowerSelectNode(bits,ordinal);
        ordinal-=count;
    }
    return 72u;
}

// R1 selects source incidence first; subsequent shells are reached only by
// its survivors. Carrier batches request their own anchors/inherited knots
// and present ancestor phases. Independent requested relations occupy lanes;
// an address outside these masks is never evaluated or silently read as zero.
void M8FlowerPacketAcquire(uint packed,bool sites,uint lane)
{
    bool originals=m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE]!=packed;
    GroupMemoryBarrierWithGroupSync();
    uint slot=packed&32767u,local=packed>>15u;
    int3 owner=M8FlowerEndpointOwner(slot,local);
    if(lane==0u && originals)
    {
        m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE]=packed;
        m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE+1u]=M8FlowerFindOwner(slot,local,
            M8FlowerEndpointGeneration(slot));
        m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE+2u]=M8LoadKernelStateRead(slot,local).flags;
        m8PacketOriginalKnown=0u;m8PacketOriginalAbsent=0u;
    }
    if(lane<3u)
        m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+22u+lane]=0u;
    if(lane==0u)m8PacketOriginalRequired=0u;
    GroupMemoryBarrierWithGroupSync();
    uint ownerRef=m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE+1u];
    uint flags=m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE+2u];
    uint epoch=M8FlowerGetOwnerEpoch(ownerRef);
    bool decode=m8PacketStage==M8_FLOWER_PACKET_DECODE_STAGE;
    if(sites && lane<8u && (m8PacketValid&(1u<<lane))!=0u)
    {
        uint carrier=m8FlowerSupportScratch[M8_FLOWER_PACKET_TASKS+4u*lane];
        InterlockedOr(m8PacketOriginalRequired,M8FlowerDecodeCarrierPetalsAt(carrier).z);
    }
    if(m8PacketStage==M8_FLOWER_PACKET_PREPARE_STAGE && lane<8u)
    {
        uint petal=m8FlowerSupportScratch[M8_FLOWER_PACKET_CANDIDATES+3u*lane];
        if(petal!=0xffffffffu)
        {
            uint3 nodes=M8FlowerPetalNodesAt(petal).xyz;
            uint required=(1u<<nodes.x)|(1u<<nodes.y)|(1u<<nodes.z);
            uint parity=((uint)owner.x&1u)|(((uint)owner.y&1u)<<1u)|(((uint)owner.z&1u)<<2u);
            [unroll]for(uint axis=0u;axis<4u;axis++)
            {
                uint node=2u*(uint)M8FlowerTetraLineAt(parity)[axis]+
                    (M8FlowerTetraEtaAt(parity)[axis]<0?1u:0u);
                required|=1u<<node;
            }
            InterlockedOr(m8PacketOriginalRequired,required);
        }
    }
    if(sites && lane<112u && (m8PacketValid&(1u<<(lane/14u)))!=0u)
    {
        uint carrier=m8FlowerSupportScratch[M8_FLOWER_PACKET_TASKS+4u*(lane/14u)];
        uint knot=M8FlowerL2CarrierKnot(carrier,(lane%14u)>>1u);
        uint begin=M8FlowerL2IncidenceOffsetsAt(knot),end=M8FlowerL2IncidenceOffsetsAt(knot+1u);
        [loop]for(uint incidence=begin;incidence<end;incidence++)
        {
            M8FlowerGeometryNode node;
            if(!M8FlowerL2GeometryNodeFromSource(M8FlowerL2IncidenceSourcesAt(incidence),
                (lane&1u)!=0u,node))continue;
            if(node.Level==0u)
            {
                InterlockedOr(m8PacketOriginalRequired,1u<<node.RootNode);continue;
            }
            M8FlowerPhaseFamilyRule family=M8FlowerGetPhaseFamily(node.Strand);
            uint petal=family.RootIncidentPetals.x!=0u?(uint)firstbitlow(family.RootIncidentPetals.x):
                32u+(uint)firstbitlow(family.RootIncidentPetals.y);
            if(M8FlowerHasPhaseFamily(ownerRef,epoch,0u,0u,petal,node.Line,node.Plus))
                InterlockedOr(m8PacketOriginalRequired,1u<<family.RootNode);
            if(node.Level==2u && M8FlowerHasPhaseFamily(ownerRef,epoch,1u,family.FinePath0,
                M8FlowerStrandAt(node.Strand).w&255u,node.Line,node.Plus))
                InterlockedOr(m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+22u+(node.Strand>>5u)],
                    1u<<(node.Strand&31u));
        }
    }
    GroupMemoryBarrierWithGroupSync();
    [loop]for(uint shell=0u;shell<(decode?3u:1u);shell++)
    {
        if(decode)
        {
            if(lane==0u)
            {
                m8PacketOriginalRequired=shell==0u?63u:0u;
                m8FlowerReachedCarriers=M8FlowerReachedCarriers(m8PacketOriginalAbsent);
            }
            GroupMemoryBarrierWithGroupSync();
            if(shell!=0u && lane<128u &&
                (m8FlowerReachedCarriers[lane>>5u]&(1u<<(lane&31u)))!=0u)
            {
                uint shellMask=shell==1u?0x0003ffc0u:0x03fc0000u;
                InterlockedOr(m8PacketOriginalRequired,M8FlowerDecodeCarrierPetalsAt(lane).z&shellMask);
            }
            GroupMemoryBarrierWithGroupSync();
        }
        if(lane==0u)m8PacketOriginalPending=m8PacketOriginalRequired&~m8PacketOriginalKnown;
        GroupMemoryBarrierWithGroupSync();
        uint originalCount=2u*countbits(m8PacketOriginalPending);
        uint element=0u;
        if(lane<originalCount)element=2u*M8FlowerSelectNode(m8PacketOriginalPending,lane>>1u)+(lane&1u);
        uint strandCount=countbits(m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+22u])+
            countbits(m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+23u])+
            countbits(m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+24u]);
        [loop]for(uint phase=0u;phase<(sites?5u:3u);phase++)
        {
            uint sourceFlags=flags,level=0u,lineClass=0u,destination=0u;
            int3 sourceOwner=owner,offset=0;bool plus=false,evaluate=false;
            if(phase==0u)
            {
                if(lane<originalCount)
                {
                    plus=(element&1u)!=0u;
                    int4 node=M8FlowerNodeAt(element>>1u);
                    offset=node.xyz;lineClass=(uint)node.w;evaluate=true;
                    destination=M8_FLOWER_PACKET_ORIGINAL+19u*element+9u;
                }
                else if(lane<originalCount+2u*strandCount)
                {
                    uint item=lane-originalCount,strand=M8FlowerSelectStrand(item>>1u);
                    plus=(item&1u)!=0u;
                    uint4 edge=M8FlowerStrandAt(strand);
                    M8FlowerPhaseFamilyRule family=M8FlowerGetPhaseFamily(strand);
                    offset=M8FlowerNodeAt(edge.x).xyz+M8FlowerNodeAt(edge.y).xyz;
                    level=1u;lineClass=(uint)M8FlowerNodeAt(family.RootNode).w;evaluate=true;
                    destination=M8_FLOWER_PACKET_BASES+9u*(2u*strand+(plus?1u:0u));
                }
            }
            else if(phase==1u && lane<originalCount)
            {
                uint nodeIndex=element>>1u;
                if(m8FlowerSupportScratch[M8_FLOWER_PACKET_ORIGINAL+19u*element+17u]==1u)
                {
                    sourceOwner=owner+M8FlowerNodeAt(nodeIndex).xyz;plus=(element&1u)!=0u;
                    uint peerSlot,peerLocal,unusedReceipt;KernelState peerState;
                    uint status=M8FlowerReadEndpointWithReceipt(slot,owner,sourceOwner,
                        peerSlot,peerLocal,peerState,unusedReceipt);
                    destination=M8_FLOWER_PACKET_SITES+10u*element;
                    m8FlowerSupportScratch[destination+9u]=peerState.flags;
                    if(status==1u)
                    {
                        int4 node=M8FlowerNodeAt(nodeIndex^1u);
                        offset=node.xyz;lineClass=(uint)node.w;sourceFlags=peerState.flags;evaluate=true;
                    }
                }
            }
            else if(phase==3u && lane<112u && (m8PacketValid&(1u<<(lane/14u)))!=0u)
            {
                uint carrier=m8FlowerSupportScratch[M8_FLOWER_PACKET_TASKS+4u*(lane/14u)];
                uint knot=M8FlowerL2CarrierKnot(carrier,(lane%14u)>>1u);
                M8FlowerGeometryNode node;
                plus=(lane&1u)!=0u;
                if(M8FlowerL2GeometryNode(knot,plus,node))
                {
                    level=node.Level;offset=node.Offset;lineClass=node.Line;evaluate=level!=0u;
                    destination=M8_FLOWER_PACKET_SITES+10u*lane;
                }
                else InterlockedOr(m8FlowerCompileStatus,M8_FLOWER_ARENA_INVALID);
            }
            if(evaluate)
            {
                M8FlowerPhaseRootEvidence root;
                M8FlowerCarrierRootProof(sourceOwner,sourceFlags,level,offset,lineClass,plus,
                    _M8FlowerPlaneErrorBounds.x,_M8FlowerPlaneErrorBounds.y,root);
                M8FlowerPacketStoreRoot(destination,root);
            }
            GroupMemoryBarrierWithGroupSync();
            if(phase==2u && lane<originalCount)
            {
                m8FlowerPacketRawElement=element;
                M8FlowerPhaseRootEvidence root,raw;bool provisional;uint receipt;
                M8FlowerEvaluateOriginalShared(slot,ownerRef,owner,flags,element>>1u,(element&1u)!=0u,
                    _M8FlowerPlaneErrorBounds.x,_M8FlowerPlaneErrorBounds.y,root,provisional,raw,receipt);
                uint address=M8_FLOWER_PACKET_ORIGINAL+19u*element;
                M8FlowerPacketStoreRoot(address,root);
                uint required=M8_FLOWER_OCCUPIED_FLAG|M8_FLOWER_PLANE_VALID;
                bool guarded=(flags&(required|M8_FLOWER_SEED_FLAG))!=required;
                m8FlowerSupportScratch[address+18u]=(receipt&M8_FLOWER_PACKET_RECEIPT_MASK)|
                    (provisional?M8_FLOWER_PACKET_CONTROL_BIT:0u)|
                    (guarded?M8_FLOWER_PACKET_RAW_GUARD|(raw.Classification<<27u):0u);
            }
            GroupMemoryBarrierWithGroupSync();
            if(phase==2u)
            {
                if(lane==0u)m8PacketOriginalKnown|=m8PacketOriginalPending;
                if(lane<26u && (m8PacketOriginalPending&(1u<<lane))!=0u)
                {
                    uint address=M8_FLOWER_PACKET_ORIGINAL+38u*lane;
                    if(m8FlowerSupportScratch[address+8u]==0u &&
                        m8FlowerSupportScratch[address+27u]==0u)
                        InterlockedOr(m8PacketOriginalAbsent,1u<<lane);
                }
            }
            if(phase==4u && lane<112u && (m8PacketValid&(1u<<(lane/14u)))!=0u)
            {
                uint carrier=m8FlowerSupportScratch[M8_FLOWER_PACKET_TASKS+4u*(lane/14u)];
                m8FlowerPacketRawElement=lane;
                m8FlowerPacketCollectEndpoints=true;m8FlowerPacketEndpointReceipt=0u;
                M8FlowerPhaseRootEvidence root;
                bool read=M8FlowerReadL2Knot(slot,ownerRef,owner,flags,
                    M8FlowerL2CarrierKnot(carrier,(lane%14u)>>1u),(lane&1u)!=0u,
                    _M8FlowerPlaneErrorBounds.x,_M8FlowerPlaneErrorBounds.y,root);
                m8FlowerPacketCollectEndpoints=false;
                M8FlowerPacketStoreSite(M8_FLOWER_PACKET_SITES+10u*lane,root,read,m8FlowerPacketEndpointReceipt);
            }
            GroupMemoryBarrierWithGroupSync();
        }
    }
}

// Commutative sign receipts: different actual signs conflict, independent of
// lane scheduling. A conflicting source petal is removed before completion.
void M8FlowerPacketRecordDirect(uint carrier,uint direct,M8FlowerPhaseRootEvidence roots[7])
{
    M8FlowerDirectAnchors delta;M8FlowerResetDirectAnchors(delta);
    M8FlowerRecordDirectAnchors(carrier,direct,roots,delta);
    [unroll]for(uint anchor=0u;anchor<3u;anchor++)
        [unroll]for(uint word=0u;word<2u;word++)
        {
            uint seen=delta.Seen[anchor][word],positive=delta.Signs[anchor][word]&seen;
            InterlockedOr(m8FlowerSupportScratch[M8_FLOWER_PACKET_DIRECT+2u*anchor+word],positive);
            InterlockedOr(m8FlowerSupportScratch[M8_FLOWER_PACKET_DIRECT+6u+2u*anchor+word],seen&~positive);
        }
    [unroll]for(uint word=0u;word<2u;word++)
        InterlockedOr(m8FlowerSupportScratch[M8_FLOWER_PACKET_DIRECT+12u+word],delta.Conflict[word]);
    [unroll]for(uint wedge=0u;wedge<6u;wedge++)if((direct&(1u<<wedge))==0u)
    {
        uint petal=M8FlowerL2WedgeAt(6u*carrier+wedge).y>>4u;
        InterlockedOr(m8FlowerSupportScratch[M8_FLOWER_PACKET_DIRECT+14u+(petal>>5u)],1u<<(petal&31u));
    }
}

M8FlowerDirectAnchors M8FlowerPacketDirectAnchors()
{
    M8FlowerDirectAnchors receipt;receipt.Conflict=M8FlowerPacketLoad2(M8_FLOWER_PACKET_DIRECT+12u);
    [unroll]for(uint anchor=0u;anchor<3u;anchor++)
    {
        uint2 positive=M8FlowerPacketLoad2(M8_FLOWER_PACKET_DIRECT+2u*anchor);
        uint2 negative=M8FlowerPacketLoad2(M8_FLOWER_PACKET_DIRECT+6u+2u*anchor);
        receipt.Signs[anchor]=positive;receipt.Seen[anchor]=positive|negative;
        receipt.Conflict|=positive&negative;
    }
    return receipt;
}

// Lane zero schedules only fixed petal ordinals. All eight candidates finish
// against immutable D; their children remain ordered, so a proved impossible
// child cannot request endpoint residency for a later, unneeded child.
void M8FlowerPacketScheduleCandidates(uint packed,bool coverageOnly)
{
    uint2 pending=M8FlowerPacketLoad2(M8_FLOWER_PACKET_CONTROL+3u);
    if(any(pending!=0u))
    {
        [unroll]for(uint task=0u;task<8u;task++)
        {
            uint token=0xffffffffu;
            if(any(pending!=0u))
            {
                uint word=pending.x!=0u?0u:1u;
                token=32u*word+(uint)firstbitlow(pending[word]);
                pending[word]&=pending[word]-1u;
            }
            uint address=M8_FLOWER_PACKET_CANDIDATES+3u*task;
            m8FlowerSupportScratch[address]=token;
            m8FlowerSupportScratch[address+1u]=0u;
            m8FlowerSupportScratch[address+2u]=0u;
        }
        M8FlowerPacketStore2(M8_FLOWER_PACKET_CONTROL+3u,pending);
        m8PacketTarget=packed;m8PacketStage=M8_FLOWER_PACKET_PREPARE_STAGE;
        return;
    }
    uint2 direct=M8FlowerPacketLoad2(M8_FLOWER_PACKET_CONTROL+5u);
    uint2 proven=M8FlowerPacketLoad2(M8_FLOWER_PACKET_CONTROL+7u);
    uint2 candidates=M8FlowerCompletionCandidates(direct,proven,proven,proven,proven,uint2(0u,0u));
    uint selected,status=M8FlowerUniqueCompletion(candidates,selected);
    if(m8PacketAmbiguous!=0u)status=2u;
    m8PacketCompletion=status==1u && selected==(m8PacketSelected&63u)?m8PacketSelected:0xffffffffu;
    if(!coverageOnly)
    {
        _M8FlowerPageDirectory.Store(M8FlowerBatchScratch(m8FlowerCompileItem)+
            M8_FLOWER_BATCH_COMPLETION+(packed>>15u)*4u,m8PacketCompletion);
        if(status==2u)
        {
            InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_UNRESOLVED],1u);
            InterlockedAdd(_M8Counters[M8_COUNTER_REFINEMENT_UNRESOLVED],1u);
        }
    }
    m8FlowerPendingCarriers=m8FlowerReachedCarriers;
    if(m8PacketCompletion!=0xffffffffu)
        m8FlowerPendingCarriers|=M8FlowerDecodePetalCarriersAt(m8PacketCompletion&63u);
    m8PacketTarget=packed;m8PacketStage=M8_FLOWER_PACKET_FINAL_STAGE;
}

void M8FlowerPacketTasks(uint packed)
{
    m8PacketValid=0u;
    if(m8PacketStage==M8_FLOWER_PACKET_PEER_STAGE)
    {
        uint2 pending=M8FlowerPacketLoad2(M8_FLOWER_PACKET_CONTROL+12u);
        if(!any(pending!=0u)){m8PacketStage=M8_FLOWER_PACKET_COVERAGE_STAGE;return;}
        uint first=pending.x!=0u?(uint)firstbitlow(pending.x):32u+(uint)firstbitlow(pending.y);
        uint target=m8FlowerSupportScratch[M8_FLOWER_PACKET_PEERS+2u*first],task=0u;
        // Equality of a generation-leased physical address only schedules the
        // exact generated requests. It neither matches geometry nor chooses a
        // root. At most 48 requests / eight outputs; no hash or queue resource.
        [loop]for(uint request=0u;request<48u && task<8u;request++)
        {
            uint bit=1u<<(request&31u),word=request>>5u;
            if((pending[word]&bit)==0u ||
                m8FlowerSupportScratch[M8_FLOWER_PACKET_PEERS+2u*request]!=target)continue;
            uint metadata=m8FlowerSupportScratch[M8_FLOWER_PACKET_PEERS+2u*request+1u];
            uint address=M8_FLOWER_PACKET_TASKS+4u*task;
            m8FlowerSupportScratch[address]=(metadata&1023u)/6u;
            m8FlowerSupportScratch[address+1u]=0xffffffffu;
            m8FlowerSupportScratch[address+2u]=0u;
            m8FlowerSupportScratch[address+3u]=request;
            pending[word]&=~bit;m8PacketValid|=1u<<task;task++;
        }
        M8FlowerPacketStore2(M8_FLOWER_PACKET_CONTROL+12u,pending);
        m8PacketTarget=target;return;
    }
    m8PacketTarget=packed;
    if(m8PacketStage==M8_FLOWER_PACKET_PREPARE_STAGE ||
        m8PacketStage==M8_FLOWER_PACKET_COVERAGE_STAGE ||
        m8PacketStage==M8_FLOWER_PACKET_DECODE_STAGE)return;
    [unroll]for(uint task=0u;task<8u;task++)
    {
        uint carrier=0u,completion=0xffffffffu,required=0u,source=0u;
        if(m8PacketStage==M8_FLOWER_PACKET_CHILD_STAGE)
        {
            uint candidate=M8_FLOWER_PACKET_CANDIDATES+3u*task;
            if(m8FlowerSupportScratch[candidate+1u]==0u)continue;
            completion=m8FlowerSupportScratch[candidate];
            source=M8FlowerL2SourceToWedgeAt(16u*(completion&63u)+m8PacketChild);
            carrier=source/6u;required=1u<<(source%6u);
        }
        else
        {
            if(all(m8FlowerPendingCarriers==0u))continue;
            uint word=m8FlowerPendingCarriers.x!=0u?0u:
                m8FlowerPendingCarriers.y!=0u?1u:m8FlowerPendingCarriers.z!=0u?2u:3u;
            carrier=32u*word+(uint)firstbitlow(m8FlowerPendingCarriers[word]);
            m8FlowerPendingCarriers[word]&=m8FlowerPendingCarriers[word]-1u;
            if(m8PacketStage==M8_FLOWER_PACKET_FINAL_STAGE)completion=m8PacketCompletion;
            required=M8FlowerL2CarrierOwnedMask(carrier);
        }
        uint address=M8_FLOWER_PACKET_TASKS+4u*task;
        m8FlowerSupportScratch[address]=carrier;m8FlowerSupportScratch[address+1u]=completion;
        m8FlowerSupportScratch[address+2u]=required;m8FlowerSupportScratch[address+3u]=source;
        m8PacketValid|=1u<<task;
    }
}

// All lanes cooperate on an occupied owner. Generated source incidence
// requests only reached roots; shared values are reused by later batches.
// Unknown anchors cannot exclude a carrier.
uint2 M8FlowerCompileOwner(uint slot,uint local,bool emit,bool coverageOnly,
    M8FlowerPageBuild build,uint2 first,uint lane)
{
    uint packed=slot|(local<<15u);
    if(lane==0u)
    {
        uint flags=M8LoadKernelStateRead(slot,local).flags;
        uint required=M8_FLOWER_OCCUPIED_FLAG|M8_FLOWER_PLANE_VALID;
        m8PacketOwnerValid=(flags&(required|M8_FLOWER_SEED_FLAG))==required?1u:0u;
    }
    GroupMemoryBarrierWithGroupSync();
    if(m8PacketOwnerValid==0u)return 0u;
    if(lane<16u)m8FlowerSupportScratch[M8_FLOWER_PACKET_DIRECT+lane]=0u;
    if(lane==0u)
    {
        m8FlowerSupportScratch[M8_FLOWER_PACKET_CACHE]=0xffffffffu;
        M8FlowerPacketStore2(M8_FLOWER_PACKET_CONTROL+3u,0u);
        M8FlowerPacketStore2(M8_FLOWER_PACKET_CONTROL+5u,0u);
        M8FlowerPacketStore2(M8_FLOWER_PACKET_CONTROL+7u,0u);
        M8FlowerPacketStore2(M8_FLOWER_PACKET_CONTROL+12u,0u);
        M8FlowerPacketStore2(M8_FLOWER_PACKET_CONTROL+14u,0u);
        m8PacketSelected=0xffffffffu;m8PacketAmbiguous=0u;
        m8PacketCompletion=emit?_M8FlowerPageDirectory.Load(M8FlowerBatchScratch(m8FlowerCompileItem)+
            M8_FLOWER_BATCH_COMPLETION+local*4u):0xffffffffu;
        m8PacketChild=0u;
        m8FlowerReachedCarriers=0u;m8FlowerPendingCarriers=0u;
        m8PacketStage=M8_FLOWER_PACKET_DECODE_STAGE;
    }
    m8FlowerPacketCollectEndpoints=false;m8FlowerPacketEndpointReceipt=0u;m8FlowerPacketTask=0u;
    GroupMemoryBarrierWithGroupSync();
    [loop]while(m8PacketStage!=M8_FLOWER_PACKET_DONE)
    {
        if(lane==0u)M8FlowerPacketTasks(packed);
        GroupMemoryBarrierWithGroupSync();
        uint stage=m8PacketStage;
        if(stage!=M8_FLOWER_PACKET_COVERAGE_STAGE)
            M8FlowerPacketAcquire(m8PacketTarget,
                stage!=M8_FLOWER_PACKET_PREPARE_STAGE &&
                stage!=M8_FLOWER_PACKET_DECODE_STAGE && m8PacketValid!=0u,lane);
        M8FlowerDecodeCarrierBatch(lane);

        if(stage==M8_FLOWER_PACKET_DECODE_STAGE)
        {
            if(lane==0u)
            {
                m8FlowerReachedCarriers=M8FlowerReachedCarriers(m8PacketOriginalAbsent);
                m8FlowerPendingCarriers=m8FlowerReachedCarriers;
                if(emit && m8PacketCompletion!=0xffffffffu)
                    m8FlowerPendingCarriers|=M8FlowerDecodePetalCarriersAt(m8PacketCompletion&63u);
            }
            GroupMemoryBarrierWithGroupSync();
            if(lane<128u && (m8FlowerReachedCarriers[lane>>5u]&(1u<<(lane&31u)))==0u)
            {
                // No child evaluator or dual query: this carrier's original
                // source is already impossible. Its whole-parent direct
                // coverage cannot be claimed by simply skipping its children.
                uint2 failed=M8FlowerDecodeCarrierPetalsAt(lane).xy;
                InterlockedOr(m8FlowerSupportScratch[M8_FLOWER_PACKET_DIRECT+14u],failed.x);
                InterlockedOr(m8FlowerSupportScratch[M8_FLOWER_PACKET_DIRECT+15u],failed.y);
            }
        }

        if(stage==M8_FLOWER_PACKET_PREPARE_STAGE && lane<8u)
        {
            uint address=M8_FLOWER_PACKET_CANDIDATES+3u*lane;
            uint petal=m8FlowerSupportScratch[address];
            if(petal!=0xffffffffu)
            {
                uint token,receipt;
                uint status=M8FlowerPrepareCompletionPetal(slot,local,_M8FlowerPlaneErrorBounds,
                    M8FlowerPacketLoad2(M8_FLOWER_PACKET_CONTROL+5u),petal,
                    M8FlowerPacketDirectAnchors(),token,receipt);
                M8FlowerSupportRequire(receipt);
                m8FlowerSupportScratch[address]=token;
                m8FlowerSupportScratch[address+1u]=status==1u?1u:0u;
                if(status==2u)InterlockedOr(m8PacketAmbiguous,1u);
            }
        }
        // A reached batch may contain fewer than eight carriers. Empty slots
        // cannot retain a previous batch's coverage or peer requests.
        if(stage==M8_FLOWER_PACKET_FINAL_STAGE && lane<8u)
            m8FlowerSupportScratch[M8_FLOWER_PACKET_FOOTPRINTS+85u*lane+75u]=0u;
        M8FlowerSymbolRecord symbol=(M8FlowerSymbolRecord)0;
        uint status=0u,bytes=0u,active=0u;
        if(lane<8u && (m8PacketValid&(1u<<lane))!=0u)
        {
            uint task=M8_FLOWER_PACKET_TASKS+4u*lane;
            uint carrier=m8FlowerSupportScratch[task],completion=m8FlowerSupportScratch[task+1u];
            uint target=m8PacketTarget;
            M8FlowerPhaseRootEvidence roots[7];float3 positions[7];
            uint unresolved,direct,receipt;int3 boundsFirst,boundsLast;
            m8FlowerPacketTask=lane;
            // The one projection/dual call serves immutable D, each viable
            // child, the final carrier, and its exact foreign edge partners.
            status=M8FlowerPageCarrier(target&32767u,target>>15u,carrier,
                _M8FlowerPlaneErrorBounds,completion,
                stage==M8_FLOWER_PACKET_DIRECT_STAGE || stage==M8_FLOWER_PACKET_CHILD_STAGE,
                m8FlowerSupportScratch[task+2u],symbol,unresolved,direct,
                roots,positions,boundsFirst,boundsLast,receipt);
            active=M8FlowerDrawActiveWedgeMask(symbol);
            if(stage==M8_FLOWER_PACKET_DIRECT_STAGE)
            {
                M8FlowerSupportRequire(receipt);
                M8FlowerPacketRecordDirect(carrier,direct,roots);
            }
            else if(stage==M8_FLOWER_PACKET_CHILD_STAGE)
            {
                uint candidate=M8_FLOWER_PACKET_CANDIDATES+3u*lane;
                m8FlowerSupportScratch[candidate+2u]|=receipt;
                uint bit=m8FlowerSupportScratch[task+2u];
                if(status!=1u || (active&bit)==0u)
                    m8FlowerSupportScratch[candidate+1u]=(unresolved&bit)==0u?0u:2u;
            }
            else if(stage==M8_FLOWER_PACKET_FINAL_STAGE)
            {
                M8FlowerSupportRequire(receipt);
                uint footprint=M8_FLOWER_PACKET_FOOTPRINTS+85u*lane;
                if(status==1u)
                {
                    if(!emit && m8FlowerSupportCoverageNeeded!=0u && all(boundsFirst<=boundsLast))
                    {
                        [loop]for(uint site=1u;site<7u;site++)
                            M8FlowerPacketStoreRoot(footprint+9u*(site-1u),roots[site]);
                        [loop]for(uint site=0u;site<7u;site++)
                            M8FlowerPacketStorePosition(footprint+54u+3u*site,positions[site]);
                        m8FlowerSupportScratch[footprint+75u]=active;
                        M8FlowerPacketStore3(footprint+76u,asuint(boundsFirst));
                        M8FlowerPacketStore3(footprint+79u,asuint(boundsLast));
                        M8FlowerPacketStore3(footprint+82u,0u);
                    }
                    if(!coverageOnly)
                    {
                        if(!M8FlowerCarrierSkinBytes(symbol.DetailRef,carrier,active,
                            M8FlowerDrawRootSigns(symbol),M8FlowerDrawHubSector(symbol),bytes))
                        {InterlockedOr(m8FlowerCompileStatus,M8_FLOWER_ARENA_INVALID);status=0u;}
                        else if(!emit)InterlockedAdd(m8FlowerCompileTriangles,countbits(active));
                    }
                }
            }
            else if(stage==M8_FLOWER_PACKET_PEER_STAGE && status==1u)
            {
                uint request=m8FlowerSupportScratch[task+3u];
                uint metadata=m8FlowerSupportScratch[M8_FLOWER_PACKET_PEERS+2u*request+1u];
                if((active&(1u<<((metadata&1023u)%6u)))!=0u)
                {
                    uint ownTask=request/6u,wedge=request%6u,last=(wedge+1u)%6u;
                    uint footprint=M8_FLOWER_PACKET_FOOTPRINTS+85u*ownTask;
                    uint3 sites=uint3((metadata>>10u)&7u,(metadata>>13u)&7u,(metadata>>16u)&7u);
                    uint axes=M8FlowerSupportPairAxes(
                        M8FlowerPacketLoadRoot(footprint+9u*wedge),
                        M8FlowerPacketLoadRoot(footprint+9u*last),roots[sites.x],roots[sites.y],
                        M8FlowerPacketLoadPosition(footprint+54u+3u*(1u+wedge)),
                        M8FlowerPacketLoadPosition(footprint+54u+3u*(1u+last)),
                        M8FlowerPacketLoadPosition(footprint+54u),positions[sites.z]);
                    [unroll]for(uint axis=0u;axis<3u;axis++)if((axes&(1u<<axis))!=0u)
                        InterlockedOr(m8FlowerSupportScratch[footprint+82u+axis],1u<<wedge);
                }
            }
        }
        GroupMemoryBarrierWithGroupSync();

        if(stage==M8_FLOWER_PACKET_FINAL_STAGE)
        {
            if(lane<8u)M8FlowerPacketStore2(M8_FLOWER_PACKET_PREFIX+2u*lane,
                !coverageOnly && status==1u?uint2(1u,bytes):uint2(0u,0u));
            GroupMemoryBarrierWithGroupSync();
            [unroll]for(uint stride=1u;stride<8u;stride<<=1u)
            {
                uint2 sum=0u;
                if(lane<8u)
                {
                    sum=M8FlowerPacketLoad2(M8_FLOWER_PACKET_PREFIX+2u*lane);
                    if(lane>=stride)sum+=M8FlowerPacketLoad2(M8_FLOWER_PACKET_PREFIX+2u*(lane-stride));
                }
                GroupMemoryBarrierWithGroupSync();
                if(lane<8u)M8FlowerPacketStore2(M8_FLOWER_PACKET_PREFIX+2u*lane,sum);
                GroupMemoryBarrierWithGroupSync();
            }
            if(emit && lane<8u && status==1u)
            {
                uint2 prefix=lane==0u?uint2(0u,0u):M8FlowerPacketLoad2(M8_FLOWER_PACKET_PREFIX+2u*(lane-1u));
                uint2 address=first+M8FlowerPacketLoad2(M8_FLOWER_PACKET_CONTROL+14u)+prefix;
                if(address.x>=build.SymbolCapacity/16u || address.y>build.SampleCapacity ||
                    bytes>build.SampleCapacity-address.y)
                    InterlockedOr(m8FlowerCompileStatus,M8_FLOWER_ARENA_INVALID);
                else
                {
                    KernelState state=M8LoadKernelStateRead(slot,local);
                    float3 captured=float3(state.packedColor&255u,(state.packedColor>>8u)&255u,
                        (state.packedColor>>16u)&255u)*(1.0/255.0);
                    uint threadRef,carrier=m8FlowerSupportScratch[M8_FLOWER_PACKET_TASKS+4u*lane];
                    if(!M8FlowerCompileCarrierSkin(symbol.DetailRef,carrier,active,
                        M8FlowerDrawRootSigns(symbol),M8FlowerDrawHubSector(symbol),captured,
                        build.SampleAddress+address.y,bytes,threadRef))
                        InterlockedOr(m8FlowerCompileStatus,M8_FLOWER_ARENA_INVALID);
                    else
                    {
                        symbol.ThreadRef=threadRef;
                        M8FlowerStoreSymbol(build.SymbolAddress,address.x,symbol);
                    }
                }
            }
            GroupMemoryBarrierWithGroupSync();
            if(lane==0u)
            {
                M8FlowerPacketStore2(M8_FLOWER_PACKET_CONTROL+14u,
                    M8FlowerPacketLoad2(M8_FLOWER_PACKET_CONTROL+14u)+
                    M8FlowerPacketLoad2(M8_FLOWER_PACKET_PREFIX+14u));
                M8FlowerPacketStore2(M8_FLOWER_PACKET_CONTROL+12u,0u);
            }
            GroupMemoryBarrierWithGroupSync();
            if(!emit && lane<48u)
            {
                uint ownTask=lane/6u,wedge=lane%6u;
                uint footprint=M8_FLOWER_PACKET_FOOTPRINTS+85u*ownTask;
                if((m8FlowerSupportScratch[footprint+75u]&(1u<<wedge))!=0u)
                {
                    uint2 address;uint peerWedge;uint3 sites;
                    if(M8FlowerSupportResolveOuterPeer(slot,M8FlowerEndpointOwner(slot,local),
                        m8FlowerSupportScratch[M8_FLOWER_PACKET_TASKS+4u*ownTask],
                        wedge,address,peerWedge,sites))
                    {
                        M8FlowerPacketStore2(M8_FLOWER_PACKET_PEERS+2u*lane,
                            uint2(address.x|(address.y<<15u),
                                peerWedge|(sites.x<<10u)|(sites.y<<13u)|(sites.z<<16u)));
                        InterlockedOr(m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+12u+(lane>>5u)],
                            1u<<(lane&31u));
                    }
                }
            }
            GroupMemoryBarrierWithGroupSync();
        }

        if(stage==M8_FLOWER_PACKET_COVERAGE_STAGE)
        {
            uint footprint=M8_FLOWER_PACKET_FOOTPRINTS+85u*(lane>>5u);
            uint mask=m8FlowerSupportScratch[footprint+75u];
            if(mask!=0u)
            {
                float3 positions[7];
                [loop]for(uint site=0u;site<7u;site++)
                    positions[site]=M8FlowerPacketLoadPosition(footprint+54u+3u*site);
                M8FlowerSupportAccumulateCarrier(positions,mask,
                    M8FlowerPacketLoad3(footprint+82u),
                    asint(M8FlowerPacketLoad3(footprint+76u)),
                    asint(M8FlowerPacketLoad3(footprint+79u)),lane&31u,32u);
            }
        }
        GroupMemoryBarrierWithGroupSync();

        bool finishCandidates=false;
        if(stage==M8_FLOWER_PACKET_CHILD_STAGE)
        {
            // A later impossible child drops only its own candidate's earlier
            // ambiguous dual receipt. Numeric/endpoint rules are unchanged.
            uint anyPossible=0u;
            [unroll]for(uint candidate=0u;candidate<8u;candidate++)
                anyPossible|=m8FlowerSupportScratch[M8_FLOWER_PACKET_CANDIDATES+3u*candidate+1u];
            finishCandidates=m8PacketChild==15u || anyPossible==0u;
            if(finishCandidates && lane<8u)
            {
                uint address=M8_FLOWER_PACKET_CANDIDATES+3u*lane;
                uint proof=m8FlowerSupportScratch[address+1u],token=m8FlowerSupportScratch[address];
                if(proof!=0u)M8FlowerSupportRequire(m8FlowerSupportScratch[address+2u]);
                if(proof==1u)
                {
                    uint petal=token&63u,ignored;
                    InterlockedOr(m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+7u+(petal>>5u)],
                        1u<<(petal&31u));
                    InterlockedExchange(m8PacketSelected,token,ignored);
                }
                else if(proof==2u)InterlockedOr(m8PacketAmbiguous,1u);
            }
        }
        GroupMemoryBarrierWithGroupSync();
        if(lane==0u)
        {
            if(stage==M8_FLOWER_PACKET_DECODE_STAGE)
                m8PacketStage=emit?M8_FLOWER_PACKET_FINAL_STAGE:M8_FLOWER_PACKET_DIRECT_STAGE;
            else if(stage==M8_FLOWER_PACKET_DIRECT_STAGE)
            {
                if(all(m8FlowerPendingCarriers==0u))
                {
                    M8FlowerDirectAnchors receipt=M8FlowerPacketDirectAnchors();
                    uint2 direct=~M8FlowerPacketLoad2(M8_FLOWER_PACKET_DIRECT+14u)&
                        uint2(0xffffffffu,0xffffu)&M8FlowerDirectAnchorMask(receipt);
                    M8FlowerPacketStore2(M8_FLOWER_PACKET_CONTROL+5u,direct);
                    M8FlowerPacketStore2(M8_FLOWER_PACKET_CONTROL+3u,M8FlowerCompletionBoundaryCandidates(direct));
                    M8FlowerPacketScheduleCandidates(packed,coverageOnly);
                }
            }
            else if(stage==M8_FLOWER_PACKET_PREPARE_STAGE)
            {m8PacketChild=0u;m8PacketStage=M8_FLOWER_PACKET_CHILD_STAGE;}
            else if(stage==M8_FLOWER_PACKET_CHILD_STAGE)
            {
                if(finishCandidates)M8FlowerPacketScheduleCandidates(packed,coverageOnly);
                else m8PacketChild++;
            }
            else if(stage==M8_FLOWER_PACKET_FINAL_STAGE)
            {
                if(!emit)m8PacketStage=M8_FLOWER_PACKET_PEER_STAGE;
                else
                {
                    if(all(m8FlowerPendingCarriers==0u))m8PacketStage=M8_FLOWER_PACKET_DONE;
                }
            }
            else if(stage==M8_FLOWER_PACKET_COVERAGE_STAGE)
            {
                m8PacketStage=all(m8FlowerPendingCarriers==0u)?
                    M8_FLOWER_PACKET_DONE:M8_FLOWER_PACKET_FINAL_STAGE;
            }
        }
        GroupMemoryBarrierWithGroupSync();
    }
    return M8FlowerPacketLoad2(M8_FLOWER_PACKET_CONTROL+14u);
}

// One WG per accepted page, over one bounded immutable native-job lease.
// Count and emit reuse this exact entry/evaluator with a global Reserve
// boundary between them. Only compact integer proofs cross that boundary.
// Failed count/skin validation never publishes a partial page or changes FRONT.
[numthreads(256,1,1)]
void CompactDirtyFlowerSymbols(uint3 groupId:SV_GroupID,uint lane:SV_GroupIndex)
{
    if(lane==0u)
    {
        m8FlowerCompileStatus=M8_FLOWER_ARENA_OK;
        m8FlowerCompileTriangles=0u;m8FlowerCompileTotal=0u;
        m8FlowerCompilePhase=_M8FlowerPageDirectory.Load(M8_FLOWER_BATCH_PHASE);
        m8FlowerCompileItem=groupId.x;
        if(m8FlowerCompilePhase==1u && groupId.x<M8_FLOWER_BATCH_CAPACITY)
            m8FlowerCompileItem=_M8FlowerPageDirectory.Load(M8_FLOWER_BATCH_EMIT_INDICES+4u*groupId.x);
        m8FlowerCompileSlot=0xffffffffu;m8FlowerCompileGeneration=0u;
        m8FlowerCompileSlotGeneration=0u;
        if(m8FlowerCompilePhase<2u && m8FlowerCompileItem<M8_FLOWER_BATCH_CAPACITY &&
            m8FlowerCompileItem<_M8FlowerPageDirectory.Load(M8_FLOWER_BATCH_COUNT))
        {
            uint4 identity=_M8FlowerPageDirectory.Load4(M8FlowerBatchRecord(m8FlowerCompileItem));
            uint requiredState=m8FlowerCompilePhase==0u?M8_FLOWER_BATCH_ITEM_CLAIMED:M8_FLOWER_BATCH_ITEM_RESERVED;
            if(identity.w==requiredState)
            {
                m8FlowerCompileSlot=identity.x;m8FlowerCompileGeneration=identity.z;
                m8FlowerCompileSlotGeneration=identity.y;
            }
        }
        if(m8FlowerCompileSlot<32768u)
        {
            uint4 meta=M8LoadTileMetaRead(m8FlowerCompileSlot);
            uint4 runtime=M8LoadTileRuntimeRead(m8FlowerCompileSlot);
            if(runtime.w!=0u && runtime.w==m8FlowerCompileSlotGeneration &&
                m8FlowerCompileGeneration!=0u &&
                M8FlowerPageSourceUnchanged(m8FlowerCompileSlot,m8FlowerCompileGeneration) &&
                meta.x<MERKABA_M8_CHUNK_CAPACITY && meta.y<64u &&
                _M8ChunkTileRefsRead[meta.x*64u+meta.y]==m8FlowerCompileSlot+1u)
            {
                uint slot=m8FlowerCompileSlot;
                uint2 front=_M8FlowerPageDirectory.Load2(
                    M8_FLOWER_PAGE_DIRECTORY_BASE+16u*slot);
                uint header0=M8_FLOWER_PAGE_HEADER_BASE+64u*slot;
                int3 minimum=M8GlobalKernelCoordRead(slot,0u);
                bool sameInstallation=front.y!=0u &&
                    (front.x==header0 || front.x==header0+32u) &&
                    _M8FlowerPageDirectory.Load(M8_FLOWER_PAGE_AUX_BASE+32u*slot+28u)==runtime.w;
                if(sameInstallation)
                {
                    M8FlowerPageHeader previous=M8FlowerLoadPageHeader(front.x);
                    // Slot generations wrap; the exact logical tile prevents
                    // an old slot occupant from supplying its classification.
                    sameInstallation=previous.Generation==front.y &&
                        all(previous.LogicalTile==(minimum>>3));
                }
                // Installation is a residency trigger even at a stationary
                // head. Until its first successful publication a retry remains
                // this same install work; ordinary source dirtiness thereafter
                // does not reclassify the already published slot lifetime.
                if(!sameInstallation && m8FlowerCompilePhase==0u)
                    M8FlowerSetPageResidency(slot,M8FlowerClassifyTileDistance(minimum));
            }
            else
            {
                if(runtime.w==0u)M8FlowerClearRetiredPageResidency(m8FlowerCompileSlot);
                _M8FlowerPageDirectory.Store(M8FlowerBatchRecord(m8FlowerCompileItem)+52u,M8_FLOWER_ARENA_INVALID);
                M8FlowerSetBatchState(m8FlowerCompileItem,M8_FLOWER_BATCH_ITEM_ABORT);
                m8FlowerCompileSlot=0xffffffffu;
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    uint slot=m8FlowerCompileSlot,generation=m8FlowerCompileGeneration;
    if(slot>=32768u)return;
    uint batchItem=m8FlowerCompileItem,record=M8FlowerBatchRecord(batchItem),scratch=M8FlowerBatchScratch(batchItem);
    bool emitting=m8FlowerCompilePhase==1u;
    M8FlowerCacheTileHalo(slot,lane,true);
    int3 logicalTile=m8FlowerHaloTile;
    M8FlowerSupportCacheTile(logicalTile,lane,256u);
    M8FlowerPageBuild build=(M8FlowerPageBuild)0;
    if(emitting)
    {
        build=M8FlowerLoadBatchBuild(batchItem);
        if(lane<M8_FLOWER_SUPPORT_HALF_WORDS)
            m8FlowerSupportHalves[lane]=_M8FlowerPageDirectory.Load(scratch+M8_FLOWER_BATCH_DIRT_HALVES+lane*4u);
        GroupMemoryBarrierWithGroupSync();
        M8FlowerSupportPrepareSymbols(lane);
        if(lane==0u)
        {
            m8FlowerCompileTotal=_M8FlowerPageDirectory.Load2(record+16u);
            m8FlowerCompileTriangles=_M8FlowerPageDirectory.Load(record+28u);
            m8FlowerSupportUnresolved=_M8FlowerPageDirectory.Load(record+56u);
            m8FlowerHaloUnresolvedReads|=_M8FlowerPageDirectory.Load(record+60u);
            if(m8FlowerSupportSymbolCount!=_M8FlowerPageDirectory.Load(record+24u) ||
                m8FlowerHaloUnresolvedReads!=0u)m8FlowerCompileStatus=M8_FLOWER_ARENA_INVALID;
        }
        GroupMemoryBarrierWithGroupSync();
        if(m8FlowerCompileStatus==M8_FLOWER_ARENA_OK)
        {
            uint result=M8FlowerSupportEmitPage(build,m8FlowerCompileTotal.x,lane,256u);
            if(lane==0u)m8FlowerCompileStatus=result;
        }
    }
    else
    {
        [unroll]for(uint ownerIndex=0u;ownerIndex<2u;ownerIndex++)
        {
            uint local=lane+ownerIndex*256u;
            _M8FlowerPageDirectory.Store2(scratch+local*8u,uint2(0u,0u));
            _M8FlowerPageDirectory.Store(scratch+M8_FLOWER_BATCH_COMPLETION+local*4u,0xffffffffu);
        }
        M8FlowerSupportBuildFaces(lane,256u);
    }
    GroupMemoryBarrierWithGroupSync();
    // Exactly one syntactic evaluator call: count+neighbor phases now precede
    // the global allocation boundary; emission consumes their saved proofs.
    [loop]for(uint phase=emitting?2u:0u;phase<(emitting?3u:2u);phase++)
    {
        if(phase==2u && m8FlowerCompileStatus!=M8_FLOWER_ARENA_OK)break;
        bool coverageOnly=phase==1u;
        uint itemCount=512u;
        if(coverageOnly)
            itemCount=M8FlowerSupportPrepareNeighborCoverage(lane,256u)?
                M8_FLOWER_COVERAGE_OWNER_COUNT:0u;
        [loop]for(uint batch=0u;batch<itemCount;batch+=512u)
        {
            // Select two owners per lane before entering cooperative packets.
            // Empty pages pay one parallel mask build, not two WG barriers
            // for each of 512 empty owners. Bits retain canonical owner order.
            GroupMemoryBarrierWithGroupSync();
            if(lane<16u)m8FlowerActiveOwners[lane]=0u;
            GroupMemoryBarrierWithGroupSync();
            [unroll]for(uint ownerHalf=0u;ownerHalf<2u;ownerHalf++)
            {
                uint candidate=lane+ownerHalf*256u,item=batch+candidate;
                uint ownerSlot=slot,local=item;
                if(item>=itemCount)continue;
                bool valid=true;
                if(coverageOnly)valid=M8FlowerSupportResolveCoverageOwner(slot,item,ownerSlot,local);
                if(valid)
                {
                    uint flags=M8LoadKernelStateRead(ownerSlot,local).flags;
                    uint required=M8_FLOWER_OCCUPIED_FLAG|M8_FLOWER_PLANE_VALID;
                    valid=(flags&(required|M8_FLOWER_SEED_FLAG))==required;
                    if(valid)InterlockedOr(m8FlowerActiveOwners[candidate>>5u],1u<<(candidate&31u));
                }
            }
            GroupMemoryBarrierWithGroupSync();
            [loop]for(uint word=0u;word<16u;word++)
            {
                uint pending=m8FlowerActiveOwners[word];
                [loop]while(pending!=0u)
                {
                    uint item=batch+word*32u+(uint)firstbitlow(pending);
                    pending&=pending-1u;
                    uint ownerSlot=slot,local=item;
                    if(coverageOnly)
                    {
                        // Halo addresses cannot change during the page lease.
                        // Resolve only selected owners; keep the bitmap small
                        // instead of retaining 512 addresses in groupshared.
                        if(lane==0u)
                        {
                            M8FlowerSupportResolveCoverageOwner(slot,item,ownerSlot,local);
                            m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+20u]=ownerSlot|(local<<15u);
                        }
                        GroupMemoryBarrierWithGroupSync();
                        uint address=m8FlowerSupportScratch[M8_FLOWER_PACKET_CONTROL+20u];
                        ownerSlot=address&32767u;local=address>>15u;
                        GroupMemoryBarrierWithGroupSync();
                    }
                    uint2 first=0u;
                    if(phase==2u)first=_M8FlowerPageDirectory.Load2(scratch+local*8u);
                    uint2 count=M8FlowerCompileOwner(ownerSlot,local,phase==2u,coverageOnly,build,first,lane);
                    if(lane==0u && phase==0u)_M8FlowerPageDirectory.Store2(scratch+local*8u,count);
                    else if(lane==0u && phase==2u)
                    {
                        uint2 end=local==511u?m8FlowerCompileTotal:
                            _M8FlowerPageDirectory.Load2(scratch+(local+1u)*8u);
                        if(any(count!=end-first))
                            InterlockedOr(m8FlowerCompileStatus,M8_FLOWER_ARENA_INVALID);
                    }
                    GroupMemoryBarrierWithGroupSync();
                }
            }
        }
        GroupMemoryBarrierWithGroupSync();
        if(phase==1u)
        {
            M8FlowerRequestPageEndpoints(lane);
            M8FlowerSupportRequestResidency(lane,256u);
            M8FlowerSupportFinalizeCoverage(lane,256u);
            M8FlowerSupportPrepareSymbols(lane);
            DeviceMemoryBarrierWithGroupSync();
            [unroll]for(uint ownerIndex=0u;ownerIndex<2u;ownerIndex++)
            {
                uint local=lane+ownerIndex*256u;
                m8FlowerPageOwnerSpans[local]=_M8FlowerPageDirectory.Load2(scratch+local*8u);
            }
            GroupMemoryBarrierWithGroupSync();
            M8FlowerPrefixOwners(lane);
            if(lane==0u)
            {
                uint2 sum=m8FlowerCompileTotal;
                if(sum.x>M8_FLOWER_MAX_PAGE_SYMBOLS-m8FlowerSupportSymbolCount || sum.y>67108864u)
                    m8FlowerCompileStatus=M8_FLOWER_ARENA_CAPACITY;
                if(m8FlowerHaloUnresolvedReads!=0u || m8FlowerSupportUnresolved!=0u ||
                    m8FlowerSupportOriginValid==0u)
                    m8FlowerCompileStatus=M8_FLOWER_SUPPORT_AMBIGUOUS;
            }
            GroupMemoryBarrierWithGroupSync();
            [unroll]for(uint ownerIndex=0u;ownerIndex<2u;ownerIndex++)
            {
                uint local=lane+ownerIndex*256u;
                _M8FlowerPageDirectory.Store2(scratch+local*8u,m8FlowerPageOwnerSpans[local]);
            }
            if(lane<M8_FLOWER_SUPPORT_HALF_WORDS)
                _M8FlowerPageDirectory.Store(scratch+M8_FLOWER_BATCH_DIRT_HALVES+lane*4u,m8FlowerSupportHalves[lane]);
        }
    }
    if(lane==0u && emitting && (m8FlowerHaloUnresolvedReads!=0u || m8FlowerSupportUnresolved!=0u))
        m8FlowerCompileStatus=M8_FLOWER_SUPPORT_AMBIGUOUS;
    GroupMemoryBarrierWithGroupSync();
    if(emitting && m8FlowerCompileStatus==M8_FLOWER_ARENA_OK)
    {
        uint result=M8FlowerSupportFinishPage(build,logicalTile,m8FlowerCompileTotal.x,
            m8FlowerCompileTotal.x,true,m8FlowerCompileTotal.y/64u,lane);
        if(lane==0u)m8FlowerCompileStatus=result;
    }
    DeviceMemoryBarrierWithGroupSync();
    if(lane==0u)
    {
        if(!emitting)
        {
            _M8FlowerPageDirectory.Store4(record+16u,uint4(m8FlowerCompileTotal,
                m8FlowerSupportSymbolCount,m8FlowerCompileTriangles));
            _M8FlowerPageDirectory.Store2(record+56u,
                uint2(m8FlowerSupportUnresolved,m8FlowerHaloUnresolvedReads));
        }
        _M8FlowerPageDirectory.Store(record+52u,m8FlowerCompileStatus);
        if(m8FlowerCompileStatus!=M8_FLOWER_ARENA_OK)
        {
            M8FlowerMarkPageDirty(slot,generation);
            InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_UNRESOLVED],1u);
            M8FlowerSetBatchState(batchItem,M8_FLOWER_BATCH_ITEM_ABORT);
        }
        else M8FlowerSetBatchState(batchItem,emitting?M8_FLOWER_BATCH_ITEM_READY:M8_FLOWER_BATCH_ITEM_COUNTED);
    }
}

// Count is complete across all page WGs. This entry orders the batch receipts;
// atomic buddy allocation itself needs no global metadata lease.
[numthreads(1,1,1)]
void ReserveDirtyFlowerBatch(uint lane:SV_GroupIndex)
{
    if(_M8FlowerPageDirectory.Load(M8_FLOWER_BATCH_PHASE)!=0u)return;
    uint count=min(_M8FlowerPageDirectory.Load(M8_FLOWER_BATCH_COUNT),M8_FLOWER_BATCH_CAPACITY);
    uint emitCount=0u;
    [loop]for(uint item=0u;item<count;item++)
    {
        uint address=M8FlowerBatchRecord(item);
        uint4 identity=_M8FlowerPageDirectory.Load4(address);
        if(identity.w!=M8_FLOWER_BATCH_ITEM_COUNTED)
        {
            if(identity.w==M8_FLOWER_BATCH_ITEM_CLAIMED)
            {
                _M8FlowerPageDirectory.Store(address+52u,M8_FLOWER_ARENA_INVALID);
                M8FlowerSetBatchState(item,M8_FLOWER_BATCH_ITEM_ABORT);
            }
            continue;
        }
        uint4 amounts=_M8FlowerPageDirectory.Load4(address+16u);
        uint result=M8_FLOWER_ARENA_INVALID;
        M8FlowerPageBuild build=(M8FlowerPageBuild)0;
        if(identity.x<32768u && identity.y!=0u && M8LoadTileRuntimeRead(identity.x).w==identity.y)
            result=M8FlowerBeginPage(identity.x,identity.y,identity.z,
                amounts.x+amounts.z,amounts.y,build);
        // Persist before publishing either success OR failure. Even a failed
        // rollback owns any capacity it could not return; Publish will retry.
        M8FlowerStoreBatchBuild(item,build);
        _M8FlowerPageDirectory.Store(address+52u,result);
        if(result==M8_FLOWER_ARENA_OK)
        {
            _M8FlowerPageDirectory.Store(M8_FLOWER_BATCH_EMIT_INDICES+4u*emitCount,item);
            emitCount++;
            M8FlowerSetBatchState(item,M8_FLOWER_BATCH_ITEM_RESERVED);
        }
        else
        {
            if(result==M8_FLOWER_ARENA_CAPACITY)_M8FlowerPageDirectory.Store(4u,1u);
            M8FlowerMarkPageDirty(identity.x,identity.z);
            M8FlowerSetBatchState(item,M8_FLOWER_BATCH_ITEM_ABORT);
        }
    }
    _M8FlowerPageDirectory.Store(M8_FLOWER_BATCH_RESERVED,emitCount);
    _M8FlowerPageDirectory.Store(M8_FLOWER_BATCH_PHASE,1u);
    DeviceMemoryBarrier();
    _M8FlowerIndirectCommands.Store4(M8_FLOWER_BATCH_DISPATCH_ARGS,uint4(emitCount,1u,1u,0u));
}

#undef _M8ChunkTileRefsRead

// Translation/install-only residency classification, bounded by HOT capacity.
// It neither traverses a logical sphere stencil nor compiles surface symbols.
[numthreads(128,1,1)]
void ClassifyHotFlowerPages(uint dispatchId : SV_DispatchThreadID)
{
    if(_M8FlowerClassifySingleSlot!=0u && dispatchId!=0u)return;
    uint slot=_M8FlowerClassifySingleSlot!=0u?_M8FlowerClassifySlot:dispatchId;
    if(slot>=MERKABA_M8_PHYSICAL_TILE_CAPACITY)return;
    uint4 meta=M8LoadTileMetaRead(slot);
    uint4 runtime=M8LoadTileRuntimeRead(slot);
    if(runtime.w!=0u && meta.x<MERKABA_M8_CHUNK_CAPACITY && meta.y<64u &&
        _M8ChunkTileRefsRead[meta.x*64u+meta.y]==slot+1u)
        M8FlowerSetPageResidency(slot,
            M8FlowerClassifyTileDistance(M8GlobalKernelCoordRead(slot,0u)));
    else M8FlowerClearRetiredPageResidency(slot);
}

[numthreads(1,1,1)]
void PublishDirtyFlowerPages(uint lane:SV_GroupIndex)
{
    uint count=min(_M8FlowerPageDirectory.Load(M8_FLOWER_BATCH_COUNT),M8_FLOWER_BATCH_CAPACITY);
    if(count==0u)return;
    uint remaining=0u;
    [loop]for(uint item=0u;item<count;item++)
    {
        uint address=M8FlowerBatchRecord(item);
        uint4 identity=_M8FlowerPageDirectory.Load4(address);
        if(identity.w==M8_FLOWER_BATCH_ITEM_RETIRED)continue;
        M8FlowerPageBuild build=M8FlowerLoadBatchBuild(item);
        uint result=M8_FLOWER_ARENA_INVALID;bool published=false;
        if(identity.w==M8_FLOWER_BATCH_ITEM_READY)
        {
            uint directory=M8_FLOWER_PAGE_DIRECTORY_BASE+16u*identity.x;
            uint2 pending=_M8FlowerPageDirectory.Load2(directory+8u);
            if(pending.x==build.Header && pending.y==build.SourceGeneration)
            {
                result=M8FlowerPublishPage(identity.x,M8LoadTileRuntimeRead(identity.x).w,
                    _M8FlowerGraphicsRetiredGeneration);
                if(result==M8_FLOWER_ARENA_OK)
                {
                    uint2 front=_M8FlowerPageDirectory.Load2(directory);
                    published=front.x==build.Header && front.y==build.SourceGeneration;
                    // Ownership has transferred to FRONT, or the stale pending
                    // allocation has been returned. Never free this receipt again.
                    build.SymbolCapacity=build.SampleCapacity=0u;
                }
            }
        }
        else result=M8FlowerAbortPage(build);
        M8FlowerStoreBatchBuild(item,build);
        if(result!=M8_FLOWER_ARENA_OK)
        {
            _M8FlowerPageDirectory.Store(address+52u,result);
            remaining++;continue;
        }
        uint ignored;
        if(published)
        {
            uint4 amounts=_M8FlowerPageDirectory.Load4(address+16u);
            _M8FlowerPageDirectory.InterlockedAdd(M8_FLOWER_BATCH_COMMITTED,1u,ignored);
            InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES],amounts.w+amounts.z);
            InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_EMITTED_VERTICES],7u*(amounts.x+amounts.z));
        }
        else
        {
            // New installation/source dirtiness wins. No old-generation bit
            // is cleared on retirement; an absent physical slot needs no retry.
            if(identity.x<32768u && M8LoadTileRuntimeRead(identity.x).w!=0u)
                M8FlowerMarkPageDirty(identity.x,_M8FlowerPageDirectory.Load(M8_FLOWER_PAGE_AUX_BASE+identity.x*32u));
            uint status=_M8FlowerPageDirectory.Load(address+52u);
            uint counter=status==M8_FLOWER_ARENA_INVALID?M8_FLOWER_BATCH_FAILED:M8_FLOWER_BATCH_RETRIED;
            _M8FlowerPageDirectory.InterlockedAdd(counter,1u,ignored);
        }
        M8FlowerSetBatchState(item,M8_FLOWER_BATCH_ITEM_RETIRED);
    }
    // BUSY/failure receipts keep the original queue span and all addresses.
    // Prepare will run retirement-only until each receipt is retired once.
    if(remaining==0u)_M8FlowerPageDirectory.Store(M8_FLOWER_BATCH_COUNT,0u);
}

// Current view changes only these commands. The count word is reset by the
// command stream immediately before this dispatch, never by a racing lane.
[numthreads(128,1,1)]
void CullFlowerPages(uint slot : SV_DispatchThreadID)
{
    if(slot>=MERKABA_M8_PHYSICAL_TILE_CAPACITY ||
        (_M8FlowerPageDirectory.Load(M8_FLOWER_PAGE_AUX_BASE+32u*slot+4u)&
            M8_FLOWER_PAGE_RESIDENCY_MASK)<2u)return;
    M8FlowerPageHeader page;
    if(!M8FlowerFrontPage(slot,page) || page.SymbolCount==0u)return;
    if(_M8FlowerPageDirectory.Load(M8_FLOWER_PAGE_AUX_BASE+32u*slot+28u)!=
        M8LoadTileRuntimeRead(slot).w)return;
    float3 minimum=(float3(page.LogicalTile)*8.0-1.0)*MERKABA_LATTICE_STEP;
    float3 maximum=(float3(page.LogicalTile)*8.0+8.0)*MERKABA_LATTICE_STEP;
    bool visible=false;
    [unroll]for(uint eye=0u;eye<2u;eye++)
    {
        bool inside=true;
        [unroll]for(uint plane=0u;plane<6u;plane++)
        {
            float4 p=_M8FlowerCullPlanes[eye*6u+plane];
            float3 positive=float3(p.x>=0.0?maximum.x:minimum.x,
                p.y>=0.0?maximum.y:minimum.y,p.z>=0.0?maximum.z:minimum.z);
            inside=inside && dot(p.xyz,positive)+p.w>=0.0;
        }
        visible=visible || inside;
    }
    uint views=_M8FlowerViewInstanceCount;
    if(!visible || (views!=1u && views!=2u))return;
    uint command;
    _M8FlowerIndirectCommands.InterlockedAdd(M8_FLOWER_INDIRECT_COUNT,1u,command);
    // At most one invocation per physical page, so command<32768 structurally.
    // Also bound the store if a rejected/reset command stream is replayed.
    if(command>=32768u)return;
    uint address=command*M8_FLOWER_INDIRECT_STRIDE;
    _M8FlowerIndirectCommands.Store4(address,uint4(page.SymbolCount*18u,views,
        0u,page.FirstSymbol*7u));
    _M8FlowerIndirectCommands.Store(address+16u,slot*views);
}
