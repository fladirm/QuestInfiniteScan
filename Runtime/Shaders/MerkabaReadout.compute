#pragma kernel ResetReadoutBuild
#pragma kernel QueryM8Readout
#pragma kernel PrepareReadoutBuild
#pragma kernel PreflightReadout
#pragma kernel PrepareReadoutEmit
#pragma kernel EmitReadoutVertices
#pragma kernel FinalizeReadout

#include "MerkabaWorld.hlsl"
#include "MerkabaOverlapShell.generated.hlsl"

#define MERKABA_LATTICE_STEP 0.025
#define MERKABA_HALF_SUPPORT 0.025
#define MERKABA_OCCUPIED_FLAG 1u
#define M8_READOUT_VERTICES_PER_TRIANGLE 3u

struct MerkabaReadoutVertex
{
    float3 gridPosition;
    uint packedColor;
};

RWStructuredBuffer<uint2> _M8VisibleTiles;
StructuredBuffer<uint2> _M8VisibleTilesRead;
RWStructuredBuffer<MerkabaReadoutVertex> _M8ReadoutVertices0;
RWStructuredBuffer<MerkabaReadoutVertex> _M8ReadoutVertices1;
RWStructuredBuffer<uint> _M8FrameDispatchArgs;
RWStructuredBuffer<uint> _M8DrawArgs;

float4x4 _MerkabaGridToWorld;
float4x4 _MerkabaWorldToGrid;
float4 _M8DrawPlanes[12];
float4 _M8DependencyPlanes[12];
float3 _M8CameraWorld;
float _M8RenderDistance;
float _M8WarmDistance;
float _M8DependencyDistance;
int3 _M8QueryCenterBlock;
int _M8QueryBlockRadius;
int _M8QueryBlockSide;

bool M8AabbIntersectsDistance(int3 globalMin, int span, float distance)
{
    return MerkabaM8AabbIntersectsDistance(globalMin, span, distance,
        _M8CameraWorld, _MerkabaGridToWorld, _MerkabaWorldToGrid,
        MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
}

uint M8DistanceChildMask(int3 parentMin, int parentSpan, float distance)
{
    return MerkabaM8DistanceChildMask(parentMin, parentSpan, distance,
        _M8CameraWorld, _MerkabaGridToWorld, _MerkabaWorldToGrid,
        MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
}

uint M8EyeFrustumChildMask(int3 parentMin, int parentSpan, uint eye)
{
    uint support = 255u;
    [unroll]
    for (uint plane = 0u; plane < 6u; plane++)
        support &= MerkabaM8PlaneChildMask(parentMin, parentSpan,
            _M8DrawPlanes[eye * 6u + plane], _MerkabaGridToWorld,
            MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
    return support;
}

uint M8EyeDependencyChildMask(int3 parentMin, int parentSpan, uint eye)
{
    uint support = 255u;
    [unroll]
    for (uint plane = 0u; plane < 6u; plane++)
        support &= MerkabaM8PlaneChildMask(parentMin, parentSpan,
            _M8DependencyPlanes[eye * 6u + plane], _MerkabaGridToWorld,
            MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
    return support;
}

uint M8DrawChildMask(int3 parentMin, int parentSpan)
{
    uint stereo = M8EyeFrustumChildMask(parentMin, parentSpan, 0u) |
        M8EyeFrustumChildMask(parentMin, parentSpan, 1u);
    return stereo & M8DistanceChildMask(parentMin, parentSpan,
        _M8RenderDistance);
}

uint M8DependencyChildMask(int3 parentMin, int parentSpan)
{
    uint stereo = M8EyeDependencyChildMask(parentMin, parentSpan, 0u) |
        M8EyeDependencyChildMask(parentMin, parentSpan, 1u);
    return stereo & M8DistanceChildMask(parentMin, parentSpan,
        _M8DependencyDistance);
}

void M8RequestWarmLoad(uint tileRefIndex, uint chunkIndex, uint tileLocal,
    bool lateDraw)
{
    M8QueueColdTileLoad(tileRefIndex, chunkIndex, tileLocal);
    if (lateDraw) M8CounterIncrement(M8_COUNTER_LATE_DRAW_COLD_MISSES);
}

[numthreads(1, 1, 1)]
void ResetReadoutBuild(uint id : SV_DispatchThreadID)
{
    _M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT] = 0u;
    _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES] = 0u;
    _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 0u;
    _M8Counters[M8_COUNTER_LATE_DRAW_COLD_MISSES] = 0u;
    _M8Counters[M8_COUNTER_CANDIDATE_BLOCKS] = 0u;
    _M8Counters[M8_COUNTER_HASH_HIT_BLOCKS] = 0u;
    _M8Counters[M8_COUNTER_VISIBLE_CHUNKS] = 0u;
    _M8Counters[M8_COUNTER_OCCUPIED_CONSIDERED] = 0u;
    _M8Counters[M8_COUNTER_PRIMITIVES_BEFORE_FACING] = 0u;
    _M8Counters[M8_COUNTER_PRIMITIVES_REJECTED] = 0u;
    _M8Counters[M8_COUNTER_READOUT_UNRESOLVED] = 0u;
    _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES] = 0u;
    _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
        MERKABA_READOUT_BUILDING;
    _M8Counters[M8_COUNTER_FRAME_EPOCH] += 1u;
    _M8FrameDispatchArgs[0] = 0u;
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
}

groupshared uint gFrameBlockRef;
groupshared int3 gFrameBlockMin;
groupshared uint gFrameWarm4;
groupshared uint gFrameDraw4;
groupshared uint gFrameDependency4;
groupshared uint gFrameWarm3[8];
groupshared uint gFrameDraw3[8];
groupshared uint gFrameDependency3[8];

[numthreads(64, 1, 1)]
void QueryM8Readout(uint3 groupId : SV_GroupID, uint thread : SV_GroupIndex)
{
    uint linearBlockIndex = groupId.x;
    if (thread == 0u)
    {
        gFrameBlockRef = 0u;
        gFrameWarm4 = 0u;
        gFrameDraw4 = 0u;
        gFrameDependency4 = 0u;
        uint side = (uint)_M8QueryBlockSide;
        if (linearBlockIndex < side * side * side)
        {
            int3 offset;
            offset.x = (int)(linearBlockIndex % side) - _M8QueryBlockRadius;
            offset.y = (int)((linearBlockIndex / side) % side) -
                _M8QueryBlockRadius;
            offset.z = (int)(linearBlockIndex / (side * side)) -
                _M8QueryBlockRadius;
            int3 blockCoord = _M8QueryCenterBlock + offset;
            gFrameBlockMin = blockCoord * MERKABA_M8_BLOCK_KERNEL_SPAN;
            M8CounterIncrement(M8_COUNTER_CANDIDATE_BLOCKS);
            if (M8AabbIntersectsDistance(gFrameBlockMin,
                MERKABA_M8_BLOCK_KERNEL_SPAN, _M8WarmDistance))
            {
                uint blockIndex = 0u;
                if (M8FindBlock(blockCoord, blockIndex))
                {
                    gFrameBlockRef = blockIndex + 1u;
                    gFrameWarm4 = M8DistanceChildMask(gFrameBlockMin, 256,
                        _M8WarmDistance);
                    gFrameDraw4 = M8DrawChildMask(gFrameBlockMin, 256);
                    gFrameDependency4 = M8DependencyChildMask(
                        gFrameBlockMin, 256);
                    M8CounterIncrement(M8_COUNTER_HASH_HIT_BLOCKS);
                }
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (thread < 8u)
    {
        uint d4ForMask = thread;
        gFrameWarm3[d4ForMask] = 0u;
        gFrameDraw3[d4ForMask] = 0u;
        gFrameDependency3[d4ForMask] = 0u;
        if (gFrameBlockRef != 0u)
        {
            uint maskBlockIndex = gFrameBlockRef - 1u;
            if (((_M8BlockPresenceL0Read[maskBlockIndex] & gFrameWarm4) &
                (1u << d4ForMask)) != 0u)
            {
                int3 min4ForMask = gFrameBlockMin +
                    MerkabaM8OctantOffset(d4ForMask, 128);
                gFrameWarm3[d4ForMask] = M8DistanceChildMask(min4ForMask, 128,
                    _M8WarmDistance);
                gFrameDraw3[d4ForMask] =
                    ((gFrameDraw4 >> d4ForMask) & 1u) != 0u
                    ? M8DrawChildMask(min4ForMask, 128) : 0u;
                gFrameDependency3[d4ForMask] =
                    ((gFrameDependency4 >> d4ForMask) & 1u) != 0u
                    ? M8DependencyChildMask(min4ForMask, 128) : 0u;
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gFrameBlockRef == 0u) return;

    uint blockIndex = gFrameBlockRef - 1u;
    int3 blockMin = gFrameBlockMin;
    uint d4 = thread >> 3u;
    uint d3 = thread & 7u;
    if (((gFrameWarm4 >> d4) & 1u) == 0u ||
        (((_M8BlockPresenceL1Read[blockIndex * 8u + d4] &
        gFrameWarm3[d4]) >> d3) & 1u) == 0u) return;

    int3 min4 = blockMin + MerkabaM8OctantOffset(d4, 128);
    int3 min3 = min4 + MerkabaM8OctantOffset(d3, 64);
    uint warm2 = M8DistanceChildMask(min3, 64, _M8WarmDistance);
    bool drawPath3 = ((gFrameDraw4 >> d4) & 1u) != 0u &&
        ((gFrameDraw3[d4] >> d3) & 1u) != 0u;
    bool dependencyPath3 = ((gFrameDependency4 >> d4) & 1u) != 0u &&
        ((gFrameDependency3[d4] >> d3) & 1u) != 0u;
    uint draw2 = drawPath3 ? M8DrawChildMask(min3, 64) : 0u;
    uint dependency2 = dependencyPath3
        ? M8DependencyChildMask(min3, 64) : 0u;
    uint support2 = (_M8BlockPresenceL2Read[blockIndex * 64u +
        d4 * 8u + d3] & 255u) & warm2;
    while (support2 != 0u)
    {
        uint d2 = (uint)firstbitlow(support2);
        support2 &= support2 - 1u;
        uint chunkLocal = (d4 << 6u) | (d3 << 3u) | d2;
        uint chunkRef = _M8BlockChunkRefsRead[blockIndex * 512u + chunkLocal];
        if (chunkRef == 0u || chunkRef >= MERKABA_REF_EVICTING) continue;
        uint chunkIndex = chunkRef - 1u;
        int3 min2 = min3 + MerkabaM8OctantOffset(d2, 32);
        uint warm1 = M8DistanceChildMask(min2, 32, _M8WarmDistance);
        bool drawPath2 = drawPath3 && ((draw2 >> d2) & 1u) != 0u;
        bool dependencyPath2 = dependencyPath3 &&
            ((dependency2 >> d2) & 1u) != 0u;
        uint draw1 = drawPath2 ? M8DrawChildMask(min2, 32) : 0u;
        uint dependency1 = dependencyPath2
            ? M8DependencyChildMask(min2, 32) : 0u;
        uint support1 =
            (_M8ChunkPresenceRead[M8ChunkPresenceL0Index(chunkIndex)] &
            255u) & warm1;
        bool visibleChunk = false;
        while (support1 != 0u)
        {
            uint d1 = (uint)firstbitlow(support1);
            support1 &= support1 - 1u;
            int3 min1 = min2 + MerkabaM8OctantOffset(d1, 16);
            uint warm0 = M8DistanceChildMask(min1, 16, _M8WarmDistance);
            bool drawPath1 = drawPath2 && ((draw1 >> d1) & 1u) != 0u;
            bool dependencyPath1 = dependencyPath2 &&
                ((dependency1 >> d1) & 1u) != 0u;
            uint draw0 = drawPath1 ? M8DrawChildMask(min1, 16) : 0u;
            uint dependency0 = dependencyPath1
                ? M8DependencyChildMask(min1, 16) : 0u;
            uint support0 =
                (_M8ChunkPresenceRead[
                    M8ChunkPresenceL1Index(chunkIndex, d1)] & 255u) & warm0;
            while (support0 != 0u)
            {
                uint d0 = (uint)firstbitlow(support0);
                support0 &= support0 - 1u;
                uint tileLocal = (d1 << 3u) | d0;
                uint tileRefIndex = chunkIndex * 64u + tileLocal;
                uint tileRef = _M8ChunkTileRefs[tileRefIndex];
                bool inDraw = drawPath1 && ((draw0 >> d0) & 1u) != 0u;
                bool inDependency = dependencyPath1 &&
                    ((dependency0 >> d0) & 1u) != 0u;
                if (tileRef == MERKABA_REF_COLD_ON_SSD)
                {
                    M8RequestWarmLoad(tileRefIndex, chunkIndex, tileLocal,
                        inDraw);
                    if (inDependency)
                        M8CounterIncrement(M8_COUNTER_READOUT_UNRESOLVED);
                    continue;
                }
                if (!M8IsHotRef(tileRef))
                {
                    if (inDraw)
                        M8CounterIncrement(M8_COUNTER_LATE_DRAW_COLD_MISSES);
                    if (inDependency)
                        M8CounterIncrement(M8_COUNTER_READOUT_UNRESOLVED);
                    continue;
                }
                uint physicalSlot = M8PhysicalSlot(tileRef);
                _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].z =
                    _M8Counters[M8_COUNTER_FRAME_EPOCH];
                if (!inDraw ||
                    _M8TileRecords[M8TileMetaIndex(physicalSlot)].z == 0u)
                    continue;
                uint visibleIndex;
                InterlockedAdd(_M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT],
                    1u, visibleIndex);
                if (visibleIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                    _M8VisibleTiles[visibleIndex] = uint2(physicalSlot, 0u);
                visibleChunk = true;
            }
        }
        if (visibleChunk) M8CounterIncrement(M8_COUNTER_VISIBLE_CHUNKS);
    }
}

[numthreads(1, 1, 1)]
void PrepareReadoutBuild(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_READOUT_UNRESOLVED] != 0u)
    {
        _M8FrameDispatchArgs[0] = 0u;
        _M8FrameDispatchArgs[1] = 1u;
        _M8FrameDispatchArgs[2] = 1u;
        _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
            MERKABA_READOUT_SKIPPED;
        return;
    }
    _M8FrameDispatchArgs[0] = min(
        _M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
}

#define M8_SHELL_HALO_SIDE 10
#define M8_SHELL_HALO_PLANE 100
#define M8_SHELL_HALO_COUNT 1000
#define M8_SHELL_GROUP_THREADS 128u
#define M8_SHELL_NEUTRAL_COLOR 0x00a0a0a0u

groupshared int gM8ShellEvidence[M8_SHELL_HALO_COUNT];
groupshared uint gM8ShellOccupied[M8_SHELL_HALO_COUNT];
groupshared uint gM8ShellStateTokens[M8_SHELL_HALO_COUNT];
groupshared uint gM8ShellOccupiedWords[MERKABA_M8_TILE_WORDS];
groupshared uint gM8ShellWordPrefixes[MERKABA_M8_TILE_WORDS];
groupshared uint gM8ShellUnresolved;
groupshared uint gM8ShellPhysicalSlot;
groupshared uint gM8ShellChunkIndex;
groupshared uint gM8ShellBlockIndex;
groupshared uint gM8ShellOccupiedCount;
groupshared uint gM8ShellBaseTriangle;
groupshared uint gM8ShellOutputValid;
groupshared int3 gM8ShellTileOrigin;

uint M8ShellHaloIndex(int3 haloCoord)
{
    return (uint)(haloCoord.x + haloCoord.y * M8_SHELL_HALO_SIDE +
        haloCoord.z * M8_SHELL_HALO_PLANE);
}

uint M8ShellIndex(int3 mainHaloCoord, int3 offset)
{
    return M8ShellHaloIndex(mainHaloCoord + offset);
}

// Missing logical paths are exact empty. Existing non-HOT payload is unresolved.
// The sparse lookup happens once per cooperatively loaded halo sample, never
// once per MAIN neighbour or emitted triangle.
bool M8TryLoadReadoutNeighbourState(MerkabaM8Address currentAddress,
    uint currentPhysicalSlot, uint currentChunkIndex, uint currentBlockIndex,
    int3 neighbourStep, out KernelState state, out uint stateToken)
{
    state = (KernelState)0;
    stateToken = 0u;
    int3 localSigned = int3(currentAddress.local) + neighbourStep;
    bool sameBlock = all(localSigned >= 0) && all(localSigned < 256);
    int3 blockCoord = currentAddress.blockCoord;
    if (!sameBlock)
    {
        if (localSigned.x < 0) { blockCoord.x--; localSigned.x += 256; }
        else if (localSigned.x >= 256) { blockCoord.x++; localSigned.x -= 256; }
        if (localSigned.y < 0) { blockCoord.y--; localSigned.y += 256; }
        else if (localSigned.y >= 256) { blockCoord.y++; localSigned.y -= 256; }
        if (localSigned.z < 0) { blockCoord.z--; localSigned.z += 256; }
        else if (localSigned.z >= 256) { blockCoord.z++; localSigned.z -= 256; }
    }
    MerkabaM8Address neighbourAddress = MerkabaAddressFromBlockLocal(
        blockCoord, uint3(localSigned));

    if (sameBlock &&
        neighbourAddress.chunkLocal == currentAddress.chunkLocal &&
        neighbourAddress.tileLocal == currentAddress.tileLocal)
    {
        state = M8LoadKernelStateRead(currentPhysicalSlot,
            neighbourAddress.kernelLocal);
        stateToken = (currentPhysicalSlot << 9u) |
            neighbourAddress.kernelLocal;
        stateToken++;
        return true;
    }

    uint chunkIndex = currentChunkIndex;
    if (neighbourAddress.chunkLocal != currentAddress.chunkLocal || !sameBlock)
    {
        uint blockIndex = currentBlockIndex;
        if (!sameBlock && !M8FindBlock(blockCoord, blockIndex)) return true;
        uint chunkRef = _M8BlockChunkRefsRead[blockIndex *
            MERKABA_M8_BLOCK_CHUNK_COUNT + neighbourAddress.chunkLocal];
        if (chunkRef == MERKABA_REF_EMPTY) return true;
        if (chunkRef == MERKABA_REF_CLAIMED_NEW) return false;
        chunkIndex = chunkRef - 1u;
    }

    uint tileRef = _M8ChunkTileRefsRead[chunkIndex *
        MERKABA_M8_TILES_PER_CHUNK + neighbourAddress.tileLocal];
    if (tileRef == MERKABA_REF_EMPTY) return true;
    if (!M8IsHotRef(tileRef)) return false;
    uint physicalSlot = M8PhysicalSlot(tileRef);
    state = M8LoadKernelStateRead(physicalSlot,
        neighbourAddress.kernelLocal);
    stateToken = (physicalSlot << 9u) | neighbourAddress.kernelLocal;
    stateToken++;
    return true;
}

M8OverlapSignature M8DeriveOverlapSignature(int3 mainHaloCoord)
{
    int3 freeMoment = int3(0, 0, 0);
    int3 occupiedCrossings = int3(0, 0, 0);
    [unroll]
    for (int z = -1; z <= 1; z++)
    [unroll]
    for (int y = -1; y <= 1; y++)
    [unroll]
    for (int x = -1; x <= 1; x++)
    {
        int3 offset = int3(x, y, z);
        if (all(offset == 0)) continue;
        uint sampleIndex = M8ShellIndex(mainHaloCoord, offset);
        if (gM8ShellEvidence[sampleIndex] < 0) freeMoment += offset;
        if (gM8ShellOccupied[sampleIndex] != 0u)
            occupiedCrossings += abs(offset);
    }

    M8OverlapSignature signature;
    signature.normalAxis = M8OverlapMinimumAxis(occupiedCrossings);
    int signedFree = freeMoment[signature.normalAxis];
    signature.hasKnownFreeSide = signedFree != 0 ? 1u : 0u;
    signature.freeSign = signedFree < 0 ? -1 : 1;
    return signature;
}

bool M8TryOverlapContributor(int3 mainHaloCoord,
    M8OverlapSignature signature, int3 normal, int3 tangentOffset,
    out int selectedHeight, out uint selectedStateToken)
{
    int columnFreeMoment = 0;
    [unroll]
    for (int normalOffset = -1; normalOffset <= 1; normalOffset++)
    {
        uint sampleIndex = M8ShellIndex(mainHaloCoord,
            tangentOffset + normal * normalOffset);
        if (gM8ShellEvidence[sampleIndex] < 0)
            columnFreeMoment += normalOffset;
    }

    bool mainColumn = all(tangentOffset == 0);
    if (!mainColumn && signature.hasKnownFreeSide != 0u &&
        columnFreeMoment != 0 &&
        (columnFreeMoment < 0 ? -1 : 1) != signature.freeSign)
    {
        selectedHeight = 0;
        selectedStateToken = 0u;
        return false;
    }

    bool found = false;
    int selectedDistance = 2;
    selectedHeight = 0;
    selectedStateToken = 0u;
    [unroll]
    for (int normalOffset = -1; normalOffset <= 1; normalOffset++)
    {
        uint sampleIndex = M8ShellIndex(mainHaloCoord,
            tangentOffset + normal * normalOffset);
        if (gM8ShellOccupied[sampleIndex] == 0u) continue;
        int distance = abs(normalOffset);
        // Iteration order -1,0,+1 is the exact lexicographic tie break.
        if (!found || distance < selectedDistance)
        {
            found = true;
            selectedDistance = distance;
            selectedHeight = normalOffset;
            selectedStateToken = gM8ShellStateTokens[sampleIndex];
        }
    }
    return found;
}

uint M8ReduceOverlapColor(int4 heights, uint4 stateTokens,
    uint count, int lowerHeight, int upperHeight)
{
    uint red = 0u;
    uint green = 0u;
    uint blue = 0u;
    uint alpha = 0u;
    uint total = 0u;
    [unroll]
    for (uint index = 0u; index < 4u; index++)
    {
        if (index >= count || heights[index] < lowerHeight ||
            heights[index] > upperHeight || stateTokens[index] == 0u)
            continue;
        uint stateIndex = stateTokens[index] - 1u;
        KernelState state = M8LoadKernelStateRead(stateIndex >> 9u,
            stateIndex & 511u);
        uint weight = min(state.colorConfidence, 65535u);
        if (weight == 0u) continue;
        uint color = state.packedColor;
        red += (color & 255u) * weight;
        green += ((color >> 8u) & 255u) * weight;
        blue += ((color >> 16u) & 255u) * weight;
        alpha += ((color >> 24u) & 255u) * weight;
        total += weight;
    }
    if (total == 0u) return M8_SHELL_NEUTRAL_COLOR;
    float inverseTotal = rcp((float)total);
    uint4 reduced = (uint4)floor(float4(red, green, blue, alpha) *
        inverseTotal + 0.5);
    return reduced.x | (reduced.y << 8u) | (reduced.z << 16u) |
        (reduced.w << 24u);
}

M8OverlapCorner M8BuildOverlapCorner(int3 globalCoord,
    int3 mainHaloCoord, M8OverlapSignature signature, int3 normal,
    int3 tangent0, int3 tangent1, int tangentSign0, int tangentSign1)
{
    int4 heights = int4(0, 0, 0, 0);
    uint4 stateTokens = uint4(0u, 0u, 0u, 0u);
    uint contributorCount = 0u;

    [unroll]
    for (int v = 0; v <= 1; v++)
    [unroll]
    for (int u = 0; u <= 1; u++)
    {
        int3 tangentOffset =
            (u == 0 ? int3(0, 0, 0) : tangent0 * tangentSign0) +
            (v == 0 ? int3(0, 0, 0) : tangent1 * tangentSign1);
        int height;
        uint stateToken;
        if (!M8TryOverlapContributor(mainHaloCoord, signature, normal,
                tangentOffset, height, stateToken))
            continue;
        heights[contributorCount] = height;
        stateTokens[contributorCount] = stateToken;
        contributorCount++;
    }

    int lowerHeight;
    int upperHeight;
    M8OverlapMedianBand(heights, contributorCount,
        lowerHeight, upperHeight);

    M8OverlapCorner corner;
    corner.quarterCoordinate =
        globalCoord * M8_OVERLAP_QUARTERS_PER_STEP +
        tangent0 * (tangentSign0 * M8_OVERLAP_HALF_STEP_QUARTERS) +
        tangent1 * (tangentSign1 * M8_OVERLAP_HALF_STEP_QUARTERS);
    corner.quarterCoordinate[signature.normalAxis] =
        globalCoord[signature.normalAxis] *
        M8_OVERLAP_QUARTERS_PER_STEP +
        M8OverlapMedianQuarterHeight(heights, contributorCount);
    corner.packedColor = M8ReduceOverlapColor(heights, stateTokens,
        contributorCount, lowerHeight, upperHeight);
    return corner;
}

struct M8OverlapPatch
{
    M8OverlapSignature signature;
    M8OverlapCorner corner00;
    M8OverlapCorner corner10;
    M8OverlapCorner corner11;
    M8OverlapCorner corner01;
};

M8OverlapPatch M8BuildOverlapPatch(int3 globalCoord, int3 mainHaloCoord)
{
    M8OverlapPatch patch;
    patch.signature = M8DeriveOverlapSignature(mainHaloCoord);
    int3 normal;
    int3 tangent0;
    int3 tangent1;
    M8OverlapAxes(patch.signature.normalAxis, normal, tangent0, tangent1);
    patch.corner00 = M8BuildOverlapCorner(globalCoord, mainHaloCoord,
        patch.signature, normal, tangent0, tangent1, -1, -1);
    patch.corner10 = M8BuildOverlapCorner(globalCoord, mainHaloCoord,
        patch.signature, normal, tangent0, tangent1, 1, -1);
    patch.corner11 = M8BuildOverlapCorner(globalCoord, mainHaloCoord,
        patch.signature, normal, tangent0, tangent1, 1, 1);
    patch.corner01 = M8BuildOverlapCorner(globalCoord, mainHaloCoord,
        patch.signature, normal, tangent0, tangent1, -1, 1);
    return patch;
}

M8OverlapCorner M8OverlapPatchCorner(M8OverlapPatch patch, uint index)
{
    if (index == 0u) return patch.corner00;
    if (index == 1u) return patch.corner10;
    if (index == 2u) return patch.corner11;
    return patch.corner01;
}

uint M8OccupiedPrefix(uint kernelLocal)
{
    uint wordIndex = kernelLocal >> 5u;
    uint bitIndex = kernelLocal & 31u;
    uint belowMask = bitIndex == 0u ? 0u : ((1u << bitIndex) - 1u);
    return gM8ShellWordPrefixes[wordIndex] + countbits(
        gM8ShellOccupiedWords[wordIndex] & belowMask);
}

void M8StoreReadoutVertex(uint outputTriangle, uint corner,
    float3 gridPosition, uint packedColor)
{
    uint outputVertex = outputTriangle * M8_READOUT_VERTICES_PER_TRIANGLE;
    bool secondBuffer = outputTriangle >=
        MERKABA_M8_READOUT_TRIANGLES_PER_BUFFER;
    if (secondBuffer)
        outputVertex -= MERKABA_M8_READOUT_VERTICES_PER_BUFFER;
    MerkabaReadoutVertex vertex;
    vertex.gridPosition = gridPosition;
    vertex.packedColor = packedColor;
    if (secondBuffer)
        _M8ReadoutVertices1[outputVertex + corner] = vertex;
    else
        _M8ReadoutVertices0[outputVertex + corner] = vertex;
}

bool M8LoadOverlapHalo(uint physicalSlot,
    uint3 groupThreadId, uint thread, uint failureStatus)
{
    if (thread == 0u)
    {
        gM8ShellUnresolved = 0u;
        gM8ShellPhysicalSlot = physicalSlot;
        uint4 tileMeta = M8LoadTileMetaRead(physicalSlot);
        gM8ShellChunkIndex = tileMeta.x;
        gM8ShellOccupiedCount = tileMeta.z;
        gM8ShellBlockIndex =
            M8LoadChunkOwnerRead(gM8ShellChunkIndex).x;
        gM8ShellTileOrigin =
            M8GlobalKernelCoordRead(physicalSlot, 0u);
    }
    GroupMemoryBarrierWithGroupSync();

    MerkabaM8Address tileOriginAddress =
        MerkabaAddressOf(gM8ShellTileOrigin);
    for (uint z = groupThreadId.z; z < M8_SHELL_HALO_SIDE; z += 2u)
    for (uint y = groupThreadId.y; y < M8_SHELL_HALO_SIDE; y += 8u)
    for (uint x = groupThreadId.x; x < M8_SHELL_HALO_SIDE; x += 8u)
    {
        int3 haloCoord = int3(x, y, z);
        KernelState state;
        uint stateToken;
        bool resolved = M8TryLoadReadoutNeighbourState(tileOriginAddress,
            gM8ShellPhysicalSlot, gM8ShellChunkIndex, gM8ShellBlockIndex,
            haloCoord - int3(1, 1, 1), state, stateToken);
        uint haloIndex = M8ShellHaloIndex(haloCoord);
        gM8ShellEvidence[haloIndex] = state.evidence;
        gM8ShellOccupied[haloIndex] =
            (state.flags & MERKABA_OCCUPIED_FLAG) != 0u ? 1u : 0u;
        gM8ShellStateTokens[haloIndex] = stateToken;
        if (!resolved)
        {
            uint ignored;
            InterlockedOr(gM8ShellUnresolved, 1u, ignored);
        }
    }
    if (thread < MERKABA_M8_TILE_WORDS)
        gM8ShellOccupiedWords[thread] =
            _M8TileBitsRead[M8TileWordIndex(gM8ShellPhysicalSlot, thread)].x;
    GroupMemoryBarrierWithGroupSync();

    if (gM8ShellUnresolved == 0u) return true;
    if (thread == 0u)
    {
        M8CounterIncrement(M8_COUNTER_LATE_DRAW_COLD_MISSES);
        M8CounterIncrement(M8_COUNTER_READOUT_UNRESOLVED);
        uint ignored;
        InterlockedMax(_M8Counters[M8_COUNTER_READOUT_BUILD_STATUS],
            failureStatus, ignored);
    }
    return false;
}

[numthreads(8, 8, 2)]
void PreflightReadout(uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID, uint thread : SV_GroupIndex)
{
    uint2 visibleTile = _M8VisibleTiles[groupId.x];
    if (!M8LoadOverlapHalo(visibleTile.x, groupThreadId, thread,
            MERKABA_READOUT_FAILED))
        return;

    if (thread != 0u) return;
    uint primitiveCount =
        gM8ShellOccupiedCount * M8_OVERLAP_TRIANGLES_PER_PATCH;
    uint ignored;
    InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_CONSIDERED],
        gM8ShellOccupiedCount, ignored);
    InterlockedAdd(_M8Counters[M8_COUNTER_PRIMITIVES_BEFORE_FACING],
        primitiveCount, ignored);
    uint baseTriangle;
    InterlockedAdd(_M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES],
        primitiveCount, baseTriangle);
    if (baseTriangle + primitiveCount >
        MERKABA_M8_READOUT_TRIANGLE_CAPACITY)
    {
        _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 1u;
        InterlockedMax(_M8Counters[M8_COUNTER_READOUT_BUILD_STATUS],
            MERKABA_READOUT_FAILED, ignored);
        return;
    }
    _M8VisibleTiles[groupId.x].y = baseTriangle;
}

[numthreads(1, 1, 1)]
void PrepareReadoutEmit(uint id : SV_DispatchThreadID)
{
    uint status = _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS];
    uint logical =
        _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES];
    if (status != MERKABA_READOUT_BUILDING ||
        _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] != 0u ||
        _M8Counters[M8_COUNTER_READOUT_UNRESOLVED] != 0u ||
        logical > MERKABA_M8_READOUT_TRIANGLE_CAPACITY)
    {
        _M8FrameDispatchArgs[0] = 0u;
        _M8FrameDispatchArgs[1] = 1u;
        _M8FrameDispatchArgs[2] = 1u;
        if (status == MERKABA_READOUT_BUILDING)
            _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
                MERKABA_READOUT_FAILED;
        return;
    }

    _M8FrameDispatchArgs[0] = min(
        _M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
    _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
        MERKABA_READOUT_PREFLIGHTED;
}

[numthreads(8, 8, 2)]
void EmitReadoutVertices(uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID, uint thread : SV_GroupIndex)
{
    uint2 visibleTile = _M8VisibleTilesRead[groupId.x];
    if (!M8LoadOverlapHalo(visibleTile.x, groupThreadId, thread,
            MERKABA_READOUT_EMIT_FAILED))
        return;

    if (thread < MERKABA_M8_TILE_WORDS)
    {
        uint prefix = 0u;
        [unroll]
        for (uint word = 0u; word < MERKABA_M8_TILE_WORDS; word++)
        {
            if (word >= thread) break;
            prefix += countbits(gM8ShellOccupiedWords[word]);
        }
        gM8ShellWordPrefixes[thread] = prefix;
    }
    if (thread == 0u)
    {
        uint ignored;
        InterlockedAdd(
            _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES],
            gM8ShellOccupiedCount * M8_OVERLAP_TRIANGLES_PER_PATCH,
            ignored);
    }
    GroupMemoryBarrierWithGroupSync();

    for (uint kernelLocal = thread;
        kernelLocal < MERKABA_M8_KERNELS_PER_TILE;
        kernelLocal += M8_SHELL_GROUP_THREADS)
    {
        uint word = kernelLocal >> 5u;
        uint bit = 1u << (kernelLocal & 31u);
        if ((gM8ShellOccupiedWords[word] & bit) == 0u) continue;

        int3 tileLocal = int3(kernelLocal & 7u,
            (kernelLocal >> 3u) & 7u, (kernelLocal >> 6u) & 7u);
        int3 globalCoord = gM8ShellTileOrigin + tileLocal;
        M8OverlapPatch patch = M8BuildOverlapPatch(globalCoord,
            tileLocal + 1);
        uint outputTriangle = visibleTile.y +
            M8OccupiedPrefix(kernelLocal) *
            M8_OVERLAP_TRIANGLES_PER_PATCH;

        [unroll]
        for (uint vertex = 0u; vertex < 6u; vertex++)
        {
            uint cornerIndex = M8OverlapTriangleCorner(
                patch.signature.freeSign, vertex);
            M8OverlapCorner corner =
                M8OverlapPatchCorner(patch, cornerIndex);
            uint triangleOffset = vertex >= 3u ? 1u : 0u;
            uint triangleCorner = vertex - triangleOffset * 3u;
            M8StoreReadoutVertex(outputTriangle + triangleOffset,
                triangleCorner,
                (float3)corner.quarterCoordinate *
                    (MERKABA_LATTICE_STEP * 0.25),
                corner.packedColor);
        }
    }
}

[numthreads(1, 1, 1)]
void FinalizeReadout(uint id : SV_DispatchThreadID)
{
    uint status = _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS];
    if (status == MERKABA_READOUT_SKIPPED ||
        status == MERKABA_READOUT_FAILED)
        return;

    uint logical =
        _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES];
    uint emitted =
        _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES];
    if (status != MERKABA_READOUT_PREFLIGHTED ||
        _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] != 0u ||
        _M8Counters[M8_COUNTER_READOUT_UNRESOLVED] != 0u ||
        logical > MERKABA_M8_READOUT_TRIANGLE_CAPACITY ||
        emitted != logical)
    {
        // A post-preflight mismatch is an invariant violation. Suppress the
        // corrupted generation; normal dependency/capacity failure returned
        // above without touching the last-good args or vertex stream.
        _M8DrawArgs[0] = 0u;
        _M8DrawArgs[1] = 2u;
        _M8DrawArgs[2] = 0u;
        _M8DrawArgs[3] = 0u;
        _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
            MERKABA_READOUT_EMIT_FAILED;
        return;
    }

    _M8DrawArgs[0] = logical * M8_READOUT_VERTICES_PER_TRIANGLE;
    _M8DrawArgs[1] = 2u;
    _M8DrawArgs[2] = 0u;
    _M8DrawArgs[3] = 0u;
    _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
        MERKABA_READOUT_PUBLISHED;
}
