#pragma kernel BeginRenderBuild
#pragma kernel RequestWarmResidency
#pragma kernel ReclaimRenderPages
#pragma kernel ApplyRenderReclaim
#pragma kernel CopyRenderIndex
#pragma kernel MarkRenderRebuildTiles
#pragma kernel CollectRenderRebuildTiles
#pragma kernel PrepareRenderBuild
#pragma kernel BuildRenderTiles
#pragma kernel PublishRenderTileList
#pragma kernel FinalizeReadout
#pragma kernel CullRenderTiles
#pragma kernel PrepareVisibleIndices
#pragma kernel EmitVisibleIndices

#include "MerkabaWorld.hlsl"
#include "MerkabaSurfaceOrientation.generated.hlsl"

#define MERKABA_LATTICE_STEP 0.025
#define MERKABA_HALF_SUPPORT 0.025
#define MERKABA_OCCUPIED_FLAG 1u
#define M8_RENDER_SLOT_GROUP 256u
#define M8_SHELL_GROUP_THREADS 128u
#define M8_CULL_GROUP_THREADS 128u
#define M8_EMIT_GROUP_THREADS 64u

// Disposable readout publication. A build rewrites only tiles whose membrane
// inputs changed (plus their 26-tile dependency halo) into free pages of one
// shared vertex pool. Tile records live in two FRONT/BACK index slots; the
// CPU adopts BACK atomically. Pages retired by a publication are reclaimed
// by the next build, after every frame that could draw them has run.
RWStructuredBuffer<uint2> _M8VisibleTiles;
StructuredBuffer<uint2> _M8VisibleTilesRead;
RWByteAddressBuffer _M8RenderVertices;
RWStructuredBuffer<uint> _M8RenderIndexBack;
StructuredBuffer<uint> _M8RenderIndexFrontRead;
RWStructuredBuffer<uint> _M8RenderPageQueues;
RWStructuredBuffer<uint> _M8RenderMutationQueue;
RWStructuredBuffer<uint> _M8FrameDispatchArgs;
RWStructuredBuffer<uint4> _M8AttemptCompletion;

// Per-frame visibility (graphics queue, FRONT only).
RWStructuredBuffer<uint> _M8VisiblePages;
StructuredBuffer<uint> _M8VisiblePagesRead;
RWStructuredBuffer<uint> _M8CullControl;
StructuredBuffer<uint> _M8CullControlRead;
RWStructuredBuffer<uint> _M8RenderDrawArgs;
RWByteAddressBuffer _M8VisibleIndices;

float3 _M8CameraGridMeters;
float3 _M8GridMetricDiagonal;
float3 _M8GridMetricCross;
float _M8RenderDistance;
float _M8WarmDistance;
float _M8DependencyDistance;
int3 _M8QueryCenterBlock;
int _M8QueryBlockRadius;
int _M8QueryBlockSide;
float4x4 _MerkabaGridToWorld;
float4x4 _MerkabaWorldToGrid;
float4 _M8CullGridPlanes[12];
uint _M8ReadoutRevision;
uint _M8PreviousPublished;
uint _M8ResidencyChanged;
uint _M8FrontTileCount;

uint M8RecordBase(uint physicalSlot)
{
    return M8_RENDER_INDEX_HEADER + physicalSlot * M8_RENDER_RECORD_WORDS;
}

bool M8AabbIntersectsDistance(int3 globalMin, int span, float distance)
{
    return MerkabaM8GridAabbIntersectsDistance(globalMin, span, distance,
        _M8CameraGridMeters, _M8GridMetricDiagonal, _M8GridMetricCross,
        MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
}

uint M8DistanceChildMask(int3 parentMin, int parentSpan, float distance)
{
    return MerkabaM8GridDistanceChildMask(parentMin, parentSpan, distance,
        _M8CameraGridMeters, _M8GridMetricDiagonal, _M8GridMetricCross,
        MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
}

uint M8DrawChildMask(int3 parentMin, int parentSpan)
{
    return M8DistanceChildMask(parentMin, parentSpan, _M8RenderDistance);
}

uint M8DependencyChildMask(int3 parentMin, int parentSpan)
{
    return M8DistanceChildMask(parentMin, parentSpan,
        _M8DependencyDistance);
}

void M8RequestWarmLoad(uint tileRefIndex, uint chunkIndex, uint tileLocal,
    bool lateDraw)
{
    M8QueueColdTileLoad(tileRefIndex, chunkIndex, tileLocal);
    if (lateDraw) M8CounterIncrement(M8_COUNTER_LATE_DRAW_COLD_MISSES);
}

[numthreads(1, 1, 1)]
void BeginRenderBuild(uint id : SV_DispatchThreadID)
{
    _M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT] = 0u;
    _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 0u;
    _M8Counters[M8_COUNTER_LATE_DRAW_COLD_MISSES] = 0u;
    _M8Counters[M8_COUNTER_CANDIDATE_BLOCKS] = 0u;
    _M8Counters[M8_COUNTER_HASH_HIT_BLOCKS] = 0u;
    _M8Counters[M8_COUNTER_VISIBLE_CHUNKS] = 0u;
    _M8Counters[M8_COUNTER_OCCUPIED_CONSIDERED] = 0u;
    _M8Counters[M8_COUNTER_READOUT_PLANE_VALID] = 0u;
    _M8Counters[M8_COUNTER_READOUT_EMITTED_PATCHES] = 0u;
    _M8Counters[M8_COUNTER_READOUT_UNRESOLVED] = 0u;
    _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES] = 0u;
    _M8Counters[M8_COUNTER_READOUT_PLANE_LEGACY_INVALID] = 0u;
    _M8Counters[M8_COUNTER_READOUT_EMITTED_VERTICES] = 0u;
    _M8Counters[M8_COUNTER_RENDER_REBUILD_TILES] = 0u;
    _M8Counters[M8_COUNTER_RENDER_BUILD_OVERFLOW] = 0u;
    _M8Counters[M8_COUNTER_RENDER_PENDING_TILES] = 0u;
    _M8Counters[M8_COUNTER_RENDER_CAPACITY_FAILED] = 0u;
    _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] = MERKABA_READOUT_BUILDING;
    _M8Counters[M8_COUNTER_FRAME_EPOCH] += 1u;
    uint reclaim = _M8PreviousPublished != 0u
        ? _M8RenderPageQueues[M8_RENDER_CONTROL_RETIRE_COUNT]
        : _M8RenderPageQueues[M8_RENDER_CONTROL_ALLOC_COUNT];
    reclaim = min(reclaim, M8_RENDER_PAGE_CAPACITY);
    _M8RenderPageQueues[M8_RENDER_CONTROL_RECLAIM_COUNT] = reclaim;
    _M8FrameDispatchArgs[0] = (reclaim + 255u) / 256u;
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
}

groupshared uint gFrameBlockRef;
groupshared int3 gFrameBlockMin;
groupshared uint gFrameWarm4;
groupshared uint gFrameDraw4;
groupshared uint gFrameDependency4;
groupshared uint gFrameWarm3[8];
groupshared uint gFrameDraw3[8];
groupshared uint gFrameDependency3[8];

[numthreads(64, 1, 1)]
void RequestWarmResidency(uint3 groupId : SV_GroupID, uint thread : SV_GroupIndex)
{
    uint linearBlockIndex = groupId.x;
    if (thread == 0u)
    {
        gFrameBlockRef = 0u;
        gFrameWarm4 = 0u;
        gFrameDraw4 = 0u;
        gFrameDependency4 = 0u;
        uint side = (uint)_M8QueryBlockSide;
        if (linearBlockIndex < side * side * side)
        {
            int3 offset;
            offset.x = (int)(linearBlockIndex % side) - _M8QueryBlockRadius;
            offset.y = (int)((linearBlockIndex / side) % side) -
                _M8QueryBlockRadius;
            offset.z = (int)(linearBlockIndex / (side * side)) -
                _M8QueryBlockRadius;
            int3 blockCoord = _M8QueryCenterBlock + offset;
            gFrameBlockMin = blockCoord * MERKABA_M8_BLOCK_KERNEL_SPAN;
            M8CounterIncrement(M8_COUNTER_CANDIDATE_BLOCKS);
            if (M8AabbIntersectsDistance(gFrameBlockMin,
                MERKABA_M8_BLOCK_KERNEL_SPAN, _M8WarmDistance))
            {
                uint blockIndex = 0u;
                if (M8FindBlock(blockCoord, blockIndex))
                {
                    gFrameBlockRef = blockIndex + 1u;
                    gFrameWarm4 = M8DistanceChildMask(gFrameBlockMin, 256,
                        _M8WarmDistance);
                    gFrameDraw4 = M8DrawChildMask(gFrameBlockMin, 256);
                    gFrameDependency4 = M8DependencyChildMask(
                        gFrameBlockMin, 256);
                    M8CounterIncrement(M8_COUNTER_HASH_HIT_BLOCKS);
                }
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (thread < 8u)
    {
        uint d4ForMask = thread;
        gFrameWarm3[d4ForMask] = 0u;
        gFrameDraw3[d4ForMask] = 0u;
        gFrameDependency3[d4ForMask] = 0u;
        if (gFrameBlockRef != 0u)
        {
            uint maskBlockIndex = gFrameBlockRef - 1u;
            if (((_M8BlockPresenceL0Read[maskBlockIndex] & gFrameWarm4) &
                (1u << d4ForMask)) != 0u)
            {
                int3 min4ForMask = gFrameBlockMin +
                    MerkabaM8OctantOffset(d4ForMask, 128);
                gFrameWarm3[d4ForMask] = M8DistanceChildMask(min4ForMask, 128,
                    _M8WarmDistance);
                gFrameDraw3[d4ForMask] =
                    ((gFrameDraw4 >> d4ForMask) & 1u) != 0u
                    ? M8DrawChildMask(min4ForMask, 128) : 0u;
                gFrameDependency3[d4ForMask] =
                    ((gFrameDependency4 >> d4ForMask) & 1u) != 0u
                    ? M8DependencyChildMask(min4ForMask, 128) : 0u;
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gFrameBlockRef == 0u) return;

    uint blockIndex = gFrameBlockRef - 1u;
    int3 blockMin = gFrameBlockMin;
    uint d4 = thread >> 3u;
    uint d3 = thread & 7u;
    if (((gFrameWarm4 >> d4) & 1u) == 0u ||
        (((_M8BlockPresenceL1Read[blockIndex * 8u + d4] &
        gFrameWarm3[d4]) >> d3) & 1u) == 0u) return;

    int3 min4 = blockMin + MerkabaM8OctantOffset(d4, 128);
    int3 min3 = min4 + MerkabaM8OctantOffset(d3, 64);
    uint warm2 = M8DistanceChildMask(min3, 64, _M8WarmDistance);
    bool drawPath3 = ((gFrameDraw4 >> d4) & 1u) != 0u &&
        ((gFrameDraw3[d4] >> d3) & 1u) != 0u;
    bool dependencyPath3 = ((gFrameDependency4 >> d4) & 1u) != 0u &&
        ((gFrameDependency3[d4] >> d3) & 1u) != 0u;
    uint draw2 = drawPath3 ? M8DrawChildMask(min3, 64) : 0u;
    uint dependency2 = dependencyPath3
        ? M8DependencyChildMask(min3, 64) : 0u;
    uint support2 = (_M8BlockPresenceL2Read[blockIndex * 64u +
        d4 * 8u + d3] & 255u) & warm2;
    while (support2 != 0u)
    {
        uint d2 = (uint)firstbitlow(support2);
        support2 &= support2 - 1u;
        uint chunkLocal = (d4 << 6u) | (d3 << 3u) | d2;
        uint chunkRef = _M8BlockChunkRefsRead[blockIndex * 512u + chunkLocal];
        if (chunkRef == 0u || chunkRef >= MERKABA_REF_EVICTING) continue;
        uint chunkIndex = chunkRef - 1u;
        int3 min2 = min3 + MerkabaM8OctantOffset(d2, 32);
        uint warm1 = M8DistanceChildMask(min2, 32, _M8WarmDistance);
        bool drawPath2 = drawPath3 && ((draw2 >> d2) & 1u) != 0u;
        bool dependencyPath2 = dependencyPath3 &&
            ((dependency2 >> d2) & 1u) != 0u;
        uint draw1 = drawPath2 ? M8DrawChildMask(min2, 32) : 0u;
        uint dependency1 = dependencyPath2
            ? M8DependencyChildMask(min2, 32) : 0u;
        uint support1 =
            (_M8ChunkPresenceRead[M8ChunkPresenceL0Index(chunkIndex)] &
            255u) & warm1;
        bool visibleChunk = false;
        while (support1 != 0u)
        {
            uint d1 = (uint)firstbitlow(support1);
            support1 &= support1 - 1u;
            int3 min1 = min2 + MerkabaM8OctantOffset(d1, 16);
            uint warm0 = M8DistanceChildMask(min1, 16, _M8WarmDistance);
            bool drawPath1 = drawPath2 && ((draw1 >> d1) & 1u) != 0u;
            bool dependencyPath1 = dependencyPath2 &&
                ((dependency1 >> d1) & 1u) != 0u;
            uint draw0 = drawPath1 ? M8DrawChildMask(min1, 16) : 0u;
            uint dependency0 = dependencyPath1
                ? M8DependencyChildMask(min1, 16) : 0u;
            uint support0 =
                (_M8ChunkPresenceRead[
                    M8ChunkPresenceL1Index(chunkIndex, d1)] & 255u) & warm0;
            while (support0 != 0u)
            {
                uint d0 = (uint)firstbitlow(support0);
                support0 &= support0 - 1u;
                uint tileLocal = (d1 << 3u) | d0;
                uint tileRefIndex = chunkIndex * 64u + tileLocal;
                uint tileRef = _M8ChunkTileRefs[tileRefIndex];
                bool inDraw = drawPath1 && ((draw0 >> d0) & 1u) != 0u;
                bool inDependency = dependencyPath1 &&
                    ((dependency0 >> d0) & 1u) != 0u;
                if (tileRef == MERKABA_REF_COLD_ON_SSD)
                {
                    M8RequestWarmLoad(tileRefIndex, chunkIndex, tileLocal,
                        inDraw);
                    if (inDraw)
                        M8CounterIncrement(M8_COUNTER_READOUT_UNRESOLVED);
                    continue;
                }
                if (!M8IsHotRef(tileRef) && inDraw)
                    M8CounterIncrement(M8_COUNTER_READOUT_UNRESOLVED);
                if (inDraw) visibleChunk = true;
            }
        }
        if (visibleChunk) M8CounterIncrement(M8_COUNTER_VISIBLE_CHUNKS);
    }
}

struct M8ReadoutTileContext
{
    uint physicalSlot;
    int3 tileOrigin;
    int3 blockCoord;
    uint blockIndex;
    uint chunkIndex;
    uint chunkLocal;
};

#define M8_MEMBRANE_TILE_COUNT 27u
#define M8_MEMBRANE_TILE_WORD_COUNT \
    (M8_MEMBRANE_TILE_COUNT * MERKABA_M8_TILE_WORDS)
#define M8_MEMBRANE_CACHE_HALO 2
#define M8_MEMBRANE_CACHE_SIDE 12u
#define M8_MEMBRANE_CACHE_PLANE \
    (M8_MEMBRANE_CACHE_SIDE * M8_MEMBRANE_CACHE_SIDE)
#define M8_MEMBRANE_CACHE_COUNT \
    (M8_MEMBRANE_CACHE_PLANE * M8_MEMBRANE_CACHE_SIDE)
#define M8_MEMBRANE_CENTER_TILE 13u
#define M8_MEMBRANE_TILE_MISSING 0xfffffffeu
#define M8_MEMBRANE_TILE_UNRESOLVED 0xffffffffu

groupshared uint gM8MembranePhysicalSlot;
groupshared int3 gM8MembraneTileOrigin;
groupshared int3 gM8MembraneBlockCoord;
groupshared uint gM8MembraneBlockIndex;
groupshared uint gM8MembraneChunkIndex;
groupshared uint gM8MembraneChunkLocal;
groupshared uint gM8MembraneTileSlots[M8_MEMBRANE_TILE_COUNT];
groupshared uint gM8MembraneOccupiedWords[M8_MEMBRANE_TILE_WORD_COUNT];
// A membrane decision needs only signed FREE evidence and packed plane flags.
// PackedColor is loaded once, only for a MAIN which actually emits.
groupshared uint2 gM8MembraneState[M8_MEMBRANE_CACHE_COUNT];
groupshared uint gM8MembranePatchWords[4];
groupshared uint gM8MembraneMeasuredWords[4];
groupshared uint gM8SkinCounts[M8_SHELL_GROUP_THREADS];
groupshared uint gM8SkinPrefix[M8_SHELL_GROUP_THREADS];
groupshared uint gM8MembraneCanEmit;
groupshared uint gM8MembraneMeasuredTotal;
groupshared uint gM8MembranePageIds[M8_RENDER_TILE_MAX_PAGES];
groupshared uint gM8MembranePageCount;
groupshared uint gM8MembranePatchTotal;
groupshared uint gM8MembraneBatchBase;
groupshared uint gM8MembraneFailed;
groupshared uint gM8MembraneUnresolved;

M8ReadoutTileContext M8SharedReadoutTileContext()
{
    M8ReadoutTileContext context;
    context.physicalSlot = gM8MembranePhysicalSlot;
    context.tileOrigin = gM8MembraneTileOrigin;
    context.blockCoord = gM8MembraneBlockCoord;
    context.blockIndex = gM8MembraneBlockIndex;
    context.chunkIndex = gM8MembraneChunkIndex;
    context.chunkLocal = gM8MembraneChunkLocal;
    return context;
}

M8ReadoutTileContext M8TileContextOf(uint physicalSlot)
{
    // The tile being rebuilt owns scheduling bits in _M8TileRecords, so the
    // context reads the writable binding (a kernel never binds both aliases).
    M8ReadoutTileContext context;
    uint4 meta = _M8TileRecords[M8TileMetaIndex(physicalSlot)];
    uint2 owner = M8LoadChunkOwnerRead(meta.x);
    context.physicalSlot = physicalSlot;
    context.tileOrigin = M8GlobalKernelCoord(physicalSlot, 0u);
    context.blockIndex = owner.x;
    context.chunkIndex = meta.x;
    context.chunkLocal = owner.y;
    context.blockCoord = M8LoadBlockCoordRead(owner.x);
    return context;
}

void M8InitializeReadoutTileContext(uint physicalSlot)
{
    M8ReadoutTileContext context = M8TileContextOf(physicalSlot);
    gM8MembranePhysicalSlot = context.physicalSlot;
    gM8MembraneTileOrigin = context.tileOrigin;
    gM8MembraneBlockIndex = context.blockIndex;
    gM8MembraneChunkIndex = context.chunkIndex;
    gM8MembraneChunkLocal = context.chunkLocal;
    gM8MembraneBlockCoord = context.blockCoord;
}

uint M8MembraneTileIndex(int3 tileOffset)
{
    return (uint)(tileOffset.x + 1) +
        (uint)(tileOffset.y + 1) * 3u +
        (uint)(tileOffset.z + 1) * 9u;
}

int3 M8MembraneTileOffset(uint index)
{
    uint z = index >= 18u ? 2u : index >= 9u ? 1u : 0u;
    uint remainder = index - z * 9u;
    uint y = remainder >= 6u ? 2u : remainder >= 3u ? 1u : 0u;
    uint x = remainder - y * 3u;
    return int3((int)x - 1, (int)y - 1, (int)z - 1);
}

uint M8ResolveMembraneTile(M8ReadoutTileContext context, int3 tileOffset)
{
    if (!any(tileOffset != 0)) return context.physicalSlot;

    MerkabaM8Address address = MerkabaAddressOf(
        context.tileOrigin + tileOffset * 8);
    uint blockIndex = context.blockIndex;
    if (!all(address.blockCoord == context.blockCoord) &&
        !M8FindBlock(address.blockCoord, blockIndex))
        return M8_MEMBRANE_TILE_MISSING;

    uint chunkIndex = context.chunkIndex;
    if (blockIndex != context.blockIndex ||
        address.chunkLocal != context.chunkLocal)
    {
        uint chunkRef = _M8BlockChunkRefsRead[blockIndex *
            MERKABA_M8_BLOCK_CHUNK_COUNT + address.chunkLocal];
        if (chunkRef == MERKABA_REF_EMPTY)
            return M8_MEMBRANE_TILE_MISSING;
        if (chunkRef >= MERKABA_REF_EVICTING)
            return M8_MEMBRANE_TILE_UNRESOLVED;
        chunkIndex = chunkRef - 1u;
    }

    uint tileRef = _M8ChunkTileRefsRead[chunkIndex *
        MERKABA_M8_TILES_PER_CHUNK + address.tileLocal];
    if (tileRef == MERKABA_REF_EMPTY)
        return M8_MEMBRANE_TILE_MISSING;
    if (!M8IsHotRef(tileRef))
        return M8_MEMBRANE_TILE_UNRESOLVED;
    return M8PhysicalSlot(tileRef);
}

uint M8LoadKernelFlagsOnly(uint physicalSlot, uint kernelLocal)
{
    uint index = M8BankStateIndex(physicalSlot, kernelLocal);
    uint bank = physicalSlot >> MERKABA_M8_TILE_BANK_SHIFT;
    if (bank == 0u) return _M8KernelStates0Read[index].flags;
    if (bank == 1u) return _M8KernelStates1Read[index].flags;
    if (bank == 2u) return _M8KernelStates2Read[index].flags;
    return _M8KernelStates3Read[index].flags;
}

int M8LoadKernelEvidenceOnly(uint physicalSlot, uint kernelLocal)
{
    uint index = M8BankStateIndex(physicalSlot, kernelLocal);
    uint bank = physicalSlot >> MERKABA_M8_TILE_BANK_SHIFT;
    if (bank == 0u) return _M8KernelStates0Read[index].evidence;
    if (bank == 1u) return _M8KernelStates1Read[index].evidence;
    if (bank == 2u) return _M8KernelStates2Read[index].evidence;
    return _M8KernelStates3Read[index].evidence;
}

void M8MembraneCacheAddress(uint index, out int3 relative,
    out uint tileIndex, out uint kernelLocal)
{
    // The bounded [0,1727] index is exactly representable as float. Reciprocal
    // indexing avoids integer division in this Adreno hot path.
    uint z = (uint)((float)index * (1.0 / 144.0));
    uint remainder = index - z * M8_MEMBRANE_CACHE_PLANE;
    uint y = (uint)((float)remainder * (1.0 / 12.0));
    uint x = remainder - y * M8_MEMBRANE_CACHE_SIDE;
    relative = int3((int)x, (int)y, (int)z) - M8_MEMBRANE_CACHE_HALO;
    int3 tileOffset = int3(relative.x < 0 ? -1 : relative.x >= 8 ? 1 : 0,
        relative.y < 0 ? -1 : relative.y >= 8 ? 1 : 0,
        relative.z < 0 ? -1 : relative.z >= 8 ? 1 : 0);
    int3 tileLocal = relative - tileOffset * 8;
    tileIndex = M8MembraneTileIndex(tileOffset);
    kernelLocal = (uint)tileLocal.x | ((uint)tileLocal.y << 3u) |
        ((uint)tileLocal.z << 6u);
}

uint M8MembraneCacheIndex(int3 globalCoord)
{
    int3 local = globalCoord - gM8MembraneTileOrigin +
        M8_MEMBRANE_CACHE_HALO;
    return (uint)local.x + (uint)local.y * M8_MEMBRANE_CACHE_SIDE +
        (uint)local.z * M8_MEMBRANE_CACHE_PLANE;
}

bool M8TryLoadMembraneState(int3 globalCoord, out KernelState state,
    out bool resolved)
{
    state = (KernelState)0;
    int3 local = globalCoord - gM8MembraneTileOrigin +
        M8_MEMBRANE_CACHE_HALO;
    if (any(local < 0) || any(local >= (int)M8_MEMBRANE_CACHE_SIDE))
    {
        resolved = false;
        return false;
    }

    int3 relative = globalCoord - gM8MembraneTileOrigin;
    int3 tileOffset = int3(relative.x < 0 ? -1 : relative.x >= 8 ? 1 : 0,
        relative.y < 0 ? -1 : relative.y >= 8 ? 1 : 0,
        relative.z < 0 ? -1 : relative.z >= 8 ? 1 : 0);
    uint slot = gM8MembraneTileSlots[M8MembraneTileIndex(tileOffset)];
    if (slot == M8_MEMBRANE_TILE_UNRESOLVED)
    {
        resolved = false;
        return false;
    }
    resolved = true;
    if (slot == M8_MEMBRANE_TILE_MISSING) return false;

    uint2 summary = gM8MembraneState[M8MembraneCacheIndex(globalCoord)];
    state.evidence = asint(summary.x);
    state.flags = summary.y;
    return true;
}


[numthreads(256, 1, 1)]
void ReclaimRenderPages(uint id : SV_DispatchThreadID)
{
    uint count = _M8RenderPageQueues[M8_RENDER_CONTROL_RECLAIM_COUNT];
    uint freeBase = _M8RenderPageQueues[M8_RENDER_CONTROL_FREE_PAGES];
    if (id >= count || freeBase + id >= M8_RENDER_PAGE_CAPACITY) return;
    uint source = (_M8PreviousPublished != 0u
        ? M8_RENDER_RETIRE_BASE : M8_RENDER_ALLOC_BASE) + id;
    _M8RenderPageQueues[M8_RENDER_FREE_BASE + freeBase + id] =
        _M8RenderPageQueues[source];
}

[numthreads(1, 1, 1)]
void ApplyRenderReclaim(uint id : SV_DispatchThreadID)
{
    uint freePages = min(_M8RenderPageQueues[M8_RENDER_CONTROL_FREE_PAGES] +
        _M8RenderPageQueues[M8_RENDER_CONTROL_RECLAIM_COUNT],
        M8_RENDER_PAGE_CAPACITY);
    _M8RenderPageQueues[M8_RENDER_CONTROL_FREE_PAGES] = freePages;
    _M8RenderPageQueues[M8_RENDER_CONTROL_RECLAIM_COUNT] = 0u;
    _M8RenderPageQueues[M8_RENDER_CONTROL_RETIRE_COUNT] = 0u;
    _M8RenderPageQueues[M8_RENDER_CONTROL_ALLOC_COUNT] = 0u;
}

[numthreads(64, 1, 1)]
void CopyRenderIndex(uint id : SV_DispatchThreadID)
{
    if (id < M8_RENDER_INDEX_HEADER)
        _M8RenderIndexBack[id] = _M8RenderIndexFrontRead[id];

    uint deltaCount = min(
        _M8Counters[M8_COUNTER_RENDER_DELTA_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    for (uint delta = id; delta < deltaCount; delta += 64u)
    {
        uint2 entry = _M8VisibleTilesRead[delta];
        uint physicalSlot = entry.x;
        if (physicalSlot >= MERKABA_M8_PHYSICAL_TILE_CAPACITY) continue;
        uint base = M8RecordBase(physicalSlot);
        [unroll]
        for (uint word = 0u; word < M8_RENDER_RECORD_WORDS; word++)
            _M8RenderIndexBack[base + word] =
                _M8RenderIndexFrontRead[base + word];
        if (entry.y != 0u)
        {
            uint listIndex = entry.y - 1u;
            if (listIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                _M8RenderIndexBack[M8_RENDER_TILE_LIST_BASE + listIndex] =
                    _M8RenderIndexFrontRead[
                        M8_RENDER_TILE_LIST_BASE + listIndex];
        }
    }
    if (id == 0u)
        _M8Counters[M8_COUNTER_RENDER_DELTA_COUNT] = 0u;
}

bool M8RenderJournalReserve(uint headCounter, uint tailCounter,
    out uint ticket)
{
    ticket = 0u;
    [loop]
    for (uint attempt = 0u; attempt < 16u; attempt++)
    {
        uint head = _M8Counters[headCounter];
        uint tail = _M8Counters[tailCounter];
        if (tail - head >= M8_RENDER_JOURNAL_CAPACITY)
        {
            _M8Counters[M8_COUNTER_RENDER_JOURNAL_OVERFLOW] = 1u;
            return false;
        }
        uint prior;
        InterlockedCompareExchange(_M8Counters[tailCounter], tail,
            tail + 1u, prior);
        if (prior == tail)
        {
            ticket = tail;
            return true;
        }
    }
    _M8Counters[M8_COUNTER_RENDER_JOURNAL_OVERFLOW] = 1u;
    return false;
}

void M8RenderJournalQueueDirty(uint physicalSlot, uint dependencyBits)
{
    uint previous;
    InterlockedOr(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
        M8_RENDER_DIRTY | M8_RENDER_DIRTY_QUEUED |
        (dependencyBits & M8_RENDER_DEPENDENCY_MASK), previous);
    if ((previous & M8_RENDER_DIRTY_QUEUED) != 0u) return;
    uint ticket;
    if (!M8RenderJournalReserve(M8_COUNTER_RENDER_JOURNAL_HEAD,
            M8_COUNTER_RENDER_JOURNAL_TAIL, ticket))
    {
        uint ignored;
        InterlockedAnd(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
            ~M8_RENDER_DIRTY_QUEUED, ignored);
        return;
    }
    _M8RenderMutationQueue[M8_RENDER_JOURNAL_DIRTY_BASE +
        (ticket & M8_RENDER_JOURNAL_MASK)] = physicalSlot;
}

void M8RenderJournalQueuePending(uint physicalSlot)
{
    uint previous;
    InterlockedOr(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
        M8_RENDER_PENDING | M8_RENDER_PENDING_QUEUED, previous);
    if ((previous & M8_RENDER_PENDING_QUEUED) != 0u) return;
    uint ticket;
    if (!M8RenderJournalReserve(M8_COUNTER_RENDER_PENDING_HEAD,
            M8_COUNTER_RENDER_PENDING_TAIL, ticket))
    {
        uint ignored;
        InterlockedAnd(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
            ~M8_RENDER_PENDING_QUEUED, ignored);
        return;
    }
    _M8RenderMutationQueue[M8_RENDER_JOURNAL_PENDING_BASE +
        (ticket & M8_RENDER_JOURNAL_MASK)] = physicalSlot;
}

bool M8RenderSelectUnique(uint physicalSlot, inout uint selected)
{
    if (physicalSlot >= MERKABA_M8_PHYSICAL_TILE_CAPACITY) return false;
    [unroll]
    for (uint index = 0u; index < M8_RENDER_MUTATION_BATCH; index++)
        if (index < selected && _M8VisibleTiles[index].x == physicalSlot)
            return false;
    if (selected >= M8_RENDER_MUTATION_BATCH) return false;
    _M8VisibleTiles[selected] = uint2(physicalSlot, 0u);
    selected++;
    return true;
}

uint M8CurrentRenderIdentity(uint physicalSlot)
{
    uint4 meta = _M8TileRecords[M8TileMetaIndex(physicalSlot)];
    uint refIndex = meta.x * MERKABA_M8_TILES_PER_CHUNK + meta.y;
    return refIndex < MERKABA_M8_CHUNK_CAPACITY *
        MERKABA_M8_TILES_PER_CHUNK &&
        _M8ChunkTileRefsRead[refIndex] == physicalSlot + 1u
        ? refIndex + 1u : 0u;
}

void M8QueueRenderDependencies(uint physicalSlot, uint dependencyBits)
{
    if (dependencyBits == 0u ||
        M8CurrentRenderIdentity(physicalSlot) == 0u) return;
    M8ReadoutTileContext context = M8TileContextOf(physicalSlot);
    [unroll]
    for (uint neighbour = 0u; neighbour < 26u; neighbour++)
    {
        uint dependency = 1u << (M8_RENDER_DEPENDENCY_SHIFT + neighbour);
        if ((dependencyBits & dependency) == 0u) continue;
        uint gridIndex = neighbour < 13u ? neighbour : neighbour + 1u;
        uint slot = M8ResolveMembraneTile(context,
            M8MembraneTileOffset(gridIndex));
        if (slot < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
            M8RenderJournalQueueDirty(slot, 0u);
    }
}

[numthreads(1, 1, 1)]
void MarkRenderRebuildTiles(uint id : SV_DispatchThreadID)
{
    uint selected = 0u;

    if (_M8ResidencyChanged != 0u)
    {
        uint head = _M8Counters[M8_COUNTER_RENDER_PENDING_HEAD];
        uint tail = _M8Counters[M8_COUNTER_RENDER_PENDING_TAIL];
        uint consumed = 0u;
        while (head != tail && selected < M8_RENDER_MUTATION_BATCH &&
               consumed < M8_RENDER_JOURNAL_DRAIN_LIMIT)
        {
            uint slot = _M8RenderMutationQueue[
                M8_RENDER_JOURNAL_PENDING_BASE +
                (head & M8_RENDER_JOURNAL_MASK)];
            head++;
            consumed++;
            if (slot >= MERKABA_M8_PHYSICAL_TILE_CAPACITY) continue;
            uint ignored;
            InterlockedAnd(_M8TileRecords[M8TileRuntimeIndex(slot)].w,
                ~M8_RENDER_PENDING_QUEUED, ignored);
            uint bits = _M8TileRecords[M8TileRuntimeIndex(slot)].w;
            if ((bits & M8_RENDER_PENDING) == 0u) continue;
            M8RenderSelectUnique(slot, selected);
        }
        _M8Counters[M8_COUNTER_RENDER_PENDING_HEAD] = head;
    }

    uint head = _M8Counters[M8_COUNTER_RENDER_JOURNAL_HEAD];
    uint tail = _M8Counters[M8_COUNTER_RENDER_JOURNAL_TAIL];
    uint consumed = 0u;
    while (head != tail && selected < M8_RENDER_MUTATION_BATCH &&
           consumed < M8_RENDER_JOURNAL_DRAIN_LIMIT)
    {
        uint slot = _M8RenderMutationQueue[M8_RENDER_JOURNAL_DIRTY_BASE +
            (head & M8_RENDER_JOURNAL_MASK)];
        head++;
        consumed++;
        if (slot >= MERKABA_M8_PHYSICAL_TILE_CAPACITY) continue;
        uint ignored;
        InterlockedAnd(_M8TileRecords[M8TileRuntimeIndex(slot)].w,
            ~M8_RENDER_DIRTY_QUEUED, ignored);
        uint bits = _M8TileRecords[M8TileRuntimeIndex(slot)].w;
        uint frontIdentity =
            _M8RenderIndexFrontRead[M8RecordBase(slot) + 2u];
        uint currentIdentity = M8CurrentRenderIdentity(slot);
        if ((bits & M8_RENDER_DIRTY) == 0u &&
            frontIdentity == currentIdentity)
            continue;
        M8QueueRenderDependencies(slot,
            bits & M8_RENDER_DEPENDENCY_MASK);
        M8RenderSelectUnique(slot, selected);
    }
    _M8Counters[M8_COUNTER_RENDER_JOURNAL_HEAD] = head;
    _M8Counters[M8_COUNTER_RENDER_REBUILD_TILES] = selected;
}

[numthreads(1, 1, 1)]
void CollectRenderRebuildTiles(uint id : SV_DispatchThreadID)
{
    // Kept as an entry point for serialized asset compatibility. Sparse
    // selection is completed by MarkRenderRebuildTiles; no slot sweep occurs.
}

void M8AppendPageQueue(uint queueBase, uint control, uint page)
{
    uint index;
    InterlockedAdd(_M8RenderPageQueues[control], 1u, index);
    if (index < M8_RENDER_PAGE_CAPACITY)
        _M8RenderPageQueues[queueBase + index] = page;
}

void M8RetireBackRecordPages(uint base)
{
    uint pages = min(_M8RenderIndexBack[base + 1u],
        M8_RENDER_TILE_MAX_PAGES);
    uint page = _M8RenderIndexBack[base + M8_RENDER_RECORD_FIRST_PAGE];
    for (uint ordinal = 0u;
        ordinal < pages && page != M8_RENDER_PAGE_INVALID; ordinal++)
    {
        uint next = _M8RenderPageQueues[M8_RENDER_LINK_BASE + page];
        M8AppendPageQueue(M8_RENDER_RETIRE_BASE,
            M8_RENDER_CONTROL_RETIRE_COUNT, page);
        page = next;
    }
}

[numthreads(1, 1, 1)]
void PrepareRenderBuild(uint id : SV_DispatchThreadID)
{
    uint tiles = min(_M8Counters[M8_COUNTER_RENDER_REBUILD_TILES],
        M8_RENDER_MUTATION_BATCH);
    _M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT] = tiles;
    _M8FrameDispatchArgs[0] = tiles;
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
}

#include "MerkabaSkin.generated.hlsl"

void M8StoreRenderVertex(uint vertex, float3 gridPosition, uint packedColor)
{
    uint address = vertex * 16u;
    _M8RenderVertices.Store3(address, asuint(gridPosition));
    _M8RenderVertices.Store(address + 12u, packedColor);
}

// Exact union-skin topology. Missing neighbour tiles are empty; non-resident
// neighbours are unresolved and defer publication so FRONT remains coherent.
int3 M8SkinNormalStep(float3 normal)
{
    float3 a = abs(normal);
    if (a.x >= a.y && a.x >= a.z)
        return int3(normal.x >= 0.0 ? 1 : -1, 0, 0);
    if (a.y >= a.z)
        return int3(0, normal.y >= 0.0 ? 1 : -1, 0);
    return int3(0, 0, normal.z >= 0.0 ? 1 : -1);
}

bool M8SkinKnownFree(int3 coord, out bool unresolved)
{
    KernelState state;
    bool resolved;
    bool exists = M8TryLoadMembraneState(coord, state, resolved);
    unresolved = !resolved;
    return resolved && exists &&
        (state.flags & MERKABA_OCCUPIED_FLAG) == 0u &&
        state.evidence <= MERKABA_EXPORT_KNOWN_FREE;
}

int3 M8SkinFreeSide(int3 coord, KernelState state, out bool unresolved)
{
    unresolved = false;
    if (!M8HasSurfacePlane(state.flags)) return int3(0, 0, 0);
    float3 normal;
    float offset;
    M8DecodeSurfacePlane(state.flags, normal, offset);
    int3 step = M8SkinNormalStep(normal);
    bool plusUnresolved;
    bool minusUnresolved;
    bool plus = M8SkinKnownFree(coord + step, plusUnresolved);
    bool minus = M8SkinKnownFree(coord - step, minusUnresolved);
    unresolved = plusUnresolved || minusUnresolved;
    if (plus == minus) return int3(0, 0, 0);
    return plus ? step : -step;
}

bool M8SkinCompatible(int3 mainCoord, KernelState main,
    int3 neighbourCoord, KernelState neighbour, out bool unresolved)
{
    bool aUnresolved;
    bool bUnresolved;
    int3 a = M8SkinFreeSide(mainCoord, main, aUnresolved);
    int3 b = M8SkinFreeSide(neighbourCoord, neighbour, bUnresolved);
    unresolved = aUnresolved || bUnresolved;
    if (unresolved) return false;
    if (all(a == 0) || all(b == 0)) return true;
    return dot(a, b) >= 0;
}

bool M8TrySkinNeighbourMask(int3 globalCoord, KernelState main,
    out uint neighbourMask, out bool unresolved)
{
    neighbourMask = 0u;
    unresolved = false;
    [unroll]
    for (uint neighbour = 0u; neighbour < M8_SKIN_NEIGHBOUR_COUNT;
        neighbour++)
    {
        int3 relative = globalCoord + M8_SKIN_NEIGHBOURS[neighbour] -
            gM8MembraneTileOrigin;
        int3 tileOffset = int3(relative.x < 0 ? -1 : relative.x >= 8 ? 1 : 0,
            relative.y < 0 ? -1 : relative.y >= 8 ? 1 : 0,
            relative.z < 0 ? -1 : relative.z >= 8 ? 1 : 0);
        uint slot = gM8MembraneTileSlots[M8MembraneTileIndex(tileOffset)];
        if (slot == M8_MEMBRANE_TILE_UNRESOLVED)
        {
            unresolved = true;
            return false;
        }
        if (slot == M8_MEMBRANE_TILE_MISSING) continue;
        int3 local = relative - tileOffset * 8;
        uint kernelLocal = (uint)local.x | ((uint)local.y << 3u) |
            ((uint)local.z << 6u);
        uint occupied = gM8MembraneOccupiedWords[
            M8MembraneTileIndex(tileOffset) * MERKABA_M8_TILE_WORDS +
            (kernelLocal >> 5u)];
        if ((occupied & (1u << (kernelLocal & 31u))) == 0u) continue;
        KernelState neighbourState;
        bool neighbourResolved;
        if (!M8TryLoadMembraneState(globalCoord +
                M8_SKIN_NEIGHBOURS[neighbour], neighbourState,
                neighbourResolved))
        {
            if (!neighbourResolved) unresolved = true;
            continue;
        }
        if (!M8HasSurfacePlane(neighbourState.flags)) continue;
        bool compatibilityUnresolved;
        if (M8SkinCompatible(globalCoord, main,
                globalCoord + M8_SKIN_NEIGHBOURS[neighbour],
                neighbourState, compatibilityUnresolved))
            neighbourMask |= 1u << neighbour;
        if (compatibilityUnresolved) unresolved = true;
    }
    return true;
}

uint M8SkinVisibleFaceletCount(uint neighbourMask)
{
    uint count = 0u;
    [unroll]
    for (uint facelet = 0u; facelet < M8_SKIN_FACELET_COUNT; facelet++)
        if ((M8_SKIN_FACELETS[facelet].w & neighbourMask) == 0u)
            count++;
    return count;
}

float3 M8SkinGridVertex(int3 globalCoord, uint vertexIndex)
{
    return ((float3)globalCoord +
        (float3)M8_SKIN_HALF_VERTICES[vertexIndex] * 0.5) *
        MERKABA_LATTICE_STEP;
}

void M8EmitSkinFacelet(int3 globalCoord, uint faceletIndex,
    uint packedColor, uint primitiveIndex)
{
    uint page = gM8MembranePageIds[primitiveIndex >> 4u];
    uint vertex = page * M8_RENDER_PAGE_VERTICES +
        (primitiveIndex & (M8_RENDER_PAGE_PATCHES - 1u)) * 3u;
    uint4 facelet = M8_SKIN_FACELETS[faceletIndex];
    M8StoreRenderVertex(vertex + 0u,
        M8SkinGridVertex(globalCoord, facelet.x), packedColor);
    M8StoreRenderVertex(vertex + 1u,
        M8SkinGridVertex(globalCoord, facelet.y), packedColor);
    M8StoreRenderVertex(vertex + 2u,
        M8SkinGridVertex(globalCoord, facelet.z), packedColor);
}

bool M8TakeRenderPages(uint pagesNeeded)
{
    if (pagesNeeded == 0u) return true;
    if (gM8MembranePageCount + pagesNeeded > M8_RENDER_TILE_MAX_PAGES)
        return false;
    // One atomic pop of the shared free stack: concurrent tile groups never
    // observe the same page, and an exhausted pool reverts its own claim.
    uint remaining;
    InterlockedAdd(_M8RenderPageQueues[M8_RENDER_CONTROL_FREE_PAGES],
        ~pagesNeeded + 1u, remaining);
    if (remaining < pagesNeeded || remaining > M8_RENDER_PAGE_CAPACITY)
    {
        uint ignored;
        InterlockedAdd(_M8RenderPageQueues[M8_RENDER_CONTROL_FREE_PAGES],
            pagesNeeded, ignored);
        return false;
    }
    for (uint page = 0u; page < pagesNeeded; page++)
    {
        uint pageId = _M8RenderPageQueues[
            M8_RENDER_FREE_BASE + remaining - 1u - page];
        if (gM8MembranePageCount != 0u)
        {
            uint previous = gM8MembranePageIds[gM8MembranePageCount - 1u];
            _M8RenderPageQueues[M8_RENDER_LINK_BASE + previous] = pageId;
        }
        gM8MembranePageIds[gM8MembranePageCount] = pageId;
        gM8MembranePageCount += 1u;
        _M8RenderPageQueues[M8_RENDER_LINK_BASE + pageId] =
            M8_RENDER_PAGE_INVALID;
    }
    return true;
}

void M8DiscardTilePages()
{
    // Pages consumed by a rejected tile are referenced by neither slot, so
    // they return to the free stack immediately.
    uint count = gM8MembranePageCount;
    if (count == 0u) return;
    uint base;
    InterlockedAdd(_M8RenderPageQueues[M8_RENDER_CONTROL_FREE_PAGES], count,
        base);
    for (uint page = 0u; page < count; page++)
        if (base + page < M8_RENDER_PAGE_CAPACITY)
            _M8RenderPageQueues[M8_RENDER_FREE_BASE + base + page] =
                gM8MembranePageIds[page];
}

[numthreads(128, 1, 1)]
void BuildRenderTiles(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    // The build kernel owns the work slot: it reads through the RW view so
    // the gate never sees an RW/read alias pair for _M8VisibleTiles.
    uint physicalSlot = _M8VisibleTiles[groupId.x].x;
    // One prologue barrier only: the gate caps this kernel at eight.
    if (thread == 0u)
    {
        gM8MembraneMeasuredTotal = 0u;
        gM8MembranePageCount = 0u;
        gM8MembranePatchTotal = 0u;
        gM8MembraneFailed = 0u;
        gM8MembraneUnresolved = 0u;
        uint ignored;
        if (M8CurrentRenderIdentity(physicalSlot) == 0u)
        {
            uint base = M8RecordBase(physicalSlot);
            M8RetireBackRecordPages(base);
            _M8RenderIndexBack[base + 0u] = 0u;
            _M8RenderIndexBack[base + 1u] = 0u;
            _M8RenderIndexBack[base + 2u] = 0u;
            InterlockedAnd(
                _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
                ~(M8_RENDER_DIRTY | M8_RENDER_PENDING |
                  M8_RENDER_DEPENDENCY_MASK), ignored);
            _M8VisibleTiles[groupId.x].y = 1u;
            gM8MembraneFailed = 2u;
        }
        else
        {
            _M8VisibleTiles[groupId.x].y = 0u;
            M8InitializeReadoutTileContext(physicalSlot);
            InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_CONSIDERED],
                _M8TileRecords[M8TileMetaIndex(physicalSlot)].z, ignored);
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gM8MembraneFailed == 2u) return;

    M8ReadoutTileContext context = M8SharedReadoutTileContext();
    if (thread < M8_MEMBRANE_TILE_COUNT)
        gM8MembraneTileSlots[thread] = M8ResolveMembraneTile(context,
            M8MembraneTileOffset(thread));
    GroupMemoryBarrierWithGroupSync();

    for (uint wordIndex = thread;
        wordIndex < M8_MEMBRANE_TILE_WORD_COUNT;
        wordIndex += M8_SHELL_GROUP_THREADS)
    {
        uint tileIndex = wordIndex >> 4u;
        uint word = wordIndex - tileIndex * MERKABA_M8_TILE_WORDS;
        uint slot = gM8MembraneTileSlots[tileIndex];
        gM8MembraneOccupiedWords[wordIndex] =
            slot < MERKABA_M8_PHYSICAL_TILE_CAPACITY
            ? _M8TileBitsRead[M8TileWordIndex(slot, word)].x : 0u;
    }
    GroupMemoryBarrierWithGroupSync();

    for (uint cacheIndex = thread; cacheIndex < M8_MEMBRANE_CACHE_COUNT;
        cacheIndex += M8_SHELL_GROUP_THREADS)
    {
        int3 relative;
        uint tileIndex;
        uint kernelLocal;
        M8MembraneCacheAddress(cacheIndex, relative, tileIndex, kernelLocal);
        uint slot = gM8MembraneTileSlots[tileIndex];
        uint2 summary = 0u;
        if (slot < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
        {
            uint occupancy = gM8MembraneOccupiedWords[tileIndex *
                MERKABA_M8_TILE_WORDS + (kernelLocal >> 5u)];
            if ((occupancy & (1u << (kernelLocal & 31u))) != 0u)
                summary.y = M8LoadKernelFlagsOnly(slot, kernelLocal);
            else
                summary.x = asuint(M8LoadKernelEvidenceOnly(slot,
                    kernelLocal));
        }
        gM8MembraneState[cacheIndex] = summary;
    }
    GroupMemoryBarrierWithGroupSync();

    // The barriers make this a uniform four-phase tile walk. Keep the loop
    // rolled so Unity's mobile Vulkan compiler does not clone the complete
    // membrane oracle four times.
    [loop]
    for (uint batch = 0u; batch < 4u; batch++)
    {
        if (thread == 0u) gM8MembraneCanEmit = 0u;
        gM8SkinCounts[thread] = 0u;
        gM8SkinPrefix[thread] = 0u;
        GroupMemoryBarrierWithGroupSync();

        uint kernelLocal = thread + batch * M8_SHELL_GROUP_THREADS;
        uint mainOccupancy = gM8MembraneOccupiedWords[
            M8_MEMBRANE_CENTER_TILE * MERKABA_M8_TILE_WORDS +
            (kernelLocal >> 5u)];
        bool occupied = (mainOccupancy &
            (1u << (kernelLocal & 31u))) != 0u;
        KernelState state = (KernelState)0;
        bool measured = false;
        bool unresolved = false;
        uint neighbourMask = 0u;
        uint faceletCount = 0u;
        int3 globalCoord = context.tileOrigin + int3(
            kernelLocal & 7u, (kernelLocal >> 3u) & 7u,
            (kernelLocal >> 6u) & 7u);
        if (occupied)
        {
            state = M8LoadKernelStateRead(physicalSlot, kernelLocal);
            measured = (state.flags & MERKABA_OCCUPIED_FLAG) != 0u &&
                M8HasSurfacePlane(state.flags);
            if (measured &&
                M8TrySkinNeighbourMask(globalCoord, state, neighbourMask, unresolved))
                faceletCount = M8SkinVisibleFaceletCount(neighbourMask);
        }
        gM8SkinCounts[thread] = faceletCount;
        if (unresolved)
        {
            uint ignored;
            InterlockedOr(gM8MembraneUnresolved, 1u, ignored);
        }
        if (measured)
        {
            uint ignored;
            InterlockedAdd(gM8MembraneMeasuredTotal, 1u, ignored);
            InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_PLANE_VALID],
                1u, ignored);
        }
        GroupMemoryBarrierWithGroupSync();

        if (thread == 0u)
        {
            uint batchCount = 0u;
            [unroll]
            for (uint lane = 0u; lane < M8_SHELL_GROUP_THREADS; lane++)
            {
                gM8SkinPrefix[lane] = batchCount;
                batchCount += gM8SkinCounts[lane];
            }
            gM8MembraneBatchBase = gM8MembranePatchTotal;
            if (gM8MembraneUnresolved == 0u && gM8MembraneFailed == 0u &&
                batchCount != 0u)
            {
                uint total = gM8MembranePatchTotal + batchCount;
                // Page size is 16, so the gate-mandated shift replaces the
                // division: BuildRenderTiles must stay free of integer div.
                uint pagesNeeded = ((total + M8_RENDER_PAGE_PATCHES - 1u) >>
                    4u) - gM8MembranePageCount;
                if (M8TakeRenderPages(pagesNeeded))
                {
                    gM8MembraneCanEmit = 1u;
                    gM8MembranePatchTotal = total;
                }
                else
                {
                    gM8MembraneFailed = 1u;
                    _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 1u;
                }
            }
        }
        GroupMemoryBarrierWithGroupSync();

        if (faceletCount != 0u && gM8MembraneCanEmit != 0u)
        {
            uint localFacelet = 0u;
            [unroll]
            for (uint facelet = 0u; facelet < M8_SKIN_FACELET_COUNT;
                facelet++)
            {
                if ((M8_SKIN_FACELETS[facelet].w & neighbourMask) != 0u)
                    continue;
                M8EmitSkinFacelet(globalCoord, facelet, state.packedColor,
                    gM8MembraneBatchBase + gM8SkinPrefix[thread] +
                        localFacelet);
                localFacelet++;
            }
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if (thread != 0u) return;
    uint4 meta = _M8TileRecords[M8TileMetaIndex(physicalSlot)];
    uint occupiedCount = meta.z;
    uint legacyCount = occupiedCount > gM8MembraneMeasuredTotal
        ? occupiedCount - gM8MembraneMeasuredTotal : 0u;
    uint ignoredCount;
    InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_PLANE_LEGACY_INVALID],
        legacyCount, ignoredCount);
    uint base = M8RecordBase(physicalSlot);
    if (gM8MembraneUnresolved != 0u || gM8MembraneFailed != 0u)
    {
        // BACK keeps this tile's previous record. An unresolved halo waits
        // for residency; a capacity failure retries on the next build.
        M8DiscardTilePages();
        if (gM8MembraneUnresolved != 0u)
        {
            InterlockedAnd(_M8TileRecords[
                M8TileRuntimeIndex(physicalSlot)].w,
                ~M8_RENDER_DIRTY, ignoredCount);
            M8RenderJournalQueuePending(physicalSlot);
            M8CounterIncrement(M8_COUNTER_RENDER_PENDING_TILES);
        }
        else
        {
            M8RenderJournalQueueDirty(physicalSlot, 0u);
            M8CounterIncrement(M8_COUNTER_RENDER_CAPACITY_FAILED);
        }
        return;
    }
    M8RetireBackRecordPages(base);
    _M8RenderIndexBack[base + 0u] = gM8MembranePatchTotal;
    _M8RenderIndexBack[base + 1u] = gM8MembranePageCount;
    _M8RenderIndexBack[base + 2u] =
        meta.x * MERKABA_M8_TILES_PER_CHUNK + meta.y + 1u;
    _M8RenderIndexBack[base + 3u] = asuint(gM8MembraneTileOrigin.x);
    _M8RenderIndexBack[base + 4u] = asuint(gM8MembraneTileOrigin.y);
    _M8RenderIndexBack[base + 5u] = asuint(gM8MembraneTileOrigin.z);
    _M8RenderIndexBack[base + M8_RENDER_RECORD_FIRST_PAGE] =
        gM8MembranePageCount != 0u ? gM8MembranePageIds[0] :
            M8_RENDER_PAGE_INVALID;
    for (uint page = 0u; page < gM8MembranePageCount; page++)
        M8AppendPageQueue(M8_RENDER_ALLOC_BASE,
            M8_RENDER_CONTROL_ALLOC_COUNT, gM8MembranePageIds[page]);
    InterlockedAnd(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
        ~(M8_RENDER_DIRTY | M8_RENDER_PENDING |
          M8_RENDER_DEPENDENCY_MASK), ignoredCount);
    _M8VisibleTiles[groupId.x].y = 1u;
    InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_EMITTED_PATCHES],
        gM8MembranePatchTotal, ignoredCount);
}

[numthreads(1, 1, 1)]
void PublishRenderTileList(uint id : SV_DispatchThreadID)
{
    uint selected = min(_M8Counters[M8_COUNTER_RENDER_REBUILD_TILES],
        M8_RENDER_MUTATION_BATCH);
    uint tileCount = min(_M8RenderIndexBack[0],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    uint patchCount = _M8RenderIndexBack[1];
    uint deltaCount = selected;

    for (uint index = 0u; index < selected; index++)
    {
        uint2 work = _M8VisibleTiles[index];
        uint physicalSlot = work.x;
        bool succeeded = work.y != 0u;
        _M8VisibleTiles[index].y = 0u;
        if (!succeeded ||
            physicalSlot >= MERKABA_M8_PHYSICAL_TILE_CAPACITY)
            continue;

        uint base = M8RecordBase(physicalSlot);
        uint oldPatches = _M8RenderIndexFrontRead[base + 0u];
        uint newPatches = _M8RenderIndexBack[base + 0u];
        bool oldActive = oldPatches != 0u &&
            _M8RenderIndexFrontRead[base + 2u] != 0u;
        bool newActive = newPatches != 0u &&
            _M8RenderIndexBack[base + 2u] != 0u;
        patchCount = patchCount >= oldPatches
            ? patchCount - oldPatches + newPatches
            : newPatches;

        uint changedListSlot = 0u;
        if (!oldActive && newActive)
        {
            if (tileCount < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
            {
                _M8RenderIndexBack[M8_RENDER_TILE_LIST_BASE + tileCount] =
                    physicalSlot;
                _M8RenderIndexBack[
                    base + M8_RENDER_RECORD_LIST_SLOT] = tileCount + 1u;
                changedListSlot = tileCount + 1u;
                tileCount++;
            }
        }
        else if (oldActive && !newActive && tileCount != 0u)
        {
            uint listSlot =
                _M8RenderIndexBack[base + M8_RENDER_RECORD_LIST_SLOT];
            if (listSlot != 0u && listSlot <= tileCount)
            {
                uint removeIndex = listSlot - 1u;
                uint lastIndex = tileCount - 1u;
                if (removeIndex != lastIndex)
                {
                    uint moved = _M8RenderIndexBack[
                        M8_RENDER_TILE_LIST_BASE + lastIndex];
                    _M8RenderIndexBack[
                        M8_RENDER_TILE_LIST_BASE + removeIndex] = moved;
                    if (moved < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                    {
                        uint movedBase = M8RecordBase(moved);
                        _M8RenderIndexBack[movedBase +
                            M8_RENDER_RECORD_LIST_SLOT] = removeIndex + 1u;
                        if (deltaCount <
                            MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                            _M8VisibleTiles[deltaCount++] =
                                uint2(moved, removeIndex + 1u);
                    }
                    changedListSlot = removeIndex + 1u;
                }
                tileCount = lastIndex;
            }
            _M8RenderIndexBack[base + M8_RENDER_RECORD_LIST_SLOT] = 0u;
        }
        _M8VisibleTiles[index].y = changedListSlot;
    }

    _M8RenderIndexBack[0] = tileCount;
    _M8RenderIndexBack[1] = patchCount;
    _M8Counters[M8_COUNTER_RENDER_DELTA_COUNT] = deltaCount;
}

[numthreads(1, 1, 1)]
void FinalizeReadout(uint id : SV_DispatchThreadID)
{
    uint tiles = _M8RenderIndexBack[0];
    uint patches = _M8RenderIndexBack[1];
    _M8Counters[M8_COUNTER_RENDER_PUBLISHED_TILES] = tiles;
    _M8Counters[M8_COUNTER_RENDER_PUBLISHED_PATCHES] = patches;
    _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES] = patches;
    _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES] =
        _M8Counters[M8_COUNTER_READOUT_EMITTED_PATCHES];
    uint dirtyHead = _M8Counters[M8_COUNTER_RENDER_JOURNAL_HEAD];
    uint dirtyTail = _M8Counters[M8_COUNTER_RENDER_JOURNAL_TAIL];
    uint backlog = dirtyTail != dirtyHead ||
        _M8Counters[M8_COUNTER_RENDER_JOURNAL_OVERFLOW] != 0u
        ? 0x80000000u : 0u;
    uint unresolved = min(0x7fffffffu,
        _M8Counters[M8_COUNTER_READOUT_UNRESOLVED] +
        _M8Counters[M8_COUNTER_RENDER_PENDING_TILES]);
    if (_M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] ==
            MERKABA_READOUT_BUILDING)
        _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
            MERKABA_READOUT_PUBLISHED;
    // The CPU publication decision reads only this record. Counters remain
    // diagnostics that a later scanner job may reset.
    _M8AttemptCompletion[1] = uint4(_M8ReadoutRevision,
        _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS], tiles,
        backlog | unresolved);
}

bool M8SphereOutsideFrustum(float3 center, float radius, uint planeBase)
{
    float4 center4 = float4(center, 1.0);
    return dot(_M8CullGridPlanes[planeBase + 0u], center4) < -radius ||
        dot(_M8CullGridPlanes[planeBase + 1u], center4) < -radius ||
        dot(_M8CullGridPlanes[planeBase + 2u], center4) < -radius ||
        dot(_M8CullGridPlanes[planeBase + 3u], center4) < -radius ||
        dot(_M8CullGridPlanes[planeBase + 4u], center4) < -radius ||
        dot(_M8CullGridPlanes[planeBase + 5u], center4) < -radius;
}

groupshared uint gM8CullPages[M8_CULL_GROUP_THREADS];
groupshared uint gM8CullPrefix[M8_CULL_GROUP_THREADS];
groupshared uint gM8CullBase;

[numthreads(128, 1, 1)]
void CullRenderTiles(uint3 groupId : SV_GroupID,
    uint lane : SV_GroupIndex)
{
    uint listIndex = groupId.x * M8_CULL_GROUP_THREADS + lane;
    uint base = 0u;
    uint pages = 0u;
    if (listIndex < _M8FrontTileCount)
    {
        uint slot = _M8RenderIndexFrontRead[M8_RENDER_TILE_LIST_BASE +
            listIndex];
        base = M8RecordBase(slot);
        int3 origin = int3(asint(_M8RenderIndexFrontRead[base + 3u]),
            asint(_M8RenderIndexFrontRead[base + 4u]),
            asint(_M8RenderIndexFrontRead[base + 5u]));
        // Patches of a tile stay within its kernels plus one lattice step.
        float3 minimum = ((float3)origin - 1.0) * MERKABA_LATTICE_STEP;
        float3 center = minimum + 5.0 * MERKABA_LATTICE_STEP;
        float radius = sqrt(3.0) * 5.0 * MERKABA_LATTICE_STEP;
        bool visible = M8AabbIntersectsDistance(origin - 1, 10,
                _M8RenderDistance) &&
            (!M8SphereOutsideFrustum(center, radius, 0u) ||
             !M8SphereOutsideFrustum(center, radius, 6u));
        if (visible)
            pages = min(_M8RenderIndexFrontRead[base + 1u],
                M8_RENDER_TILE_MAX_PAGES);
    }
    gM8CullPages[lane] = pages;
    GroupMemoryBarrierWithGroupSync();

    if (lane == 0u)
    {
        uint total = 0u;
        [unroll]
        for (uint entry = 0u; entry < M8_CULL_GROUP_THREADS; entry++)
        {
            gM8CullPrefix[entry] = total;
            total += gM8CullPages[entry];
        }
        InterlockedAdd(_M8CullControl[0], total, gM8CullBase);
    }
    GroupMemoryBarrierWithGroupSync();

    if (pages == 0u) return;
    uint patches = _M8RenderIndexFrontRead[base];
    uint output = gM8CullBase + gM8CullPrefix[lane];
    uint pageId = _M8RenderIndexFrontRead[
        base + M8_RENDER_RECORD_FIRST_PAGE];
    for (uint page = 0u; page < pages; page++)
    {
        if (output + page >= M8_RENDER_PAGE_CAPACITY ||
            pageId == M8_RENDER_PAGE_INVALID) return;
        uint pagePatches = patches - page * M8_RENDER_PAGE_PATCHES;
        uint used = min(pagePatches, M8_RENDER_PAGE_PATCHES);
        _M8VisiblePages[output + page] = pageId | ((used - 1u) << 17u);
        pageId = _M8RenderPageQueues[M8_RENDER_LINK_BASE + pageId];
    }
}

[numthreads(1, 1, 1)]
void PrepareVisibleIndices(uint id : SV_DispatchThreadID)
{
    uint pages = min(_M8CullControl[0], M8_RENDER_PAGE_CAPACITY);
    _M8CullControl[1] = (pages + M8_EMIT_GROUP_THREADS - 1u) >> 6u;
    _M8CullControl[2] = 1u;
    _M8CullControl[3] = 1u;
    _M8RenderDrawArgs[0] = pages * M8_RENDER_PAGE_INDICES;
    _M8RenderDrawArgs[1] = 2u;
    _M8RenderDrawArgs[2] = 0u;
    _M8RenderDrawArgs[3] = 0u;
    _M8RenderDrawArgs[4] = 0u;
}

[numthreads(64, 1, 1)]
void EmitVisibleIndices(uint id : SV_DispatchThreadID)
{
    if (id >= min(_M8CullControlRead[0], M8_RENDER_PAGE_CAPACITY)) return;
    uint entry = _M8VisiblePagesRead[id];
    uint page = entry & M8_RENDER_PAGE_ID_MASK;
    uint used = ((entry >> 17u) & 15u) + 1u;
    uint pageVertex = page * M8_RENDER_PAGE_VERTICES;
    uint output = id * M8_RENDER_PAGE_INDICES * 4u;
    [unroll]
    for (uint facelet = 0u; facelet < M8_RENDER_PAGE_PATCHES; facelet++)
    {
        uint v = pageVertex + facelet * 3u;
        bool live = facelet < used;
        uint address = output + facelet * 3u * 4u;
        // Unused slots of a partially filled page are degenerate triangles.
        _M8VisibleIndices.Store(address + 0u, live ? v : pageVertex);
        _M8VisibleIndices.Store(address + 4u, live ? v + 1u : pageVertex);
        _M8VisibleIndices.Store(address + 8u, live ? v + 2u : pageVertex);
    }
}
