#include "MerkabaWorld.hlsl"
#include "MerkabaSurfaceOrientation.generated.hlsl"

#define MERKABA_LATTICE_STEP 0.025
#define MERKABA_HALF_SUPPORT 0.025
#define MERKABA_OCCUPIED_FLAG 1u
#define M8_RENDER_SLOT_GROUP 256u
#define M8_SHELL_GROUP_THREADS 128u

// The generated membrane oracle reads the tile-local halo cache, the chart
// table and the canonical colour of its contributors through these
// accessors, which are defined once the cache exists below. One HLSL
// authority, no copy.
bool M8MembraneCell(int3 globalCoord, out bool resolved, out bool measured,
    out bool knownFree);
float4 M8MembranePlaneOf(int3 globalCoord);
int M8MembraneChartOf(int3 globalCoord);
void M8LoadMembraneColor(int3 globalCoord, out uint packedColor,
    out uint colorConfidence);
#include "MerkabaOverlapShell.generated.hlsl"

// Disposable readout publication. A build rewrites only tiles whose membrane
// inputs changed (plus their 26-tile dependency halo) into free pages of one
// shared vertex pool. Tile records live in two FRONT/BACK index slots; the
// CPU adopts BACK atomically. Pages retired by a publication are reclaimed
// by the next build, after every frame that could draw them has run.
RWStructuredBuffer<uint2> _M8VisibleTiles;
StructuredBuffer<uint2> _M8VisibleTilesRead;
RWByteAddressBuffer _M8RenderVertices;
RWStructuredBuffer<uint> _M8RenderIndexBack;
StructuredBuffer<uint> _M8RenderIndexFrontRead;
RWStructuredBuffer<uint> _M8RenderPageQueues;
RWStructuredBuffer<uint> _M8RenderMutationQueue;
RWStructuredBuffer<uint> _M8RenderIndices;
StructuredBuffer<uint> _M8RenderIndicesRead;
// Canonical publication version per physical tile: bumped by every mutation
// that can change the tile's skin, compared against each slot's record.
RWStructuredBuffer<uint> _M8RenderVersions;
StructuredBuffer<uint> _M8RenderVersionsRead;
RWStructuredBuffer<uint> _M8FrameDispatchArgs;
RWStructuredBuffer<uint4> _M8AttemptCompletion;

// Per-build readout scratch, one region per batch-local work tile:
// patch descriptors from CollectRenderPatchInputs, the uses of every touched
// line (SolveSharedKnotLines), node records and transition records
// (SolveSharedKnotLines, ResolveRenderPatches), one header per tile.
RWStructuredBuffer<uint4> _M8RenderPatchScratch;
RWStructuredBuffer<uint4> _M8RenderLineUseScratch;
RWStructuredBuffer<uint4> _M8RenderNodeScratch;
RWStructuredBuffer<uint4> _M8RenderScratchHeader;
StructuredBuffer<uint4> _M8RenderPatchScratchRead;
StructuredBuffer<uint4> _M8RenderLineUseScratchRead;
StructuredBuffer<uint4> _M8RenderNodeScratchRead;
StructuredBuffer<uint4> _M8RenderScratchHeaderRead;

float3 _M8CameraGridMeters;
float3 _M8GridMetricDiagonal;
float3 _M8GridMetricCross;
float _M8RenderDistance;
float _M8WarmDistance;
float _M8DependencyDistance;
int3 _M8QueryCenterBlock;
int _M8QueryBlockRadius;
int _M8QueryBlockSide;
float4x4 _MerkabaGridToWorld;
float4x4 _MerkabaWorldToGrid;
uint _M8ReadoutRevision;

// Published tile count and active list of the FRONT slot.
uint M8FrontTileCount()
{
    return min(_M8RenderIndexFrontRead[0],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
}

uint M8FrontListBase()
{
    return M8_RENDER_TILE_LIST_BASE +
        (_M8RenderIndexFrontRead[M8_RENDER_HEADER_LIST_REGION] & 1u) *
        M8_RENDER_TILE_LIST_REGION_WORDS;
}

// The list being built in BACK and the list BACK published last time.
uint M8BackListBase()
{
    return M8_RENDER_TILE_LIST_BASE +
        (_M8RenderIndexBack[M8_RENDER_HEADER_LIST_REGION] & 1u) *
        M8_RENDER_TILE_LIST_REGION_WORDS;
}

uint M8BackPreviousListBase()
{
    return M8_RENDER_TILE_LIST_BASE +
        ((_M8RenderIndexBack[M8_RENDER_HEADER_LIST_REGION] ^ 1u) & 1u) *
        M8_RENDER_TILE_LIST_REGION_WORDS;
}

uint M8BackPreviousTileCount()
{
    return min(_M8RenderIndexBack[M8_RENDER_HEADER_PREVIOUS_TILES],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
}

uint M8RecordBase(uint physicalSlot)
{
    return M8_RENDER_INDEX_HEADER + physicalSlot * M8_RENDER_RECORD_WORDS;
}

bool M8AabbIntersectsDistance(int3 globalMin, int span, float distance)
{
    return MerkabaM8GridAabbIntersectsDistance(globalMin, span, distance,
        _M8CameraGridMeters, _M8GridMetricDiagonal, _M8GridMetricCross,
        MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
}

uint M8DistanceChildMask(int3 parentMin, int parentSpan, float distance)
{
    return MerkabaM8GridDistanceChildMask(parentMin, parentSpan, distance,
        _M8CameraGridMeters, _M8GridMetricDiagonal, _M8GridMetricCross,
        MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
}

uint M8DrawChildMask(int3 parentMin, int parentSpan)
{
    return M8DistanceChildMask(parentMin, parentSpan, _M8RenderDistance);
}

uint M8DependencyChildMask(int3 parentMin, int parentSpan)
{
    return M8DistanceChildMask(parentMin, parentSpan,
        _M8DependencyDistance);
}

void M8RequestWarmLoad(uint tileRefIndex, uint chunkIndex, uint tileLocal,
    bool lateDraw)
{
    M8QueueColdTileLoad(tileRefIndex, chunkIndex, tileLocal);
    if (lateDraw) M8CounterIncrement(M8_COUNTER_LATE_DRAW_COLD_MISSES);
}

// Contract C9 amendment: a drawn tile is listed only when its 26-neighbour
// tile ring is HOT or ABSENT. Defined with the membrane tile resolver below.
bool M8ReadoutRingResident(uint physicalSlot);


// A page retired by this slot is free again at this slot's next build: the
// slot is BACK for the whole of that build and no frame draws BACK.
void M8RetirePage(uint page)
{
    uint ticket;
    InterlockedAdd(_M8RenderPageQueues[M8_RENDER_CONTROL_RETIRE_TAIL], 1u,
        ticket);
    uint head = _M8RenderPageQueues[M8_RENDER_CONTROL_RETIRE_HEAD];
    if (ticket - head >= M8_RENDER_PAGE_CAPACITY) return;
    _M8RenderPageQueues[M8_RENDER_RETIRE_BASE +
        (ticket & M8_RENDER_RETIRE_MASK)] = page & M8_RENDER_PAGE_ID_MASK;
}

void M8RetireBackRecordPages(uint base)
{
    uint pages = min(_M8RenderIndexBack[base + 1u],
        M8_RENDER_TILE_MAX_PAGES);
    uint page = _M8RenderIndexBack[base + M8_RENDER_RECORD_FIRST_PAGE];
    for (uint ordinal = 0u;
        ordinal < pages && page != M8_RENDER_PAGE_INVALID; ordinal++)
    {
        uint next = _M8RenderPageQueues[M8_RENDER_LINK_BASE + page];
        M8RetirePage(page);
        page = next;
    }
}

[numthreads(1, 1, 1)]
void BeginRenderBuild(uint id : SV_DispatchThreadID)
{
    _M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT] = 0u;
    _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 0u;
    _M8Counters[M8_COUNTER_LATE_DRAW_COLD_MISSES] = 0u;
    _M8Counters[M8_COUNTER_CANDIDATE_BLOCKS] = 0u;
    _M8Counters[M8_COUNTER_HASH_HIT_BLOCKS] = 0u;
    _M8Counters[M8_COUNTER_VISIBLE_CHUNKS] = 0u;
    _M8Counters[M8_COUNTER_OCCUPIED_CONSIDERED] = 0u;
    _M8Counters[M8_COUNTER_READOUT_PLANE_VALID] = 0u;
    _M8Counters[M8_COUNTER_READOUT_EMITTED_PATCHES] = 0u;
    _M8Counters[M8_COUNTER_READOUT_COLD_IN_COVERAGE] = 0u;
    _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES] = 0u;
    _M8Counters[M8_COUNTER_READOUT_PLANE_LEGACY_INVALID] = 0u;
    _M8Counters[M8_COUNTER_READOUT_EMITTED_VERTICES] = 0u;
    _M8Counters[M8_COUNTER_RENDER_REBUILD_TILES] = 0u;
    _M8Counters[M8_COUNTER_RENDER_VIEW_OVERFLOW] = 0u;
    _M8Counters[M8_COUNTER_RENDER_PUBLICATION_INVALID] = 0u;
    _M8Counters[M8_COUNTER_READOUT_RING_INVARIANT] = 0u;
    _M8Counters[M8_COUNTER_RENDER_CAPACITY_FAILED] = 0u;
    _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] = MERKABA_READOUT_BUILDING;
    // The list built now goes to the other region of this slot; the list
    // this slot published last time stays readable for CopyRenderIndex and
    // CollectRenderRebuildTiles.
    _M8RenderIndexBack[M8_RENDER_HEADER_PREVIOUS_TILES] =
        _M8RenderIndexBack[0];
    _M8RenderIndexBack[M8_RENDER_HEADER_LIST_REGION] =
        (_M8RenderIndexBack[M8_RENDER_HEADER_LIST_REGION] ^ 1u) & 1u;
    _M8RenderIndexBack[0] = 0u;
    // _M8RenderIndexBack[1] (published indices) follows the records by
    // delta and is never recounted.
    _M8Counters[M8_COUNTER_RENDER_BATCH_BASE] = 0u;
    _M8Counters[M8_COUNTER_RENDER_BATCH_CURSOR] = 0u;
}

groupshared uint gFrameBlockRef;
groupshared int3 gFrameBlockMin;
groupshared uint gFrameWarm4;
groupshared uint gFrameDraw4;
groupshared uint gFrameDependency4;
groupshared uint gFrameWarm3[8];
groupshared uint gFrameDraw3[8];
groupshared uint gFrameDependency3[8];

[numthreads(64, 1, 1)]
void RequestWarmResidency(uint3 groupId : SV_GroupID, uint thread : SV_GroupIndex)
{
    uint linearBlockIndex = groupId.x;
    if (thread == 0u)
    {
        gFrameBlockRef = 0u;
        gFrameWarm4 = 0u;
        gFrameDraw4 = 0u;
        gFrameDependency4 = 0u;
        uint side = (uint)_M8QueryBlockSide;
        if (linearBlockIndex < side * side * side)
        {
            int3 offset;
            offset.x = (int)(linearBlockIndex % side) - _M8QueryBlockRadius;
            offset.y = (int)((linearBlockIndex / side) % side) -
                _M8QueryBlockRadius;
            offset.z = (int)(linearBlockIndex / (side * side)) -
                _M8QueryBlockRadius;
            int3 blockCoord = _M8QueryCenterBlock + offset;
            gFrameBlockMin = blockCoord * MERKABA_M8_BLOCK_KERNEL_SPAN;
            M8CounterIncrement(M8_COUNTER_CANDIDATE_BLOCKS);
            if (M8AabbIntersectsDistance(gFrameBlockMin,
                MERKABA_M8_BLOCK_KERNEL_SPAN, _M8WarmDistance))
            {
                uint blockIndex = 0u;
                if (M8FindBlock(blockCoord, blockIndex))
                {
                    gFrameBlockRef = blockIndex + 1u;
                    gFrameWarm4 = M8DistanceChildMask(gFrameBlockMin, 256,
                        _M8WarmDistance);
                    gFrameDraw4 = M8DrawChildMask(gFrameBlockMin, 256);
                    gFrameDependency4 = M8DependencyChildMask(
                        gFrameBlockMin, 256);
                    M8CounterIncrement(M8_COUNTER_HASH_HIT_BLOCKS);
                }
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (thread < 8u)
    {
        uint d4ForMask = thread;
        gFrameWarm3[d4ForMask] = 0u;
        gFrameDraw3[d4ForMask] = 0u;
        gFrameDependency3[d4ForMask] = 0u;
        if (gFrameBlockRef != 0u)
        {
            uint maskBlockIndex = gFrameBlockRef - 1u;
            if (((_M8BlockPresenceL0Read[maskBlockIndex] & gFrameWarm4) &
                (1u << d4ForMask)) != 0u)
            {
                int3 min4ForMask = gFrameBlockMin +
                    MerkabaM8OctantOffset(d4ForMask, 128);
                gFrameWarm3[d4ForMask] = M8DistanceChildMask(min4ForMask, 128,
                    _M8WarmDistance);
                gFrameDraw3[d4ForMask] =
                    ((gFrameDraw4 >> d4ForMask) & 1u) != 0u
                    ? M8DrawChildMask(min4ForMask, 128) : 0u;
                gFrameDependency3[d4ForMask] =
                    ((gFrameDependency4 >> d4ForMask) & 1u) != 0u
                    ? M8DependencyChildMask(min4ForMask, 128) : 0u;
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gFrameBlockRef == 0u) return;

    uint blockIndex = gFrameBlockRef - 1u;
    int3 blockMin = gFrameBlockMin;
    uint d4 = thread >> 3u;
    uint d3 = thread & 7u;
    if (((gFrameWarm4 >> d4) & 1u) == 0u ||
        (((_M8BlockPresenceL1Read[blockIndex * 8u + d4] &
        gFrameWarm3[d4]) >> d3) & 1u) == 0u) return;

    int3 min4 = blockMin + MerkabaM8OctantOffset(d4, 128);
    int3 min3 = min4 + MerkabaM8OctantOffset(d3, 64);
    uint warm2 = M8DistanceChildMask(min3, 64, _M8WarmDistance);
    bool drawPath3 = ((gFrameDraw4 >> d4) & 1u) != 0u &&
        ((gFrameDraw3[d4] >> d3) & 1u) != 0u;
    bool dependencyPath3 = ((gFrameDependency4 >> d4) & 1u) != 0u &&
        ((gFrameDependency3[d4] >> d3) & 1u) != 0u;
    uint draw2 = drawPath3 ? M8DrawChildMask(min3, 64) : 0u;
    uint dependency2 = dependencyPath3
        ? M8DependencyChildMask(min3, 64) : 0u;
    uint support2 = (_M8BlockPresenceL2Read[blockIndex * 64u +
        d4 * 8u + d3] & 255u) & warm2;
    while (support2 != 0u)
    {
        uint d2 = (uint)firstbitlow(support2);
        support2 &= support2 - 1u;
        uint chunkLocal = (d4 << 6u) | (d3 << 3u) | d2;
        uint chunkRef = _M8BlockChunkRefsRead[blockIndex * 512u + chunkLocal];
        if (chunkRef == 0u || chunkRef >= MERKABA_REF_EVICTING) continue;
        uint chunkIndex = chunkRef - 1u;
        int3 min2 = min3 + MerkabaM8OctantOffset(d2, 32);
        uint warm1 = M8DistanceChildMask(min2, 32, _M8WarmDistance);
        bool drawPath2 = drawPath3 && ((draw2 >> d2) & 1u) != 0u;
        bool dependencyPath2 = dependencyPath3 &&
            ((dependency2 >> d2) & 1u) != 0u;
        uint draw1 = drawPath2 ? M8DrawChildMask(min2, 32) : 0u;
        uint dependency1 = dependencyPath2
            ? M8DependencyChildMask(min2, 32) : 0u;
        uint support1 =
            (_M8ChunkPresenceRead[M8ChunkPresenceL0Index(chunkIndex)] &
            255u) & warm1;
        bool visibleChunk = false;
        while (support1 != 0u)
        {
            uint d1 = (uint)firstbitlow(support1);
            support1 &= support1 - 1u;
            int3 min1 = min2 + MerkabaM8OctantOffset(d1, 16);
            uint warm0 = M8DistanceChildMask(min1, 16, _M8WarmDistance);
            bool drawPath1 = drawPath2 && ((draw1 >> d1) & 1u) != 0u;
            bool dependencyPath1 = dependencyPath2 &&
                ((dependency1 >> d1) & 1u) != 0u;
            uint draw0 = drawPath1 ? M8DrawChildMask(min1, 16) : 0u;
            uint dependency0 = dependencyPath1
                ? M8DependencyChildMask(min1, 16) : 0u;
            uint support0 =
                (_M8ChunkPresenceRead[
                    M8ChunkPresenceL1Index(chunkIndex, d1)] & 255u) & warm0;
            while (support0 != 0u)
            {
                uint d0 = (uint)firstbitlow(support0);
                support0 &= support0 - 1u;
                uint tileLocal = (d1 << 3u) | d0;
                uint tileRefIndex = chunkIndex * 64u + tileLocal;
                uint tileRef = _M8ChunkTileRefs[tileRefIndex];
                bool inDraw = drawPath1 && ((draw0 >> d0) & 1u) != 0u;
                bool inDependency = dependencyPath1 &&
                    ((dependency0 >> d0) & 1u) != 0u;
                // Every traversal may request loads; a LOADING tile ignores
                // a repeated request. A tile that is not resident, or whose
                // ring is not, is simply not drawn yet: no wait, no retry.
                if (tileRef == MERKABA_REF_COLD_ON_SSD)
                {
                    M8RequestWarmLoad(tileRefIndex, chunkIndex, tileLocal,
                        inDraw);
                    if (inDraw)
                        M8CounterIncrement(
                            M8_COUNTER_READOUT_COLD_IN_COVERAGE);
                    continue;
                }
                bool drawable = M8IsHotRef(tileRef) && inDraw &&
                    M8ReadoutRingResident(M8PhysicalSlot(tileRef));
                if (inDraw && !drawable)
                    M8CounterIncrement(M8_COUNTER_READOUT_COLD_IN_COVERAGE);
                if (drawable)
                {
                    uint physicalSlot = M8PhysicalSlot(tileRef);
                    uint base = M8RecordBase(physicalSlot);
                    uint currentIdentity = tileRefIndex + 1u;
                    uint backIdentity = _M8RenderIndexBack[base + 2u];
                    uint previousBits;
                    InterlockedOr(_M8TileRecords[
                        M8TileRuntimeIndex(physicalSlot)].w,
                        M8_RENDER_VIEW_MARK, previousBits);

                    uint listIndex;
                    InterlockedAdd(_M8RenderIndexBack[0], 1u, listIndex);
                    if (listIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                    {
                        _M8RenderIndexBack[M8BackListBase() + listIndex] =
                            physicalSlot;
                        // BACK keeps its own previous record of this tile.
                        // A record of another logical tile is retired here;
                        // a stale version is rebuilt below.
                        if (backIdentity != currentIdentity)
                        {
                            if (backIdentity != 0u)
                                M8RetireBackRecordPages(base);
                            _M8RenderIndexBack[base + 0u] = 0u;
                            _M8RenderIndexBack[base + 1u] = 0u;
                            _M8RenderIndexBack[base + 2u] = 0u;
                            _M8RenderIndexBack[
                                base + M8_RENDER_RECORD_FIRST_PAGE] =
                                M8_RENDER_PAGE_INVALID;
                            _M8RenderIndexBack[
                                base + M8_RENDER_RECORD_VERSION] = 0u;
                        }

                        bool needsBuild = backIdentity != currentIdentity ||
                            _M8RenderIndexBack[base + M8_RENDER_RECORD_VERSION]
                                != _M8RenderVersionsRead[physicalSlot];
                        if (needsBuild)
                        {
                            uint workIndex;
                            InterlockedAdd(_M8Counters[
                                M8_COUNTER_RENDER_REBUILD_TILES], 1u, workIndex);
                            if (workIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                                _M8VisibleTiles[workIndex] =
                                    uint2(physicalSlot, 0u);
                            else
                                _M8Counters[
                                    M8_COUNTER_RENDER_VIEW_OVERFLOW] = 1u;
                        }
                    }
                }
                if (inDraw) visibleChunk = true;
            }
        }
        if (visibleChunk) M8CounterIncrement(M8_COUNTER_VISIBLE_CHUNKS);
    }
}

struct M8ReadoutTileContext
{
    uint physicalSlot;
    int3 tileOrigin;
    int3 blockCoord;
    uint blockIndex;
    uint chunkIndex;
    uint chunkLocal;
};

#define M8_MEMBRANE_TILE_COUNT 27u
// Line-node halo (plan section 3): a valid branch of an in-tile use lies in
// layers -2..9, deciding validity needs uses in -4..11 and their charts read
// radius one, so the cell cube is the tile +-5 (18^3) and the chart table
// the tile +-4 (16^3). Both lie inside the 27 neighbour tiles.
#define M8_MEMBRANE_CACHE_HALO 5
#define M8_MEMBRANE_CACHE_SIDE 18u
#define M8_MEMBRANE_CACHE_PLANE \
    (M8_MEMBRANE_CACHE_SIDE * M8_MEMBRANE_CACHE_SIDE)
#define M8_MEMBRANE_CACHE_COUNT \
    (M8_MEMBRANE_CACHE_PLANE * M8_MEMBRANE_CACHE_SIDE)
#define M8_MEMBRANE_CHART_HALO 4
#define M8_MEMBRANE_CHART_SIDE 16u
#define M8_MEMBRANE_CHART_COUNT 4096u
#define M8_MEMBRANE_CHART_WORDS 256u
#define M8_MEMBRANE_CHART_NONE 3
#define M8_MEMBRANE_CENTER_TILE 13u
#define M8_MEMBRANE_TILE_MISSING 0xfffffffeu
#define M8_MEMBRANE_TILE_UNRESOLVED 0xffffffffu

groupshared uint gM8MembranePhysicalSlot;
groupshared int3 gM8MembraneTileOrigin;
groupshared int3 gM8MembraneBlockCoord;
groupshared uint gM8MembraneBlockIndex;
groupshared uint gM8MembraneChunkIndex;
groupshared uint gM8MembraneChunkLocal;
groupshared uint gM8MembraneTileSlots[M8_MEMBRANE_TILE_COUNT];
// The kernel flags word of every measured halo cell (the plane is decoded on
// read) and two bits per cell (bit 0 occupied with a measured plane, bit 1
// KNOWN FREE). The chart table holds the C5.1 chart of every measured cell
// of the tile +-4 (3 = none).
#define M8_MEMBRANE_CELL_WORDS 365u
#define M8_RENDER_TILE_KERNELS 512u
// One BACK transaction runs in 64-tile batches. Scratch is one batch only;
// the persistent BACK records/pages are the transaction state.
#define M8_RENDER_BATCH_TILES 64u
#define M8_RENDER_SCRATCH_TILES 64u
// Per work tile: 512 descriptors + 128 uint4 of compact measured indices.
#define M8_RENDER_SCRATCH_PATCH_STRIDE 640u
// 243 line tasks (3 charts x 9 x 9 half-lattice lines) x 64 use slots
// (4 columns x layers -4..11 of the tile).
#define M8_RENDER_LINE_TASKS 243u
#define M8_RENDER_LINE_SLOTS 64u
#define M8_RENDER_SCRATCH_LINE_STRIDE 15552u
// Node records 0..3071, transition records 3072..4095.
#define M8_RENDER_NODE_CAPACITY 3072u
#define M8_RENDER_TRANSITION_CAPACITY 1024u
#define M8_RENDER_SCRATCH_NODE_SHIFT 12u
// Descriptor w: measured flag | compact index while solving, then the valid
// patch flag | output ordinal, or 0.
#define M8_SCRATCH_MEASURED 0x40000000u
#define M8_SCRATCH_INDEX_MASK 0x1ffu
#define M8_SCRATCH_PATCH_VALID 0x80000000u
#define M8_SOLVE_GROUP_THREADS 64u
groupshared uint gM8MembraneFlags[M8_MEMBRANE_CACHE_COUNT];
groupshared uint gM8MembraneCellBits[M8_MEMBRANE_CELL_WORDS];
groupshared uint gM8MembraneCharts[M8_MEMBRANE_CHART_WORDS];
groupshared uint gM8TouchedLines[8];
groupshared uint gM8NodeTotal;
groupshared uint gM8TransitionTotal;
groupshared uint gM8InvalidBranches;
groupshared uint gM8MembraneCanEmit;
groupshared uint gM8MembraneMeasuredTotal;
// First entry of this tile's page chain in the build's allocation list; the
// chain itself stays in that list so the per-tile bound costs no groupshared.
groupshared uint gM8MembraneAllocBase;
groupshared uint gM8MembranePageCount;
groupshared uint gM8MembranePatchTotal;
groupshared uint gM8MembraneFailed;
groupshared uint gM8MembraneUnresolved;

M8ReadoutTileContext M8SharedReadoutTileContext()
{
    M8ReadoutTileContext context;
    context.physicalSlot = gM8MembranePhysicalSlot;
    context.tileOrigin = gM8MembraneTileOrigin;
    context.blockCoord = gM8MembraneBlockCoord;
    context.blockIndex = gM8MembraneBlockIndex;
    context.chunkIndex = gM8MembraneChunkIndex;
    context.chunkLocal = gM8MembraneChunkLocal;
    return context;
}

M8ReadoutTileContext M8TileContextOf(uint physicalSlot)
{
    // The tile being rebuilt owns scheduling bits in _M8TileRecords, so the
    // context reads the writable binding (a kernel never binds both aliases).
    M8ReadoutTileContext context;
    uint4 meta = _M8TileRecords[M8TileMetaIndex(physicalSlot)];
    uint2 owner = M8LoadChunkOwnerRead(meta.x);
    context.physicalSlot = physicalSlot;
    context.tileOrigin = M8GlobalKernelCoord(physicalSlot, 0u);
    context.blockIndex = owner.x;
    context.chunkIndex = meta.x;
    context.chunkLocal = owner.y;
    context.blockCoord = M8LoadBlockCoordRead(owner.x);
    return context;
}

void M8InitializeReadoutTileContext(uint physicalSlot)
{
    M8ReadoutTileContext context = M8TileContextOf(physicalSlot);
    gM8MembranePhysicalSlot = context.physicalSlot;
    gM8MembraneTileOrigin = context.tileOrigin;
    gM8MembraneBlockIndex = context.blockIndex;
    gM8MembraneChunkIndex = context.chunkIndex;
    gM8MembraneChunkLocal = context.chunkLocal;
    gM8MembraneBlockCoord = context.blockCoord;
}

uint M8MembraneTileIndex(int3 tileOffset)
{
    return (uint)(tileOffset.x + 1) +
        (uint)(tileOffset.y + 1) * 3u +
        (uint)(tileOffset.z + 1) * 9u;
}

int3 M8MembraneTileOffset(uint index)
{
    uint z = index >= 18u ? 2u : index >= 9u ? 1u : 0u;
    uint remainder = index - z * 9u;
    uint y = remainder >= 6u ? 2u : remainder >= 3u ? 1u : 0u;
    uint x = remainder - y * 3u;
    return int3((int)x - 1, (int)y - 1, (int)z - 1);
}

// Tile reference index of a halo tile, or M8_MEMBRANE_TILE_MISSING /
// M8_MEMBRANE_TILE_UNRESOLVED when block or chunk already decide it. The tile
// reference itself is read by the caller through the alias its kernel binds.
uint M8MembraneTileRefIndex(M8ReadoutTileContext context, int3 tileOffset)
{
    MerkabaM8Address address = MerkabaAddressOf(
        context.tileOrigin + tileOffset * 8);
    uint blockIndex = context.blockIndex;
    if (!all(address.blockCoord == context.blockCoord) &&
        !M8FindBlock(address.blockCoord, blockIndex))
        return M8_MEMBRANE_TILE_MISSING;

    uint chunkIndex = context.chunkIndex;
    if (blockIndex != context.blockIndex ||
        address.chunkLocal != context.chunkLocal)
    {
        uint chunkRef = _M8BlockChunkRefsRead[blockIndex *
            MERKABA_M8_BLOCK_CHUNK_COUNT + address.chunkLocal];
        if (chunkRef == MERKABA_REF_EMPTY)
            return M8_MEMBRANE_TILE_MISSING;
        if (chunkRef >= MERKABA_REF_EVICTING)
            return M8_MEMBRANE_TILE_UNRESOLVED;
        chunkIndex = chunkRef - 1u;
    }
    return chunkIndex * MERKABA_M8_TILES_PER_CHUNK + address.tileLocal;
}

uint M8MembraneSlotOfRef(uint tileRef)
{
    if (tileRef == MERKABA_REF_EMPTY ||
        tileRef == MERKABA_REF_CLAIMED_NEW)
        return M8_MEMBRANE_TILE_MISSING;
    if (!M8IsHotRef(tileRef))
        return M8_MEMBRANE_TILE_UNRESOLVED;
    return M8PhysicalSlot(tileRef);
}

uint M8ResolveMembraneTile(M8ReadoutTileContext context, int3 tileOffset)
{
    if (!any(tileOffset != 0)) return context.physicalSlot;
    uint refIndex = M8MembraneTileRefIndex(context, tileOffset);
    if (refIndex >= M8_MEMBRANE_TILE_MISSING) return refIndex;
    return M8MembraneSlotOfRef(_M8ChunkTileRefsRead[refIndex]);
}

// The traversal kernel writes tile references (load requests), so the ring
// test reads the writable alias.
bool M8ReadoutRingResident(uint physicalSlot)
{
    M8ReadoutTileContext context = M8TileContextOf(physicalSlot);
    [loop]
    for (uint tile = 0u; tile < M8_MEMBRANE_TILE_COUNT; tile++)
    {
        if (tile == M8_MEMBRANE_CENTER_TILE) continue;
        uint refIndex = M8MembraneTileRefIndex(context,
            M8MembraneTileOffset(tile));
        if (refIndex == M8_MEMBRANE_TILE_MISSING) continue;
        if (refIndex == M8_MEMBRANE_TILE_UNRESOLVED) return false;
        if (M8MembraneSlotOfRef(_M8ChunkTileRefs[refIndex]) ==
                M8_MEMBRANE_TILE_UNRESOLVED)
            return false;
    }
    return true;
}

uint M8LoadKernelFlagsOnly(uint physicalSlot, uint kernelLocal)
{
    uint index = M8BankStateIndex(physicalSlot, kernelLocal);
    uint bank = physicalSlot >> MERKABA_M8_TILE_BANK_SHIFT;
    if (bank == 0u) return _M8KernelStates0Read[index].flags;
    if (bank == 1u) return _M8KernelStates1Read[index].flags;
    if (bank == 2u) return _M8KernelStates2Read[index].flags;
    return _M8KernelStates3Read[index].flags;
}

int M8LoadKernelEvidenceOnly(uint physicalSlot, uint kernelLocal)
{
    uint index = M8BankStateIndex(physicalSlot, kernelLocal);
    uint bank = physicalSlot >> MERKABA_M8_TILE_BANK_SHIFT;
    if (bank == 0u) return _M8KernelStates0Read[index].evidence;
    if (bank == 1u) return _M8KernelStates1Read[index].evidence;
    if (bank == 2u) return _M8KernelStates2Read[index].evidence;
    return _M8KernelStates3Read[index].evidence;
}

void M8MembraneCacheAddress(uint index, out int3 relative,
    out uint tileIndex, out uint kernelLocal)
{
    // The bounded [0,5831] index is exactly representable as float; the
    // half-step bias keeps the reciprocal quotient on the right integer.
    // Adreno hot path: no integer division.
    uint z = (uint)(((float)index + 0.5) * (1.0 / 324.0));
    uint remainder = index - z * M8_MEMBRANE_CACHE_PLANE;
    uint y = (uint)(((float)remainder + 0.5) * (1.0 / 18.0));
    uint x = remainder - y * M8_MEMBRANE_CACHE_SIDE;
    relative = int3((int)x, (int)y, (int)z) - M8_MEMBRANE_CACHE_HALO;
    int3 tileOffset = int3(relative.x < 0 ? -1 : relative.x >= 8 ? 1 : 0,
        relative.y < 0 ? -1 : relative.y >= 8 ? 1 : 0,
        relative.z < 0 ? -1 : relative.z >= 8 ? 1 : 0);
    int3 tileLocal = relative - tileOffset * 8;
    tileIndex = M8MembraneTileIndex(tileOffset);
    kernelLocal = (uint)tileLocal.x | ((uint)tileLocal.y << 3u) |
        ((uint)tileLocal.z << 6u);
}

bool M8MembraneCell(int3 globalCoord, out bool resolved, out bool measured,
    out bool knownFree)
{
    measured = false;
    knownFree = false;
    int3 local = globalCoord - gM8MembraneTileOrigin +
        M8_MEMBRANE_CACHE_HALO;
    if (any(local < 0) || any(local >= (int)M8_MEMBRANE_CACHE_SIDE))
    {
        resolved = false;
        return false;
    }
    int3 relative = globalCoord - gM8MembraneTileOrigin;
    int3 tileOffset = int3(relative.x < 0 ? -1 : relative.x >= 8 ? 1 : 0,
        relative.y < 0 ? -1 : relative.y >= 8 ? 1 : 0,
        relative.z < 0 ? -1 : relative.z >= 8 ? 1 : 0);
    uint slot = gM8MembraneTileSlots[M8MembraneTileIndex(tileOffset)];
    if (slot == M8_MEMBRANE_TILE_UNRESOLVED)
    {
        resolved = false;
        return false;
    }
    resolved = true;
    if (slot == M8_MEMBRANE_TILE_MISSING) return false;
    uint cellIndex = (uint)local.x + (uint)local.y * M8_MEMBRANE_CACHE_SIDE +
        (uint)local.z * M8_MEMBRANE_CACHE_PLANE;
    uint bits = gM8MembraneCellBits[cellIndex >> 4u] >>
        ((cellIndex & 15u) * 2u);
    measured = (bits & 1u) != 0u;
    knownFree = (bits & 2u) != 0u;
    return true;
}

float4 M8MembranePlaneOf(int3 globalCoord)
{
    int3 local = globalCoord - gM8MembraneTileOrigin +
        M8_MEMBRANE_CACHE_HALO;
    uint cellIndex = (uint)local.x + (uint)local.y * M8_MEMBRANE_CACHE_SIDE +
        (uint)local.z * M8_MEMBRANE_CACHE_PLANE;
    float3 normal;
    float signedOffset;
    M8DecodeSurfacePlane(gM8MembraneFlags[cellIndex], normal, signedOffset);
    return float4(normal, dot((float3)globalCoord * MERKABA_LATTICE_STEP,
        normal) + signedOffset);
}

int M8MembraneChartOf(int3 globalCoord)
{
    int3 local = globalCoord - gM8MembraneTileOrigin +
        M8_MEMBRANE_CHART_HALO;
    if (any(local < 0) || any(local >= (int)M8_MEMBRANE_CHART_SIDE))
        return M8_MEMBRANE_CHART_NONE;
    uint index = (uint)local.x + ((uint)local.y << 4u) +
        ((uint)local.z << 8u);
    return (int)((gM8MembraneCharts[index >> 4u] >>
        ((index & 15u) * 2u)) & 3u);
}

[numthreads(1, 1, 1)]
void PrepareRenderReclaim(uint id : SV_DispatchThreadID)
{
    // A rejected BACK keeps its records and their pages: the next build of
    // this slot completes it. Only the retire ring returns pages, one build
    // after they stopped being referenced.
    uint head = _M8RenderPageQueues[M8_RENDER_CONTROL_RETIRE_HEAD];
    uint tail = _M8RenderPageQueues[M8_RENDER_CONTROL_RETIRE_TAIL];
    uint pending = min(tail - head, M8_RENDER_PAGE_CAPACITY);
    _M8RenderPageQueues[M8_RENDER_CONTROL_RECLAIM_COUNT] = pending;
    _M8FrameDispatchArgs[0] = max(1u, (pending + 255u) >> 8u);
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
}

[numthreads(256, 1, 1)]
void ReclaimRenderPages(uint id : SV_DispatchThreadID)
{
    uint count = _M8RenderPageQueues[M8_RENDER_CONTROL_RECLAIM_COUNT];
    uint freeBase = _M8RenderPageQueues[M8_RENDER_CONTROL_FREE_PAGES];
    if (id >= count || freeBase + id >= M8_RENDER_PAGE_CAPACITY) return;
    uint head = _M8RenderPageQueues[M8_RENDER_CONTROL_RETIRE_HEAD];
    uint entry = _M8RenderPageQueues[M8_RENDER_RETIRE_BASE +
        ((head + id) & M8_RENDER_RETIRE_MASK)];
    _M8RenderPageQueues[M8_RENDER_FREE_BASE + freeBase + id] =
        entry & M8_RENDER_PAGE_ID_MASK;
    // A page returning to the free stack belongs to no record.
    _M8RenderPageQueues[M8_RENDER_OWNER_BASE + (entry & M8_RENDER_PAGE_ID_MASK)]
        = 0u;
}

[numthreads(1, 1, 1)]
void ApplyRenderReclaim(uint id : SV_DispatchThreadID)
{
    uint reclaimed = _M8RenderPageQueues[M8_RENDER_CONTROL_RECLAIM_COUNT];
    uint freePages = min(_M8RenderPageQueues[M8_RENDER_CONTROL_FREE_PAGES] +
        reclaimed, M8_RENDER_PAGE_CAPACITY);
    _M8RenderPageQueues[M8_RENDER_CONTROL_FREE_PAGES] = freePages;
    _M8RenderPageQueues[M8_RENDER_CONTROL_RETIRE_HEAD] += reclaimed;
    _M8RenderPageQueues[M8_RENDER_CONTROL_RECLAIM_COUNT] = 0u;
    _M8RenderPageQueues[M8_RENDER_CONTROL_ALLOC_COUNT] = 0u;
}

[numthreads(128, 1, 1)]
void CopyRenderIndex(uint id : SV_DispatchThreadID)
{
    // Page ownership persists with the pages: written at allocation, cleared
    // at reclaim. Nothing is swept here.
    if (id >= M8BackPreviousTileCount()) return;
    uint physicalSlot = _M8RenderIndexBack[M8BackPreviousListBase() + id];
    if (physicalSlot >= MERKABA_M8_PHYSICAL_TILE_CAPACITY) return;
    uint ignored;
    InterlockedAnd(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
        ~M8_RENDER_VIEW_MARK, ignored);
}


uint M8CurrentRenderIdentity(uint physicalSlot)
{
    uint4 meta = _M8TileRecords[M8TileMetaIndex(physicalSlot)];
    uint refIndex = meta.x * MERKABA_M8_TILES_PER_CHUNK + meta.y;
    return refIndex < MERKABA_M8_CHUNK_CAPACITY *
        MERKABA_M8_TILES_PER_CHUNK &&
        _M8ChunkTileRefsRead[refIndex] == physicalSlot + 1u
        ? refIndex + 1u : 0u;
}

bool M8RenderJournalReserve(uint headCounter, uint tailCounter,
    out uint ticket)
{
    ticket = 0u;
    [loop]
    for (uint attempt = 0u; attempt < 16u; attempt++)
    {
        uint head = _M8Counters[headCounter];
        uint tail = _M8Counters[tailCounter];
        if (tail - head >= M8_RENDER_JOURNAL_CAPACITY)
        {
            _M8Counters[M8_COUNTER_RENDER_JOURNAL_OVERFLOW] = 1u;
            return false;
        }
        uint prior;
        InterlockedCompareExchange(_M8Counters[tailCounter], tail,
            tail + 1u, prior);
        if (prior == tail)
        {
            ticket = tail;
            return true;
        }
    }
    _M8Counters[M8_COUNTER_RENDER_JOURNAL_OVERFLOW] = 1u;
    return false;
}

void M8RenderJournalQueueDirty(uint physicalSlot, uint dependencyBits)
{
    uint previous;
    InterlockedOr(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
        M8_RENDER_DIRTY | M8_RENDER_DIRTY_QUEUED |
        (dependencyBits & M8_RENDER_DEPENDENCY_MASK), previous);
    if ((previous & M8_RENDER_DIRTY_QUEUED) != 0u) return;
    uint ticket;
    if (!M8RenderJournalReserve(M8_COUNTER_RENDER_JOURNAL_HEAD,
            M8_COUNTER_RENDER_JOURNAL_TAIL, ticket))
    {
        uint ignored;
        InterlockedAnd(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
            ~M8_RENDER_DIRTY_QUEUED, ignored);
        return;
    }
    uint entry = (ticket & M8_RENDER_JOURNAL_MASK) *
        M8_RENDER_JOURNAL_ENTRY_WORDS;
    _M8RenderMutationQueue[entry] = physicalSlot;
    _M8RenderMutationQueue[entry + 1u] =
        M8CurrentRenderIdentity(physicalSlot);
}

void M8MarkDependencyDirty(uint physicalSlot)
{
    if (physicalSlot >= MERKABA_M8_PHYSICAL_TILE_CAPACITY) return;
    uint previous;
    InterlockedOr(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
        M8_RENDER_DIRTY, previous);
    InterlockedAdd(_M8RenderVersions[physicalSlot], 1u, previous);
    if ((previous & M8_RENDER_DIRTY) == 0u)
        M8CounterIncrement(M8_COUNTER_RENDER_DIRTY_MARKS);
}


void M8QueueRenderDependencies(uint physicalSlot, uint dependencyBits)
{
    if (dependencyBits == 0u ||
        M8CurrentRenderIdentity(physicalSlot) == 0u) return;
    M8ReadoutTileContext context = M8TileContextOf(physicalSlot);
    [unroll]
    for (uint neighbour = 0u; neighbour < 26u; neighbour++)
    {
        uint dependency = 1u << (M8_RENDER_DEPENDENCY_SHIFT + neighbour);
        if ((dependencyBits & dependency) == 0u) continue;
        uint gridIndex = neighbour < 13u ? neighbour : neighbour + 1u;
        uint slot = M8ResolveMembraneTile(context,
            M8MembraneTileOffset(gridIndex));
        if (slot < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
            M8MarkDependencyDirty(slot);
    }
}

[numthreads(1, 1, 1)]
void MarkRenderRebuildTiles(uint id : SV_DispatchThreadID)
{
    uint head = _M8Counters[M8_COUNTER_RENDER_JOURNAL_HEAD];
    uint tail = _M8Counters[M8_COUNTER_RENDER_JOURNAL_TAIL];
    uint count = min(tail - head, M8_RENDER_JOURNAL_CAPACITY);
    _M8Counters[M8_COUNTER_RENDER_JOURNAL_BATCH] = count;
    _M8FrameDispatchArgs[0] = max(1u, (count + 63u) >> 6u);
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
}

[numthreads(64, 1, 1)]
void ApplyRenderMutationJournal(uint id : SV_DispatchThreadID)
{
    uint count = _M8Counters[M8_COUNTER_RENDER_JOURNAL_BATCH];
    if (id >= count) return;
    uint head = _M8Counters[M8_COUNTER_RENDER_JOURNAL_HEAD];
    uint entry = ((head + id) & M8_RENDER_JOURNAL_MASK) *
        M8_RENDER_JOURNAL_ENTRY_WORDS;
    uint physicalSlot = _M8RenderMutationQueue[entry];
    uint journalledIdentity = _M8RenderMutationQueue[entry + 1u];
    if (physicalSlot >= MERKABA_M8_PHYSICAL_TILE_CAPACITY) return;
    // A slot recycled by eviction must never mark the tile that took it.
    if (journalledIdentity != 0u &&
        M8CurrentRenderIdentity(physicalSlot) != journalledIdentity)
    {
        uint stale;
        InterlockedAnd(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
            ~M8_RENDER_DIRTY_QUEUED, stale);
        return;
    }
    uint previous;
    InterlockedAnd(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
        ~(M8_RENDER_DIRTY_QUEUED | M8_RENDER_DEPENDENCY_MASK), previous);
    uint version;
    InterlockedAdd(_M8RenderVersions[physicalSlot], 1u, version);
    M8QueueRenderDependencies(physicalSlot,
        previous & M8_RENDER_DEPENDENCY_MASK);
}

[numthreads(128, 1, 1)]
void CollectRenderRebuildTiles(uint id : SV_DispatchThreadID)
{
    // Tiles that BACK published last time but which left coverage now.
    if (id >= M8BackPreviousTileCount()) return;
    uint physicalSlot = _M8RenderIndexBack[M8BackPreviousListBase() + id];
    if (physicalSlot >= MERKABA_M8_PHYSICAL_TILE_CAPACITY) return;
    uint bits = _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w;
    if ((bits & M8_RENDER_VIEW_MARK) != 0u) return;
    uint base = M8RecordBase(physicalSlot);
    if (_M8RenderIndexBack[base + 2u] == 0u) return;
    M8RetireBackRecordPages(base);
    uint ignored;
    InterlockedAdd(_M8RenderIndexBack[1], ~_M8RenderIndexBack[base + 0u] + 1u,
        ignored);
    _M8RenderIndexBack[base + 0u] = 0u;
    _M8RenderIndexBack[base + 1u] = 0u;
    _M8RenderIndexBack[base + 2u] = 0u;
    _M8RenderIndexBack[base + M8_RENDER_RECORD_FIRST_PAGE] =
        M8_RENDER_PAGE_INVALID;
    _M8RenderIndexBack[base + M8_RENDER_RECORD_VERSION] = 0u;
}

[numthreads(1, 1, 1)]
void PrepareRenderBuild(uint id : SV_DispatchThreadID)
{
    uint journalCount = _M8Counters[M8_COUNTER_RENDER_JOURNAL_BATCH];
    uint journalHead = _M8Counters[M8_COUNTER_RENDER_JOURNAL_HEAD] +
        journalCount;
    _M8Counters[M8_COUNTER_RENDER_JOURNAL_HEAD] = journalHead;
    if (journalHead == _M8Counters[M8_COUNTER_RENDER_JOURNAL_TAIL])
        _M8Counters[M8_COUNTER_RENDER_JOURNAL_OVERFLOW] = 0u;
    _M8Counters[M8_COUNTER_RENDER_JOURNAL_BATCH] = 0u;
    uint tiles = min(_M8Counters[M8_COUNTER_RENDER_REBUILD_TILES],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    _M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT] = tiles;
    // The rebuild list is immutable from here; AdvanceRenderBuildBatch
    // schedules it batch by batch. Record 2 tells the CPU how far it is.
    _M8Counters[M8_COUNTER_RENDER_BATCH_BASE] = 0u;
    _M8Counters[M8_COUNTER_RENDER_BATCH_CURSOR] = 0u;
    _M8FrameDispatchArgs[0] = 0u;
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
    _M8AttemptCompletion[2] = uint4(_M8ReadoutRevision, 0u, tiles, 0u);
}


void M8StoreRenderVertex(uint vertex, float3 gridPosition, uint packedColor)
{
    uint address = vertex * 16u;
    _M8RenderVertices.Store3(address, asuint(gridPosition));
    _M8RenderVertices.Store(address + 12u, packedColor);
}

// Exact union-skin topology. Missing neighbour tiles are empty; non-resident
// neighbours are unresolved and defer publication so FRONT remains coherent.
// Full canonical state of a resolved halo kernel through the cached tile
// slots: colour and confidence come from the record, not from the halo
// summary, so the live node equals the export node.
KernelState M8LoadMembraneOwnerState(int3 globalCoord)
{
    int3 relative = globalCoord - gM8MembraneTileOrigin;
    int3 tileOffset = int3(relative.x < 0 ? -1 : relative.x >= 8 ? 1 : 0,
        relative.y < 0 ? -1 : relative.y >= 8 ? 1 : 0,
        relative.z < 0 ? -1 : relative.z >= 8 ? 1 : 0);
    int3 local = relative - tileOffset * 8;
    uint slot = gM8MembraneTileSlots[M8MembraneTileIndex(tileOffset)];
    uint kernelLocal = (uint)local.x | ((uint)local.y << 3u) |
        ((uint)local.z << 6u);
    return M8LoadKernelStateRead(slot, kernelLocal);
}

void M8LoadMembraneColor(int3 globalCoord, out uint packedColor,
    out uint colorConfidence)
{
    KernelState owner = M8LoadMembraneOwnerState(globalCoord);
    packedColor = owner.packedColor;
    colorConfidence = owner.colorConfidence;
}

// The membrane is the generated CPU/HLSL oracle (C5.1-C5.4): one measured
// MAIN owns one 25 mm quad (4 vertices, 6 indices, 2 triangles) whose corners
// are line nodes shared by every patch that uses them. The 50 mm support
// decides only which samples are joined; it never defines a triangle.
// Page p of this tile's chain, from the build's allocation list.
uint M8TilePage(uint ordinal)
{
    return _M8RenderPageQueues[M8_RENDER_ALLOC_BASE + gM8MembraneAllocBase +
        ordinal];
}

bool M8TakeRenderPages(uint pagesNeeded)
{
    if (pagesNeeded == 0u) return true;
    if (gM8MembranePageCount != 0u || pagesNeeded > M8_RENDER_TILE_MAX_PAGES)
        return false;
    // One atomic pop of the shared free stack: concurrent tile groups never
    // observe the same page, and an exhausted pool reverts its own claim.
    // Nothing pushes onto the free stack during a build (rejected tiles
    // retire their pages), so the popped range is intact while it is read.
    uint remaining;
    InterlockedAdd(_M8RenderPageQueues[M8_RENDER_CONTROL_FREE_PAGES],
        ~pagesNeeded + 1u, remaining);
    if (remaining < pagesNeeded || remaining > M8_RENDER_PAGE_CAPACITY)
    {
        uint ignored;
        InterlockedAdd(_M8RenderPageQueues[M8_RENDER_CONTROL_FREE_PAGES],
            pagesNeeded, ignored);
        return false;
    }
    uint allocBase;
    InterlockedAdd(_M8RenderPageQueues[M8_RENDER_CONTROL_ALLOC_COUNT],
        pagesNeeded, allocBase);
    if (allocBase + pagesNeeded > M8_RENDER_PAGE_CAPACITY)
    {
        uint ignored;
        InterlockedAdd(_M8RenderPageQueues[M8_RENDER_CONTROL_FREE_PAGES],
            pagesNeeded, ignored);
        return false;
    }
    gM8MembraneAllocBase = allocBase;
    uint previous = M8_RENDER_PAGE_INVALID;
    [loop]
    for (uint page = 0u; page < pagesNeeded; page++)
    {
        uint pageId = _M8RenderPageQueues[
            M8_RENDER_FREE_BASE + remaining - 1u - page];
        _M8RenderPageQueues[M8_RENDER_ALLOC_BASE + allocBase + page] = pageId;
        // Ownership is written with the allocation and cleared by reclaim.
        _M8RenderPageQueues[M8_RENDER_OWNER_BASE + pageId] =
            gM8MembranePhysicalSlot + 1u;
        if (previous != M8_RENDER_PAGE_INVALID)
            _M8RenderPageQueues[M8_RENDER_LINK_BASE + previous] = pageId;
        _M8RenderPageQueues[M8_RENDER_LINK_BASE + pageId] =
            M8_RENDER_PAGE_INVALID;
        previous = pageId;
    }
    gM8MembranePageCount = pagesNeeded;
    return true;
}

void M8DiscardTilePages()
{
    // Pages of a rejected tile belong to no record; they return through the
    // retire ring of this slot like every page a build stops referencing.
    uint count = gM8MembranePageCount;
    [loop]
    for (uint page = 0u; page < count; page++)
        M8RetirePage(M8TilePage(page));
}

// The upper bound taken before emission is trimmed to the pages the tile
// really filled; the surplus returns through the retire ring.
void M8TrimTilePages(uint keepPages)
{
    uint count = gM8MembranePageCount;
    if (keepPages >= count) return;
    if (keepPages != 0u)
        _M8RenderPageQueues[M8_RENDER_LINK_BASE +
            M8TilePage(keepPages - 1u)] = M8_RENDER_PAGE_INVALID;
    [loop]
    for (uint page = keepPages; page < count; page++)
        M8RetirePage(M8TilePage(page));
    gM8MembranePageCount = keepPages;
}

// Vertex k of the tile lives in page chain[k >> 6], slot k & 63.
uint M8MembraneVertexSlot(uint tileVertex)
{
    return M8TilePage(tileVertex >> M8_RENDER_PAGE_VERTEX_SHIFT) *
        M8_RENDER_PAGE_VERTICES +
        (tileVertex & (M8_RENDER_PAGE_VERTICES - 1u));
}

// Index j of the tile lives in page chain[j >> 8], slot j & 255.
uint M8MembraneIndexSlot(uint tileIndex)
{
    return M8TilePage(tileIndex >> M8_RENDER_PAGE_INDEX_SHIFT) *
        M8_RENDER_PAGE_INDICES +
        (tileIndex & (M8_RENDER_PAGE_INDICES - 1u));
}

// ---------------------------------------------------------------------------
// Readout build: one BACK transaction in batches of M8_RENDER_BATCH_TILES,
// every batch four flat dispatches per rebuild tile (contract C5, C5.1-C5.4):
//   AdvanceRenderBuildBatch    cursor and dispatch size of the next batch
//   CollectRenderPatchInputs   descriptors (fixed kernelLocal slots) and the
//                              compact list of measured MAINs
//   SolveSharedKnotLines       halo cube, chart table, and one C5.2 node per
//                              valid branch of every touched line
//   ResolveRenderPatches       C5.3 patches and C5.4 transitions from node
//                              ids, one vertex ordinal per referenced node
//   EmitRenderTileGeometry     pages (owner written at allocation), one
//                              vertex per referenced node, six indices per
//                              patch and transition, record with delta
// No kernel mixes solve with emission, nothing is indexed dynamically in
// private memory, no lane walks the tile serially and no batch publishes.
// ---------------------------------------------------------------------------

groupshared uint gM8ScratchVertexTotal;
groupshared uint gM8ScratchValidPatches;
groupshared uint gM8MeasuredWords[16];
groupshared uint gM8MeasuredList[M8_RENDER_TILE_KERNELS];

// Scratch of batch-local work tile w: 512 descriptors then 128 uint4 that
// hold the compact list of measured kernelLocals (four per uint4).
uint M8ScratchPatchBase(uint work)
{
    return work * M8_RENDER_SCRATCH_PATCH_STRIDE;
}

uint M8ScratchCompactBase(uint work)
{
    return work * M8_RENDER_SCRATCH_PATCH_STRIDE + M8_RENDER_TILE_KERNELS;
}

uint M8ScratchCompactKernel(uint patchBase, uint index)
{
    uint4 entry = _M8RenderPatchScratch[patchBase + M8_RENDER_TILE_KERNELS +
        (index >> 2u)];
    uint lane = index & 3u;
    return lane == 0u ? entry.x : lane == 1u ? entry.y :
        lane == 2u ? entry.z : entry.w;
}

uint M8ScratchCompactKernelRead(uint patchBase, uint index)
{
    uint4 entry = _M8RenderPatchScratchRead[patchBase +
        M8_RENDER_TILE_KERNELS + (index >> 2u)];
    uint lane = index & 3u;
    return lane == 0u ? entry.x : lane == 1u ? entry.y :
        lane == 2u ? entry.z : entry.w;
}

// Population count without the intrinsic (FXC rejects it in this shader on
// the Vulkan path).
uint M8PopCount(uint value)
{
    value = value - ((value >> 1u) & 0x55555555u);
    value = (value & 0x33333333u) + ((value >> 2u) & 0x33333333u);
    value = (value + (value >> 4u)) & 0x0f0f0f0fu;
    return (value * 0x01010101u) >> 24u;
}

// Rebuild-list index of batch-local work tile w.
uint M8BatchWork(uint local)
{
    return _M8Counters[M8_COUNTER_RENDER_BATCH_BASE] + local;
}

// Retires the record of a tile whose identity is gone (evicted or reused).
void M8ClearDepartedRecord(uint work, uint physicalSlot)
{
    uint ignored;
    uint base = M8RecordBase(physicalSlot);
    M8RetireBackRecordPages(base);
    // The publication total follows the record by delta, never by recount.
    InterlockedAdd(_M8RenderIndexBack[1], ~_M8RenderIndexBack[base + 0u] + 1u,
        ignored);
    _M8RenderIndexBack[base + 0u] = 0u;
    _M8RenderIndexBack[base + 1u] = 0u;
    _M8RenderIndexBack[base + 2u] = 0u;
    _M8RenderIndexBack[base + M8_RENDER_RECORD_FIRST_PAGE] =
        M8_RENDER_PAGE_INVALID;
    _M8RenderIndexBack[base + M8_RENDER_RECORD_VERSION] = 0u;
    InterlockedAnd(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
        ~(M8_RENDER_DIRTY | M8_RENDER_DEPENDENCY_MASK), ignored);
    _M8VisibleTiles[work].y = 1u;
}

// Descriptor: x = kernelLocal, y = MAIN flags, z = packed colour,
// w = compact index | M8_SCRATCH_MEASURED while solving, then
// M8_SCRATCH_PATCH_VALID | output ordinal for a valid patch, 0 otherwise.
bool M8DescriptorMeasured(uint4 descriptor)
{
    return (descriptor.w & M8_SCRATCH_MEASURED) != 0u;
}

// The next batch of the transaction: cursor, dispatch size, completion
// record 2 = (revision, cursor after this batch, rebuild count, scheduled).
[numthreads(1, 1, 1)]
void AdvanceRenderBuildBatch(uint id : SV_DispatchThreadID)
{
    uint total = min(_M8Counters[M8_COUNTER_RENDER_REBUILD_TILES],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    uint cursor = _M8Counters[M8_COUNTER_RENDER_BATCH_CURSOR];
    uint scheduled = cursor < total
        ? min(total - cursor, M8_RENDER_BATCH_TILES) : 0u;
    _M8Counters[M8_COUNTER_RENDER_BATCH_BASE] = cursor;
    _M8Counters[M8_COUNTER_RENDER_BATCH_CURSOR] = cursor + scheduled;
    _M8FrameDispatchArgs[0] = scheduled;
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
    _M8AttemptCompletion[2] = uint4(_M8ReadoutRevision, cursor + scheduled,
        total, scheduled);
}

// Kernel 1: fixed descriptor slot per kernel and the compact measured list.
[numthreads(128, 1, 1)]
void CollectRenderPatchInputs(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint local = groupId.x;
    uint work = M8BatchWork(local);
    uint physicalSlot = _M8VisibleTiles[work].x;
    if (thread == 0u)
    {
        gM8MembraneMeasuredTotal = 0u;
        gM8MembraneFailed = 0u;
        if (M8CurrentRenderIdentity(physicalSlot) == 0u)
        {
            M8ClearDepartedRecord(work, physicalSlot);
            gM8MembraneFailed = 2u;
        }
        else
        {
            _M8VisibleTiles[work].y = 0u;
            M8InitializeReadoutTileContext(physicalSlot);
            uint ignored;
            InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_CONSIDERED],
                _M8TileRecords[M8TileMetaIndex(physicalSlot)].z, ignored);
        }
    }
    if (thread < 16u) gM8MeasuredWords[thread] = 0u;
    GroupMemoryBarrierWithGroupSync();
    if (gM8MembraneFailed == 2u) return;

    uint patchBase = M8ScratchPatchBase(local);
    [loop]
    for (uint batch = 0u; batch < 4u; batch++)
    {
        uint kernelLocal = thread + batch * M8_SHELL_GROUP_THREADS;
        uint4 descriptor = 0u;
        uint occupancy = _M8TileBitsRead[M8TileWordIndex(physicalSlot,
            kernelLocal >> 5u)].x;
        if ((occupancy & (1u << (kernelLocal & 31u))) != 0u)
        {
            uint flags = M8LoadKernelFlagsOnly(physicalSlot, kernelLocal);
            if ((flags & MERKABA_OCCUPIED_FLAG) != 0u &&
                M8HasSurfacePlane(flags))
            {
                uint ignored;
                InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_PLANE_VALID],
                    1u, ignored);
                InterlockedOr(gM8MeasuredWords[kernelLocal >> 5u],
                    1u << (kernelLocal & 31u), ignored);
                descriptor = uint4(kernelLocal, flags, 0u, M8_SCRATCH_MEASURED);
            }
        }
        _M8RenderPatchScratch[patchBase + kernelLocal] = descriptor;
    }
    GroupMemoryBarrierWithGroupSync();

    // Compact list in kernelLocal order: prefix over the measured words.
    [loop]
    for (uint batch = 0u; batch < 4u; batch++)
    {
        uint kernelLocal = thread + batch * M8_SHELL_GROUP_THREADS;
        uint wordIndex = kernelLocal >> 5u;
        uint word = gM8MeasuredWords[wordIndex];
        uint bit = 1u << (kernelLocal & 31u);
        if ((word & bit) == 0u) continue;
        uint index = M8PopCount(word & (bit - 1u));
        [unroll]
        for (uint previous = 0u; previous < 16u; previous++)
            index += previous < wordIndex ? M8PopCount(gM8MeasuredWords[previous])
                : 0u;
        uint4 descriptor = _M8RenderPatchScratch[patchBase + kernelLocal];
        descriptor.w = M8_SCRATCH_MEASURED | index;
        _M8RenderPatchScratch[patchBase + kernelLocal] = descriptor;
        gM8MeasuredList[index] = kernelLocal;
    }
    GroupMemoryBarrierWithGroupSync();
    // Four compact entries per uint4, one whole element per thread: no
    // partial element stores, nothing to race.
    uint total = 0u;
    [unroll]
    for (uint wordIndex = 0u; wordIndex < 16u; wordIndex++)
        total += M8PopCount(gM8MeasuredWords[wordIndex]);
    uint entry = thread * 4u;
    if (entry < total)
        _M8RenderPatchScratch[patchBase + M8_RENDER_TILE_KERNELS + thread] =
            uint4(gM8MeasuredList[entry],
                entry + 1u < total ? gM8MeasuredList[entry + 1u] : 0u,
                entry + 2u < total ? gM8MeasuredList[entry + 2u] : 0u,
                entry + 3u < total ? gM8MeasuredList[entry + 3u] : 0u);
    if (thread == 0u)
        _M8RenderScratchHeader[local] = uint4(0u, 0u, 0u, total);
}

// Descriptor after the MAIN prepass:
// x: [0..8] kernelLocal, [9..10] chart, [11..12] side, [13] ready,
//    [14..22] compact measured index, [23] transition along tangent 0,
//    [24] transition along tangent 1.
// After ResolveRenderPatches a valid patch holds its four node ids in
// canonical winding: z = id00 | id10 << 12, y = id11 | id01 << 12, and
// w = M8_SCRATCH_PATCH_VALID | output ordinal.
#define M8_DESCRIPTOR_KERNEL_MASK 0x1ffu
#define M8_DESCRIPTOR_CHART_SHIFT 9u
#define M8_DESCRIPTOR_SIDE_SHIFT 11u
#define M8_DESCRIPTOR_READY 0x2000u
#define M8_DESCRIPTOR_COMPACT_SHIFT 14u
#define M8_DESCRIPTOR_TRANSITION0 0x800000u
#define M8_DESCRIPTOR_TRANSITION1 0x1000000u
// Line use slot: x = height bits, y = valid | side << 1 | (node id + 1) << 4.
#define M8_LINE_USE_VALID 1u
#define M8_LINE_USE_SIDE_SHIFT 1u
#define M8_LINE_USE_NODE_SHIFT 4u
// Node record: x = height bits, y = RGB, z = line task, w = valid |
// referenced | vertex ordinal. Transition record: x = a | b << 12,
// y = c | d << 12, w = valid.
#define M8_NODE_VALID 0x80000000u
#define M8_NODE_REFERENCED 0x40000000u
#define M8_NODE_ORDINAL_MASK 0xfffffu
#define M8_NODE_ID_MASK 0xfffu
// Header z: bit 0 halo not resident (ring invariant), bit 1 capacity,
// nodes << 8. Header w: measured MAINs | transitions << 12.
#define M8_HEADER_UNRESOLVED 1u
#define M8_HEADER_FAILED 2u

int M8DescriptorChart(uint4 descriptor)
{
    return (int)((descriptor.x >> M8_DESCRIPTOR_CHART_SHIFT) & 3u);
}

uint M8DescriptorSide(uint4 descriptor)
{
    return (descriptor.x >> M8_DESCRIPTOR_SIDE_SHIFT) & 3u;
}

bool M8DescriptorReady(uint4 descriptor)
{
    return (descriptor.x & M8_DESCRIPTOR_READY) != 0u;
}

uint M8ScratchLineBase(uint work)
{
    return work * M8_RENDER_SCRATCH_LINE_STRIDE;
}

uint M8ScratchNodeBase(uint work)
{
    return work << M8_RENDER_SCRATCH_NODE_SHIFT;
}

// Line task of chart c with half-lattice indices i0, i1 along the chart's
// tangent axes: half = 2 * (tile origin) + 2 * i - 1, i in 0..8.
uint M8LineTask(int chart, int index0, int index1)
{
    return (uint)chart * 81u + (uint)index0 * 9u + (uint)index1;
}

void M8LineTaskDecode(uint task, out int chart, out int index0,
    out int index1)
{
    uint chartIndex = task >= 162u ? 2u : task >= 81u ? 1u : 0u;
    uint remainder = task - chartIndex * 81u;
    // remainder <= 80: the half-step bias keeps the reciprocal exact.
    uint first = (uint)(((float)remainder + 0.5) * (1.0 / 9.0));
    chart = (int)chartIndex;
    index0 = (int)first;
    index1 = (int)(remainder - first * 9u);
}

// Absolute half-lattice address of a line task (chart component zero).
int3 M8LineHalfAddress(uint task, int3 tileOrigin, out int chart,
    out int tangentAxis0, out int tangentAxis1)
{
    int index0;
    int index1;
    M8LineTaskDecode(task, chart, index0, index1);
    M8MembraneTangentAxes(chart, tangentAxis0, tangentAxis1);
    int3 halfAddress = tileOrigin * 2;
    halfAddress = M8MembraneSetIntComponent(halfAddress, tangentAxis0,
        halfAddress[tangentAxis0] + 2 * index0 - 1);
    halfAddress = M8MembraneSetIntComponent(halfAddress, tangentAxis1,
        halfAddress[tangentAxis1] + 2 * index1 - 1);
    return M8MembraneSetIntComponent(halfAddress, chart, 0);
}

float3 M8NodeRecordPosition(uint4 record, int3 tileOrigin)
{
    int chart;
    int tangentAxis0;
    int tangentAxis1;
    int3 halfAddress = M8LineHalfAddress(record.z & 0xffu, tileOrigin, chart,
        tangentAxis0, tangentAxis1);
    return M8MembraneNodePosition(halfAddress, chart, asfloat(record.x));
}

// The task and use slot holding a cell of the tile's frame on the line
// through the cell's corner (sign0, sign1 in {0, 1} = -half, +half) of
// chart c. The cell's column on that line is (1 - sign0, 1 - sign1).
uint M8CornerLineTask(int3 local, int chart, int tangentAxis0,
    int tangentAxis1, uint sign0, uint sign1)
{
    return M8LineTask(chart, local[tangentAxis0] + (int)sign0,
        local[tangentAxis1] + (int)sign1);
}

uint M8CornerUseSlot(int3 local, int chart, uint sign0, uint sign1)
{
    uint column = (1u - sign0) * 2u + (1u - sign1);
    return column * 16u + (uint)(local[chart] + 4);
}

// Height registers for the up to twelve candidates of one common window
// (slot = column * 3 + layer - window low).
void M8StoreCandidateHeight(inout float4 heights0, inout float4 heights1,
    inout float4 heights2, uint slot, float value)
{
    uint lane = slot & 3u;
    if (slot < 4u)
    {
        if (lane == 0u) heights0.x = value;
        else if (lane == 1u) heights0.y = value;
        else if (lane == 2u) heights0.z = value;
        else heights0.w = value;
    }
    else if (slot < 8u)
    {
        if (lane == 0u) heights1.x = value;
        else if (lane == 1u) heights1.y = value;
        else if (lane == 2u) heights1.z = value;
        else heights1.w = value;
    }
    else
    {
        if (lane == 0u) heights2.x = value;
        else if (lane == 1u) heights2.y = value;
        else if (lane == 2u) heights2.z = value;
        else heights2.w = value;
    }
}

float M8LoadCandidateHeight(float4 heights0, float4 heights1,
    float4 heights2, uint slot)
{
    uint lane = slot & 3u;
    float4 values = slot < 4u ? heights0 : slot < 8u ? heights1 : heights2;
    return lane == 0u ? values.x : lane == 1u ? values.y :
        lane == 2u ? values.z : values.w;
}

bool M8UseBit(uint maskLow, uint maskHigh, uint slot)
{
    // Both select operands are evaluated: keep every shift below 32.
    return slot < 32u ? ((maskLow >> (slot & 31u)) & 1u) != 0u :
        ((maskHigh >> ((slot - 32u) & 31u)) & 1u) != 0u;
}

// C5.2 for one touched line of the solving tile: gather the uses, split
// them into components under R, and give every valid component with a
// member in the tile's layers 0..7 one node. Pure function of the halo
// cache, lane-owned scratch region.
void M8SolveLineTask(uint local, uint task)
{
    int3 tileOrigin = gM8MembraneTileOrigin;
    int chart;
    int tangentAxis0;
    int tangentAxis1;
    int3 halfAddress = M8LineHalfAddress(task, tileOrigin, chart,
        tangentAxis0, tangentAxis1);
    int layerBase = tileOrigin[chart] - 4;
    uint lineBase = M8ScratchLineBase(local) + task * M8_RENDER_LINE_SLOTS;

    // Uses: column * 16 + layer offset, layers -4..11 of the tile.
    uint usesLow = 0u;
    uint usesHigh = 0u;
    [loop]
    for (uint slot = 0u; slot < M8_RENDER_LINE_SLOTS; slot++)
    {
        int layer = layerBase + (int)(slot & 15u);
        int3 cell = M8MembraneColumnCell(halfAddress, chart, tangentAxis0,
            tangentAxis1, slot >> 4u, layer);
        uint4 record = 0u;
        if (M8MembraneMeasuredAt(cell) && M8MembraneChartOf(cell) == chart)
        {
            float height;
            if (M8MembraneLineHeight(M8MembranePlaneOf(cell), chart,
                    halfAddress, height))
            {
                record = uint4(asuint(height), M8_LINE_USE_VALID |
                    (M8MembraneSignature(cell, chart) <<
                        M8_LINE_USE_SIDE_SHIFT), 0u, 0u);
                if (slot < 32u) usesLow |= 1u << slot;
                else usesHigh |= 1u << (slot - 32u);
            }
        }
        _M8RenderLineUseScratch[lineBase + slot] = record;
    }

    uint nodeBase = M8ScratchNodeBase(local);
    uint remainingLow = usesLow;
    uint remainingHigh = usesHigh;
    [loop]
    for (uint component = 0u; component < M8_RENDER_LINE_SLOTS &&
        (remainingLow | remainingHigh) != 0u; component++)
    {
        uint seed = remainingLow != 0u ? (uint)firstbitlow(remainingLow) :
            32u + (uint)firstbitlow(remainingHigh);
        uint side = (_M8RenderLineUseScratch[lineBase + seed].y >>
            M8_LINE_USE_SIDE_SHIFT) & 3u;
        uint memberLow = seed < 32u ? 1u << (seed & 31u) : 0u;
        uint memberHigh = seed < 32u ? 0u : 1u << ((seed - 32u) & 31u);
        uint minOffset = seed & 15u;
        uint maxOffset = minOffset;

        // Closure of R over the uses of this side.
        [loop]
        for (uint sweep = 0u; sweep < M8_RENDER_LINE_SLOTS; sweep++)
        {
            bool grown = false;
            [loop]
            for (uint u = 0u; u < M8_RENDER_LINE_SLOTS; u++)
            {
                if (!M8UseBit(remainingLow, remainingHigh, u) ||
                    M8UseBit(memberLow, memberHigh, u))
                    continue;
                uint4 useU = _M8RenderLineUseScratch[lineBase + u];
                if (((useU.y >> M8_LINE_USE_SIDE_SHIFT) & 3u) != side)
                    continue;
                [loop]
                for (uint v = 0u; v < M8_RENDER_LINE_SLOTS; v++)
                {
                    if (!M8UseBit(memberLow, memberHigh, v)) continue;
                    uint4 useV = _M8RenderLineUseScratch[lineBase + v];
                    if (!M8MembraneRelated(halfAddress, chart, tangentAxis0,
                            tangentAxis1, u >> 4u,
                            layerBase + (int)(u & 15u), asfloat(useU.x),
                            v >> 4u, layerBase + (int)(v & 15u),
                            asfloat(useV.x)))
                        continue;
                    if (u < 32u) memberLow |= 1u << u;
                    else memberHigh |= 1u << (u - 32u);
                    minOffset = min(minOffset, u & 15u);
                    maxOffset = max(maxOffset, u & 15u);
                    grown = true;
                    break;
                }
            }
            if (!grown) break;
        }
        remainingLow &= ~memberLow;
        remainingHigh &= ~memberHigh;

        // Only components with a member in the tile's layers 0..7 (offsets
        // 4..11) give this tile a node.
        if (((memberLow | memberHigh) & 0x0ff00ff0u) == 0u) continue;
        if (maxOffset - minOffset > (uint)M8_MEMBRANE_MAX_LAYER_SPAN)
        {
            uint ignoredInvalid;
            InterlockedAdd(gM8InvalidBranches, 1u, ignoredInvalid);
            continue;
        }
        int minLayer = layerBase + (int)minOffset;
        int maxLayer = layerBase + (int)maxOffset;

        // Reference: median of member heights in (h, L, column) order;
        // member layer presence relative to minLayer.
        uint memberCount = 0u;
        uint layerPresence = 0u;
        [loop]
        for (uint m = 0u; m < M8_RENDER_LINE_SLOTS; m++)
        {
            if (!M8UseBit(memberLow, memberHigh, m)) continue;
            memberCount++;
            layerPresence |= 1u << ((m & 15u) - minOffset);
        }
        uint middle = memberCount >> 1u;
        float medianLow = 0.0;
        float medianHigh = 0.0;
        [loop]
        for (uint a = 0u; a < M8_RENDER_LINE_SLOTS; a++)
        {
            if (!M8UseBit(memberLow, memberHigh, a)) continue;
            float heightA = asfloat(_M8RenderLineUseScratch[lineBase + a].x);
            uint rank = 0u;
            [loop]
            for (uint b = 0u; b < M8_RENDER_LINE_SLOTS; b++)
            {
                if (!M8UseBit(memberLow, memberHigh, b)) continue;
                if (M8MembraneOrderBefore(
                        asfloat(_M8RenderLineUseScratch[lineBase + b].x),
                        layerBase + (int)(b & 15u), b >> 4u, heightA,
                        layerBase + (int)(a & 15u), a >> 4u))
                    rank++;
            }
            if (rank == middle) medianHigh = heightA;
            if (middle > 0u && rank == middle - 1u) medianLow = heightA;
        }
        float reference = (memberCount & 1u) != 0u
            ? medianHigh : (medianLow + medianHigh) * 0.5;

        // Candidates of W = [maxL - 1, minL + 1], column outer, layer inner.
        int windowLow = maxLayer - 1;
        int windowHigh = minLayer + 1;
        float4 heights0 = 0.0;
        float4 heights1 = 0.0;
        float4 heights2 = 0.0;
        uint candidates = 0u;
        [loop]
        for (uint column = 0u; column < 4u; column++)
        [loop]
        for (int layer = windowLow; layer <= windowHigh; layer++)
        {
            uint slot = column * 3u + (uint)(layer - windowLow);
            int nearest = minLayer;
            int nearestDistance = 1000;
            [loop]
            for (uint present = 0u; present < 3u; present++)
            {
                if (((layerPresence >> present) & 1u) == 0u) continue;
                int memberLayer = minLayer + (int)present;
                int distance = abs(memberLayer - layer);
                if (distance < nearestDistance)
                {
                    nearestDistance = distance;
                    nearest = memberLayer;
                }
            }
            float height;
            float3 candidateNormal;
            if (!M8MembraneCandidateHeight(halfAddress, chart, tangentAxis0,
                    tangentAxis1, side, column, layer, nearest, height,
                    candidateNormal))
                continue;
            M8StoreCandidateHeight(heights0, heights1, heights2, slot, height);
            candidates |= 1u << slot;
        }
        if (candidates == 0u) continue;

        // Admission seed: nearest the reference, (h, L, column) on ties.
        uint seedSlot = 0u;
        bool haveSeed = false;
        [loop]
        for (uint c = 0u; c < 12u; c++)
        {
            if (((candidates >> c) & 1u) == 0u) continue;
            float heightC = M8LoadCandidateHeight(heights0, heights1,
                heights2, c);
            float distance = abs(heightC - reference);
            if (haveSeed)
            {
                float seedHeight = M8LoadCandidateHeight(heights0, heights1,
                    heights2, seedSlot);
                float seedDistance = abs(seedHeight - reference);
                uint seedColumn = seedSlot < 3u ? 0u : seedSlot < 6u ? 1u :
                    seedSlot < 9u ? 2u : 3u;
                uint columnC = c < 3u ? 0u : c < 6u ? 1u : c < 9u ? 2u : 3u;
                int seedLayer = windowLow + (int)(seedSlot - seedColumn * 3u);
                int layerC = windowLow + (int)(c - columnC * 3u);
                if (!(distance < seedDistance ||
                      (distance == seedDistance && M8MembraneOrderBefore(
                           heightC, layerC, columnC, seedHeight, seedLayer,
                           seedColumn))))
                    continue;
            }
            seedSlot = c;
            haveSeed = true;
        }
        uint admitted = 1u << seedSlot;
        [loop]
        for (uint growth = 0u; growth < 12u; growth++)
        {
            uint grownMask = admitted;
            [loop]
            for (uint c = 0u; c < 12u; c++)
            {
                if (((candidates >> c) & 1u) == 0u ||
                    ((grownMask >> c) & 1u) != 0u)
                    continue;
                float heightC = M8LoadCandidateHeight(heights0, heights1,
                    heights2, c);
                [loop]
                for (uint o = 0u; o < 12u; o++)
                {
                    if (((admitted >> o) & 1u) == 0u) continue;
                    if (abs(heightC - M8LoadCandidateHeight(heights0,
                            heights1, heights2, o)) <= M8_MEMBRANE_BRANCH_GAP)
                    {
                        grownMask |= 1u << c;
                        break;
                    }
                }
            }
            if (grownMask == admitted) break;
            admitted = grownMask;
        }

        // Winner per column; node = column-order mean.
        float heightSum = 0.0;
        uint accepted = 0u;
        uint red = 0u;
        uint green = 0u;
        uint blue = 0u;
        uint weightTotal = 0u;
        [loop]
        for (uint column = 0u; column < 4u; column++)
        {
            bool haveBest = false;
            float bestDistance = 0.0;
            int bestMemberDistance = 0;
            int bestLayer = 0;
            uint bestSlot = 0u;
            [loop]
            for (int layer = windowLow; layer <= windowHigh; layer++)
            {
                uint slot = column * 3u + (uint)(layer - windowLow);
                if (((admitted >> slot) & 1u) == 0u) continue;
                int memberDistance = 1000;
                [loop]
                for (uint present = 0u; present < 3u; present++)
                {
                    if (((layerPresence >> present) & 1u) == 0u) continue;
                    memberDistance = min(memberDistance,
                        abs(minLayer + (int)present - layer));
                }
                float distance = abs(M8LoadCandidateHeight(heights0,
                    heights1, heights2, slot) - reference);
                if (!M8MembraneWinnerBefore(distance, memberDistance, layer,
                        haveBest, bestDistance, bestMemberDistance,
                        bestLayer))
                    continue;
                haveBest = true;
                bestDistance = distance;
                bestMemberDistance = memberDistance;
                bestLayer = layer;
                bestSlot = slot;
            }
            if (!haveBest) continue;
            heightSum += M8LoadCandidateHeight(heights0, heights1, heights2,
                bestSlot);
            accepted++;
            uint ownerColor;
            uint ownerConfidence;
            M8LoadMembraneColor(M8MembraneColumnCell(halfAddress, chart,
                tangentAxis0, tangentAxis1, column, bestLayer), ownerColor,
                ownerConfidence);
            uint weight = max(1u, ownerConfidence);
            red += (ownerColor & 255u) * weight;
            green += ((ownerColor >> 8u) & 255u) * weight;
            blue += ((ownerColor >> 16u) & 255u) * weight;
            weightTotal += weight;
        }
        if (accepted == 0u) continue;
        float nodeHeight = heightSum / (float)accepted;
        if (!isfinite(nodeHeight)) continue;

        uint nodeId;
        InterlockedAdd(gM8NodeTotal, 1u, nodeId);
        if (nodeId >= M8_RENDER_NODE_CAPACITY)
        {
            uint ignoredFailed;
            InterlockedOr(gM8MembraneFailed, 1u, ignoredFailed);
            continue;
        }
        _M8RenderNodeScratch[nodeBase + nodeId] = uint4(asuint(nodeHeight),
            M8MembranePackMeanColor(red, green, blue, weightTotal), task,
            M8_NODE_VALID);
        [loop]
        for (uint m = 0u; m < M8_RENDER_LINE_SLOTS; m++)
        {
            if (!M8UseBit(memberLow, memberHigh, m)) continue;
            _M8RenderLineUseScratch[lineBase + m].y |=
                (nodeId + 1u) << M8_LINE_USE_NODE_SHIFT;
        }
    }
}

// Kernel 2: halo cache, chart table, MAIN prepass (chart, side, touched
// lines, transition eligibility) and one C5.2 solve per touched line.
[numthreads(64, 1, 1)]
void SolveSharedKnotLines(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint local = groupId.x;
    uint work = M8BatchWork(local);
    // Prologue inline (FXC rejects a barrier after a return inside a
    // helper): identity, context, halo slots, cleared tables.
    uint physicalSlot = _M8VisibleTiles[work].x;
    if (thread == 0u)
    {
        gM8MembraneUnresolved = 0u;
        gM8MembraneFailed = 0u;
        gM8NodeTotal = 0u;
        gM8InvalidBranches = 0u;
        if (M8CurrentRenderIdentity(physicalSlot) == 0u)
            gM8MembraneFailed = 2u;
        else
        {
            M8InitializeReadoutTileContext(physicalSlot);
            M8ReadoutTileContext initContext = M8SharedReadoutTileContext();
            [loop]
            for (uint tile = 0u; tile < M8_MEMBRANE_TILE_COUNT; tile++)
                gM8MembraneTileSlots[tile] = M8ResolveMembraneTile(
                    initContext, M8MembraneTileOffset(tile));
            [loop]
            for (uint word = 0u; word < M8_MEMBRANE_CELL_WORDS; word++)
                gM8MembraneCellBits[word] = 0u;
            [loop]
            for (uint chartWord = 0u; chartWord < M8_MEMBRANE_CHART_WORDS;
                chartWord++)
                gM8MembraneCharts[chartWord] = 0xffffffffu;
            [loop]
            for (uint lineWord = 0u; lineWord < 8u; lineWord++)
                gM8TouchedLines[lineWord] = 0u;
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gM8MembraneFailed == 2u) return;

    // Halo cube: occupancy first, then the flags word of measured cells and
    // the KNOWN FREE classification of empty ones.
    [loop]
    for (uint cacheIndex = thread; cacheIndex < M8_MEMBRANE_CACHE_COUNT;
        cacheIndex += M8_SOLVE_GROUP_THREADS)
    {
        int3 relative;
        uint tileIndex;
        uint kernelLocal;
        M8MembraneCacheAddress(cacheIndex, relative, tileIndex, kernelLocal);
        uint slot = gM8MembraneTileSlots[tileIndex];
        uint flags = 0u;
        uint bits = 0u;
        if (slot == M8_MEMBRANE_TILE_UNRESOLVED)
        {
            uint ignoredUnresolved;
            InterlockedOr(gM8MembraneUnresolved, 1u, ignoredUnresolved);
        }
        else if (slot < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
        {
            uint occupancy = _M8TileBitsRead[M8TileWordIndex(slot,
                kernelLocal >> 5u)].x;
            if ((occupancy & (1u << (kernelLocal & 31u))) != 0u)
            {
                uint kernelFlags = M8LoadKernelFlagsOnly(slot, kernelLocal);
                if ((kernelFlags & MERKABA_OCCUPIED_FLAG) != 0u &&
                    M8HasSurfacePlane(kernelFlags))
                {
                    flags = kernelFlags;
                    bits = 1u;
                }
            }
            else if (M8LoadKernelEvidenceOnly(slot, kernelLocal) <=
                     MERKABA_EXPORT_KNOWN_FREE)
                bits = 2u;
        }
        gM8MembraneFlags[cacheIndex] = flags;
        if (bits != 0u)
        {
            uint ignoredBits;
            InterlockedOr(gM8MembraneCellBits[cacheIndex >> 4u],
                bits << ((cacheIndex & 15u) * 2u), ignoredBits);
        }
    }
    GroupMemoryBarrierWithGroupSync();

    // C5.1 chart table of the tile +-4.
    [loop]
    for (uint chartIndex = thread; chartIndex < M8_MEMBRANE_CHART_COUNT;
        chartIndex += M8_SOLVE_GROUP_THREADS)
    {
        int3 coord = gM8MembraneTileOrigin + int3((int)(chartIndex & 15u),
            (int)((chartIndex >> 4u) & 15u), (int)(chartIndex >> 8u)) -
            M8_MEMBRANE_CHART_HALO;
        if (!M8MembraneMeasuredAt(coord)) continue;
        uint chart = (uint)M8MembraneCanonicalChart(coord);
        uint clear = ((~chart) & 3u) << ((chartIndex & 15u) * 2u);
        uint ignoredChart;
        InterlockedAnd(gM8MembraneCharts[chartIndex >> 4u], ~clear,
            ignoredChart);
    }
    GroupMemoryBarrierWithGroupSync();

    uint4 header = _M8RenderScratchHeader[local];
    uint measuredCount = min(header.w, M8_RENDER_TILE_KERNELS);
    uint patchBase = M8ScratchPatchBase(local);

    // MAIN prepass: chart, side, the four corner lines, and the facing lines
    // of every C5.4 transition neighbour.
    [loop]
    for (uint index = thread; index < measuredCount;
        index += M8_SOLVE_GROUP_THREADS)
    {
        uint kernelLocal = M8ScratchCompactKernel(patchBase, index);
        uint4 descriptor = _M8RenderPatchScratch[patchBase + kernelLocal];
        int3 localCoord = int3(kernelLocal & 7u, (kernelLocal >> 3u) & 7u,
            (kernelLocal >> 6u) & 7u);
        int3 coord = gM8MembraneTileOrigin + localCoord;
        int chart = M8MembraneChartOf(coord);
        if (chart == M8_MEMBRANE_CHART_NONE) continue;
        int tangentAxis0;
        int tangentAxis1;
        M8MembraneTangentAxes(chart, tangentAxis0, tangentAxis1);
        uint side = M8MembraneSignature(coord, chart);
        descriptor.x = kernelLocal |
            ((uint)chart << M8_DESCRIPTOR_CHART_SHIFT) |
            (side << M8_DESCRIPTOR_SIDE_SHIFT) | M8_DESCRIPTOR_READY |
            (index << M8_DESCRIPTOR_COMPACT_SHIFT);
        uint ignoredTouch;
        [loop]
        for (uint corner = 0u; corner < 4u; corner++)
        {
            uint task = M8CornerLineTask(localCoord, chart, tangentAxis0,
                tangentAxis1, corner >> 1u, corner & 1u);
            InterlockedOr(gM8TouchedLines[task >> 5u], 1u << (task & 31u),
                ignoredTouch);
        }
        float4 mainPlane = M8MembranePlaneOf(coord);
        [loop]
        for (uint edge = 0u; edge < 2u; edge++)
        {
            int tangentAxis = edge == 0u ? tangentAxis0 : tangentAxis1;
            int3 neighbour = coord + M8MembraneAxis(tangentAxis);
            if (!M8MembraneMeasuredAt(neighbour)) continue;
            int otherChart = M8MembraneChartOf(neighbour);
            if (otherChart == chart || otherChart == tangentAxis ||
                !M8MembraneTransitionCompatible(coord, mainPlane, neighbour,
                    M8MembranePlaneOf(neighbour)))
                continue;
            descriptor.x |= edge == 0u ? M8_DESCRIPTOR_TRANSITION0 :
                M8_DESCRIPTOR_TRANSITION1;
            int3 neighbourLocal = localCoord + M8MembraneAxis(tangentAxis);
            int otherTangent0;
            int otherTangent1;
            M8MembraneTangentAxes(otherChart, otherTangent0, otherTangent1);
            [loop]
            for (uint along = 0u; along < 2u; along++)
            {
                // Facing lines: half t = 2 n_t - 1, half c = 2 n_c +- 1.
                int indexT = neighbourLocal[tangentAxis];
                int indexC = neighbourLocal[chart] + (int)along;
                uint task = M8LineTask(otherChart,
                    otherTangent0 == tangentAxis ? indexT : indexC,
                    otherTangent1 == tangentAxis ? indexT : indexC);
                InterlockedOr(gM8TouchedLines[task >> 5u],
                    1u << (task & 31u), ignoredTouch);
            }
        }
        _M8RenderPatchScratch[patchBase + kernelLocal] = descriptor;
    }
    AllMemoryBarrierWithGroupSync();

    // One C5.2 solve per touched line task, four passes of 64 lanes.
    [loop]
    for (uint taskPass = 0u; taskPass < 4u; taskPass++)
    {
        uint task = thread + taskPass * M8_SOLVE_GROUP_THREADS;
        if (task >= M8_RENDER_LINE_TASKS) continue;
        if (((gM8TouchedLines[task >> 5u] >> (task & 31u)) & 1u) == 0u)
            continue;
        M8SolveLineTask(local, task);
    }
    AllMemoryBarrierWithGroupSync();

    if (thread != 0u) return;
    uint nodes = min(gM8NodeTotal, M8_RENDER_NODE_CAPACITY);
    header.z = (gM8MembraneUnresolved != 0u ? M8_HEADER_UNRESOLVED : 0u) |
        (gM8MembraneFailed != 0u ? M8_HEADER_FAILED : 0u) | (nodes << 8u);
    _M8RenderScratchHeader[local] = header;
    if (gM8InvalidBranches != 0u)
    {
        uint ignoredCounter;
        InterlockedAdd(_M8Counters[M8_COUNTER_MEMBRANE_INVALID_BRANCH],
            gM8InvalidBranches, ignoredCounter);
    }
}

uint M8UseNodeId(uint lineBase, uint slot)
{
    return (_M8RenderLineUseScratchRead[lineBase + slot].y >>
        M8_LINE_USE_NODE_SHIFT) & 0xfffu;
}

float4 M8DescriptorPlane(uint4 descriptor, int3 coord)
{
    float3 normal;
    float signedOffset;
    M8DecodeSurfacePlane(descriptor.y, normal, signedOffset);
    return float4(normal, dot((float3)coord * MERKABA_LATTICE_STEP, normal) +
        signedOffset);
}

// Measured plane of a cell through the halo tile slots (for the transition
// neighbour, which may lie in a neighbour tile).
float4 M8HaloPlane(int3 coord)
{
    int3 relative = coord - gM8MembraneTileOrigin;
    int3 tileOffset = int3(relative.x < 0 ? -1 : relative.x >= 8 ? 1 : 0,
        relative.y < 0 ? -1 : relative.y >= 8 ? 1 : 0,
        relative.z < 0 ? -1 : relative.z >= 8 ? 1 : 0);
    int3 local = relative - tileOffset * 8;
    uint slot = gM8MembraneTileSlots[M8MembraneTileIndex(tileOffset)];
    uint kernelLocal = (uint)local.x | ((uint)local.y << 3u) |
        ((uint)local.z << 6u);
    float3 normal;
    float signedOffset;
    M8DecodeSurfacePlane(M8LoadKernelFlagsOnly(slot, kernelLocal), normal,
        signedOffset);
    return float4(normal, dot((float3)coord * MERKABA_LATTICE_STEP, normal) +
        signedOffset);
}

// Kernel 3: C5.3 patches and C5.4 transitions from node ids only, then one
// vertex ordinal per referenced node.
[numthreads(64, 1, 1)]
void ResolveRenderPatches(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint local = groupId.x;
    uint work = M8BatchWork(local);
    uint physicalSlot = _M8VisibleTiles[work].x;
    uint4 header = _M8RenderScratchHeader[local];
    if (thread == 0u)
    {
        gM8ScratchValidPatches = 0u;
        gM8ScratchVertexTotal = 0u;
        gM8TransitionTotal = 0u;
        gM8MembraneFailed = 0u;
        if (M8CurrentRenderIdentity(physicalSlot) == 0u ||
            (header.z & (M8_HEADER_UNRESOLVED | M8_HEADER_FAILED)) != 0u)
            gM8MembraneFailed = 2u;
        else
        {
            M8InitializeReadoutTileContext(physicalSlot);
            M8ReadoutTileContext initContext = M8SharedReadoutTileContext();
            [loop]
            for (uint tile = 0u; tile < M8_MEMBRANE_TILE_COUNT; tile++)
                gM8MembraneTileSlots[tile] = M8ResolveMembraneTile(
                    initContext, M8MembraneTileOffset(tile));
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gM8MembraneFailed == 2u) return;

    int3 tileOrigin = gM8MembraneTileOrigin;
    uint measuredCount = min(header.w & 0xfffu, M8_RENDER_TILE_KERNELS);
    uint nodeTotal = min(header.z >> 8u, M8_RENDER_NODE_CAPACITY);
    uint patchBase = M8ScratchPatchBase(local);
    uint lineBase = M8ScratchLineBase(local);
    uint nodeBase = M8ScratchNodeBase(local);
    [loop]
    for (uint index = thread; index < measuredCount;
        index += M8_SOLVE_GROUP_THREADS)
    {
        uint kernelLocal = M8ScratchCompactKernel(patchBase, index);
        uint4 descriptor = _M8RenderPatchScratch[patchBase + kernelLocal];
        if (!M8DescriptorReady(descriptor)) continue;
        int chart = M8DescriptorChart(descriptor);
        int tangentAxis0;
        int tangentAxis1;
        M8MembraneTangentAxes(chart, tangentAxis0, tangentAxis1);
        int3 localCoord = int3(kernelLocal & 7u, (kernelLocal >> 3u) & 7u,
            (kernelLocal >> 6u) & 7u);
        int3 coord = tileOrigin + localCoord;
        float4 mainPlane = M8DescriptorPlane(descriptor, coord);
        uint ignoredReference;

        // C5.3: corners 00, 10, 11, 01 are (sign0, sign1) = (0,0), (1,0),
        // (1,1), (0,1).
        uint id00 = M8UseNodeId(lineBase + M8CornerLineTask(localCoord,
            chart, tangentAxis0, tangentAxis1, 0u, 0u) * M8_RENDER_LINE_SLOTS,
            M8CornerUseSlot(localCoord, chart, 0u, 0u));
        uint id10 = M8UseNodeId(lineBase + M8CornerLineTask(localCoord,
            chart, tangentAxis0, tangentAxis1, 1u, 0u) * M8_RENDER_LINE_SLOTS,
            M8CornerUseSlot(localCoord, chart, 1u, 0u));
        uint id11 = M8UseNodeId(lineBase + M8CornerLineTask(localCoord,
            chart, tangentAxis0, tangentAxis1, 1u, 1u) * M8_RENDER_LINE_SLOTS,
            M8CornerUseSlot(localCoord, chart, 1u, 1u));
        uint id01 = M8UseNodeId(lineBase + M8CornerLineTask(localCoord,
            chart, tangentAxis0, tangentAxis1, 0u, 1u) * M8_RENDER_LINE_SLOTS,
            M8CornerUseSlot(localCoord, chart, 0u, 1u));
        descriptor.w = 0u;
        if (id00 != 0u && id10 != 0u && id11 != 0u && id01 != 0u)
        {
            id00--;
            id10--;
            id11--;
            id01--;
            float3 p00 = M8NodeRecordPosition(
                _M8RenderNodeScratch[nodeBase + id00], tileOrigin);
            float3 p10 = M8NodeRecordPosition(
                _M8RenderNodeScratch[nodeBase + id10], tileOrigin);
            float3 p11 = M8NodeRecordPosition(
                _M8RenderNodeScratch[nodeBase + id11], tileOrigin);
            float3 p01 = M8NodeRecordPosition(
                _M8RenderNodeScratch[nodeBase + id01], tileOrigin);
            if (M8MembranePatchGuards(p00, p10, p11, p01, mainPlane))
            {
                if (dot(cross(p10 - p00, p11 - p00), mainPlane.xyz) < 0.0)
                {
                    uint swap = id10;
                    id10 = id01;
                    id01 = swap;
                }
                uint ordinal;
                InterlockedAdd(gM8ScratchValidPatches, 1u, ordinal);
                descriptor.w = M8_SCRATCH_PATCH_VALID | ordinal;
                descriptor.z = id00 | (id10 << 12u);
                descriptor.y = id11 | (id01 << 12u);
                InterlockedOr(_M8RenderNodeScratch[nodeBase + id00].w,
                    M8_NODE_REFERENCED, ignoredReference);
                InterlockedOr(_M8RenderNodeScratch[nodeBase + id10].w,
                    M8_NODE_REFERENCED, ignoredReference);
                InterlockedOr(_M8RenderNodeScratch[nodeBase + id11].w,
                    M8_NODE_REFERENCED, ignoredReference);
                InterlockedOr(_M8RenderNodeScratch[nodeBase + id01].w,
                    M8_NODE_REFERENCED, ignoredReference);
            }
        }

        // C5.4: the +t edge of MAIN against the -t edge of its neighbour.
        [loop]
        for (uint edge = 0u; edge < 2u; edge++)
        {
            uint eligible = edge == 0u ? M8_DESCRIPTOR_TRANSITION0 :
                M8_DESCRIPTOR_TRANSITION1;
            if ((descriptor.x & eligible) == 0u) continue;
            int tangentAxis = edge == 0u ? tangentAxis0 : tangentAxis1;
            int otherChart = edge == 0u ? tangentAxis1 : tangentAxis0;
            int3 neighbourLocal = localCoord + M8MembraneAxis(tangentAxis);
            int otherTangent0;
            int otherTangent1;
            M8MembraneTangentAxes(otherChart, otherTangent0, otherTangent1);
            // MAIN edge: lines of chart c at half t = 2 m_t + 1 (MAIN column
            // 0 along t), half c' = 2 m_c' -+ 1 (MAIN column 1 - along).
            uint mainIds = 0u;
            uint otherIds = 0u;
            bool complete = true;
            [loop]
            for (uint along = 0u; along < 2u; along++)
            {
                int mainIndexT = localCoord[tangentAxis] + 1;
                int mainIndexO = localCoord[otherChart] + (int)along;
                uint mainTask = M8LineTask(chart,
                    tangentAxis0 == tangentAxis ? mainIndexT : mainIndexO,
                    tangentAxis1 == tangentAxis ? mainIndexT : mainIndexO);
                uint mainColumnT = 0u;
                uint mainColumnO = 1u - along;
                uint mainColumn = tangentAxis0 == tangentAxis
                    ? mainColumnT * 2u + mainColumnO
                    : mainColumnO * 2u + mainColumnT;
                uint mainId = M8UseNodeId(lineBase + mainTask *
                    M8_RENDER_LINE_SLOTS, mainColumn * 16u +
                    (uint)(localCoord[chart] + 4));
                // Neighbour edge: lines of chart c' at half t = 2 n_t - 1
                // (neighbour column 1 along t), half c = 2 n_c -+ 1.
                int otherIndexT = neighbourLocal[tangentAxis];
                int otherIndexC = neighbourLocal[chart] + (int)along;
                uint otherTask = M8LineTask(otherChart,
                    otherTangent0 == tangentAxis ? otherIndexT : otherIndexC,
                    otherTangent1 == tangentAxis ? otherIndexT : otherIndexC);
                uint otherColumnT = 1u;
                uint otherColumnC = 1u - along;
                uint otherColumn = otherTangent0 == tangentAxis
                    ? otherColumnT * 2u + otherColumnC
                    : otherColumnC * 2u + otherColumnT;
                uint otherId = M8UseNodeId(lineBase + otherTask *
                    M8_RENDER_LINE_SLOTS, otherColumn * 16u +
                    (uint)(neighbourLocal[otherChart] + 4));
                if (mainId == 0u || otherId == 0u) complete = false;
                mainIds |= ((mainId - 1u) & M8_NODE_ID_MASK) << (along * 12u);
                otherIds |= ((otherId - 1u) & M8_NODE_ID_MASK) <<
                    (along * 12u);
            }
            if (!complete) continue;
            uint mainLow = mainIds & M8_NODE_ID_MASK;
            uint mainHigh = mainIds >> 12u;
            uint otherLow = otherIds & M8_NODE_ID_MASK;
            uint otherHigh = otherIds >> 12u;
            if (mainLow == mainHigh || mainLow == otherLow ||
                mainLow == otherHigh || mainHigh == otherLow ||
                mainHigh == otherHigh || otherLow == otherHigh)
                continue;
            float3 a = M8NodeRecordPosition(
                _M8RenderNodeScratch[nodeBase + mainLow], tileOrigin);
            float3 b = M8NodeRecordPosition(
                _M8RenderNodeScratch[nodeBase + mainHigh], tileOrigin);
            float3 low = M8NodeRecordPosition(
                _M8RenderNodeScratch[nodeBase + otherLow], tileOrigin);
            float3 high = M8NodeRecordPosition(
                _M8RenderNodeScratch[nodeBase + otherHigh], tileOrigin);
            float4 otherPlane = M8HaloPlane(tileOrigin + neighbourLocal);
            bool matchHigh;
            bool flip;
            if (!M8MembraneTransitionQuad(a, b, low, high,
                    mainPlane.xyz + otherPlane.xyz, tangentAxis, matchHigh,
                    flip))
                continue;
            uint second = mainHigh;
            uint third = matchHigh ? otherHigh : otherLow;
            uint fourth = matchHigh ? otherLow : otherHigh;
            if (flip)
            {
                uint swap = second;
                second = fourth;
                fourth = swap;
            }
            // No flow control on the ticket (FXC: a barrier follows): an
            // overflowing tile writes its last record and fails as a whole.
            uint transition;
            InterlockedAdd(gM8TransitionTotal, 1u, transition);
            _M8RenderNodeScratch[nodeBase + M8_RENDER_NODE_CAPACITY +
                min(transition, M8_RENDER_TRANSITION_CAPACITY - 1u)] =
                uint4(mainLow | (second << 12u),
                third | (fourth << 12u), 0u, M8_NODE_VALID);
            InterlockedOr(_M8RenderNodeScratch[nodeBase + mainLow].w,
                M8_NODE_REFERENCED, ignoredReference);
            InterlockedOr(_M8RenderNodeScratch[nodeBase + mainHigh].w,
                M8_NODE_REFERENCED, ignoredReference);
            InterlockedOr(_M8RenderNodeScratch[nodeBase + otherLow].w,
                M8_NODE_REFERENCED, ignoredReference);
            InterlockedOr(_M8RenderNodeScratch[nodeBase + otherHigh].w,
                M8_NODE_REFERENCED, ignoredReference);
        }
        _M8RenderPatchScratch[patchBase + kernelLocal] = descriptor;
    }
    AllMemoryBarrierWithGroupSync();

    // One vertex ordinal per referenced node.
    [loop]
    for (uint node = thread; node < nodeTotal;
        node += M8_SOLVE_GROUP_THREADS)
    {
        uint state = _M8RenderNodeScratch[nodeBase + node].w;
        if ((state & M8_NODE_REFERENCED) == 0u) continue;
        uint ordinal;
        InterlockedAdd(gM8ScratchVertexTotal, 1u, ordinal);
        _M8RenderNodeScratch[nodeBase + node].w =
            (state & ~M8_NODE_ORDINAL_MASK) | (ordinal & M8_NODE_ORDINAL_MASK);
    }
    AllMemoryBarrierWithGroupSync();

    if (thread != 0u) return;
    uint transitions = min(gM8TransitionTotal, M8_RENDER_TRANSITION_CAPACITY);
    header.x = gM8ScratchValidPatches;
    header.y = gM8ScratchVertexTotal;
    header.z |= gM8TransitionTotal > M8_RENDER_TRANSITION_CAPACITY
        ? M8_HEADER_FAILED : 0u;
    header.w = measuredCount | (transitions << 12u);
    _M8RenderScratchHeader[local] = header;
}

void M8WriteQuadIndices(uint outputQuad, uint a, uint b, uint c, uint d)
{
    uint indexBase = outputQuad * M8_MEMBRANE_INDICES_PER_PATCH;
    _M8RenderIndices[M8MembraneIndexSlot(indexBase + 0u)] = a;
    _M8RenderIndices[M8MembraneIndexSlot(indexBase + 1u)] = b;
    _M8RenderIndices[M8MembraneIndexSlot(indexBase + 2u)] = c;
    _M8RenderIndices[M8MembraneIndexSlot(indexBase + 3u)] = a;
    _M8RenderIndices[M8MembraneIndexSlot(indexBase + 4u)] = c;
    _M8RenderIndices[M8MembraneIndexSlot(indexBase + 5u)] = d;
}

// Vertex slot of a node id, or 0xffffffff when the node carries no valid
// ordinal below the tile's vertex total.
uint M8NodeVertexSlot(uint nodeBase, uint id, uint vertexTotal)
{
    uint state = _M8RenderNodeScratchRead[nodeBase + id].w;
    uint ordinal = state & M8_NODE_ORDINAL_MASK;
    if ((state & M8_NODE_REFERENCED) == 0u || ordinal >= vertexTotal)
        return 0xffffffffu;
    return M8MembraneVertexSlot(ordinal);
}

// Kernel 4: pages, one vertex per referenced node, six indices per valid
// patch and per transition, record with index-count delta.
[numthreads(128, 1, 1)]
void EmitRenderTileGeometry(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint local = groupId.x;
    uint work = M8BatchWork(local);
    uint physicalSlot = _M8VisibleTiles[work].x;
    uint4 header = _M8RenderScratchHeaderRead[local];
    uint patchTotal = header.x;
    uint vertexTotal = header.y;
    uint transitionTotal = min(header.w >> 12u, M8_RENDER_TRANSITION_CAPACITY);
    if (thread == 0u)
    {
        gM8MembraneMeasuredTotal = header.w & 0xfffu;
        gM8MembranePageCount = 0u;
        gM8MembranePatchTotal = patchTotal + transitionTotal;
        gM8MembraneCanEmit = 0u;
        gM8MembraneFailed = 0u;
        gM8MembraneUnresolved = header.z & M8_HEADER_UNRESOLVED;
        if (M8CurrentRenderIdentity(physicalSlot) == 0u)
            gM8MembraneFailed = 2u;
        else
        {
            M8InitializeReadoutTileContext(physicalSlot);
            if ((header.z & M8_HEADER_FAILED) != 0u)
                gM8MembraneFailed = 1u;
            uint indexTotal = gM8MembranePatchTotal *
                M8_MEMBRANE_INDICES_PER_PATCH;
            uint vertexPages = (vertexTotal + M8_RENDER_PAGE_VERTICES - 1u) >>
                M8_RENDER_PAGE_VERTEX_SHIFT;
            uint indexPages = (indexTotal + M8_RENDER_PAGE_INDICES - 1u) >>
                M8_RENDER_PAGE_INDEX_SHIFT;
            if (gM8MembraneUnresolved == 0u && gM8MembraneFailed == 0u &&
                indexTotal != 0u)
            {
                if (M8TakeRenderPages(max(vertexPages, indexPages)))
                    gM8MembraneCanEmit = 1u;
                else
                {
                    gM8MembraneFailed = 1u;
                    _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 1u;
                }
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gM8MembraneFailed == 2u) return;

    int3 tileOrigin = gM8MembraneTileOrigin;
    uint patchBase = M8ScratchPatchBase(local);
    uint nodeBase = M8ScratchNodeBase(local);
    uint nodeTotal = min(header.z >> 8u, M8_RENDER_NODE_CAPACITY);
    if (gM8MembraneCanEmit != 0u)
    {
        // One vertex per referenced node, straight from its record.
        [loop]
        for (uint node = thread; node < nodeTotal;
            node += M8_SHELL_GROUP_THREADS)
        {
            uint4 record = _M8RenderNodeScratchRead[nodeBase + node];
            if ((record.w & M8_NODE_REFERENCED) == 0u) continue;
            uint ordinal = record.w & M8_NODE_ORDINAL_MASK;
            if (ordinal >= vertexTotal)
            {
                uint ignoredReason;
                InterlockedOr(_M8Counters[M8_COUNTER_RENDER_PUBLICATION_INVALID],
                    1u, ignoredReason);
                continue;
            }
            M8StoreRenderVertex(M8MembraneVertexSlot(ordinal),
                M8NodeRecordPosition(record, tileOrigin), record.y);
        }
        // Six indices per valid patch, in its canonical corner order.
        [loop]
        for (uint kernelLocal = thread; kernelLocal < M8_RENDER_TILE_KERNELS;
            kernelLocal += M8_SHELL_GROUP_THREADS)
        {
            uint4 descriptor = _M8RenderPatchScratchRead[patchBase +
                kernelLocal];
            if ((descriptor.w & M8_SCRATCH_PATCH_VALID) == 0u) continue;
            uint outputPatch = descriptor.w & ~M8_SCRATCH_PATCH_VALID;
            uint a = M8NodeVertexSlot(nodeBase, descriptor.z & M8_NODE_ID_MASK,
                vertexTotal);
            uint b = M8NodeVertexSlot(nodeBase, descriptor.z >> 12u,
                vertexTotal);
            uint c = M8NodeVertexSlot(nodeBase, descriptor.y & M8_NODE_ID_MASK,
                vertexTotal);
            uint d = M8NodeVertexSlot(nodeBase, descriptor.y >> 12u,
                vertexTotal);
            if (outputPatch >= patchTotal || a == 0xffffffffu ||
                b == 0xffffffffu || c == 0xffffffffu || d == 0xffffffffu)
            {
                uint ignoredReason;
                InterlockedOr(_M8Counters[M8_COUNTER_RENDER_PUBLICATION_INVALID],
                    2u, ignoredReason);
                continue;
            }
            M8WriteQuadIndices(outputPatch, a, b, c, d);
        }
        // Six indices per chart transition, after all patches.
        [loop]
        for (uint transition = thread; transition < transitionTotal;
            transition += M8_SHELL_GROUP_THREADS)
        {
            uint4 record = _M8RenderNodeScratchRead[nodeBase +
                M8_RENDER_NODE_CAPACITY + transition];
            if ((record.w & M8_NODE_VALID) == 0u) continue;
            uint a = M8NodeVertexSlot(nodeBase, record.x & M8_NODE_ID_MASK,
                vertexTotal);
            uint b = M8NodeVertexSlot(nodeBase, record.x >> 12u, vertexTotal);
            uint c = M8NodeVertexSlot(nodeBase, record.y & M8_NODE_ID_MASK,
                vertexTotal);
            uint d = M8NodeVertexSlot(nodeBase, record.y >> 12u, vertexTotal);
            if (a == 0xffffffffu || b == 0xffffffffu || c == 0xffffffffu ||
                d == 0xffffffffu)
            {
                uint ignoredReason;
                InterlockedOr(_M8Counters[M8_COUNTER_RENDER_PUBLICATION_INVALID],
                    4u, ignoredReason);
                continue;
            }
            M8WriteQuadIndices(patchTotal + transition, a, b, c, d);
        }
    }
    GroupMemoryBarrierWithGroupSync();

    if (thread != 0u) return;
    uint4 meta = _M8TileRecords[M8TileMetaIndex(physicalSlot)];
    uint occupiedCount = meta.z;
    uint legacyCount = occupiedCount > gM8MembraneMeasuredTotal
        ? occupiedCount - gM8MembraneMeasuredTotal : 0u;
    uint ignoredCount;
    InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_PLANE_LEGACY_INVALID],
        legacyCount, ignoredCount);
    uint base = M8RecordBase(physicalSlot);
    if (gM8MembraneUnresolved != 0u)
    {
        // Ring invariant breach (the traversal listed only tiles with a
        // resident ring): the tile fails closed, no record, no wait. Its
        // cleared identity rebuilds it on the next transaction.
        M8DiscardTilePages();
        M8ClearDepartedRecord(work, physicalSlot);
        M8CounterIncrement(M8_COUNTER_READOUT_RING_INVARIANT);
        return;
    }
    if (gM8MembraneFailed != 0u)
    {
        // BACK keeps this tile's previous record; a capacity failure is
        // rebuilt by the next transaction.
        M8DiscardTilePages();
        M8RenderJournalQueueDirty(physicalSlot, 0u);
        M8CounterIncrement(M8_COUNTER_RENDER_CAPACITY_FAILED);
        return;
    }

    uint indexTotal = gM8MembranePatchTotal * M8_MEMBRANE_INDICES_PER_PATCH;
    // The publication total follows the record by delta, never by recount.
    InterlockedAdd(_M8RenderIndexBack[1],
        indexTotal + (~_M8RenderIndexBack[base + 0u] + 1u), ignoredCount);
    M8RetireBackRecordPages(base);
    // Record 0 is the published index count of this tile.
    _M8RenderIndexBack[base + 0u] = indexTotal;
    _M8RenderIndexBack[base + 1u] = gM8MembranePageCount;
    _M8RenderIndexBack[base + 2u] =
        meta.x * MERKABA_M8_TILES_PER_CHUNK + meta.y + 1u;
    _M8RenderIndexBack[base + 3u] = asuint(gM8MembraneTileOrigin.x);
    _M8RenderIndexBack[base + 4u] = asuint(gM8MembraneTileOrigin.y);
    _M8RenderIndexBack[base + 5u] = asuint(gM8MembraneTileOrigin.z);
    _M8RenderIndexBack[base + M8_RENDER_RECORD_FIRST_PAGE] =
        gM8MembranePageCount != 0u ? M8TilePage(0u) :
            M8_RENDER_PAGE_INVALID;
    _M8RenderIndexBack[base + M8_RENDER_RECORD_VERSION] =
        _M8RenderVersionsRead[physicalSlot];
    InterlockedAnd(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
        ~(M8_RENDER_DIRTY | M8_RENDER_DEPENDENCY_MASK), ignoredCount);
    _M8VisibleTiles[work].y = 1u;
    InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_EMITTED_PATCHES],
        gM8MembranePatchTotal, ignoredCount);
    InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_EMITTED_VERTICES],
        vertexTotal, ignoredCount);
}

[numthreads(1, 1, 1)]
void PublishRenderTileList(uint id : SV_DispatchThreadID)
{
    uint tiles = min(_M8RenderIndexBack[0],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    _M8RenderIndexBack[0] = tiles;
    // _M8RenderIndexBack[1] (published indices) is kept by delta.
    _M8FrameDispatchArgs[0] = max(1u, (tiles + 127u) >> 7u);
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
}

// Every record this transaction rebuilt is checked before BACK can become
// FRONT: identity, chain of exactly the recorded length inside the page
// pool, every page owned by this record, index count a whole number of
// patches inside the chain. Unchanged records were validated when they were
// written and their pages are immutable until the record is replaced;
// index ranges were checked fail-closed by the emitting kernel. One
// violation keeps the whole transaction from publishing.
[numthreads(128, 1, 1)]
void ValidatePublication(uint id : SV_DispatchThreadID)
{
    uint tiles = min(_M8Counters[M8_COUNTER_RENDER_REBUILD_TILES],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    if (id >= tiles) return;
    uint2 entry = _M8VisibleTilesRead[id];
    if (entry.y == 0u) return;
    uint physicalSlot = entry.x;
    bool valid = physicalSlot < MERKABA_M8_PHYSICAL_TILE_CAPACITY;
    if (valid)
    {
        uint base = M8RecordBase(physicalSlot);
        uint indexCount = _M8RenderIndexBack[base + 0u];
        uint pages = _M8RenderIndexBack[base + 1u];
        valid = pages <= M8_RENDER_TILE_MAX_PAGES &&
            indexCount <= pages * M8_RENDER_PAGE_INDICES &&
            (indexCount % M8_MEMBRANE_INDICES_PER_PATCH) == 0u &&
            (_M8RenderIndexBack[base + 2u] != 0u || pages == 0u);
        uint reason = valid ? 0u : 8u;
        uint page = _M8RenderIndexBack[base + M8_RENDER_RECORD_FIRST_PAGE];
        [loop]
        for (uint ordinal = 0u; valid && ordinal < pages; ordinal++)
        {
            if (page >= M8_RENDER_PAGE_CAPACITY)
            {
                valid = false;
                reason = 16u;
                break;
            }
            if (_M8RenderPageQueues[M8_RENDER_OWNER_BASE + page] !=
                physicalSlot + 1u)
            {
                valid = false;
                reason = 32u;
                break;
            }
            page = _M8RenderPageQueues[M8_RENDER_LINK_BASE + page];
        }
        if (valid && page != M8_RENDER_PAGE_INVALID)
        {
            valid = false;
            reason = 64u;
        }
        if (!valid)
        {
            uint ignoredReason;
            InterlockedOr(_M8Counters[M8_COUNTER_RENDER_PUBLICATION_INVALID],
                reason, ignoredReason);
        }
        return;
    }
    // A listed slot outside the physical range.
    uint ignoredRange;
    InterlockedOr(_M8Counters[M8_COUNTER_RENDER_PUBLICATION_INVALID], 128u,
        ignoredRange);
}

[numthreads(1, 1, 1)]
void FinalizeReadout(uint id : SV_DispatchThreadID)
{
    uint tiles = _M8RenderIndexBack[0];
    uint indices = _M8RenderIndexBack[1];
    _M8Counters[M8_COUNTER_RENDER_PUBLISHED_TILES] = tiles;
    // The publication counts indices; report patches and triangles.
    uint publishedPatches = indices / M8_MEMBRANE_INDICES_PER_PATCH;
    uint publishedTriangles = indices / 3u;
    _M8Counters[M8_COUNTER_RENDER_PUBLISHED_PATCHES] = publishedPatches;
    _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES] = publishedTriangles;
    _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES] =
        _M8Counters[M8_COUNTER_READOUT_EMITTED_PATCHES] *
        M8_MEMBRANE_TRIANGLES_PER_PATCH;
    uint dirtyHead = _M8Counters[M8_COUNTER_RENDER_JOURNAL_HEAD];
    uint dirtyTail = _M8Counters[M8_COUNTER_RENDER_JOURNAL_TAIL];
    uint backlog = dirtyTail != dirtyHead ||
        _M8Counters[M8_COUNTER_RENDER_JOURNAL_OVERFLOW] != 0u ||
        _M8Counters[M8_COUNTER_RENDER_VIEW_OVERFLOW] != 0u
        ? 0x80000000u : 0u;
    // Tiles of the coverage sphere not drawn yet (not resident, or ring not
    // resident). Diagnostic and load-readiness only, never a failure.
    uint coldInCoverage = min(0x7fffffffu,
        _M8Counters[M8_COUNTER_READOUT_COLD_IN_COVERAGE]);
    // A build that could not place every selected tile publishes nothing:
    // FRONT stays and the next transaction rebuilds.
    bool failed = _M8Counters[M8_COUNTER_RENDER_CAPACITY_FAILED] != 0u ||
        _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] != 0u ||
        _M8Counters[M8_COUNTER_RENDER_VIEW_OVERFLOW] != 0u ||
        _M8Counters[M8_COUNTER_RENDER_PUBLICATION_INVALID] != 0u;
    if (_M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] ==
            MERKABA_READOUT_BUILDING)
        _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] = failed
            ? MERKABA_READOUT_FAILED : MERKABA_READOUT_PUBLISHED;
    // The CPU publication decision reads only this record. Counters remain
    // diagnostics that a later scanner job may reset.
    _M8AttemptCompletion[1] = uint4(_M8ReadoutRevision,
        _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS], tiles,
        backlog | coldInCoverage);
}
