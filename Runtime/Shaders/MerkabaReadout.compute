#pragma kernel ResetReadoutBuild
#pragma kernel QueryM8Readout
#pragma kernel PrepareReadoutBuild
#pragma kernel PreflightReadout
#pragma kernel PrepareReadoutEmit
#pragma kernel EmitReadoutVertices
#pragma kernel FinalizeReadout

#include "MerkabaWorld.hlsl"

#define MERKABA_LATTICE_STEP 0.025
#define MERKABA_HALF_SUPPORT 0.025
#define MERKABA_OCCUPIED_FLAG 1u
#define M8_READOUT_VERTICES_PER_TRIANGLE 3u

struct MerkabaReadoutVertex
{
    float3 gridPosition;
    uint packedColor;
};

RWStructuredBuffer<uint2> _M8VisibleTiles;
StructuredBuffer<uint2> _M8VisibleTilesRead;
RWStructuredBuffer<MerkabaReadoutVertex> _M8ReadoutVertices0;
RWStructuredBuffer<MerkabaReadoutVertex> _M8ReadoutVertices1;
RWStructuredBuffer<uint> _M8FrameDispatchArgs;
RWStructuredBuffer<uint> _M8DrawArgs;

float3 _M8CameraGridMeters;
float3 _M8GridMetricDiagonal;
float3 _M8GridMetricCross;
float _M8RenderDistance;
float _M8WarmDistance;
float _M8DependencyDistance;
int3 _M8QueryCenterBlock;
int _M8QueryBlockRadius;
int _M8QueryBlockSide;

bool M8AabbIntersectsDistance(int3 globalMin, int span, float distance)
{
    return MerkabaM8GridAabbIntersectsDistance(globalMin, span, distance,
        _M8CameraGridMeters, _M8GridMetricDiagonal, _M8GridMetricCross,
        MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
}

uint M8DistanceChildMask(int3 parentMin, int parentSpan, float distance)
{
    return MerkabaM8GridDistanceChildMask(parentMin, parentSpan, distance,
        _M8CameraGridMeters, _M8GridMetricDiagonal, _M8GridMetricCross,
        MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
}

uint M8DrawChildMask(int3 parentMin, int parentSpan)
{
    return M8DistanceChildMask(parentMin, parentSpan, _M8RenderDistance);
}

uint M8DependencyChildMask(int3 parentMin, int parentSpan)
{
    return M8DistanceChildMask(parentMin, parentSpan,
        _M8DependencyDistance);
}

void M8RequestWarmLoad(uint tileRefIndex, uint chunkIndex, uint tileLocal,
    bool lateDraw)
{
    M8QueueColdTileLoad(tileRefIndex, chunkIndex, tileLocal);
    if (lateDraw) M8CounterIncrement(M8_COUNTER_LATE_DRAW_COLD_MISSES);
}

[numthreads(1, 1, 1)]
void ResetReadoutBuild(uint id : SV_DispatchThreadID)
{
    _M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT] = 0u;
    _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES] = 0u;
    _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 0u;
    _M8Counters[M8_COUNTER_LATE_DRAW_COLD_MISSES] = 0u;
    _M8Counters[M8_COUNTER_CANDIDATE_BLOCKS] = 0u;
    _M8Counters[M8_COUNTER_HASH_HIT_BLOCKS] = 0u;
    _M8Counters[M8_COUNTER_VISIBLE_CHUNKS] = 0u;
    _M8Counters[M8_COUNTER_OCCUPIED_CONSIDERED] = 0u;
    _M8Counters[M8_COUNTER_READOUT_PLANE_VALID] = 0u;
    _M8Counters[M8_COUNTER_READOUT_EMITTED_PATCHES] = 0u;
    _M8Counters[M8_COUNTER_READOUT_UNRESOLVED] = 0u;
    _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES] = 0u;
    _M8Counters[M8_COUNTER_READOUT_PLANE_LEGACY_INVALID] = 0u;
    _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
        MERKABA_READOUT_BUILDING;
    _M8Counters[M8_COUNTER_FRAME_EPOCH] += 1u;
    _M8FrameDispatchArgs[0] = 0u;
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
}

groupshared uint gFrameBlockRef;
groupshared int3 gFrameBlockMin;
groupshared uint gFrameWarm4;
groupshared uint gFrameDraw4;
groupshared uint gFrameDependency4;
groupshared uint gFrameWarm3[8];
groupshared uint gFrameDraw3[8];
groupshared uint gFrameDependency3[8];

[numthreads(64, 1, 1)]
void QueryM8Readout(uint3 groupId : SV_GroupID, uint thread : SV_GroupIndex)
{
    uint linearBlockIndex = groupId.x;
    if (thread == 0u)
    {
        gFrameBlockRef = 0u;
        gFrameWarm4 = 0u;
        gFrameDraw4 = 0u;
        gFrameDependency4 = 0u;
        uint side = (uint)_M8QueryBlockSide;
        if (linearBlockIndex < side * side * side)
        {
            int3 offset;
            offset.x = (int)(linearBlockIndex % side) - _M8QueryBlockRadius;
            offset.y = (int)((linearBlockIndex / side) % side) -
                _M8QueryBlockRadius;
            offset.z = (int)(linearBlockIndex / (side * side)) -
                _M8QueryBlockRadius;
            int3 blockCoord = _M8QueryCenterBlock + offset;
            gFrameBlockMin = blockCoord * MERKABA_M8_BLOCK_KERNEL_SPAN;
            M8CounterIncrement(M8_COUNTER_CANDIDATE_BLOCKS);
            if (M8AabbIntersectsDistance(gFrameBlockMin,
                MERKABA_M8_BLOCK_KERNEL_SPAN, _M8WarmDistance))
            {
                uint blockIndex = 0u;
                if (M8FindBlock(blockCoord, blockIndex))
                {
                    gFrameBlockRef = blockIndex + 1u;
                    gFrameWarm4 = M8DistanceChildMask(gFrameBlockMin, 256,
                        _M8WarmDistance);
                    gFrameDraw4 = M8DrawChildMask(gFrameBlockMin, 256);
                    gFrameDependency4 = M8DependencyChildMask(
                        gFrameBlockMin, 256);
                    M8CounterIncrement(M8_COUNTER_HASH_HIT_BLOCKS);
                }
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (thread < 8u)
    {
        uint d4ForMask = thread;
        gFrameWarm3[d4ForMask] = 0u;
        gFrameDraw3[d4ForMask] = 0u;
        gFrameDependency3[d4ForMask] = 0u;
        if (gFrameBlockRef != 0u)
        {
            uint maskBlockIndex = gFrameBlockRef - 1u;
            if (((_M8BlockPresenceL0Read[maskBlockIndex] & gFrameWarm4) &
                (1u << d4ForMask)) != 0u)
            {
                int3 min4ForMask = gFrameBlockMin +
                    MerkabaM8OctantOffset(d4ForMask, 128);
                gFrameWarm3[d4ForMask] = M8DistanceChildMask(min4ForMask, 128,
                    _M8WarmDistance);
                gFrameDraw3[d4ForMask] =
                    ((gFrameDraw4 >> d4ForMask) & 1u) != 0u
                    ? M8DrawChildMask(min4ForMask, 128) : 0u;
                gFrameDependency3[d4ForMask] =
                    ((gFrameDependency4 >> d4ForMask) & 1u) != 0u
                    ? M8DependencyChildMask(min4ForMask, 128) : 0u;
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gFrameBlockRef == 0u) return;

    uint blockIndex = gFrameBlockRef - 1u;
    int3 blockMin = gFrameBlockMin;
    uint d4 = thread >> 3u;
    uint d3 = thread & 7u;
    if (((gFrameWarm4 >> d4) & 1u) == 0u ||
        (((_M8BlockPresenceL1Read[blockIndex * 8u + d4] &
        gFrameWarm3[d4]) >> d3) & 1u) == 0u) return;

    int3 min4 = blockMin + MerkabaM8OctantOffset(d4, 128);
    int3 min3 = min4 + MerkabaM8OctantOffset(d3, 64);
    uint warm2 = M8DistanceChildMask(min3, 64, _M8WarmDistance);
    bool drawPath3 = ((gFrameDraw4 >> d4) & 1u) != 0u &&
        ((gFrameDraw3[d4] >> d3) & 1u) != 0u;
    bool dependencyPath3 = ((gFrameDependency4 >> d4) & 1u) != 0u &&
        ((gFrameDependency3[d4] >> d3) & 1u) != 0u;
    uint draw2 = drawPath3 ? M8DrawChildMask(min3, 64) : 0u;
    uint dependency2 = dependencyPath3
        ? M8DependencyChildMask(min3, 64) : 0u;
    uint support2 = (_M8BlockPresenceL2Read[blockIndex * 64u +
        d4 * 8u + d3] & 255u) & warm2;
    while (support2 != 0u)
    {
        uint d2 = (uint)firstbitlow(support2);
        support2 &= support2 - 1u;
        uint chunkLocal = (d4 << 6u) | (d3 << 3u) | d2;
        uint chunkRef = _M8BlockChunkRefsRead[blockIndex * 512u + chunkLocal];
        if (chunkRef == 0u || chunkRef >= MERKABA_REF_EVICTING) continue;
        uint chunkIndex = chunkRef - 1u;
        int3 min2 = min3 + MerkabaM8OctantOffset(d2, 32);
        uint warm1 = M8DistanceChildMask(min2, 32, _M8WarmDistance);
        bool drawPath2 = drawPath3 && ((draw2 >> d2) & 1u) != 0u;
        bool dependencyPath2 = dependencyPath3 &&
            ((dependency2 >> d2) & 1u) != 0u;
        uint draw1 = drawPath2 ? M8DrawChildMask(min2, 32) : 0u;
        uint dependency1 = dependencyPath2
            ? M8DependencyChildMask(min2, 32) : 0u;
        uint support1 =
            (_M8ChunkPresenceRead[M8ChunkPresenceL0Index(chunkIndex)] &
            255u) & warm1;
        bool visibleChunk = false;
        while (support1 != 0u)
        {
            uint d1 = (uint)firstbitlow(support1);
            support1 &= support1 - 1u;
            int3 min1 = min2 + MerkabaM8OctantOffset(d1, 16);
            uint warm0 = M8DistanceChildMask(min1, 16, _M8WarmDistance);
            bool drawPath1 = drawPath2 && ((draw1 >> d1) & 1u) != 0u;
            bool dependencyPath1 = dependencyPath2 &&
                ((dependency1 >> d1) & 1u) != 0u;
            uint draw0 = drawPath1 ? M8DrawChildMask(min1, 16) : 0u;
            uint dependency0 = dependencyPath1
                ? M8DependencyChildMask(min1, 16) : 0u;
            uint support0 =
                (_M8ChunkPresenceRead[
                    M8ChunkPresenceL1Index(chunkIndex, d1)] & 255u) & warm0;
            while (support0 != 0u)
            {
                uint d0 = (uint)firstbitlow(support0);
                support0 &= support0 - 1u;
                uint tileLocal = (d1 << 3u) | d0;
                uint tileRefIndex = chunkIndex * 64u + tileLocal;
                uint tileRef = _M8ChunkTileRefs[tileRefIndex];
                bool inDraw = drawPath1 && ((draw0 >> d0) & 1u) != 0u;
                bool inDependency = dependencyPath1 &&
                    ((dependency0 >> d0) & 1u) != 0u;
                if (tileRef == MERKABA_REF_COLD_ON_SSD)
                {
                    M8RequestWarmLoad(tileRefIndex, chunkIndex, tileLocal,
                        inDraw);
                    if (inDependency)
                        M8CounterIncrement(M8_COUNTER_READOUT_UNRESOLVED);
                    continue;
                }
                if (!M8IsHotRef(tileRef))
                {
                    if (inDraw)
                        M8CounterIncrement(M8_COUNTER_LATE_DRAW_COLD_MISSES);
                    if (inDependency)
                        M8CounterIncrement(M8_COUNTER_READOUT_UNRESOLVED);
                    continue;
                }
                uint physicalSlot = M8PhysicalSlot(tileRef);
                _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].z =
                    _M8Counters[M8_COUNTER_FRAME_EPOCH];
                if (!inDraw ||
                    _M8TileRecords[M8TileMetaIndex(physicalSlot)].z == 0u)
                    continue;
                uint visibleIndex;
                InterlockedAdd(_M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT],
                    1u, visibleIndex);
                if (visibleIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                    _M8VisibleTiles[visibleIndex] = uint2(physicalSlot, 0u);
                visibleChunk = true;
            }
        }
        if (visibleChunk) M8CounterIncrement(M8_COUNTER_VISIBLE_CHUNKS);
    }
}

[numthreads(1, 1, 1)]
void PrepareReadoutBuild(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_READOUT_UNRESOLVED] != 0u)
    {
        _M8FrameDispatchArgs[0] = 0u;
        _M8FrameDispatchArgs[1] = 1u;
        _M8FrameDispatchArgs[2] = 1u;
        _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
            MERKABA_READOUT_SKIPPED;
        return;
    }
    _M8FrameDispatchArgs[0] = min(
        _M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
}

#define M8_SHELL_GROUP_THREADS 128u
#define M8_SHELL_MAIN_COUNT 512u

groupshared uint gM8ShellPatchValidWords[MERKABA_M8_TILE_WORDS];
groupshared uint gM8ShellPatchPrefixes[MERKABA_M8_TILE_WORDS];
groupshared uint gM8ShellOccupiedWords[MERKABA_M8_TILE_WORDS];
groupshared uint gM8ShellPhysicalSlot;
groupshared uint gM8ShellOccupiedCount;
groupshared uint gM8ShellValidPatchCount;
groupshared int3 gM8ShellTileOrigin;

#include "MerkabaOverlapShell.generated.hlsl"

uint M8PatchPrefix(uint kernelLocal)
{
    uint wordIndex = kernelLocal >> 5u;
    uint bitIndex = kernelLocal & 31u;
    uint belowMask = bitIndex == 0u ? 0u : ((1u << bitIndex) - 1u);
    return gM8ShellPatchPrefixes[wordIndex] + countbits(
        gM8ShellPatchValidWords[wordIndex] & belowMask);
}

void M8StoreReadoutVertex(uint outputTriangle, uint corner,
    float3 gridPosition, uint packedColor)
{
    uint outputVertex = outputTriangle * M8_READOUT_VERTICES_PER_TRIANGLE;
    bool secondBuffer = outputTriangle >=
        MERKABA_M8_READOUT_TRIANGLES_PER_BUFFER;
    if (secondBuffer)
        outputVertex -= MERKABA_M8_READOUT_VERTICES_PER_BUFFER;
    MerkabaReadoutVertex vertex;
    vertex.gridPosition = gridPosition;
    vertex.packedColor = packedColor;
    if (secondBuffer)
        _M8ReadoutVertices1[outputVertex + corner] = vertex;
    else
        _M8ReadoutVertices0[outputVertex + corner] = vertex;
}

void M8LoadMainTile(uint physicalSlot, uint thread)
{
    if (thread < MERKABA_M8_TILE_WORDS)
        gM8ShellOccupiedWords[thread] = _M8TileBitsRead[
            M8TileWordIndex(physicalSlot, thread)].x;
    if (thread == 0u)
    {
        gM8ShellPhysicalSlot = physicalSlot;
        uint4 tileMeta = M8LoadTileMetaRead(physicalSlot);
        gM8ShellOccupiedCount = tileMeta.z;
        gM8ShellTileOrigin =
            M8GlobalKernelCoordRead(physicalSlot, 0u);
    }
    GroupMemoryBarrierWithGroupSync();
}

void M8ResolveOverlapPatchMask(uint thread)
{
    if (thread < MERKABA_M8_TILE_WORDS)
    {
        gM8ShellPatchValidWords[thread] = 0u;
        gM8ShellPatchPrefixes[thread] = 0u;
    }
    if (thread == 0u) gM8ShellValidPatchCount = 0u;
    GroupMemoryBarrierWithGroupSync();

    [loop]
    for (uint batch = 0u; batch < 4u; batch++)
    {
        uint kernelLocal = thread + batch * M8_SHELL_GROUP_THREADS;
        uint word = kernelLocal >> 5u;
        uint bit = 1u << (kernelLocal & 31u);
        if ((gM8ShellOccupiedWords[word] & bit) == 0u)
            continue;
        KernelState state = M8LoadKernelStateRead(gM8ShellPhysicalSlot,
            kernelLocal);
        if ((state.flags & MERKABA_OCCUPIED_FLAG) == 0u ||
            !M8HasSurfacePlane(state.flags))
            continue;
        uint ignored;
        InterlockedOr(gM8ShellPatchValidWords[word], bit, ignored);
    }
    GroupMemoryBarrierWithGroupSync();

    if (thread < MERKABA_M8_TILE_WORDS)
    {
        uint prefix = 0u;
        [unroll]
        for (uint word = 0u; word < MERKABA_M8_TILE_WORDS; word++)
        {
            if (word >= thread) break;
            prefix += countbits(gM8ShellPatchValidWords[word]);
        }
        gM8ShellPatchPrefixes[thread] = prefix;
    }
    GroupMemoryBarrierWithGroupSync();
    if (thread == 0u)
        gM8ShellValidPatchCount =
            gM8ShellPatchPrefixes[MERKABA_M8_TILE_WORDS - 1u] +
            countbits(gM8ShellPatchValidWords[
                MERKABA_M8_TILE_WORDS - 1u]);
    GroupMemoryBarrierWithGroupSync();
}

[numthreads(8, 8, 2)]
void PreflightReadout(uint3 groupId : SV_GroupID, uint thread : SV_GroupIndex)
{
    uint2 visibleTile = _M8VisibleTiles[groupId.x];
    M8LoadMainTile(visibleTile.x, thread);
    M8ResolveOverlapPatchMask(thread);

    if (thread != 0u) return;
    uint primitiveCount =
        gM8ShellValidPatchCount * M8_OVERLAP_TRIANGLES_PER_PATCH;
    uint ignored;
    InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_CONSIDERED],
        gM8ShellOccupiedCount, ignored);
    InterlockedAdd(
        _M8Counters[M8_COUNTER_READOUT_PLANE_LEGACY_INVALID],
        gM8ShellOccupiedCount - gM8ShellValidPatchCount, ignored);
    InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_PLANE_VALID],
        gM8ShellValidPatchCount, ignored);
    uint baseTriangle;
    InterlockedAdd(_M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES],
        primitiveCount, baseTriangle);
    if (baseTriangle + primitiveCount >
        MERKABA_M8_READOUT_TRIANGLE_CAPACITY)
    {
        _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 1u;
        InterlockedMax(_M8Counters[M8_COUNTER_READOUT_BUILD_STATUS],
            MERKABA_READOUT_FAILED, ignored);
        return;
    }
    _M8VisibleTiles[groupId.x].y = baseTriangle;
}

[numthreads(1, 1, 1)]
void PrepareReadoutEmit(uint id : SV_DispatchThreadID)
{
    uint status = _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS];
    uint logical =
        _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES];
    if (status != MERKABA_READOUT_BUILDING ||
        _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] != 0u ||
        _M8Counters[M8_COUNTER_READOUT_UNRESOLVED] != 0u ||
        logical > MERKABA_M8_READOUT_TRIANGLE_CAPACITY)
    {
        _M8FrameDispatchArgs[0] = 0u;
        _M8FrameDispatchArgs[1] = 1u;
        _M8FrameDispatchArgs[2] = 1u;
        if (status == MERKABA_READOUT_BUILDING)
            _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
                MERKABA_READOUT_FAILED;
        return;
    }

    _M8FrameDispatchArgs[0] = min(
        _M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
    _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
        MERKABA_READOUT_PREFLIGHTED;
}

void M8EmitOneOverlapPatch(uint kernelLocal, uint tileBaseTriangle)
{
    uint word = kernelLocal >> 5u;
    uint bit = 1u << (kernelLocal & 31u);
    if ((gM8ShellPatchValidWords[word] & bit) == 0u) return;

    int3 tileLocal = int3(kernelLocal & 7u,
        (kernelLocal >> 3u) & 7u, (kernelLocal >> 6u) & 7u);
    int3 globalCoord = gM8ShellTileOrigin + tileLocal;
    KernelState mainState = M8LoadKernelStateRead(gM8ShellPhysicalSlot,
        kernelLocal);
    M8OverlapPatch patch;
    M8TryBuildMeasuredPlanePatch(globalCoord, mainState, patch);
    uint outputTriangle = tileBaseTriangle + M8PatchPrefix(kernelLocal) *
        M8_OVERLAP_TRIANGLES_PER_PATCH;

    uint cornerIndex = M8OverlapTriangleCorner(0u);
    float3 corner = M8OverlapPatchCorner(patch, cornerIndex);
    M8StoreReadoutVertex(outputTriangle, 0u,
        corner, patch.packedColor);
    cornerIndex = M8OverlapTriangleCorner(1u);
    corner = M8OverlapPatchCorner(patch, cornerIndex);
    M8StoreReadoutVertex(outputTriangle, 1u,
        corner, patch.packedColor);
    cornerIndex = M8OverlapTriangleCorner(2u);
    corner = M8OverlapPatchCorner(patch, cornerIndex);
    M8StoreReadoutVertex(outputTriangle, 2u,
        corner, patch.packedColor);
    cornerIndex = M8OverlapTriangleCorner(3u);
    corner = M8OverlapPatchCorner(patch, cornerIndex);
    M8StoreReadoutVertex(outputTriangle + 1u, 0u,
        corner, patch.packedColor);
    cornerIndex = M8OverlapTriangleCorner(4u);
    corner = M8OverlapPatchCorner(patch, cornerIndex);
    M8StoreReadoutVertex(outputTriangle + 1u, 1u,
        corner, patch.packedColor);
    cornerIndex = M8OverlapTriangleCorner(5u);
    corner = M8OverlapPatchCorner(patch, cornerIndex);
    M8StoreReadoutVertex(outputTriangle + 1u, 2u,
        corner, patch.packedColor);
}

[numthreads(8, 8, 2)]
void EmitReadoutVertices(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint2 visibleTile = _M8VisibleTilesRead[groupId.x];
    M8LoadMainTile(visibleTile.x, thread);
    M8ResolveOverlapPatchMask(thread);
    if (thread == 0u)
    {
        uint ignored;
        InterlockedAdd(
            _M8Counters[M8_COUNTER_READOUT_EMITTED_PATCHES],
            gM8ShellValidPatchCount, ignored);
        InterlockedAdd(
            _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES],
            gM8ShellValidPatchCount * M8_OVERLAP_TRIANGLES_PER_PATCH,
            ignored);
    }
    GroupMemoryBarrierWithGroupSync();

    M8EmitOneOverlapPatch(thread, visibleTile.y);
    M8EmitOneOverlapPatch(thread + M8_SHELL_GROUP_THREADS, visibleTile.y);
    M8EmitOneOverlapPatch(thread + M8_SHELL_GROUP_THREADS * 2u,
        visibleTile.y);
    M8EmitOneOverlapPatch(thread + M8_SHELL_GROUP_THREADS * 3u,
        visibleTile.y);
}

[numthreads(1, 1, 1)]
void FinalizeReadout(uint id : SV_DispatchThreadID)
{
    uint status = _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS];
    if (status == MERKABA_READOUT_SKIPPED ||
        status == MERKABA_READOUT_FAILED)
        return;

    uint logical =
        _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES];
    uint emitted =
        _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES];
    if (status != MERKABA_READOUT_PREFLIGHTED ||
        _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] != 0u ||
        _M8Counters[M8_COUNTER_READOUT_UNRESOLVED] != 0u ||
        logical > MERKABA_M8_READOUT_TRIANGLE_CAPACITY ||
        emitted != logical)
    {
        // A post-preflight mismatch is an invariant violation. Never publish
        // it and preserve the last-good draw arguments.
        _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
            MERKABA_READOUT_EMIT_FAILED;
        return;
    }

    _M8DrawArgs[0] = logical * M8_READOUT_VERTICES_PER_TRIANGLE;
    _M8DrawArgs[1] = 2u;
    _M8DrawArgs[2] = 0u;
    _M8DrawArgs[3] = 0u;
    _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
        MERKABA_READOUT_PUBLISHED;
}
