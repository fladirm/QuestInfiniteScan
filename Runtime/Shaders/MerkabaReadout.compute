#pragma kernel ResetReadoutBuild
#pragma kernel QueryM8Readout
#pragma kernel PrepareReadoutBuild
#pragma kernel ProjectReadoutFrontDepth
#pragma kernel IndexReadoutVertices
#pragma kernel BuildReadoutVertices
#pragma kernel ProjectReadoutMeshPins
#pragma kernel BuildReadoutMesh
#pragma kernel FinalizeReadout

#include "MerkabaWorld.hlsl"
#include "MerkabaSurfaceOrientation.generated.hlsl"

#define MERKABA_LATTICE_STEP 0.025
#define MERKABA_SUPPORT_SIZE 0.050
#define MERKABA_HALF_SUPPORT 0.025
#define MERKABA_OCCUPIED_FLAG 1u
#define M8_READOUT_VERTICES_PER_TRIANGLE 3u
#define M8_READOUT_PLANAR_TRIANGLES 2u
#define M8_READOUT_GLYPH_TRIANGLES 8u
#define M8_READOUT_GLYPH_EXTRA_TRIANGLES 6u
#define M8_READOUT_GLYPH_EQUATOR_EXTENT 0.0125
#define M8_READOUT_GLYPH_TIP_EXTENT 0.00625
#define M8_READOUT_SEAM_OVERLAP \
    (MERKABA_SURFACE_PLANE_OFFSET_RANGE / 127.0)
#define M8_MESH_MAX_DIMENSION 512u
#define M8_MESH_MAX_PIXELS \
    (M8_MESH_MAX_DIMENSION * M8_MESH_MAX_DIMENSION)
#define M8_MESH_SCRATCH_BASE (M8_MESH_MAX_PIXELS * 6u)
#define M8_MESH_ENVELOPE_BASE (M8_MESH_SCRATCH_BASE + M8_MESH_MAX_PIXELS)
#define M8_MESH_INVALID_RANK 0xffffffffu
#define M8_MESH_NEUTRAL_COLOR 0xffa0a0a0u
#define M8_MESH_MAX_EDGE_LENGTH 0.150
#define M8_FRONT_FACE_DIMENSION 512u
#define M8_FRONT_FACE_PIXELS \
    (M8_FRONT_FACE_DIMENSION * M8_FRONT_FACE_DIMENSION)
#define M8_FRONT_PIXEL_COUNT (6u * M8_FRONT_FACE_PIXELS)
#define M8_FRONT_INVALID_DEPTH 0xffffu
#define M8_FRONT_PACKED_INVALID_DEPTH 0xffffffffu
#define M8_FRONT_DEPTH_SCALE 1000.0
#define M8_FRONT_DEPTH_TOLERANCE_MM \
    ((uint)round(2.0 * MERKABA_HALF_SUPPORT * M8_FRONT_DEPTH_SCALE))
#define M8_FRONT_MASK_WORDS_PER_TILE 32u
#define M8_FRONT_MASK_KERNELS_PER_WORD 16u
#define M8_FRONT_VALID_WORDS_PER_TILE MERKABA_M8_TILE_WORDS
#define M8_FRONT_MASK_BASE MERKABA_M8_PHYSICAL_TILE_CAPACITY
#define M8_FRONT_VERTEX_BASE (M8_FRONT_MASK_BASE + \
    MERKABA_M8_PHYSICAL_TILE_CAPACITY * M8_FRONT_MASK_WORDS_PER_TILE)
#define M8_READOUT_PIN_SHEET_SHIFT 25u
#define M8_READOUT_PIN_SHEET_MASK 0x0fu
#define M8_READOUT_VISIBLE_COLOR_MASK 0x01ffffffu
#define M8_READOUT_BUILD_VERTEX_MASK 0x00ffffffu
#define M8_READOUT_BUILD_POSITIVE (1u << 24u)
#define M8_READOUT_BUILD_NEGATIVE (1u << 25u)
#define M8_READOUT_BUILD_GLYPH (1u << 26u)
#define M8_READOUT_BUILD_FLAGS_MASK (7u << 24u)
#define M8_READOUT_BUILD_KERNEL_MASK 511u
#define M8_READOUT_INVALID_VERTEX M8_READOUT_BUILD_VERTEX_MASK
#define M8_READOUT_INVALID_PHYSICAL_SLOT 0xffffffffu
#define M8_READOUT_GLYPH_VERTICES 6u

struct MerkabaReadoutVertex
{
    float3 gridPosition;
    uint packedColor;
};

RWStructuredBuffer<uint2> _M8VisibleTiles;
StructuredBuffer<uint2> _M8VisibleTilesRead;
RWStructuredBuffer<MerkabaReadoutVertex> _M8ReadoutVertices0;
RWStructuredBuffer<MerkabaReadoutVertex> _M8ReadoutVertices1;
RWByteAddressBuffer _M8ReadoutIndices;
RWStructuredBuffer<uint> _M8FrameDispatchArgs;
RWStructuredBuffer<uint> _M8DrawArgs;
Texture2DArray<float> _SrcDepth;

float3 _M8CameraGridMeters;
float3 _M8EyeGridPosition0;
float3 _M8EyeGridPosition1;
float3 _M8GridMetricDiagonal;
float3 _M8GridMetricCross;
float _M8RenderDistance;
float _M8WarmDistance;
float _M8DependencyDistance;
int3 _M8QueryCenterBlock;
int _M8QueryBlockRadius;
int _M8QueryBlockSide;
uint _M8MeshReadoutEnabled;
uint2 _M8MeshDepthSize;
float4x4 _MerkabaGridToWorld;
float4x4 _MerkabaWorldToGrid;
float4x4 _M8MeshDepthProj0;
float4x4 _M8MeshDepthProj1;
float4x4 _M8MeshDepthProjInv0;
float4x4 _M8MeshDepthProjInv1;
float4x4 _M8MeshDepthView0;
float4x4 _M8MeshDepthView1;
float4x4 _M8MeshDepthViewInv0;
float4x4 _M8MeshDepthViewInv1;

bool M8AabbIntersectsDistance(int3 globalMin, int span, float distance)
{
    return MerkabaM8GridAabbIntersectsDistance(globalMin, span, distance,
        _M8CameraGridMeters, _M8GridMetricDiagonal, _M8GridMetricCross,
        MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
}

uint M8DistanceChildMask(int3 parentMin, int parentSpan, float distance)
{
    return MerkabaM8GridDistanceChildMask(parentMin, parentSpan, distance,
        _M8CameraGridMeters, _M8GridMetricDiagonal, _M8GridMetricCross,
        MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
}

uint M8DrawChildMask(int3 parentMin, int parentSpan)
{
    return M8DistanceChildMask(parentMin, parentSpan, _M8RenderDistance);
}

uint M8DependencyChildMask(int3 parentMin, int parentSpan)
{
    return M8DistanceChildMask(parentMin, parentSpan,
        _M8DependencyDistance);
}

void M8RequestWarmLoad(uint tileRefIndex, uint chunkIndex, uint tileLocal,
    bool lateDraw)
{
    M8QueueColdTileLoad(tileRefIndex, chunkIndex, tileLocal);
    if (lateDraw) M8CounterIncrement(M8_COUNTER_LATE_DRAW_COLD_MISSES);
}

[numthreads(128, 1, 1)]
void ResetReadoutBuild(uint id : SV_DispatchThreadID)
{
    if (_M8MeshReadoutEnabled == 0u && id < M8_FRONT_PIXEL_COUNT)
        _M8VisibleTiles[id].y = M8_FRONT_PACKED_INVALID_DEPTH;
    if (id != 0u) return;
    _M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT] = 0u;
    _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES] = 0u;
    _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 0u;
    _M8Counters[M8_COUNTER_LATE_DRAW_COLD_MISSES] = 0u;
    _M8Counters[M8_COUNTER_CANDIDATE_BLOCKS] = 0u;
    _M8Counters[M8_COUNTER_HASH_HIT_BLOCKS] = 0u;
    _M8Counters[M8_COUNTER_VISIBLE_CHUNKS] = 0u;
    _M8Counters[M8_COUNTER_OCCUPIED_CONSIDERED] = 0u;
    _M8Counters[M8_COUNTER_READOUT_PLANE_VALID] = 0u;
    _M8Counters[M8_COUNTER_READOUT_EMITTED_PATCHES] = 0u;
    _M8Counters[M8_COUNTER_READOUT_UNRESOLVED] = 0u;
    _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES] = 0u;
    _M8Counters[M8_COUNTER_READOUT_PLANE_LEGACY_INVALID] = 0u;
    _M8Counters[M8_COUNTER_READOUT_EMITTED_VERTICES] = 0u;
    _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
        MERKABA_READOUT_BUILDING;
    _M8Counters[M8_COUNTER_FRAME_EPOCH] += 1u;
    _M8FrameDispatchArgs[0] = 0u;
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
}

groupshared uint gFrameBlockRef;
groupshared int3 gFrameBlockMin;
groupshared uint gFrameWarm4;
groupshared uint gFrameDraw4;
groupshared uint gFrameDependency4;
groupshared uint gFrameWarm3[8];
groupshared uint gFrameDraw3[8];
groupshared uint gFrameDependency3[8];

[numthreads(64, 1, 1)]
void QueryM8Readout(uint3 groupId : SV_GroupID, uint thread : SV_GroupIndex)
{
    uint linearBlockIndex = groupId.x;
    if (thread == 0u)
    {
        gFrameBlockRef = 0u;
        gFrameWarm4 = 0u;
        gFrameDraw4 = 0u;
        gFrameDependency4 = 0u;
        uint side = (uint)_M8QueryBlockSide;
        if (linearBlockIndex < side * side * side)
        {
            int3 offset;
            offset.x = (int)(linearBlockIndex % side) - _M8QueryBlockRadius;
            offset.y = (int)((linearBlockIndex / side) % side) -
                _M8QueryBlockRadius;
            offset.z = (int)(linearBlockIndex / (side * side)) -
                _M8QueryBlockRadius;
            int3 blockCoord = _M8QueryCenterBlock + offset;
            gFrameBlockMin = blockCoord * MERKABA_M8_BLOCK_KERNEL_SPAN;
            M8CounterIncrement(M8_COUNTER_CANDIDATE_BLOCKS);
            if (M8AabbIntersectsDistance(gFrameBlockMin,
                MERKABA_M8_BLOCK_KERNEL_SPAN, _M8WarmDistance))
            {
                uint blockIndex = 0u;
                if (M8FindBlock(blockCoord, blockIndex))
                {
                    gFrameBlockRef = blockIndex + 1u;
                    gFrameWarm4 = M8DistanceChildMask(gFrameBlockMin, 256,
                        _M8WarmDistance);
                    gFrameDraw4 = M8DrawChildMask(gFrameBlockMin, 256);
                    gFrameDependency4 = M8DependencyChildMask(
                        gFrameBlockMin, 256);
                    M8CounterIncrement(M8_COUNTER_HASH_HIT_BLOCKS);
                }
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (thread < 8u)
    {
        uint d4ForMask = thread;
        gFrameWarm3[d4ForMask] = 0u;
        gFrameDraw3[d4ForMask] = 0u;
        gFrameDependency3[d4ForMask] = 0u;
        if (gFrameBlockRef != 0u)
        {
            uint maskBlockIndex = gFrameBlockRef - 1u;
            if (((_M8BlockPresenceL0Read[maskBlockIndex] & gFrameWarm4) &
                (1u << d4ForMask)) != 0u)
            {
                int3 min4ForMask = gFrameBlockMin +
                    MerkabaM8OctantOffset(d4ForMask, 128);
                gFrameWarm3[d4ForMask] = M8DistanceChildMask(min4ForMask, 128,
                    _M8WarmDistance);
                gFrameDraw3[d4ForMask] =
                    ((gFrameDraw4 >> d4ForMask) & 1u) != 0u
                    ? M8DrawChildMask(min4ForMask, 128) : 0u;
                gFrameDependency3[d4ForMask] =
                    ((gFrameDependency4 >> d4ForMask) & 1u) != 0u
                    ? M8DependencyChildMask(min4ForMask, 128) : 0u;
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gFrameBlockRef == 0u) return;

    uint blockIndex = gFrameBlockRef - 1u;
    int3 blockMin = gFrameBlockMin;
    uint d4 = thread >> 3u;
    uint d3 = thread & 7u;
    if (((gFrameWarm4 >> d4) & 1u) == 0u ||
        (((_M8BlockPresenceL1Read[blockIndex * 8u + d4] &
        gFrameWarm3[d4]) >> d3) & 1u) == 0u) return;

    int3 min4 = blockMin + MerkabaM8OctantOffset(d4, 128);
    int3 min3 = min4 + MerkabaM8OctantOffset(d3, 64);
    uint warm2 = M8DistanceChildMask(min3, 64, _M8WarmDistance);
    bool drawPath3 = ((gFrameDraw4 >> d4) & 1u) != 0u &&
        ((gFrameDraw3[d4] >> d3) & 1u) != 0u;
    bool dependencyPath3 = ((gFrameDependency4 >> d4) & 1u) != 0u &&
        ((gFrameDependency3[d4] >> d3) & 1u) != 0u;
    uint draw2 = drawPath3 ? M8DrawChildMask(min3, 64) : 0u;
    uint dependency2 = dependencyPath3
        ? M8DependencyChildMask(min3, 64) : 0u;
    uint support2 = (_M8BlockPresenceL2Read[blockIndex * 64u +
        d4 * 8u + d3] & 255u) & warm2;
    while (support2 != 0u)
    {
        uint d2 = (uint)firstbitlow(support2);
        support2 &= support2 - 1u;
        uint chunkLocal = (d4 << 6u) | (d3 << 3u) | d2;
        uint chunkRef = _M8BlockChunkRefsRead[blockIndex * 512u + chunkLocal];
        if (chunkRef == 0u || chunkRef >= MERKABA_REF_EVICTING) continue;
        uint chunkIndex = chunkRef - 1u;
        int3 min2 = min3 + MerkabaM8OctantOffset(d2, 32);
        uint warm1 = M8DistanceChildMask(min2, 32, _M8WarmDistance);
        bool drawPath2 = drawPath3 && ((draw2 >> d2) & 1u) != 0u;
        bool dependencyPath2 = dependencyPath3 &&
            ((dependency2 >> d2) & 1u) != 0u;
        uint draw1 = drawPath2 ? M8DrawChildMask(min2, 32) : 0u;
        uint dependency1 = dependencyPath2
            ? M8DependencyChildMask(min2, 32) : 0u;
        uint support1 =
            (_M8ChunkPresenceRead[M8ChunkPresenceL0Index(chunkIndex)] &
            255u) & warm1;
        bool visibleChunk = false;
        while (support1 != 0u)
        {
            uint d1 = (uint)firstbitlow(support1);
            support1 &= support1 - 1u;
            int3 min1 = min2 + MerkabaM8OctantOffset(d1, 16);
            uint warm0 = M8DistanceChildMask(min1, 16, _M8WarmDistance);
            bool drawPath1 = drawPath2 && ((draw1 >> d1) & 1u) != 0u;
            bool dependencyPath1 = dependencyPath2 &&
                ((dependency1 >> d1) & 1u) != 0u;
            uint draw0 = drawPath1 ? M8DrawChildMask(min1, 16) : 0u;
            uint dependency0 = dependencyPath1
                ? M8DependencyChildMask(min1, 16) : 0u;
            uint support0 =
                (_M8ChunkPresenceRead[
                    M8ChunkPresenceL1Index(chunkIndex, d1)] & 255u) & warm0;
            while (support0 != 0u)
            {
                uint d0 = (uint)firstbitlow(support0);
                support0 &= support0 - 1u;
                uint tileLocal = (d1 << 3u) | d0;
                uint tileRefIndex = chunkIndex * 64u + tileLocal;
                uint tileRef = _M8ChunkTileRefs[tileRefIndex];
                bool inDraw = drawPath1 && ((draw0 >> d0) & 1u) != 0u;
                bool inDependency = dependencyPath1 &&
                    ((dependency0 >> d0) & 1u) != 0u;
                if (tileRef == MERKABA_REF_COLD_ON_SSD)
                {
                    M8RequestWarmLoad(tileRefIndex, chunkIndex, tileLocal,
                        inDraw);
                    if (inDependency)
                        M8CounterIncrement(M8_COUNTER_READOUT_UNRESOLVED);
                    continue;
                }
                if (!M8IsHotRef(tileRef))
                {
                    if (inDraw)
                        M8CounterIncrement(M8_COUNTER_LATE_DRAW_COLD_MISSES);
                    if (inDependency)
                        M8CounterIncrement(M8_COUNTER_READOUT_UNRESOLVED);
                    continue;
                }
                uint physicalSlot = M8PhysicalSlot(tileRef);
                _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].z =
                    _M8Counters[M8_COUNTER_FRAME_EPOCH];
                if (!inDraw ||
                    _M8TileRecords[M8TileMetaIndex(physicalSlot)].z == 0u)
                    continue;
                uint visibleIndex;
                InterlockedAdd(_M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT],
                    1u, visibleIndex);
                if (visibleIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                    _M8VisibleTiles[visibleIndex].x = physicalSlot;
                visibleChunk = true;
            }
        }
        if (visibleChunk) M8CounterIncrement(M8_COUNTER_VISIBLE_CHUNKS);
    }
}

[numthreads(8, 8, 1)]
void PrepareReadoutBuild(uint3 id : SV_DispatchThreadID)
{
    if (_M8MeshReadoutEnabled != 0u &&
        id.x < _M8MeshDepthSize.x && id.y < _M8MeshDepthSize.y)
    {
        uint pixel = id.x + id.y * _M8MeshDepthSize.x;
        _M8ReadoutVertices0[M8_MESH_SCRATCH_BASE + pixel].packedColor =
            M8_MESH_INVALID_RANK;
        _M8ReadoutVertices1[M8_MESH_SCRATCH_BASE + pixel].packedColor =
            M8_MESH_INVALID_RANK;
    }
    if (id.x == 0u && id.y == 0u && id.z == 0u &&
        _M8MeshReadoutEnabled != 0u)
    {
        _M8ReadoutVertices0[M8_MESH_ENVELOPE_BASE + 0u].packedColor =
            M8_MESH_INVALID_RANK;
        _M8ReadoutVertices0[M8_MESH_ENVELOPE_BASE + 1u].packedColor =
            M8_MESH_INVALID_RANK;
        _M8ReadoutVertices0[M8_MESH_ENVELOPE_BASE + 2u].packedColor = 0u;
        _M8ReadoutVertices0[M8_MESH_ENVELOPE_BASE + 3u].packedColor = 0u;
        _M8ReadoutVertices1[M8_MESH_ENVELOPE_BASE + 0u].packedColor =
            M8_MESH_INVALID_RANK;
        _M8ReadoutVertices1[M8_MESH_ENVELOPE_BASE + 1u].packedColor =
            M8_MESH_INVALID_RANK;
        _M8ReadoutVertices1[M8_MESH_ENVELOPE_BASE + 2u].packedColor = 0u;
        _M8ReadoutVertices1[M8_MESH_ENVELOPE_BASE + 3u].packedColor = 0u;
    }
    if (any(id != 0u)) return;
    _M8FrameDispatchArgs[0] = min(
        _M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
}

#define M8_SHELL_GROUP_THREADS 128u
#define M8_SHELL_MAIN_COUNT 512u

bool M8FrontDepthPixel(float3 gridPosition, float3 eyeGridPosition,
    out uint pixel,
    out uint depthMillimetres)
{
    pixel = 0u;
    depthMillimetres = 0u;
    float3 delta = gridPosition - eyeGridPosition;
    float distance = length(delta);
    if (distance <= 1.0e-6) return false;
    float3 direction = delta / distance;
    float3 absoluteDirection = abs(direction);
    uint face;
    float2 facePosition;
    if (absoluteDirection.x >= absoluteDirection.y &&
        absoluteDirection.x >= absoluteDirection.z)
    {
        face = direction.x >= 0.0 ? 0u : 1u;
        facePosition = direction.x >= 0.0
            ? float2(-direction.z, direction.y) / absoluteDirection.x
            : float2(direction.z, direction.y) / absoluteDirection.x;
    }
    else if (absoluteDirection.y >= absoluteDirection.z)
    {
        face = direction.y >= 0.0 ? 2u : 3u;
        facePosition = direction.y >= 0.0
            ? float2(direction.x, -direction.z) / absoluteDirection.y
            : float2(direction.x, direction.z) / absoluteDirection.y;
    }
    else
    {
        face = direction.z >= 0.0 ? 4u : 5u;
        facePosition = direction.z >= 0.0
            ? float2(direction.x, direction.y) / absoluteDirection.z
            : float2(-direction.x, direction.y) / absoluteDirection.z;
    }
    uint2 coordinate = min((uint2)(saturate(facePosition * 0.5 + 0.5) *
        M8_FRONT_FACE_DIMENSION), M8_FRONT_FACE_DIMENSION - 1u);
    pixel = face * M8_FRONT_FACE_PIXELS + coordinate.y *
        M8_FRONT_FACE_DIMENSION + coordinate.x;
    depthMillimetres = min(M8_FRONT_INVALID_DEPTH - 1u,
        (uint)round(distance * M8_FRONT_DEPTH_SCALE));
    return true;
}

void M8AtomicMinFrontDepth(uint pixel, uint eye, uint depthMillimetres)
{
    uint shift = eye * 16u;
    uint mask = M8_FRONT_INVALID_DEPTH << shift;
    uint previous = _M8VisibleTiles[pixel].y;
    [allow_uav_condition]
    while (true)
    {
        uint current = (previous >> shift) & M8_FRONT_INVALID_DEPTH;
        if (depthMillimetres >= current) return;
        uint replacement = (previous & ~mask) | (depthMillimetres << shift);
        uint observed;
        InterlockedCompareExchange(_M8VisibleTiles[pixel].y, previous,
            replacement, observed);
        if (observed == previous) return;
        previous = observed;
    }
}

[numthreads(128, 1, 1)]
void ProjectReadoutFrontDepth(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint physicalSlot = _M8VisibleTiles[groupId.x].x;
    [unroll]
    for (uint batch = 0u; batch < 4u; batch++)
    {
        uint kernelLocal = thread + batch * M8_SHELL_GROUP_THREADS;
        uint word = _M8TileBitsRead[M8TileWordIndex(physicalSlot,
            kernelLocal >> 5u)].x;
        uint bit = 1u << (kernelLocal & 31u);
        if ((word & bit) == 0u) continue;
        KernelState state = M8LoadKernelStateRead(physicalSlot, kernelLocal);
        if ((state.flags & MERKABA_OCCUPIED_FLAG) == 0u ||
            !M8HasSurfacePlane(state.flags)) continue;
        float3 normal;
        float signedOffset;
        M8DecodeSurfacePlane(state.flags, normal, signedOffset);
        int3 globalCoord = M8GlobalKernelCoordRead(physicalSlot,
            kernelLocal);
        float3 center = (float3)globalCoord * MERKABA_LATTICE_STEP +
            normal * signedOffset;
        uint pixel;
        uint depthMillimetres;
        if (M8FrontDepthPixel(center, _M8EyeGridPosition0, pixel,
            depthMillimetres))
            M8AtomicMinFrontDepth(pixel, 0u, depthMillimetres);
        if (M8FrontDepthPixel(center, _M8EyeGridPosition1, pixel,
            depthMillimetres))
            M8AtomicMinFrontDepth(pixel, 1u, depthMillimetres);
    }
}

bool M8IsFrontReadoutKernelForEye(float3 center, float3 eyeGridPosition,
    uint eye)
{
    uint pixel;
    uint depthMillimetres;
    if (!M8FrontDepthPixel(center, eyeGridPosition, pixel,
        depthMillimetres))
        return false;
    uint packedDepth = _M8VisibleTiles[pixel].y;
    uint frontDepth = (packedDepth >> (eye * 16u)) &
        M8_FRONT_INVALID_DEPTH;
    return frontDepth != M8_FRONT_INVALID_DEPTH &&
        depthMillimetres <= frontDepth + M8_FRONT_DEPTH_TOLERANCE_MM;
}

uint M8FrontReadoutEyeMask(int3 globalCoord, KernelState state)
{
    float3 normal;
    float signedOffset;
    M8DecodeSurfacePlane(state.flags, normal, signedOffset);
    float3 center = (float3)globalCoord * MERKABA_LATTICE_STEP +
        normal * signedOffset;
    uint mask = M8IsFrontReadoutKernelForEye(center,
        _M8EyeGridPosition0, 0u) ? 1u : 0u;
    if (M8IsFrontReadoutKernelForEye(center, _M8EyeGridPosition1, 1u))
        mask |= 2u;
    return mask;
}

void M8StoreReadoutVertex(uint outputVertex, float3 gridPosition,
    uint packedColor)
{
    bool secondBuffer = outputVertex >=
        MERKABA_M8_READOUT_VERTICES_PER_BUFFER;
    if (secondBuffer)
        outputVertex -= MERKABA_M8_READOUT_VERTICES_PER_BUFFER;
    MerkabaReadoutVertex vertex;
    vertex.gridPosition = gridPosition;
    vertex.packedColor = packedColor;
    if (secondBuffer) _M8ReadoutVertices1[outputVertex] = vertex;
    else _M8ReadoutVertices0[outputVertex] = vertex;
}

uint M8EncodeReadoutSheet(int3 step)
{
    int first = step.x != 0 ? step.x : step.y != 0 ? step.y : step.z;
    if (first < 0) step = -step;
    if (step.y == 0 && step.z == 0) return 0u;
    if (step.x == 0 && step.z == 0) return 1u;
    if (step.x == 0 && step.y == 0) return 2u;
    if (step.z == 0) return step.y > 0 ? 3u : 4u;
    if (step.y == 0) return step.z > 0 ? 5u : 6u;
    if (step.x == 0) return step.z > 0 ? 7u : 8u;
    return 9u + (step.y < 0 ? 2u : 0u) + (step.z < 0 ? 1u : 0u);
}

uint M8ReadoutSheetCode(uint packedColor)
{
    return (packedColor >> M8_READOUT_PIN_SHEET_SHIFT) &
        M8_READOUT_PIN_SHEET_MASK;
}

int3 M8DecodeReadoutSheetCode(uint encoded)
{
    if (encoded == 0u) return int3(1, 0, 0);
    if (encoded == 1u) return int3(0, 1, 0);
    if (encoded == 2u) return int3(0, 0, 1);
    if (encoded == 3u) return int3(1, 1, 0);
    if (encoded == 4u) return int3(1, -1, 0);
    if (encoded == 5u) return int3(1, 0, 1);
    if (encoded == 6u) return int3(1, 0, -1);
    if (encoded == 7u) return int3(0, 1, 1);
    if (encoded == 8u) return int3(0, 1, -1);
    uint body = encoded - 9u;
    return int3(1, (body & 2u) != 0u ? -1 : 1,
        (body & 1u) != 0u ? -1 : 1);
}

uint M8PackReadoutPinColor(uint packedColor, float3 normal)
{
    uint sheet = M8EncodeReadoutSheet(
        MerkabaNearestGridNormalStep(normal));
    return (packedColor & M8_READOUT_VISIBLE_COLOR_MASK) |
        (sheet << M8_READOUT_PIN_SHEET_SHIFT);
}

void M8StoreReadoutIndex(uint outputIndex, uint outputVertex)
{
    _M8ReadoutIndices.Store(outputIndex * 4u, outputVertex);
}

#define M8_READOUT_INDEX_CAPACITY \
    (MERKABA_M8_READOUT_TRIANGLE_CAPACITY * 3u)
#define M8_READOUT_MAP_WORD_BASE M8_READOUT_INDEX_CAPACITY
#define M8_READOUT_MAP_WORDS_PER_TILE 256u

groupshared uint gM8IndexEyeMasks[M8_SHELL_MAIN_COUNT];
groupshared uint gM8IndexValidWords[MERKABA_M8_TILE_WORDS];
groupshared uint gM8IndexWordPrefixes[MERKABA_M8_TILE_WORDS];
groupshared uint gM8IndexBaseVertex;
groupshared uint gM8IndexValidCount;
groupshared uint gM8IndexPlaneCount;
groupshared uint gM8IndexCanEmit;

uint M8IndexLocalPrefix(uint kernelLocal)
{
    uint word = kernelLocal >> 5u;
    uint bitIndex = kernelLocal & 31u;
    uint below = bitIndex == 0u ? 0u : (1u << bitIndex) - 1u;
    return gM8IndexWordPrefixes[word] +
        countbits(gM8IndexValidWords[word] & below);
}

bool M8IndexPinValid(uint kernelLocal)
{
    return (gM8IndexValidWords[kernelLocal >> 5u] &
        (1u << (kernelLocal & 31u))) != 0u;
}

void M8StoreReadoutLocalMapPair(uint physicalSlot, uint pair,
    uint firstKernel)
{
    uint first = M8IndexPinValid(firstKernel)
        ? M8IndexLocalPrefix(firstKernel) + 1u : 0u;
    uint second = M8IndexPinValid(firstKernel + 1u)
        ? M8IndexLocalPrefix(firstKernel + 1u) + 1u : 0u;
    uint mapWord = M8_READOUT_MAP_WORD_BASE + physicalSlot *
        M8_READOUT_MAP_WORDS_PER_TILE + pair;
    _M8ReadoutIndices.Store(mapWord * 4u, first | (second << 16u));
}

[numthreads(128, 1, 1)]
void IndexReadoutVertices(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint physicalSlot = _M8VisibleTiles[groupId.x].x;
    if (thread == 0u)
    {
        gM8IndexPlaneCount = 0u;
        gM8IndexCanEmit = 0u;
    }
    if (thread < MERKABA_M8_TILE_WORDS)
        gM8IndexValidWords[thread] = 0u;
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint batch = 0u; batch < 4u; batch++)
    {
        uint kernelLocal = thread + batch * M8_SHELL_GROUP_THREADS;
        uint occupancy = _M8TileBitsRead[M8TileWordIndex(physicalSlot,
            kernelLocal >> 5u)].x;
        uint eyeMask = 0u;
        if ((occupancy & (1u << (kernelLocal & 31u))) != 0u)
        {
            KernelState state = M8LoadKernelStateRead(physicalSlot,
                kernelLocal);
            if ((state.flags & MERKABA_OCCUPIED_FLAG) != 0u &&
                M8HasSurfacePlane(state.flags))
            {
                uint ignored;
                InterlockedAdd(gM8IndexPlaneCount, 1u, ignored);
                InterlockedOr(gM8IndexValidWords[kernelLocal >> 5u],
                    1u << (kernelLocal & 31u), ignored);
                int3 globalCoord = M8GlobalKernelCoordRead(physicalSlot,
                    kernelLocal);
                eyeMask = M8FrontReadoutEyeMask(globalCoord, state);
            }
        }
        gM8IndexEyeMasks[kernelLocal] = eyeMask;
    }
    GroupMemoryBarrierWithGroupSync();

    if (thread < M8_FRONT_MASK_WORDS_PER_TILE)
    {
        uint packed = 0u;
        uint firstKernel = thread * M8_FRONT_MASK_KERNELS_PER_WORD;
        [unroll]
        for (uint index = 0u; index < M8_FRONT_MASK_KERNELS_PER_WORD;
            index++)
            packed |= (gM8IndexEyeMasks[firstKernel + index] & 3u) <<
                (index * 2u);
        _M8VisibleTiles[M8_FRONT_MASK_BASE + physicalSlot *
            M8_FRONT_MASK_WORDS_PER_TILE + thread].x = packed;
    }
    GroupMemoryBarrierWithGroupSync();

    if (thread < MERKABA_M8_TILE_WORDS)
    {
        uint prefix = 0u;
        [unroll]
        for (uint word = 0u; word < MERKABA_M8_TILE_WORDS; word++)
        {
            if (word >= thread) break;
            prefix += countbits(gM8IndexValidWords[word]);
        }
        gM8IndexWordPrefixes[thread] = prefix;
    }
    GroupMemoryBarrierWithGroupSync();

    if (thread == 0u)
    {
        gM8IndexValidCount = gM8IndexWordPrefixes[
            MERKABA_M8_TILE_WORDS - 1u] + countbits(
            gM8IndexValidWords[MERKABA_M8_TILE_WORDS - 1u]);
        uint ignored;
        InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_EMITTED_VERTICES],
            gM8IndexValidCount, gM8IndexBaseVertex);
        uint totalCapacity = MERKABA_M8_READOUT_VERTICES_PER_BUFFER * 2u;
        bool fits = gM8IndexBaseVertex <= totalCapacity &&
            gM8IndexValidCount <= totalCapacity - gM8IndexBaseVertex;
        if (!fits)
        {
            _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 1u;
            InterlockedMax(_M8Counters[M8_COUNTER_READOUT_BUILD_STATUS],
                MERKABA_READOUT_FAILED, ignored);
        }
        else
        {
            gM8IndexCanEmit = 1u;
            _M8VisibleTiles[M8_FRONT_VERTEX_BASE + physicalSlot] = uint2(
                gM8IndexBaseVertex, _M8Counters[M8_COUNTER_FRAME_EPOCH]);
        }
        uint occupied = M8LoadTileMetaRead(physicalSlot).z;
        InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_CONSIDERED],
            occupied, ignored);
        InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_PLANE_VALID],
            gM8IndexPlaneCount, ignored);
        InterlockedAdd(_M8Counters[
            M8_COUNTER_READOUT_PLANE_LEGACY_INVALID],
            occupied - gM8IndexPlaneCount, ignored);
    }
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint pairBatch = 0u; pairBatch < 2u; pairBatch++)
    {
        uint pair = thread + pairBatch * M8_SHELL_GROUP_THREADS;
        M8StoreReadoutLocalMapPair(physicalSlot, pair, pair * 2u);
    }
    if (gM8IndexCanEmit == 0u) return;

    [unroll]
    for (uint batch = 0u; batch < 4u; batch++)
    {
        uint kernelLocal = thread + batch * M8_SHELL_GROUP_THREADS;
        if (!M8IndexPinValid(kernelLocal)) continue;
        KernelState state = M8LoadKernelStateRead(physicalSlot, kernelLocal);
        float3 normal;
        float signedOffset;
        M8DecodeSurfacePlane(state.flags, normal, signedOffset);
        int3 globalCoord = M8GlobalKernelCoordRead(physicalSlot,
            kernelLocal);
        float3 center = (float3)globalCoord * MERKABA_LATTICE_STEP +
            normal * signedOffset;
        M8StoreReadoutVertex(gM8IndexBaseVertex +
            M8IndexLocalPrefix(kernelLocal), center,
            M8PackReadoutPinColor(state.packedColor, normal));
    }
}

#include "MerkabaOverlapShell.generated.hlsl"

uint M8ReadoutEyeMask(uint physicalSlot, uint kernelLocal)
{
    uint packed = _M8VisibleTiles[M8_FRONT_MASK_BASE + physicalSlot *
        M8_FRONT_MASK_WORDS_PER_TILE + (kernelLocal >> 4u)].x;
    return (packed >> ((kernelLocal & 15u) * 2u)) & 3u;
}

bool M8ReadoutLocalVertexIndex(uint physicalSlot, uint kernelLocal,
    uint baseVertex, out uint vertexIndex)
{
    vertexIndex = 0u;
    uint mapWord = M8_READOUT_MAP_WORD_BASE + physicalSlot *
        M8_READOUT_MAP_WORDS_PER_TILE + (kernelLocal >> 1u);
    uint packed = _M8ReadoutIndices.Load(mapWord * 4u);
    uint local = (packed >> ((kernelLocal & 1u) * 16u)) & 0xffffu;
    if (local == 0u) return false;
    vertexIndex = baseVertex + local - 1u;
    return true;
}

bool M8ReadoutVertexIndex(uint physicalSlot, uint kernelLocal,
    out uint vertexIndex)
{
    uint2 record = _M8VisibleTiles[M8_FRONT_VERTEX_BASE + physicalSlot];
    if (record.y != _M8Counters[M8_COUNTER_FRAME_EPOCH])
    {
        vertexIndex = 0u;
        return false;
    }
    return M8ReadoutLocalVertexIndex(physicalSlot, kernelLocal, record.x,
        vertexIndex);
}

struct M8ReadoutPin
{
    float3 center;
    uint sheet;
    uint eyeMask;
    uint vertexIndex;
};

void M8InitializeReadoutPin(out M8ReadoutPin pin)
{
    pin = (M8ReadoutPin)0;
    pin.vertexIndex = 0xffffffffu;
}

MerkabaReadoutVertex M8LoadReadoutVertex(uint vertexIndex)
{
    if (vertexIndex < MERKABA_M8_READOUT_VERTICES_PER_BUFFER)
        return _M8ReadoutVertices0[vertexIndex];
    return _M8ReadoutVertices1[
        vertexIndex - MERKABA_M8_READOUT_VERTICES_PER_BUFFER];
}

void M8DecodeReadoutPin(uint eyeMask, uint vertexIndex,
    out M8ReadoutPin pin)
{
    M8InitializeReadoutPin(pin);
    MerkabaReadoutVertex vertex = M8LoadReadoutVertex(vertexIndex);
    pin.center = vertex.gridPosition;
    pin.sheet = M8ReadoutSheetCode(vertex.packedColor);
    pin.eyeMask = eyeMask;
    pin.vertexIndex = vertexIndex;
}

struct M8ReadoutTileContext
{
    uint physicalSlot;
    uint baseVertex;
    int3 tileOrigin;
    int3 blockCoord;
    uint blockIndex;
    uint chunkIndex;
    uint chunkLocal;
};

M8ReadoutTileContext M8LoadReadoutTileContext(uint physicalSlot,
    uint baseVertex)
{
    M8ReadoutTileContext context;
    context.physicalSlot = physicalSlot;
    context.baseVertex = baseVertex;
    context.tileOrigin = M8GlobalKernelCoordRead(physicalSlot, 0u);
    uint4 meta = M8LoadTileMetaRead(physicalSlot);
    uint2 owner = M8LoadChunkOwnerRead(meta.x);
    context.blockIndex = owner.x;
    context.chunkIndex = meta.x;
    context.chunkLocal = owner.y;
    context.blockCoord = M8LoadBlockCoordRead(owner.x);
    return context;
}

bool M8ResolveReadoutAddress(M8ReadoutTileContext context,
    int3 globalCoord, out uint physicalSlot, out uint kernelLocal)
{
    int3 tileLocal = globalCoord - context.tileOrigin;
    if (!any(tileLocal < 0) && !any(tileLocal >= 8))
    {
        physicalSlot = context.physicalSlot;
        kernelLocal = (uint)tileLocal.x | ((uint)tileLocal.y << 3u) |
            ((uint)tileLocal.z << 6u);
        return true;
    }
    MerkabaM8Address address = MerkabaAddressOf(globalCoord);
    kernelLocal = address.kernelLocal;
    uint blockIndex = context.blockIndex;
    if (!all(address.blockCoord == context.blockCoord) &&
        !M8FindBlock(address.blockCoord, blockIndex))
    {
        physicalSlot = 0u;
        return false;
    }
    uint chunkIndex = context.chunkIndex;
    if (blockIndex != context.blockIndex ||
        address.chunkLocal != context.chunkLocal)
    {
        uint chunkRef = _M8BlockChunkRefsRead[blockIndex *
            MERKABA_M8_BLOCK_CHUNK_COUNT + address.chunkLocal];
        if (chunkRef == 0u || chunkRef >= MERKABA_REF_EVICTING)
        {
            physicalSlot = 0u;
            return false;
        }
        chunkIndex = chunkRef - 1u;
    }
    uint tileRef = _M8ChunkTileRefsRead[chunkIndex *
        MERKABA_M8_TILES_PER_CHUNK + address.tileLocal];
    if (!M8IsHotRef(tileRef))
    {
        physicalSlot = 0u;
        return false;
    }
    physicalSlot = M8PhysicalSlot(tileRef);
    return true;
}

// Tangent neighbours can cross only the current tile's face or edge. Resolve
// those 3x3x3 tile addresses once per workgroup instead of repeating the
// sparse block/chunk/tile walk for every boundary pin.
groupshared uint gM8BuildNeighbourSlots[27];

uint M8BuildNeighbourSlotIndex(int3 tileOffset)
{
    return (uint)(tileOffset.x + 1) +
        (uint)(tileOffset.y + 1) * 3u +
        (uint)(tileOffset.z + 1) * 9u;
}

int3 M8BuildNeighbourTileOffset(uint lane)
{
    int z = lane < 9u ? -1 : lane < 18u ? 0 : 1;
    uint planeLane = lane - (lane < 9u ? 0u : lane < 18u ? 9u : 18u);
    int y = planeLane < 3u ? -1 : planeLane < 6u ? 0 : 1;
    uint rowLane = planeLane -
        (planeLane < 3u ? 0u : planeLane < 6u ? 3u : 6u);
    return int3((int)rowLane - 1, y, z);
}

bool M8ResolveBuildReadoutAddress(M8ReadoutTileContext context,
    int3 globalCoord, out uint physicalSlot, out uint kernelLocal)
{
    int3 relative = globalCoord - context.tileOrigin;
    int3 tileOffset = int3(relative.x < 0 ? -1 : relative.x >= 8 ? 1 : 0,
        relative.y < 0 ? -1 : relative.y >= 8 ? 1 : 0,
        relative.z < 0 ? -1 : relative.z >= 8 ? 1 : 0);
    int3 tileLocal = relative - tileOffset * 8;
    physicalSlot = gM8BuildNeighbourSlots[
        M8BuildNeighbourSlotIndex(tileOffset)];
    if (physicalSlot == M8_READOUT_INVALID_PHYSICAL_SLOT)
    {
        kernelLocal = 0u;
        return false;
    }
    kernelLocal = (uint)tileLocal.x | ((uint)tileLocal.y << 3u) |
        ((uint)tileLocal.z << 6u);
    return true;
}

bool M8TryLoadReadoutPin(M8ReadoutTileContext context, int3 globalCoord,
    out M8ReadoutPin pin)
{
    M8InitializeReadoutPin(pin);
    uint physicalSlot;
    uint kernelLocal;
    if (!M8ResolveBuildReadoutAddress(context, globalCoord, physicalSlot,
            kernelLocal))
        return false;
    uint vertexIndex;
    if (physicalSlot == context.physicalSlot)
    {
        if (!M8ReadoutLocalVertexIndex(physicalSlot, kernelLocal,
                context.baseVertex, vertexIndex))
            return false;
    }
    else if (!M8ReadoutVertexIndex(physicalSlot, kernelLocal, vertexIndex))
        return false;
    M8DecodeReadoutPin(M8ReadoutEyeMask(physicalSlot, kernelLocal),
        vertexIndex, pin);
    return true;
}

bool M8ReadoutPinsCompatible(M8ReadoutPin mainPin,
    M8ReadoutPin neighbourPin, float3 mainSheet, float chartLength)
{
    if (mainPin.sheet != neighbourPin.sheet)
        return false;
    float3 delta = neighbourPin.center - mainPin.center;
    return dot(delta, delta) <=
            MERKABA_SUPPORT_SIZE * MERKABA_SUPPORT_SIZE + 1.0e-6 &&
        abs(dot(delta, mainSheet)) <= chartLength *
            (MERKABA_HALF_SUPPORT + M8_READOUT_SEAM_OVERLAP);
}

bool M8TryCompatibleReadoutSide(M8ReadoutTileContext context,
    M8ReadoutPin mainPin, float3 mainSheet, float chartLength,
    int3 neighbourCoord,
    out uint vertexIndex, out uint eyeMask)
{
    vertexIndex = 0xffffffffu;
    eyeMask = 0u;
    M8ReadoutPin neighbourPin;
    if (!M8TryLoadReadoutPin(context, neighbourCoord, neighbourPin) ||
        !M8ReadoutPinsCompatible(mainPin, neighbourPin, mainSheet,
            chartLength))
        return false;
    vertexIndex = neighbourPin.vertexIndex;
    eyeMask = neighbourPin.eyeMask;
    return true;
}

float3 M8GlyphEquator(uint index, float3 center, float3 tangent0,
    float3 tangent1)
{
    float3 resultPosition =
        center - tangent1 * M8_READOUT_GLYPH_EQUATOR_EXTENT;
    if (index == 0u)
        resultPosition = center + tangent0 * M8_READOUT_GLYPH_EQUATOR_EXTENT;
    else if (index == 1u)
        resultPosition = center + tangent1 * M8_READOUT_GLYPH_EQUATOR_EXTENT;
    else if (index == 2u)
        resultPosition = center - tangent0 * M8_READOUT_GLYPH_EQUATOR_EXTENT;
    return resultPosition;
}

void M8StoreReadoutTriangle(uint outputIndex, uint primitive,
    uint first, uint second, uint third)
{
    uint baseIndex = outputIndex + primitive * 3u;
    M8StoreReadoutIndex(baseIndex + 0u, first);
    M8StoreReadoutIndex(baseIndex + 1u, second);
    M8StoreReadoutIndex(baseIndex + 2u, third);
}

void M8EmitReadoutGlyph(uint outputTriangle, uint outputVertex,
    int3 globalCoord, KernelState state)
{
    float3 normal = float3(1.0, 0.0, 0.0);
    float signedOffset = 0.0;
    M8DecodeSurfacePlane(state.flags, normal, signedOffset);
    float3 tangent0 = float3(0.0, 1.0, 0.0);
    float3 tangent1 = float3(0.0, 0.0, 1.0);
    M8MeasuredPlaneTangentBasis(normal, tangent0, tangent1);
    float3 center = (float3)globalCoord * MERKABA_LATTICE_STEP +
        normal * signedOffset;
    float3 positiveTip = center + normal * M8_READOUT_GLYPH_TIP_EXTENT;
    float3 negativeTip = center - normal * M8_READOUT_GLYPH_TIP_EXTENT;
    M8StoreReadoutVertex(outputVertex + 0u, positiveTip,
        state.packedColor);
    M8StoreReadoutVertex(outputVertex + 1u, negativeTip,
        state.packedColor);
    M8StoreReadoutVertex(outputVertex + 2u,
        M8GlyphEquator(0u, center, tangent0, tangent1), state.packedColor);
    M8StoreReadoutVertex(outputVertex + 3u,
        M8GlyphEquator(1u, center, tangent0, tangent1), state.packedColor);
    M8StoreReadoutVertex(outputVertex + 4u,
        M8GlyphEquator(2u, center, tangent0, tangent1), state.packedColor);
    M8StoreReadoutVertex(outputVertex + 5u,
        M8GlyphEquator(3u, center, tangent0, tangent1), state.packedColor);
    uint outputIndex = outputTriangle * M8_READOUT_VERTICES_PER_TRIANGLE;
    M8StoreReadoutTriangle(outputIndex, 0u, outputVertex,
        outputVertex + 2u, outputVertex + 3u);
    M8StoreReadoutTriangle(outputIndex, 1u, outputVertex,
        outputVertex + 3u, outputVertex + 4u);
    M8StoreReadoutTriangle(outputIndex, 2u, outputVertex,
        outputVertex + 4u, outputVertex + 5u);
    M8StoreReadoutTriangle(outputIndex, 3u, outputVertex,
        outputVertex + 5u, outputVertex + 2u);
    M8StoreReadoutTriangle(outputIndex, 4u, outputVertex + 1u,
        outputVertex + 3u, outputVertex + 2u);
    M8StoreReadoutTriangle(outputIndex, 5u, outputVertex + 1u,
        outputVertex + 4u, outputVertex + 3u);
    M8StoreReadoutTriangle(outputIndex, 6u, outputVertex + 1u,
        outputVertex + 5u, outputVertex + 4u);
    M8StoreReadoutTriangle(outputIndex, 7u, outputVertex + 1u,
        outputVertex + 2u, outputVertex + 5u);
}

void M8FailReadoutCapacity()
{
    uint ignored;
    _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 1u;
    InterlockedMax(_M8Counters[M8_COUNTER_READOUT_BUILD_STATUS],
        MERKABA_READOUT_FAILED, ignored);
}

groupshared uint4 gM8BuildRecords[M8_SHELL_MAIN_COUNT];
groupshared uint gM8BuildValidWords[M8_FRONT_VALID_WORDS_PER_TILE];
groupshared uint gM8BuildValidPrefixes[M8_FRONT_VALID_WORDS_PER_TILE];
groupshared uint3 gM8BuildLaneTotals[M8_SHELL_GROUP_THREADS];
groupshared uint3 gM8BuildQuadTotals[32];
groupshared uint3 gM8BuildBlockTotals[8];
groupshared uint gM8BuildBaseTriangle;
groupshared uint gM8BuildBaseGlyphVertex;
groupshared uint gM8BuildCanEmit;
groupshared uint gM8BuildValidCount;

uint M8BuildValidWord(uint physicalSlot, uint word)
{
    uint result = 0u;
    uint firstPair = word * 16u;
    [unroll]
    for (uint pairInWord = 0u; pairInWord < 16u; pairInWord++)
    {
        uint mapWord = M8_READOUT_MAP_WORD_BASE + physicalSlot *
            M8_READOUT_MAP_WORDS_PER_TILE + firstPair + pairInWord;
        uint packed = _M8ReadoutIndices.Load(mapWord * 4u);
        uint firstValid = (packed & 65535u) != 0u ? 1u : 0u;
        uint secondValid = (packed >> 16u) != 0u ? 1u : 0u;
        result |= (firstValid | (secondValid << 1u)) <<
            (pairInWord * 2u);
    }
    return result;
}

uint4 M8PackBuildRecord(uint record, uint4 sides)
{
    return uint4(record,
        sides.x | ((sides.y & 255u) << 24u),
        (sides.y >> 8u) | ((sides.z & 65535u) << 16u),
        (sides.z >> 16u) | (sides.w << 8u));
}

uint4 M8BuildSideVertices(uint4 packed)
{
    return uint4(packed.y & M8_READOUT_BUILD_VERTEX_MASK,
        (packed.y >> 24u) | ((packed.z & 65535u) << 8u),
        (packed.z >> 16u) | ((packed.w & 255u) << 16u),
        (packed.w >> 8u) & M8_READOUT_BUILD_VERTEX_MASK);
}

uint M8SelectSetBit(uint bits, uint rank)
{
    uint bitIndex = 0u;
    uint lower = bits & 65535u;
    uint lowerCount = countbits(lower);
    if (rank >= lowerCount)
    {
        rank -= lowerCount;
        bits >>= 16u;
        bitIndex += 16u;
    }
    else bits = lower;
    lower = bits & 255u;
    lowerCount = countbits(lower);
    if (rank >= lowerCount)
    {
        rank -= lowerCount;
        bits >>= 8u;
        bitIndex += 8u;
    }
    else bits = lower;
    lower = bits & 15u;
    lowerCount = countbits(lower);
    if (rank >= lowerCount)
    {
        rank -= lowerCount;
        bits >>= 4u;
        bitIndex += 4u;
    }
    else bits = lower;
    lower = bits & 3u;
    lowerCount = countbits(lower);
    if (rank >= lowerCount)
    {
        rank -= lowerCount;
        bits >>= 2u;
        bitIndex += 2u;
    }
    else bits = lower;
    lowerCount = bits & 1u;
    if (rank >= lowerCount) bitIndex += 1u;
    return bitIndex;
}

uint M8BuildKernelForOrdinal(uint ordinal)
{
    uint word = gM8BuildValidPrefixes[8] <= ordinal ? 8u : 0u;
    if (gM8BuildValidPrefixes[word + 4u] <= ordinal) word += 4u;
    if (gM8BuildValidPrefixes[word + 2u] <= ordinal) word += 2u;
    if (gM8BuildValidPrefixes[word + 1u] <= ordinal) word += 1u;
    uint rank = ordinal - gM8BuildValidPrefixes[word];
    return word * 32u + M8SelectSetBit(gM8BuildValidWords[word], rank);
}

void M8ResolveOneReadoutPin(M8ReadoutTileContext context, uint kernelLocal,
    uint mainVertex, out uint record, out uint4 sideVertices)
{
    record = 0u;
    sideVertices = uint4(M8_READOUT_INVALID_VERTEX,
        M8_READOUT_INVALID_VERTEX, M8_READOUT_INVALID_VERTEX,
        M8_READOUT_INVALID_VERTEX);
    int3 tileLocal = int3(kernelLocal & 7u,
        (kernelLocal >> 3u) & 7u, (kernelLocal >> 6u) & 7u);
    int3 globalCoord = context.tileOrigin + tileLocal;
    M8ReadoutPin mainPin;
    M8InitializeReadoutPin(mainPin);
    M8DecodeReadoutPin(M8ReadoutEyeMask(context.physicalSlot, kernelLocal),
        mainVertex, mainPin);

    int3 mainSheet = M8DecodeReadoutSheetCode(mainPin.sheet);
    int nonZero = abs(mainSheet.x) + abs(mainSheet.y) + abs(mainSheet.z);
    float chartLength = nonZero == 1 ? 1.0 :
        nonZero == 2 ? 1.41421356237 : 1.73205080757;
    int3 tangent0 = 0;
    int3 tangent1 = 0;
    MerkabaGridSheetTangents(mainSheet, tangent0, tangent1);

    uint negative0Vertex;
    uint positive0Vertex;
    uint negative1Vertex;
    uint positive1Vertex;
    uint negative0Eyes;
    uint positive0Eyes;
    uint negative1Eyes;
    uint positive1Eyes;
    bool negative0 = M8TryCompatibleReadoutSide(context, mainPin,
        (float3)mainSheet, chartLength, globalCoord - tangent0,
        negative0Vertex, negative0Eyes);
    bool positive0 = M8TryCompatibleReadoutSide(context, mainPin,
        (float3)mainSheet, chartLength, globalCoord + tangent0,
        positive0Vertex, positive0Eyes);
    bool negative1 = M8TryCompatibleReadoutSide(context, mainPin,
        (float3)mainSheet, chartLength, globalCoord - tangent1,
        negative1Vertex, negative1Eyes);
    bool positive1 = M8TryCompatibleReadoutSide(context, mainPin,
        (float3)mainSheet, chartLength, globalCoord + tangent1,
        positive1Vertex, positive1Eyes);

    uint sideMask = (negative0 ? 1u : 0u) |
        (positive0 ? 2u : 0u) | (negative1 ? 4u : 0u) |
        (positive1 ? 8u : 0u);
    bool positive = positive0 && positive1 &&
        (mainPin.eyeMask | positive0Eyes | positive1Eyes) != 0u;
    bool negative = negative0 && negative1 &&
        (mainPin.eyeMask | negative0Eyes | negative1Eyes) != 0u;
    bool glyph = mainPin.eyeMask != 0u &&
        (countbits(sideMask) < 3u || (!positive && !negative));
    uint flags = glyph ? M8_READOUT_BUILD_GLYPH :
        ((positive ? M8_READOUT_BUILD_POSITIVE : 0u) |
        (negative ? M8_READOUT_BUILD_NEGATIVE : 0u));
    if (flags == 0u) return;
    record = kernelLocal | flags;
    sideVertices = uint4(negative0Vertex, positive0Vertex,
        negative1Vertex, positive1Vertex);
}

uint3 M8BuildRecordTotals(uint record)
{
    uint flags = record & M8_READOUT_BUILD_FLAGS_MASK;
    bool glyph = (flags & M8_READOUT_BUILD_GLYPH) != 0u;
    uint triangles = glyph ? M8_READOUT_GLYPH_TRIANGLES :
        ((flags & M8_READOUT_BUILD_POSITIVE) != 0u ? 1u : 0u) +
        ((flags & M8_READOUT_BUILD_NEGATIVE) != 0u ? 1u : 0u);
    return uint3(triangles, flags != 0u ? 1u : 0u, glyph ? 1u : 0u);
}

uint3 M8BuildLanePrefix(uint thread)
{
    uint quad = thread >> 2u;
    uint block = quad >> 2u;
    uint3 prefix = 0u;
    if (block > 0u) prefix += gM8BuildBlockTotals[0];
    if (block > 1u) prefix += gM8BuildBlockTotals[1];
    if (block > 2u) prefix += gM8BuildBlockTotals[2];
    if (block > 3u) prefix += gM8BuildBlockTotals[3];
    if (block > 4u) prefix += gM8BuildBlockTotals[4];
    if (block > 5u) prefix += gM8BuildBlockTotals[5];
    if (block > 6u) prefix += gM8BuildBlockTotals[6];

    uint firstQuad = block * 4u;
    uint quadInBlock = quad & 3u;
    if (quadInBlock > 0u) prefix += gM8BuildQuadTotals[firstQuad];
    if (quadInBlock > 1u) prefix += gM8BuildQuadTotals[firstQuad + 1u];
    if (quadInBlock > 2u) prefix += gM8BuildQuadTotals[firstQuad + 2u];

    uint firstLane = quad * 4u;
    uint laneInQuad = thread & 3u;
    if (laneInQuad > 0u) prefix += gM8BuildLaneTotals[firstLane];
    if (laneInQuad > 1u) prefix += gM8BuildLaneTotals[firstLane + 1u];
    if (laneInQuad > 2u) prefix += gM8BuildLaneTotals[firstLane + 2u];
    return prefix;
}

void M8EmitOneReadoutPin(M8ReadoutTileContext context, uint ordinal,
    uint outputTriangle, uint glyphVertex)
{
    uint4 packed = gM8BuildRecords[ordinal];
    uint record = packed.x;
    uint flags = record & M8_READOUT_BUILD_FLAGS_MASK;
    if (flags == 0u) return;
    uint4 sides = M8BuildSideVertices(packed);
    uint kernelLocal = record & M8_READOUT_BUILD_KERNEL_MASK;
    uint mainVertex = context.baseVertex + ordinal;
    if ((flags & M8_READOUT_BUILD_GLYPH) != 0u)
    {
        int3 tileLocal = int3(kernelLocal & 7u,
            (kernelLocal >> 3u) & 7u, (kernelLocal >> 6u) & 7u);
        KernelState state = M8LoadKernelStateRead(context.physicalSlot,
            kernelLocal);
        M8EmitReadoutGlyph(outputTriangle, glyphVertex,
            context.tileOrigin + tileLocal, state);
        return;
    }

    uint outputIndex = outputTriangle * M8_READOUT_VERTICES_PER_TRIANGLE;
    if ((flags & M8_READOUT_BUILD_POSITIVE) != 0u)
    {
        M8StoreReadoutIndex(outputIndex + 0u, mainVertex);
        M8StoreReadoutIndex(outputIndex + 1u,
            sides.y & M8_READOUT_BUILD_VERTEX_MASK);
        M8StoreReadoutIndex(outputIndex + 2u,
            sides.w & M8_READOUT_BUILD_VERTEX_MASK);
        outputIndex += 3u;
    }
    if ((flags & M8_READOUT_BUILD_NEGATIVE) != 0u)
    {
        M8StoreReadoutIndex(outputIndex + 0u, mainVertex);
        M8StoreReadoutIndex(outputIndex + 1u,
            sides.x & M8_READOUT_BUILD_VERTEX_MASK);
        M8StoreReadoutIndex(outputIndex + 2u,
            sides.z & M8_READOUT_BUILD_VERTEX_MASK);
    }
}

[numthreads(8, 8, 2)]
void BuildReadoutVertices(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint physicalSlot = _M8VisibleTiles[groupId.x].x;
    uint2 vertexRecord =
        _M8VisibleTiles[M8_FRONT_VERTEX_BASE + physicalSlot];
    bool tileReady = _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] ==
            MERKABA_READOUT_BUILDING &&
        vertexRecord.y == _M8Counters[M8_COUNTER_FRAME_EPOCH];
    M8ReadoutTileContext context = M8LoadReadoutTileContext(physicalSlot,
        vertexRecord.x);

    if (thread < 27u)
    {
        int3 tileOffset = M8BuildNeighbourTileOffset(thread);
        uint neighbourSlot;
        uint ignoredKernel;
        bool reachable = abs(tileOffset.x) + abs(tileOffset.y) +
            abs(tileOffset.z) <= 2;
        bool resolved = tileReady && reachable &&
            M8ResolveReadoutAddress(context,
                context.tileOrigin + tileOffset * 8, neighbourSlot,
                ignoredKernel);
        gM8BuildNeighbourSlots[thread] = resolved ? neighbourSlot :
            M8_READOUT_INVALID_PHYSICAL_SLOT;
    }
    if (thread < M8_FRONT_VALID_WORDS_PER_TILE)
        gM8BuildValidWords[thread] = tileReady
            ? M8BuildValidWord(physicalSlot, thread) : 0u;
    GroupMemoryBarrierWithGroupSync();

    if (thread < M8_FRONT_VALID_WORDS_PER_TILE)
    {
        uint prefix = 0u;
        [unroll]
        for (uint word = 0u; word < M8_FRONT_VALID_WORDS_PER_TILE; word++)
        {
            if (word >= thread) break;
            prefix += countbits(gM8BuildValidWords[word]);
        }
        gM8BuildValidPrefixes[thread] = prefix;
        if (thread == M8_FRONT_VALID_WORDS_PER_TILE - 1u)
            gM8BuildValidCount = prefix +
                countbits(gM8BuildValidWords[thread]);
    }
    GroupMemoryBarrierWithGroupSync();

    uint3 laneTotal = 0u;
    uint firstOrdinal = thread * 4u;
    [unroll]
    for (uint local = 0u; local < 4u; local++)
    {
        uint ordinal = firstOrdinal + local;
        uint record = 0u;
        uint4 sideVertices = uint4(M8_READOUT_INVALID_VERTEX,
            M8_READOUT_INVALID_VERTEX, M8_READOUT_INVALID_VERTEX,
            M8_READOUT_INVALID_VERTEX);
        if (ordinal < gM8BuildValidCount)
        {
            uint kernelLocal = M8BuildKernelForOrdinal(ordinal);
            M8ResolveOneReadoutPin(context, kernelLocal,
                context.baseVertex + ordinal, record, sideVertices);
        }
        gM8BuildRecords[ordinal] =
            M8PackBuildRecord(record, sideVertices);
        laneTotal += M8BuildRecordTotals(record);
    }
    gM8BuildLaneTotals[thread] = laneTotal;
    GroupMemoryBarrierWithGroupSync();

    if (thread < 32u)
    {
        uint firstLane = thread * 4u;
        gM8BuildQuadTotals[thread] =
            gM8BuildLaneTotals[firstLane] +
            gM8BuildLaneTotals[firstLane + 1u] +
            gM8BuildLaneTotals[firstLane + 2u] +
            gM8BuildLaneTotals[firstLane + 3u];
    }
    GroupMemoryBarrierWithGroupSync();

    if (thread < 8u)
    {
        uint firstQuad = thread * 4u;
        gM8BuildBlockTotals[thread] =
            gM8BuildQuadTotals[firstQuad] +
            gM8BuildQuadTotals[firstQuad + 1u] +
            gM8BuildQuadTotals[firstQuad + 2u] +
            gM8BuildQuadTotals[firstQuad + 3u];
    }
    GroupMemoryBarrierWithGroupSync();

    if (thread == 0u)
    {
        uint3 total = gM8BuildBlockTotals[0] +
            gM8BuildBlockTotals[1] + gM8BuildBlockTotals[2] +
            gM8BuildBlockTotals[3] + gM8BuildBlockTotals[4] +
            gM8BuildBlockTotals[5] + gM8BuildBlockTotals[6] +
            gM8BuildBlockTotals[7];
        uint triangleCount = total.x;
        uint patchCount = total.y;
        uint glyphVertices = total.z * M8_READOUT_GLYPH_VERTICES;
        gM8BuildCanEmit = 0u;
        uint ignored;
        if (tileReady && triangleCount != 0u)
            InterlockedAdd(
                _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES],
                triangleCount, gM8BuildBaseTriangle);
        else
            gM8BuildBaseTriangle = 0u;
        if (tileReady && glyphVertices != 0u)
            InterlockedAdd(
                _M8Counters[M8_COUNTER_READOUT_EMITTED_VERTICES],
                glyphVertices, gM8BuildBaseGlyphVertex);
        else
            gM8BuildBaseGlyphVertex = 0u;
        uint totalVertices =
            MERKABA_M8_READOUT_VERTICES_PER_BUFFER * 2u;
        bool trianglesFit = gM8BuildBaseTriangle <=
                MERKABA_M8_READOUT_TRIANGLE_CAPACITY &&
            triangleCount <= MERKABA_M8_READOUT_TRIANGLE_CAPACITY -
                gM8BuildBaseTriangle;
        bool verticesFit = gM8BuildBaseGlyphVertex <= totalVertices &&
            glyphVertices <= totalVertices - gM8BuildBaseGlyphVertex;
        if (tileReady && (!trianglesFit || !verticesFit))
            M8FailReadoutCapacity();
        else if (tileReady)
        {
            gM8BuildCanEmit = 1u;
            if (patchCount != 0u)
                InterlockedAdd(
                    _M8Counters[M8_COUNTER_READOUT_EMITTED_PATCHES],
                    patchCount, ignored);
            if (triangleCount != 0u)
                InterlockedAdd(
                    _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES],
                    triangleCount, ignored);
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gM8BuildCanEmit == 0u) return;

    uint3 prefix = M8BuildLanePrefix(thread);
    uint outputTriangle = gM8BuildBaseTriangle + prefix.x;
    uint glyphVertex = gM8BuildBaseGlyphVertex +
        prefix.z * M8_READOUT_GLYPH_VERTICES;
    [unroll]
    for (uint emitLocal = 0u; emitLocal < 4u; emitLocal++)
    {
        uint ordinal = firstOrdinal + emitLocal;
        uint3 recordTotal = M8BuildRecordTotals(
            gM8BuildRecords[ordinal].x);
        M8EmitOneReadoutPin(context, ordinal, outputTriangle,
            glyphVertex);
        outputTriangle += recordTotal.x;
        glyphVertex += recordTotal.z * M8_READOUT_GLYPH_VERTICES;
    }
}

float4 M8MeshWorldToClip(uint eye, float3 worldPosition)
{
    if (eye == 0u)
        return mul(_M8MeshDepthProj0,
            mul(_M8MeshDepthView0, float4(worldPosition, 1.0)));
    return mul(_M8MeshDepthProj1,
        mul(_M8MeshDepthView1, float4(worldPosition, 1.0)));
}

float3 M8MeshDepthToWorld(uint eye, float2 uv, float depth)
{
    float4 clip = float4(float3(uv, depth) * 2.0 - 1.0, 1.0);
    float4 world = eye == 0u
        ? mul(_M8MeshDepthViewInv0, mul(_M8MeshDepthProjInv0, clip))
        : mul(_M8MeshDepthViewInv1, mul(_M8MeshDepthProjInv1, clip));
    return world.xyz / world.w;
}

float3 M8MeshEyePosition(uint eye)
{
    return eye == 0u
        ? float3(_M8MeshDepthViewInv0[0][3],
            _M8MeshDepthViewInv0[1][3], _M8MeshDepthViewInv0[2][3])
        : float3(_M8MeshDepthViewInv1[0][3],
            _M8MeshDepthViewInv1[1][3], _M8MeshDepthViewInv1[2][3]);
}

float3 M8MeshNormalToWorld(float3 gridNormal)
{
    return normalize(mul(transpose((float3x3)_MerkabaWorldToGrid),
        gridNormal));
}

bool M8ProjectOneMeshPin(uint eye, uint handle, float3 pinGrid,
    float3 normalGrid)
{
    float3 pinWorld = mul(_MerkabaGridToWorld,
        float4(pinGrid, 1.0)).xyz;
    float4 clip = M8MeshWorldToClip(eye, pinWorld);
    if (clip.w <= 0.0) return false;
    float2 uv = clip.xy / clip.w * 0.5 + 0.5;
    if (any(uv <= 0.0) || any(uv >= 1.0)) return false;
    uint2 pixel = min((uint2)(uv * (float2)_M8MeshDepthSize),
        _M8MeshDepthSize - 1u);
    float depth = _SrcDepth.Load(int4(pixel, (int)eye, 0));
    if (depth <= 0.0 || depth >= 1.0) return false;
    float2 centerUv = (float2(pixel) + 0.5) /
        (float2)_M8MeshDepthSize;
    float3 depthWorld = M8MeshDepthToWorld(eye, centerUv, depth);
    float3 eyeWorld = M8MeshEyePosition(eye);
    float3 toDepth = depthWorld - eyeWorld;
    float depthDistance = length(toDepth);
    if (depthDistance <= 1.0e-6) return false;
    float3 ray = toDepth / depthDistance;
    float3 normalWorld = M8MeshNormalToWorld(normalGrid);
    float denominator = dot(ray, normalWorld);
    if (abs(denominator) <= 1.0e-6) return false;
    float planeDistance = dot(pinWorld - eyeWorld, normalWorld) /
        denominator;
    if (planeDistance <= 0.0) return false;
    float error = abs(planeDistance - depthDistance);
    if (error > MERKABA_HALF_SUPPORT) return false;
    // Reserve 0xffffffff as the empty scratch sentinel even for the highest
    // physical slot and kernel-local handle.
    uint errorRank = min(126u, (uint)round(
        error / MERKABA_HALF_SUPPORT * 127.0));
    uint depthClass = planeDistance <= depthDistance ? 0u : 128u;
    uint rank = ((depthClass + errorRank) << 24u) |
        (handle & 0x00ffffffu);
    uint pixelIndex = pixel.x + pixel.y * _M8MeshDepthSize.x;
    uint ignored;
    if (eye == 0u)
    {
        InterlockedMin(_M8ReadoutVertices0[
            M8_MESH_SCRATCH_BASE + pixelIndex].packedColor, rank, ignored);
        InterlockedMin(_M8ReadoutVertices0[
            M8_MESH_ENVELOPE_BASE + 0u].packedColor, pixel.x, ignored);
        InterlockedMin(_M8ReadoutVertices0[
            M8_MESH_ENVELOPE_BASE + 1u].packedColor, pixel.y, ignored);
        InterlockedMax(_M8ReadoutVertices0[
            M8_MESH_ENVELOPE_BASE + 2u].packedColor, pixel.x, ignored);
        InterlockedMax(_M8ReadoutVertices0[
            M8_MESH_ENVELOPE_BASE + 3u].packedColor, pixel.y, ignored);
    }
    else
    {
        InterlockedMin(_M8ReadoutVertices1[
            M8_MESH_SCRATCH_BASE + pixelIndex].packedColor, rank, ignored);
        InterlockedMin(_M8ReadoutVertices1[
            M8_MESH_ENVELOPE_BASE + 0u].packedColor, pixel.x, ignored);
        InterlockedMin(_M8ReadoutVertices1[
            M8_MESH_ENVELOPE_BASE + 1u].packedColor, pixel.y, ignored);
        InterlockedMax(_M8ReadoutVertices1[
            M8_MESH_ENVELOPE_BASE + 2u].packedColor, pixel.x, ignored);
        InterlockedMax(_M8ReadoutVertices1[
            M8_MESH_ENVELOPE_BASE + 3u].packedColor, pixel.y, ignored);
    }
    return true;
}

[numthreads(8, 8, 2)]
void ProjectReadoutMeshPins(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    if (_M8MeshReadoutEnabled == 0u ||
        _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] !=
            MERKABA_READOUT_BUILDING)
        return;
    uint physicalSlot = _M8VisibleTilesRead[groupId.x].x;
    if (thread == 0u)
    {
        uint ignored;
        InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_CONSIDERED],
            M8LoadTileMetaRead(physicalSlot).z, ignored);
    }
    [loop]
    for (uint batch = 0u; batch < 4u; batch++)
    {
        uint kernelLocal = thread + batch * M8_SHELL_GROUP_THREADS;
        uint bit = 1u << (kernelLocal & 31u);
        if ((_M8TileBitsRead[M8TileWordIndex(physicalSlot,
                kernelLocal >> 5u)].x & bit) == 0u)
            continue;
        KernelState state = M8LoadKernelStateRead(physicalSlot, kernelLocal);
        if ((state.flags & MERKABA_OCCUPIED_FLAG) == 0u ||
            !M8HasSurfacePlane(state.flags))
            continue;
        float3 normalGrid;
        float signedOffset;
        M8DecodeSurfacePlane(state.flags, normalGrid, signedOffset);
        int3 globalCoord = M8GlobalKernelCoordRead(physicalSlot, kernelLocal);
        float3 pinGrid = (float3)globalCoord * MERKABA_LATTICE_STEP +
            normalGrid * signedOffset;
        uint handle = (physicalSlot << 9u) | kernelLocal;
        bool projectedLeft = M8ProjectOneMeshPin(0u, handle, pinGrid,
            normalGrid);
        bool projectedRight = M8ProjectOneMeshPin(1u, handle, pinGrid,
            normalGrid);
        if (projectedLeft || projectedRight)
        {
            uint ignored;
            InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_PLANE_VALID],
                1u, ignored);
        }
    }
}

struct M8MeshVertex
{
    float3 gridPosition;
    float3 worldPosition;
    uint packedColor;
    uint valid;
};

uint M8MeshRank(uint eye, uint2 pixel)
{
    uint index = M8_MESH_SCRATCH_BASE + pixel.x +
        pixel.y * _M8MeshDepthSize.x;
    return eye == 0u ? _M8ReadoutVertices0[index].packedColor :
        _M8ReadoutVertices1[index].packedColor;
}

M8MeshVertex M8LoadMeshVertex(uint eye, uint2 pixel)
{
    M8MeshVertex result = (M8MeshVertex)0;
    float depth = _SrcDepth.Load(int4(pixel, (int)eye, 0));
    if (depth <= 0.0 || depth >= 1.0) return result;
    float2 uv = (float2(pixel) + 0.5) / (float2)_M8MeshDepthSize;
    float3 rawWorld = M8MeshDepthToWorld(eye, uv, depth);
    if (any(rawWorld != rawWorld) || any(abs(rawWorld) >= 1.0e20))
        return result;
    float3 eyeWorld = M8MeshEyePosition(eye);
    float3 toRaw = rawWorld - eyeWorld;
    float rawDistance = length(toRaw);
    if (rawDistance <= 1.0e-6) return result;
    float3 ray = toRaw / rawDistance;
    // Reuse the existing sub-millimetre seam guard so an inferred bridge at
    // the frozen environment depth remains visible under the later dynamic
    // occlusion sample. Exact M8-plane anchors are never biased.
    result.worldPosition = eyeWorld + ray * max(1.0e-6,
        rawDistance - M8_READOUT_SEAM_OVERLAP);
    result.gridPosition = mul(_MerkabaWorldToGrid,
        float4(result.worldPosition, 1.0)).xyz;
    result.packedColor = M8_MESH_NEUTRAL_COLOR;
    result.valid = 1u;

    uint rank = M8MeshRank(eye, pixel);
    if (rank == M8_MESH_INVALID_RANK) return result;
    uint handle = rank & 0x00ffffffu;
    uint physicalSlot = handle >> 9u;
    uint kernelLocal = handle & 511u;
    KernelState state = M8LoadKernelStateRead(physicalSlot, kernelLocal);
    if ((state.flags & MERKABA_OCCUPIED_FLAG) == 0u ||
        !M8HasSurfacePlane(state.flags))
        return result;
    float3 normalGrid;
    float signedOffset;
    M8DecodeSurfacePlane(state.flags, normalGrid, signedOffset);
    int3 globalCoord = M8GlobalKernelCoordRead(physicalSlot, kernelLocal);
    float3 pinGrid = (float3)globalCoord * MERKABA_LATTICE_STEP +
        normalGrid * signedOffset;
    float3 pinWorld = mul(_MerkabaGridToWorld,
        float4(pinGrid, 1.0)).xyz;
    float3 normalWorld = M8MeshNormalToWorld(normalGrid);
    float denominator = dot(ray, normalWorld);
    if (abs(denominator) <= 1.0e-6) return result;
    float planeDistance = dot(pinWorld - eyeWorld, normalWorld) /
        denominator;
    if (planeDistance <= 0.0 ||
        abs(planeDistance - rawDistance) > MERKABA_HALF_SUPPORT)
        return result;
    result.worldPosition = eyeWorld + ray * planeDistance;
    result.gridPosition = mul(_MerkabaWorldToGrid,
        float4(result.worldPosition, 1.0)).xyz;
    result.packedColor = state.packedColor;
    return result;
}

bool M8MeshTriangleValid(M8MeshVertex a, M8MeshVertex b, M8MeshVertex c)
{
    if ((a.valid & b.valid & c.valid) == 0u) return false;
    float3 ab = a.worldPosition - b.worldPosition;
    float3 bc = b.worldPosition - c.worldPosition;
    float3 ca = c.worldPosition - a.worldPosition;
    float maximumEdge2 = M8_MESH_MAX_EDGE_LENGTH *
        M8_MESH_MAX_EDGE_LENGTH;
    return dot(ab, ab) <= maximumEdge2 &&
        dot(bc, bc) <= maximumEdge2 && dot(ca, ca) <= maximumEdge2;
}

bool M8MeshInsideEnvelope(uint eye, uint2 cell)
{
    uint minX, minY, maxX, maxY;
    if (eye == 0u)
    {
        minX = _M8ReadoutVertices0[
            M8_MESH_ENVELOPE_BASE + 0u].packedColor;
        minY = _M8ReadoutVertices0[
            M8_MESH_ENVELOPE_BASE + 1u].packedColor;
        maxX = _M8ReadoutVertices0[
            M8_MESH_ENVELOPE_BASE + 2u].packedColor;
        maxY = _M8ReadoutVertices0[
            M8_MESH_ENVELOPE_BASE + 3u].packedColor;
    }
    else
    {
        minX = _M8ReadoutVertices1[
            M8_MESH_ENVELOPE_BASE + 0u].packedColor;
        minY = _M8ReadoutVertices1[
            M8_MESH_ENVELOPE_BASE + 1u].packedColor;
        maxX = _M8ReadoutVertices1[
            M8_MESH_ENVELOPE_BASE + 2u].packedColor;
        maxY = _M8ReadoutVertices1[
            M8_MESH_ENVELOPE_BASE + 3u].packedColor;
    }
    return minX != M8_MESH_INVALID_RANK &&
        cell.x + 1u >= minX && cell.x <= maxX &&
        cell.y + 1u >= minY && cell.y <= maxY;
}

void M8StoreMeshVertex(uint eye, uint index, M8MeshVertex vertex)
{
    MerkabaReadoutVertex output;
    output.gridPosition = vertex.gridPosition;
    output.packedColor = vertex.packedColor;
    if (eye == 0u) _M8ReadoutVertices0[index] = output;
    else _M8ReadoutVertices1[index] = output;
}

void M8StoreMeshTriangle(uint eye, uint outputVertex, M8MeshVertex a,
    M8MeshVertex b, M8MeshVertex c)
{
    if (!M8MeshTriangleValid(a, b, c))
    {
        M8MeshVertex degenerate = (M8MeshVertex)0;
        degenerate.packedColor = M8_MESH_NEUTRAL_COLOR;
        M8StoreMeshVertex(eye, outputVertex + 0u, degenerate);
        M8StoreMeshVertex(eye, outputVertex + 1u, degenerate);
        M8StoreMeshVertex(eye, outputVertex + 2u, degenerate);
        return;
    }
    M8StoreMeshVertex(eye, outputVertex + 0u, a);
    M8StoreMeshVertex(eye, outputVertex + 1u, b);
    M8StoreMeshVertex(eye, outputVertex + 2u, c);
}

void M8BuildMeshEye(uint eye, uint2 cell, uint outputVertex)
{
    if (!M8MeshInsideEnvelope(eye, cell))
    {
        M8MeshVertex degenerate = (M8MeshVertex)0;
        degenerate.packedColor = M8_MESH_NEUTRAL_COLOR;
        M8StoreMeshTriangle(eye, outputVertex, degenerate, degenerate,
            degenerate);
        M8StoreMeshTriangle(eye, outputVertex + 3u, degenerate, degenerate,
            degenerate);
        return;
    }
    M8MeshVertex corner00 = M8LoadMeshVertex(eye, cell);
    M8MeshVertex corner10 = M8LoadMeshVertex(eye, cell + uint2(1u, 0u));
    M8MeshVertex corner11 = M8LoadMeshVertex(eye, cell + uint2(1u, 1u));
    M8MeshVertex corner01 = M8LoadMeshVertex(eye, cell + uint2(0u, 1u));
    M8StoreMeshTriangle(eye, outputVertex, corner00, corner10, corner11);
    M8StoreMeshTriangle(eye, outputVertex + 3u,
        corner00, corner11, corner01);
}

[numthreads(8, 8, 1)]
void BuildReadoutMesh(uint3 id : SV_DispatchThreadID)
{
    if (_M8MeshReadoutEnabled == 0u ||
        _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] !=
            MERKABA_READOUT_BUILDING)
        return;
    bool validSize = all(_M8MeshDepthSize >= 2u) &&
        all(_M8MeshDepthSize <= M8_MESH_MAX_DIMENSION);
    if (all(id == 0u))
    {
        if (!validSize)
        {
            _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 1u;
            _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
                MERKABA_READOUT_FAILED;
        }
        else if (_M8Counters[M8_COUNTER_READOUT_PLANE_VALID] == 0u)
        {
            _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES] = 0u;
            _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES] = 0u;
        }
        else
        {
            uint cells = (_M8MeshDepthSize.x - 1u) *
                (_M8MeshDepthSize.y - 1u);
            uint triangles = cells * 2u;
            _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES] = triangles;
            _M8Counters[M8_COUNTER_READOUT_EMITTED_PATCHES] = cells;
            _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES] = triangles;
        }
    }
    if (!validSize ||
        _M8Counters[M8_COUNTER_READOUT_PLANE_VALID] == 0u ||
        id.x + 1u >= _M8MeshDepthSize.x ||
        id.y + 1u >= _M8MeshDepthSize.y)
        return;
    uint cell = id.x + id.y * (_M8MeshDepthSize.x - 1u);
    uint outputVertex = cell * 6u;
    M8BuildMeshEye(0u, id.xy, outputVertex);
    M8BuildMeshEye(1u, id.xy, outputVertex);
}

[numthreads(1, 1, 1)]
void FinalizeReadout(uint id : SV_DispatchThreadID)
{
    uint status = _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS];
    if (status == MERKABA_READOUT_SKIPPED ||
        status == MERKABA_READOUT_FAILED)
        return;

    uint logical =
        _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES];
    uint emitted =
        _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES];
    if (status != MERKABA_READOUT_BUILDING ||
        _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] != 0u ||
        logical > MERKABA_M8_READOUT_TRIANGLE_CAPACITY ||
        emitted != logical)
    {
        // A build mismatch is an invariant violation. Never publish it and
        // preserve the last-good draw arguments.
        _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
            MERKABA_READOUT_EMIT_FAILED;
        return;
    }

    _M8DrawArgs[0] = logical * M8_READOUT_VERTICES_PER_TRIANGLE;
    _M8DrawArgs[1] = 2u;
    _M8DrawArgs[2] = 0u;
    _M8DrawArgs[3] = 0u;
    _M8DrawArgs[4] = 0u;
    _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
        _M8Counters[M8_COUNTER_READOUT_UNRESOLVED] != 0u
        ? MERKABA_READOUT_PARTIAL_PUBLISHED
        : MERKABA_READOUT_PUBLISHED;
}
