#pragma kernel ResetReadoutBuild
#pragma kernel QueryM8Readout
#pragma kernel PrepareReadoutBuild
#pragma kernel CompileReadoutVertices
#pragma kernel FinalizeReadout

#include "MerkabaCanonicalGeometry.generated.hlsl"
#include "MerkabaWorld.hlsl"

#define MERKABA_LATTICE_STEP 0.025
#define MERKABA_HALF_SUPPORT 0.025
#define MERKABA_OCCUPIED_FLAG 1u

struct MerkabaReadoutVertex
{
    float3 gridPosition;
    uint packedColor;
};

RWStructuredBuffer<uint> _M8VisibleTiles;
StructuredBuffer<uint> _M8VisibleTilesRead;
RWStructuredBuffer<MerkabaReadoutVertex> _M8ReadoutVertices0;
RWStructuredBuffer<MerkabaReadoutVertex> _M8ReadoutVertices1;
RWStructuredBuffer<uint> _M8FrameDispatchArgs;
RWStructuredBuffer<uint> _M8DrawArgs;

float4x4 _MerkabaGridToWorld;
float4x4 _MerkabaWorldToGrid;
float4 _M8DrawPlanes[12];
float4 _M8DependencyPlanes[12];
float3 _M8EyeGridPositions[2];
float _M8GridWindingSign;
float _M8ReadoutTranslationGuardGrid;
float3 _M8CameraWorld;
float _M8RenderDistance;
float _M8WarmDistance;
float _M8DependencyDistance;
int3 _M8QueryCenterBlock;
int _M8QueryBlockRadius;
int _M8QueryBlockSide;

bool M8AabbIntersectsDistance(int3 globalMin, int span, float distance)
{
    return MerkabaM8AabbIntersectsDistance(globalMin, span, distance,
        _M8CameraWorld, _MerkabaGridToWorld, _MerkabaWorldToGrid,
        MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
}

uint M8DistanceChildMask(int3 parentMin, int parentSpan, float distance)
{
    return MerkabaM8DistanceChildMask(parentMin, parentSpan, distance,
        _M8CameraWorld, _MerkabaGridToWorld, _MerkabaWorldToGrid,
        MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
}

uint M8EyeFrustumChildMask(int3 parentMin, int parentSpan, uint eye)
{
    uint support = 255u;
    [unroll]
    for (uint plane = 0u; plane < 6u; plane++)
        support &= MerkabaM8PlaneChildMask(parentMin, parentSpan,
            _M8DrawPlanes[eye * 6u + plane], _MerkabaGridToWorld,
            MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
    return support;
}

uint M8EyeDependencyChildMask(int3 parentMin, int parentSpan, uint eye)
{
    uint support = 255u;
    [unroll]
    for (uint plane = 0u; plane < 6u; plane++)
        support &= MerkabaM8PlaneChildMask(parentMin, parentSpan,
            _M8DependencyPlanes[eye * 6u + plane], _MerkabaGridToWorld,
            MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
    return support;
}

uint M8DrawChildMask(int3 parentMin, int parentSpan)
{
    uint stereo = M8EyeFrustumChildMask(parentMin, parentSpan, 0u) |
        M8EyeFrustumChildMask(parentMin, parentSpan, 1u);
    return stereo & M8DistanceChildMask(parentMin, parentSpan,
        _M8RenderDistance);
}

uint M8DependencyChildMask(int3 parentMin, int parentSpan)
{
    uint stereo = M8EyeDependencyChildMask(parentMin, parentSpan, 0u) |
        M8EyeDependencyChildMask(parentMin, parentSpan, 1u);
    return stereo & M8DistanceChildMask(parentMin, parentSpan,
        _M8DependencyDistance);
}

void M8RequestWarmLoad(uint tileRefIndex, uint chunkIndex, uint tileLocal,
    bool lateDraw)
{
    M8QueueColdTileLoad(tileRefIndex, chunkIndex, tileLocal);
    if (lateDraw) M8CounterIncrement(M8_COUNTER_LATE_DRAW_COLD_MISSES);
}

[numthreads(1, 1, 1)]
void ResetReadoutBuild(uint id : SV_DispatchThreadID)
{
    _M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT] = 0u;
    _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES] = 0u;
    _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 0u;
    _M8Counters[M8_COUNTER_LATE_DRAW_COLD_MISSES] = 0u;
    _M8Counters[M8_COUNTER_CANDIDATE_BLOCKS] = 0u;
    _M8Counters[M8_COUNTER_HASH_HIT_BLOCKS] = 0u;
    _M8Counters[M8_COUNTER_VISIBLE_CHUNKS] = 0u;
    _M8Counters[M8_COUNTER_OCCUPIED_CONSIDERED] = 0u;
    _M8Counters[M8_COUNTER_PRIMITIVES_BEFORE_FACING] = 0u;
    _M8Counters[M8_COUNTER_PRIMITIVES_REJECTED] = 0u;
    _M8Counters[M8_COUNTER_READOUT_UNRESOLVED] = 0u;
    _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
        MERKABA_READOUT_BUILDING;
    _M8Counters[M8_COUNTER_FRAME_EPOCH] += 1u;
    _M8FrameDispatchArgs[0] = 0u;
    _M8FrameDispatchArgs[1] = 8u;
    _M8FrameDispatchArgs[2] = 1u;
}

groupshared uint gFrameBlockRef;
groupshared int3 gFrameBlockMin;
groupshared uint gFrameWarm4;
groupshared uint gFrameDraw4;
groupshared uint gFrameDependency4;
groupshared uint gFrameWarm3[8];
groupshared uint gFrameDraw3[8];
groupshared uint gFrameDependency3[8];

[numthreads(64, 1, 1)]
void QueryM8Readout(uint3 groupId : SV_GroupID, uint thread : SV_GroupIndex)
{
    uint linearBlockIndex = groupId.x;
    if (thread == 0u)
    {
        gFrameBlockRef = 0u;
        gFrameWarm4 = 0u;
        gFrameDraw4 = 0u;
        gFrameDependency4 = 0u;
        uint side = (uint)_M8QueryBlockSide;
        if (linearBlockIndex < side * side * side)
        {
            int3 offset;
            offset.x = (int)(linearBlockIndex % side) - _M8QueryBlockRadius;
            offset.y = (int)((linearBlockIndex / side) % side) -
                _M8QueryBlockRadius;
            offset.z = (int)(linearBlockIndex / (side * side)) -
                _M8QueryBlockRadius;
            int3 blockCoord = _M8QueryCenterBlock + offset;
            gFrameBlockMin = blockCoord * MERKABA_M8_BLOCK_KERNEL_SPAN;
            M8CounterIncrement(M8_COUNTER_CANDIDATE_BLOCKS);
            if (M8AabbIntersectsDistance(gFrameBlockMin,
                MERKABA_M8_BLOCK_KERNEL_SPAN, _M8WarmDistance))
            {
                uint blockIndex = 0u;
                if (M8FindBlock(blockCoord, blockIndex))
                {
                    gFrameBlockRef = blockIndex + 1u;
                    gFrameWarm4 = M8DistanceChildMask(gFrameBlockMin, 256,
                        _M8WarmDistance);
                    gFrameDraw4 = M8DrawChildMask(gFrameBlockMin, 256);
                    gFrameDependency4 = M8DependencyChildMask(
                        gFrameBlockMin, 256);
                    M8CounterIncrement(M8_COUNTER_HASH_HIT_BLOCKS);
                }
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (thread < 8u)
    {
        uint d4ForMask = thread;
        gFrameWarm3[d4ForMask] = 0u;
        gFrameDraw3[d4ForMask] = 0u;
        gFrameDependency3[d4ForMask] = 0u;
        if (gFrameBlockRef != 0u)
        {
            uint maskBlockIndex = gFrameBlockRef - 1u;
            if (((_M8BlockPresenceL0Read[maskBlockIndex] & gFrameWarm4) &
                (1u << d4ForMask)) != 0u)
            {
                int3 min4ForMask = gFrameBlockMin +
                    MerkabaM8OctantOffset(d4ForMask, 128);
                gFrameWarm3[d4ForMask] = M8DistanceChildMask(min4ForMask, 128,
                    _M8WarmDistance);
                gFrameDraw3[d4ForMask] =
                    ((gFrameDraw4 >> d4ForMask) & 1u) != 0u
                    ? M8DrawChildMask(min4ForMask, 128) : 0u;
                gFrameDependency3[d4ForMask] =
                    ((gFrameDependency4 >> d4ForMask) & 1u) != 0u
                    ? M8DependencyChildMask(min4ForMask, 128) : 0u;
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gFrameBlockRef == 0u) return;

    uint blockIndex = gFrameBlockRef - 1u;
    int3 blockMin = gFrameBlockMin;
    uint d4 = thread >> 3u;
    uint d3 = thread & 7u;
    if (((gFrameWarm4 >> d4) & 1u) == 0u ||
        (((_M8BlockPresenceL1Read[blockIndex * 8u + d4] &
        gFrameWarm3[d4]) >> d3) & 1u) == 0u) return;

    int3 min4 = blockMin + MerkabaM8OctantOffset(d4, 128);
    int3 min3 = min4 + MerkabaM8OctantOffset(d3, 64);
    uint warm2 = M8DistanceChildMask(min3, 64, _M8WarmDistance);
    bool drawPath3 = ((gFrameDraw4 >> d4) & 1u) != 0u &&
        ((gFrameDraw3[d4] >> d3) & 1u) != 0u;
    bool dependencyPath3 = ((gFrameDependency4 >> d4) & 1u) != 0u &&
        ((gFrameDependency3[d4] >> d3) & 1u) != 0u;
    uint draw2 = drawPath3 ? M8DrawChildMask(min3, 64) : 0u;
    uint dependency2 = dependencyPath3
        ? M8DependencyChildMask(min3, 64) : 0u;
    uint support2 = (_M8BlockPresenceL2Read[blockIndex * 64u +
        d4 * 8u + d3] & 255u) & warm2;
    while (support2 != 0u)
    {
        uint d2 = (uint)firstbitlow(support2);
        support2 &= support2 - 1u;
        uint chunkLocal = (d4 << 6u) | (d3 << 3u) | d2;
        uint chunkRef = _M8BlockChunkRefsRead[blockIndex * 512u + chunkLocal];
        if (chunkRef == 0u || chunkRef >= MERKABA_REF_EVICTING) continue;
        uint chunkIndex = chunkRef - 1u;
        int3 min2 = min3 + MerkabaM8OctantOffset(d2, 32);
        uint warm1 = M8DistanceChildMask(min2, 32, _M8WarmDistance);
        bool drawPath2 = drawPath3 && ((draw2 >> d2) & 1u) != 0u;
        bool dependencyPath2 = dependencyPath3 &&
            ((dependency2 >> d2) & 1u) != 0u;
        uint draw1 = drawPath2 ? M8DrawChildMask(min2, 32) : 0u;
        uint dependency1 = dependencyPath2
            ? M8DependencyChildMask(min2, 32) : 0u;
        uint support1 =
            (_M8ChunkPresenceRead[M8ChunkPresenceL0Index(chunkIndex)] &
            255u) & warm1;
        bool visibleChunk = false;
        while (support1 != 0u)
        {
            uint d1 = (uint)firstbitlow(support1);
            support1 &= support1 - 1u;
            int3 min1 = min2 + MerkabaM8OctantOffset(d1, 16);
            uint warm0 = M8DistanceChildMask(min1, 16, _M8WarmDistance);
            bool drawPath1 = drawPath2 && ((draw1 >> d1) & 1u) != 0u;
            bool dependencyPath1 = dependencyPath2 &&
                ((dependency1 >> d1) & 1u) != 0u;
            uint draw0 = drawPath1 ? M8DrawChildMask(min1, 16) : 0u;
            uint dependency0 = dependencyPath1
                ? M8DependencyChildMask(min1, 16) : 0u;
            uint support0 =
                (_M8ChunkPresenceRead[
                    M8ChunkPresenceL1Index(chunkIndex, d1)] & 255u) & warm0;
            while (support0 != 0u)
            {
                uint d0 = (uint)firstbitlow(support0);
                support0 &= support0 - 1u;
                uint tileLocal = (d1 << 3u) | d0;
                uint tileRefIndex = chunkIndex * 64u + tileLocal;
                uint tileRef = _M8ChunkTileRefs[tileRefIndex];
                bool inDraw = drawPath1 && ((draw0 >> d0) & 1u) != 0u;
                bool inDependency = dependencyPath1 &&
                    ((dependency0 >> d0) & 1u) != 0u;
                if (tileRef == MERKABA_REF_COLD_ON_SSD)
                {
                    M8RequestWarmLoad(tileRefIndex, chunkIndex, tileLocal,
                        inDraw);
                    if (inDependency)
                        M8CounterIncrement(M8_COUNTER_READOUT_UNRESOLVED);
                    continue;
                }
                if (!M8IsHotRef(tileRef))
                {
                    if (inDraw)
                        M8CounterIncrement(M8_COUNTER_LATE_DRAW_COLD_MISSES);
                    if (inDependency)
                        M8CounterIncrement(M8_COUNTER_READOUT_UNRESOLVED);
                    continue;
                }
                uint physicalSlot = M8PhysicalSlot(tileRef);
                _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].z =
                    _M8Counters[M8_COUNTER_FRAME_EPOCH];
                if (!inDraw ||
                    _M8TileRecords[M8TileMetaIndex(physicalSlot)].z == 0u)
                    continue;
                uint visibleIndex;
                InterlockedAdd(_M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT],
                    1u, visibleIndex);
                if (visibleIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                    _M8VisibleTiles[visibleIndex] = physicalSlot;
                visibleChunk = true;
            }
        }
        if (visibleChunk) M8CounterIncrement(M8_COUNTER_VISIBLE_CHUNKS);
    }
}

[numthreads(1, 1, 1)]
void PrepareReadoutBuild(uint id : SV_DispatchThreadID)
{
    if (_M8Counters[M8_COUNTER_READOUT_UNRESOLVED] != 0u)
    {
        _M8FrameDispatchArgs[0] = 0u;
        _M8FrameDispatchArgs[1] = 8u;
        _M8FrameDispatchArgs[2] = 1u;
        _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
            MERKABA_READOUT_SKIPPED;
        return;
    }
    _M8FrameDispatchArgs[0] = min(
        _M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    _M8FrameDispatchArgs[1] = 8u;
    _M8FrameDispatchArgs[2] = 1u;
}

uint M8ReadoutPackedColor(KernelState state)
{
    uint rgb = state.packedColor & 0x00ffffffu;
    uint hasRgb = state.colorConfidence > 0u ? 1u : 0u;
    return rgb | (hasRgb << 24u);
}

// The globally-even cube corners form the central tetrahedron. The other four
// corners form the four corner tetrahedra. Translating the cube flips the local
// pattern while retaining the same global-even face diagonal, so adjacent cubes
// remain conforming. These literal switches avoid dynamic constant-array indexing
// on Quest/Vulkan.
int3 M8ReadoutEvenOffset(uint index)
{
    switch (index)
    {
        case 0u: return int3(-1,  0,  1);
        case 1u: return int3(-1,  1,  0);
        case 2u: return int3( 0, -1, -1);
        case 3u: return int3( 0, -1,  1);
        case 4u: return int3( 0,  0, -1);
        case 5u: return int3( 0,  0,  1);
        case 6u: return int3( 0,  1, -1);
        case 7u: return int3( 0,  1,  0);
        case 8u: return int3( 0,  1,  1);
        case 9u: return int3( 1, -1,  0);
        case 10u: return int3(1,  0, -1);
        case 11u: return int3(1,  0,  0);
        case 12u: return int3(1,  0,  1);
        default: return int3(1,  1,  0);
    }
}

uint4 M8ReadoutEvenFace(uint index)
{
    switch (index)
    {
        case 0u: return uint4( 5u,  8u,  0u, 12u);
        case 1u: return uint4( 5u, 12u,  3u,  8u);
        case 2u: return uint4( 6u,  7u,  1u, 13u);
        case 3u: return uint4( 6u, 10u,  4u, 13u);
        case 4u: return uint4( 6u, 13u,  7u, 10u);
        case 5u: return uint4( 7u,  8u,  1u, 13u);
        case 6u: return uint4( 7u, 13u,  6u,  8u);
        case 7u: return uint4( 8u, 12u,  5u, 13u);
        case 8u: return uint4( 8u, 13u,  7u, 12u);
        case 9u: return uint4( 9u, 10u,  2u, 11u);
        case 10u: return uint4(9u, 11u, 10u, 12u);
        case 11u: return uint4(9u, 12u,  3u, 11u);
        case 12u: return uint4(10u, 11u, 9u, 13u);
        case 13u: return uint4(10u, 13u, 6u, 11u);
        case 14u: return uint4(11u, 12u, 9u, 13u);
        case 15u: return uint4(11u, 13u, 10u, 12u);
        default: return uint4(12u, 13u, 8u, 11u);
    }
}

int3 M8ReadoutOddOffset(uint index)
{
    switch (index)
    {
        case 0u: return int3(-1,  0,  0);
        case 1u: return int3( 0, -1,  0);
        case 2u: return int3( 0,  0, -1);
        case 3u: return int3( 0,  0,  1);
        case 4u: return int3( 0,  1,  0);
        default: return int3(1,  0,  0);
    }
}

uint4 M8ReadoutOddFace(uint index)
{
    switch (index)
    {
        case 0u: return uint4(3u, 4u, 0u, 5u);
        case 1u: return uint4(3u, 5u, 1u, 4u);
        default: return uint4(4u, 5u, 2u, 3u);
    }
}

int3 M8ReadoutOffset(bool evenVertex, uint index)
{
    return evenVertex ? M8ReadoutEvenOffset(index) :
        M8ReadoutOddOffset(index);
}

uint4 M8ReadoutFace(bool evenVertex, uint index)
{
    return evenVertex ? M8ReadoutEvenFace(index) :
        M8ReadoutOddFace(index);
}

bool M8TryLoadReadoutNeighbourState(MerkabaM8Address currentAddress,
    uint currentPhysicalSlot, uint currentChunkIndex, uint currentBlockIndex,
    int3 neighbourStep, out KernelState state)
{
    state = (KernelState)0;
    int3 localSigned = int3(currentAddress.local) + neighbourStep;
    bool sameBlock = all(localSigned >= 0) && all(localSigned < 256);
    int3 blockCoord = currentAddress.blockCoord;
    if (!sameBlock)
    {
        if (localSigned.x < 0) { blockCoord.x--; localSigned.x += 256; }
        else if (localSigned.x >= 256) { blockCoord.x++; localSigned.x -= 256; }
        if (localSigned.y < 0) { blockCoord.y--; localSigned.y += 256; }
        else if (localSigned.y >= 256) { blockCoord.y++; localSigned.y -= 256; }
        if (localSigned.z < 0) { blockCoord.z--; localSigned.z += 256; }
        else if (localSigned.z >= 256) { blockCoord.z++; localSigned.z -= 256; }
    }
    MerkabaM8Address neighbourAddress = MerkabaAddressFromBlockLocal(
        blockCoord, uint3(localSigned));

    if (sameBlock &&
        neighbourAddress.chunkLocal == currentAddress.chunkLocal &&
        neighbourAddress.tileLocal == currentAddress.tileLocal)
    {
        state = M8LoadKernelStateRead(currentPhysicalSlot,
            neighbourAddress.kernelLocal);
        return true;
    }

    uint chunkIndex = currentChunkIndex;
    if (neighbourAddress.chunkLocal != currentAddress.chunkLocal || !sameBlock)
    {
        uint blockIndex = currentBlockIndex;
        if (!sameBlock && !M8FindBlock(blockCoord, blockIndex)) return true;
        uint chunkRef = _M8BlockChunkRefsRead[blockIndex *
            MERKABA_M8_BLOCK_CHUNK_COUNT + neighbourAddress.chunkLocal];
        if (chunkRef == MERKABA_REF_EMPTY) return true;
        if (chunkRef == MERKABA_REF_CLAIMED_NEW) return false;
        chunkIndex = chunkRef - 1u;
    }

    uint tileRef = _M8ChunkTileRefsRead[chunkIndex *
        MERKABA_M8_TILES_PER_CHUNK + neighbourAddress.tileLocal];
    if (tileRef == MERKABA_REF_EMPTY) return true;
    if (!M8IsHotRef(tileRef)) return false;
    state = M8LoadKernelStateRead(M8PhysicalSlot(tileRef),
        neighbourAddress.kernelLocal);
    return true;
}

void M8FailReadoutDependency()
{
    M8CounterIncrement(M8_COUNTER_LATE_DRAW_COLD_MISSES);
    M8CounterIncrement(M8_COUNTER_READOUT_UNRESOLVED);
    uint ignored;
    InterlockedMax(_M8Counters[M8_COUNTER_READOUT_BUILD_STATUS],
        MERKABA_READOUT_FAILED, ignored);
}

void M8StoreReadoutVertex(uint outputTriangle, uint corner,
    int3 globalCoord, uint packedColor)
{
    uint outputVertex = outputTriangle * MERKABA_VERTICES_PER_PRIMITIVE;
    bool secondBuffer = outputTriangle >=
        MERKABA_M8_READOUT_TRIANGLES_PER_BUFFER;
    if (secondBuffer)
        outputVertex -= MERKABA_M8_READOUT_VERTICES_PER_BUFFER;
    MerkabaReadoutVertex vertex;
    vertex.gridPosition = (float3)globalCoord * MERKABA_LATTICE_STEP;
    vertex.packedColor = packedColor;
    if (secondBuffer)
        _M8ReadoutVertices1[outputVertex + corner] = vertex;
    else
        _M8ReadoutVertices0[outputVertex + corner] = vertex;
}

[numthreads(64, 1, 1)]
void CompileReadoutVertices(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint visibleCount = min(_M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    if (groupId.x >= visibleCount) return;
    uint physicalSlot = _M8VisibleTilesRead[groupId.x];
    uint kernelLocal = groupId.y * 64u + thread;
    uint word = M8TileWordIndex(physicalSlot, kernelLocal >> 5u);
    uint bit = 1u << (kernelLocal & 31u);
    if ((_M8TileBitsRead[word].x & bit) == 0u) return;
    M8CounterIncrement(M8_COUNTER_OCCUPIED_CONSIDERED);
    KernelState state = M8LoadKernelStateRead(physicalSlot, kernelLocal);
    int3 globalCoord = M8GlobalKernelCoordRead(physicalSlot, kernelLocal);
    MerkabaM8Address currentAddress = MerkabaAddressOf(globalCoord);
    uint4 tileMeta = M8LoadTileMetaRead(physicalSlot);
    uint2 chunkOwner = M8LoadChunkOwnerRead(tileMeta.x);

    bool evenVertex = ((asuint(globalCoord.x) ^ asuint(globalCoord.y) ^
        asuint(globalCoord.z)) & 1u) == 0u;
    uint offsetCount = evenVertex ? 14u : 6u;
    uint faceCount = evenVertex ? 17u : 3u;
    uint occupiedMask = 0u;
    [loop]
    for (uint offsetIndex = 0u; offsetIndex < offsetCount; offsetIndex++)
    {
        bool occupied = false;
        if (!M8TryOccupiedNeighbour(currentAddress, physicalSlot,
            tileMeta.x, chunkOwner.x,
            M8ReadoutOffset(evenVertex, offsetIndex), occupied))
        {
            M8FailReadoutDependency();
            return;
        }
        if (occupied) occupiedMask |= 1u << offsetIndex;
    }

    uint candidateMask = 0u;
    uint surfaceMask = 0u;
    [loop]
    for (uint faceIndex = 0u; faceIndex < faceCount; faceIndex++)
    {
        uint4 face = M8ReadoutFace(evenVertex, faceIndex);
        uint vertices = (1u << face.x) | (1u << face.y);
        if ((occupiedMask & vertices) != vertices) continue;
        candidateMask |= 1u << faceIndex;
        bool opposite0 = (occupiedMask & (1u << face.z)) != 0u;
        bool opposite1 = (occupiedMask & (1u << face.w)) != 0u;
        if (!(opposite0 && opposite1)) surfaceMask |= 1u << faceIndex;
    }

    uint candidateCount = countbits(candidateMask);
    uint surfaceCount = countbits(surfaceMask);
    uint ignored;
    InterlockedAdd(_M8Counters[M8_COUNTER_PRIMITIVES_BEFORE_FACING],
        candidateCount, ignored);
    InterlockedAdd(_M8Counters[M8_COUNTER_PRIMITIVES_REJECTED],
        candidateCount - surfaceCount, ignored);
    if (surfaceCount == 0u) return;

    uint baseIndex;
    InterlockedAdd(_M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES],
        surfaceCount, baseIndex);
    if (baseIndex + surfaceCount >
        MERKABA_M8_READOUT_TRIANGLE_CAPACITY)
    {
        _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 1u;
        InterlockedMax(_M8Counters[M8_COUNTER_READOUT_BUILD_STATUS],
            MERKABA_READOUT_FAILED, ignored);
        return;
    }

    uint outputOffset = 0u;
    [loop]
    for (uint faceIndex = 0u; faceIndex < faceCount; faceIndex++)
    {
        if ((surfaceMask & (1u << faceIndex)) == 0u) continue;
        uint4 face = M8ReadoutFace(evenVertex, faceIndex);
        int3 offsetB = M8ReadoutOffset(evenVertex, face.x);
        int3 offsetC = M8ReadoutOffset(evenVertex, face.y);
        int3 offsetD0 = M8ReadoutOffset(evenVertex, face.z);
        int3 offsetD1 = M8ReadoutOffset(evenVertex, face.w);
        bool opposite0 = (occupiedMask & (1u << face.z)) != 0u;
        bool opposite1 = (occupiedMask & (1u << face.w)) != 0u;

        float3 normal = cross((float3)offsetB, (float3)offsetC);
        bool swapWinding = false;
        if (opposite0 != opposite1)
        {
            int3 occupiedOpposite = opposite0 ? offsetD0 : offsetD1;
            swapWinding = dot(normal, (float3)occupiedOpposite) > 0.0;
            if (_M8GridWindingSign < 0.0) swapWinding = !swapWinding;
        }
        else
        {
            float3 center = ((float3)globalCoord +
                ((float3)offsetB + (float3)offsetC) / 3.0) *
                MERKABA_LATTICE_STEP;
            float3 guardedNormal = normal * _M8GridWindingSign;
            float leftFacing = dot(guardedNormal,
                _M8EyeGridPositions[0] - center);
            float rightFacing = dot(guardedNormal,
                _M8EyeGridPositions[1] - center);
            swapWinding = max(leftFacing, rightFacing) < 0.0;
        }

        KernelState stateB;
        KernelState stateC;
        if (!M8TryLoadReadoutNeighbourState(currentAddress, physicalSlot,
            tileMeta.x, chunkOwner.x, offsetB, stateB) ||
            !M8TryLoadReadoutNeighbourState(currentAddress, physicalSlot,
            tileMeta.x, chunkOwner.x, offsetC, stateC))
        {
            M8FailReadoutDependency();
            return;
        }

        int3 coordB = globalCoord + offsetB;
        int3 coordC = globalCoord + offsetC;
        if (swapWinding)
        {
            int3 swapCoord = coordB;
            coordB = coordC;
            coordC = swapCoord;
            KernelState swapState = stateB;
            stateB = stateC;
            stateC = swapState;
        }
        uint outputTriangle = baseIndex + outputOffset++;
        M8StoreReadoutVertex(outputTriangle, 0u, globalCoord,
            M8ReadoutPackedColor(state));
        M8StoreReadoutVertex(outputTriangle, 1u, coordB,
            M8ReadoutPackedColor(stateB));
        M8StoreReadoutVertex(outputTriangle, 2u, coordC,
            M8ReadoutPackedColor(stateC));
    }
}

[numthreads(1, 1, 1)]
void FinalizeReadout(uint id : SV_DispatchThreadID)
{
    uint status = _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS];
    if (status == MERKABA_READOUT_SKIPPED) return;
    if (status == MERKABA_READOUT_FAILED ||
        _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] != 0u ||
        _M8Counters[M8_COUNTER_READOUT_UNRESOLVED] != 0u)
    {
        _M8DrawArgs[0] = 0u;
        _M8DrawArgs[1] = 2u;
        _M8DrawArgs[2] = 0u;
        _M8DrawArgs[3] = 0u;
        _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
            MERKABA_READOUT_FAILED;
        return;
    }
    uint logical = min(
        _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES],
        MERKABA_M8_READOUT_TRIANGLE_CAPACITY);
    _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES] = logical;
    _M8DrawArgs[0] = logical * MERKABA_VERTICES_PER_PRIMITIVE;
    _M8DrawArgs[1] = 2u;
    _M8DrawArgs[2] = 0u;
    _M8DrawArgs[3] = 0u;
    _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] =
        MERKABA_READOUT_PUBLISHED;
}
