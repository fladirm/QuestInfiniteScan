#pragma kernel ClassifyHotFlowerPages
#pragma kernel CompactDirtyFlowerSymbols
#pragma kernel PublishDirtyFlowerPages
#pragma kernel CullFlowerPages
// Keep bounded generated loops intact in the Quest compiler, as in the
// procedural graphics pass. The FXC/HLSLcc route tries to unroll the exact
// codec through its callers and rejects its explicit loop attributes.
#pragma use_dxc vulkan

#include "MerkabaWorld.hlsl"
#define M8_FLOWER_THREAD_DRAW_WRITE
#define M8_FLOWER_PAGE_WRITE
#include "MerkabaFlowerPages.hlsl"
// Compaction may enqueue existing COLD tiles. All subsequent halo/dual reads
// therefore use the same descriptor as that publication, never an RW/SRV alias.
#define _M8ChunkTileRefsRead _M8ChunkTileRefs
#include "MerkabaFlowerTileHalo.hlsl"
#include "MerkabaFlowerGeometry.hlsl"
#include "MerkabaFlowerSupport.hlsl"
#include "MerkabaFlowerSkinReadout.hlsl"

#define MERKABA_LATTICE_STEP 0.025
#define MERKABA_HALF_SUPPORT 0.025

float3 _M8CameraGridMeters;
float3 _M8GridMetricDiagonal;
float3 _M8GridMetricCross;
float _M8RenderDistance;
float _M8WarmDistance;
float _M8ScanDistance;
uint _M8FlowerGraphicsRetiredGeneration;
uint _M8FlowerClassifySingleSlot;
uint _M8FlowerClassifySlot;
uint _M8FlowerViewInstanceCount;
float4 _M8FlowerCullPlanes[12];
float2 _M8FlowerPlaneErrorBounds;

groupshared uint2 m8FlowerPageOwnerSpans[512];
// Same immutable page lease as count/emit; nine bits of symbolic completion
// provenance per owner, not persistent topology or an observation gate.
groupshared uint m8FlowerPageCompletion[512];
groupshared uint m8FlowerCompileSlot;
groupshared uint m8FlowerCompileGeneration;
groupshared uint m8FlowerCompileSlotGeneration;
groupshared uint m8FlowerCompileStatus;
groupshared uint m8FlowerCompileTriangles;
groupshared uint2 m8FlowerCompileTotal;

// Translation classification and a newly installed page use the same metric
// and support AABB. This helper has no residency descriptor of its own: Compact
// validates its RW-backed ref while the translation pass uses the SRV view.
uint M8FlowerClassifyTileDistance(int3 minimum)
{
    bool warm=MerkabaM8GridAabbIntersectsDistance(minimum,8,_M8WarmDistance,
        _M8CameraGridMeters,_M8GridMetricDiagonal,_M8GridMetricCross,
        MERKABA_LATTICE_STEP,MERKABA_HALF_SUPPORT);
    bool draw=warm && MerkabaM8GridAabbIntersectsDistance(minimum,8,_M8RenderDistance,
        _M8CameraGridMeters,_M8GridMetricDiagonal,_M8GridMetricCross,
        MERKABA_LATTICE_STEP,MERKABA_HALF_SUPPORT);
    bool scan=draw && MerkabaM8GridAabbIntersectsDistance(minimum,8,_M8ScanDistance,
        _M8CameraGridMeters,_M8GridMetricDiagonal,_M8GridMetricCross,
        MERKABA_LATTICE_STEP,MERKABA_HALF_SUPPORT);
    return scan?3u:(draw?2u:(warm?1u:0u));
}

void M8FlowerClearRetiredPageResidency(uint slot)
{
    M8FlowerSetPageResidency(slot,0u);
    // A retired installation cannot retain FRONT's slot-lifetime receipt.
    // Allocation/source generations remain intact for normal page retirement.
    _M8FlowerPageDirectory.Store(M8_FLOWER_PAGE_AUX_BASE+32u*slot+28u,0u);
}

// This is a storage request after the cached geometry work, not a relation
// lookup in the knot loop. Only endpoints actually requested by the reader
// can hold this page for residency; unrelated COLD halo entries cannot.
void M8FlowerRequestPageEndpoints(uint lane)
{
    if(lane>=27u || (m8FlowerHaloUnresolvedReads&(1u<<lane))==0u)return;
    int3 tile=m8FlowerHaloTile+M8FlowerHaloDelta(lane);
    if(any(tile < -268435456) || any(tile > 268435455))return;
    MerkabaM8Address address=MerkabaAddressOf(tile*8);
    uint block;
    if(!M8FindBlock(address.blockCoord,block))return;
    uint chunkRef=_M8BlockChunkRefsRead[block*512u+address.chunkLocal];
    if(chunkRef==0u || chunkRef-1u>=MERKABA_M8_CHUNK_CAPACITY)return;
    uint chunk=chunkRef-1u;
    M8QueueColdTileLoad(chunk*64u+address.tileLocal,chunk,address.tileLocal);
}

// Count, neighboring coverage and emit share this one frozen evaluator. No
// temporary XYZ, per-world candidates or index lists are allocated. Coverage
// consumes the given owner but never claims its symbols for the current page.
uint2 M8FlowerCompileOwner(uint slot,uint local,bool emit,bool coverageOnly,
    M8FlowerPageBuild build,uint2 first)
{
    uint2 count=0u;
    KernelState state=M8LoadKernelStateRead(slot,local);
    uint required=M8_FLOWER_OCCUPIED_FLAG|M8_FLOWER_PLANE_VALID;
    if((state.flags&(required|M8_FLOWER_SEED_FLAG))!=required)return count;
    int3 owner=M8FlowerEndpointOwner(slot,local);
    uint completion=emit?m8FlowerPageCompletion[local]:0xffffffffu;
    uint2 failedDirect=0u,parentDirect=0u,pending=0u,proven=0u;
    M8FlowerDirectAnchors directAnchors;
    M8FlowerResetDirectAnchors(directAnchors);
    uint selectedToken=0xffffffffu,sourcePass=emit?2u:0u;
    bool ambiguousCompletion=false;
    // D must be complete before the boundary equation is evaluated. Reuse
    // the identical carrier call site and fixed 48-bit local masks;
    // do not retain 128 roots/positions or publish a partial completion.
    [loop]while(true)
    {
    uint childProof=1u;
    uint itemCount=sourcePass==1u?16u:128u;
    [loop]for(uint item=0u;item<itemCount;item++)
    {
        uint source=sourcePass==1u?M8FlowerL2SourceToWedge[16u*(completion&63u)+item]:0u;
        uint carrier=sourcePass==1u?source/6u:item;
        M8FlowerSymbolRecord symbol=(M8FlowerSymbolRecord)0;
        M8FlowerPhaseRootEvidence roots[7];float3 positions[7];
        uint unresolved=0u,direct=0u,status=0u;
        uint3 pairedEdges=0u;int3 carrierFirst=0,carrierLast=0;
        bool collectCoverage=false;
        // Own carrier, then only its required resident boundary partners.
        // One evaluator call site also covers D, completion children and
        // final emission. Keep only one carrier while each peer is consumed;
        // no page/world root cache, recursive evaluator or extra dispatch.
        [loop]for(uint visit=0u;visit<7u;visit++)
        {
            uint2 address=uint2(slot,local);uint targetCarrier=carrier;
            uint peerWedge=0u;uint3 peerSites=0u;
            if(visit!=0u)
            {
                if(!collectCoverage)break;
                if((M8FlowerDrawActiveWedgeMask(symbol)&(1u<<(visit-1u)))==0u)continue;
                if(!M8FlowerSupportResolveOuterPeer(slot,owner,carrier,visit-1u,
                    address,peerWedge,peerSites))continue;
                targetCarrier=peerWedge/6u;
            }
            M8FlowerSymbolRecord evaluatedSymbol;
            M8FlowerPhaseRootEvidence evaluatedRoots[7];float3 evaluatedPositions[7];
            uint evaluatedUnresolved,evaluatedDirect;
            uint evaluatedStatus=M8FlowerPageCarrier(address.x,address.y,targetCarrier,
                _M8FlowerPlaneErrorBounds,visit==0u?completion:0xffffffffu,
                visit==0u && sourcePass!=2u,evaluatedSymbol,evaluatedUnresolved,
                evaluatedDirect,evaluatedRoots,evaluatedPositions);
            if(visit==0u)
            {
                symbol=evaluatedSymbol;status=evaluatedStatus;
                unresolved=evaluatedUnresolved;direct=evaluatedDirect;
                if(sourcePass==0u)
                    M8FlowerRecordDirectAnchors(carrier,direct,evaluatedRoots,directAnchors);
                if(sourcePass!=2u || emit || status!=1u)break;
                collectCoverage=M8FlowerSupportCarrierCells(owner,carrier,
                    M8FlowerDrawActiveWedgeMask(symbol),evaluatedRoots,carrierFirst,carrierLast);
                if(!collectCoverage)break;
                [loop]for(uint site=0u;site<7u;site++)
                {roots[site]=evaluatedRoots[site];positions[site]=evaluatedPositions[site];}
            }
            else if(evaluatedStatus==1u &&
                (M8FlowerDrawActiveWedgeMask(evaluatedSymbol)&(1u<<(peerWedge%6u)))!=0u)
            {
                uint wedge=visit-1u,firstSite=1u+wedge,lastSite=1u+(wedge+1u)%6u;
                uint axes=M8FlowerSupportPairAxes(roots[firstSite],roots[lastSite],
                    evaluatedRoots[peerSites.x],evaluatedRoots[peerSites.y],
                    positions[firstSite],positions[lastSite],positions[0],evaluatedPositions[peerSites.z]);
                [unroll]for(uint axis=0u;axis<3u;axis++)
                    if((axes&(1u<<axis))!=0u)pairedEdges[axis]|=1u<<wedge;
            }
        }
        if(sourcePass==0u)
        {
            [unroll]for(uint wedge=0u;wedge<6u;wedge++)if((direct&(1u<<wedge))==0u)
            {
                uint petal=M8FlowerL2Wedge[6u*carrier+wedge].y>>4u;
                failedDirect[petal>>5u]|=1u<<(petal&31u);
            }
            continue;
        }
        if(sourcePass==1u)
        {
            uint bit=1u<<(source%6u);
            if(status!=1u || (M8FlowerDrawActiveWedgeMask(symbol)&bit)==0u)
            {
                if((unresolved&bit)==0u){childProof=0u;break;}
                childProof=2u;
            }
            continue;
        }
        if(status!=1u)continue;
        if(collectCoverage)
            M8FlowerSupportAccumulateCarrier(positions,M8FlowerDrawActiveWedgeMask(symbol),
                pairedEdges,carrierFirst,carrierLast);
        if(coverageOnly)continue;
        uint active=M8FlowerDrawActiveWedgeMask(symbol);
        uint signs=M8FlowerDrawRootSigns(symbol),sector=M8FlowerDrawHubSector(symbol);
        uint bytes;
        if(!M8FlowerCarrierSkinBytes(symbol.DetailRef,carrier,active,signs,sector,bytes))
        {InterlockedOr(m8FlowerCompileStatus,M8_FLOWER_ARENA_INVALID);continue;}
        if(emit)
        {
            uint symbolIndex=first.x+count.x,sampleOffset=first.y+count.y;
            if(symbolIndex>=build.SymbolCapacity/16u || sampleOffset>build.SampleCapacity ||
                bytes>build.SampleCapacity-sampleOffset)
            {InterlockedOr(m8FlowerCompileStatus,M8_FLOWER_ARENA_INVALID);continue;}
            float3 captured=float3(state.packedColor&255u,(state.packedColor>>8u)&255u,
                (state.packedColor>>16u)&255u)*(1.0/255.0);
            uint threadRef;
            if(!M8FlowerCompileCarrierSkin(symbol.DetailRef,carrier,active,signs,sector,
                captured,build.SampleAddress+sampleOffset,bytes,threadRef))
            {InterlockedOr(m8FlowerCompileStatus,M8_FLOWER_ARENA_INVALID);continue;}
            symbol.ThreadRef=threadRef;
            M8FlowerStoreSymbol(build.SymbolAddress,symbolIndex,symbol);
        }
        else
            InterlockedAdd(m8FlowerCompileTriangles,countbits(active));
        count+=uint2(1u,bytes);
    }
    if(sourcePass==2u)break;
    if(sourcePass==0u)
    {
        parentDirect=~failedDirect&uint2(0xffffffffu,0xffffu)&
            M8FlowerDirectAnchorMask(directAnchors);
        pending=M8FlowerCompletionBoundaryCandidates(parentDirect);
    }
    else if(childProof==1u)
    {
        uint petal=completion&63u;
        proven[petal>>5u]|=1u<<(petal&31u);
        selectedToken=completion;
    }
    else if(childProof==2u)ambiguousCompletion=true;
    // Only a finite boundary candidate with actual donor/R3 evidence enters
    // the sixteen-child pass. All passes use the SAME call above; no nested
    // full carrier reader or serialized micro-dispatch is introduced.
    sourcePass=2u;completion=0xffffffffu;
    [loop]while(any(pending!=0u))
    {
        uint word=pending.x!=0u?0u:1u;
        uint petal=32u*word+(uint)firstbitlow(pending[word]);
        pending[word]&=pending[word]-1u;
        uint status=M8FlowerPrepareCompletionPetal(slot,local,_M8FlowerPlaneErrorBounds,
            parentDirect,petal,directAnchors,completion);
        if(status==1u){sourcePass=1u;break;}
        if(status==2u)ambiguousCompletion=true;
    }
    if(sourcePass==1u)continue;
    // 'proven' contains ONLY candidates with all donor, class, orientation,
    // child-closure and full-dual proofs. These are not placeholder masks.
    uint2 candidates=M8FlowerCompletionCandidates(parentDirect,proven,proven,
        proven,proven,uint2(0u,0u));
    uint selected;uint completionStatus=M8FlowerUniqueCompletion(candidates,selected);
    if(ambiguousCompletion)completionStatus=2u;
    completion=completionStatus==1u && selected==(selectedToken&63u)?selectedToken:0xffffffffu;
    if(completionStatus==2u && !coverageOnly)
    {
        InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_UNRESOLVED],1u);
        InterlockedAdd(_M8Counters[M8_COUNTER_REFINEMENT_UNRESOLVED],1u);
    }
    if(!coverageOnly)m8FlowerPageCompletion[local]=completion;
    }
    return count;
}

// Exactly one bounded page quantum on the existing serialized native queue.
// The immutable source lease spans all three passes and final publication.
// Failed count/skin validation never publishes a partial page or changes FRONT.
[numthreads(256,1,1)]
void CompactDirtyFlowerSymbols(uint lane:SV_GroupIndex)
{
    if(lane==0u)
    {
        m8FlowerCompileStatus=M8_FLOWER_ARENA_OK;
        m8FlowerCompileTriangles=0u;m8FlowerCompileTotal=0u;
        if(!M8FlowerTakeDirtyPage(m8FlowerCompileSlot,m8FlowerCompileGeneration))
            m8FlowerCompileSlot=0xffffffffu;
        m8FlowerCompileSlotGeneration=0u;
        if(m8FlowerCompileSlot<32768u)
        {
            uint4 meta=M8LoadTileMetaRead(m8FlowerCompileSlot);
            uint4 runtime=M8LoadTileRuntimeRead(m8FlowerCompileSlot);
            if(runtime.w!=0u && meta.x<MERKABA_M8_CHUNK_CAPACITY && meta.y<64u &&
                _M8ChunkTileRefsRead[meta.x*64u+meta.y]==m8FlowerCompileSlot+1u)
            {
                m8FlowerCompileSlotGeneration=runtime.w;
                uint slot=m8FlowerCompileSlot;
                uint2 front=_M8FlowerPageDirectory.Load2(
                    M8_FLOWER_PAGE_DIRECTORY_BASE+16u*slot);
                uint header0=M8_FLOWER_PAGE_HEADER_BASE+64u*slot;
                int3 minimum=M8GlobalKernelCoordRead(slot,0u);
                bool sameInstallation=front.y!=0u &&
                    (front.x==header0 || front.x==header0+32u) &&
                    _M8FlowerPageDirectory.Load(M8_FLOWER_PAGE_AUX_BASE+32u*slot+28u)==runtime.w;
                if(sameInstallation)
                {
                    M8FlowerPageHeader previous=M8FlowerLoadPageHeader(front.x);
                    // Slot generations wrap; the exact logical tile prevents
                    // an old slot occupant from supplying its classification.
                    sameInstallation=previous.Generation==front.y &&
                        all(previous.LogicalTile==(minimum>>3));
                }
                // Installation is a residency trigger even at a stationary
                // head. Until its first successful publication a retry remains
                // this same install work; ordinary source dirtiness thereafter
                // does not reclassify the already published slot lifetime.
                if(!sameInstallation)
                    M8FlowerSetPageResidency(slot,M8FlowerClassifyTileDistance(minimum));
            }
            else M8FlowerClearRetiredPageResidency(m8FlowerCompileSlot);
        }
    }
    GroupMemoryBarrierWithGroupSync();
    uint slot=m8FlowerCompileSlot,generation=m8FlowerCompileGeneration;
    if(slot>=32768u)return;
    if(m8FlowerCompileSlotGeneration==0u || generation==0u)
    {
        // A retired physical slot has no page source. Installation republishes
        // its own generation and dirty neighbourhood before it can be drawn.
        return;
    }
    M8FlowerCacheTileHalo(slot,lane,true);
    int3 logicalTile=m8FlowerHaloTile;
    M8FlowerSupportCacheTile(logicalTile,lane,256u);
    M8FlowerSupportBuildFaces(lane,256u);
    M8FlowerPageBuild build=(M8FlowerPageBuild)0;
    // One ordered call site: central count, neighboring coverage, central emit.
    // Resolve only maps the fixed stencil to resident owners; it never invokes
    // a second carrier evaluator. All coverage completes before allocation.
    [loop]for(uint phase=0u;phase<3u;phase++)
    {
        if(phase==2u && m8FlowerCompileStatus!=M8_FLOWER_ARENA_OK)break;
        bool coverageOnly=phase==1u;
        uint itemCount=2u;
        if(coverageOnly)
            itemCount=M8FlowerSupportPrepareNeighborCoverage(lane,256u)?
                (M8_FLOWER_COVERAGE_OWNER_COUNT+255u)/256u:0u;
        [loop]for(uint item=0u;item<itemCount;item++)
        {
            uint ownerSlot=slot,local=lane+256u*item;
            if(coverageOnly)
            {
                uint stencilIndex=local;
                if(stencilIndex>=M8_FLOWER_COVERAGE_OWNER_COUNT)continue;
                if(!M8FlowerSupportResolveCoverageOwner(slot,stencilIndex,ownerSlot,local))continue;
            }
            uint2 first=0u;
            if(phase==2u)first=m8FlowerPageOwnerSpans[local];
            uint2 count=M8FlowerCompileOwner(ownerSlot,local,phase==2u,coverageOnly,build,first);
            if(phase==0u)m8FlowerPageOwnerSpans[local]=count;
            else if(phase==2u)
            {
                uint2 end=local==511u?m8FlowerCompileTotal:m8FlowerPageOwnerSpans[local+1u];
                if(any(count!=end-first))
                    InterlockedOr(m8FlowerCompileStatus,M8_FLOWER_ARENA_INVALID);
            }
        }
        GroupMemoryBarrierWithGroupSync();
        if(phase==1u)
        {
            M8FlowerRequestPageEndpoints(lane);
            M8FlowerSupportRequestResidency(lane,256u);
            M8FlowerSupportFinalizeCoverage(lane,256u);
            if(lane==0u)
            {
                uint2 sum=0u;
                [loop]for(uint local=0u;local<512u;local++)
                {
                    uint2 count=m8FlowerPageOwnerSpans[local];
                    m8FlowerPageOwnerSpans[local]=sum;sum+=count;
                }
                m8FlowerCompileTotal=sum;
                if(sum.x>M8_FLOWER_MAX_PAGE_SYMBOLS || sum.y>67108864u)
                    m8FlowerCompileStatus=M8_FLOWER_ARENA_CAPACITY;
                if(m8FlowerHaloUnresolvedReads!=0u)
                    m8FlowerCompileStatus=M8_FLOWER_SUPPORT_AMBIGUOUS;
            }
            GroupMemoryBarrierWithGroupSync();
            if(m8FlowerCompileStatus==M8_FLOWER_ARENA_OK)
            {
                uint result=M8FlowerSupportBeginPage(slot,m8FlowerCompileSlotGeneration,
                    generation,m8FlowerCompileTotal.x,m8FlowerCompileTotal.y,lane,256u,build);
                if(lane==0u)m8FlowerCompileStatus=result;
                GroupMemoryBarrierWithGroupSync();
            }
        }
    }
    if(m8FlowerCompileStatus==M8_FLOWER_ARENA_OK)
    {
        uint result=M8FlowerSupportFinishPage(build,logicalTile,m8FlowerCompileTotal.x,
            m8FlowerCompileTotal.x,true,m8FlowerCompileTotal.y/64u,lane);
        if(lane==0u)m8FlowerCompileStatus=result;
    }
    GroupMemoryBarrierWithGroupSync();
    if(lane==0u)
    {
        if(m8FlowerCompileStatus!=M8_FLOWER_ARENA_OK)
        {
            if(build.SymbolCapacity!=0u || build.SampleCapacity!=0u)M8FlowerAbortPage(build);
            M8FlowerMarkPageDirty(slot,generation);
            _M8Counters[M8_COUNTER_READOUT_UNRESOLVED]+=1u;
            if(m8FlowerCompileStatus==M8_FLOWER_ARENA_CAPACITY)
                _M8FlowerPageDirectory.Store(4u,1u);
        }
        else
        {
            _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES]=
                m8FlowerCompileTriangles+m8FlowerSupportSymbolCount;
            _M8Counters[M8_COUNTER_READOUT_EMITTED_VERTICES]=
                7u*(m8FlowerCompileTotal.x+m8FlowerSupportSymbolCount);
        }
    }
}

#undef _M8ChunkTileRefsRead

// Translation/install-only residency classification, bounded by HOT capacity.
// It neither traverses a logical sphere stencil nor compiles surface symbols.
[numthreads(128,1,1)]
void ClassifyHotFlowerPages(uint dispatchId : SV_DispatchThreadID)
{
    if(_M8FlowerClassifySingleSlot!=0u && dispatchId!=0u)return;
    uint slot=_M8FlowerClassifySingleSlot!=0u?_M8FlowerClassifySlot:dispatchId;
    if(slot>=MERKABA_M8_PHYSICAL_TILE_CAPACITY)return;
    uint4 meta=M8LoadTileMetaRead(slot);
    uint4 runtime=M8LoadTileRuntimeRead(slot);
    if(runtime.w!=0u && meta.x<MERKABA_M8_CHUNK_CAPACITY && meta.y<64u &&
        _M8ChunkTileRefsRead[meta.x*64u+meta.y]==slot+1u)
        M8FlowerSetPageResidency(slot,
            M8FlowerClassifyTileDistance(M8GlobalKernelCoordRead(slot,0u)));
    else M8FlowerClearRetiredPageResidency(slot);
}

[numthreads(128,1,1)]
void PublishDirtyFlowerPages(uint slot : SV_DispatchThreadID)
{
    if(slot>=MERKABA_M8_PHYSICAL_TILE_CAPACITY)return;
    uint address=M8_FLOWER_PAGE_DIRECTORY_BASE+16u*slot;
    if(_M8FlowerPageDirectory.Load(address+12u)==0u)return;
    uint result=M8FlowerPublishPage(slot,M8LoadTileRuntimeRead(slot).w,
        _M8FlowerGraphicsRetiredGeneration);
    if(result==M8_FLOWER_ARENA_CAPACITY)
        _M8FlowerPageDirectory.Store(4u,1u);
}

// Current view changes only these commands. The count word is reset by the
// command stream immediately before this dispatch, never by a racing lane.
[numthreads(128,1,1)]
void CullFlowerPages(uint slot : SV_DispatchThreadID)
{
    if(slot>=MERKABA_M8_PHYSICAL_TILE_CAPACITY ||
        (_M8FlowerPageDirectory.Load(M8_FLOWER_PAGE_AUX_BASE+32u*slot+4u)&
            M8_FLOWER_PAGE_RESIDENCY_MASK)<2u)return;
    M8FlowerPageHeader page;
    if(!M8FlowerFrontPage(slot,page) || page.SymbolCount==0u)return;
    if(_M8FlowerPageDirectory.Load(M8_FLOWER_PAGE_AUX_BASE+32u*slot+28u)!=
        M8LoadTileRuntimeRead(slot).w)return;
    float3 minimum=(float3(page.LogicalTile)*8.0-1.0)*MERKABA_LATTICE_STEP;
    float3 maximum=(float3(page.LogicalTile)*8.0+8.0)*MERKABA_LATTICE_STEP;
    bool visible=false;
    [unroll]for(uint eye=0u;eye<2u;eye++)
    {
        bool inside=true;
        [unroll]for(uint plane=0u;plane<6u;plane++)
        {
            float4 p=_M8FlowerCullPlanes[eye*6u+plane];
            float3 positive=float3(p.x>=0.0?maximum.x:minimum.x,
                p.y>=0.0?maximum.y:minimum.y,p.z>=0.0?maximum.z:minimum.z);
            inside=inside && dot(p.xyz,positive)+p.w>=0.0;
        }
        visible=visible || inside;
    }
    uint views=_M8FlowerViewInstanceCount;
    if(!visible || (views!=1u && views!=2u))return;
    uint command;
    _M8FlowerIndirectCommands.InterlockedAdd(M8_FLOWER_INDIRECT_COUNT,1u,command);
    // At most one invocation per physical page, so command<32768 structurally.
    // Also bound the store if a rejected/reset command stream is replayed.
    if(command>=32768u)return;
    uint address=command*M8_FLOWER_INDIRECT_STRIDE;
    _M8FlowerIndirectCommands.Store4(address,uint4(page.SymbolCount*18u,views,
        0u,page.FirstSymbol*7u));
    _M8FlowerIndirectCommands.Store(address+16u,slot*views);
}
