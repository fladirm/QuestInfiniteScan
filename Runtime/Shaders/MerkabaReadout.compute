#include "MerkabaWorld.hlsl"
#include "MerkabaSurfaceOrientation.generated.hlsl"

#define MERKABA_LATTICE_STEP 0.025
#define MERKABA_HALF_SUPPORT 0.025
#define MERKABA_OCCUPIED_FLAG 1u
#define M8_RENDER_SLOT_GROUP 256u
#define M8_SHELL_GROUP_THREADS 128u

// The generated membrane oracle reads the tile-local halo cache and the
// canonical colour of its contributors through these two accessors, which
// are defined once the cache exists below. One HLSL authority, no copy.
bool M8MembraneCell(int3 globalCoord, out bool resolved, out bool measured,
    out bool knownFree);
float4 M8MembranePlaneOf(int3 globalCoord);
void M8LoadMembraneColor(int3 globalCoord, out uint packedColor,
    out uint colorConfidence);
#include "MerkabaOverlapShell.generated.hlsl"

// Disposable readout publication. A build rewrites only tiles whose membrane
// inputs changed (plus their 26-tile dependency halo) into free pages of one
// shared vertex pool. Tile records live in two FRONT/BACK index slots; the
// CPU adopts BACK atomically. Pages retired by a publication are reclaimed
// by the next build, after every frame that could draw them has run.
RWStructuredBuffer<uint2> _M8VisibleTiles;
StructuredBuffer<uint2> _M8VisibleTilesRead;
RWByteAddressBuffer _M8RenderVertices;
RWStructuredBuffer<uint> _M8RenderIndexBack;
StructuredBuffer<uint> _M8RenderIndexFrontRead;
RWStructuredBuffer<uint> _M8RenderPageQueues;
RWStructuredBuffer<uint> _M8RenderMutationQueue;
RWStructuredBuffer<uint> _M8RenderIndices;
StructuredBuffer<uint> _M8RenderIndicesRead;
// Canonical publication version per physical tile: bumped by every mutation
// that can change the tile's skin, compared against each slot's record.
RWStructuredBuffer<uint> _M8RenderVersions;
StructuredBuffer<uint> _M8RenderVersionsRead;
RWStructuredBuffer<uint> _M8FrameDispatchArgs;
RWStructuredBuffer<uint4> _M8AttemptCompletion;

// Per-frame visibility (graphics queue, FRONT only).
// Per-build readout scratch, one region per rebuild tile (work index):
// patch descriptors from CollectRenderPatchInputs, corner results and knot
// ownership from ReduceAndSolveSharedKnots, one header per tile.
RWStructuredBuffer<uint4> _M8RenderPatchScratch;
RWStructuredBuffer<uint4> _M8RenderKnotScratch;
RWStructuredBuffer<uint> _M8RenderKnotOwner;
RWStructuredBuffer<uint4> _M8RenderScratchHeader;
StructuredBuffer<uint4> _M8RenderPatchScratchRead;
StructuredBuffer<uint4> _M8RenderKnotScratchRead;
StructuredBuffer<uint> _M8RenderKnotOwnerRead;
StructuredBuffer<uint4> _M8RenderScratchHeaderRead;

float3 _M8CameraGridMeters;
float3 _M8GridMetricDiagonal;
float3 _M8GridMetricCross;
float _M8RenderDistance;
float _M8WarmDistance;
float _M8DependencyDistance;
int3 _M8QueryCenterBlock;
int _M8QueryBlockRadius;
int _M8QueryBlockSide;
float4x4 _MerkabaGridToWorld;
float4x4 _MerkabaWorldToGrid;
uint _M8ReadoutRevision;
uint _M8ResidencyChanged;

// Published tile count and active list of the FRONT slot.
uint M8FrontTileCount()
{
    return min(_M8RenderIndexFrontRead[0],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
}

uint M8FrontListBase()
{
    return M8_RENDER_TILE_LIST_BASE +
        (_M8RenderIndexFrontRead[M8_RENDER_HEADER_LIST_REGION] & 1u) *
        M8_RENDER_TILE_LIST_REGION_WORDS;
}

// The list being built in BACK and the list BACK published last time.
uint M8BackListBase()
{
    return M8_RENDER_TILE_LIST_BASE +
        (_M8RenderIndexBack[M8_RENDER_HEADER_LIST_REGION] & 1u) *
        M8_RENDER_TILE_LIST_REGION_WORDS;
}

uint M8BackPreviousListBase()
{
    return M8_RENDER_TILE_LIST_BASE +
        ((_M8RenderIndexBack[M8_RENDER_HEADER_LIST_REGION] ^ 1u) & 1u) *
        M8_RENDER_TILE_LIST_REGION_WORDS;
}

uint M8BackPreviousTileCount()
{
    return min(_M8RenderIndexBack[M8_RENDER_HEADER_PREVIOUS_TILES],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
}

uint M8RecordBase(uint physicalSlot)
{
    return M8_RENDER_INDEX_HEADER + physicalSlot * M8_RENDER_RECORD_WORDS;
}

bool M8AabbIntersectsDistance(int3 globalMin, int span, float distance)
{
    return MerkabaM8GridAabbIntersectsDistance(globalMin, span, distance,
        _M8CameraGridMeters, _M8GridMetricDiagonal, _M8GridMetricCross,
        MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
}

uint M8DistanceChildMask(int3 parentMin, int parentSpan, float distance)
{
    return MerkabaM8GridDistanceChildMask(parentMin, parentSpan, distance,
        _M8CameraGridMeters, _M8GridMetricDiagonal, _M8GridMetricCross,
        MERKABA_LATTICE_STEP, MERKABA_HALF_SUPPORT);
}

uint M8DrawChildMask(int3 parentMin, int parentSpan)
{
    return M8DistanceChildMask(parentMin, parentSpan, _M8RenderDistance);
}

uint M8DependencyChildMask(int3 parentMin, int parentSpan)
{
    return M8DistanceChildMask(parentMin, parentSpan,
        _M8DependencyDistance);
}

void M8RequestWarmLoad(uint tileRefIndex, uint chunkIndex, uint tileLocal,
    bool lateDraw)
{
    M8QueueColdTileLoad(tileRefIndex, chunkIndex, tileLocal);
    if (lateDraw) M8CounterIncrement(M8_COUNTER_LATE_DRAW_COLD_MISSES);
}


// A page retired by this slot is free again at this slot's next build: the
// slot is BACK for the whole of that build and no frame draws BACK.
void M8RetirePage(uint page)
{
    uint ticket;
    InterlockedAdd(_M8RenderPageQueues[M8_RENDER_CONTROL_RETIRE_TAIL], 1u,
        ticket);
    uint head = _M8RenderPageQueues[M8_RENDER_CONTROL_RETIRE_HEAD];
    if (ticket - head >= M8_RENDER_PAGE_CAPACITY) return;
    _M8RenderPageQueues[M8_RENDER_RETIRE_BASE +
        (ticket & M8_RENDER_RETIRE_MASK)] = page & M8_RENDER_PAGE_ID_MASK;
}

void M8RetireBackRecordPages(uint base)
{
    uint pages = min(_M8RenderIndexBack[base + 1u],
        M8_RENDER_TILE_MAX_PAGES);
    uint page = _M8RenderIndexBack[base + M8_RENDER_RECORD_FIRST_PAGE];
    for (uint ordinal = 0u;
        ordinal < pages && page != M8_RENDER_PAGE_INVALID; ordinal++)
    {
        uint next = _M8RenderPageQueues[M8_RENDER_LINK_BASE + page];
        M8RetirePage(page);
        page = next;
    }
}

[numthreads(1, 1, 1)]
void BeginRenderBuild(uint id : SV_DispatchThreadID)
{
    _M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT] = 0u;
    _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 0u;
    _M8Counters[M8_COUNTER_LATE_DRAW_COLD_MISSES] = 0u;
    _M8Counters[M8_COUNTER_CANDIDATE_BLOCKS] = 0u;
    _M8Counters[M8_COUNTER_HASH_HIT_BLOCKS] = 0u;
    _M8Counters[M8_COUNTER_VISIBLE_CHUNKS] = 0u;
    _M8Counters[M8_COUNTER_OCCUPIED_CONSIDERED] = 0u;
    _M8Counters[M8_COUNTER_READOUT_PLANE_VALID] = 0u;
    _M8Counters[M8_COUNTER_READOUT_EMITTED_PATCHES] = 0u;
    _M8Counters[M8_COUNTER_READOUT_UNRESOLVED] = 0u;
    _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES] = 0u;
    _M8Counters[M8_COUNTER_READOUT_PLANE_LEGACY_INVALID] = 0u;
    _M8Counters[M8_COUNTER_READOUT_EMITTED_VERTICES] = 0u;
    _M8Counters[M8_COUNTER_RENDER_REBUILD_TILES] = 0u;
    _M8Counters[M8_COUNTER_RENDER_VIEW_OVERFLOW] = 0u;
    _M8Counters[M8_COUNTER_RENDER_PUBLICATION_INVALID] = 0u;
    _M8Counters[M8_COUNTER_RENDER_PENDING_TILES] = 0u;
    _M8Counters[M8_COUNTER_RENDER_CAPACITY_FAILED] = 0u;
    _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] = MERKABA_READOUT_BUILDING;
    _M8Counters[M8_COUNTER_FRAME_EPOCH] += 1u;
    // The list built now goes to the other region of this slot; the list
    // this slot published last time stays readable for CopyRenderIndex and
    // CollectRenderRebuildTiles.
    _M8RenderIndexBack[M8_RENDER_HEADER_PREVIOUS_TILES] =
        _M8RenderIndexBack[0];
    _M8RenderIndexBack[M8_RENDER_HEADER_LIST_REGION] =
        (_M8RenderIndexBack[M8_RENDER_HEADER_LIST_REGION] ^ 1u) & 1u;
    _M8RenderIndexBack[0] = 0u;
    _M8RenderIndexBack[1] = 0u;
}

groupshared uint gFrameBlockRef;
groupshared int3 gFrameBlockMin;
groupshared uint gFrameWarm4;
groupshared uint gFrameDraw4;
groupshared uint gFrameDependency4;
groupshared uint gFrameWarm3[8];
groupshared uint gFrameDraw3[8];
groupshared uint gFrameDependency3[8];

[numthreads(64, 1, 1)]
void RequestWarmResidency(uint3 groupId : SV_GroupID, uint thread : SV_GroupIndex)
{
    uint linearBlockIndex = groupId.x;
    if (thread == 0u)
    {
        gFrameBlockRef = 0u;
        gFrameWarm4 = 0u;
        gFrameDraw4 = 0u;
        gFrameDependency4 = 0u;
        uint side = (uint)_M8QueryBlockSide;
        if (linearBlockIndex < side * side * side)
        {
            int3 offset;
            offset.x = (int)(linearBlockIndex % side) - _M8QueryBlockRadius;
            offset.y = (int)((linearBlockIndex / side) % side) -
                _M8QueryBlockRadius;
            offset.z = (int)(linearBlockIndex / (side * side)) -
                _M8QueryBlockRadius;
            int3 blockCoord = _M8QueryCenterBlock + offset;
            gFrameBlockMin = blockCoord * MERKABA_M8_BLOCK_KERNEL_SPAN;
            M8CounterIncrement(M8_COUNTER_CANDIDATE_BLOCKS);
            if (M8AabbIntersectsDistance(gFrameBlockMin,
                MERKABA_M8_BLOCK_KERNEL_SPAN, _M8WarmDistance))
            {
                uint blockIndex = 0u;
                if (M8FindBlock(blockCoord, blockIndex))
                {
                    gFrameBlockRef = blockIndex + 1u;
                    gFrameWarm4 = M8DistanceChildMask(gFrameBlockMin, 256,
                        _M8WarmDistance);
                    gFrameDraw4 = M8DrawChildMask(gFrameBlockMin, 256);
                    gFrameDependency4 = M8DependencyChildMask(
                        gFrameBlockMin, 256);
                    M8CounterIncrement(M8_COUNTER_HASH_HIT_BLOCKS);
                }
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (thread < 8u)
    {
        uint d4ForMask = thread;
        gFrameWarm3[d4ForMask] = 0u;
        gFrameDraw3[d4ForMask] = 0u;
        gFrameDependency3[d4ForMask] = 0u;
        if (gFrameBlockRef != 0u)
        {
            uint maskBlockIndex = gFrameBlockRef - 1u;
            if (((_M8BlockPresenceL0Read[maskBlockIndex] & gFrameWarm4) &
                (1u << d4ForMask)) != 0u)
            {
                int3 min4ForMask = gFrameBlockMin +
                    MerkabaM8OctantOffset(d4ForMask, 128);
                gFrameWarm3[d4ForMask] = M8DistanceChildMask(min4ForMask, 128,
                    _M8WarmDistance);
                gFrameDraw3[d4ForMask] =
                    ((gFrameDraw4 >> d4ForMask) & 1u) != 0u
                    ? M8DrawChildMask(min4ForMask, 128) : 0u;
                gFrameDependency3[d4ForMask] =
                    ((gFrameDependency4 >> d4ForMask) & 1u) != 0u
                    ? M8DependencyChildMask(min4ForMask, 128) : 0u;
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gFrameBlockRef == 0u) return;

    uint blockIndex = gFrameBlockRef - 1u;
    int3 blockMin = gFrameBlockMin;
    uint d4 = thread >> 3u;
    uint d3 = thread & 7u;
    if (((gFrameWarm4 >> d4) & 1u) == 0u ||
        (((_M8BlockPresenceL1Read[blockIndex * 8u + d4] &
        gFrameWarm3[d4]) >> d3) & 1u) == 0u) return;

    int3 min4 = blockMin + MerkabaM8OctantOffset(d4, 128);
    int3 min3 = min4 + MerkabaM8OctantOffset(d3, 64);
    uint warm2 = M8DistanceChildMask(min3, 64, _M8WarmDistance);
    bool drawPath3 = ((gFrameDraw4 >> d4) & 1u) != 0u &&
        ((gFrameDraw3[d4] >> d3) & 1u) != 0u;
    bool dependencyPath3 = ((gFrameDependency4 >> d4) & 1u) != 0u &&
        ((gFrameDependency3[d4] >> d3) & 1u) != 0u;
    uint draw2 = drawPath3 ? M8DrawChildMask(min3, 64) : 0u;
    uint dependency2 = dependencyPath3
        ? M8DependencyChildMask(min3, 64) : 0u;
    uint support2 = (_M8BlockPresenceL2Read[blockIndex * 64u +
        d4 * 8u + d3] & 255u) & warm2;
    while (support2 != 0u)
    {
        uint d2 = (uint)firstbitlow(support2);
        support2 &= support2 - 1u;
        uint chunkLocal = (d4 << 6u) | (d3 << 3u) | d2;
        uint chunkRef = _M8BlockChunkRefsRead[blockIndex * 512u + chunkLocal];
        if (chunkRef == 0u || chunkRef >= MERKABA_REF_EVICTING) continue;
        uint chunkIndex = chunkRef - 1u;
        int3 min2 = min3 + MerkabaM8OctantOffset(d2, 32);
        uint warm1 = M8DistanceChildMask(min2, 32, _M8WarmDistance);
        bool drawPath2 = drawPath3 && ((draw2 >> d2) & 1u) != 0u;
        bool dependencyPath2 = dependencyPath3 &&
            ((dependency2 >> d2) & 1u) != 0u;
        uint draw1 = drawPath2 ? M8DrawChildMask(min2, 32) : 0u;
        uint dependency1 = dependencyPath2
            ? M8DependencyChildMask(min2, 32) : 0u;
        uint support1 =
            (_M8ChunkPresenceRead[M8ChunkPresenceL0Index(chunkIndex)] &
            255u) & warm1;
        bool visibleChunk = false;
        while (support1 != 0u)
        {
            uint d1 = (uint)firstbitlow(support1);
            support1 &= support1 - 1u;
            int3 min1 = min2 + MerkabaM8OctantOffset(d1, 16);
            uint warm0 = M8DistanceChildMask(min1, 16, _M8WarmDistance);
            bool drawPath1 = drawPath2 && ((draw1 >> d1) & 1u) != 0u;
            bool dependencyPath1 = dependencyPath2 &&
                ((dependency1 >> d1) & 1u) != 0u;
            uint draw0 = drawPath1 ? M8DrawChildMask(min1, 16) : 0u;
            uint dependency0 = dependencyPath1
                ? M8DependencyChildMask(min1, 16) : 0u;
            uint support0 =
                (_M8ChunkPresenceRead[
                    M8ChunkPresenceL1Index(chunkIndex, d1)] & 255u) & warm0;
            while (support0 != 0u)
            {
                uint d0 = (uint)firstbitlow(support0);
                support0 &= support0 - 1u;
                uint tileLocal = (d1 << 3u) | d0;
                uint tileRefIndex = chunkIndex * 64u + tileLocal;
                uint tileRef = _M8ChunkTileRefs[tileRefIndex];
                bool inDraw = drawPath1 && ((draw0 >> d0) & 1u) != 0u;
                bool inDependency = dependencyPath1 &&
                    ((dependency0 >> d0) & 1u) != 0u;
                if (tileRef == MERKABA_REF_COLD_ON_SSD)
                {
                    M8RequestWarmLoad(tileRefIndex, chunkIndex, tileLocal,
                        inDraw);
                    if (inDraw)
                        M8CounterIncrement(M8_COUNTER_READOUT_UNRESOLVED);
                    continue;
                }
                if (!M8IsHotRef(tileRef) && inDraw)
                    M8CounterIncrement(M8_COUNTER_READOUT_UNRESOLVED);
                if (M8IsHotRef(tileRef) && inDraw)
                {
                    uint physicalSlot = M8PhysicalSlot(tileRef);
                    uint base = M8RecordBase(physicalSlot);
                    uint currentIdentity = tileRefIndex + 1u;
                    uint backIdentity = _M8RenderIndexBack[base + 2u];
                    uint previousBits;
                    InterlockedOr(_M8TileRecords[
                        M8TileRuntimeIndex(physicalSlot)].w,
                        M8_RENDER_VIEW_MARK, previousBits);

                    uint listIndex;
                    InterlockedAdd(_M8RenderIndexBack[0], 1u, listIndex);
                    if (listIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                    {
                        _M8RenderIndexBack[M8BackListBase() + listIndex] =
                            physicalSlot;
                        // BACK keeps its own previous record of this tile.
                        // A record of another logical tile is retired here;
                        // a stale version is rebuilt below.
                        if (backIdentity != currentIdentity)
                        {
                            if (backIdentity != 0u)
                                M8RetireBackRecordPages(base);
                            _M8RenderIndexBack[base + 0u] = 0u;
                            _M8RenderIndexBack[base + 1u] = 0u;
                            _M8RenderIndexBack[base + 2u] = 0u;
                            _M8RenderIndexBack[
                                base + M8_RENDER_RECORD_FIRST_PAGE] =
                                M8_RENDER_PAGE_INVALID;
                            _M8RenderIndexBack[
                                base + M8_RENDER_RECORD_VERSION] = 0u;
                        }

                        uint bits = _M8TileRecords[
                            M8TileRuntimeIndex(physicalSlot)].w;
                        bool needsBuild = backIdentity != currentIdentity ||
                            _M8RenderIndexBack[base + M8_RENDER_RECORD_VERSION]
                                != _M8RenderVersionsRead[physicalSlot] ||
                            (_M8ResidencyChanged != 0u &&
                             (bits & M8_RENDER_PENDING) != 0u);
                        if (needsBuild)
                        {
                            uint workIndex;
                            InterlockedAdd(_M8Counters[
                                M8_COUNTER_RENDER_REBUILD_TILES], 1u, workIndex);
                            if (workIndex < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
                                _M8VisibleTiles[workIndex] =
                                    uint2(physicalSlot, 0u);
                            else
                                _M8Counters[
                                    M8_COUNTER_RENDER_VIEW_OVERFLOW] = 1u;
                        }
                    }
                }
                if (inDraw) visibleChunk = true;
            }
        }
        if (visibleChunk) M8CounterIncrement(M8_COUNTER_VISIBLE_CHUNKS);
    }
}

struct M8ReadoutTileContext
{
    uint physicalSlot;
    int3 tileOrigin;
    int3 blockCoord;
    uint blockIndex;
    uint chunkIndex;
    uint chunkLocal;
};

#define M8_MEMBRANE_TILE_COUNT 27u
#define M8_MEMBRANE_TILE_WORD_COUNT \
    (M8_MEMBRANE_TILE_COUNT * MERKABA_M8_TILE_WORDS)
#define M8_MEMBRANE_CACHE_HALO 2
#define M8_MEMBRANE_CACHE_SIDE 12u
#define M8_MEMBRANE_CACHE_PLANE \
    (M8_MEMBRANE_CACHE_SIDE * M8_MEMBRANE_CACHE_SIDE)
#define M8_MEMBRANE_CACHE_COUNT \
    (M8_MEMBRANE_CACHE_PLANE * M8_MEMBRANE_CACHE_SIDE)
#define M8_MEMBRANE_CENTER_TILE 13u
#define M8_MEMBRANE_TILE_MISSING 0xfffffffeu
#define M8_MEMBRANE_TILE_UNRESOLVED 0xffffffffu

groupshared uint gM8MembranePhysicalSlot;
groupshared int3 gM8MembraneTileOrigin;
groupshared int3 gM8MembraneBlockCoord;
groupshared uint gM8MembraneBlockIndex;
groupshared uint gM8MembraneChunkIndex;
groupshared uint gM8MembraneChunkLocal;
groupshared uint gM8MembraneTileSlots[M8_MEMBRANE_TILE_COUNT];
groupshared uint gM8MembraneOccupiedWords[M8_MEMBRANE_TILE_WORD_COUNT];
// The measured plane of every halo cell, decoded once per tile: xyz unit
// normal, w = dot(C, N) + d. Two bits per cell classify it (bit 0 occupied
// with a measured plane, bit 1 known FREE). The oracle reads these, never
// the kernel states, so a corner candidate costs one groupshared read.
#define M8_MEMBRANE_CELL_WORDS 108u
#define M8_RENDER_TILE_KERNELS 512u
// Readout scratch capacity: at most this many rebuild tiles are solved per
// build; the rest keep their previous record and stay dirty for the next
// build (carry-over, never dropped).
#define M8_RENDER_SCRATCH_TILES 512u
#define M8_RENDER_SCRATCH_PATCHES 512u
#define M8_RENDER_SCRATCH_CORNERS 2048u
#define M8_RENDER_SCRATCH_CORNER_SHIFT 11u
#define M8_RENDER_SCRATCH_PATCH_SHIFT 9u
// Descriptor w after the solve: valid patch flag | output ordinal.
#define M8_SCRATCH_PATCH_VALID 0x80000000u
#define M8_SOLVE_GROUP_THREADS 64u
// Header words: 0 patch count, 1 knot (vertex) count, 2 unresolved, 3 flags.
#define M8_SCRATCH_FLAG_GUARDED 1u
// A solved knot may not leave its MAIN's support: farther than one lattice
// step from MAIN's own plane height it falls back to that height.
#define M8_MEMBRANE_KNOT_SUPPORT_LIMIT MERKABA_LATTICE_STEP
// Knots of one line and chart within this height distance are one vertex.
#define M8_MEMBRANE_WELD_EPSILON 0.001
// No patch edge may exceed this; longer patches are degenerate.
#define M8_MEMBRANE_MAX_EDGE 0.045
groupshared float4 gM8MembranePlane[M8_MEMBRANE_CACHE_COUNT];
groupshared uint gM8MembraneCellBits[M8_MEMBRANE_CELL_WORDS];
groupshared uint gM8MembraneCanEmit;
groupshared uint gM8MembraneMeasuredTotal;
// First entry of this tile's page chain in the build's allocation list; the
// chain itself stays in that list so the per-tile bound costs no groupshared.
groupshared uint gM8MembraneAllocBase;
groupshared uint gM8MembranePageCount;
groupshared uint gM8MembranePatchTotal;
groupshared uint gM8MembraneFailed;
groupshared uint gM8MembraneUnresolved;

M8ReadoutTileContext M8SharedReadoutTileContext()
{
    M8ReadoutTileContext context;
    context.physicalSlot = gM8MembranePhysicalSlot;
    context.tileOrigin = gM8MembraneTileOrigin;
    context.blockCoord = gM8MembraneBlockCoord;
    context.blockIndex = gM8MembraneBlockIndex;
    context.chunkIndex = gM8MembraneChunkIndex;
    context.chunkLocal = gM8MembraneChunkLocal;
    return context;
}

M8ReadoutTileContext M8TileContextOf(uint physicalSlot)
{
    // The tile being rebuilt owns scheduling bits in _M8TileRecords, so the
    // context reads the writable binding (a kernel never binds both aliases).
    M8ReadoutTileContext context;
    uint4 meta = _M8TileRecords[M8TileMetaIndex(physicalSlot)];
    uint2 owner = M8LoadChunkOwnerRead(meta.x);
    context.physicalSlot = physicalSlot;
    context.tileOrigin = M8GlobalKernelCoord(physicalSlot, 0u);
    context.blockIndex = owner.x;
    context.chunkIndex = meta.x;
    context.chunkLocal = owner.y;
    context.blockCoord = M8LoadBlockCoordRead(owner.x);
    return context;
}

void M8InitializeReadoutTileContext(uint physicalSlot)
{
    M8ReadoutTileContext context = M8TileContextOf(physicalSlot);
    gM8MembranePhysicalSlot = context.physicalSlot;
    gM8MembraneTileOrigin = context.tileOrigin;
    gM8MembraneBlockIndex = context.blockIndex;
    gM8MembraneChunkIndex = context.chunkIndex;
    gM8MembraneChunkLocal = context.chunkLocal;
    gM8MembraneBlockCoord = context.blockCoord;
}

uint M8MembraneTileIndex(int3 tileOffset)
{
    return (uint)(tileOffset.x + 1) +
        (uint)(tileOffset.y + 1) * 3u +
        (uint)(tileOffset.z + 1) * 9u;
}

int3 M8MembraneTileOffset(uint index)
{
    uint z = index >= 18u ? 2u : index >= 9u ? 1u : 0u;
    uint remainder = index - z * 9u;
    uint y = remainder >= 6u ? 2u : remainder >= 3u ? 1u : 0u;
    uint x = remainder - y * 3u;
    return int3((int)x - 1, (int)y - 1, (int)z - 1);
}

uint M8ResolveMembraneTile(M8ReadoutTileContext context, int3 tileOffset)
{
    if (!any(tileOffset != 0)) return context.physicalSlot;

    MerkabaM8Address address = MerkabaAddressOf(
        context.tileOrigin + tileOffset * 8);
    uint blockIndex = context.blockIndex;
    if (!all(address.blockCoord == context.blockCoord) &&
        !M8FindBlock(address.blockCoord, blockIndex))
        return M8_MEMBRANE_TILE_MISSING;

    uint chunkIndex = context.chunkIndex;
    if (blockIndex != context.blockIndex ||
        address.chunkLocal != context.chunkLocal)
    {
        uint chunkRef = _M8BlockChunkRefsRead[blockIndex *
            MERKABA_M8_BLOCK_CHUNK_COUNT + address.chunkLocal];
        if (chunkRef == MERKABA_REF_EMPTY)
            return M8_MEMBRANE_TILE_MISSING;
        if (chunkRef >= MERKABA_REF_EVICTING)
            return M8_MEMBRANE_TILE_UNRESOLVED;
        chunkIndex = chunkRef - 1u;
    }

    uint tileRef = _M8ChunkTileRefsRead[chunkIndex *
        MERKABA_M8_TILES_PER_CHUNK + address.tileLocal];
    if (tileRef == MERKABA_REF_EMPTY)
        return M8_MEMBRANE_TILE_MISSING;
    if (!M8IsHotRef(tileRef))
        return M8_MEMBRANE_TILE_UNRESOLVED;
    return M8PhysicalSlot(tileRef);
}

uint M8LoadKernelFlagsOnly(uint physicalSlot, uint kernelLocal)
{
    uint index = M8BankStateIndex(physicalSlot, kernelLocal);
    uint bank = physicalSlot >> MERKABA_M8_TILE_BANK_SHIFT;
    if (bank == 0u) return _M8KernelStates0Read[index].flags;
    if (bank == 1u) return _M8KernelStates1Read[index].flags;
    if (bank == 2u) return _M8KernelStates2Read[index].flags;
    return _M8KernelStates3Read[index].flags;
}

int M8LoadKernelEvidenceOnly(uint physicalSlot, uint kernelLocal)
{
    uint index = M8BankStateIndex(physicalSlot, kernelLocal);
    uint bank = physicalSlot >> MERKABA_M8_TILE_BANK_SHIFT;
    if (bank == 0u) return _M8KernelStates0Read[index].evidence;
    if (bank == 1u) return _M8KernelStates1Read[index].evidence;
    if (bank == 2u) return _M8KernelStates2Read[index].evidence;
    return _M8KernelStates3Read[index].evidence;
}

void M8MembraneCacheAddress(uint index, out int3 relative,
    out uint tileIndex, out uint kernelLocal)
{
    // The bounded [0,1727] index is exactly representable as float. Reciprocal
    // indexing avoids integer division in this Adreno hot path.
    uint z = (uint)((float)index * (1.0 / 144.0));
    uint remainder = index - z * M8_MEMBRANE_CACHE_PLANE;
    uint y = (uint)((float)remainder * (1.0 / 12.0));
    uint x = remainder - y * M8_MEMBRANE_CACHE_SIDE;
    relative = int3((int)x, (int)y, (int)z) - M8_MEMBRANE_CACHE_HALO;
    int3 tileOffset = int3(relative.x < 0 ? -1 : relative.x >= 8 ? 1 : 0,
        relative.y < 0 ? -1 : relative.y >= 8 ? 1 : 0,
        relative.z < 0 ? -1 : relative.z >= 8 ? 1 : 0);
    int3 tileLocal = relative - tileOffset * 8;
    tileIndex = M8MembraneTileIndex(tileOffset);
    kernelLocal = (uint)tileLocal.x | ((uint)tileLocal.y << 3u) |
        ((uint)tileLocal.z << 6u);
}

uint M8MembraneCacheIndex(int3 globalCoord)
{
    int3 local = globalCoord - gM8MembraneTileOrigin +
        M8_MEMBRANE_CACHE_HALO;
    return (uint)local.x + (uint)local.y * M8_MEMBRANE_CACHE_SIDE +
        (uint)local.z * M8_MEMBRANE_CACHE_PLANE;
}

bool M8MembraneCell(int3 globalCoord, out bool resolved, out bool measured,
    out bool knownFree)
{
    measured = false;
    knownFree = false;
    int3 local = globalCoord - gM8MembraneTileOrigin +
        M8_MEMBRANE_CACHE_HALO;
    if (any(local < 0) || any(local >= (int)M8_MEMBRANE_CACHE_SIDE))
    {
        resolved = false;
        return false;
    }
    int3 relative = globalCoord - gM8MembraneTileOrigin;
    int3 tileOffset = int3(relative.x < 0 ? -1 : relative.x >= 8 ? 1 : 0,
        relative.y < 0 ? -1 : relative.y >= 8 ? 1 : 0,
        relative.z < 0 ? -1 : relative.z >= 8 ? 1 : 0);
    uint slot = gM8MembraneTileSlots[M8MembraneTileIndex(tileOffset)];
    if (slot == M8_MEMBRANE_TILE_UNRESOLVED)
    {
        resolved = false;
        return false;
    }
    resolved = true;
    if (slot == M8_MEMBRANE_TILE_MISSING) return false;
    uint cellIndex = (uint)local.x + (uint)local.y * M8_MEMBRANE_CACHE_SIDE +
        (uint)local.z * M8_MEMBRANE_CACHE_PLANE;
    uint bits = gM8MembraneCellBits[cellIndex >> 4u] >>
        ((cellIndex & 15u) * 2u);
    measured = (bits & 1u) != 0u;
    knownFree = (bits & 2u) != 0u;
    return true;
}

float4 M8MembranePlaneOf(int3 globalCoord)
{
    return gM8MembranePlane[M8MembraneCacheIndex(globalCoord)];
}

[numthreads(1, 1, 1)]
void PrepareRenderReclaim(uint id : SV_DispatchThreadID)
{
    // A rejected BACK keeps its records and their pages: the next build of
    // this slot completes it. Only the retire ring returns pages, one build
    // after they stopped being referenced.
    uint head = _M8RenderPageQueues[M8_RENDER_CONTROL_RETIRE_HEAD];
    uint tail = _M8RenderPageQueues[M8_RENDER_CONTROL_RETIRE_TAIL];
    uint pending = min(tail - head, M8_RENDER_PAGE_CAPACITY);
    _M8RenderPageQueues[M8_RENDER_CONTROL_RECLAIM_COUNT] = pending;
    _M8FrameDispatchArgs[0] = max(1u, (pending + 255u) >> 8u);
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
}

[numthreads(256, 1, 1)]
void ReclaimRenderPages(uint id : SV_DispatchThreadID)
{
    uint count = _M8RenderPageQueues[M8_RENDER_CONTROL_RECLAIM_COUNT];
    uint freeBase = _M8RenderPageQueues[M8_RENDER_CONTROL_FREE_PAGES];
    if (id >= count || freeBase + id >= M8_RENDER_PAGE_CAPACITY) return;
    uint head = _M8RenderPageQueues[M8_RENDER_CONTROL_RETIRE_HEAD];
    uint entry = _M8RenderPageQueues[M8_RENDER_RETIRE_BASE +
        ((head + id) & M8_RENDER_RETIRE_MASK)];
    _M8RenderPageQueues[M8_RENDER_FREE_BASE + freeBase + id] =
        entry & M8_RENDER_PAGE_ID_MASK;
}

[numthreads(1, 1, 1)]
void ApplyRenderReclaim(uint id : SV_DispatchThreadID)
{
    uint reclaimed = _M8RenderPageQueues[M8_RENDER_CONTROL_RECLAIM_COUNT];
    uint freePages = min(_M8RenderPageQueues[M8_RENDER_CONTROL_FREE_PAGES] +
        reclaimed, M8_RENDER_PAGE_CAPACITY);
    _M8RenderPageQueues[M8_RENDER_CONTROL_FREE_PAGES] = freePages;
    _M8RenderPageQueues[M8_RENDER_CONTROL_RETIRE_HEAD] += reclaimed;
    _M8RenderPageQueues[M8_RENDER_CONTROL_RECLAIM_COUNT] = 0u;
    _M8RenderPageQueues[M8_RENDER_CONTROL_ALLOC_COUNT] = 0u;
}

[numthreads(128, 1, 1)]
void CopyRenderIndex(uint id : SV_DispatchThreadID)
{
    // Page ownership of this publication starts empty; RecountRenderPatches
    // claims every page of every published record. This sweep covers one
    // physical tile per thread, two pages each.
    _M8RenderPageQueues[M8_RENDER_OWNER_BASE + id * 2u] = 0u;
    _M8RenderPageQueues[M8_RENDER_OWNER_BASE + id * 2u + 1u] = 0u;
    if (id >= M8BackPreviousTileCount()) return;
    uint physicalSlot = _M8RenderIndexBack[M8BackPreviousListBase() + id];
    if (physicalSlot >= MERKABA_M8_PHYSICAL_TILE_CAPACITY) return;
    uint ignored;
    InterlockedAnd(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
        ~M8_RENDER_VIEW_MARK, ignored);
}


uint M8CurrentRenderIdentity(uint physicalSlot)
{
    uint4 meta = _M8TileRecords[M8TileMetaIndex(physicalSlot)];
    uint refIndex = meta.x * MERKABA_M8_TILES_PER_CHUNK + meta.y;
    return refIndex < MERKABA_M8_CHUNK_CAPACITY *
        MERKABA_M8_TILES_PER_CHUNK &&
        _M8ChunkTileRefsRead[refIndex] == physicalSlot + 1u
        ? refIndex + 1u : 0u;
}

bool M8RenderJournalReserve(uint headCounter, uint tailCounter,
    out uint ticket)
{
    ticket = 0u;
    [loop]
    for (uint attempt = 0u; attempt < 16u; attempt++)
    {
        uint head = _M8Counters[headCounter];
        uint tail = _M8Counters[tailCounter];
        if (tail - head >= M8_RENDER_JOURNAL_CAPACITY)
        {
            _M8Counters[M8_COUNTER_RENDER_JOURNAL_OVERFLOW] = 1u;
            return false;
        }
        uint prior;
        InterlockedCompareExchange(_M8Counters[tailCounter], tail,
            tail + 1u, prior);
        if (prior == tail)
        {
            ticket = tail;
            return true;
        }
    }
    _M8Counters[M8_COUNTER_RENDER_JOURNAL_OVERFLOW] = 1u;
    return false;
}

void M8RenderJournalQueueDirty(uint physicalSlot, uint dependencyBits)
{
    uint previous;
    InterlockedOr(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
        M8_RENDER_DIRTY | M8_RENDER_DIRTY_QUEUED |
        (dependencyBits & M8_RENDER_DEPENDENCY_MASK), previous);
    if ((previous & M8_RENDER_DIRTY_QUEUED) != 0u) return;
    uint ticket;
    if (!M8RenderJournalReserve(M8_COUNTER_RENDER_JOURNAL_HEAD,
            M8_COUNTER_RENDER_JOURNAL_TAIL, ticket))
    {
        uint ignored;
        InterlockedAnd(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
            ~M8_RENDER_DIRTY_QUEUED, ignored);
        return;
    }
    uint entry = (ticket & M8_RENDER_JOURNAL_MASK) *
        M8_RENDER_JOURNAL_ENTRY_WORDS;
    _M8RenderMutationQueue[entry] = physicalSlot;
    _M8RenderMutationQueue[entry + 1u] =
        M8CurrentRenderIdentity(physicalSlot);
}

void M8MarkDependencyDirty(uint physicalSlot)
{
    if (physicalSlot >= MERKABA_M8_PHYSICAL_TILE_CAPACITY) return;
    uint previous;
    InterlockedOr(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
        M8_RENDER_DIRTY, previous);
    InterlockedAdd(_M8RenderVersions[physicalSlot], 1u, previous);
    if ((previous & M8_RENDER_DIRTY) == 0u)
        M8CounterIncrement(M8_COUNTER_RENDER_DIRTY_MARKS);
}


void M8QueueRenderDependencies(uint physicalSlot, uint dependencyBits)
{
    if (dependencyBits == 0u ||
        M8CurrentRenderIdentity(physicalSlot) == 0u) return;
    M8ReadoutTileContext context = M8TileContextOf(physicalSlot);
    [unroll]
    for (uint neighbour = 0u; neighbour < 26u; neighbour++)
    {
        uint dependency = 1u << (M8_RENDER_DEPENDENCY_SHIFT + neighbour);
        if ((dependencyBits & dependency) == 0u) continue;
        uint gridIndex = neighbour < 13u ? neighbour : neighbour + 1u;
        uint slot = M8ResolveMembraneTile(context,
            M8MembraneTileOffset(gridIndex));
        if (slot < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
            M8MarkDependencyDirty(slot);
    }
}

[numthreads(1, 1, 1)]
void MarkRenderRebuildTiles(uint id : SV_DispatchThreadID)
{
    uint head = _M8Counters[M8_COUNTER_RENDER_JOURNAL_HEAD];
    uint tail = _M8Counters[M8_COUNTER_RENDER_JOURNAL_TAIL];
    uint count = min(tail - head, M8_RENDER_JOURNAL_CAPACITY);
    _M8Counters[M8_COUNTER_RENDER_JOURNAL_BATCH] = count;
    _M8FrameDispatchArgs[0] = max(1u, (count + 63u) >> 6u);
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
}

[numthreads(64, 1, 1)]
void ApplyRenderMutationJournal(uint id : SV_DispatchThreadID)
{
    uint count = _M8Counters[M8_COUNTER_RENDER_JOURNAL_BATCH];
    if (id >= count) return;
    uint head = _M8Counters[M8_COUNTER_RENDER_JOURNAL_HEAD];
    uint entry = ((head + id) & M8_RENDER_JOURNAL_MASK) *
        M8_RENDER_JOURNAL_ENTRY_WORDS;
    uint physicalSlot = _M8RenderMutationQueue[entry];
    uint journalledIdentity = _M8RenderMutationQueue[entry + 1u];
    if (physicalSlot >= MERKABA_M8_PHYSICAL_TILE_CAPACITY) return;
    // A slot recycled by eviction must never mark the tile that took it.
    if (journalledIdentity != 0u &&
        M8CurrentRenderIdentity(physicalSlot) != journalledIdentity)
    {
        uint stale;
        InterlockedAnd(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
            ~M8_RENDER_DIRTY_QUEUED, stale);
        return;
    }
    uint previous;
    InterlockedAnd(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
        ~(M8_RENDER_DIRTY_QUEUED | M8_RENDER_DEPENDENCY_MASK), previous);
    uint version;
    InterlockedAdd(_M8RenderVersions[physicalSlot], 1u, version);
    M8QueueRenderDependencies(physicalSlot,
        previous & M8_RENDER_DEPENDENCY_MASK);
}

[numthreads(128, 1, 1)]
void CollectRenderRebuildTiles(uint id : SV_DispatchThreadID)
{
    // Tiles that BACK published last time but which left coverage now.
    if (id >= M8BackPreviousTileCount()) return;
    uint physicalSlot = _M8RenderIndexBack[M8BackPreviousListBase() + id];
    if (physicalSlot >= MERKABA_M8_PHYSICAL_TILE_CAPACITY) return;
    uint bits = _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w;
    if ((bits & M8_RENDER_VIEW_MARK) != 0u) return;
    uint base = M8RecordBase(physicalSlot);
    if (_M8RenderIndexBack[base + 2u] == 0u) return;
    M8RetireBackRecordPages(base);
    _M8RenderIndexBack[base + 0u] = 0u;
    _M8RenderIndexBack[base + 1u] = 0u;
    _M8RenderIndexBack[base + 2u] = 0u;
    _M8RenderIndexBack[base + M8_RENDER_RECORD_FIRST_PAGE] =
        M8_RENDER_PAGE_INVALID;
    _M8RenderIndexBack[base + M8_RENDER_RECORD_VERSION] = 0u;
}

[numthreads(1, 1, 1)]
void PrepareRenderBuild(uint id : SV_DispatchThreadID)
{
    uint journalCount = _M8Counters[M8_COUNTER_RENDER_JOURNAL_BATCH];
    uint journalHead = _M8Counters[M8_COUNTER_RENDER_JOURNAL_HEAD] +
        journalCount;
    _M8Counters[M8_COUNTER_RENDER_JOURNAL_HEAD] = journalHead;
    if (journalHead == _M8Counters[M8_COUNTER_RENDER_JOURNAL_TAIL])
        _M8Counters[M8_COUNTER_RENDER_JOURNAL_OVERFLOW] = 0u;
    _M8Counters[M8_COUNTER_RENDER_JOURNAL_BATCH] = 0u;
    uint tiles = min(_M8Counters[M8_COUNTER_RENDER_REBUILD_TILES],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    _M8Counters[M8_COUNTER_VISIBLE_TILE_COUNT] = tiles;
    _M8FrameDispatchArgs[0] = tiles;
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
}


void M8StoreRenderVertex(uint vertex, float3 gridPosition, uint packedColor)
{
    uint address = vertex * 16u;
    _M8RenderVertices.Store3(address, asuint(gridPosition));
    _M8RenderVertices.Store(address + 12u, packedColor);
}

// Exact union-skin topology. Missing neighbour tiles are empty; non-resident
// neighbours are unresolved and defer publication so FRONT remains coherent.
// Full canonical state of a resolved halo kernel through the cached tile
// slots: colour and confidence come from the record, not from the halo
// summary, so the live knot equals the export knot.
KernelState M8LoadMembraneOwnerState(int3 globalCoord)
{
    int3 relative = globalCoord - gM8MembraneTileOrigin;
    int3 tileOffset = int3(relative.x < 0 ? -1 : relative.x >= 8 ? 1 : 0,
        relative.y < 0 ? -1 : relative.y >= 8 ? 1 : 0,
        relative.z < 0 ? -1 : relative.z >= 8 ? 1 : 0);
    int3 local = relative - tileOffset * 8;
    uint slot = gM8MembraneTileSlots[M8MembraneTileIndex(tileOffset)];
    uint kernelLocal = (uint)local.x | ((uint)local.y << 3u) |
        ((uint)local.z << 6u);
    return M8LoadKernelStateRead(slot, kernelLocal);
}

void M8LoadMembraneColor(int3 globalCoord, out uint packedColor,
    out uint colorConfidence)
{
    KernelState owner = M8LoadMembraneOwnerState(globalCoord);
    packedColor = owner.packedColor;
    colorConfidence = owner.colorConfidence;
}

// The membrane is the frozen CPU/HLSL oracle: one measured MAIN owns one
// 25 mm quad (4 vertices, 6 indices, 2 triangles) whose corners are shared
// knots solved from the corner neighbourhood. The 50 mm support decides only
// which samples are joined; it never defines a triangle.
// Page p of this tile's chain, from the build's allocation list.
uint M8TilePage(uint ordinal)
{
    return _M8RenderPageQueues[M8_RENDER_ALLOC_BASE + gM8MembraneAllocBase +
        ordinal];
}

bool M8TakeRenderPages(uint pagesNeeded)
{
    if (pagesNeeded == 0u) return true;
    if (gM8MembranePageCount != 0u || pagesNeeded > M8_RENDER_TILE_MAX_PAGES)
        return false;
    // One atomic pop of the shared free stack: concurrent tile groups never
    // observe the same page, and an exhausted pool reverts its own claim.
    // Nothing pushes onto the free stack during a build (rejected tiles
    // retire their pages), so the popped range is intact while it is read.
    uint remaining;
    InterlockedAdd(_M8RenderPageQueues[M8_RENDER_CONTROL_FREE_PAGES],
        ~pagesNeeded + 1u, remaining);
    if (remaining < pagesNeeded || remaining > M8_RENDER_PAGE_CAPACITY)
    {
        uint ignored;
        InterlockedAdd(_M8RenderPageQueues[M8_RENDER_CONTROL_FREE_PAGES],
            pagesNeeded, ignored);
        return false;
    }
    uint allocBase;
    InterlockedAdd(_M8RenderPageQueues[M8_RENDER_CONTROL_ALLOC_COUNT],
        pagesNeeded, allocBase);
    if (allocBase + pagesNeeded > M8_RENDER_PAGE_CAPACITY)
    {
        uint ignored;
        InterlockedAdd(_M8RenderPageQueues[M8_RENDER_CONTROL_FREE_PAGES],
            pagesNeeded, ignored);
        return false;
    }
    gM8MembraneAllocBase = allocBase;
    uint previous = M8_RENDER_PAGE_INVALID;
    [loop]
    for (uint page = 0u; page < pagesNeeded; page++)
    {
        uint pageId = _M8RenderPageQueues[
            M8_RENDER_FREE_BASE + remaining - 1u - page];
        _M8RenderPageQueues[M8_RENDER_ALLOC_BASE + allocBase + page] = pageId;
        if (previous != M8_RENDER_PAGE_INVALID)
            _M8RenderPageQueues[M8_RENDER_LINK_BASE + previous] = pageId;
        _M8RenderPageQueues[M8_RENDER_LINK_BASE + pageId] =
            M8_RENDER_PAGE_INVALID;
        previous = pageId;
    }
    gM8MembranePageCount = pagesNeeded;
    return true;
}

void M8DiscardTilePages()
{
    // Pages of a rejected tile belong to no record; they return through the
    // retire ring of this slot like every page a build stops referencing.
    uint count = gM8MembranePageCount;
    [loop]
    for (uint page = 0u; page < count; page++)
        M8RetirePage(M8TilePage(page));
}

// The upper bound taken before emission is trimmed to the pages the tile
// really filled; the surplus returns through the retire ring.
void M8TrimTilePages(uint keepPages)
{
    uint count = gM8MembranePageCount;
    if (keepPages >= count) return;
    if (keepPages != 0u)
        _M8RenderPageQueues[M8_RENDER_LINK_BASE +
            M8TilePage(keepPages - 1u)] = M8_RENDER_PAGE_INVALID;
    [loop]
    for (uint page = keepPages; page < count; page++)
        M8RetirePage(M8TilePage(page));
    gM8MembranePageCount = keepPages;
}

// Vertex k of the tile lives in page chain[k >> 6], slot k & 63.
uint M8MembraneVertexSlot(uint tileVertex)
{
    return M8TilePage(tileVertex >> M8_RENDER_PAGE_VERTEX_SHIFT) *
        M8_RENDER_PAGE_VERTICES +
        (tileVertex & (M8_RENDER_PAGE_VERTICES - 1u));
}

// Index j of the tile lives in page chain[j >> 8], slot j & 255.
uint M8MembraneIndexSlot(uint tileIndex)
{
    return M8TilePage(tileIndex >> M8_RENDER_PAGE_INDEX_SHIFT) *
        M8_RENDER_PAGE_INDICES +
        (tileIndex & (M8_RENDER_PAGE_INDICES - 1u));
}

// ---------------------------------------------------------------------------
// Readout build in three flat dispatches per rebuild tile (contract C5/C6):
//   CollectRenderPatchInputs   one descriptor slot per kernel, fixed by
//                              kernelLocal: no atomic compaction, no map
//   ReduceAndSolveSharedKnots  one corner solve per task, weld so one physical
//                              knot is one vertex; valid patches and referenced
//                              root knots take ordinals by atomic ticket
//   EmitRenderTileGeometry     pages, one vertex per referenced root knot, six
//                              indices per valid patch, records
// No kernel mixes solve with emission, nothing is indexed dynamically in
// private memory and no lane walks the tile serially.
// ---------------------------------------------------------------------------

groupshared uint gM8ScratchVertexTotal;
groupshared uint gM8ScratchValidPatches;

uint M8ScratchPatchBase(uint work)
{
    return work << M8_RENDER_SCRATCH_PATCH_SHIFT;
}

uint M8ScratchCornerBase(uint work)
{
    return work << M8_RENDER_SCRATCH_CORNER_SHIFT;
}

// Retires the record of a tile whose identity is gone (evicted or reused).
void M8ClearDepartedRecord(uint work, uint physicalSlot)
{
    uint ignored;
    uint base = M8RecordBase(physicalSlot);
    M8RetireBackRecordPages(base);
    _M8RenderIndexBack[base + 0u] = 0u;
    _M8RenderIndexBack[base + 1u] = 0u;
    _M8RenderIndexBack[base + 2u] = 0u;
    _M8RenderIndexBack[base + M8_RENDER_RECORD_FIRST_PAGE] =
        M8_RENDER_PAGE_INVALID;
    _M8RenderIndexBack[base + M8_RENDER_RECORD_VERSION] = 0u;
    InterlockedAnd(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
        ~(M8_RENDER_DIRTY | M8_RENDER_PENDING |
          M8_RENDER_DEPENDENCY_MASK), ignored);
    _M8VisibleTiles[work].y = 1u;
}

// Descriptor: x = kernelLocal | chart << 9 | freeSignature << 11,
// y = MAIN flags, z = packed colour, w = colour confidence while solving,
// then M8_SCRATCH_PATCH_VALID | output ordinal for a valid patch, 0 otherwise.
bool M8DescriptorMeasured(uint4 descriptor)
{
    return (descriptor.y & MERKABA_OCCUPIED_FLAG) != 0u &&
        M8HasSurfacePlane(descriptor.y);
}

// Kernel 1: one descriptor slot per kernel of the tile. A slot that holds
// no measured MAIN is written as zero, which also clears stale scratch.
[numthreads(128, 1, 1)]
void CollectRenderPatchInputs(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint work = groupId.x;
    uint physicalSlot = _M8VisibleTiles[work].x;
    if (thread == 0u)
    {
        gM8MembraneMeasuredTotal = 0u;
        gM8MembraneUnresolved = 0u;
        gM8MembraneFailed = 0u;
        if (M8CurrentRenderIdentity(physicalSlot) == 0u)
        {
            M8ClearDepartedRecord(work, physicalSlot);
            gM8MembraneFailed = 2u;
        }
        else if (work >= M8_RENDER_SCRATCH_TILES)
        {
            // Beyond the scratch capacity: keep the previous record, stay
            // dirty, list it if it was published before.
            _M8VisibleTiles[work].y =
                _M8RenderIndexBack[M8RecordBase(physicalSlot) + 2u] != 0u
                    ? 1u : 0u;
            gM8MembraneFailed = 2u;
        }
        else
        {
            _M8VisibleTiles[work].y = 0u;
            M8InitializeReadoutTileContext(physicalSlot);
            uint ignored;
            InterlockedAdd(_M8Counters[M8_COUNTER_OCCUPIED_CONSIDERED],
                _M8TileRecords[M8TileMetaIndex(physicalSlot)].z, ignored);
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gM8MembraneFailed == 2u) return;

    M8ReadoutTileContext context = M8SharedReadoutTileContext();
    if (thread < M8_MEMBRANE_TILE_COUNT)
        gM8MembraneTileSlots[thread] = M8ResolveMembraneTile(context,
            M8MembraneTileOffset(thread));
    if (thread < M8_MEMBRANE_CELL_WORDS) gM8MembraneCellBits[thread] = 0u;
    GroupMemoryBarrierWithGroupSync();

    for (uint wordIndex = thread;
        wordIndex < M8_MEMBRANE_TILE_WORD_COUNT;
        wordIndex += M8_SHELL_GROUP_THREADS)
    {
        uint tileIndex = wordIndex >> 4u;
        uint word = wordIndex - tileIndex * MERKABA_M8_TILE_WORDS;
        uint slot = gM8MembraneTileSlots[tileIndex];
        gM8MembraneOccupiedWords[wordIndex] =
            slot < MERKABA_M8_PHYSICAL_TILE_CAPACITY
            ? _M8TileBitsRead[M8TileWordIndex(slot, word)].x : 0u;
    }
    // Only the two free-side cells of each MAIN are classified here; the
    // solve dispatch builds the full plane cache.
    for (uint cacheIndex = thread; cacheIndex < M8_MEMBRANE_CACHE_COUNT;
        cacheIndex += M8_SHELL_GROUP_THREADS)
    {
        int3 relative;
        uint tileIndex;
        uint kernelLocal;
        M8MembraneCacheAddress(cacheIndex, relative, tileIndex, kernelLocal);
        uint slot = gM8MembraneTileSlots[tileIndex];
        uint bits = 0u;
        if (slot < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
        {
            uint occupancy = gM8MembraneOccupiedWords[tileIndex *
                MERKABA_M8_TILE_WORDS + (kernelLocal >> 5u)];
            if ((occupancy & (1u << (kernelLocal & 31u))) != 0u)
                bits = 1u;
            else if (M8LoadKernelEvidenceOnly(slot, kernelLocal) <=
                     MERKABA_EXPORT_KNOWN_FREE)
                bits = 2u;
        }
        if (bits != 0u)
        {
            uint ignored;
            InterlockedOr(gM8MembraneCellBits[cacheIndex >> 4u],
                bits << ((cacheIndex & 15u) * 2u), ignored);
        }
    }
    GroupMemoryBarrierWithGroupSync();

    uint patchBase = M8ScratchPatchBase(work);
    [loop]
    for (uint batch = 0u; batch < 4u; batch++)
    {
        uint kernelLocal = thread + batch * M8_SHELL_GROUP_THREADS;
        uint4 descriptor = 0u;
        uint occupancy = gM8MembraneOccupiedWords[
            M8_MEMBRANE_CENTER_TILE * MERKABA_M8_TILE_WORDS +
            (kernelLocal >> 5u)];
        if ((occupancy & (1u << (kernelLocal & 31u))) != 0u)
        {
            KernelState state =
                M8LoadKernelStateRead(physicalSlot, kernelLocal);
            if ((state.flags & MERKABA_OCCUPIED_FLAG) != 0u &&
                M8HasSurfacePlane(state.flags))
            {
                uint ignored;
                InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_PLANE_VALID],
                    1u, ignored);
                float3 normal;
                float signedOffset;
                M8DecodeSurfacePlane(state.flags, normal, signedOffset);
                int chart = M8MembraneDominantAxis(normal);
                int3 globalCoord = context.tileOrigin + int3(
                    kernelLocal & 7u, (kernelLocal >> 3u) & 7u,
                    (kernelLocal >> 6u) & 7u);
                uint freeSignature;
                bool unresolved;
                if (M8MembraneFreeSideSignature(globalCoord, chart,
                        freeSignature, unresolved))
                {
                    descriptor = uint4(kernelLocal | ((uint)chart << 9u) |
                        (freeSignature << 11u), state.flags,
                        state.packedColor, state.colorConfidence);
                    InterlockedAdd(gM8MembraneMeasuredTotal, 1u, ignored);
                }
                else if (unresolved)
                    InterlockedOr(gM8MembraneUnresolved, 1u, ignored);
            }
        }
        _M8RenderPatchScratch[patchBase + kernelLocal] = descriptor;
    }
    GroupMemoryBarrierWithGroupSync();
    if (thread == 0u)
        _M8RenderScratchHeader[work] = uint4(0u, 0u,
            gM8MembraneUnresolved, gM8MembraneMeasuredTotal);
}

// Corner slot order of a patch: 0 = (-1,-1), 1 = (+1,-1), 2 = (+1,+1),
// 3 = (-1,+1) in tangent axes (t0, t1).
int M8CornerSign0(uint corner) { return (corner == 1u || corner == 2u) ? 1 : -1; }
int M8CornerSign1(uint corner) { return corner >= 2u ? 1 : -1; }

// Kernel 2: solve every patch corner once from the plane cache, weld corners
// of one line, chart and free side whose heights agree so that one physical
// knot is one vertex inside the tile, then give valid patches and the root
// knots they reference their ordinals. Corner task = kernelLocal * 4 + corner.
// Knot result: x = height bits, y = knot colour, z = key, w = bit 0 solved,
// bit 1 referenced by a valid patch.
[numthreads(64, 1, 1)]
void ReduceAndSolveSharedKnots(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint work = groupId.x;
    // Tile prologue inline (FXC rejects a barrier after a return inside
    // a helper): identity, context, halo slots, occupancy, plane cache.
    uint physicalSlot = _M8VisibleTiles[work].x;
    if (thread == 0u)
    {
        gM8MembraneUnresolved = 0u;
        gM8ScratchVertexTotal = 0u;
        gM8ScratchValidPatches = 0u;
        gM8MembraneFailed = 0u;
        if (work >= M8_RENDER_SCRATCH_TILES ||
            M8CurrentRenderIdentity(physicalSlot) == 0u)
            gM8MembraneFailed = 2u;
        else
            M8InitializeReadoutTileContext(physicalSlot);
    }
    GroupMemoryBarrierWithGroupSync();
    if (gM8MembraneFailed == 2u) return;

    M8ReadoutTileContext context = M8SharedReadoutTileContext();
    if (thread < M8_MEMBRANE_TILE_COUNT)
        gM8MembraneTileSlots[thread] = M8ResolveMembraneTile(context,
            M8MembraneTileOffset(thread));
    if (thread < M8_MEMBRANE_CELL_WORDS) gM8MembraneCellBits[thread] = 0u;
    GroupMemoryBarrierWithGroupSync();

    for (uint wordIndex = thread;
        wordIndex < M8_MEMBRANE_TILE_WORD_COUNT;
        wordIndex += M8_SOLVE_GROUP_THREADS)
    {
        uint tileIndex = wordIndex >> 4u;
        uint word = wordIndex - tileIndex * MERKABA_M8_TILE_WORDS;
        uint slot = gM8MembraneTileSlots[tileIndex];
        gM8MembraneOccupiedWords[wordIndex] =
            slot < MERKABA_M8_PHYSICAL_TILE_CAPACITY
            ? _M8TileBitsRead[M8TileWordIndex(slot, word)].x : 0u;
    }
    GroupMemoryBarrierWithGroupSync();

    // Every halo cell is classified and its plane decoded exactly once.
    for (uint cacheIndex = thread; cacheIndex < M8_MEMBRANE_CACHE_COUNT;
        cacheIndex += M8_SOLVE_GROUP_THREADS)
    {
        int3 relative;
        uint tileIndex;
        uint kernelLocal;
        M8MembraneCacheAddress(cacheIndex, relative, tileIndex, kernelLocal);
        uint slot = gM8MembraneTileSlots[tileIndex];
        float4 plane = 0.0;
        uint bits = 0u;
        if (slot < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
        {
            uint occupancy = gM8MembraneOccupiedWords[tileIndex *
                MERKABA_M8_TILE_WORDS + (kernelLocal >> 5u)];
            if ((occupancy & (1u << (kernelLocal & 31u))) != 0u)
            {
                uint flags = M8LoadKernelFlagsOnly(slot, kernelLocal);
                if ((flags & MERKABA_OCCUPIED_FLAG) != 0u &&
                    M8HasSurfacePlane(flags))
                {
                    float3 normal;
                    float signedOffset;
                    M8DecodeSurfacePlane(flags, normal, signedOffset);
                    int3 globalCoord = gM8MembraneTileOrigin + relative;
                    plane = float4(normal, dot((float3)globalCoord *
                        MERKABA_LATTICE_STEP, normal) + signedOffset);
                    bits = 1u;
                }
            }
            else if (M8LoadKernelEvidenceOnly(slot, kernelLocal) <=
                     MERKABA_EXPORT_KNOWN_FREE)
                bits = 2u;
        }
        gM8MembranePlane[cacheIndex] = plane;
        if (bits != 0u)
        {
            uint ignored;
            InterlockedOr(gM8MembraneCellBits[cacheIndex >> 4u],
                bits << ((cacheIndex & 15u) * 2u), ignored);
        }
    }
    GroupMemoryBarrierWithGroupSync();
    uint4 header = _M8RenderScratchHeader[work];
    uint patchBase = M8ScratchPatchBase(work);
    uint cornerBase = M8ScratchCornerBase(work);

    // Phase A: one corner solve per task.
    [loop]
    for (uint task = thread; task < M8_RENDER_SCRATCH_CORNERS;
        task += M8_SOLVE_GROUP_THREADS)
    {
        uint kernelLocal = task >> 2u;
        uint corner = task & 3u;
        uint4 descriptor = _M8RenderPatchScratch[patchBase + kernelLocal];
        uint4 result = 0u;
        if (M8DescriptorMeasured(descriptor))
        {
            int chart = (int)((descriptor.x >> 9u) & 3u);
            uint freeSignature = (descriptor.x >> 11u) & 3u;
            KernelState state = (KernelState)0;
            state.flags = descriptor.y;
            state.packedColor = descriptor.z;
            state.colorConfidence = descriptor.w;
            state.evidence = 1;
            int3 globalCoord = context.tileOrigin + int3(
                kernelLocal & 7u, (kernelLocal >> 3u) & 7u,
                (kernelLocal >> 6u) & 7u);
            float3 normal;
            float signedOffset;
            M8DecodeSurfacePlane(state.flags, normal, signedOffset);
            int tangentAxis0;
            int tangentAxis1;
            M8MembraneTangentAxes(chart, tangentAxis0, tangentAxis1);
            float3 position;
            uint color;
            int3 knotLine;
            bool unresolved;
            if (M8MembraneResolveCorner(globalCoord, state, normal, signedOffset,
                    chart, tangentAxis0, tangentAxis1, M8CornerSign0(corner),
                    M8CornerSign1(corner), freeSignature, position, color,
                    knotLine, unresolved))
            {
                // Support guard: a knot farther than one lattice step from
                // MAIN's own measured plane falls back to that plane's
                // height on the knot line (measured, never invented).
                float height = position[chart];
                float3 cornerLine = position;
                cornerLine = M8MembraneSetFloatComponent(cornerLine, chart,
                    0.0);
                float mainHeight;
                if (M8MembranePlaneLineHeight(globalCoord, normal,
                        signedOffset, chart, cornerLine, mainHeight) &&
                    abs(height - mainHeight) > M8_MEMBRANE_KNOT_SUPPORT_LIMIT)
                    height = mainHeight;
                // Key: line address in tangent axes (9 bits each, offset
                // 256), chart and free side.
                uint key = ((uint)(knotLine[tangentAxis0] + 256) & 511u) |
                    (((uint)(knotLine[tangentAxis1] + 256) & 511u) << 9u) |
                    ((uint)chart << 18u) | (freeSignature << 20u);
                result = uint4(asuint(height), color, key, 1u);
            }
            else if (unresolved)
            {
                uint ignored;
                InterlockedOr(gM8MembraneUnresolved, 1u, ignored);
            }
        }
        _M8RenderKnotScratch[cornerBase + task] = result;
    }
    DeviceMemoryBarrierWithGroupSync();

    // Phase B: weld. The owner of a corner is the lowest task among the
    // corners of the (up to twelve) patches around the same line, chart and
    // free side whose height is within the weld epsilon.
    [loop]
    for (uint task = thread; task < M8_RENDER_SCRATCH_CORNERS;
        task += M8_SOLVE_GROUP_THREADS)
    {
        uint4 mine = _M8RenderKnotScratch[cornerBase + task];
        uint owner = task;
        if ((mine.w & 1u) != 0u)
        {
            uint kernelLocal = task >> 2u;
            uint corner = task & 3u;
            int chart = (int)((mine.z >> 18u) & 3u);
            int tangentAxis0;
            int tangentAxis1;
            M8MembraneTangentAxes(chart, tangentAxis0, tangentAxis1);
            int3 local = int3(kernelLocal & 7u, (kernelLocal >> 3u) & 7u,
                (kernelLocal >> 6u) & 7u);
            float height = asfloat(mine.x);
            int s0 = M8CornerSign0(corner);
            int s1 = M8CornerSign1(corner);
            // Candidate patches: the four columns around the line, three
            // layers along the chart axis. The sharing kernels sit at
            // local + (sign>0 ? 0|+1 : -1|0) per tangent axis.
            [unroll]
            for (uint column = 0u; column < 4u; column++)
            [unroll]
            for (uint layer = 0u; layer < 3u; layer++)
            {
                int3 other = local;
                int d0 = (column & 1u) != 0u ? 1 : 0;
                int d1 = (column & 2u) != 0u ? 1 : 0;
                other = M8MembraneSetIntComponent(other, tangentAxis0,
                    local[tangentAxis0] + (s0 > 0 ? d0 : d0 - 1));
                other = M8MembraneSetIntComponent(other, tangentAxis1,
                    local[tangentAxis1] + (s1 > 0 ? d1 : d1 - 1));
                other = M8MembraneSetIntComponent(other, chart,
                    local[chart] + (int)layer - 1);
                if (any(other < 0) || any(other > 7)) continue;
                uint otherKernel = (uint)other.x | ((uint)other.y << 3u) |
                    ((uint)other.z << 6u);
                // The corner of the other patch on the same line.
                int o0 = (other[tangentAxis0] < local[tangentAxis0] ||
                    (other[tangentAxis0] == local[tangentAxis0] && s0 > 0))
                    ? 1 : -1;
                int o1 = (other[tangentAxis1] < local[tangentAxis1] ||
                    (other[tangentAxis1] == local[tangentAxis1] && s1 > 0))
                    ? 1 : -1;
                uint otherCorner = o0 > 0 ? (o1 > 0 ? 2u : 1u)
                    : (o1 > 0 ? 3u : 0u);
                uint otherTask = otherKernel * 4u + otherCorner;
                if (otherTask >= task) continue;
                uint4 theirs = _M8RenderKnotScratch[cornerBase + otherTask];
                if ((theirs.w & 1u) == 0u || theirs.z != mine.z) continue;
                if (abs(asfloat(theirs.x) - height) > M8_MEMBRANE_WELD_EPSILON)
                    continue;
                owner = min(owner, otherTask);
            }
        }
        // Direct owner only; chains are followed where they are consumed.
        // Ownership is transitive by the lowest-task rule inside one
        // line, chart and side, and every hop strictly decreases the task.
        _M8RenderKnotOwner[cornerBase + task] = owner;
    }
    DeviceMemoryBarrierWithGroupSync();

    // Phase C: patch validity and output ordinals, in parallel. A valid patch
    // has four solved corners and no edge above the limit; it takes an output
    // ordinal and marks the root knot of every corner as referenced. Owner
    // entries are still task indices here, so following a chain is safe.
    [loop]
    for (uint kernelLocal = thread; kernelLocal < M8_RENDER_TILE_KERNELS;
        kernelLocal += M8_SOLVE_GROUP_THREADS)
    {
        uint4 descriptor = _M8RenderPatchScratch[patchBase + kernelLocal];
        if (!M8DescriptorMeasured(descriptor)) continue;
        uint firstTask = kernelLocal * 4u;
        uint4 r0 = _M8RenderKnotScratch[cornerBase + firstTask + 0u];
        uint4 r1 = _M8RenderKnotScratch[cornerBase + firstTask + 1u];
        uint4 r2 = _M8RenderKnotScratch[cornerBase + firstTask + 2u];
        uint4 r3 = _M8RenderKnotScratch[cornerBase + firstTask + 3u];
        bool valid = (r0.w & 1u) != 0u && (r1.w & 1u) != 0u &&
            (r2.w & 1u) != 0u && (r3.w & 1u) != 0u;
        if (valid)
        {
            // Edge guard: tangent span is one pitch; the chart-axis span
            // decides the edge length.
            float h0 = asfloat(r0.x), h1 = asfloat(r1.x);
            float h2 = asfloat(r2.x), h3 = asfloat(r3.x);
            float tangent2 = M8_MEMBRANE_PATCH_PITCH * M8_MEMBRANE_PATCH_PITCH;
            float maxEdge2 = M8_MEMBRANE_MAX_EDGE * M8_MEMBRANE_MAX_EDGE;
            valid = tangent2 + (h1 - h0) * (h1 - h0) <= maxEdge2 &&
                tangent2 + (h2 - h1) * (h2 - h1) <= maxEdge2 &&
                tangent2 + (h3 - h2) * (h3 - h2) <= maxEdge2 &&
                tangent2 + (h0 - h3) * (h0 - h3) <= maxEdge2;
        }
        if (valid)
        {
            uint ordinal;
            InterlockedAdd(gM8ScratchValidPatches, 1u, ordinal);
            descriptor.w = M8_SCRATCH_PATCH_VALID | ordinal;
            [unroll]
            for (uint corner = 0u; corner < 4u; corner++)
            {
                uint root = firstTask + corner;
                [loop]
                for (uint hop = 0u; hop < 12u; hop++)
                {
                    uint next = _M8RenderKnotOwner[cornerBase + root];
                    if (next == root) break;
                    root = next;
                }
                uint ignored;
                InterlockedOr(_M8RenderKnotScratch[cornerBase + root].w, 2u,
                    ignored);
            }
        }
        else
            descriptor.w = 0u;
        _M8RenderPatchScratch[patchBase + kernelLocal] = descriptor;
    }
    DeviceMemoryBarrierWithGroupSync();

    // Phase D: vertex ordinals for referenced roots only. Only root entries
    // are written, nobody reads owner entries in this phase: no lane can
    // ever read an ordinal as a task index.
    [loop]
    for (uint task = thread; task < M8_RENDER_SCRATCH_CORNERS;
        task += M8_SOLVE_GROUP_THREADS)
    {
        if (_M8RenderKnotOwner[cornerBase + task] != task) continue;
        if ((_M8RenderKnotScratch[cornerBase + task].w & 2u) == 0u) continue;
        uint ordinal;
        InterlockedAdd(gM8ScratchVertexTotal, 1u, ordinal);
        _M8RenderKnotOwner[cornerBase + task] = 0x80000000u | ordinal;
    }
    DeviceMemoryBarrierWithGroupSync();
    if (thread == 0u)
        _M8RenderScratchHeader[work] = uint4(gM8ScratchValidPatches,
            gM8ScratchVertexTotal, header.z | gM8MembraneUnresolved,
            header.w);
}

// Vertex ordinal of a corner task: follow owners until the root, whose entry
// carries the high bit (every hop strictly decreases the task).
uint M8KnotVertexOrdinal(uint cornerBase, uint task)
{
    uint owner = _M8RenderKnotOwnerRead[cornerBase + task];
    [loop]
    for (uint hop = 0u; hop < 12u && (owner & 0x80000000u) == 0u; hop++)
        owner = _M8RenderKnotOwnerRead[cornerBase + owner];
    return owner & 0x7fffffffu;
}

// Kernel 3: pages, one vertex per referenced root knot, six indices per
// valid patch at its output ordinal, record. Invalid patches emit nothing.
[numthreads(128, 1, 1)]
void EmitRenderTileGeometry(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint work = groupId.x;
    uint physicalSlot = _M8VisibleTiles[work].x;
    uint4 header = _M8RenderScratchHeaderRead[work];
    if (thread == 0u)
    {
        gM8MembraneMeasuredTotal = header.w;
        gM8MembranePageCount = 0u;
        gM8MembranePatchTotal = header.x;
        gM8MembraneCanEmit = 0u;
        gM8MembraneFailed = 0u;
        gM8MembraneUnresolved = header.z;
        if (work >= M8_RENDER_SCRATCH_TILES ||
            M8CurrentRenderIdentity(physicalSlot) == 0u)
            gM8MembraneFailed = 2u;
        else
        {
            M8InitializeReadoutTileContext(physicalSlot);
            uint vertexTotal = header.y;
            uint indexTotal = header.x * M8_MEMBRANE_INDICES_PER_PATCH;
            uint vertexPages = (vertexTotal + M8_RENDER_PAGE_VERTICES - 1u) >>
                M8_RENDER_PAGE_VERTEX_SHIFT;
            uint indexPages = (indexTotal + M8_RENDER_PAGE_INDICES - 1u) >>
                M8_RENDER_PAGE_INDEX_SHIFT;
            if (gM8MembraneUnresolved == 0u && indexTotal != 0u)
            {
                if (M8TakeRenderPages(max(vertexPages, indexPages)))
                    gM8MembraneCanEmit = 1u;
                else
                {
                    gM8MembraneFailed = 1u;
                    _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] = 1u;
                }
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (gM8MembraneFailed == 2u) return;

    uint patchBase = M8ScratchPatchBase(work);
    uint cornerBase = M8ScratchCornerBase(work);
    M8ReadoutTileContext context = M8SharedReadoutTileContext();
    if (gM8MembraneCanEmit != 0u)
    {
        // Vertices: one per referenced root knot, at the knot line with the
        // solved height on the chart axis (the oracle's own construction).
        [loop]
        for (uint task = thread; task < M8_RENDER_SCRATCH_CORNERS;
            task += M8_SHELL_GROUP_THREADS)
        {
            uint owner = _M8RenderKnotOwnerRead[cornerBase + task];
            if ((owner & 0x80000000u) == 0u) continue;
            uint4 result = _M8RenderKnotScratchRead[cornerBase + task];
            uint kernelLocal = task >> 2u;
            uint corner = task & 3u;
            int chart = (int)((result.z >> 18u) & 3u);
            int tangentAxis0;
            int tangentAxis1;
            M8MembraneTangentAxes(chart, tangentAxis0, tangentAxis1);
            int3 main = context.tileOrigin + int3(kernelLocal & 7u,
                (kernelLocal >> 3u) & 7u, (kernelLocal >> 6u) & 7u);
            int3 halfAddress = main * 2;
            halfAddress = M8MembraneSetIntComponent(halfAddress, tangentAxis0,
                halfAddress[tangentAxis0] + M8CornerSign0(corner));
            halfAddress = M8MembraneSetIntComponent(halfAddress, tangentAxis1,
                halfAddress[tangentAxis1] + M8CornerSign1(corner));
            float3 position = (float3)halfAddress *
                (M8_MEMBRANE_PATCH_PITCH * 0.5);
            position = M8MembraneSetFloatComponent(position, chart,
                asfloat(result.x));
            M8StoreRenderVertex(M8MembraneVertexSlot(owner & 0x7fffffffu),
                position, result.y);
        }
        // Indices: six per valid patch onto root ordinals, canonical
        // winding from the solved corners.
        [loop]
        for (uint kernelLocal = thread; kernelLocal < M8_RENDER_TILE_KERNELS;
            kernelLocal += M8_SHELL_GROUP_THREADS)
        {
            uint4 descriptor = _M8RenderPatchScratchRead[patchBase + kernelLocal];
            if ((descriptor.w & M8_SCRATCH_PATCH_VALID) == 0u) continue;
            uint outputPatch = descriptor.w & ~M8_SCRATCH_PATCH_VALID;
            uint firstTask = kernelLocal * 4u;
            uint4 r0 = _M8RenderKnotScratchRead[cornerBase + firstTask + 0u];
            uint4 r1 = _M8RenderKnotScratchRead[cornerBase + firstTask + 1u];
            uint4 r2 = _M8RenderKnotScratchRead[cornerBase + firstTask + 2u];
            uint v0 = M8KnotVertexOrdinal(cornerBase, firstTask + 0u);
            uint v1 = M8KnotVertexOrdinal(cornerBase, firstTask + 1u);
            uint v2 = M8KnotVertexOrdinal(cornerBase, firstTask + 2u);
            uint v3 = M8KnotVertexOrdinal(cornerBase, firstTask + 3u);
            int chart = (int)((r0.z >> 18u) & 3u);
            int tangentAxis0;
            int tangentAxis1;
            M8MembraneTangentAxes(chart, tangentAxis0, tangentAxis1);
            float h0 = asfloat(r0.x), h1 = asfloat(r1.x), h2 = asfloat(r2.x);
            // Winding: the oracle swaps corners 10 and 01 when the quad's
            // normal opposes the measured normal.
            float3 normal;
            float signedOffset;
            M8DecodeSurfacePlane(descriptor.y, normal, signedOffset);
            float3 c00 = 0.0, c10 = 0.0, c11 = 0.0;
            c00 = M8MembraneSetFloatComponent(c00, tangentAxis0, -1.0);
            c00 = M8MembraneSetFloatComponent(c00, tangentAxis1, -1.0);
            c00 = M8MembraneSetFloatComponent(c00, chart, h0);
            c10 = M8MembraneSetFloatComponent(c10, tangentAxis0, 1.0);
            c10 = M8MembraneSetFloatComponent(c10, tangentAxis1, -1.0);
            c10 = M8MembraneSetFloatComponent(c10, chart, h1);
            c11 = M8MembraneSetFloatComponent(c11, tangentAxis0, 1.0);
            c11 = M8MembraneSetFloatComponent(c11, tangentAxis1, 1.0);
            c11 = M8MembraneSetFloatComponent(c11, chart, h2);
            bool flip = dot(cross(c10 - c00, c11 - c00), normal) < 0.0;
            uint a = M8MembraneVertexSlot(v0);
            uint b = M8MembraneVertexSlot(flip ? v3 : v1);
            uint c = M8MembraneVertexSlot(v2);
            uint d = M8MembraneVertexSlot(flip ? v1 : v3);
            uint indexBase = outputPatch * M8_MEMBRANE_INDICES_PER_PATCH;
            _M8RenderIndices[M8MembraneIndexSlot(indexBase + 0u)] = a;
            _M8RenderIndices[M8MembraneIndexSlot(indexBase + 1u)] = b;
            _M8RenderIndices[M8MembraneIndexSlot(indexBase + 2u)] = c;
            _M8RenderIndices[M8MembraneIndexSlot(indexBase + 3u)] = a;
            _M8RenderIndices[M8MembraneIndexSlot(indexBase + 4u)] = c;
            _M8RenderIndices[M8MembraneIndexSlot(indexBase + 5u)] = d;
        }
    }
    GroupMemoryBarrierWithGroupSync();

    if (thread != 0u) return;
    uint4 meta = _M8TileRecords[M8TileMetaIndex(physicalSlot)];
    uint occupiedCount = meta.z;
    uint legacyCount = occupiedCount > gM8MembraneMeasuredTotal
        ? occupiedCount - gM8MembraneMeasuredTotal : 0u;
    uint ignoredCount;
    InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_PLANE_LEGACY_INVALID],
        legacyCount, ignoredCount);
    uint base = M8RecordBase(physicalSlot);
    if (gM8MembraneUnresolved != 0u || gM8MembraneFailed != 0u)
    {
        // BACK keeps this tile's previous record. An unresolved halo waits
        // for residency; a capacity failure retries on the next build.
        M8DiscardTilePages();
        if (gM8MembraneUnresolved != 0u)
        {
            InterlockedAnd(_M8TileRecords[
                M8TileRuntimeIndex(physicalSlot)].w,
                ~M8_RENDER_DIRTY, ignoredCount);
            InterlockedOr(_M8TileRecords[
                M8TileRuntimeIndex(physicalSlot)].w, M8_RENDER_PENDING,
                ignoredCount);
            M8CounterIncrement(M8_COUNTER_RENDER_PENDING_TILES);
        }
        else
        {
            M8RenderJournalQueueDirty(physicalSlot, 0u);
            M8CounterIncrement(M8_COUNTER_RENDER_CAPACITY_FAILED);
        }
        return;
    }

    uint indexTotal = gM8MembranePatchTotal * M8_MEMBRANE_INDICES_PER_PATCH;
    M8RetireBackRecordPages(base);
    // Record 0 is the published index count of this tile.
    _M8RenderIndexBack[base + 0u] = indexTotal;
    _M8RenderIndexBack[base + 1u] = gM8MembranePageCount;
    _M8RenderIndexBack[base + 2u] =
        meta.x * MERKABA_M8_TILES_PER_CHUNK + meta.y + 1u;
    _M8RenderIndexBack[base + 3u] = asuint(gM8MembraneTileOrigin.x);
    _M8RenderIndexBack[base + 4u] = asuint(gM8MembraneTileOrigin.y);
    _M8RenderIndexBack[base + 5u] = asuint(gM8MembraneTileOrigin.z);
    _M8RenderIndexBack[base + M8_RENDER_RECORD_FIRST_PAGE] =
        gM8MembranePageCount != 0u ? M8TilePage(0u) :
            M8_RENDER_PAGE_INVALID;
    _M8RenderIndexBack[base + M8_RENDER_RECORD_VERSION] =
        _M8RenderVersionsRead[physicalSlot];
    InterlockedAnd(_M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w,
        ~(M8_RENDER_DIRTY | M8_RENDER_PENDING |
          M8_RENDER_DEPENDENCY_MASK), ignoredCount);
    _M8VisibleTiles[work].y = 1u;
    InterlockedAdd(_M8Counters[M8_COUNTER_READOUT_EMITTED_PATCHES],
        gM8MembranePatchTotal, ignoredCount);
}

[numthreads(1, 1, 1)]
void PublishRenderTileList(uint id : SV_DispatchThreadID)
{
    uint tiles = min(_M8RenderIndexBack[0],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    _M8RenderIndexBack[0] = tiles;
    _M8RenderIndexBack[1] = 0u;
    _M8FrameDispatchArgs[0] = max(1u, (tiles + 127u) >> 7u);
    _M8FrameDispatchArgs[1] = 1u;
    _M8FrameDispatchArgs[2] = 1u;
}

[numthreads(128, 1, 1)]
void RecountRenderPatches(uint id : SV_DispatchThreadID)
{
    uint tiles = _M8RenderIndexBack[0];
    if (id >= tiles) return;
    uint physicalSlot = _M8RenderIndexBack[M8BackListBase() + id];
    if (physicalSlot >= MERKABA_M8_PHYSICAL_TILE_CAPACITY) return;
    uint base = M8RecordBase(physicalSlot);
    uint patches = _M8RenderIndexBack[base + 0u];
    uint ignored;
    InterlockedAdd(_M8RenderIndexBack[1], patches, ignored);
    // Every page of this record is claimed for this tile. A page claimed by
    // two records is publication corruption; ValidatePublication then also
    // rejects every index that does not land in a page of its own record.
    uint pages = min(_M8RenderIndexBack[base + 1u], M8_RENDER_TILE_MAX_PAGES);
    uint page = _M8RenderIndexBack[base + M8_RENDER_RECORD_FIRST_PAGE];
    [loop]
    for (uint ordinal = 0u; ordinal < pages; ordinal++)
    {
        if (page >= M8_RENDER_PAGE_CAPACITY) break;
        uint prior;
        InterlockedCompareExchange(
            _M8RenderPageQueues[M8_RENDER_OWNER_BASE + page], 0u,
            physicalSlot + 1u, prior);
        if (prior != 0u)
            _M8Counters[M8_COUNTER_RENDER_PUBLICATION_INVALID] = 1u;
        page = _M8RenderPageQueues[M8_RENDER_LINK_BASE + page];
    }
}

// Every published record of BACK is checked before it can become FRONT: page
// ids in range, chains of exactly the recorded length, index counts within
// the chain and every index inside this slot's vertex arena. One violation
// keeps the whole build from publishing.
[numthreads(128, 1, 1)]
void ValidatePublication(uint id : SV_DispatchThreadID)
{
    uint tiles = min(_M8RenderIndexBack[0], MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    if (id >= tiles) return;
    uint physicalSlot = _M8RenderIndexBack[M8BackListBase() + id];
    bool valid = physicalSlot < MERKABA_M8_PHYSICAL_TILE_CAPACITY;
    if (valid)
    {
        uint base = M8RecordBase(physicalSlot);
        uint indexCount = _M8RenderIndexBack[base + 0u];
        uint pages = _M8RenderIndexBack[base + 1u];
        valid = pages <= M8_RENDER_TILE_MAX_PAGES &&
            indexCount <= pages * M8_RENDER_PAGE_INDICES &&
            (indexCount % M8_MEMBRANE_INDICES_PER_PATCH) == 0u;
        uint page = _M8RenderIndexBack[base + M8_RENDER_RECORD_FIRST_PAGE];
        uint remaining = indexCount;
        [loop]
        for (uint ordinal = 0u; valid && ordinal < pages; ordinal++)
        {
            if (page >= M8_RENDER_PAGE_CAPACITY)
            {
                valid = false;
                break;
            }
            uint used = min(remaining, M8_RENDER_PAGE_INDICES);
            uint source = page * M8_RENDER_PAGE_INDICES;
            [loop]
            for (uint slot = 0u; slot < used; slot++)
            {
                uint vertex = _M8RenderIndicesRead[source + slot];
                // The vertex must live in a page this very record owns.
                if (vertex >= M8_RENDER_PAGE_CAPACITY *
                        M8_RENDER_PAGE_VERTICES ||
                    _M8RenderPageQueues[M8_RENDER_OWNER_BASE +
                        (vertex >> M8_RENDER_PAGE_VERTEX_SHIFT)] !=
                    physicalSlot + 1u)
                {
                    valid = false;
                    break;
                }
            }
            remaining -= used;
            page = _M8RenderPageQueues[M8_RENDER_LINK_BASE + page];
        }
        if (valid && pages != 0u && page != M8_RENDER_PAGE_INVALID)
            valid = false;
    }
    if (!valid) _M8Counters[M8_COUNTER_RENDER_PUBLICATION_INVALID] = 1u;
}

[numthreads(1, 1, 1)]
void FinalizeReadout(uint id : SV_DispatchThreadID)
{
    uint tiles = _M8RenderIndexBack[0];
    uint indices = _M8RenderIndexBack[1];
    _M8Counters[M8_COUNTER_RENDER_PUBLISHED_TILES] = tiles;
    // The publication counts indices; report patches and triangles.
    uint publishedPatches = indices / M8_MEMBRANE_INDICES_PER_PATCH;
    uint publishedTriangles = indices / 3u;
    _M8Counters[M8_COUNTER_RENDER_PUBLISHED_PATCHES] = publishedPatches;
    _M8Counters[M8_COUNTER_LOGICAL_VISIBLE_PRIMITIVES] = publishedTriangles;
    _M8Counters[M8_COUNTER_READOUT_EMITTED_TRIANGLES] =
        _M8Counters[M8_COUNTER_READOUT_EMITTED_PATCHES] *
        M8_MEMBRANE_TRIANGLES_PER_PATCH;
    uint dirtyHead = _M8Counters[M8_COUNTER_RENDER_JOURNAL_HEAD];
    uint dirtyTail = _M8Counters[M8_COUNTER_RENDER_JOURNAL_TAIL];
    uint backlog = dirtyTail != dirtyHead ||
        _M8Counters[M8_COUNTER_RENDER_JOURNAL_OVERFLOW] != 0u ||
        _M8Counters[M8_COUNTER_RENDER_VIEW_OVERFLOW] != 0u
        ? 0x80000000u : 0u;
    uint unresolved = min(0x7fffffffu,
        _M8Counters[M8_COUNTER_READOUT_UNRESOLVED] +
        _M8Counters[M8_COUNTER_RENDER_PENDING_TILES]);
    // A build that could not place every selected tile, or whose halo is
    // still unresolved, publishes nothing: FRONT stays, the scan transaction
    // stays open and the readout retries once residency moved.
    bool failed = _M8Counters[M8_COUNTER_RENDER_CAPACITY_FAILED] != 0u ||
        _M8Counters[M8_COUNTER_RENDER_PRIMITIVE_OVERFLOW] != 0u ||
        _M8Counters[M8_COUNTER_RENDER_VIEW_OVERFLOW] != 0u ||
        _M8Counters[M8_COUNTER_RENDER_PUBLICATION_INVALID] != 0u ||
        unresolved != 0u;
    if (_M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] ==
            MERKABA_READOUT_BUILDING)
        _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS] = failed
            ? MERKABA_READOUT_FAILED : MERKABA_READOUT_PUBLISHED;
    // The CPU publication decision reads only this record. Counters remain
    // diagnostics that a later scanner job may reset.
    _M8AttemptCompletion[1] = uint4(_M8ReadoutRevision,
        _M8Counters[M8_COUNTER_READOUT_BUILD_STATUS], tiles,
        backlog | unresolved);
}
