// Match the Vulkan frontend used by integration/readout and preserve explicit
// loop control in the nested sparse storage/publication routines.
#pragma use_dxc vulkan

#include "MerkabaWorld.hlsl"
#include "MerkabaDualHierarchy.hlsl"
#define M8_FLOWER_SIDECAR_WRITE 1
#include "MerkabaFlowerStorage.hlsl"
#include "MerkabaFlowerPageInvalidation.hlsl"

#define MERKABA_OCCUPIED_FLAG 1u

RWStructuredBuffer<uint> _M8ClearUInts;
RWStructuredBuffer<int4> _M8ClearInt4s;
RWByteAddressBuffer _M8ClearRaw;
RWStructuredBuffer<uint> _M8ClearBlockArgs;
RWStructuredBuffer<uint> _M8ClearChunkArgs;
RWStructuredBuffer<uint> _M8ObservationDispatchArgs;
RWStructuredBuffer<uint4> _M8HashBenchmarkOutput;
uint _M8ClearCount;
uint _M8LinearGroupsX;

uint _M8StreamBatchCount;
uint _M8EvictAllDirty;
uint _M8SafeEpoch;
uint _M8DualPublishingGeneration;
uint _M8DualRetiredGeneration;
uint _M8DualDurableGeneration;
uint _M8DualReclaimCursor;
uint _M8RegisterDualNodeKind;
uint _M8DrainSourceGeneration;

#define M8_DUAL_PACKET_RECORDS 16u
#define M8_WRITEBACK_TILE_RECORDS (MERKABA_M8_KERNELS_PER_TILE+1u+M8_DUAL_PACKET_RECORDS+M8_FLOWER_STORAGE_PACKET_RECORDS)
#define M8_LOAD_TILE_RECORDS (MERKABA_M8_KERNELS_PER_TILE+M8_DUAL_PACKET_RECORDS+M8_FLOWER_STORAGE_PACKET_RECORDS)
#define M8_WRITEBACK_KEEP_HOT 0x80000000u
#define M8_WRITEBACK_REF_MASK 0x7fffffffu

[numthreads(256, 1, 1)]
void ClearRawBuffer(uint id : SV_DispatchThreadID)
{
    if (id < _M8ClearCount) _M8ClearRaw.Store(id*4u,0u);
}

void M8GatherDualPacket(uint item, uint physicalSlot)
{
    uint first=item*M8_WRITEBACK_TILE_RECORDS+1u+MERKABA_M8_KERNELS_PER_TILE;
    [unroll] for (uint record=0u;record<M8_DUAL_PACKET_RECORDS;++record)
        _M8WritebackStaging[first+record]=0u;
    uint4 tile=M8LoadTileMetaRead(physicalSlot);
    uint2 owner=M8LoadChunkOwnerRead(tile.x);
    M8DualBlockMeta block;
    uint state=M8DualReadBlock(owner.x,block), flags=0u;
    if (state == M8_DUAL_AMBIGUOUS) { _M8WritebackStaging[first].x=16u; return; }
    if (block.StateAndGeneration == 0u) return;
    flags=1u;
    _M8WritebackStaging[first+1u]=uint4(block.StateAndGeneration,block.PayloadIndex,0u,0u);
    if (state == M8_DUAL_MIXED)
    {
        flags |= 2u;
        [unroll] for (uint word=0u;word<8u;++word)
            _M8WritebackStaging[first+2u+word]=
                _M8DualBlockState.Load4(M8DualBlockMaskAddress(owner.x,word*4u));
        uint chunkIndex;
        M8DualChunkPayload chunk;
        state=M8DualReadChunk(owner.x,owner.y,chunkIndex,chunk);
        if (state == M8_DUAL_AMBIGUOUS) flags |= 16u;
        else if (state == M8_DUAL_MIXED)
        {
            flags |= 4u;
            _M8WritebackStaging[first+10u]=uint4(chunk.NonFullMaskLo,chunk.NonFullMaskHi,
                chunk.MixedMaskLo,chunk.MixedMaskHi);
            _M8WritebackStaging[first+11u]=uint4(chunk.LeafRefBase,chunk.Generation,0u,0u);
            if (M8DualChunkTileState(chunk,tile.y) == M8_DUAL_MIXED)
            {
                uint packed=M8DualLeafReference(chunk,tile.y);
                uint generation=(packed >> 15u) & M8_DUAL_SLOT_MASK;
                // The M8 ref is deliberately EVICTING throughout this frozen
                // packet. Validate the captured slot/generation, not HOT state.
                if ((packed >> 30u) != 2u || (packed & M8_DUAL_SLOT_MASK) != physicalSlot ||
                    generation == 0u || generation != M8LoadTileRuntimeRead(physicalSlot).w)
                    flags |= 16u;
                else
                {
                    flags |= 8u;
                    [unroll] for (uint word=0u;word<4u;++word)
                        _M8WritebackStaging[first+12u+word]=
                            _M8DualLeaves.Load4(physicalSlot*64u+word*16u);
                }
            }
        }
    }
    _M8WritebackStaging[first].x=flags;
}

bool M8NextDirtyDualNode(uint first, out uint node)
{
    node=M8_DUAL_NO_REF;
    if (first >= M8_DUAL_DIRTY_NODE_COUNT) return false;
    uint root=_M8DualBlockState.Load(M8_DUAL_DIRTY_ROOT_OFFSET) &
        ~M8DualLowBits(first >> 15u);
    [loop] while (root != 0u)
    {
        uint top=firstbitlow(root); root &= root-1u;
        uint topBits=_M8DualBlockState.Load(M8_DUAL_DIRTY_TOP_OFFSET+top*4u);
        if (top == (first >> 15u)) topBits &= ~M8DualLowBits((first >> 10u)&31u);
        [loop] while (topBits != 0u)
        {
            uint summary=top*32u+firstbitlow(topBits); topBits &= topBits-1u;
            uint summaryBits=_M8DualBlockState.Load(M8_DUAL_DIRTY_SUMMARY_OFFSET+summary*4u);
            if (summary == (first >> 10u)) summaryBits &= ~M8DualLowBits((first >> 5u)&31u);
            [loop] while (summaryBits != 0u)
            {
                uint word=summary*32u+firstbitlow(summaryBits); summaryBits &= summaryBits-1u;
                uint bits=_M8DualBlockState.Load(M8_DUAL_DIRTY_BITS_OFFSET+word*4u);
                if (word == (first >> 5u)) bits &= ~M8DualLowBits(first&31u);
                if (bits == 0u) continue;
                node=word*32u+firstbitlow(bits);
                return node < M8_DUAL_DIRTY_NODE_COUNT;
            }
        }
    }
    return false;
}

void M8ClearDirtyDualNode(uint node)
{
    // Called only by the serialized storage ack after comparing the captured
    // node generation. No semantic writer overlaps this queue lease.
    uint word=node >> 5u, summary=word >> 5u, top=summary >> 5u;
    uint value=_M8DualBlockState.Load(M8_DUAL_DIRTY_BITS_OFFSET+word*4u) & ~(1u<<(node&31u));
    _M8DualBlockState.Store(M8_DUAL_DIRTY_BITS_OFFSET+word*4u,value);
    if (value != 0u) return;
    value=_M8DualBlockState.Load(M8_DUAL_DIRTY_SUMMARY_OFFSET+summary*4u) & ~(1u<<(word&31u));
    _M8DualBlockState.Store(M8_DUAL_DIRTY_SUMMARY_OFFSET+summary*4u,value);
    if (value != 0u) return;
    value=_M8DualBlockState.Load(M8_DUAL_DIRTY_TOP_OFFSET+top*4u) & ~(1u<<(summary&31u));
    _M8DualBlockState.Store(M8_DUAL_DIRTY_TOP_OFFSET+top*4u,value);
    if (value != 0u) return;
    value=_M8DualBlockState.Load(M8_DUAL_DIRTY_ROOT_OFFSET) & ~(1u<<top);
    _M8DualBlockState.Store(M8_DUAL_DIRTY_ROOT_OFFSET,value);
}

bool M8GatherDualNodePacket(uint node, uint first)
{
    [unroll] for (uint row=0u;row<17u;++row) _M8WritebackStaging[first+row]=0u;
    bool isBlock=node<MERKABA_M8_BLOCK_CAPACITY;
    uint2 owner=isBlock ? uint2(node,0u) :
        M8LoadChunkOwnerRead(node-MERKABA_M8_BLOCK_CAPACITY);
    _M8WritebackStaging[first]=uint4(asuint(M8LoadBlockCoordRead(owner.x)),owner.y);
    uint packet=first+1u;
    M8DualBlockMeta block;
    uint state=M8DualReadBlock(owner.x,block);
    if (state == M8_DUAL_AMBIGUOUS || block.StateAndGeneration == 0u) return false;
    uint flags=1u|(isBlock ? 32u : 64u);
    _M8WritebackStaging[packet+1u]=uint4(block.StateAndGeneration,block.PayloadIndex,0u,0u);
    if (state == M8_DUAL_MIXED)
    {
        flags |= 2u;
        [unroll] for (uint word=0u;word<8u;++word)
            _M8WritebackStaging[packet+2u+word]=
                _M8DualBlockState.Load4(M8DualBlockMaskAddress(owner.x,word*4u));
        if (!isBlock)
        {
            uint physical;
            M8DualChunkPayload chunk;
            state=M8DualReadChunk(owner.x,owner.y,physical,chunk);
            if (state == M8_DUAL_AMBIGUOUS) return false;
            if (state == M8_DUAL_MIXED)
            {
                flags |= 4u;
                _M8WritebackStaging[packet+10u]=uint4(chunk.NonFullMaskLo,chunk.NonFullMaskHi,
                    chunk.MixedMaskLo,chunk.MixedMaskHi);
                _M8WritebackStaging[packet+11u]=uint4(chunk.LeafRefBase,chunk.Generation,0u,0u);
            }
        }
    }
    uint nodeGeneration=isBlock ? block.StateAndGeneration >> 2u :
        M8DualLoadChunkPayload(node-MERKABA_M8_BLOCK_CAPACITY).Generation;
    _M8WritebackStaging[packet]=uint4(flags,node,nodeGeneration,block.StateAndGeneration);
    return true;
}

[numthreads(1,1,1)]
void GatherDualWritebackBatch(uint id : SV_DispatchThreadID)
{
    uint first=0u, count=0u, error=0u, node;
    [loop] while (count<32u && M8NextDirtyDualNode(first,node))
    {
        if (!M8GatherDualNodePacket(node,1u+count*17u)) { error=1u; break; }
        count++; first=node+1u;
    }
    _M8WritebackStaging[0]=uint4(count,
        _M8DualBlockState.Load(M8_DUAL_DIRTY_ROOT_OFFSET),_M8DrainSourceGeneration,error);
    if (count == 0u)
    {
        // A whole-source receipt is possible only under the CPU's source-cut
        // gate, after all selected append/ack batches have completed. Ordinary
        // gathers pass source generation zero and cannot certify a source cut.
        _M8WritebackStaging[1]=uint4(
            _M8Counters[M8_COUNTER_OCCUPIED_KERNEL_COUNT],
            _M8Counters[M8_COUNTER_DIRTY_TILE_COUNT],
            _M8Counters[M8_COUNTER_OBSERVATION_TOKEN],
            _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED]);
    }
}

[numthreads(1,1,1)]
void AcknowledgeDualWritebackBatch(uint id : SV_DispatchThreadID)
{
    uint count=min(_M8WritebackStaging[0].x,32u);
    [loop] for (uint item=0u;item<count;++item)
    {
        uint4 captured=_M8WritebackStaging[2u+item*17u];
        uint node=captured.y;
        if (node >= M8_DUAL_DIRTY_NODE_COUNT) continue;
        bool isBlock=node<MERKABA_M8_BLOCK_CAPACITY;
        uint2 owner=isBlock ? uint2(node,0u) :
            M8LoadChunkOwnerRead(node-MERKABA_M8_BLOCK_CAPACITY);
        uint currentParent=_M8DualBlockState.Load(owner.x*8u);
        uint generation=isBlock ? currentParent >> 2u :
            M8DualLoadChunkPayload(node-MERKABA_M8_BLOCK_CAPACITY).Generation;
        if (generation != captured.z || currentParent != captured.w) continue;
        M8ClearDirtyDualNode(node);
    }
}

uint M8LinearIndex(uint3 groupId, uint groupThread)
{
    return ((groupId.y * _M8LinearGroupsX + groupId.x) * 256u) +
        groupThread;
}

[numthreads(256, 1, 1)]
void BenchmarkM8Pcg3d(uint id : SV_DispatchThreadID)
{
    if (id >= MERKABA_M8_BLOCK_CAPACITY) return;
    int coordinate = (int)id - (int)(MERKABA_M8_BLOCK_CAPACITY / 2u);
    uint3 hash = MerkabaPcg3d(int3(coordinate, coordinate * 3,
        coordinate * -5));
    _M8HashBenchmarkOutput[id] = uint4(hash,
        hash.x ^ hash.y ^ hash.z);
}

[numthreads(256, 1, 1)]
void ClearUInts(uint3 groupId : SV_GroupID, uint thread : SV_GroupIndex)
{
    uint index = M8LinearIndex(groupId, thread);
    if (index < _M8ClearCount) _M8ClearUInts[index] = 0u;
}

[numthreads(256, 1, 1)]
void ClearInt4s(uint3 groupId : SV_GroupID, uint thread : SV_GroupIndex)
{
    uint index = M8LinearIndex(groupId, thread);
    if (index < _M8ClearCount) _M8ClearInt4s[index] = 0;
}

[numthreads(256, 1, 1)]
void InitializeFreeTileStack(uint id : SV_DispatchThreadID)
{
    if (id < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
    {
        _M8FreeTileStack[id] = id;
        _M8TileRecords[M8TileMetaIndex(id)] = 0u.xxxx;
        _M8TileRecords[M8TileRuntimeIndex(id)] = 0u.xxxx;
    }
    if (id == 0u)
    {
        _M8Counters[M8_COUNTER_FREE_TILE_COUNT] =
            MERKABA_M8_PHYSICAL_TILE_CAPACITY;
        _M8Counters[M8_COUNTER_DIRTY_TILE_COUNT] = 0u;
    }
}

[numthreads(128, 1, 1)]
void ResetWorldCounters(uint id : SV_DispatchThreadID)
{
    if (id < M8_COUNTER_COUNT) _M8Counters[id] = 0u;
}

#define MERKABA_M8_MAX_DISPATCH_X 65535u

[numthreads(1, 1, 1)]
void PrepareAllocatedClearArgs(uint id : SV_DispatchThreadID)
{
    uint blocks = min(_M8CountersRead[M8_COUNTER_BLOCK_COUNT],
        MERKABA_M8_BLOCK_CAPACITY);
    _M8ClearBlockArgs[0] = min(max(blocks, 1u), MERKABA_M8_MAX_DISPATCH_X);
    _M8ClearBlockArgs[1] = max(1u, (blocks + MERKABA_M8_MAX_DISPATCH_X - 1u) /
        MERKABA_M8_MAX_DISPATCH_X);
    _M8ClearBlockArgs[2] = 1u;
    uint chunks = min(_M8CountersRead[M8_COUNTER_CHUNK_COUNT],
        MERKABA_M8_CHUNK_CAPACITY);
    _M8ClearChunkArgs[0] = min(max(chunks, 1u), MERKABA_M8_MAX_DISPATCH_X);
    _M8ClearChunkArgs[1] = max(1u, (chunks + MERKABA_M8_MAX_DISPATCH_X - 1u) /
        MERKABA_M8_MAX_DISPATCH_X);
    _M8ClearChunkArgs[2] = 1u;
}

uint M8ClearGroupIndex(uint3 groupId)
{
    return groupId.y * MERKABA_M8_MAX_DISPATCH_X + groupId.x;
}

[numthreads(64, 1, 1)]
void ClearAllocatedBlocks(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint blockIndex = M8ClearGroupIndex(groupId);
    uint count = min(_M8CountersRead[M8_COUNTER_BLOCK_COUNT],
        MERKABA_M8_BLOCK_CAPACITY);
    if (blockIndex >= count) return;
    for (uint local = thread; local < MERKABA_M8_BLOCK_CHUNK_COUNT;
         local += 64u)
        _M8BlockChunkRefs[blockIndex * MERKABA_M8_BLOCK_CHUNK_COUNT + local] = 0u;
    _M8BlockPresenceL2[blockIndex * 64u + thread] = 0u;
    if (thread < 8u) _M8BlockPresenceL1[blockIndex * 8u + thread] = 0u;
    if (thread == 0u)
    {
        _M8OwnerRecords[blockIndex] = 0u;
        _M8BlockPresenceL0[blockIndex] = 0u;
    }
}

[numthreads(64, 1, 1)]
void ClearAllocatedChunks(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint chunkIndex = M8ClearGroupIndex(groupId);
    uint count = min(_M8CountersRead[M8_COUNTER_CHUNK_COUNT],
        MERKABA_M8_CHUNK_CAPACITY);
    if (chunkIndex >= count) return;
    _M8ChunkTileRefs[chunkIndex * MERKABA_M8_TILES_PER_CHUNK + thread] = 0u;
    if (thread < MERKABA_M8_CHUNK_PRESENCE_STRIDE)
        _M8ChunkPresence[M8ChunkPresenceL0Index(chunkIndex) + thread] = 0u;
    if (thread == 0u)
        _M8OwnerRecords[MERKABA_M8_OWNER_CHUNK_OFFSET + chunkIndex] = 0u;
}

[numthreads(64, 1, 1)]
void PublishNewBlocks(uint id : SV_DispatchThreadID)
{
    uint count = min(_M8CountersRead[M8_COUNTER_NEW_BLOCK_QUEUE_COUNT],
        MERKABA_M8_BLOCK_CAPACITY);
    if (id >= count) return;
    uint2 claim = _M8ClaimQueueRead[MERKABA_M8_CLAIM_BLOCK_OFFSET + id];
    _M8HashEntries[claim.x].blockRef = claim.y + 1u;
}

[numthreads(64, 1, 1)]
void PublishNewChunks(uint id : SV_DispatchThreadID)
{
    uint count = min(_M8CountersRead[M8_COUNTER_NEW_CHUNK_QUEUE_COUNT],
        MERKABA_M8_CHUNK_CAPACITY);
    if (id >= count) return;
    uint2 claim = _M8ClaimQueueRead[MERKABA_M8_CLAIM_CHUNK_OFFSET + id];
    uint chunkIndex = claim.y;
    uint2 owner = M8LoadChunkOwnerRead(chunkIndex);
    uint chunkLocal = owner.y;
    uint d4 = (chunkLocal >> 6u) & 7u;
    uint d3 = (chunkLocal >> 3u) & 7u;
    uint d2 = chunkLocal & 7u;
    uint ignored;
    InterlockedOr(_M8BlockPresenceL0[owner.x], 1u << d4, ignored);
    InterlockedOr(_M8BlockPresenceL1[owner.x * 8u + d4],
        1u << d3, ignored);
    InterlockedOr(_M8BlockPresenceL2[owner.x * 64u + d4 * 8u + d3],
        1u << d2, ignored);
    _M8BlockChunkRefs[claim.x] = chunkIndex + 1u;
}

[numthreads(64, 1, 1)]
void InitializeNewTiles(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint2 claim = _M8ClaimQueueRead[MERKABA_M8_CLAIM_TILE_OFFSET + groupId.x];
    uint reservationBase =
        _M8Counters[M8_COUNTER_NEW_TILE_RESERVATION_BASE];
    uint physicalSlot = _M8FreeTileStackRead[reservationBase + groupId.x];
    [unroll]
    for (uint lane = thread; lane < MERKABA_M8_KERNELS_PER_TILE; lane += 64u)
    {
        KernelState state = (KernelState)0;
        M8StoreKernelState(physicalSlot, lane, state);
    }
    if (thread < MERKABA_M8_TILE_WORDS)
    {
        _M8TileBits[M8TileWordIndex(physicalSlot, thread)] = 0u;
    }
    DeviceMemoryBarrierWithGroupSync();
    if (thread == 0u)
    {
        uint refIndex = claim.x;
        uint chunkIndex = refIndex / MERKABA_M8_TILES_PER_CHUNK;
        uint tileLocal = refIndex % MERKABA_M8_TILES_PER_CHUNK;
        uint generation = M8NextTileSlotGeneration(
            _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w);
        M8ClearTileDirty(physicalSlot);
        _M8TileRecords[M8TileMetaIndex(physicalSlot)] =
            uint4(chunkIndex, tileLocal, 0u, 0u);
        _M8TileRecords[M8TileRuntimeIndex(physicalSlot)] = uint4(0u, 0u,
            _M8Counters[M8_COUNTER_FRAME_EPOCH], generation);
        M8MarkTileDirty(physicalSlot);
    }
    DeviceMemoryBarrierWithGroupSync();
    if (thread == 0u)
    {
        uint refIndex = claim.x;
        _M8ChunkTileRefs[refIndex] = physicalSlot + 1u;
        M8CounterIncrement(M8_COUNTER_HOT_TILE_COUNT);
        M8CounterIncrement(M8_COUNTER_SURFACE_TILES_ALLOCATED);
        M8SignalResidencyChange();
    }
}

[numthreads(1, 1, 1)]
void ResetClaimQueueCounts(uint id : SV_DispatchThreadID)
{
    _M8Counters[M8_COUNTER_NEW_BLOCK_QUEUE_COUNT] = 0u;
    _M8Counters[M8_COUNTER_NEW_CHUNK_QUEUE_COUNT] = 0u;
    _M8Counters[M8_COUNTER_NEW_TILE_QUEUE_COUNT] = 0u;
    _M8ObservationDispatchArgs[0] = 0u;
    _M8ObservationDispatchArgs[1] = 1u;
    _M8ObservationDispatchArgs[2] = 1u;
}

[numthreads(1, 1, 1)]
void PrepareNewTileDispatchArgs(uint id : SV_DispatchThreadID)
{
    _M8Counters[M8_COUNTER_UNRESOLVED_SURFACE_TILES] = 0u;
    uint pendingClaims = min(
        _M8Counters[M8_COUNTER_NEW_TILE_QUEUE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    uint freeCount = min(_M8Counters[M8_COUNTER_FREE_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    uint reservationCount = min(pendingClaims, freeCount);
    uint reservationBase = freeCount - reservationCount;
    _M8Counters[M8_COUNTER_NEW_TILE_RESERVATION_BASE] = reservationBase;
    _M8Counters[M8_COUNTER_FREE_TILE_COUNT] = reservationBase;
    _M8ObservationDispatchArgs[0] = reservationCount;
    _M8ObservationDispatchArgs[1] = 1u;
    _M8ObservationDispatchArgs[2] = 1u;
    if (reservationCount < pendingClaims)
        _M8Counters[M8_COUNTER_TILE_STARVATION] = 1u;
    if (reservationCount < pendingClaims || reservationBase < 256u)
        _M8Counters[M8_COUNTER_EVICTION_NEEDED] = 1u;
}

[numthreads(1, 1, 1)]
void PrepareEvictionSelection(uint id : SV_DispatchThreadID)
{
    uint freeCount = min(_M8Counters[M8_COUNTER_FREE_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    _M8Counters[M8_COUNTER_EVICTION_CLEAN_BUDGET] =
        _M8EvictAllDirty == 0u && freeCount < 256u ? 256u - freeCount : 0u;
    _M8Counters[M8_COUNTER_EVICTION_CLEAN_TICKET] = 0u;
    _M8Counters[M8_COUNTER_EVICTION_NEEDED] = 0u;
    uint cursor = _M8Counters[M8_COUNTER_EVICTION_CURSOR];
    _M8Counters[M8_COUNTER_EVICTION_CURSOR] =
        (cursor + 256u) & (MERKABA_M8_PHYSICAL_TILE_CAPACITY - 1u);
}

bool M8TilePinnedByObservation(uint physicalSlot, bool tileMetadataWriteView=false)
{
    uint observation = _M8Counters[M8_COUNTER_OBSERVATION_TOKEN];
    uint stamp=tileMetadataWriteView ?
        _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].x :
        M8LoadTileRuntimeRead(physicalSlot).x;
    return observation != 0u &&
        _M8Counters[M8_COUNTER_OBSERVATION_COMPLETED] == 0u &&
        stamp == observation;
}

bool M8TileHasPendingFlowerEpoch(uint physicalSlot)
{
    uint pending=0u;
    [unroll] for(uint word=0u;word<16u;word++)
        pending|=_M8TileBitsRead[M8TileWordIndex(physicalSlot,word)].w;
    return pending!=0u;
}

[numthreads(256, 1, 1)]
void SelectEvictionVictims(uint id : SV_DispatchThreadID)
{
    if (!M8FlowerPageSourceReady(_M8DualPublishingGeneration)) return;
    if (id >= MERKABA_M8_PHYSICAL_TILE_CAPACITY) return;
    uint cursor = _M8Counters[M8_COUNTER_EVICTION_CURSOR];
    uint physicalSlot = (cursor + id) &
        (MERKABA_M8_PHYSICAL_TILE_CAPACITY - 1u);
    uint4 meta = M8LoadTileMetaRead(physicalSlot);
    uint4 runtime = M8LoadTileRuntimeRead(physicalSlot);
    uint tileRefIndex = meta.x * MERKABA_M8_TILES_PER_CHUNK + meta.y;
    uint expected = physicalSlot + 1u;
    if (_M8ChunkTileRefs[tileRefIndex] != expected) return;
    // The M8 edit and subordinate epoch invalidation are one source cut.
    // Even writeback-only SAVE must not capture between these two stores.
    if (M8TileHasPendingFlowerEpoch(physicalSlot)) return;
    // A partially drained observation may already have committed this tile.
    // Keep its once-per-observation token resident until FinalizeObservation:
    // evict/reinstall would erase that token and admit the same seed twice.
    // A save/writeback-only capture may still copy it without freeing its slot.
    if (_M8EvictAllDirty == 0u && M8TilePinnedByObservation(physicalSlot)) return;
    if (_M8EvictAllDirty == 0u &&
        _M8Counters[M8_COUNTER_FRAME_EPOCH] - runtime.z <= _M8SafeEpoch)
        return;

    uint2 flowerDirectory=_M8FlowerDetailPagesRead.Load2(
        M8_FLOWER_TILE_DIRECTORY+M8_FLOWER_TILE_DIRECTORY_STRIDE*physicalSlot);
    bool hasFlowerPage=flowerDirectory.x!=0u;
    if (runtime.y == 0u && !hasFlowerPage)
    {
        if (_M8EvictAllDirty != 0u) return;
        uint ticket;
        InterlockedAdd(_M8Counters[M8_COUNTER_EVICTION_CLEAN_TICKET], 1u,
            ticket);
        if (ticket >= _M8Counters[M8_COUNTER_EVICTION_CLEAN_BUDGET]) return;
        uint prior;
        InterlockedCompareExchange(_M8ChunkTileRefs[tileRefIndex], expected,
            MERKABA_REF_COLD_ON_SSD, prior);
        if (prior != expected) return;
        uint2 owner=M8LoadChunkOwnerRead(meta.x);
        uint dualStatus=M8DualMakeLeafCold(owner.x,owner.y,meta.y,
            _M8DualPublishingGeneration,_M8DualRetiredGeneration);
        if (dualStatus > M8_DUAL_WRITE_COMMITTED)
        {
            _M8ChunkTileRefs[tileRefIndex]=expected;
            return;
        }
        M8FlowerMarkTileNeighborhoodDirty(physicalSlot, _M8DualPublishingGeneration,
            false, true);
        DeviceMemoryBarrier();
        M8PushPhysicalTile(physicalSlot);
        uint ignored;
        InterlockedAdd(_M8Counters[M8_COUNTER_HOT_TILE_COUNT], 0xffffffffu,
            ignored);
        InterlockedAdd(_M8Counters[M8_COUNTER_COLD_TILE_COUNT], 1u, ignored);
        return;
    }

    uint prior;
    InterlockedCompareExchange(_M8ChunkTileRefs[tileRefIndex], expected,
        MERKABA_REF_EVICTING, prior);
    if (prior != expected) return;
    uint queueIndex;
    InterlockedAdd(_M8Counters[M8_COUNTER_WRITEBACK_COUNT], 1u, queueIndex);
    if (queueIndex >= 32u)
    {
        InterlockedCompareExchange(_M8ChunkTileRefs[tileRefIndex],
            MERKABA_REF_EVICTING, expected, prior);
        return;
    }
    // A whole-source drain copies every selected tile without evicting SCAN
    // residency. This transient queue bit is not persisted or added to M8.
    _M8WritebackQueue[queueIndex] = uint2(physicalSlot, tileRefIndex |
        (_M8EvictAllDirty != 0u ? M8_WRITEBACK_KEEP_HOT : 0u));
    M8FlowerMarkTileNeighborhoodDirty(physicalSlot, _M8DualPublishingGeneration,
        false, true);
    M8CounterIncrement(M8_COUNTER_WRITEBACK_TILES);
}

[numthreads(64, 1, 1)]
void GatherWritebackBatch(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint item = groupId.x;
    uint count = min(_M8CountersRead[M8_COUNTER_WRITEBACK_COUNT], 32u);
    if (item >= count) return;
    uint physicalSlot = _M8WritebackQueueRead[item].x;
    if (thread == 0u)
    {
        uint4 meta = M8LoadTileMetaRead(physicalSlot);
        M8TileAddress address = M8LogicalAddress(meta.x, meta.y);
        _M8WritebackStaging[item * M8_WRITEBACK_TILE_RECORDS] =
            uint4(asuint(address.blockCoord), address.localAddress);
        M8GatherDualPacket(item, physicalSlot);
        M8CaptureFlowerTile(item*M8_WRITEBACK_TILE_RECORDS+1u+
            MERKABA_M8_KERNELS_PER_TILE+M8_DUAL_PACKET_RECORDS,physicalSlot);
    }
    for (uint kernelLocal = thread; kernelLocal < MERKABA_M8_KERNELS_PER_TILE;
         kernelLocal += 64u)
    {
        KernelState state = M8LoadKernelStateRead(physicalSlot, kernelLocal);
        _M8WritebackStaging[item * M8_WRITEBACK_TILE_RECORDS +
            1u + kernelLocal] = uint4(asuint(state.evidence), state.packedColor,
                state.colorConfidence, state.flags);
    }
}

groupshared uint gFlowerWritebackReady;
[numthreads(32, 1, 1)]
void AcknowledgeWritebackBatch(uint id : SV_DispatchThreadID)
{
    if (!M8FlowerPageSourceReady(_M8DualPublishingGeneration)) return;
    if(id==0u)
    {
        gFlowerWritebackReady=1u;
        [loop]for(uint item=0u;item<min(_M8StreamBatchCount,32u);item++)
        {
            uint first=item*M8_WRITEBACK_TILE_RECORDS+1u+512u+M8_DUAL_PACKET_RECORDS;
            if(_M8WritebackStaging[first].z!=2u)gFlowerWritebackReady=0u;
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if(gFlowerWritebackReady==0u)return;
    if (id >= _M8StreamBatchCount) return;
    if (id == 0u) _M8Counters[M8_COUNTER_WRITEBACK_COUNT] = 0u;
    uint2 queued = _M8WritebackQueueRead[id];
    uint physicalSlot = queued.x;
    uint refIndex = queued.y & M8_WRITEBACK_REF_MASK;
    bool keepHot = (queued.y & M8_WRITEBACK_KEEP_HOT) != 0u ||
        M8TilePinnedByObservation(physicalSlot,true);
    uint prior;
    InterlockedCompareExchange(_M8ChunkTileRefs[refIndex],
        MERKABA_REF_EVICTING,
        keepHot ? physicalSlot + 1u : MERKABA_REF_COLD_ON_SSD, prior);
    if (prior != MERKABA_REF_EVICTING) return;
    M8FlowerMarkTileNeighborhoodDirty(physicalSlot, _M8DualPublishingGeneration,
        true, true);
    if (keepHot)
    {
        // Persistence may copy a committed tile while its frozen observation
        // waits elsewhere, but its once-only admission token must survive.
        M8ClearTileDirty(physicalSlot);
        M8SignalResidencyChange();
        return;
    }
    // TransferFlowerStorage has retired both fine arenas and made the dual
    // leaf COLD before this final physical-slot publication barrier.
    DeviceMemoryBarrier();
    M8ClearTileDirty(physicalSlot);
    M8PushPhysicalTile(physicalSlot);
    uint ignored;
    InterlockedAdd(_M8Counters[M8_COUNTER_HOT_TILE_COUNT], 0xffffffffu,
        ignored);
    InterlockedAdd(_M8Counters[M8_COUNTER_COLD_TILE_COUNT], 1u, ignored);
}

[numthreads(32, 1, 1)]
void FailWritebackBatch(uint id : SV_DispatchThreadID)
{
    if (!M8FlowerPageSourceReady(_M8DualPublishingGeneration)) return;
    uint count = min(_M8StreamBatchCount, 32u);
    if (id < count)
    {
        uint2 queued = _M8WritebackQueueRead[id];
        uint refIndex = queued.y & M8_WRITEBACK_REF_MASK;
        uint prior;
        InterlockedCompareExchange(_M8ChunkTileRefs[refIndex],
            MERKABA_REF_EVICTING, queued.x + 1u, prior);
        if (prior == MERKABA_REF_EVICTING)
        {
            M8FlowerMarkTileNeighborhoodDirty(queued.x, _M8DualPublishingGeneration,
                true, true);
            M8MarkTileDirty(queued.x);
            M8SignalResidencyChange();
        }
    }
    if (id == 0u)
    {
        _M8Counters[M8_COUNTER_FAILED_WRITES] += count;
        _M8Counters[M8_COUNTER_STORAGE_BACKPRESSURE] = 1u;
        _M8Counters[M8_COUNTER_EVICTION_NEEDED] = 1u;
        _M8Counters[M8_COUNTER_WRITEBACK_COUNT] = 0u;
    }
}

#define M8_LOAD_LOCAL_MASK 0x00007fffu
#define M8_LOAD_SLOT_SHIFT 15u
#define M8_LOAD_INSTALL_BIT 0x40000000u
#define M8_LOAD_READY_BIT 0x80000000u

groupshared uint gLoadNeedCount;
groupshared uint gLoadReservationBase;
groupshared uint gLoadReservationCount;
groupshared uint gLoadDualReady[32];

uint4 M8DualLoadPacket(uint item, uint record)
{
    KernelState value=_M8LoadStagingStates[item*M8_LOAD_TILE_RECORDS+
        MERKABA_M8_KERNELS_PER_TILE+record];
    return uint4(asuint(value.evidence),value.packedColor,
        value.colorConfidence,value.flags);
}

// At most 32 paths, imported serially once per batch. This prevents sibling
// loads from independently allocating the same chunk's dense reference span.
bool M8RestoreDualAncestors(uint item)
{
    uint flags=M8DualLoadPacket(item,0u).x;
    if ((flags & 16u) != 0u) return false;
    if ((flags & 1u) == 0u) return flags == 0u;
    M8TileAddress address=_M8LoadStagingAddresses[item];
    uint block;
    if (!M8FindBlock(address.blockCoord,block)) return false;
    uint4 meta=M8DualLoadPacket(item,1u);
    M8DualBlockMeta incoming;
    incoming.StateAndGeneration=meta.x; incoming.PayloadIndex=meta.y;
    uint words[32];
    [unroll] for (uint index=0u;index<8u;++index)
    {
        uint4 value=M8DualLoadPacket(item,2u+index);
        words[4u*index]=value.x; words[4u*index+1u]=value.y;
        words[4u*index+2u]=value.z; words[4u*index+3u]=value.w;
    }
    uint status=M8DualInstallBlock(block,incoming,words,
        _M8DualPublishingGeneration,_M8DualRetiredGeneration);
    if (status > M8_DUAL_WRITE_COMMITTED) return false;
    if (status == M8_DUAL_WRITE_COMMITTED)
        M8FlowerMarkResidentBlockNeighborhoodDirty(block, _M8DualPublishingGeneration,
            true, false);
    if ((flags & 4u) == 0u) return true;
    uint4 a=M8DualLoadPacket(item,10u), b=M8DualLoadPacket(item,11u);
    M8DualChunkPayload chunk;
    chunk.NonFullMaskLo=a.x; chunk.NonFullMaskHi=a.y;
    chunk.MixedMaskLo=a.z; chunk.MixedMaskHi=a.w;
    chunk.LeafRefBase=b.x; chunk.Generation=b.y;
    chunk.Reserved0=b.z; chunk.Reserved1=b.w;
    status=M8DualInstallChunk(block,address.localAddress & 0x1ffu,
        incoming.StateAndGeneration >> 2u,chunk,
        _M8DualPublishingGeneration,_M8DualRetiredGeneration);
    if (status == M8_DUAL_WRITE_COMMITTED)
    {
        uint chunkReference = _M8BlockChunkRefsRead[block * MERKABA_M8_BLOCK_CHUNK_COUNT +
            (address.localAddress & 0x1ffu)];
        if (chunkReference != 0u && chunkReference - 1u < MERKABA_M8_CHUNK_CAPACITY)
            M8FlowerMarkResidentChunkNeighborhoodDirty(chunkReference - 1u,
                _M8DualPublishingGeneration, true, false);
    }
    if (status == M8_DUAL_WRITE_RETRY && (flags & 64u) != 0u)
    {
        // OPEN registers the complete sparse address hierarchy, not the whole
        // SSD leaf set as HOT GPU memory. A capacity-limited chunk stays COLD.
        uint physical;
        M8DualChunkPayload current;
        if (M8DualReadChunk(block,address.localAddress & 0x1ffu,
            physical,current) == M8_DUAL_AMBIGUOUS) return true;
    }
    return status <= M8_DUAL_WRITE_COMMITTED;
}

bool M8RestoreDualLeaf(uint item, uint slot, bool prepared)
{
    M8TileAddress address=_M8LoadStagingAddresses[item];
    uint block;
    if (!M8FindBlock(address.blockCoord,block)) return false;
    uint child=address.localAddress & 0x1ffu;
    uint tile=(address.localAddress >> 9u) & 0x3fu;
    uint flags=M8DualLoadPacket(item,0u).x;
    if ((flags & 8u) != 0u)
    {
        uint words[16];
        [unroll] for (uint index=0u;index<4u;++index)
        {
            uint4 value=M8DualLoadPacket(item,12u+index);
            words[4u*index]=value.x; words[4u*index+1u]=value.y;
            words[4u*index+2u]=value.z; words[4u*index+3u]=value.w;
        }
        uint status=M8DualInstallLeaf(block,child,tile,slot,
            M8DualLoadPacket(item,11u).y,_M8DualPublishingGeneration,
            _M8DualRetiredGeneration,words,prepared);
        if (status > M8_DUAL_WRITE_COMMITTED) return false;
        // All checks precede the leaf write. There is no fallible operation
        // after its publication and therefore no staged HOT ref to roll back.
        if (status == M8_DUAL_WRITE_COMMITTED) return true;
    }
    // An ignored older response is not proof that a newer MIXED leaf is HOT.
    uint chunk;
    M8DualChunkPayload payload;
    uint state=M8DualReadChunk(block,child,chunk,payload);
    if (state == M8_DUAL_MIXED) state=M8DualChunkTileState(payload,tile);
    if (state != M8_DUAL_MIXED) return state != M8_DUAL_AMBIGUOUS;
    uint resident;
    return M8DualStorageLeafResident(M8DualLeafReference(payload,tile),
        chunk,tile,prepared,resident) && resident == slot;
}

[numthreads(32, 1, 1)]
void PrepareLoadedTiles(uint id : SV_DispatchThreadID)
{
    if (!M8FlowerPageSourceReady(_M8DualPublishingGeneration)) return;
    if (id == 0u)
    {
        gLoadNeedCount = 0u;
        gLoadReservationBase = 0u;
        gLoadReservationCount = 0u;
        uint chunks=min(_M8Counters[M8_COUNTER_CHUNK_COUNT],MERKABA_M8_CHUNK_CAPACITY);
        uint reclaimCount=min(chunks,256u);
        [loop] for (uint cursor=0u;cursor<reclaimCount;++cursor)
        {
            uint physical=(_M8DualReclaimCursor+cursor)%chunks;
            uint2 owner=M8LoadChunkOwnerRead(physical);
            uint reclaimed=M8DualMakeChunkCold(owner.x,owner.y,_M8DualPublishingGeneration,
                _M8DualRetiredGeneration,_M8DualDurableGeneration);
            if (reclaimed == M8_DUAL_WRITE_COMMITTED)
            {
                M8FlowerMarkResidentChunkNeighborhoodDirty(physical,
                    _M8DualPublishingGeneration, true, false);
                M8SignalResidencyChange();
            }
        }
        [loop] for (uint item=0u;item<min(_M8StreamBatchCount,32u);++item)
            gLoadDualReady[item]=M8RestoreDualAncestors(item) ? 1u : 0u;
    }
    DeviceMemoryBarrierWithGroupSync();

    bool active = id < min(_M8StreamBatchCount, 32u);
    M8TileAddress address = (M8TileAddress)0;
    if (active) address = _M8LoadStagingAddresses[id];
    uint localAddress = address.localAddress & M8_LOAD_LOCAL_MASK;
    uint encodedAddress = localAddress;
    uint chunkIndex = 0u;
    uint tileLocal = 0u;
    bool needsSlot = false;
    if (active && gLoadDualReady[id] != 0u)
    {
        encodedAddress = localAddress;
        // Scope bits are residency packets for sparse dual-only ancestors.
        // They allocate no M8 tile and never fabricate positive states.
        if ((M8DualLoadPacket(id,0u).x & 96u) != 0u)
        {
            _M8LoadStagingAddresses[id].localAddress=localAddress|M8_LOAD_READY_BIT;
        }
        uint blockIndex;
        if ((M8DualLoadPacket(id,0u).x & 96u) == 0u &&
            M8FindBlock(address.blockCoord, blockIndex))
        {
            uint chunkLocal = localAddress & 0x1ffu;
            tileLocal = (localAddress >> 9u) & 0x3fu;
            uint chunkRef = _M8BlockChunkRefsRead[blockIndex *
                MERKABA_M8_BLOCK_CHUNK_COUNT + chunkLocal];
            if (chunkRef != MERKABA_REF_EMPTY &&
                chunkRef < MERKABA_REF_EVICTING)
            {
                chunkIndex = chunkRef - 1u;
                uint refIndex = chunkIndex * MERKABA_M8_TILES_PER_CHUNK +
                    tileLocal;
                uint tileRef = _M8ChunkTileRefsRead[refIndex];
                if (M8IsHotRef(tileRef))
                {
                    uint physicalSlot = M8PhysicalSlot(tileRef);
                    uint4 meta =
                        _M8TileRecords[M8TileMetaIndex(physicalSlot)];
                    if (meta.x == chunkIndex && meta.y == tileLocal &&
                        M8RestoreDualLeaf(id,physicalSlot,false))
                    {
                        M8FlowerMarkTileNeighborhoodDirty(physicalSlot,
                            _M8DualPublishingGeneration, true, false);
                        encodedAddress |= M8_LOAD_READY_BIT;
                    }
                }
                else if (tileRef == MERKABA_REF_LOADING)
                {
                    uint slot=(address.localAddress>>M8_LOAD_SLOT_SHIFT)&0x7fffu;
                    uint4 staged=_M8TileRecords[M8TileMetaIndex(slot)];
                    if((address.localAddress&(M8_LOAD_INSTALL_BIT|M8_LOAD_READY_BIT))==
                        (M8_LOAD_INSTALL_BIT|M8_LOAD_READY_BIT) &&
                        staged.x==chunkIndex && staged.y==tileLocal)
                        encodedAddress=address.localAddress;
                    else needsSlot = true;
                }
            }
        }
    }

    uint needIndex = 0xffffffffu;
    if (needsSlot)
        InterlockedAdd(gLoadNeedCount, 1u, needIndex);
    GroupMemoryBarrierWithGroupSync();

    if (id == 0u)
    {
        uint freeCount = min(_M8Counters[M8_COUNTER_FREE_TILE_COUNT],
            MERKABA_M8_PHYSICAL_TILE_CAPACITY);
        gLoadReservationCount = min(gLoadNeedCount, freeCount);
        gLoadReservationBase = freeCount - gLoadReservationCount;
        _M8Counters[M8_COUNTER_FREE_TILE_COUNT] = gLoadReservationBase;
        if (gLoadReservationCount < gLoadNeedCount)
            _M8Counters[M8_COUNTER_TILE_STARVATION] = 1u;
        if (gLoadReservationCount < gLoadNeedCount ||
            (gLoadReservationCount != 0u && gLoadReservationBase < 256u))
            _M8Counters[M8_COUNTER_EVICTION_NEEDED] = 1u;
    }
    GroupMemoryBarrierWithGroupSync();

    uint reservedSlot = 0xffffffffu;
    if (needsSlot && needIndex < gLoadReservationCount)
        reservedSlot = _M8FreeTileStack[gLoadReservationBase + needIndex];
    // A failed dual prepare returns its reserved slot to this same stack.
    // Every lane must consume its reservation before any lane can overwrite
    // the newly freed suffix with a rollback push.
    GroupMemoryBarrierWithGroupSync();

    if (reservedSlot != 0xffffffffu)
    {
        uint physicalSlot = reservedSlot;
        uint generation = M8NextTileSlotGeneration(
            _M8TileRecords[M8TileRuntimeIndex(physicalSlot)].w);
        M8ClearTileDirty(physicalSlot);
        _M8TileRecords[M8TileMetaIndex(physicalSlot)] =
            uint4(chunkIndex, tileLocal, 0u, 0u);
        _M8TileRecords[M8TileRuntimeIndex(physicalSlot)] =
            uint4(0u, 0u, _M8Counters[M8_COUNTER_FRAME_EPOCH], generation);
        // This existing preparation stage has room for the page-directory
        // writer. InstallLoadedTiles uses all eight UAVs for M8 publication;
        // its LOADING slot and existing neighbours are already invalid here.
        M8FlowerMarkTileNeighborhoodDirty(physicalSlot, _M8DualPublishingGeneration,
            true, false);
        DeviceMemoryBarrier();
        if (M8RestoreDualLeaf(id,physicalSlot,true))
            encodedAddress |= (physicalSlot << M8_LOAD_SLOT_SHIFT) |
                M8_LOAD_INSTALL_BIT | M8_LOAD_READY_BIT;
        else
            M8PushPhysicalTile(physicalSlot);
    }
    if (active && (M8DualLoadPacket(id,0u).x & 96u) == 0u)
        _M8LoadStagingAddresses[id].localAddress = encodedAddress;
}

groupshared uint gLoadSlot;
groupshared uint gLoadInstall;
groupshared uint gLoadOccupied;
groupshared uint gLoadCarve;

[numthreads(64, 1, 1)]
void InstallLoadedTiles(uint3 groupId : SV_GroupID,
    uint thread : SV_GroupIndex)
{
    uint item = groupId.x;
    if (thread == 0u)
    {
        uint encodedAddress =
            _M8LoadStagingAddressesRead[item].localAddress;
        uint fineFirst=item*M8_LOAD_TILE_RECORDS+512u+M8_DUAL_PACKET_RECORDS;
        gLoadInstall = (encodedAddress & M8_LOAD_INSTALL_BIT) != 0u &&
            _M8LoadStagingStates[fineFirst].flags==2u ? 1u : 0u;
        gLoadSlot = (encodedAddress >> M8_LOAD_SLOT_SHIFT) & 0x7fffu;
        gLoadOccupied = 0u;
        gLoadCarve = 0u;
    }
    GroupMemoryBarrierWithGroupSync();

    if (gLoadInstall != 0u && thread < MERKABA_M8_TILE_WORDS)
        _M8TileBits[M8TileWordIndex(gLoadSlot, thread)] = 0u;
    DeviceMemoryBarrierWithGroupSync();
    if (gLoadInstall != 0u)
    {
        for (uint kernelLocal = thread;
             kernelLocal < MERKABA_M8_KERNELS_PER_TILE;
             kernelLocal += 64u)
        {
            KernelState state = _M8LoadStagingStates[item *
                M8_LOAD_TILE_RECORDS + kernelLocal];
            M8StoreKernelState(gLoadSlot, kernelLocal, state);
            uint wordIndex = M8TileWordIndex(gLoadSlot, kernelLocal >> 5u);
            uint bit = 1u << (kernelLocal & 31u);
            uint ignored;
            if ((state.flags & MERKABA_OCCUPIED_FLAG) != 0u)
            {
                InterlockedOr(_M8TileBits[wordIndex].x, bit, ignored);
                InterlockedAdd(gLoadOccupied, 1u, ignored);
            }
            if ((state.flags & (MERKABA_OCCUPIED_FLAG | MERKABA_R1_SEED_FLAG)) != 0u)
            {
                InterlockedOr(_M8TileBits[wordIndex].y, bit, ignored);
                InterlockedAdd(gLoadCarve, 1u, ignored);
            }
        }
    }
    AllMemoryBarrierWithGroupSync();
    if (thread == 0u && gLoadInstall != 0u)
    {
        uint4 meta = _M8TileRecords[M8TileMetaIndex(gLoadSlot)];
        meta.z = gLoadOccupied;
        meta.w = gLoadCarve;
        _M8TileRecords[M8TileMetaIndex(gLoadSlot)] = meta;
    }
    DeviceMemoryBarrierWithGroupSync();
    if (thread == 0u && gLoadInstall != 0u)
    {
        uint4 meta = _M8TileRecords[M8TileMetaIndex(gLoadSlot)];
        uint refIndex = meta.x * MERKABA_M8_TILES_PER_CHUNK + meta.y;
        _M8ChunkTileRefs[refIndex] = gLoadSlot + 1u;
        DeviceMemoryBarrier();
        uint ignored;
        InterlockedAdd(_M8Counters[M8_COUNTER_COLD_TILE_COUNT], 0xffffffffu,
            ignored);
        InterlockedAdd(_M8Counters[M8_COUNTER_HOT_TILE_COUNT], 1u, ignored);
        InterlockedAdd(_M8Counters[M8_COUNTER_LOADS_INSTALLED], 1u, ignored);
        M8SignalResidencyChange();
    }
}

[numthreads(32, 1, 1)]
void FailLoadedTiles(uint id : SV_DispatchThreadID)
{
    if (id >= _M8StreamBatchCount) return;
    M8TileAddress address = _M8LoadStagingAddressesRead[id];
    bool prepared=(address.localAddress&M8_LOAD_INSTALL_BIT)!=0u;
    uint fineFirst=id*M8_LOAD_TILE_RECORDS+512u+M8_DUAL_PACKET_RECORDS;
    if(prepared && _M8LoadStagingStates[fineFirst].flags!=5u)return;
    uint blockIndex;
    if (!M8FindBlock(address.blockCoord, blockIndex)) return;
    uint chunkLocal = address.localAddress & 0x1ffu;
    uint tileLocal = (address.localAddress >> 9u) & 0x3fu;
    uint chunkRef = _M8BlockChunkRefsRead[blockIndex *
        MERKABA_M8_BLOCK_CHUNK_COUNT + chunkLocal];
    if (chunkRef == 0u || chunkRef >= MERKABA_REF_EVICTING) return;
    uint refIndex = (chunkRef - 1u) * MERKABA_M8_TILES_PER_CHUNK + tileLocal;
    uint prior;
    InterlockedCompareExchange(_M8ChunkTileRefs[refIndex],
        MERKABA_REF_LOADING, MERKABA_REF_COLD_ON_SSD, prior);
    if (prior == MERKABA_REF_LOADING)
    {
        if(prepared)M8PushPhysicalTile((address.localAddress>>M8_LOAD_SLOT_SHIFT)&0x7fffu);
        M8CounterIncrement(M8_COUNTER_FAILED_READS);
        M8SignalResidencyChange();
    }
}

[numthreads(64, 1, 1)]
void RegisterLoadedTileAddresses(uint id : SV_DispatchThreadID)
{
    if (id >= _M8StreamBatchCount) return;
    M8TileAddress address = _M8LoadStagingAddressesRead[id];
    address.localAddress &= M8_LOAD_LOCAL_MASK;
    uint blockIndex;
    uint failureReason;
    if (!M8FindOrClaimBlock(address.blockCoord, blockIndex,
        failureReason)) return;
    if (_M8RegisterDualNodeKind == 2u) return;
    uint chunkLocal = address.localAddress & 0x1ffu;
    uint chunkIndex;
    if (!M8FindOrClaimChunk(blockIndex, chunkLocal, chunkIndex,
        failureReason)) return;
    if (_M8RegisterDualNodeKind == 4u) return;
    uint tileLocal = (address.localAddress >> 9u) & 0x3fu;
    uint refIndex = chunkIndex * MERKABA_M8_TILES_PER_CHUNK + tileLocal;
    uint prior;
    InterlockedCompareExchange(_M8ChunkTileRefs[refIndex], MERKABA_REF_EMPTY,
        MERKABA_REF_COLD_ON_SSD, prior);
    if (prior == MERKABA_REF_EMPTY)
    {
        uint d1 = (tileLocal >> 3u) & 7u;
        uint d0 = tileLocal & 7u;
        uint ignored;
        InterlockedOr(_M8ChunkPresence[M8ChunkPresenceL0Index(chunkIndex)],
            1u << d1, ignored);
        InterlockedOr(_M8ChunkPresence[M8ChunkPresenceL1Index(chunkIndex, d1)],
            1u << d0, ignored);
        InterlockedAdd(_M8Counters[M8_COUNTER_COLD_TILE_COUNT], 1u, ignored);
    }
}

#include "MerkabaFlowerStorageTransfer.hlsl"
