    float3(0.5773502691896258, 0.5773502691896258, 0.5773502691896258),
    float3(0.5773502691896258, -0.5773502691896258, -0.5773502691896258),
    float3(-0.5773502691896258, 0.5773502691896258, -0.5773502691896258),
    float3(-0.5773502691896258, -0.5773502691896258, 0.5773502691896258)
};

struct M8FlowerInterval { float lo; float hi; };
struct M8FlowerInterval2 { M8FlowerInterval x; M8FlowerInterval y; };
struct M8FlowerInterval3 { M8FlowerInterval x; M8FlowerInterval y; M8FlowerInterval z; };

float M8FlowerNext(float v)
{
    uint b = asuint(v);
    if ((b & 0x7fffffffu) == 0u) return asfloat(1u);
    if (b == 0x7f800000u) return v;
    return asfloat((b & 0x80000000u) == 0u ? b + 1u : b - 1u);
}

float M8FlowerPrevious(float v)
{
    uint b = asuint(v);
    if ((b & 0x7fffffffu) == 0u) return asfloat(0x80000001u);
    if (b == 0xff800000u) return v;
    return asfloat((b & 0x80000000u) == 0u ? b - 1u : b + 1u);
}

M8FlowerInterval M8FlowerI(float lo, float hi)
{
    M8FlowerInterval r; r.lo = lo; r.hi = hi; return r;
}

// Exact algebraic identities preserve zero without manufacturing denormal
// endpoints that a mobile arithmetic unit can flush before the next op.
// Inspect bits: a nonzero subnormal is NOT the exact zero interval.
bool M8FlowerIZero(M8FlowerInterval a)
{
    return ((asuint(a.lo) | asuint(a.hi)) & 0x7fffffffu) == 0u;
}

M8FlowerInterval M8FlowerIAdd(M8FlowerInterval a, M8FlowerInterval b)
{
    if (M8FlowerIZero(a)) return b;
    if (M8FlowerIZero(b)) return a;
    precise float lo = a.lo+b.lo;
    precise float hi = a.hi+b.hi;
    return M8FlowerI(M8FlowerPrevious(lo),M8FlowerNext(hi));
}

M8FlowerInterval M8FlowerISub(M8FlowerInterval a, M8FlowerInterval b)
{
    if (M8FlowerIZero(b)) return a;
    if (M8FlowerIZero(a)) return M8FlowerI(-b.hi,-b.lo);
    precise float lo = a.lo-b.hi;
    precise float hi = a.hi-b.lo;
    return M8FlowerI(M8FlowerPrevious(lo),M8FlowerNext(hi));
}

M8FlowerInterval M8FlowerIMul(M8FlowerInterval a, M8FlowerInterval b)
{
    if ((M8FlowerIZero(a) && all((asuint(float2(b.lo,b.hi)) & 0x7f800000u) != 0x7f800000u)) ||
        (M8FlowerIZero(b) && all((asuint(float2(a.lo,a.hi)) & 0x7f800000u) != 0x7f800000u)))
        return M8FlowerI(0.0,0.0);
    precise float4 p = float4(a.lo * b.lo, a.lo * b.hi,
        a.hi * b.lo, a.hi * b.hi);
    return M8FlowerI(M8FlowerPrevious(min(min(p.x,p.y),min(p.z,p.w))),
        M8FlowerNext(max(max(p.x,p.y),max(p.z,p.w))));
}

M8FlowerInterval M8FlowerISquare(M8FlowerInterval a)
{
    if (M8FlowerIZero(a)) return M8FlowerI(0.0,0.0);
    if (a.lo <= 0.0 && a.hi >= 0.0)
        return M8FlowerI(0.0,
            M8FlowerNext(max(a.lo*a.lo,a.hi*a.hi)));
    return M8FlowerIMul(a,a);
}

struct M8FlowerDyadicSquare
{
    uint2 coefficient;
    int exponent;
    uint nonzero;
};

uint2 M8FlowerMultiply24(uint a, uint b)
{
    uint a0 = a & 0xffffu;
    uint a1 = a >> 16;
    uint b0 = b & 0xffffu;
    uint b1 = b >> 16;
    uint p0 = a0*b0;
    uint p1 = a0*b1+a1*b0;
    uint lo = p0+(p1 << 16);
    uint carry = lo < p0 ? 1u : 0u;
    uint hi = (p1 >> 16)+a1*b1+carry;
    return uint2(lo,hi);
}

M8FlowerDyadicSquare M8FlowerSquareDyadic(float value)
{
    M8FlowerDyadicSquare result;
    uint bits = asuint(abs(value));
    uint exponentBits = (bits >> 23) & 0xffu;
    uint mantissa = bits & 0x7fffffu;
    result.nonzero = 0u;
    result.coefficient = 0u.xx;
    result.exponent = 0;
    if (exponentBits == 0xffu)
    {
        result.nonzero = 2u;
        return result;
    }
    if (exponentBits == 0u && mantissa == 0u)
        return result;
    int exponent = exponentBits == 0u ? -149 : (int)exponentBits-127-23;
    if (exponentBits != 0u) mantissa |= 0x800000u;
    int trailing = firstbitlow(mantissa);
    mantissa >>= trailing;
    exponent += trailing;
    result.coefficient = M8FlowerMultiply24(mantissa,mantissa);
    result.exponent = exponent*2;
    result.nonzero = 1u;
    return result;
}

uint M8FlowerBitLength(uint2 value)
{
    return value.y != 0u ? 33u+(uint)firstbithigh(value.y) :
        (value.x != 0u ? 1u+(uint)firstbithigh(value.x) : 0u);
}

bool M8FlowerEqual64(uint2 a, uint2 b)
{
    return all(a == b);
}

uint2 M8FlowerAdd64(uint2 a, uint2 b)
{
    uint lo = a.x+b.x;
    return uint2(lo,a.y+b.y+(lo < a.x ? 1u : 0u));
}

uint2 M8FlowerShiftLeft64(uint2 value, uint shift)
{
    if (shift == 0u) return value;
    if (shift < 32u)
        return uint2(value.x << shift,
            (value.y << shift) | (value.x >> (32u-shift)));
    if (shift < 64u) return uint2(0u,value.x << (shift-32u));
    return 0u.xx;
}

uint2 M8FlowerShiftRightOne64(uint2 value)
{
    return uint2((value.x >> 1) | (value.y << 31),value.y >> 1);
}

bool M8FlowerExactSquaredEquality(float a, float b, float c)
{
    M8FlowerDyadicSquare sa = M8FlowerSquareDyadic(a);
    M8FlowerDyadicSquare sb = M8FlowerSquareDyadic(b);
    M8FlowerDyadicSquare sc = M8FlowerSquareDyadic(c);
    if (sa.nonzero == 2u || sb.nonzero == 2u || sc.nonzero == 2u)
        return false;
    if (sb.nonzero == 0u && sc.nonzero == 0u)
        return sa.nonzero == 0u;
    if (sa.nonzero == 0u) return false;
    if (sb.nonzero == 0u)
        return sa.exponent == sc.exponent &&
            M8FlowerEqual64(sa.coefficient,sc.coefficient);
    if (sc.nonzero == 0u)
        return sa.exponent == sb.exponent &&
            M8FlowerEqual64(sa.coefficient,sb.coefficient);

    if (sb.exponent == sc.exponent)
    {
        uint2 sum = M8FlowerAdd64(sb.coefficient,sc.coefficient);
        return sa.exponent == sb.exponent+1 &&
            M8FlowerEqual64(sa.coefficient,M8FlowerShiftRightOne64(sum));
    }

    M8FlowerDyadicSquare low;
    M8FlowerDyadicSquare high;
    if (sb.exponent < sc.exponent)
    {
        low = sb;
        high = sc;
    }
    else
    {
        low = sc;
        high = sb;
    }
    int difference = high.exponent-low.exponent;
    if (sa.exponent != low.exponent || difference >= 64)
        return false;
    uint highBits = M8FlowerBitLength(high.coefficient);
    uint leftBits = M8FlowerBitLength(sa.coefficient);
    if (highBits+(uint)difference > leftBits)
        return false;
    uint2 sum = M8FlowerAdd64(low.coefficient,
        M8FlowerShiftLeft64(high.coefficient,(uint)difference));
    return M8FlowerEqual64(sa.coefficient,sum);
}

uint M8FlowerClassifyRoot(M8FlowerInterval3 abc)
{
    if (abc.x.lo == abc.x.hi && abc.y.lo == abc.y.hi &&
        abc.z.lo == abc.z.hi &&
        M8FlowerExactSquaredEquality(abc.x.lo,abc.y.lo,abc.z.lo))
        return abc.y.lo == 0.0 && abc.z.lo == 0.0 ?
            M8_FLOWER_ROOT_COPLANAR : M8_FLOWER_ROOT_CERTAIN_TANGENT;
    M8FlowerInterval q = M8FlowerIAdd(M8FlowerISquare(abc.y),
        M8FlowerISquare(abc.z));
    M8FlowerInterval aa = M8FlowerISquare(abc.x);
    if (q.lo == 0.0 && q.hi == 0.0)
    {
        if (abc.x.lo == abc.x.hi)
            return abc.x.lo == 0.0 ? M8_FLOWER_ROOT_COPLANAR :
                M8_FLOWER_ROOT_IMPOSSIBLE;
        return abc.x.lo <= 0.0 && abc.x.hi >= 0.0 ?
            M8_FLOWER_ROOT_AMBIGUOUS : M8_FLOWER_ROOT_IMPOSSIBLE;
    }
    if (aa.hi < q.lo) return M8_FLOWER_ROOT_CERTAIN_SECANT;
    if (aa.lo > q.hi) return M8_FLOWER_ROOT_IMPOSSIBLE;
    if (aa.lo == aa.hi && q.lo == q.hi && aa.lo == q.lo && q.lo > 0.0)
        return M8_FLOWER_ROOT_CERTAIN_TANGENT;
    return M8_FLOWER_ROOT_AMBIGUOUS;
}

// Exact dyadic comparisons certify interval products and midpoint decisions.
M8FlowerDyadicSquare M8FlowerProductDyadic(float left, float right)
{
    M8FlowerDyadicSquare result;
    uint2 bits = uint2(asuint(left), asuint(right)) & 0x7fffffffu;
    uint2 e = (bits >> 23u) & 0xffu;
    uint2 m = bits & 0x7fffffu;
    m |= uint2(e.x != 0u ? 0x800000u : 0u,
        e.y != 0u ? 0x800000u : 0u);
    result.coefficient = M8FlowerMultiply24(m.x, m.y);
    result.exponent = (e.x == 0u ? -149 : (int)e.x - 150) +
        (e.y == 0u ? -149 : (int)e.y - 150);
    result.nonzero = any(e == 255u) ? 2u :
        (all(m != 0u) ? 1u : 0u);
    if (result.nonzero == 0u) result.coefficient = 0u.xx;
    return result;
}

int M8FlowerCompareDyadic(M8FlowerDyadicSquare a, M8FlowerDyadicSquare b)
{
    uint na = M8FlowerBitLength(a.coefficient);
    uint nb = M8FlowerBitLength(b.coefficient);
    if (na == 0u || nb == 0u) return na == nb ? 0 : (na == 0u ? -1 : 1);
    int topA = a.exponent + (int)na;
    int topB = b.exponent + (int)nb;
    if (topA != topB) return topA < topB ? -1 : 1;
    uint2 ca = M8FlowerShiftLeft64(a.coefficient, na < nb ? nb - na : 0u);
    uint2 cb = M8FlowerShiftLeft64(b.coefficient, nb < na ? na - nb : 0u);
    if (ca.y != cb.y) return ca.y < cb.y ? -1 : 1;
    return ca.x == cb.x ? 0 : (ca.x < cb.x ? -1 : 1);
}

bool M8FlowerDivideEnclosed(float numerator, float denominator,
    out M8FlowerInterval result)
{
    result = M8FlowerI(0.0, 0.0);
    uint denominatorBits = asuint(denominator);
    if (!M8FlowerIsFinite(numerator) || denominatorBits == 0u ||
        denominatorBits >= 0x7f800000u)
        return false;
    uint sign = asuint(numerator) & 0x80000000u;
    uint magnitude = asuint(numerator) & 0x7fffffffu;
    if (magnitude == 0u) return true;
    uint nEncoded=magnitude>>23u,dEncoded=denominatorBits>>23u;
    uint n=(magnitude&0x7fffffu)|(nEncoded!=0u?0x800000u:0u);
    uint d=(denominatorBits&0x7fffffu)|(dEncoded!=0u?0x800000u:0u);
    int nExponent=nEncoded!=0u?(int)nEncoded-127:-126;
    int dExponent=dEncoded!=0u?(int)dEncoded-127:-126;
    [loop] while(n<0x800000u){n<<=1u;--nExponent;}
    [loop] while(d<0x800000u){d<<=1u;--dExponent;}
    int exponent=nExponent-dExponent;
    if(n<d){n<<=1u;--exponent;}
    if(exponent>127)return false;
    uint lo=0u,hi=1u;
    if(exponent>=-149)
    {
        // d<=n<2d. Integer long division emits exactly the representable
        // significand bits, never more than23; every remainder is <2d.
        uint fractionBits=exponent>=-126?23u:(uint)(exponent+149);
        uint quotient=1u,remainder=n-d;
        [loop] for(uint bit=0u;bit<fractionBits;++bit)
        {
            if(remainder==0u){quotient<<=fractionBits-bit;break;}
            remainder<<=1u;quotient<<=1u;
            if(remainder>=d){remainder-=d;quotient|=1u;}
        }
        lo=exponent>=-126?((uint)(exponent+127)<<23u)|(quotient&0x7fffffu):quotient;
        hi=lo+(remainder!=0u?1u:0u);
        if(hi>=0x7f800000u)return false;
    }
    // Underflow has the exact [0,min-subnormal] enclosure. Subnormal to
    // normal carry is valid; only maxfinite to infinity was rejected above.
    if (sign == 0u) result = M8FlowerI(asfloat(lo),asfloat(hi));
    else result = M8FlowerI(asfloat(hi | sign),asfloat(lo | sign));
    return true;
}

bool M8FlowerIDivPositive(M8FlowerInterval numerator,
    M8FlowerInterval denominator, out M8FlowerInterval result)
{
    result = M8FlowerI(0.0, 0.0);
    uint dLo = asuint(denominator.lo), dHi = asuint(denominator.hi);
    uint nLo = asuint(numerator.lo), nHi = asuint(numerator.hi);
    if (dLo == 0u || dLo > dHi || dHi >= 0x7f800000u ||
        !M8FlowerIsFinite(numerator.lo) || !M8FlowerIsFinite(numerator.hi)) return false;
    // Compare finite values and choose denominator endpoints by bits.
    // Shader FP comparisons may flush a nonzero subnormal to signed zero.
    if ((nLo & 0x7fffffffu) == 0u) nLo = 0u;
    if ((nHi & 0x7fffffffu) == 0u) nHi = 0u;
    bool lowerNegative = (nLo >> 31u) != 0u;
    bool upperNegative = (nHi >> 31u) != 0u;
    uint lowerOrder = lowerNegative ? ~nLo : nLo | 0x80000000u;
    uint upperOrder = upperNegative ? ~nHi : nHi | 0x80000000u;
    if (lowerOrder > upperOrder) return false;
    float2 numerators = float2(numerator.lo,numerator.hi);
    float2 denominators = float2(lowerNegative ? denominator.lo : denominator.hi,
        upperNegative ? denominator.hi : denominator.lo);
    float2 endpoints = 0.0;
    [loop] for(uint endpoint=0u;endpoint<2u;endpoint++)
    {
        M8FlowerInterval enclosed;
        if(!M8FlowerDivideEnclosed(numerators[endpoint],denominators[endpoint],enclosed))return false;
        endpoints[endpoint]=endpoint==0u?enclosed.lo:enclosed.hi;
    }
    result = M8FlowerI(endpoints.x,endpoints.y);
    return true;
}

// The canonical rounding implementation follows the interval primitives
// whose exact dyadic enclosure it reuses.
float M8FlowerRoundSqrt(float value);

bool M8FlowerISqrt(M8FlowerInterval value, out M8FlowerInterval result)
{
    result = M8FlowerI(0.0, 0.0);
    if (!(value.lo >= 0.0) || value.lo > value.hi || !M8FlowerIsFinite(value.hi))
        return false;
    float2 values=float2(value.lo,value.hi);
    precise float2 rounded=0.0;
    [loop] for(uint endpoint=0u;endpoint<2u;endpoint++)
        rounded[endpoint]=M8FlowerRoundSqrt(values[endpoint]);
    float2 enclosed=float2(max(0.0,M8FlowerPrevious(rounded.x)),M8FlowerNext(rounded.y));
    if(!M8FlowerIsFinite(enclosed.y))return false;
    [loop] for(uint endpoint=0u;endpoint<2u;endpoint++)
    {
        int comparison=M8FlowerCompareDyadic(M8FlowerSquareDyadic(enclosed[endpoint]),
            M8FlowerProductDyadic(values[endpoint],1.0));
        if(endpoint==0u?comparison>0:comparison<0)return false;
    }
    result = M8FlowerI(enclosed.x,enclosed.y);
    return true;
}

float M8FlowerAbsoluteProductSumUpper(float3 a, float3 b)
{
    precise float3 product = a * b;
    float3 upper = float3(M8FlowerNext(abs(product.x)),
        M8FlowerNext(abs(product.y)), M8FlowerNext(abs(product.z)));
    precise float xy = upper.x + upper.y;
    precise float xyz = M8FlowerNext(xy) + upper.z;
    return M8FlowerNext(xyz);
}

M8FlowerInterval M8FlowerCenterRadius(float center, float radius)
{
    precise float lo = center - radius;
    precise float hi = center + radius;
    return M8FlowerI(M8FlowerPrevious(lo), M8FlowerNext(hi));
}

// Section 5: the caller supplies the frozen calibrated + quantization
// uncertainty, never an observation score or a manually selected epsilon.
// relative is the loop-center displacement from this endpoint's M8 owner.
bool M8FlowerPlaneIntervals(float3 normal, float offset, float3 relative,
    float radius, uint lineClass, float normalUncertainty, float offsetUncertainty,
    out M8FlowerInterval3 abc)
{
    abc.x = M8FlowerI(0.0, 0.0); abc.y = abc.x; abc.z = abc.x;
    if (lineClass >= M8_FLOWER_LINE_CLASS_COUNT ||
        !all(M8FlowerIsFinite(normal)) || !all(M8FlowerIsFinite(relative)) ||
        !all(M8FlowerIsFinite(float4(offset, radius, normalUncertainty, offsetUncertainty))) ||
        radius <= 0.0 || normalUncertainty < 0.0 || offsetUncertainty < 0.0)
        return false;
    float3 e1 = M8FlowerLineE1[lineClass];
    float3 e2 = M8FlowerLineE2[lineClass];
    precise float3 ar = normal * relative;
    precise float axy = ar.x + ar.y;
    precise float a = (axy + ar.z) - offset;
    precise float3 br = normal * e1;
    precise float bxy = br.x + br.y;
    precise float b = radius * (bxy + br.z);
    precise float3 cr = normal * e2;
    precise float cxy = cr.x + cr.y;
    precise float c = radius * (cxy + cr.z);

    M8FlowerInterval lengthSquared = M8FlowerIAdd(M8FlowerIAdd(
        M8FlowerISquare(M8FlowerI(relative.x, relative.x)),
        M8FlowerISquare(M8FlowerI(relative.y, relative.y))),
        M8FlowerISquare(M8FlowerI(relative.z, relative.z)));
    M8FlowerInterval length = M8FlowerI(0.0, 0.0);
    if (!M8FlowerISqrt(lengthSquared, length)) return false;
    precise float sa = M8FlowerAbsoluteProductSumUpper(normal, relative) + abs(offset);
    precise float sb = radius * M8FlowerAbsoluteProductSumUpper(normal, e1);
    precise float sc = radius * M8FlowerAbsoluteProductSumUpper(normal, e2);
    precise float eaMetric = normalUncertainty * length.hi;
    precise float eaOffset = M8FlowerNext(eaMetric) + offsetUncertainty;
    precise float eaRound = M8_FLOWER_GAMMA6_UPPER * M8FlowerNext(sa);
    precise float ea = M8FlowerNext(eaOffset) + M8FlowerNext(eaRound);
    precise float radialMetric = radius * normalUncertainty;
    precise float ebRound = M8_FLOWER_GAMMA7_UPPER * M8FlowerNext(sb);
    precise float ecRound = M8_FLOWER_GAMMA7_UPPER * M8FlowerNext(sc);
    precise float eb = M8FlowerNext(radialMetric) + M8FlowerNext(ebRound);
    precise float ec = M8FlowerNext(radialMetric) + M8FlowerNext(ecRound);
    abc.x = M8FlowerCenterRadius(a, M8FlowerNext(ea));
    abc.y = M8FlowerCenterRadius(b, M8FlowerNext(eb));
    abc.z = M8FlowerCenterRadius(c, M8FlowerNext(ec));
    return all(M8FlowerIsFinite(float3(abc.x.lo, abc.y.lo, abc.z.lo))) &&
        all(M8FlowerIsFinite(float3(abc.x.hi, abc.y.hi, abc.z.hi)));
}

uint M8FlowerRootInterval(M8FlowerInterval3 abc, bool plusRoot,
    out M8FlowerInterval2 root)
{
    root.x = M8FlowerI(0.0, 0.0);
    root.y = root.x;
    if (!all(M8FlowerIsFinite(float3(abc.x.lo, abc.y.lo, abc.z.lo))) ||
        !all(M8FlowerIsFinite(float3(abc.x.hi, abc.y.hi, abc.z.hi))) ||
        abc.x.lo > abc.x.hi || abc.y.lo > abc.y.hi || abc.z.lo > abc.z.hi)
        return M8_FLOWER_ROOT_AMBIGUOUS;
    uint classification = M8FlowerClassifyRoot(abc);
    if (classification != M8_FLOWER_ROOT_CERTAIN_SECANT &&
        classification != M8_FLOWER_ROOT_CERTAIN_TANGENT) return classification;
    M8FlowerInterval q = M8FlowerIAdd(M8FlowerISquare(abc.y),
        M8FlowerISquare(abc.z));
    M8FlowerInterval minusA = M8FlowerI(-abc.x.hi, -abc.x.lo);
    M8FlowerInterval x = M8FlowerIMul(minusA, abc.y);
    M8FlowerInterval y = M8FlowerIMul(minusA, abc.z);
    // Exact singleton tangency was established by dyadic equality, so no
    // uncertain subtraction around delta=0 is used to invent a second root.
    if (classification == M8_FLOWER_ROOT_CERTAIN_SECANT)
    {
        M8FlowerInterval delta = M8FlowerISub(q, M8FlowerISquare(abc.x));
        M8FlowerInterval turn = M8FlowerI(0.0, 0.0);
        if (!M8FlowerISqrt(delta, turn)) return M8_FLOWER_ROOT_AMBIGUOUS;
        if (!plusRoot) turn = M8FlowerI(-turn.hi, -turn.lo);
        x = M8FlowerIAdd(x, M8FlowerIMul(turn, M8FlowerI(-abc.z.hi, -abc.z.lo)));
        y = M8FlowerIAdd(y, M8FlowerIMul(turn, abc.y));
    }
    bool valid=true;
    [loop]for(uint axis=0u;axis<2u;axis++)
    {
        M8FlowerInterval numerator=axis==0u?x:y;
        M8FlowerInterval component;
        bool componentValid=M8FlowerIDivPositive(numerator,q,component);
        if(axis==0u)root.x=component;else root.y=component;
        valid=valid && componentValid;
    }
    if(!valid)return M8_FLOWER_ROOT_AMBIGUOUS;
    return classification;
}

M8FlowerInterval M8FlowerICross(M8FlowerInterval2 a, M8FlowerInterval2 b)
{
    return M8FlowerISub(M8FlowerIMul(a.x, b.y), M8FlowerIMul(a.y, b.x));
}

bool M8FlowerRootSector(uint lineClass, M8FlowerInterval2 root, out uint sector)
{
    sector = 0xffffffffu;
    if (lineClass >= M8_FLOWER_LINE_CLASS_COUNT) return false;
    uint3 meta = M8FlowerLineMeta[lineClass];
    [loop]
    for (uint candidate = 0u; candidate < meta.z; candidate++)
    {
        float4 a = M8FlowerSectorBounds[meta.y + candidate];
        uint next = candidate + 1u == meta.z ? 0u : candidate + 1u;
        float4 b = M8FlowerSectorBounds[meta.y + next];
        M8FlowerInterval2 start, end;
        start.x = M8FlowerI(a.x, a.y); start.y = M8FlowerI(a.z, a.w);
        end.x = M8FlowerI(b.x, b.y); end.y = M8FlowerI(b.z, b.w);
        if (M8FlowerICross(start, root).lo > 0.0 &&
            M8FlowerICross(root, end).lo > 0.0)
        {
            if (sector != 0xffffffffu) { sector = 0xffffffffu; return false; }
            sector = candidate;
        }
    }
    return sector != 0xffffffffu;
}

int3 M8FlowerOverlapDelta(uint ordinal)
{
    return int3(ordinal & 1u, (ordinal >> 1u) & 1u, (ordinal >> 2u) & 1u);
}

uint M8FlowerOverlapBoundaryMask(int3 firstOwner, uint shift)
{
    uint mask = (1u << shift) - 1u;
    bool3 crosses = (asuint(firstOwner) & mask) == mask;
    return (crosses.x ? 1u : 0u) | (crosses.y ? 2u : 0u) |
        (crosses.z ? 4u : 0u);
}

int3 M8FlowerJunction(int3 kernel, int3 direction)
{
    return kernel * 2 + direction;
}

uint M8FlowerJunctionParity(int3 junction)
{
    uint3 u = asuint(junction);
    return (u.x & 1u) + (u.y & 1u) + (u.z & 1u);
}

bool M8FlowerEndpointPair(int3 junction, uint lineClass,
    out int3 first, out int3 second)
{
    int3 direction = M8FlowerLineDirection[lineClass];
    int3 doubled = junction-direction;
    if (any((asuint(doubled) & 1u) != 0u))
    {
        first = 0;
        second = 0;
        return false;
    }
    first = doubled >> 1;
    second = first+direction;
    return true;
}

float M8FlowerLevelStep(uint level)
{
    return M8_FLOWER_LATTICE_STEP / float(1u << level);
}

bool M8FlowerRoot(float3 abc, bool plusRoot, out float2 root)
{
    precise float q = abc.y*abc.y+abc.z*abc.z;
    precise float delta = q-abc.x*abc.x;
    if (!(q > 0.0) || delta < 0.0) { root = 0.0.xx; return false; }
    precise float d = sqrt(delta);
    precise float s = plusRoot ? 1.0 : -1.0;
    root = float2((-abc.x*abc.y + s*d*-abc.z)/q,
        (-abc.x*abc.z + s*d*abc.y)/q);
    return true;
}

bool M8FlowerTauInterval(M8FlowerInterval2 from, M8FlowerInterval2 to,
    out M8FlowerInterval turn)
{
    M8FlowerInterval denominator = M8FlowerIAdd(M8FlowerI(1.0,1.0),
        M8FlowerIAdd(M8FlowerIMul(from.x,to.x),
            M8FlowerIMul(from.y,to.y)));
    return M8FlowerIDivPositive(M8FlowerICross(from,to),denominator,turn);
}

bool M8FlowerSealBend(M8FlowerInterval2 first, M8FlowerInterval2 second,
    uint lineClass, out M8FlowerInterval2 seal, out M8FlowerInterval bend,
    out uint sector)
{
    seal.x = M8FlowerI(0.0,0.0);
    seal.y = M8FlowerI(0.0,0.0);
    bend = M8FlowerI(0.0,0.0);
    sector = 0u;
    uint secondSector;
    if (!M8FlowerRootSector(lineClass,first,sector) ||
        !M8FlowerRootSector(lineClass,second,secondSector) ||
        sector != secondSector) return false;
    M8FlowerInterval x = M8FlowerIAdd(first.x,second.x);
    M8FlowerInterval y = M8FlowerIAdd(first.y,second.y);
    M8FlowerInterval length;
    if (!M8FlowerISqrt(M8FlowerIAdd(M8FlowerISquare(x),
            M8FlowerISquare(y)),length) || !(length.lo > 0.0))return false;
    [loop]for(uint axis=0u;axis<2u;axis++)
    {
        M8FlowerInterval numerator=axis==0u?x:y;
        M8FlowerInterval component;
        bool valid=M8FlowerIDivPositive(numerator,length,component);
        if(axis==0u)seal.x=component;else seal.y=component;
        if(!valid)return false;
    }
    uint sharedSector;
    if (!M8FlowerRootSector(lineClass,seal,sharedSector) ||
        sharedSector != sector) return false;
    // Contract 9.1: qB is the turn from the shared seal to the SECOND
    // endpoint, not the full first-to-second phase displacement.
    return M8FlowerTauInterval(seal,second,bend);
}

bool M8FlowerRotateInterval(M8FlowerInterval2 prediction,
    M8FlowerInterval turn, uint lineClass, uint sector,
    out M8FlowerInterval2 root)
{
    root.x = M8FlowerI(0.0,0.0);
    root.y = M8FlowerI(0.0,0.0);
    uint predictedSector;
    if (!M8FlowerRootSector(lineClass,prediction,predictedSector) ||
        predictedSector != sector) return false;
    M8FlowerInterval squared = M8FlowerISquare(turn);
    M8FlowerInterval denominator = M8FlowerIAdd(M8FlowerI(1.0,1.0),squared);
    M8FlowerInterval c,s;
    c=M8FlowerI(0.0,0.0);s=c;
    [loop]for(uint axis=0u;axis<2u;axis++)
    {
        M8FlowerInterval numerator=axis==0u?
            M8FlowerISub(M8FlowerI(1.0,1.0),squared):
            M8FlowerIMul(M8FlowerI(2.0,2.0),turn);
        M8FlowerInterval component;
        if(!M8FlowerIDivPositive(numerator,denominator,component))return false;
        if(axis==0u)c=component;else s=component;
    }
    root.x = M8FlowerISub(M8FlowerIMul(c,prediction.x),
        M8FlowerIMul(s,prediction.y));
    root.y = M8FlowerIAdd(M8FlowerIMul(s,prediction.x),
        M8FlowerIMul(c,prediction.y));
    uint synthesizedSector;
    return M8FlowerRootSector(lineClass,root,synthesizedSector) &&
        synthesizedSector == sector;
}

bool M8FlowerTau(float2 from, float2 to, out float turn)
{
    precise float denominator = 1.0+dot(from,to);
    if (denominator == 0.0) { turn = 0.0; return false; }
    turn = (from.x*to.y-from.y*to.x)/denominator;
    return true;
}

float2 M8FlowerRotate(float2 root, float turn)
{
    precise float rr = turn*turn;
    precise float inverse = 1.0/(1.0+rr);
    precise float c = (1.0-rr)*inverse;
    precise float s = 2.0*turn*inverse;
    return float2(c*root.x-s*root.y,s*root.x+c*root.y);
}

#define M8_FLOWER_PHASE_IMPOSSIBLE 0u
#define M8_FLOWER_PHASE_EXACT_ZERO 1u
#define M8_FLOWER_PHASE_CERTAIN_NONZERO 2u
#define M8_FLOWER_PHASE_AMBIGUOUS 3u
#define M8_FLOWER_PHASE_PROMOTE 4u

struct M8FlowerPhaseRootEvidence
{
    int3 Junction;
    uint Tag;
    M8FlowerInterval2 Root;
    uint Classification; // ProofClassification: impossible=0,certain=1,ambiguous=2
};

struct M8FlowerPhaseResidualResult
{
    uint Classification;
    M8FlowerInterval Residual;
    M8FlowerInterval2 Synthesis;
    int Lower;
    int Upper;
};

M8FlowerPhaseResidualResult M8FlowerPhaseResult(uint classification)
{
    M8FlowerPhaseResidualResult result;
    result.Classification=classification;
    result.Residual=M8FlowerI(0.0,0.0);
    result.Synthesis.x=M8FlowerI(0.0,0.0);
    result.Synthesis.y=result.Synthesis.x;
    result.Lower=0;
    result.Upper=0;
    return result;
}

bool M8FlowerFinitePhaseRoot(M8FlowerInterval2 root)
{
    return all(M8FlowerIsFinite(float4(root.x.lo,root.x.hi,root.y.lo,root.y.hi))) &&
        root.x.lo<=root.x.hi && root.y.lo<=root.y.hi;
}

bool M8FlowerPhaseIdentityValid(M8FlowerPhaseRootEvidence evidence)
{
    uint level=evidence.Tag&7u;
    uint lineClass=(evidence.Tag>>3u)&15u;
    uint sector=(evidence.Tag>>8u)&31u;
    if (level>=3u || lineClass>=M8_FLOWER_LINE_CLASS_COUNT ||
        ((evidence.Tag>>17u)&7u)>5u || !M8FlowerFinitePhaseRoot(evidence.Root))
        return false;
    return sector<M8FlowerLineMeta[lineClass].z &&
        all(((asuint(evidence.Junction)^asuint(M8FlowerLineDirection[lineClass]))&
            1u)==0u);
}

struct M8FlowerPhaseTransportTerm
{
    int Lower;
    int Upper;
    int Orientation;
    uint AncestorLevel;
};

bool M8FlowerTryReadR2Phase(M8FlowerDetailRecord record, uint expectedKey,
    uint currentParentEpoch, out int lower, out int upper)
{
    lower=0;
    upper=0;
    if (currentParentEpoch==0u || record.ParentEpoch!=currentParentEpoch ||
        record.Key!=expectedKey || record.Lower>record.Upper ||
        (record.Lower<=0 && record.Upper>=0) || (expectedKey>>25u)!=0u)
        return false;
    uint level=expectedKey&3u;
    uint path=(expectedKey>>M8_FLOWER_DETAIL_CHILD_PATH_SHIFT)&15u;
    uint petal=(expectedKey>>M8_FLOWER_DETAIL_PETAL_SHIFT)&63u;
    uint channel=(expectedKey>>M8_FLOWER_DETAIL_CHANNEL_SHIFT)&15u;
    uint kind=(expectedKey>>M8_FLOWER_DETAIL_KIND_SHIFT)&7u;
    uint sector=(expectedKey>>M8_FLOWER_DETAIL_SECTOR_SHIFT)&31u;
    if (level>=M8_FLOWER_GEOMETRY_LEVEL_COUNT || path>=(1u<<(2u*level)) ||
        petal>=M8_FLOWER_PETAL_CLASS_COUNT || channel>=M8_FLOWER_LINE_CLASS_COUNT ||
        kind!=0u) return false;
    if (sector>=M8FlowerLineMeta[channel].z) return false;
    // Storage validates the exact key/epoch only. Generated channel incidence
    // supplies transport; these persistent Q2.29 endpoints remain unchanged.
    lower=record.Lower;
    upper=record.Upper;
    return true;
}

float M8FlowerDecodePhaseEndpoint(int value, bool upper)
{
    uint magnitude=value<0 ? 0u-asuint(value) : asuint(value);
    precise float roundedMagnitude=(float)magnitude;
    uint representedMagnitude=(uint)roundedMagnitude;
    precise float endpoint=(value<0 ? -roundedMagnitude : roundedMagnitude)*
        (1.0/536870912.0);
    bool roundedBelow=value<0 ? representedMagnitude>magnitude :
        representedMagnitude<magnitude;
    bool roundedAbove=value<0 ? representedMagnitude<magnitude :
        representedMagnitude>magnitude;
    if (upper && roundedBelow) return M8FlowerNext(endpoint);
    if (!upper && roundedAbove) return M8FlowerPrevious(endpoint);
    return endpoint;
}

M8FlowerInterval M8FlowerDecodePhaseInterval(int lower, int upper)
{
    return M8FlowerI(M8FlowerDecodePhaseEndpoint(lower,false),
        M8FlowerDecodePhaseEndpoint(upper,true));
}

// Section 10.2: childCarrierAbc is R1 restricted to the exact generated
// child loop. Terms come only from its generated ancestor-channel mapping.
// Runtime never searches mappings and neither halves phase nor includes V.
uint M8FlowerPredictChildPhase(uint childGeometryLevel, M8FlowerInterval3 childCarrierAbc,
    uint childLineClass, uint childSector, bool rootSign,
    M8FlowerPhaseTransportTerm ancestry[2], uint ancestorCount,
    out M8FlowerInterval2 prediction)
{
    prediction.x=M8FlowerI(0.0,0.0);
    prediction.y=prediction.x;
    if (childGeometryLevel==0u || childGeometryLevel>=M8_FLOWER_GEOMETRY_LEVEL_COUNT ||
        ancestorCount>childGeometryLevel || childLineClass>=M8_FLOWER_LINE_CLASS_COUNT ||
        childSector>=M8FlowerLineMeta[childLineClass].z) return 2u;
    uint previousLevel=0u;
    [loop] for (uint i=0u;i<2u;++i)
    {
        if (i>=ancestorCount) break;
        M8FlowerPhaseTransportTerm term=ancestry[i];
        if (term.Lower>term.Upper ||
            (term.Lower<=0 && term.Upper>=0 && (term.Lower!=0 || term.Upper!=0)) ||
            (term.Orientation!=1 && term.Orientation!=-1) ||
            term.AncestorLevel>=childGeometryLevel ||
            (i!=0u && term.AncestorLevel<=previousLevel)) return 2u;
        previousLevel=term.AncestorLevel;
    }
    M8FlowerInterval2 current;
    uint rootClass=M8FlowerRootInterval(childCarrierAbc,rootSign,current);
    if (rootClass==M8_FLOWER_ROOT_IMPOSSIBLE) return 0u;
    if (rootClass!=M8_FLOWER_ROOT_CERTAIN_SECANT &&
        rootClass!=M8_FLOWER_ROOT_CERTAIN_TANGENT) return 2u;
    uint sector;
    if (!M8FlowerFinitePhaseRoot(current) ||
        !M8FlowerRootSector(childLineClass,current,sector) ||
        sector!=childSector) return 2u;
    [loop] for (uint i=0u;i<2u;++i)
    {
        if (i>=ancestorCount) break;
        M8FlowerPhaseTransportTerm term=ancestry[i];
        if (term.Lower==0 && term.Upper==0) continue;
        M8FlowerInterval turn=M8FlowerDecodePhaseInterval(term.Lower,term.Upper);
        if (term.Orientation<0) turn=M8FlowerI(-turn.hi,-turn.lo);
        M8FlowerInterval2 rotated;
        if (!M8FlowerRotateInterval(current,turn,childLineClass,childSector,rotated) ||
            !M8FlowerFinitePhaseRoot(rotated))
            return 2u;
        current=rotated;
    }
    prediction=current;
    return 1u;
}

M8FlowerPhaseRootEvidence M8FlowerCopyInheritedPhase(M8FlowerPhaseRootEvidence parent)
{
    // Keep root interval and draw identity bit-identical. Do not recompute
    // even the base root of an inherited 2A/2B/2C child address.
    return parent;
}

int3 M8FlowerPhaseParentNode(uint petalClass, uint parentContext, uint node)
{
    uint3 nodes=M8FlowerPetalNodes[petalClass].xyz;
    if (parentContext==0u) return M8FlowerNode[nodes[node]].xyz;
    uint packed=M8FlowerChildPetal[parentContext-1u][node];
    int3 weights=int3(packed&3u,(packed>>2u)&3u,(packed>>4u)&3u);
    return weights.x*M8FlowerNode[nodes.x].xyz+
        weights.y*M8FlowerNode[nodes.y].xyz+
        weights.z*M8FlowerNode[nodes.z].xyz;
}

bool M8FlowerPhaseJunction(int3 rootOwner, uint shift, int3 generatedOffset,
    out int3 junction)
{
    junction=0;
    if (shift==0u || shift>3u) return false;
    int scale=1<<shift;
    int3 minimumOwner=(asint(0x80000000u)>>shift)-(generatedOffset>>shift);
    int3 maximumOwner=(2147483647>>shift)+((scale-1-generatedOffset)>>shift);
    if (any(rootOwner<minimumOwner) || any(rootOwner>maximumOwner)) return false;
    junction=asint((asuint(rootOwner)<<shift)+asuint(generatedOffset));
    return true;
}

bool M8FlowerTryGetChildPhaseLoop(uint petalClass, uint parentContext, uint knotSite,
    out uint level, out int3 junctionOffset, out uint lineClass, out uint strandClass,
    out int endpointOrientation, out int phaseOrientation, out int inheritedParentNode)
{
    level=0u;
    lineClass=0u;
    strandClass=0u;
    junctionOffset=0;
    endpointOrientation=0;
    phaseOrientation=0;
    inheritedParentNode=-1;
    if (petalClass>=M8_FLOWER_PETAL_CLASS_COUNT || parentContext>=5u || knotSite>=6u)
        return false;
    uint3 nodes=M8FlowerPetalNodes[petalClass].xyz;
    if (knotSite<3u)
    {
        inheritedParentNode=(int)knotSite;
        uint packed=parentContext==0u ? 2u<<(2u*knotSite) :
            M8FlowerChildPetal[parentContext-1u][knotSite];
        uint3 weights=uint3(packed&3u,(packed>>2u)&3u,(packed>>4u)&3u);
        int rootNode=weights.x==2u ? 0 : weights.y==2u ? 1 : weights.z==2u ? 2 : -1;
        if (rootNode>=0)
        {
            uint sourceNode=nodes[rootNode];
            int4 source=M8FlowerNode[sourceNode];
            junctionOffset=source.xyz;
            lineClass=(uint)source.w;
            endpointOrientation=M8FlowerDirectionMeta[sourceNode].x;
            return true;
        }
        uint edge=weights.x==0u ? 1u : weights.z==0u ? 0u : 2u;
        strandClass=M8FlowerPetalStrands[petalClass][edge];
        uint4 strand=M8FlowerStrand[strandClass];
        M8FlowerPhaseFamilyRule family=M8FlowerGetPhaseFamily(strandClass);
        level=1u;
        junctionOffset=M8FlowerNode[strand.x].xyz+M8FlowerNode[strand.y].xyz;
        lineClass=(uint)M8FlowerNode[family.RootNode].w;
        endpointOrientation=M8FlowerDirectionMeta[family.RootNode].x;
        return true;
    }
    uint localEdge=knotSite-3u;
    uint familyEdge=localEdge;
    int endpoint=1;
    int childPhase=1;
    if (parentContext!=0u)
    {
        M8FlowerChildPhaseEdgeRule child=M8FlowerGetChildPhaseEdge(parentContext-1u,localEdge);
        familyEdge=child.Family;
        endpoint=child.EndpointOrientation;
        childPhase=child.PhaseOrientation;
    }
    strandClass=M8FlowerPetalStrands[petalClass][familyEdge];
    M8FlowerPhaseFamilyRule rule=M8FlowerGetPhaseFamily(strandClass);
    level=parentContext==0u ? 1u : 2u;
    uint first=localEdge==1u ? 1u : 0u;
    uint second=localEdge==0u ? 1u : 2u;
    junctionOffset=M8FlowerPhaseParentNode(petalClass,parentContext,first)+
        M8FlowerPhaseParentNode(petalClass,parentContext,second);
    lineClass=(uint)M8FlowerNode[rule.RootNode].w;
    endpointOrientation=M8FlowerDirectionMeta[rule.RootNode].x*endpoint;
    phaseOrientation=rule.PhaseOrientation*childPhase;
    return true;
}

uint M8FlowerPredictChildFromFamily(int3 rootOwner, uint petalClass,
    uint parentContext, uint knotSite, float3 decodedNormal, float decodedOffset,
    float normalUncertainty, float offsetUncertainty, uint childSector, bool plusRoot,
    M8FlowerPhaseRootEvidence parentRoots[3], M8FlowerPhaseRootEvidence ancestorRoots[2],
    M8FlowerDetailRecord ancestorRecords[2], uint ancestorKeys[2], uint ancestorCount,
    uint currentParentEpoch, out M8FlowerPhaseRootEvidence prediction)
{
    prediction=(M8FlowerPhaseRootEvidence)0;
    uint level,lineClass,strandClass;
    int3 offset,junction;
    int endpoint,phase,inherited;
    if (!M8FlowerTryGetChildPhaseLoop(petalClass,parentContext,knotSite,
        level,offset,lineClass,strandClass,endpoint,phase,inherited) ||
        !M8FlowerPhaseJunction(rootOwner,level+1u,offset,junction)) return 2u;
    if (inherited>=0)
    {
        M8FlowerPhaseRootEvidence source=parentRoots[inherited];
        if (!M8FlowerPhaseIdentityValid(source) || (source.Tag&7u)!=level ||
            ((source.Tag>>3u)&15u)!=lineClass || any(source.Junction!=junction)) return 2u;
        prediction=M8FlowerCopyInheritedPhase(source);
        return prediction.Classification;
    }
    if (!all(M8FlowerIsFinite(decodedNormal)) || !M8FlowerIsFinite(decodedOffset) ||
        !M8FlowerIsFinite(normalUncertainty) || !M8FlowerIsFinite(offsetUncertainty) ||
        normalUncertainty<0.0 || offsetUncertainty<0.0 || ancestorCount>level ||
        (ancestorCount!=0u && currentParentEpoch==0u)) return 2u;

    M8FlowerPhaseFamilyRule family=M8FlowerGetPhaseFamily(strandClass);
    int4 sourceNode=M8FlowerNode[family.RootNode];
    uint4 strand=M8FlowerStrand[strandClass];
    if (M8FlowerLineMeta[(uint)sourceNode.w].x!=2u && ancestorCount!=0u) return 2u;
    M8FlowerPhaseTransportTerm terms[2];
    terms[0]=(M8FlowerPhaseTransportTerm)0;
    terms[1]=terms[0];
    uint previousLevel=0u;
    [unroll] for (uint i=0u;i<2u;++i)
    {
        if (i>=ancestorCount) break;
        uint key=ancestorKeys[i];
        int lower,upper;
        if (!M8FlowerTryReadR2Phase(ancestorRecords[i],key,currentParentEpoch,lower,upper))
            return 2u;
        uint sourceLevel=key&3u;
        M8FlowerPhaseRootEvidence source=ancestorRoots[i];
        uint keyChannel=(key>>M8_FLOWER_DETAIL_CHANNEL_SHIFT)&15u;
        uint keySector=(key>>M8_FLOWER_DETAIL_SECTOR_SHIFT)&31u;
        uint keyRoot=(key>>M8_FLOWER_DETAIL_ROOT_SHIFT)&1u;
        uint keyPath=(key>>M8_FLOWER_DETAIL_CHILD_PATH_SHIFT)&15u;
        uint keyPetal=(key>>M8_FLOWER_DETAIL_PETAL_SHIFT)&63u;
        if ((i!=0u && sourceLevel<=previousLevel) || sourceLevel>=level ||
            !M8FlowerPhaseIdentityValid(source) || source.Classification!=1u ||
            (source.Tag&7u)!=sourceLevel || ((source.Tag>>3u)&15u)!=lineClass ||
            keyChannel!=lineClass || keySector!=((source.Tag>>8u)&31u) ||
            keyRoot!=((source.Tag>>7u)&1u)) return 2u;
        previousLevel=sourceLevel;
        int3 sourceOffset;
        int orientation;
        if (sourceLevel==0u)
        {
            if (keyPath!=0u ||
                (family.RootIncidentPetals[keyPetal>>5u]&(1u<<(keyPetal&31u)))==0u)
                return 2u;
            sourceOffset=sourceNode.xyz;
            orientation=phase;
        }
        else
        {
            int path=keyPetal==(strand.w&255u) ? (int)family.FinePath0 :
                keyPetal==((strand.w>>8u)&255u) ? (int)family.FinePath1 : -1;
            if (path<0 || keyPath!=(uint)path) return 2u;
            sourceOffset=M8FlowerNode[strand.x].xyz+M8FlowerNode[strand.y].xyz;
            M8FlowerChildPhaseEdgeRule child=M8FlowerGetChildPhaseEdge(parentContext-1u,knotSite-3u);
            orientation=child.PhaseOrientation;
        }
        int3 sourceJunction;
        if (!M8FlowerPhaseJunction(rootOwner,sourceLevel+1u,sourceOffset,sourceJunction) ||
            any(source.Junction!=sourceJunction)) return 2u;
        terms[i].Lower=lower;
        terms[i].Upper=upper;
        terms[i].Orientation=orientation;
        terms[i].AncestorLevel=sourceLevel;
    }
    precise float halfStep=0.5*M8FlowerLevelStep(level);
    precise float3 relative=halfStep*(float3)offset;
    float radius=M8FlowerGeometryLoopRadius[level*M8_FLOWER_LINE_CLASS_COUNT+lineClass];
    M8FlowerInterval3 abc;
    if (!M8FlowerPlaneIntervals(decodedNormal,decodedOffset,relative,radius,lineClass,
        normalUncertainty,offsetUncertainty,abc)) return 2u;
    M8FlowerInterval2 root;
    uint classification=M8FlowerPredictChildPhase(level,abc,lineClass,childSector,plusRoot,
        terms,ancestorCount,root);
    if (classification!=1u) return classification;
    prediction.Junction=junction;
    prediction.Tag=M8FlowerPackSymbolTag(level,lineClass,plusRoot,childSector,
        endpoint<0,0u,0u,0u);
    prediction.Root=root;
    prediction.Classification=1u;
    return 1u;
}

uint M8FlowerSynthesizePhaseRecord(M8FlowerPhaseRootEvidence prediction,
    uint expectedKey, M8FlowerDetailRecord record, uint parentEpoch,
    out M8FlowerPhaseRootEvidence synthesis)
{
    synthesis=prediction;
    synthesis.Classification=2u;
    uint lineClass=(prediction.Tag>>3u)&15u;
    uint sector=(prediction.Tag>>8u)&31u;
    int lower,upper;
    if (prediction.Classification!=1u || !M8FlowerPhaseIdentityValid(prediction) ||
        (expectedKey&3u)!=(prediction.Tag&7u) ||
        ((expectedKey>>M8_FLOWER_DETAIL_CHANNEL_SHIFT)&15u)!=lineClass ||
        ((expectedKey>>M8_FLOWER_DETAIL_SECTOR_SHIFT)&31u)!=sector ||
        ((expectedKey>>M8_FLOWER_DETAIL_ROOT_SHIFT)&1u)!=
            ((prediction.Tag>>7u)&1u) ||
        !M8FlowerTryReadR2Phase(record,expectedKey,parentEpoch,lower,upper)) return 2u;
    M8FlowerInterval2 root;
    if (!M8FlowerRotateInterval(prediction.Root,
            M8FlowerDecodePhaseInterval(lower,upper),lineClass,sector,root) ||
        !M8FlowerFinitePhaseRoot(root)) return 2u;
    synthesis.Root=root;
    synthesis.Classification=1u;
    return 1u;
}

uint M8FlowerSealPhaseRelation(M8FlowerPhaseRootEvidence first,
    M8FlowerPhaseRootEvidence second, out M8FlowerPhaseRootEvidence relation,
    out M8FlowerInterval bend)
{
    relation=(M8FlowerPhaseRootEvidence)0;
    bend=M8FlowerI(0.0,0.0);
    if (first.Classification!=1u || second.Classification!=1u ||
        !M8FlowerPhaseIdentityValid(first) ||
        !M8FlowerPhaseIdentityValid(second)) return 2u;
    if (any(first.Junction!=second.Junction) ||
        (first.Tag&0x1fffu)!=(second.Tag&0x1fffu)) return 0u;
    M8FlowerInterval2 root;
    uint sector;
    if (!M8FlowerSealBend(first.Root,second.Root,(first.Tag>>3u)&15u,
            root,bend,sector) || sector!=((first.Tag>>8u)&31u)) return 2u;
    relation.Junction=first.Junction;
    relation.Tag=first.Tag&0x1fffu;
    relation.Root=root;
    relation.Classification=1u;
    return 1u;
}

// Intersect only FINAL roots claiming the same physical knot. Different
// parent-local predictions and residual programs are intentionally legal.
uint M8FlowerCloseSharedPhaseRoot(M8FlowerPhaseRootEvidence first,
    M8FlowerPhaseRootEvidence second, out M8FlowerPhaseRootEvidence closedRoot)
{
    closedRoot=first;
    closedRoot.Classification=2u;
    if (first.Classification!=1u || second.Classification!=1u ||
        !M8FlowerPhaseIdentityValid(first) ||
        !M8FlowerPhaseIdentityValid(second)) return 2u;
    if (any(first.Junction!=second.Junction) ||
        (first.Tag&0x1fffu)!=(second.Tag&0x1fffu)) return 0u;
    float2 lower=max(float2(first.Root.x.lo,first.Root.y.lo),
        float2(second.Root.x.lo,second.Root.y.lo));
    float2 upper=min(float2(first.Root.x.hi,first.Root.y.hi),
        float2(second.Root.x.hi,second.Root.y.hi));
    if (any(lower>upper)) return 0u;
    M8FlowerInterval2 root;
    root.x=M8FlowerI(lower.x,upper.x);
    root.y=M8FlowerI(lower.y,upper.y);
    uint sector;
    if (!M8FlowerRootSector((first.Tag>>3u)&15u,root,sector) ||
        sector!=((first.Tag>>8u)&31u)) return 2u;
    closedRoot.Tag=first.Tag&0x1fffu;
    closedRoot.Root=root;
    closedRoot.Classification=1u;
    return 1u;
}

bool M8FlowerEncodePhaseResidual(M8FlowerInterval residual,
    out int lower, out int upper)
{
    precise float lo=floor(residual.lo*536870912.0);
    precise float hi=ceil(residual.hi*536870912.0);
    lower=0;
    upper=0;
    if (!(lo>=-2147483648.0) || !(hi<2147483648.0) || lo>hi)
        return false;
    lower=(int)lo;
    upper=(int)hi;
    return true;
}

M8FlowerPhaseResidualResult M8FlowerAnalyzePhaseResidual(
    M8FlowerPhaseRootEvidence predicted, M8FlowerPhaseRootEvidence observed)
{
    M8FlowerPhaseResidualResult result=M8FlowerPhaseResult(
        M8_FLOWER_PHASE_AMBIGUOUS);
    if (predicted.Classification==0u || observed.Classification==0u)
        return M8FlowerPhaseResult(M8_FLOWER_PHASE_IMPOSSIBLE);
    if (predicted.Classification!=1u || observed.Classification!=1u ||
        !M8FlowerPhaseIdentityValid(predicted) ||
        !M8FlowerPhaseIdentityValid(observed)) return result;

    uint pLine=(predicted.Tag>>3u)&15u;
    uint oLine=(observed.Tag>>3u)&15u;
    uint pSector,oSector;
    if (!M8FlowerRootSector(pLine,predicted.Root,pSector) ||
        !M8FlowerRootSector(oLine,observed.Root,oSector)) return result;
    if (any(predicted.Junction!=observed.Junction) ||
        (predicted.Tag&0x1fffu)!=(observed.Tag&0x1fffu) ||
        pSector!=((predicted.Tag>>8u)&31u) ||
        oSector!=((observed.Tag>>8u)&31u))
        return M8FlowerPhaseResult(M8_FLOWER_PHASE_IMPOSSIBLE);

    // Exact cross(u,u)=0 only for singleton claims. Equal non-singleton
    // enclosures do not prove that the two physical values coincide.
    if (predicted.Root.x.lo==predicted.Root.x.hi &&
        predicted.Root.y.lo==predicted.Root.y.hi &&
        observed.Root.x.lo==observed.Root.x.hi &&
        observed.Root.y.lo==observed.Root.y.hi &&
        predicted.Root.x.lo==observed.Root.x.lo &&
        predicted.Root.y.lo==observed.Root.y.lo)
    {
        result.Classification=M8_FLOWER_PHASE_EXACT_ZERO;
        result.Synthesis=predicted.Root;
        return result;
    }

    // Prediction and observation are differenced, NEVER intersected.
    if (!M8FlowerTauInterval(predicted.Root,observed.Root,result.Residual) ||
        !all(M8FlowerIsFinite(float2(result.Residual.lo,result.Residual.hi))))
        return result;
    if (result.Residual.lo==0.0 && result.Residual.hi==0.0)
    {
        result.Classification=M8_FLOWER_PHASE_EXACT_ZERO;
        result.Synthesis=predicted.Root;
        return result;
    }
    if (result.Residual.lo<=0.0 && result.Residual.hi>=0.0) return result;
    if (!M8FlowerEncodePhaseResidual(result.Residual,result.Lower,result.Upper))
    {
        result.Classification=M8_FLOWER_PHASE_PROMOTE;
        return result;
    }
    // Nonzero evidence below fixed-point resolution is not a persistable
    // nonzero interval. Do not round it away from zero or store false detail.
    if (result.Lower<=0 && result.Upper>=0)
    {
        result.Lower=0;
        result.Upper=0;
        return result;
    }

    // Sector admission encloses the Q2.29 interval actually persisted.
    M8FlowerInterval stored=M8FlowerDecodePhaseInterval(result.Lower,result.Upper);
    if (M8FlowerRotateInterval(predicted.Root,stored,pLine,pSector,result.Synthesis))
    {
        result.Classification=M8_FLOWER_PHASE_CERTAIN_NONZERO;
        return result;
    }
    uint synthesizedSector;
    if (M8FlowerFinitePhaseRoot(result.Synthesis) &&
        M8FlowerRootSector(pLine,result.Synthesis,synthesizedSector) &&
        synthesizedSector!=pSector)
        result.Classification=M8_FLOWER_PHASE_PROMOTE;
    result.Lower=0;
    result.Upper=0;
    return result;
}

M8FlowerPhaseResidualResult M8FlowerAnalyzeR3PhaseResidual(
    M8FlowerPhaseRootEvidence predicted, M8FlowerPhaseRootEvidence observed,
    uint parity, uint axis)
{
    if (parity>=8u || axis>=4u)
        return M8FlowerPhaseResult(M8_FLOWER_PHASE_AMBIGUOUS);
    M8FlowerPhaseResidualResult result=M8FlowerAnalyzePhaseResidual(predicted,observed);
    if (result.Classification!=M8_FLOWER_PHASE_CERTAIN_NONZERO &&
        result.Classification!=M8_FLOWER_PHASE_EXACT_ZERO) return result;
    uint lineClass=(predicted.Tag>>3u)&15u;
    if (M8FlowerTetraLine[parity][axis]!=(int)lineClass)
        return M8FlowerPhaseResult(M8_FLOWER_PHASE_IMPOSSIBLE);
    if (M8FlowerTetraEta[parity][axis]>0 ||
        result.Classification==M8_FLOWER_PHASE_EXACT_ZERO) return result;
    result.Residual=M8FlowerI(-result.Residual.hi,-result.Residual.lo);
    if (!M8FlowerEncodePhaseResidual(result.Residual,result.Lower,result.Upper))
        result.Classification=M8_FLOWER_PHASE_PROMOTE;
    return result;
}

void M8FlowerTetraForwardIntervals(M8FlowerInterval q[4],
    out M8FlowerInterval scalar, out M8FlowerInterval3 tetraVector)
{
    scalar=M8FlowerIMul(M8FlowerIAdd(M8FlowerIAdd(M8FlowerIAdd(q[0],q[1]),
        q[2]),q[3]),M8FlowerI(0.25,0.25));
    M8FlowerInterval unit=M8FlowerI(M8FlowerTetraUnitBounds.x,
        M8FlowerTetraUnitBounds.y);
    M8FlowerInterval components[3];
    [unroll] for (uint axis=0u;axis<3u;axis++)
    {
        M8FlowerInterval component=M8FlowerI(0.0,0.0);
        [unroll] for (uint i=0u;i<4u;i++)
        {
            M8FlowerInterval direction=unit;
            if (M8FlowerTetraAxis[i][axis]<0.0)
                direction=M8FlowerI(-unit.hi,-unit.lo);
            M8FlowerInterval term=M8FlowerIMul(q[i],direction);
            if (i==0u) component=term;
            else component=M8FlowerIAdd(component,term);
        }
        components[axis]=M8FlowerIMul(component,M8FlowerI(0.75,0.75));
    }
    tetraVector.x=components[0];
    tetraVector.y=components[1];
    tetraVector.z=components[2];
}

float4 M8FlowerTetraForward(float4 q)
{
    precise float scalar = 0.25*(q.x+q.y+q.z+q.w);
    precise float3 tetraVector = 0.75*(q.x*M8FlowerTetraAxis[0]+
        q.y*M8FlowerTetraAxis[1]+q.z*M8FlowerTetraAxis[2]+
        q.w*M8FlowerTetraAxis[3]);
    return float4(scalar,tetraVector);
}

float4 M8FlowerTetraInverse(float scalar, float3 tetraVector)
{
    return float4(scalar+dot(M8FlowerTetraAxis[0],tetraVector),
        scalar+dot(M8FlowerTetraAxis[1],tetraVector),
        scalar+dot(M8FlowerTetraAxis[2],tetraVector),
        scalar+dot(M8FlowerTetraAxis[3],tetraVector));
}

uint3 M8FlowerSkinWedgeSites(uint wedge)
{
    return uint3(0u,wedge+1u,wedge==5u ? 1u : wedge+2u);
}

bool M8FlowerSkinBefore(float leftValue, uint leftSite,
    float rightValue, uint rightSite)
{
    return leftValue>rightValue ||
        (leftValue==rightValue && leftSite<rightSite);
}

void M8FlowerSkinSortPair(inout uint left, inout uint right,
    float3 values, uint3 sites)
{
    if (M8FlowerSkinBefore(values[left],sites[left],
            values[right],sites[right])) return;
    uint swap=left; left=right; right=swap;
}

uint M8FlowerSkinOrder(float3 barycentric, uint wedge)
{
    uint3 sites=M8FlowerSkinWedgeSites(wedge);
    uint high=0u,middle=1u,low=2u;
    M8FlowerSkinSortPair(high,middle,barycentric,sites);
    M8FlowerSkinSortPair(middle,low,barycentric,sites);
    M8FlowerSkinSortPair(high,middle,barycentric,sites);
    if (high==0u) return middle==1u ? 0u : 1u;
    if (high==1u) return middle==0u ? 2u : 3u;
    return middle==0u ? 4u : 5u;
}

float3 M8FlowerSkinApplyChamber(float3 value, int3 order)
{
    precise float x0=value[order.x];
    precise float x1=value[order.y];
    precise float x2=value[order.z];
    return float3(x0-x1,2.0*(x1-x2),3.0*x2);
}

uint4 M8FlowerSkinDescend(float3 barycentric, uint wedge,
    out float3 childBarycentric)
{
    int4 rule=M8FlowerSkinChamber[wedge*6u+
        M8FlowerSkinOrder(barycentric,wedge)];
    childBarycentric=M8FlowerSkinApplyChamber(barycentric,rule.xyz);
    uint packed=asuint(rule.w);
    return uint4(packed&0xffu,(packed>>8)&0xffu,
        (packed>>16)&0xffu,(packed>>24)&1u);
}

uint M8FlowerSkinDescendWithJacobian(inout float3 barycentric,
    inout uint wedge, inout float3 derivativeU, inout float3 derivativeV)
{
    int4 rule=M8FlowerSkinChamber[wedge*6u+
        M8FlowerSkinOrder(barycentric,wedge)];
    barycentric=M8FlowerSkinApplyChamber(barycentric,rule.xyz);
    derivativeU=M8FlowerSkinApplyChamber(derivativeU,rule.xyz);
    derivativeV=M8FlowerSkinApplyChamber(derivativeV,rule.xyz);
    uint packed=asuint(rule.w);
    wedge=(packed>>8u)&0xffu;
    return packed&0xffu;
}

uint M8FlowerRank7(uint mask, uint bit)
{
    uint below=bit==0u ? 0u : (1u<<bit)-1u;
    return countbits(mask&below&0x7fu);
}

uint M8FlowerRank49(uint2 mask, uint bit)
{
    mask.y&=0x1ffffu;
    if (bit<=32u)
    {
        uint below=bit==0u ? 0u :
            (bit==32u ? 0xffffffffu : (1u<<bit)-1u);
        return countbits(mask.x&below);
    }
    uint highBit=bit-32u;
    uint highBelow=highBit==0u ? 0u : (1u<<highBit)-1u;
    return countbits(mask.x)+countbits(mask.y&highBelow);
}

void M8FlowerUnpackSkinSplitBits(uint packedLo, uint packedHi,
    out uint splitL2, out uint splitL3, out uint2 splitL4)
{
    splitL2=packedLo&1u;
    splitL3=(packedLo>>1)&0x7fu;
    splitL4.x=(packedLo>>8)|((packedHi&0xffu)<<24);
    splitL4.y=(packedHi>>8)&0x1ffffu;
}

bool M8FlowerSkinCompactChildAddress(uint groupBase, uint packedLo,
    uint packedHi, uint level, uint c3, uint c4, uint c5,
    out uint groupIndex, out uint childStitchRank)
{
    uint splitL2,splitL3;
    uint2 splitL4;
    M8FlowerUnpackSkinSplitBits(packedLo,packedHi,splitL2,splitL3,splitL4);
    uint j3=M8FlowerSkinL3ChildRank[c3];
    groupIndex=0xffffffffu;
    childStitchRank=0xffffffffu;
    if (splitL2==0u) return false;
    if (level==3u)
    {
        groupIndex=groupBase;
        childStitchRank=j3;
        return true;
    }
    if ((splitL3&(1u<<j3))==0u) return false;
    uint p4=7u*c3+c4;
    uint r4=M8FlowerSkinL4ChildRank[p4];
    if (level==4u)
    {
        groupIndex=groupBase+1u+M8FlowerRank7(splitL3,j3);
        childStitchRank=r4;
        return true;
    }
    uint j4=M8FlowerSkinL4ParentThread[p4];
    uint l4Word=j4<32u ? splitL4.x : splitL4.y;
    uint l4Shift=j4<32u ? j4 : j4-32u;
    if (level!=5u || (l4Word&(1u<<l4Shift))==0u) return false;
    groupIndex=groupBase+1u+countbits(splitL3)+
        M8FlowerRank49(splitL4,j4);
    childStitchRank=M8FlowerSkinL5ChildRank[49u*c3+7u*c4+c5];
    return true;
}

bool M8FlowerSkinSplitClosure(uint splitL2, uint splitL3, uint2 splitL4)
{
    if ((splitL3&~0x7fu)!=0u || (splitL4.y&~0x1ffffu)!=0u)
        return false;
    if (splitL2==0u)
        return splitL3==0u && all(splitL4==0u.xx);
    [unroll]
    for (uint parent=0u;parent<7u;parent++)
    {
        if ((splitL3&(1u<<parent))!=0u) continue;
        [unroll]
        for (uint child=0u;child<7u;child++)
        {
            uint bit=7u*parent+child;
            uint value=bit<32u ? splitL4.x : splitL4.y;
            uint shift=bit<32u ? bit : bit-32u;
            if ((value&(1u<<shift))!=0u) return false;
        }
    }
    return true;
}

uint M8FlowerCompactSkinValueCount(uint splitL2, uint splitL3,
    uint2 splitL4)
{
    if (!M8FlowerSkinSplitClosure(splitL2,splitL3,splitL4))
        return 0xffffffffu;
    if (splitL2==0u) return 1u;
    return 8u+7u*countbits(splitL3&0x7fu)+
        7u*(countbits(splitL4.x)+countbits(splitL4.y&0x1ffffu));
}

bool M8FlowerIntervalsDisjoint(float2 left, float2 right)
{
    return left.y<right.x || right.y<left.x;
}

uint M8FlowerClassifyScalarSkinSplit(float2 child[7], uint certainMask,
    uint supportMask)
{
    if ((supportMask&~0x7fu)!=0u ||
        (certainMask&supportMask)!=supportMask) return M8_FLOWER_SKIN_AMBIGUOUS;
    [unroll]
    for (uint i=0u;i<7u;i++)
    {
        [unroll]
        for (uint j=i+1u;j<7u;j++)
            if ((supportMask&(1u<<i))!=0u && (supportMask&(1u<<j))!=0u &&
                M8FlowerIntervalsDisjoint(child[i],child[j]))
                return M8_FLOWER_SKIN_SPLIT;
    }
    return M8_FLOWER_SKIN_UNIFORM;
}

uint M8FlowerClassifyScalarSkinSplit(float2 child[7], uint certainMask)
{
    return M8FlowerClassifyScalarSkinSplit(child,certainMask,0x7fu);
}

uint M8FlowerClassifyRgbSkinSplit(float2 childRgb[21], uint certainMask,
    uint supportMask)
{
    if ((supportMask&~0x7fu)!=0u ||
        (certainMask&supportMask)!=supportMask) return M8_FLOWER_SKIN_AMBIGUOUS;
    [unroll]
    for (uint i=0u;i<7u;i++)
    {
        [unroll]
        for (uint j=i+1u;j<7u;j++)
        {
            [unroll]
            for (uint channel=0u;channel<3u;channel++)
                if ((supportMask&(1u<<i))!=0u && (supportMask&(1u<<j))!=0u &&
                    M8FlowerIntervalsDisjoint(childRgb[3u*i+channel],
                        childRgb[3u*j+channel]))
                    return M8_FLOWER_SKIN_SPLIT;
        }
    }
    return M8_FLOWER_SKIN_UNIFORM;
}

uint M8FlowerClassifyRgbSkinSplit(float2 childRgb[21], uint certainMask)
{
    return M8FlowerClassifyRgbSkinSplit(childRgb,certainMask,0x7fu);
}

float M8FlowerSkinBubble(float3 barycentric)
{
    precise float p=barycentric.x*barycentric.y*barycentric.z;
    return 729.0*p*p;
}

float3 M8FlowerSkinBubbleGradient(float3 b)
{
    return 1458.0*float3(
        b.x*b.y*b.y*b.z*b.z,
        b.y*b.x*b.x*b.z*b.z,
        b.z*b.x*b.x*b.y*b.y);
}

float M8FlowerNestedV(float3 child3, float3 child4, float3 child5,
    float3 amplitude)
{
    return amplitude.x*M8FlowerSkinBubble(child3)+
        amplitude.y*M8FlowerSkinBubble(child4)+
        amplitude.z*M8FlowerSkinBubble(child5);
}

#define M8_FLOWER_PLANE_U_SHIFT 0x00000002u
#define M8_FLOWER_PLANE_V_SHIFT 0x0000000cu
#define M8_FLOWER_PLANE_OFFSET_SHIFT 0x00000016u
#define M8_FLOWER_PLANE_VALID 0x80000000u
#define M8_FLOWER_PLANE_FREE_SIDE 0x40000000u
#define M8_FLOWER_PLANE_STORAGE_MASK 0xfffffffcu
#define M8_FLOWER_OCCUPIED_FLAG 0x00000001u
#define M8_FLOWER_SEED_FLAG 0x00000002u
#define M8_FLOWER_OCCUPIED_ON 0x00000200u
#define M8_FLOWER_OCCUPIED_OFF 0x00000080u
#define M8_FLOWER_EVIDENCE_LIMIT 0x00000a00u
#define M8_FLOWER_SURFACE_EVIDENCE 0x00000280u
#define M8_FLOWER_THROUGH_EVIDENCE 0x00000100u
#define M8_FLOWER_PLANE_RANGE 0.0250000004f

uint2 M8FlowerPositiveQuotientBracket(float numerator,float denominator)
{
    M8FlowerInterval bracket;
    if(!M8FlowerDivideEnclosed(numerator,denominator,bracket))
        return uint2(0xffffffffu,0xffffffffu);
    return uint2(asuint(bracket.lo),asuint(bracket.hi));
}

int M8FlowerCompareRoundMidpoint(uint lo,uint hi,float denominator,
    float value)
{
    // lo/hi are adjacent positive binary32 values. Their exact sum has
    // <=25 mantissa bits, so its product fits the existing 64-bit
    // split-multiply primitive (<=49 bits, including a power-of-two boundary).
    uint eLo=(lo>>23u)&255u,eHi=(hi>>23u)&255u;
    uint mLo=(lo&0x7fffffu)|(eLo!=0u?0x800000u:0u);
    uint mHi=(hi&0x7fffffu)|(eHi!=0u?0x800000u:0u);
    int xLo=eLo==0u?-149:(int)eLo-150;
    int xHi=eHi==0u?-149:(int)eHi-150;
    int exponent=min(xLo,xHi);
    uint sum=(mLo<<(uint)(xLo-exponent))+(mHi<<(uint)(xHi-exponent));
    M8FlowerDyadicSquare product;
    product.nonzero=1u;
    uint bits=asuint(denominator),e=(bits>>23u)&255u;
    uint mantissa=(bits&0x7fffffu)|(e!=0u?0x800000u:0u);
    product.coefficient=M8FlowerMultiply24(sum,mantissa);
    product.exponent=exponent+(e==0u?-149:(int)e-150);
    M8FlowerDyadicSquare target=M8FlowerProductDyadic(value,1.0);
    target.exponent+=1;
    return M8FlowerCompareDyadic(product,target);
}


uint M8FlowerNearestBracket(uint lo,uint hi,int midpointComparison)
{
    if(lo==hi)return lo;
    if(midpointComparison<0)return hi;
    if(midpointComparison>0)return lo;
    return (lo&1u)==0u?lo:hi;
}

float M8FlowerRoundDivide(float numerator,float denominator)
{
    uint n=asuint(numerator),d=asuint(denominator);
    uint magnitude=n&0x7fffffffu;
    if(magnitude>=0x7f800000u || d==0u || d>=0x7f800000u)
        return asfloat(0x7fc00000u);
    if(magnitude==0u)return numerator;
    float positive=asfloat(magnitude);
    uint2 bracket=M8FlowerPositiveQuotientBracket(positive,denominator);
    if(bracket.x==0xffffffffu)return asfloat(0x7fc00000u);
    uint rounded=bracket.x;
    if(bracket.x!=bracket.y)
        rounded=M8FlowerNearestBracket(bracket.x,bracket.y,
            M8FlowerCompareRoundMidpoint(bracket.x,bracket.y,denominator,positive));
    return asfloat(rounded|(n&0x80000000u));
}

float M8FlowerRoundSqrt(float value)
{
    uint bits=asuint(value);
    if((bits&0x7fffffffu)==0u)return value;
    if(bits>=0x7f800000u)return asfloat(0x7fc00000u);
    uint encodedExponent=bits>>23;
    uint mantissa=(bits&0x7fffffu)|(encodedExponent!=0u?0x800000u:0u);
    int exponent=encodedExponent!=0u?(int)encodedExponent-127:-126;
    [loop] while(mantissa<0x800000u){mantissa<<=1;--exponent;}
    int parity=exponent&1;
    int shift=23+parity;
    uint2 radicand=uint2(mantissa<<shift,mantissa>>(32-shift));
    uint root=0u,remainder=0u;
    // D=mantissa*2^(23+parity) has at most48bits. Consume exactly24
    // bit-pairs; remainder stays below2^27, so no uint64/float64 is needed.
    [loop] for(int pair=23;pair>=0;--pair)
    {
        int pairShift=2*pair;
        uint digit=pairShift>=32?radicand.y>>(pairShift-32):radicand.x>>pairShift;
        remainder=(remainder<<2)|(digit&3u);
        root<<=1;
        uint trial=(root<<1)|1u;
        if(remainder>=trial){remainder-=trial;root|=1u;}
    }
    // D=q^2+r. The midpoint square is q^2+q+1/4: integral D can
    // never tie, and nearest rounding increments q exactly when r>q.
    if(remainder>root)++root;
    int rootExponent=(exponent-parity)/2;
    // All positive binary32 square roots are normal. Addition also handles
    // the carry when rounding a24bit significand across a power of two.
    return asfloat(((uint)(rootExponent+127)<<23)+root-0x800000u);
}


bool M8FlowerHasPlane(uint flags)
{
    return (flags & M8_FLOWER_PLANE_VALID) != 0u;
}

uint M8FlowerClearPlane(uint flags)
{
    return flags & ~M8_FLOWER_PLANE_STORAGE_MASK;
}

int M8FlowerPlaneFreeSide(uint flags)
{
    return (flags & M8_FLOWER_PLANE_FREE_SIDE) != 0u ? -1 : 1;
}

float2 M8FlowerOctSigns(float2 value)
{
    return float2(value.x < 0.0f ? -1.0f : 1.0f,
        value.y < 0.0f ? -1.0f : 1.0f);
}

bool M8FlowerTryPackPlane(uint flags, float3 normal,
    float signedOffset, out uint packed)
{
    packed = flags;
    if (!all(M8FlowerIsFinite(normal)) || !M8FlowerIsFinite(signedOffset) ||
        abs(signedOffset) > M8_FLOWER_PLANE_RANGE) return false;
    precise float3 square = normal * normal;
    precise float squareXY = square.x + square.y;
    precise float lengthSquared = squareXY + square.z;
    if (!(lengthSquared > 0.0f) || !M8FlowerIsFinite(lengthSquared)) return false;
    precise float normalLength = sqrt(lengthSquared);
    normal /= normalLength;
    float first = normal.x != 0.0f ? normal.x :
        normal.y != 0.0f ? normal.y : normal.z;
    bool reversed = first < 0.0f;
    if (reversed)
    {
        normal = -normal;
        signedOffset = -signedOffset;
    }
    precise float sumXY = abs(normal.x) + abs(normal.y);
    precise float sum = sumXY + abs(normal.z);
    normal /= sum;
    float2 oct = normal.xy;
    if (normal.z < 0.0f)
        oct = (1.0f - abs(oct.yx)) * M8FlowerOctSigns(oct);
    precise float2 halfOct = oct * 0.5f;
    precise float2 unitOct = halfOct + 0.5f;
    precise float2 code = round(unitOct * 1023.0f);
    precise float normalizedOffset = signedOffset / M8_FLOWER_PLANE_RANGE;
    int offsetCode = (int)round(normalizedOffset * 127.0f);
    if (any(code < 0.0f) || any(code > 1023.0f) ||
        offsetCode < -127 || offsetCode > 127) return false;
    packed = M8FlowerClearPlane(flags) |
        ((uint)code.x << (int)M8_FLOWER_PLANE_U_SHIFT) |
        ((uint)code.y << (int)M8_FLOWER_PLANE_V_SHIFT) |
        (((uint)offsetCode & 255u) << (int)M8_FLOWER_PLANE_OFFSET_SHIFT) |
        M8_FLOWER_PLANE_VALID |
        (reversed ? M8_FLOWER_PLANE_FREE_SIDE : 0u);
    return true;
}

void M8FlowerUnpackPlane(uint flags, out float3 normal,
    out float signedOffset)
{
    uint u = (flags >> (int)M8_FLOWER_PLANE_U_SHIFT) & 1023u;
    uint v = (flags >> (int)M8_FLOWER_PLANE_V_SHIFT) & 1023u;
    uint2 encoded = uint2(u,v);
    precise float2 unit = float2(0.0f,0.0f);
    [loop] for(uint axis=0u;axis<2u;axis++)
        unit[(int)axis] = M8FlowerRoundDivide((float)encoded[(int)axis],1023.0f);
    precise float2 twice = unit * 2.0f;
    precise float2 oct = twice - 1.0f;
    precise float zX = 1.0f - abs(oct.x);
    normal = float3(oct.x, oct.y, zX - abs(oct.y));
    if (normal.z < 0.0f)
        normal.xy = (1.0f - abs(normal.yx)) * M8FlowerOctSigns(normal.xy);
    precise float3 square = normal * normal;
    precise float squareXY = square.x + square.y;
    precise float lengthSquared = squareXY + square.z;
    precise float normalLength = M8FlowerRoundSqrt(lengthSquared);
    [loop] for(uint axis=0u;axis<3u;axis++)
        normal[(int)axis] = M8FlowerRoundDivide(normal[(int)axis],normalLength);
    uint raw = (flags >> (int)M8_FLOWER_PLANE_OFFSET_SHIFT) & 255u;
    int offsetCode = raw >= 128u ? (int)raw - 256 : (int)raw;
    precise float unitOffset = M8FlowerRoundDivide((float)offsetCode,127.0f);
    signedOffset = unitOffset * M8_FLOWER_PLANE_RANGE;
}

// The caller proves these predicates from fixed incidence / interval roots.
// It applies direct admission once per immutable observation, not per quantum.
uint4 M8FlowerAdmitR1(uint4 state, uint measuredPlane,
    uint capturedColor, bool compatiblePrior, bool differentObservation,
    bool sameObservationClosure)
{
    if (!M8FlowerHasPlane(measuredPlane)) return state;
    bool occupied = (state.w & M8_FLOWER_OCCUPIED_FLAG) != 0u;
    bool seed = !occupied && M8FlowerHasPlane(state.w) &&
        (state.w & M8_FLOWER_SEED_FLAG) != 0u;
    if (occupied && !compatiblePrior) return state;
    bool promote = sameObservationClosure ||
        (seed && compatiblePrior && differentObservation);
    uint flags = measuredPlane & M8_FLOWER_PLANE_STORAGE_MASK;
    int evidence;
    if (occupied || promote)
    {
        int before = occupied || (seed && compatiblePrior) ?
            max(0, asint(state.x)) : 0;
        evidence = min((int)M8_FLOWER_EVIDENCE_LIMIT,
            max((int)M8_FLOWER_OCCUPIED_ON,
                before + (int)M8_FLOWER_SURFACE_EVIDENCE));
        flags |= M8_FLOWER_OCCUPIED_FLAG;
    }
    else
    {
        evidence = min((int)M8_FLOWER_OCCUPIED_ON - 1,
            (int)M8_FLOWER_SURFACE_EVIDENCE);
        flags |= M8_FLOWER_SEED_FLAG;
    }
    return uint4(asuint(evidence), capturedColor, 1u, flags);
}

// Only full-support THROUGH may call this. It neither creates negative M8
// authority nor relies on normal neighbours to keep a contradicted ghost.
uint4 M8FlowerContradictR1(uint4 state)
{
    bool occupied = (state.w & M8_FLOWER_OCCUPIED_FLAG) != 0u;
    if (!occupied)
        return (state.w & M8_FLOWER_SEED_FLAG) != 0u ? uint4(0u,0u,0u,0u) : state;
    int evidence = asint(state.x) - (int)M8_FLOWER_THROUGH_EVIDENCE;
    if (evidence <= (int)M8_FLOWER_OCCUPIED_OFF) return uint4(0u,0u,0u,0u);
    state.x = asuint(evidence);
    return state;
}


// Load the two planes from K=(J-r)/2 and Q=K+r, in that order.
// Restriction is owner-relative: no large world-coordinate subtraction.
uint M8FlowerEvaluateCarrierRelation(int3 junction, uint lineClass, bool rootSign,
    uint firstPlane, uint secondPlane, float normalUncertainty,
    float offsetUncertainty, out M8FlowerPhaseRootEvidence relation,
    out M8FlowerInterval bend)
{
    relation=(M8FlowerPhaseRootEvidence)0;
    bend=M8FlowerI(0.0,0.0);
    if (lineClass>=M8_FLOWER_LINE_CLASS_COUNT) return 0u;
    int3 r=M8FlowerLineDirection[lineClass];
    if (any(((asuint(junction)^asuint(r))&1u)!=0u)) return 0u;
    if (!M8FlowerHasPlane(firstPlane) || !M8FlowerHasPlane(secondPlane) ||
        (firstPlane&M8_FLOWER_OCCUPIED_FLAG)==0u ||
        (secondPlane&M8_FLOWER_OCCUPIED_FLAG)==0u ||
        (firstPlane&M8_FLOWER_SEED_FLAG)!=0u ||
        (secondPlane&M8_FLOWER_SEED_FLAG)!=0u ||
        !all(M8FlowerIsFinite(float2(normalUncertainty,offsetUncertainty))) ||
        normalUncertainty<0.0 || offsetUncertainty<0.0) return 2u;
    float3 firstNormal,secondNormal;
    float firstOffset,secondOffset;
    M8FlowerUnpackPlane(firstPlane,firstNormal,firstOffset);
    M8FlowerUnpackPlane(secondPlane,secondNormal,secondOffset);
    precise float3 relative=float3(r)*(0.5*M8_FLOWER_LATTICE_STEP);
    float radius=M8FlowerGeometryLoopRadius[lineClass];
    M8FlowerInterval3 firstAbc,secondAbc;
    if (!M8FlowerPlaneIntervals(firstNormal,firstOffset,relative,radius,lineClass,
            normalUncertainty,offsetUncertainty,firstAbc) ||
        !M8FlowerPlaneIntervals(secondNormal,secondOffset,-relative,radius,lineClass,
            normalUncertainty,offsetUncertainty,secondAbc)) return 2u;
    M8FlowerInterval2 firstRoot,secondRoot;
    uint firstClass=M8FlowerRootInterval(firstAbc,rootSign,firstRoot);
    uint secondClass=M8FlowerRootInterval(secondAbc,rootSign,secondRoot);
    if (firstClass==M8_FLOWER_ROOT_IMPOSSIBLE ||
        secondClass==M8_FLOWER_ROOT_IMPOSSIBLE) return 0u;
    if ((firstClass!=M8_FLOWER_ROOT_CERTAIN_SECANT &&
         firstClass!=M8_FLOWER_ROOT_CERTAIN_TANGENT) ||
        (secondClass!=M8_FLOWER_ROOT_CERTAIN_SECANT &&
         secondClass!=M8_FLOWER_ROOT_CERTAIN_TANGENT)) return 2u;
    M8FlowerInterval2 root;
    uint sector;
    if (!M8FlowerSealBend(firstRoot,secondRoot,lineClass,root,bend,sector)) return 2u;
    relation.Junction=junction;
    relation.Tag=M8FlowerPackSymbolTag(0u,lineClass,rootSign,sector,false,0u,0u,0u);
    relation.Root=root;
    relation.Classification=1u;
    return 1u;
}


bool M8FlowerClassifyObservationRoot(uint level,
    uint lineClass, bool endpointOrientation, bool plusRoot,
    M8FlowerInterval3 abc, out uint symbolTag,
    out M8FlowerInterval2 root, out uint classification)
{
    symbolTag = 0u;
    root.x = M8FlowerI(0.0, 0.0);
    root.y = M8FlowerI(0.0, 0.0);
    classification = M8_FLOWER_ROOT_AMBIGUOUS;
    if (level >= M8_FLOWER_GEOMETRY_LEVEL_COUNT || lineClass >= 13u)
        return false;
    classification = M8FlowerRootInterval(abc, plusRoot, root);
    if (classification != M8_FLOWER_ROOT_CERTAIN_SECANT &&
        classification != M8_FLOWER_ROOT_CERTAIN_TANGENT) return false;
    // Delta=0 has a single isolated knot. Keep only the canonical minus
    // entry when the caller iterates the two algebraic signs.
    if (classification == M8_FLOWER_ROOT_CERTAIN_TANGENT && plusRoot)
        return false;
    uint sector;
    if (!M8FlowerRootSector(lineClass, root, sector))
    {
        classification = M8_FLOWER_ROOT_AMBIGUOUS;
        return false;
    }
    symbolTag = level | (lineClass << 3u) | (plusRoot ? 1u << 7u : 0u) |
        (sector << 8u) | (endpointOrientation ? 1u << 13u : 0u);
    return true;
}


bool M8FlowerL2KnotLoop(uint knot, out uint level,
    out int3 junctionOffset, out uint lineClass)
{
    level=0u; junctionOffset=0; lineClass=0u;
    if(knot>=386u)return false;
    uint source=M8FlowerL2KnotSource[knot];
    uint strand; int endpoint,phase,inherited;
    return M8FlowerTryGetChildPhaseLoop(source&63u,(source>>6u)&7u,
        (source>>9u)&7u,level,junctionOffset,lineClass,strand,endpoint,phase,inherited);
}

uint M8FlowerL2WedgeIndex(uint petal, uint childPath)
{
    return M8FlowerL2SourceToWedge[16u*petal+childPath];
}

// Six source wedges address one immutable L2 carrier and therefore one
// persistent skin thread. Pack canonicalizes that existing source identity;
// persistent decode below rejects every noncanonical wedge alias.
uint M8FlowerPackL2Key(uint geometryChildPath,uint petalClass,
    bool rootSign,uint sector)
{
    if(geometryChildPath>=16u || petalClass>=48u || sector>=32u)
        return 0xffffffffu;
    uint carrier=M8FlowerL2WedgeIndex(petalClass,geometryChildPath)/6u;
    uint source=M8FlowerL2Wedge[6u*carrier].y;
    return source |
        (rootSign ? (1u<<M8_FLOWER_L2_KEY_ROOT_SHIFT) : 0u) |
        (sector<<M8_FLOWER_L2_KEY_SECTOR_SHIFT);
}

bool M8FlowerL2KeyValid(uint key)
{
    if((key>>16u)!=0u)return false;
    uint petal=(key>>M8_FLOWER_L2_KEY_PETAL_SHIFT)&63u;
    if(petal>=48u)return false;
    uint canonical=M8FlowerPackL2Key(key&15u,petal,
        ((key>>M8_FLOWER_L2_KEY_ROOT_SHIFT)&1u)!=0u,
        (key>>M8_FLOWER_L2_KEY_SECTOR_SHIFT)&31u);
    return canonical==key;
}
