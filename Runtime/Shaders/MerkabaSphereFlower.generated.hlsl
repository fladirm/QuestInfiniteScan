// A generated uint4 holds the seven original knot IDs, owned mask and
// canonical source. This contains no root interval or world-space value.
uint4 M8FlowerL2CarrierRow(uint carrier)
{
    return _M8FlowerTables[M8_FLOWER_L2_CARRIER_ROW_BASE+carrier];
}
uint M8FlowerL2RowKnot(uint4 row,uint site)
{
    return (row[site>>1u]>>(16u*(site&1u)))&65535u;
}
uint M8FlowerL2CarrierKnot(uint carrier,uint site)
{
    if(carrier>=128u || site>=7u)return 0xffffffffu;
    return M8FlowerL2RowKnot(M8FlowerL2CarrierRow(carrier),site);
}
uint M8FlowerL2CarrierOwnedMask(uint carrier)
{
    if(carrier>=128u)return 0u;
    return (M8FlowerL2CarrierRow(carrier).w>>16u)&63u;
}
uint M8FlowerL2CarrierSource(uint carrier)
{
    if(carrier>=128u)return 0xffffffffu;
    return M8FlowerL2CarrierRow(carrier).w>>22u;
}
uint3 M8FlowerL2WedgeKnots(uint hub,uint wedge)
{
    if(hub>=128u || wedge>=6u)return 0xffffffffu;
    uint4 row=M8FlowerL2CarrierRow(hub);
    return uint3(M8FlowerL2RowKnot(row,0u),M8FlowerL2RowKnot(row,1u+wedge),
        M8FlowerL2RowKnot(row,1u+(wedge+1u)%6u));
}

// One preselected lexicographic owner for each exact three-knot wedge.
// The runtime still performs the original world translation/overflow guard.
bool M8FlowerCanonicalL2WedgeOwner(uint carrier,uint wedge,
    out int3 ownerOffset,out uint partnerWedge,out uint vertexMap)
{
    ownerOffset=0;partnerWedge=vertexMap=0u;
    if(carrier>=128u || wedge>=6u)return false;
    int4 row=asint(_M8FlowerTables[M8_FLOWER_L2_CANONICAL_OWNER_ROW_BASE+6u*carrier+wedge]);
    ownerOffset=row.xyz;partnerWedge=(uint)row.w&1023u;
    vertexMap=((uint)row.w>>10u)&63u;
    return true;
}

bool M8FlowerOwnsL2Wedge(uint carrier,uint wedge)
{
    return wedge<6u && (M8FlowerL2CarrierOwnedMask(carrier)&(1u<<wedge))!=0u;
}
