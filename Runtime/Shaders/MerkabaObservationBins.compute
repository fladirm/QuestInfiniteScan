#pragma kernel ReserveObservationBins
#pragma kernel CountObservationBins
#pragma kernel EmitObservationBins
#pragma kernel ResolveMissingSpatialNodes
#pragma kernel ResolveObservationTileRequests
#pragma kernel ResetObservationBins
#pragma use_dxc vulkan

#include "MerkabaObservationOwners.hlsl"
#include "MerkabaSphereFlower.generated.hlsl"
#include "DepthKit.hlsl"
#include "MerkabaObservationScope.hlsl"

float4x4 _MerkabaWorldToGrid;

// The SimpleScan sensor field distinguishes strict endpoints from bootstrap.
// Integer routing never upgrades bootstrap confidence into accepted evidence.
bool M8FlowerLoadAcceptedEndpoint(uint2 pixel, out int3 firstOwner)
{
    firstOwner = 0;
    if (any(pixel >= gsDepthTexSize)) return false;
    if (any(gsDepthTexSize > 512u.xx))
    {
        M8FlowerBinFailure(M8_OBSERVATION_FAILURE_MEASUREMENT_IDENTITY);
        return false;
    }
    float depth = gsDepthTex.Load(int3(pixel, 0));
    float4 normal = gsDepthNormalTex.Load(int3(pixel, 0));
    if (normal.w != 1.0 || !all(M8FlowerIsFinite(normal.xyz)) ||
        all(normal.xyz == 0.0.xxx) || !(depth > 0.0 && depth < 1.0))
        return false;
    precise float2 uv = (float2(pixel) + 0.5) / float2(gsDepthTexSize);
    precise float3 world = gsDepthNDCtoWorld(float3(uv, depth));
    if (!M8ObservationContains(world,gsDepthEyePos())) return false;
    precise float3 grid = mul(_MerkabaWorldToGrid, float4(world, 1.0)).xyz /
        M8_FLOWER_LATTICE_STEP;
    // 2147483520 is the greatest binary32 integer below int32's upper bound.
    // Both members of each overlap pair must have a representable address.
    if (!all(M8FlowerIsFinite(grid)) || any(grid < -2147483648.0) ||
        any(grid > 2147483520.0)) return false;
    firstOwner = int3(floor(grid));
    return true;
}

[numthreads(8, 8, 1)]
void CountObservationBins(uint3 id : SV_DispatchThreadID)
{
    // Dispatch dimensions have been consumed before its invocations start.
    // Only the origin clears that retired packet; missing-address lanes write
    // the disjoint NEXT packet, never the currently consumed dimensions.
    if(all(id==0u))_M8ObservationDispatchArgs[M8_OBSERVATION_RECOUNT_ARGS]=0u;
    int3 firstOwner;
    if(!M8FlowerLoadAcceptedEndpoint(id.xy,firstOwner))return;
    if(M8FlowerCountObservationOwners(firstOwner))
    {
        InterlockedMax(_M8ObservationDispatchArgs[M8_OBSERVATION_NEXT_COUNT_ARGS],
            (gsDepthTexSize.x+7u)/8u);
        InterlockedMax(_M8ObservationDispatchArgs[M8_OBSERVATION_NEXT_COUNT_ARGS+1u],
            (gsDepthTexSize.y+7u)/8u);
    }
}

[numthreads(8, 8, 1)]
void EmitObservationBins(uint3 id : SV_DispatchThreadID)
{
    int3 firstOwner;
    if (!M8FlowerLoadAcceptedEndpoint(id.xy, firstOwner)) return;
    uint sourcePixel = id.y * gsDepthTexSize.x + id.x;
    // Root identity and precision-class/width bits are populated by the
    // generated interval classifier in FlowerCommit, never by bin routing.
    uint pendingSymbol = 4u << M8_FLOWER_SYMBOL_STATUS_SHIFT;
    M8FlowerEmitObservationOwners(firstOwner, sourcePixel,
        pendingSymbol, sourcePixel);
}

// Publish this observation's direct address claims.
[numthreads(256, 1, 1)]
void ResolveMissingSpatialNodes(uint lane : SV_GroupIndex)
{
    uint blocks = min(_M8Counters[M8_COUNTER_NEW_BLOCK_QUEUE_COUNT],
        MERKABA_M8_BLOCK_CAPACITY);
    for (uint i = lane; i < blocks; i += 256u)
    {
        uint2 claim = _M8ClaimQueue[MERKABA_M8_CLAIM_BLOCK_OFFSET + i];
        M8PublishBlockClaim(claim);
    }
    uint chunks = min(_M8Counters[M8_COUNTER_NEW_CHUNK_QUEUE_COUNT],
        MERKABA_M8_CHUNK_CAPACITY);
    for (uint j = lane; j < chunks; j += 256u)
    {
        uint2 claim = _M8ClaimQueue[MERKABA_M8_CLAIM_CHUNK_OFFSET + j];
        uint2 owner = M8PublishChunkOwner(claim);
        uint d4 = (owner.y >> 6u) & 7u;
        uint d3 = (owner.y >> 3u) & 7u;
        uint d2 = owner.y & 7u;
        InterlockedOr(_M8BlockPresenceL0[owner.x], 1u << d4);
        InterlockedOr(_M8BlockPresenceL1[owner.x * 8u + d4], 1u << d3);
        InterlockedOr(_M8BlockPresenceL2[owner.x * 64u + d4 * 8u + d3], 1u << d2);
        _M8BlockChunkRefs[claim.x] = claim.y + 1u;
    }
    DeviceMemoryBarrierWithGroupSync();
    if (lane == 0u)
    {
        _M8Counters[M8_COUNTER_NEW_BLOCK_QUEUE_COUNT] = 0u;
        _M8Counters[M8_COUNTER_NEW_CHUNK_QUEUE_COUNT] = 0u;
        // This storage barrier may enable the same snapshot's recount.
        if (blocks != 0u || chunks != 0u) M8SignalResidencyChange();
    }
}

void M8FlowerPublishColdRequest(uint refIndex, uint chunkIndex, uint tileLocal)
{
    uint previous = 0u;
    [unroll]
    for (uint attempt = 0u; attempt < 4u; attempt++)
    {
        uint expected = _M8Counters[M8_COUNTER_LOAD_REQUEST_COUNT];
        uint consumed = _M8LoadRequestReadCount[0];
        if (expected - consumed >= MERKABA_M8_LOAD_REQUEST_CAPACITY) break;
        InterlockedCompareExchange(_M8Counters[M8_COUNTER_LOAD_REQUEST_COUNT],
            expected, expected + 1u, previous);
        if (previous == expected)
        {
            _M8LoadRequests[expected & MERKABA_M8_LOAD_REQUEST_MASK] =
                M8LogicalAddress(chunkIndex, tileLocal);
            M8CounterIncrement(M8_COUNTER_SCAN_COLD_MISSES);
            return;
        }
    }
    InterlockedCompareExchange(_M8ChunkTileRefs[refIndex],
        MERKABA_REF_LOADING, MERKABA_REF_COLD_ON_SSD, previous);
    _M8Counters[M8_COUNTER_STORAGE_BACKPRESSURE] = 1u;
}

// A storage publication barrier only. No world point, plane, root, owner
// choice or surface evidence is evaluated here. One group drains the bounded
// request list and releases its arena span before HOT-install claims reuse it.
groupshared uint m8ObservationInstallCount;

[numthreads(256, 1, 1)]
void ResolveObservationTileRequests(uint lane : SV_GroupIndex)
{
    if (lane == 0u) m8ObservationInstallCount = 0u;
    uint count = min(_M8Counters[M8_COUNTER_NEW_TILE_QUEUE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    for (uint request = lane; request < count; request += 256u)
    {
        uint2 item = _M8ClaimQueue[MERKABA_M8_CLAIM_TILE_OFFSET + request];
        uint refIndex = item.x;
        uint chunkIndex = refIndex / MERKABA_M8_TILES_PER_CHUNK;
        uint tileLocal = refIndex % MERKABA_M8_TILES_PER_CHUNK;
        if (chunkIndex >= MERKABA_M8_CHUNK_CAPACITY)
        {
            M8FlowerBinFailure(M8_OBSERVATION_FAILURE_MEASUREMENT_IDENTITY);
            continue;
        }
        if (item.y == MERKABA_REF_COLD_ON_SSD)
        {
            if (_M8ChunkTileRefs[refIndex] == MERKABA_REF_LOADING)
                M8FlowerPublishColdRequest(refIndex, chunkIndex, tileLocal);
        }
        else if (item.y == MERKABA_REF_EMPTY &&
            _M8ChunkTileRefs[refIndex] == MERKABA_REF_CLAIMED_NEW)
        {
            uint pending;
            InterlockedAdd(_M8Counters[M8_COUNTER_PENDING_NEW_TILE_COUNT],
                1u, pending);
            if (pending < MERKABA_M8_PHYSICAL_TILE_CAPACITY)
            {
                _M8PendingNewTileRefs[pending] = refIndex;
                uint d1 = (tileLocal >> 3u) & 7u;
                InterlockedOr(_M8ChunkPresence[M8ChunkPresenceL0Index(chunkIndex)],
                    1u << d1);
                InterlockedOr(_M8ChunkPresence[M8ChunkPresenceL1Index(chunkIndex, d1)],
                    1u << (tileLocal & 7u));
            }
            else
            {
                uint previous;
                InterlockedCompareExchange(_M8ChunkTileRefs[refIndex],
                    MERKABA_REF_CLAIMED_NEW, MERKABA_REF_EMPTY, previous);
                M8FlowerBinFailure(M8_OBSERVATION_FAILURE_PHYSICAL_CAPACITY);
            }
        }
    }
    DeviceMemoryBarrierWithGroupSync();
    uint pendingCount = min(_M8Counters[M8_COUNTER_PENDING_NEW_TILE_COUNT],
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    for (uint pending = lane; pending < pendingCount; pending += 256u)
    {
        uint refIndex = _M8PendingNewTileRefs[pending];
        if (_M8ChunkTileRefs[refIndex] != MERKABA_REF_CLAIMED_NEW) continue;
        uint ticket;
        InterlockedAdd(m8ObservationInstallCount, 1u, ticket);
        _M8ClaimQueue[MERKABA_M8_CLAIM_TILE_OFFSET + ticket] = uint2(refIndex, 0u);
    }
    DeviceMemoryBarrierWithGroupSync();
    if (lane == 0u)
    {
        uint freeCount = min(_M8Counters[M8_COUNTER_FREE_TILE_COUNT],
            MERKABA_M8_PHYSICAL_TILE_CAPACITY);
        uint installCount = min(freeCount, m8ObservationInstallCount);
        uint reservationBase = freeCount - installCount;
        _M8Counters[M8_COUNTER_FREE_TILE_COUNT] = reservationBase;
        _M8Counters[M8_COUNTER_NEW_TILE_RESERVATION_BASE] = reservationBase;
        _M8Counters[M8_COUNTER_NEW_TILE_QUEUE_COUNT] = 0u;
        _M8ObservationDispatchArgs[M8_OBSERVATION_INSTALL_ARGS] = installCount;
        _M8ObservationDispatchArgs[M8_OBSERVATION_INSTALL_ARGS+1u] = 1u;
        _M8ObservationDispatchArgs[M8_OBSERVATION_INSTALL_ARGS+2u] = 1u;
        if (installCount < m8ObservationInstallCount)
            _M8Counters[M8_COUNTER_TILE_STARVATION] = 1u;
        if (installCount < m8ObservationInstallCount ||
            (installCount != 0u && reservationBase < 256u))
            _M8Counters[M8_COUNTER_EVICTION_NEEDED] = 1u;
        // Do NOT clear UNRESOLVED: these newly installed owners were absent
        // from this count. Recount the same immutable field before any emit.
    }
}

// One workgroup reserves all stamped HOT slots. Each lane owns a contiguous
// span, then a 256-entry integer scan supplies its exclusive span prefix.
// This avoids both per-kernel world passes and a hierarchy of scan dispatches.
#define M8_OBSERVATION_RESERVE_LANES 256u
#define M8_OBSERVATION_SLOTS_PER_LANE \
    (MERKABA_M8_PHYSICAL_TILE_CAPACITY / M8_OBSERVATION_RESERVE_LANES)

groupshared uint2 m8ObservationPrefix[M8_OBSERVATION_RESERVE_LANES];
groupshared uint2 m8ObservationTotal;
groupshared uint m8ObservationCanReserve;

uint2 M8FlowerAddBinCounts(uint2 left, uint2 right)
{
    // min(C,a+b) is associative. Both operands are <= 2,097,153, so even
    // malformed per-tile counts cannot wrap and masquerade as a valid span.
    return uint2(min(M8_FLOWER_OBSERVATION_RECORD_CAPACITY + 1u,
        left.x + right.x), left.y + right.y);
}

uint2 M8FlowerBinCount(uint slot)
{
    uint stamp = _M8ObservationTileBins[slot].x;
    uint count = _M8ObservationTileBins[slot].y;
    uint2 result = uint2(0u, 0u);
    if (stamp == _M8ObservationToken && count != 0u)
        result = uint2(min(count, M8_FLOWER_OBSERVATION_RECORD_CAPACITY + 1u), 1u);
    return result;
}

[numthreads(256, 1, 1)]
void ReserveObservationBins(uint lane : SV_GroupIndex)
{
    uint slotCount = min(_M8ObservationHotSlotCount,
        MERKABA_M8_PHYSICAL_TILE_CAPACITY);
    uint first = lane * M8_OBSERVATION_SLOTS_PER_LANE;
    uint end = min(first + M8_OBSERVATION_SLOTS_PER_LANE, slotCount);
    uint2 local = 0u.xx;
    [loop]
    for (uint readSlot = first; readSlot < end; readSlot++)
        local = M8FlowerAddBinCounts(local, M8FlowerBinCount(readSlot));
    m8ObservationPrefix[lane] = local;
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint upStep = 1u; upStep < M8_OBSERVATION_RESERVE_LANES; upStep <<= 1u)
    {
        uint index = (lane + 1u) * (upStep << 1u) - 1u;
        if (index < M8_OBSERVATION_RESERVE_LANES)
            m8ObservationPrefix[index] = M8FlowerAddBinCounts(
                m8ObservationPrefix[index - upStep], m8ObservationPrefix[index]);
        GroupMemoryBarrierWithGroupSync();
    }
    if (lane == 0u)
    {
        m8ObservationTotal = m8ObservationPrefix[M8_OBSERVATION_RESERVE_LANES - 1u];
        m8ObservationPrefix[M8_OBSERVATION_RESERVE_LANES - 1u] = 0u.xx;
        uint failure = _M8Counters[M8_COUNTER_OBSERVATION_FAILURE];
        if (_M8ObservationToken == 0u ||
            _M8ObservationHotSlotCount > MERKABA_M8_PHYSICAL_TILE_CAPACITY)
            failure |= M8_OBSERVATION_FAILURE_MEASUREMENT_IDENTITY;
        if (_M8ObservationRecordCapacity > M8_FLOWER_OBSERVATION_RECORD_CAPACITY ||
            m8ObservationTotal.x > _M8ObservationRecordCapacity)
            failure |= M8_OBSERVATION_FAILURE_SURFACE_CAPACITY;
        _M8Counters[M8_COUNTER_OBSERVATION_FAILURE] = failure;
        // Missing owners request residency locally. They do not cancel the
        // stamped counts of independent resident owners in this snapshot.
        m8ObservationCanReserve = failure == 0u ? 1u : 0u;
    }
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint downStep = M8_OBSERVATION_RESERVE_LANES >> 1u; downStep != 0u; downStep >>= 1u)
    {
        uint index = (lane + 1u) * (downStep << 1u) - 1u;
        if (index < M8_OBSERVATION_RESERVE_LANES)
        {
            uint2 left = m8ObservationPrefix[index - downStep];
            m8ObservationPrefix[index - downStep] = m8ObservationPrefix[index];
            m8ObservationPrefix[index] = M8FlowerAddBinCounts(
                m8ObservationPrefix[index], left);
        }
        GroupMemoryBarrierWithGroupSync();
    }

    // Retain the exact touched list for this snapshot's final retirement,
    // including local missing-support results. No retry world sweep exists.
    {
        uint2 prefix = m8ObservationPrefix[lane];
        [loop]
        for (uint writeSlot = first; writeSlot < end; writeSlot++)
        {
            uint2 count = M8FlowerBinCount(writeSlot);
            if (count.y == 0u) continue;
            if (m8ObservationCanReserve != 0u)
            {
                _M8ObservationTileBins[writeSlot].z = prefix.x;
                _M8ObservationTileBins[writeSlot].w = 0u;
            }
            _M8TouchedTileQueue[prefix.y] = writeSlot;
            prefix += count;
        }
    }
    if (lane == 0u)
    {
        uint touched = m8ObservationTotal.y;
        _M8Counters[M8_COUNTER_TOUCHED_TILE_COUNT] = touched;
        // Exactly one future FlowerCommit workgroup per touched tile.
        // The queue barrier between dispatches publishes spans and arguments.
        _M8ObservationDispatchArgs[0] = m8ObservationCanReserve != 0u ? touched : 0u;
        _M8ObservationDispatchArgs[1] = 1u;
        _M8ObservationDispatchArgs[2] = 1u;
        _M8ObservationDispatchArgs[M8_OBSERVATION_ALLOCATION_ARGS] = 0u;
        _M8ObservationDispatchArgs[M8_OBSERVATION_INSTALL_ARGS] = 0u;
        _M8ObservationDispatchArgs[M8_OBSERVATION_RECOUNT_ARGS] = 0u;
    }
}

groupshared uint2 m8ObservationRecountGroups;

[numthreads(256, 1, 1)]
void ResetObservationBins(uint lane : SV_GroupIndex)
{
    if(lane==0u)
    {
        m8ObservationBegins=_M8Counters[M8_COUNTER_OBSERVATION_TOKEN]!=_M8ObservationToken?1u:0u;
        m8ObservationRecountGroups=uint2(
            _M8ObservationDispatchArgs[M8_OBSERVATION_NEXT_COUNT_ARGS],
            _M8ObservationDispatchArgs[M8_OBSERVATION_NEXT_COUNT_ARGS+1u]);
    }
    GroupMemoryBarrierWithGroupSync();
    if(m8ObservationBegins==0u && m8ObservationRecountGroups.x==0u)
    {
        // COLD requests have been handed to residency. Preserve HOT counts
        // and retire only the consumed allocation/install argument packets.
        if(lane==0u)
        {
            _M8ObservationDispatchArgs[M8_OBSERVATION_ALLOCATION_ARGS]=0u;
            _M8ObservationDispatchArgs[M8_OBSERVATION_INSTALL_ARGS]=0u;
        }
        return;
    }
    M8FlowerResetObservationBins(lane);
    if(lane==0u && m8ObservationBegins==0u)
    {
        _M8ObservationDispatchArgs[M8_OBSERVATION_RECOUNT_ARGS]=m8ObservationRecountGroups.x;
        _M8ObservationDispatchArgs[M8_OBSERVATION_RECOUNT_ARGS+1u]=m8ObservationRecountGroups.y;
        _M8ObservationDispatchArgs[M8_OBSERVATION_RECOUNT_ARGS+2u]=1u;
    }
}
