// Genesis RoomScan - TSDF volume integration compute shader
// Volume format: RG8_SNorm — R = signed distance, G = confidence weight
//   weight > 0 = unfrozen, weight < 0 = frozen (abs = real weight), 0 = empty
// Color volume: RGBA8_UNorm — RGB = accumulated color, A = coverage weight
//
// Uses quality^2 modulated running average with slow weight growth.
// Camera projection uses direct pinhole model (matching Meta PCA samples)
// instead of VP matrix, avoiding Z-convention and resolution mismatch bugs.
#include "DepthKit.hlsl"
#include "VolumeHelpers.hlsl"
#include "TsdfFusionPolicy.hlsl"

RWTexture3D<float2> gsVolumeRW;
RWTexture3D<float4> gsColorVolumeRW;
float gsDepthDispThresh;
float gsMaxUpdateDist;

#define EXCLUSION_TOP 0.25
#define EXCLUSION_BOTTOM 1.7
#define EXCLUSION_RADIUS 0.6
#define MIN_DOT 0.3

#define MIN_QUALITY_SEED 0.25
#define SEED_WEIGHT 0.10
#define PRUNE_WEIGHT 0.05
#define COLOR_SURFACE_BAND 0.5

float gsBlendRate;
float gsStability;
float gsWeightGrowth;
float gsMaxWeight;

Texture2D<float4> gsCamRGB;
int gsCamAvailable;
float3 gsCamPos;
float4x4 gsCamInvRot;
float2 gsCamFocalLen;
float2 gsCamPrincipalPt;
float2 gsCamSensorRes;
float2 gsCamCurrentRes;
float gsCamExposure;

float2 ProjectToCameraUV(float3 worldPos)
{
    float3 localPos = mul(gsCamInvRot, float4(worldPos - gsCamPos, 1.0)).xyz;
    float2 uv = float2(-1, -1);
    if (localPos.z > 0.001)
    {
        float2 sensorPt = float2(
            (localPos.x / localPos.z) * gsCamFocalLen.x + gsCamPrincipalPt.x,
            (localPos.y / localPos.z) * gsCamFocalLen.y + gsCamPrincipalPt.y);

        float2 scaleFactor = gsCamCurrentRes / gsCamSensorRes;
        scaleFactor /= max(scaleFactor.x, scaleFactor.y);
        float2 cropMin = gsCamSensorRes * (1.0 - scaleFactor) * 0.5;
        float2 cropSize = gsCamSensorRes * scaleFactor;
        uv = (sensorPt - cropMin) / cropSize;
    }
    return uv;
}

// Color confidence is deliberately independent from TSDF weight. The alpha channel stores
// the best geometric observation quality that supplied RGB for this voxel. A later, more
// distant or grazing view must not wash a good close/front-facing sample back to gray.
// Geometry quality is promoted only after a better observation has pulled the TSDF
// close enough to its measurement. Otherwise one close frame would raise alpha first
// and make the remaining correction look like an equal-quality outlier.
void UpdateSurfaceColor(uint3 coord, float3 voxPos, float sDistNorm, float quality,
    bool promoteQuality)
{
    if (!gsCamAvailable || abs(sDistNorm) >= COLOR_SURFACE_BAND || quality < 0.02)
        return;

    float2 uv = ProjectToCameraUV(voxPos);
    if (uv.x <= 0.02 || uv.x >= 0.98 || uv.y <= 0.02 || uv.y >= 0.98)
        return;

    float4 camColor = gsCamRGB.SampleLevel(gsBilinearClampSampler, uv, 0);
    float3 boosted = saturate(camColor.rgb * gsCamExposure);
    float4 oldColor = gsColorVolumeRW[coord];

    // RGBA8 quantization is ~0.0039. Require a real quality improvement rather than
    // allowing equal/worse frames to rewrite a stable observation every scan frame.
    if (oldColor.a < 0.01 || quality > oldColor.a + 0.02)
    {
        float storedQuality = promoteQuality
            ? quality : max(oldColor.a, 1.0 / 255.0);
        gsColorVolumeRW[coord] = float4(boosted, storedQuality);
    }
}

// Recover the orientation already represented by the scalar TSDF instead of adding
// another normal volume. Six integer reads are issued only for confident near-surface
// voxels; free space and low-confidence voxels stay on the original fast path.
bool TryEstimateExistingSurfaceNormal(uint3 coord, out float3 worldNormal)
{
    worldNormal = float3(0, 0, 0);
    bool valid = false;
    bool interior = !any(coord == uint3(0, 0, 0)) &&
        !any(coord + 1 >= gsVoxCount);
    if (interior)
    {
        float2 xMinus = gsVolumeRW[coord - uint3(1, 0, 0)];
        float2 xPlus  = gsVolumeRW[coord + uint3(1, 0, 0)];
        float2 yMinus = gsVolumeRW[coord - uint3(0, 1, 0)];
        float2 yPlus  = gsVolumeRW[coord + uint3(0, 1, 0)];
        float2 zMinus = gsVolumeRW[coord - uint3(0, 0, 1)];
        float2 zPlus  = gsVolumeRW[coord + uint3(0, 0, 1)];

        float3 gradient = float3(0, 0, 0);
        uint validAxes = 0;
        if (min(abs(xMinus.y), abs(xPlus.y)) >= gsFusionNormalMinWeight)
        {
            gradient.x = xPlus.x - xMinus.x;
            validAxes++;
        }
        if (min(abs(yMinus.y), abs(yPlus.y)) >= gsFusionNormalMinWeight)
        {
            gradient.y = yPlus.x - yMinus.x;
            validAxes++;
        }
        if (min(abs(zMinus.y), abs(zPlus.y)) >= gsFusionNormalMinWeight)
        {
            gradient.z = zPlus.x - zMinus.x;
            validAxes++;
        }

        float gradientLength = length(gradient);
        if (validAxes > 0 && gradientLength >= 0.04)
        {
            float3 localNormal = gradient / gradientLength;
            float3 transformed = mul((float3x3)gsWorldFromVolume, localNormal);
            float transformedLength = length(transformed);
            if (transformedLength >= 0.5)
            {
                worldNormal = transformed / transformedLength;
                valid = true;
            }
        }
    }
    return valid;
}

#pragma kernel Clear

[numthreads(4, 4, 4)]
void Clear(uint3 id : SV_DispatchThreadID)
{
    gsVolumeRW[id] = float2(GS_EMPTY_VOXEL, 0);
    gsColorVolumeRW[id] = float4(0, 0, 0, 0);
}

#pragma kernel Prune

[numthreads(4, 4, 4)]
void Prune(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= gsVoxCount)) return;
    float2 val = gsVolumeRW[id];
    if (val.y > 0 && val.y < PRUNE_WEIGHT)
    {
        gsVolumeRW[id] = float2(GS_EMPTY_VOXEL, 0);
        gsColorVolumeRW[id] = float4(0, 0, 0, 0);
    }
}

#pragma kernel Integrate

[numthreads(64, 1, 1)]
void Integrate(uint id : SV_DispatchThreadID)
{
    float3 vLocalPos = gsFrustumVolume[id];
    float3 vWorldPos = mul(gsDepthViewInv[0], float4(vLocalPos, 1)).xyz;
    float3 coordFloat = gsWorldToVoxelFloat(vWorldPos);
    if (any(coordFloat < 0.0) || any(coordFloat >= (float3)gsVoxCount)) return;
    uint3 coord = (uint3)coordFloat;
    float3 voxPos = gsVoxelToWorld(coord);

    float3 eyePos = gsDepthEyePos();
    float3 eyeToVox = voxPos - eyePos;
    float voxEyeDist = length(eyeToVox);

    float3 voxView = mul(gsDepthView[0], float4(voxPos, 1)).xyz;
    if (voxView.z > -0.05) return;

    float3 voxNDC = gsDepthWorldToNDC(voxPos);

    if (voxNDC.x < 0.01 || voxNDC.x > 0.99 || voxNDC.y < 0.01 || voxNDC.y > 0.99)
        return;

    float depthNDC = gsDepthSample(voxNDC.xy);
    if (depthNDC <= 0.0 || depthNDC >= 1.0) return;
    float3 depthNorm = gsDepthNormalSample(voxNDC.xy).xyz;
    float3 depthPos = gsDepthNDCtoWorld(float3(voxNDC.xy, depthNDC));

    float3 eyeToDepth = depthPos - eyePos;
    float depthEyeDist = length(eyeToDepth);
    float normDot = -dot(eyeToVox, depthNorm) / voxEyeDist;

    float raySignedDistance = depthEyeDist - voxEyeDist;
    float sDist = raySignedDistance * saturate(normDot);
    float sDistNorm = clamp(sDist / gsVoxDist, -1.0, 1.0);

    // gsVoxMin is a distance in metres. Upstream compared normalized TSDF units to
    // gsVoxMin/gsVoxSize, which made the default back-fill reach ~30 cm through a wall.
    // Keep one resolvable negative layer, bounded by the configured physical minimum.
    float behindBandMeters = gsFusionProtectionEnabled != 0
        ? min(gsVoxMin, gsVoxSize * gsFusionBackBandVoxels)
        : gsVoxMin;
    // The band is a physical thickness perpendicular to the observed surface.
    // Raw ray distance incorrectly rejects the negative TSDF layer of an oblique
    // wall (a 5 cm normal step is ~16.7 cm along a ray at incidence 0.3).
    bool withinBand = sDist >= -behindBandMeters;
    bool freeSpaceSample = raySignedDistance >= gsVoxDist;

    float dilatedDepthNDC = gsSampleDilatedDepth(voxNDC.xy);
    float dilatedDepthLinear = gsDepthNDCToLinear(dilatedDepthNDC);
    float depthLinear = gsDepthNDCToLinear(depthNDC);
    bool acceptableDepthDisparity = depthLinear < dilatedDepthLinear + gsDepthDispThresh;
    bool unoccludedByDilation = abs(voxView.z) < dilatedDepthLinear || acceptableDepthDisparity;
    bool validSurfaceNormal = freeSpaceSample || normDot > MIN_DOT;

    bool outsideExclusions = true;
    for (int p = 0; p < gsNumExclusions; p++)
    {
        float3 headPos = gsExclusionHeads[p];
        float2 diff = vWorldPos.xz - headPos.xz;
        if (dot(diff, diff) < EXCLUSION_RADIUS * EXCLUSION_RADIUS &&
            vWorldPos.y < headPos.y + EXCLUSION_TOP &&
            vWorldPos.y > headPos.y - EXCLUSION_BOTTOM)
        {
            outsideExclusions = false;
        }
    }

    if (!outsideExclusions) return;
    bool visible = withinBand & validSurfaceNormal & unoccludedByDilation;

    float2 old = gsVolumeRW[coord];
    float oldVal = old.x;
    float weight = max(old.y, 0.0);
    float confidence = saturate(weight / max(gsMaxWeight, 0.0001));
    bool stableSurfaceCandidate = gsFusionProtectionEnabled != 0 &&
        abs(oldVal) < gsFusionSurfaceBand &&
        confidence >= gsFusionStableConfidence;

    bool hasExistingOrientation = false;
    float orientationDot = 1.0;
    if (stableSurfaceCandidate)
    {
        float3 existingNormal = float3(0, 0, 0);
        float incomingNormalLength = length(depthNorm);
        if (incomingNormalLength > 0.5 &&
            TryEstimateExistingSurfaceNormal(coord, existingNormal))
        {
            hasExistingOrientation = true;
            orientationDot = dot(existingNormal, depthNorm / incomingNormalLength);
        }
    }

    float existingBestQuality = gsColorVolumeRW[coord].a;
    GsTsdfFusionResult fusion = gsFuseTsdf(oldVal, old.y,
        existingBestQuality, sDistNorm, depthEyeDist, gsMaxUpdateDist,
        normDot, visible, hasExistingOrientation, orientationDot,
        gsMaxWeight, gsBlendRate, gsStability, gsWeightGrowth);
    if (fusion.accepted < 0.5) return;

    gsVolumeRW[coord] = float2(fusion.tsdf, fusion.weight);

    bool promoteQuality = fusion.decision == GS_FUSION_SEEDED ||
        abs(fusion.tsdf - sDistNorm) <= max(gsFusionResidualTolerance, 0.04);
    UpdateSurfaceColor(coord, voxPos, sDistNorm, fusion.quality, promoteQuality);
}

#pragma kernel BakeRelocation
#pragma kernel FreezeInFrustum
#pragma kernel UnfreezeInFrustum

[numthreads(4, 4, 4)]
void FreezeInFrustum(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= gsVoxCount)) return;
    float2 vol = gsVolumeRW[id];
    if (vol.y <= 0) return; // empty or already frozen

    float3 worldPos = gsVoxelToWorld(id);
    float2 uv = ProjectToCameraUV(worldPos);
    if (uv.x < 0.01 || uv.x > 0.99 || uv.y < 0.01 || uv.y > 0.99)
        return;

    gsVolumeRW[id] = float2(vol.x, -vol.y);
}

[numthreads(4, 4, 4)]
void UnfreezeInFrustum(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= gsVoxCount)) return;
    float2 vol = gsVolumeRW[id];
    if (vol.y >= 0) return; // not frozen

    float3 worldPos = gsVoxelToWorld(id);
    float2 uv = ProjectToCameraUV(worldPos);
    if (uv.x < 0.01 || uv.x > 0.99 || uv.y < 0.01 || uv.y > 0.99)
        return;

    gsVolumeRW[id] = float2(vol.x, -vol.y);
}

// ──────────────────────────────────────────────────────────────────
//  CountSurfaceCoverage: periodically count surface/frozen/colored
//  voxels for scan progress metrics. NOT dispatched every frame.
// ──────────────────────────────────────────────────────────────────

#pragma kernel CountSurfaceCoverage

RWStructuredBuffer<uint> _CoverageCounters; // [0]=surface, [1]=frozen, [2]=colored

Texture3D<float4> gsColorVolumeRead;

[numthreads(4, 4, 4)]
void CountSurfaceCoverage(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= gsVoxCount)) return;
    float2 tsdf = gsVolumeRW[id];
    float weight = tsdf.y;
    bool isFrozen = weight < 0;
    float absWeight = abs(weight);
    bool isSurface = absWeight > PRUNE_WEIGHT && abs(tsdf.x) < 0.3;

    if (isSurface)
    {
        InterlockedAdd(_CoverageCounters[0], 1);
        if (isFrozen)
            InterlockedAdd(_CoverageCounters[1], 1);
        float4 color = gsColorVolumeRead[id];
        if (color.a > 0.1)
            InterlockedAdd(_CoverageCounters[2], 1);
    }
}

// ──────────────────────────────────────────────────────────────────
//  BakeRelocation: resample TSDF+color from old grid into current
//  identity grid so volumeToWorld can be reset to I after loading.
// ──────────────────────────────────────────────────────────────────

Texture3D<float2> gsBakeSrcTsdf;
Texture3D<float4> gsBakeSrcColor;
float4x4 gsBakeInvRelocation;

[numthreads(4, 4, 4)]
void BakeRelocation(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= gsVoxCount)) return;

    float3 dstLocal = ((float3)id + 0.5 - (float3)gsVoxCount / 2.0) * gsVoxSize;
    float3 srcLocal = mul(gsBakeInvRelocation, float4(dstLocal, 1)).xyz;

    float3 srcGrid = srcLocal / gsVoxSize + (float3)gsVoxCount / 2.0;
    float3 uvw = srcGrid / (float3)gsVoxCount;

    bool oob = any(uvw < 0.0) || any(uvw > 1.0);
    gsVolumeRW[id]      = oob ? float2(GS_EMPTY_VOXEL, 0) : gsBakeSrcTsdf.SampleLevel(gsVolLinearClampSampler, uvw, 0);
    gsColorVolumeRW[id] = oob ? float4(0, 0, 0, 0)        : gsBakeSrcColor.SampleLevel(gsVolLinearClampSampler, uvw, 0);
}
