#version 450
// C09 depth prior back-projection (contract §6, §7.4, §7.6): ONE dispatch, one thread per Environment Depth
// texel of BOTH eye layers (320x320x2 = 204,800 threads = 3,200 workgroups of 64; lanes alternate eyes so the
// per-frame cap fills both eyes evenly; the texel order rotates by FS_MEAS_ROW_PHASE_STRIDE rows per frame so
// the cap never cuts the same band twice). Per texel: projected depth -> metres, gates (near / 6 m / holes /
// image border), central-difference normal from the four neighbours, discontinuity test (> 10 % of depth =
// edge: flagged bit 8 and skipped unless DETAIL), flat test (small Laplacian = lowTexture bit 9), provisional
// sigma model, footprint, anchor-local transform (per-eye matrix from the frame block, at the depth's own
// XrTime pose). Compaction placeholder: (x + y + frame) % k lattice + hard cap maxOut.
// Output goes straight into the device measurement ring slot (fs_meas_gpu.h): one atomicAdd per workgroup
// reserves the group's records (shared-memory prefix); overflow beyond maxOut is counted, never written.
// Twin of fs::meas::BackprojectTexel / BackprojectDispatchReference (fs_meas_math.h).
#extension GL_GOOGLE_include_directive : require
#include "fs_abi.glsl"
#include "fs_meas_common.glsl"
layout(local_size_x = FS_MEAS_WG) in;
layout(set = 0, binding = FS_MEAS_B_DEPTH) uniform sampler2DArray depthTex;
layout(std430, set = 0, binding = FS_MEAS_B_RECORDS) writeonly buffer Records { FsSurfaceMeasurement rec[]; };
// Twin: fs::meas::FrameBlock (224 B): counters (GPU atomics) + per-eye parameters (CPU-written before submit).
layout(std430, set = 0, binding = FS_MEAS_B_COUNTERS) buffer FrameBlock { uint ctr[FS_MEAS_CTR_WORDS]; mat4 anchorFromEye[2]; vec4 fov[2]; } blk;
// Twin: fs::meas::PushBackproject (48 B). zp = (nearZ, farZ, maxDepthM, pad); a = (layers, decimK, maxOut,
// flags); b = (obsId, frame, width, height).
layout(push_constant) uniform Push { vec4 zp; uvec4 a; uvec4 b; } pc;

shared uint s_count, s_base, s_edge, s_invalid, s_decim, s_lowtex;

float fsFetch(uint layer, uint x, uint y) { return texelFetch(depthTex, ivec3(int(x), int(y), int(layer)), 0).r; }

void main() {
    if (gl_LocalInvocationIndex == 0u) { s_count = 0u; s_edge = 0u; s_invalid = 0u; s_decim = 0u; s_lowtex = 0u; }
    barrier();
    const uint w = pc.b.z, h = pc.b.w, layers = pc.a.x, flags = pc.a.w;
    const float nearZ = pc.zp.x, farZ = pc.zp.y, maxDepth = pc.zp.z;
    uint t = gl_GlobalInvocationID.x;
    bool write = false; uint local = 0u;
    FsSurfaceMeasurement m;
    m.px = 0.0; m.py = 0.0; m.pz = 0.0; m.nx = 0.0; m.ny = 0.0; m.nz = 0.0;
    m.sigmaN = 0.0; m.sigmaT = 0.0; m.footprint = 0.0; m.sourceFlags = 0u; m.observationId = 0u; m.reserved = 0u;
    if (t < w * h * layers) {
        // ---- thread -> (layer, texel) (twin: ThreadToTexel)
        uint layer = t % layers;
        uint texel = (t / layers + ((pc.b.y * uint(FS_MEAS_ROW_PHASE_STRIDE)) % h) * w) % (w * h);
        uint x = texel % w, y = texel / w;
        vec4 fov = layer == 0u ? blk.fov[0] : blk.fov[1];
        // ---- per-thread body (twin: BackprojectTexel) — no early return: the barriers below are uniform
        int status = 0;                                     // 0 invalid, 1 edge, 2 decimated, 3 written
        bool edge = false, lowTex = false;
        if (x != 0u && y != 0u && x + 1u < w && y + 1u < h) {
            float z = fsMeasLinearizeDepth(fsFetch(layer, x, y), nearZ, farZ, flags);
            if (fsMeasDepthUsable(z, nearZ, maxDepth)) {
                float zxm = fsMeasLinearizeDepth(fsFetch(layer, x - 1u, y), nearZ, farZ, flags);
                float zxp = fsMeasLinearizeDepth(fsFetch(layer, x + 1u, y), nearZ, farZ, flags);
                float zym = fsMeasLinearizeDepth(fsFetch(layer, x, y - 1u), nearZ, farZ, flags);
                float zyp = fsMeasLinearizeDepth(fsFetch(layer, x, y + 1u), nearZ, farZ, flags);
                if (fsMeasDepthUsable(zxm, nearZ, maxDepth) && fsMeasDepthUsable(zxp, nearZ, maxDepth) &&
                    fsMeasDepthUsable(zym, nearZ, maxDepth) && fsMeasDepthUsable(zyp, nearZ, maxDepth)) {
                    edge = fsMeasIsEdge(z, zxm, zxp, zym, zyp);
                    if (edge && (flags & FS_MEAS_FLAG_DETAIL) == 0u) status = 1;
                    else if ((flags & FS_MEAS_FLAG_NO_DECIMATION) == 0u && !fsMeasKeepDecimated(x, y, pc.b.y, pc.a.y)) status = 2;
                    else {
                        vec2 tc = fsMeasRayTangents(x, y, w, h, fov, flags);
                        vec2 txm = fsMeasRayTangents(x - 1u, y, w, h, fov, flags);
                        vec2 txp = fsMeasRayTangents(x + 1u, y, w, h, fov, flags);
                        vec2 tym = fsMeasRayTangents(x, y - 1u, w, h, fov, flags);
                        vec2 typ = fsMeasRayTangents(x, y + 1u, w, h, fov, flags);
                        vec3 p = fsMeasEyePoint(tc, z);
                        vec3 n = fsMeasNormal(p, fsMeasEyePoint(vec2(txm.x, tc.y), zxm), fsMeasEyePoint(vec2(txp.x, tc.y), zxp),
                                                 fsMeasEyePoint(vec2(tc.x, tym.y), zym), fsMeasEyePoint(vec2(tc.x, typ.y), zyp));
                        mat4 M = layer == 0u ? blk.anchorFromEye[0] : blk.anchorFromEye[1];
                        vec3 pa = (M * vec4(p, 1.0)).xyz;
                        vec3 na = mat3(M) * n;
                        float nl = length(na); na = nl < 1e-20 ? vec3(0.0) : na / nl;
                        lowTex = fsMeasIsFlat(z, zxm, zxp, zym, zyp);
                        m.px = pa.x; m.py = pa.y; m.pz = pa.z;
                        m.nx = na.x; m.ny = na.y; m.nz = na.z;
                        m.sigmaN = fsMeasSigmaN(z);
                        m.footprint = fsMeasFootprint(z, fov, w, h);
                        m.sigmaT = m.footprint;
                        m.sourceFlags = FS_MEAS_SRC_DEPTH_PRIOR | (edge ? FS_MEAS_SRC_EDGE : 0u) | (lowTex ? FS_MEAS_SRC_LOW_TEXTURE : 0u);
                        m.observationId = pc.b.x;
                        m.reserved = 0u;
                        status = 3;
                    }
                }
            }
        }
        if (edge) atomicAdd(s_edge, 1u);
        if (status == 3) { local = atomicAdd(s_count, 1u); write = true; if (lowTex) atomicAdd(s_lowtex, 1u); }
        else if (status == 2) atomicAdd(s_decim, 1u);
        else if (status == 0) atomicAdd(s_invalid, 1u);
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u) {
        uint n = s_count, base = 0u;
        if (n > 0u) {
            base = atomicAdd(blk.ctr[FS_MEAS_CTR_RESERVED], n);        // the single global reservation of this workgroup
            uint over = fsMeasOverflow(base, n, pc.a.z);
            if (over > 0u) atomicAdd(blk.ctr[FS_MEAS_CTR_OVERFLOW], over);
            atomicAdd(blk.ctr[FS_MEAS_CTR_VALID], n);
        }
        s_base = base;
        if (s_edge > 0u) atomicAdd(blk.ctr[FS_MEAS_CTR_EDGE], s_edge);
        if (s_lowtex > 0u) atomicAdd(blk.ctr[FS_MEAS_CTR_LOWTEX], s_lowtex);
        if (s_invalid > 0u) atomicAdd(blk.ctr[FS_MEAS_CTR_INVALID], s_invalid);
        if (s_decim > 0u) atomicAdd(blk.ctr[FS_MEAS_CTR_DECIMATED], s_decim);
        atomicAdd(blk.ctr[FS_MEAS_CTR_GROUPS], 1u);
    }
    barrier();
    if (write) { uint i = s_base + local; if (i < pc.a.z) rec[i] = m; }
}
