#version 450
// C09R-E2 compaction 5/5: selected texels are back-projected (same gates and math as before: central-difference
// normal, provisional sigma, footprint, anchor-local transform at the depth's own XrTime pose) and written at
// wgBase[g] + lane rank (shared-memory scan): deterministic order, no global atomics on the records.
#extension GL_GOOGLE_include_directive : require
#include "fs_abi.glsl"
#include "fs_meas_common.glsl"
#define FS_MEAS_USE_DEPTH
#include "fs_meas_frame.glsl"
layout(local_size_x = FS_MEAS_WG) in;
layout(std430, set = 0, binding = FS_MEAS_B_RECORDS) writeonly buffer Records { FsSurfaceMeasurement rec[]; };
layout(std430, set = 0, binding = FS_MEAS_B_SCORE) readonly buffer ScoreBlock { uint score[]; };
layout(std430, set = 0, binding = FS_MEAS_B_SELECT) readonly buffer SelectBlock { uint sel[]; };
layout(set = 0, binding = FS_MEAS_B_CAM_L) uniform sampler2D camL;
layout(set = 0, binding = FS_MEAS_B_CAM_R) uniform sampler2D camR;
layout(set = 0, binding = FS_MEAS_B_CAM_K) uniform sampler2D camK;
#include "fs_meas_stereo.glsl"
// Appearance sample (contract §14, C16a; twin: SampleColor): the measured world point projected into the PCA camera of the
// same eye (captured closest to the depth time, validity decided on the CPU); RGB8 | FS_MEAS_COLOR_VALID, else 0.
uint fsSampleColor(uint eye, vec3 pWorld) {
    if ((blk.camInfo.z & (1u << eye)) == 0u || blk.camInfo.x == 0u || blk.camInfo.y == 0u) return 0u;
    vec3 pc = (blk.camFromWorld[eye] * vec4(pWorld, 1.0)).xyz;
    if (pc.z <= 0.05) return 0u;
    vec4 k = blk.camIntrinsics[eye];
    float u = k.z + k.x * pc.x / pc.z, v = k.w + k.y * pc.y / pc.z;
    if (u < 0.0 || v < 0.0 || u >= float(blk.camInfo.x) || v >= float(blk.camInfo.y)) return 0u;
    ivec2 px = ivec2(int(u), int(v));
    if (blk.camInfo.w != 0u) px.y = int(blk.camInfo.y) - 1 - px.y;
    vec4 c = eye == 0u ? texelFetch(camL, px, 0) : texelFetch(camR, px, 0);
    uvec3 c8 = uvec3(clamp(c.rgb, 0.0, 1.0) * 255.0 + 0.5);
    return FS_MEAS_COLOR_VALID | c8.r | (c8.g << 8) | (c8.b << 16);
}
shared uint s_rank[FS_MEAS_WG];
shared uint s_lowtex;
void main() {
    const uint lane = gl_LocalInvocationIndex;
    if (lane == 0u) s_lowtex = 0u;
    const uint w = pc.b.z, h = pc.b.w, layers = pc.a.x, flags = pc.a.w;
    uint t = gl_GlobalInvocationID.x;
    bool selected = t < w * h * layers && fsMeasSelected(score[t], t, pc.b.y, blk.ctr[FS_MEAS_CTR_THRESHOLD], blk.ctr[FS_MEAS_CTR_FRACTION]);
    FsSurfaceMeasurement m;
    m.px = 0.0; m.py = 0.0; m.pz = 0.0; m.nx = 0.0; m.ny = 0.0; m.nz = 0.0;
    m.sigmaN = 0.0; m.sigmaT = 0.0; m.footprint = 0.0; m.sourceFlags = 0u; m.observationId = 0u; m.reserved = 0u;
    bool write = false;
    if (selected) {
        uint layer, x, y; fsMeasThreadToTexel(t, layers, w, h, pc.b.y, layer, x, y);
        FsTexelGeometry g;
        if (fsMeasClassify(layer, x, y, g) == 3) {
            vec4 fov = layer == 0u ? blk.fov[0] : blk.fov[1];
            vec2 tc = fsMeasRayTangents(x, y, w, h, fov, flags);
            vec2 txm = fsMeasRayTangents(x - 1u, y, w, h, fov, flags);
            vec2 txp = fsMeasRayTangents(x + 1u, y, w, h, fov, flags);
            vec2 tym = fsMeasRayTangents(x, y - 1u, w, h, fov, flags);
            vec2 typ = fsMeasRayTangents(x, y + 1u, w, h, fov, flags);
            vec3 p = fsMeasEyePoint(tc, g.z);
            vec3 n = fsMeasNormal(p, fsMeasEyePoint(vec2(txm.x, tc.y), g.zxm), fsMeasEyePoint(vec2(txp.x, tc.y), g.zxp),
                                     fsMeasEyePoint(vec2(tc.x, tym.y), g.zym), fsMeasEyePoint(vec2(tc.x, typ.y), g.zyp));
            mat4 M = layer == 0u ? blk.anchorFromEye[0] : blk.anchorFromEye[1];
            vec3 pa = (M * vec4(p, 1.0)).xyz;
            vec3 na = mat3(M) * n;
            float nl = length(na); na = nl < 1e-20 ? vec3(0.0) : na / nl;
            m.px = pa.x; m.py = pa.y; m.pz = pa.z;
            m.nx = na.x; m.ny = na.y; m.nz = na.z;
            m.sigmaN = fsMeasSigmaN(g.z);
            m.footprint = fsMeasFootprint(g.z, fov, w, h);
            m.sigmaT = m.footprint;
            m.sourceFlags = FS_MEAS_SRC_DEPTH_PRIOR | (g.edge ? FS_MEAS_SRC_EDGE : 0u) | (g.isFlat ? FS_MEAS_SRC_LOW_TEXTURE : 0u) | (layer << FS_MEAS_SRC_EYE_SHIFT);
            m.observationId = pc.b.x;
            vec3 pw = (blk.worldFromEye[layer] * vec4(p, 1.0)).xyz;
            m.reserved = fsSampleColor(layer, pw);
            // C10 stereo: a coherent L/R pair turns the Env Depth point into a disparity prior; a unique textured match becomes the
            // measurement (own geometry + sigma, colour at the stereo endpoint); otherwise the Env Depth record stands (counted why)
            vec3 nw = normalize(mat3(blk.worldFromEye[layer]) * n);
            bool stereoOk = false; vec3 ps = pw; float ss = m.sigmaN;
            if ((blk.camInfo.z & 4u) != 0u && g.z <= FS_STEREO_MAX_DEPTH_M && !g.edge) {
                float zn;
                uint st = fsStereoSolve(1u, pw, nw, m.sigmaN, FS_STEREO_BAND_MAX_PX, ps, ss, zn);
                if (st != FS_STEREO_ST_SKIP) atomicAdd(blk.ctr[FS_MEAS_CTR_STEREO_TESTED], 1u);
                if (st == FS_STEREO_OK) {
                    stereoOk = true;
                    vec3 psa = (blk.anchorFromWorld * vec4(ps, 1.0)).xyz;
                    uint bin = g.z < 0.75 ? 0u : (g.z < 1.5 ? 1u : (g.z < 2.5 ? 2u : 3u));
                    atomicAdd(blk.ctr[FS_MEAS_CTR_STEREO_VALID], 1u);
                    atomicAdd(blk.ctr[FS_MEAS_CTR_STEREO_BIN_N + bin], 1u);
                    atomicAdd(blk.ctr[FS_MEAS_CTR_STEREO_BIN_RES + bin], uint(min(length(ps - pw) * 1e4, 1e6)));
                    atomicAdd(blk.ctr[FS_MEAS_CTR_STEREO_SIGMA_UM], uint(min(ss * 1e6, 1e7)));
                    atomicAdd(blk.ctr[FS_MEAS_CTR_ENV_SIGMA_UM], uint(min(m.sigmaN * 1e6, 1e7)));
                    m.px = psa.x; m.py = psa.y; m.pz = psa.z;
                    m.sigmaN = ss;
                    m.sourceFlags = (m.sourceFlags & ~FS_MEAS_SRC_DEPTH_PRIOR) | FS_MEAS_SRC_STEREO;
                    m.reserved = fsSampleColor(0u, ps);
                } else if (st == FS_STEREO_ST_LOWTEX) atomicAdd(blk.ctr[FS_MEAS_CTR_STEREO_LOWTEX], 1u);
                else if (st == FS_STEREO_ST_AMBIG) atomicAdd(blk.ctr[FS_MEAS_CTR_STEREO_AMBIG], 1u);
                else if (st == FS_STEREO_ST_EDGE) atomicAdd(blk.ctr[FS_MEAS_CTR_STEREO_EDGEBAND], 1u);
                else if (st == FS_STEREO_ST_NOCOVER) atomicAdd(blk.ctr[FS_MEAS_CTR_STEREO_NOCOVER], 1u);
                if (!stereoOk) { ps = pw; ss = fsMeasSigmaN(g.z); }
            }
            // C11 temporal large-baseline multiview: the current left PCA frame against a keyframe 20-50 cm away (static scene, both
            // poses located at capture). Prior = the L/R stereo endpoint when valid (tight band), else the Env Depth point.
            bool temporalOk = false;
            if (blk.keyInfo.z != 0u && (blk.camInfo.z & 1u) != 0u && g.z <= FS_STEREO_MAX_DEPTH_M && !g.edge) {
                vec3 pt; float stg, znt;
                uint tt = fsStereoSolve(2u, ps, nw, ss, FS_TEMPORAL_BAND_MAX_PX, pt, stg, znt);
                if (tt != FS_STEREO_ST_SKIP) atomicAdd(blk.ctr[FS_MEAS_CTR_TEMPORAL_TESTED], 1u);
                if (tt == FS_STEREO_OK) {
                    if (stereoOk && length(pt - ps) > FS_TEMPORAL_AGREE_K * sqrt(stg * stg + ss * ss)) atomicAdd(blk.ctr[FS_MEAS_CTR_TEMPORAL_DISAGREE], 1u);
                    else {
                        temporalOk = true;
                        vec3 pta = (blk.anchorFromWorld * vec4(pt, 1.0)).xyz;
                        atomicAdd(blk.ctr[FS_MEAS_CTR_TEMPORAL_VALID], 1u);
                        atomicAdd(blk.ctr[FS_MEAS_CTR_TEMPORAL_SIGMA_UM], uint(min(stg * 1e6, 1e7)));
                        m.px = pta.x; m.py = pta.y; m.pz = pta.z;
                        m.sigmaN = stg;
                        m.sourceFlags = (m.sourceFlags & ~(FS_MEAS_SRC_DEPTH_PRIOR | FS_MEAS_SRC_STEREO)) | FS_MEAS_SRC_TEMPORAL;
                        m.reserved = fsSampleColor(0u, pt);
                    }
                } else if (tt == FS_STEREO_ST_LOWTEX) atomicAdd(blk.ctr[FS_MEAS_CTR_TEMPORAL_LOWTEX], 1u);
                else if (tt == FS_STEREO_ST_AMBIG) atomicAdd(blk.ctr[FS_MEAS_CTR_TEMPORAL_AMBIG], 1u);
                else if (tt == FS_STEREO_ST_EDGE) atomicAdd(blk.ctr[FS_MEAS_CTR_TEMPORAL_EDGE], 1u);
                else if (tt == FS_STEREO_ST_NOCOVER) atomicAdd(blk.ctr[FS_MEAS_CTR_TEMPORAL_NOCOVER], 1u);
            }
            // C11 planar path: a flat low-texture patch no image match could resolve -> robust plane over the Env Depth window
            // (one observation with the averaged random error; the Env Depth systematic floor stays via FS_MEAS_SRC_DEPTH_PRIOR)
            if (!stereoOk && !temporalOk && g.isFlat) {
                atomicAdd(blk.ctr[FS_MEAS_CTR_PLANAR_TESTED], 1u);
                float zc, rmsZ; vec3 nEye; uint inl;
                if (fsMeasPlanarFit(layer, x, y, fov, zc, nEye, rmsZ, inl)) {
                    vec3 pp = fsMeasEyePoint(tc, zc);
                    vec3 ppa = (M * vec4(pp, 1.0)).xyz, npa = normalize(mat3(M) * nEye);
                    float sp = fsMeasSigmaN(zc) / sqrt(max(float(inl) / FS_PLANAR_CORR_TEXELS, 1.0));
                    atomicAdd(blk.ctr[FS_MEAS_CTR_PLANAR_VALID], 1u);
                    atomicAdd(blk.ctr[FS_MEAS_CTR_PLANAR_SIGMA_UM], uint(min(sp * 1e6, 1e7)));
                    atomicAdd(blk.ctr[FS_MEAS_CTR_PLANAR_RMS_UM], uint(min(rmsZ * 1e6, 1e7)));
                    m.px = ppa.x; m.py = ppa.y; m.pz = ppa.z; m.nx = npa.x; m.ny = npa.y; m.nz = npa.z;
                    m.sigmaN = sp;
                    m.sourceFlags |= FS_MEAS_SRC_PLANAR;
                    m.reserved = fsSampleColor(layer, (blk.worldFromEye[layer] * vec4(pp, 1.0)).xyz);
                } else atomicAdd(blk.ctr[FS_MEAS_CTR_PLANAR_REJECTED], 1u);
            }
            write = true;
        }
    }
    s_rank[lane] = write ? 1u : 0u;
    barrier();
    for (uint o = 1u; o < uint(FS_MEAS_WG); o <<= 1u) { uint v = lane >= o ? s_rank[lane - o] : 0u; barrier(); s_rank[lane] += v; barrier(); }
    if (write) {
        uint i = sel[FS_MEAS_SEL_WGBASE + gl_WorkGroupID.x] + s_rank[lane] - 1u;
        if (i < pc.a.z) { rec[i] = m; if ((m.sourceFlags & FS_MEAS_SRC_LOW_TEXTURE) != 0u) atomicAdd(s_lowtex, 1u); }
    }
    barrier();
    if (lane == 0u && s_lowtex != 0u) atomicAdd(blk.ctr[FS_MEAS_CTR_LOWTEX], s_lowtex);
}
