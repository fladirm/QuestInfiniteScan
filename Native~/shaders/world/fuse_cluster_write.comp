#version 450
// F3b: per unmatched cell segment, recompute the (identical) clusters, allocate page-local slots from the
// page cursor (slab headroom reserved by the CPU; shortfall counted, never truncated silently), assign
// deterministic SurfaceIDs = idBase + prefix, write the new TRANSIENT surfels + evidence, insert them into the
// owner cell subtree (single owner per cell) and mark the cell dirty for publication.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_MEAS
#define FS_USE_PAGES
#define FS_USE_SURFELS
#define FS_USE_EVIDENCE
#define FS_USE_INDEX
#define FS_USE_GCTR
#define FS_USE_ASSOC_A_RO
#define FS_USE_SORT_RO
#define FS_USE_POOLS
#define FS_USE_DIRTY
#define FS_USE_RETIRE
#include "fs_world_blocks.glsl"
#include "fs_fusion.glsl"
#include "fs_cluster.glsl"
#include "fs_index.glsl"
layout(local_size_x = FS_WG_SMALL) in;
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint count = FS_TK(FS_T_COUNT);
    if (i >= count) return;
    uint key = assocA[i].key;
    if ((key & FS_ASSOC_KEY_UNMATCHED) == 0u || key == FS_ASSOC_KEY_NONE) return;
    if (i > 0u && assocA[i - 1u].key == key) return;
    uint page = assocA[i].pageSlot;
    uint cell = key & 0x7FFFu;
    vec3 origin = fsPageOrigin3(pages[page].key);
    FsCand cands[FS_CELL_NEW_MAX]; uint ov;
    uint n = fsClusterSegment(i, count, key, origin, cands, ov);
    if (n == 0u) return;
    uint prefix = sortw[FS_SORT_PREFIX + i] + sortw[FS_SORT_BLOCKSUM + i / 256u];
    uint idBase = FS_TK(FS_T_ID_BASE) + prefix;
    uint capacity = pages[page].slabCount * uint(FS_SLAB_SURFELS);
    // E9 slot recycling: disjoint atomic reservations from the page's available list first, the rest from the allocation cursor
    uint rk = atomicAdd(pool[fsRecycleWord(page, 0u)], n);
    uint avail = pool[fsRecycleWord(page, 1u)];
    uint recycled = rk < avail ? min(n, avail - rk) : 0u;
    uint local0 = n > recycled ? atomicAdd(pages[page].surfelCount, n - recycled) : 0u;
    if (recycled != 0u) atomicAdd(gctr[FS_GCTR_SLOTS_RECYCLED], recycled);
    uint tick16 = FS_TK(FS_T_TICK) & 0xFFFFu;
    uint obs = meas[assocA[i].meas].observationId;
    uint eyeIndex = (meas[assocA[i].meas].sourceFlags >> 16) & 1u;
    uint written = 0u;
    for (uint c = 0u; c < uint(FS_CELL_NEW_MAX); ++c) {
        if (c >= n) break;
        uint h;
        if (c < recycled) h = pool[fsRecycleWord(page, 4u + rk + c)];
        else {
            uint local = local0 + (c - recycled);
            if (local >= capacity) { atomicAdd(pages[page].shortfall, 1u); continue; }
            h = slabDir[page * uint(FS_PAGE_MAX_SLABS) + (local / uint(FS_SLAB_SURFELS))] * uint(FS_SLAB_SURFELS) + (local % uint(FS_SLAB_SURFELS));
        }
        FsCand q = cands[c];
        vec3 nn = fsCandNormal(q);
        float mxx, myy, mxy, varNorm; fsCandMoments(q, mxx, myy, mxy, varNorm);
        float rM, rm, ang; fsMomentToEllipse(mxx, myy, mxy, rM, rm, ang);
        rM = clamp(max(rM, q.fp), FS_RADIUS_MIN_M, FS_RADIUS_MAX_M); rm = clamp(max(rm, FS_RADIUS_MIN_M), FS_RADIUS_MIN_M, rM);
        FsPatch pt; pt.p = fsPageRangeGuard(fsCandMean(q)); pt.n = nn; pt.angle = ang; pt.rM = rM; pt.rm = rm;
        pt.sigmaN = max(fsCandSigmaN(q), fsSigmaFloor(q.srcAnd)); pt.sigmaT = max(fsCandSigmaT(q), FS_SIGMA_T_FLOOR_M);
        // C09R-E4: a candidate is ALWAYS transient with one observation of support, whatever the number of pixels
        pt.flags = 1u | FS_FLAG_TRANSIENT | FS_FLAG_SIDED_A;
        pt.surfaceId = idBase + c; pt.appearance = q.colW > 0.0 ? fsAppearanceWord(q.col / q.colW, 1u) : fsPreviewColorFromNormal(nn);
        surfels[h] = fsPack(pt);
        FsSurfelEvidence ev = fsEvidenceNew(tick16, fsEncodeLog(max(varNorm, 1e-3), FS_VAR_NORM_BASE), obs);
        // E9: the birth is the first independent observation; its view sector is recorded so only a NEW sector counts again
        fsSet_FsSurfelEvidence_viewDiversity(ev, fsViewSectorBit(nn, fsEpochEye(eyeIndex) - (origin + pt.p)));
        fsIndependentSet(ev, (q.srcAnd & FS_SRC_PHOTOMETRIC_MASK) != 0u ? 2u : 1u);
        evidence[h] = ev;
        // the owner cell holds the entry (the mean lies in it up to the seed spread); a mean in a neighbour cell is relocated
        uint meanCell = fsCellOf(pt.p);
        if (meanCell != cell) fsPushRelocation(h, page, cell, meanCell, surfels[h]);
        if (fsIndexInsert(page, cell, pt.p, h)) written++;
        else { FsSurfel dead = surfels[h]; fsSet_FsSurfel_evidenceFlags(dead, pt.flags | FS_FLAG_REMOVED); surfels[h] = dead; fsRecycleFree(page, h); }   // never indexed: free at once
    }
    // New sites are transient canonical hypotheses: never published. fuse_reduce marks the cell when it promotes them.
    if (written != 0u) atomicAdd(gctr[FS_GCTR_NEW_SURFELS], written);
    if (ov != 0u) atomicAdd(gctr[FS_GCTR_SEG_OVERFLOW], 1u);
}
