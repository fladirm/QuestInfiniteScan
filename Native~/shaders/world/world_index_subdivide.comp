#version 450
// Index rebuild, step 3/4 (adaptive subdivision, §9.2), batched: a cell whose count exceeds
// FS_CELL_OVERFLOW_THRESHOLD gets a 2x2x2 micro-bucket block from the slot's pool; pool exhaustion is
// counted (FS_GCTR_MICRO_POOL_FULL, folded into FS_CTR_INDEX_OVERFLOW) and the cell stays coarse.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_SLOTS
#define FS_USE_INDEX
#define FS_USE_GCTR
#include "fs_world_blocks.glsl"
layout(local_size_x = FS_WG_SMALL) in;
void main() {
    uint k = gl_WorkGroupID.y; if (k >= gctr[FS_G_REBUILD_COUNT]) return;
    uint slot = gctr[FS_G_REBUILD_LIST + k];
    uint cell = gl_GlobalInvocationID.x;
    if (cell >= uint(FS_CELLS_PER_PAGE)) return;
    FsSlotLayout l = layouts[slot];
    if (idx[fsCountIndex(l, cell)] <= uint(FS_CELL_OVERFLOW_THRESHOLD)) return;
    uint block = atomicAdd(idx[slot], 1u);
    if (block >= uint(FS_MICRO_BLOCKS_PER_SLOT)) { atomicAdd(gctr[FS_GCTR_MICRO_POOL_FULL], 1u); atomicAdd(gctr[FS_GCTR_INDEX_OVERFLOW], 1u); return; }
    idx[fsHeadIndex(l, cell)] = FS_CELL_HEAD_SUBDIV_BIT | block;
}
