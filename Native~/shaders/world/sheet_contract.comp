#version 450
// C09R-E4.1C graph edge contraction (one sequential invocation over the batch, after sheet_apply). For every node the immutable fit
// selected as a contraction loser (delta word 4 = survivor): the survivor keeps its SurfaceID and absorbs the loser
// (fsAbsorbPatch: precision-weighted centre / normal, union statistical support, summed evidence, count-weighted appearance), the
// loser is REMOVED (its leaf is compacted by the next maintenance of its dirty cell), the survivor's centre relocates when it crossed
// its cell, and the survivor plus every former neighbour of the loser is marked graph-dirty so the next batches relink the edges.
// Flat walls coarsen; curved rings (no flat fit), boundaries (degree < FS_CONTRACT_MIN_DEGREE) and detail never contract.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_PAGES_RO
#define FS_USE_SURFELS
#define FS_USE_EVIDENCE
#define FS_USE_GCTR
#define FS_USE_SHEET
#define FS_USE_DIRTY
#include "fs_world_blocks.glsl"
#include "fs_fusion.glsl"
layout(local_size_x = 1) in;
void main() {
    uint n = FS_TK(FS_T_SHEET_COUNT), contractions = 0u;
    for (uint i = 0u; i < uint(FS_SHEET_BATCH_MAX); ++i) {
        if (i >= n) break;
        uint dw = fsSheetDeltaWord(i, 0u);
        uint target = sheet[dw + 4u];
        if (target == FS_INDEX_NONE) continue;
        uint e = sheet[FS_TK(FS_T_SHEET_RING_BASE) + ((FS_TK(FS_T_SHEET_BEGIN) + i) & (uint(FS_SHEET_RING_CAP) - 1u))];
        uint lp = e >> 22, lh = e & 0x3FFFFFu, sp = target >> 22, shh = target & 0x3FFFFFu;
        FsPatch pd = fsUnpack(surfels[lh]), ps = fsUnpack(surfels[shh]);
        const uint dead = FS_FLAG_REMOVED | FS_FLAG_TRANSIENT;
        if ((pd.flags & dead) != 0u || (ps.flags & dead) != 0u || (ps.flags & FS_FLAG_PROMOTED) == 0u) continue;
        FsSurfel oldS = surfels[shh];
        uint oldCell = fsCellOf(ps.p);
        pd.p += fsPageOrigin3(pages[lp].key) - fsPageOrigin3(pages[sp].key);   // loser centre in the survivor's page frame
        FsPatch r = fsAbsorbPatch(ps, pd);
        r.p = fsPageRangeGuard(r.p);
        uint newCell = fsCellOf(r.p);
        if (newCell != oldCell && !fsPushRelocation(shh, sp, oldCell, newCell, oldS)) continue;   // list full: the contraction waits
        surfels[shh] = fsPack(r);
        FsSurfelEvidence es = evidence[shh], ed = evidence[lh];
        fsSet_FsSurfelEvidence_positiveSupport(es, min(fsGet_FsSurfelEvidence_positiveSupport(es) + fsGet_FsSurfelEvidence_positiveSupport(ed), 65535u));
        fsSet_FsSurfelEvidence_contradictionDebt(es, min(fsGet_FsSurfelEvidence_contradictionDebt(es), fsGet_FsSurfelEvidence_contradictionDebt(ed)));   // E6R: absorbed support never inherits the worse debt
        fsSet_FsSurfelEvidence_viewDiversity(es, fsGet_FsSurfelEvidence_viewDiversity(es) | fsGet_FsSurfelEvidence_viewDiversity(ed));
        evidence[shh] = es;
        FsSurfel ls = surfels[lh]; fsSet_FsSurfel_evidenceFlags(ls, fsGet_FsSurfel_evidenceFlags(ls) | FS_FLAG_REMOVED); surfels[lh] = ls;
        fsMarkDirtyCell(lp, fsCellOf(fsUnpack(ls).p));
        fsMarkDirtyCell(sp, oldCell);
        // relink: the loser's former neighbours and the survivor rebuild their proposals
        for (uint k = 0u; k < uint(FS_SHEET_K); ++k) {
            uint nbE = sheet[fsSheetNodeWord(lh, k)];
            sheet[fsSheetNodeWord(lh, k)] = FS_INDEX_NONE;
            if (nbE != FS_INDEX_NONE && nbE != target) fsSheetMark(nbE >> 22, nbE & 0x3FFFFFu);
        }
        sheet[fsSheetNodeWord(lh, 6u)] = 0u; sheet[fsSheetNodeWord(lh, 7u)] = 0u; sheet[fsSheetNodeWord(lh, 8u)] = 0u; sheet[fsSheetNodeWord(lh, 9u)] = 0u;
        fsSheetMark(sp, shh);
        contractions++; atomicAdd(gctr[FS_GCTR_PROMOTED_REMOVED], 1u);
    }
    if (contractions != 0u) atomicAdd(gctr[FS_GCTR_EDGE_CONTRACTIONS], contractions);
}
