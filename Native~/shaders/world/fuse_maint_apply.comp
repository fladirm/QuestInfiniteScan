#version 450
// F4b per dirty cell (single owner): ghost removal from free-space contradictions, deterministic merges,
// explicit splits (two children along the major axis, ids = idBase + newTotal + prefix), leaf compaction.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_PAGES
#define FS_USE_SURFELS
#define FS_USE_EVIDENCE
#define FS_USE_INDEX
#define FS_USE_GCTR
#define FS_USE_SORT_RO
#define FS_USE_FREESPACE_RO
#define FS_USE_POOLS
#define FS_USE_DIRTY_RO
#define FS_USE_RETIRE
#include "fs_world_blocks.glsl"
#include "fs_fusion.glsl"
#include "fs_index.glsl"
#include "fs_maint.glsl"
layout(local_size_x = FS_WG_SMALL) in;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= FS_TK(FS_T_DIRTY_COUNT)) return;
    uint entry = dirty[FS_DIRTY_LIST(0) + i];
    uint page = entry >> 15, cell = entry & 0x7FFFu;
    uint tick = FS_TK(FS_T_TICK), tick16 = tick & 0xFFFFu, stamp = 1u + (tick % 255u);
    uint byteIndex = pages[page].freeSpaceBase + cell;
    bool seenThrough = ((freeSpace[byteIndex >> 2u] >> ((byteIndex & 3u) * 8u)) & 0xFFu) == stamp;
    uint leaves[FS_MAINT_LEAVES_MAX]; uint nl = fsCollectLeaves(page, cell, leaves);
    uint splitId = FS_TK(FS_T_ID_BASE) + FS_TK(FS_T_NEW_TOTAL) + sortw[FS_SORT_PREFIX + i] + sortw[FS_SORT_BLOCKSUM + i / 256u];
    uint capacity = pages[page].slabCount * uint(FS_SLAB_SURFELS);
    uint ghosts = 0u, merges = 0u, splits = 0u;
    uint splitPlan[FS_SPLITS_PER_CELL]; uint nPlan = 0u;
    for (uint l = 0u; l < uint(FS_MAINT_LEAVES_MAX); ++l) {
        if (l >= nl) break;
        uint leaf = leaves[l];
        uint cnt = min(idx[fsIdxLeafWord(leaf, 0u)], uint(FS_INDEX_LEAF_CAP));
        // ---- ghosts (§8.6): seen through this tick without being observed
        for (uint k = 0u; k < uint(FS_INDEX_LEAF_CAP); ++k) {
            if (k >= cnt) break;
            uint h = idx[fsIdxLeafWord(leaf, 2u + k)];
            FsSurfel s = surfels[h]; uint flags = fsGet_FsSurfel_evidenceFlags(s);
            if ((flags & FS_FLAG_REMOVED) != 0u) continue;
            FsSurfelEvidence ev = evidence[h];
            // E3: an unpromoted candidate in this re-observed cell that no measurement supported for FS_TRANSIENT_TTL ticks expires
            if ((flags & FS_FLAG_PROMOTED) == 0u && ((tick16 - fsGet_FsSurfelEvidence_lastSeenFrame(ev)) & 0xFFFFu) > uint(FS_TRANSIENT_TTL)) {
                fsSet_FsSurfel_evidenceFlags(s, flags | FS_FLAG_REMOVED); surfels[h] = s; ghosts++; continue;
            }
            if (!seenThrough || fsGet_FsSurfelEvidence_lastSeenFrame(ev) == tick16) continue;
            uint motion = min(fsGet_FsSurfelEvidence_motionEvidence(ev) + 1u, 65535u);
            fsSet_FsSurfelEvidence_motionEvidence(ev, motion);
            uint limit = uint(FS_GHOST_MOTION_MIN) + fsGet_FsSurfelEvidence_staticEvidence(ev) / uint(FS_GHOST_STATIC_K);
            if (motion >= limit) { fsSet_FsSurfel_evidenceFlags(s, flags | FS_FLAG_REMOVED); surfels[h] = s; ghosts++; }
            evidence[h] = ev;
        }
        // ---- merges (§8.4): pairs inside the leaf, survivor by deterministic priority
        for (uint a = 0u; a < uint(FS_INDEX_LEAF_CAP); ++a) {
            if (a >= cnt) break;
            uint ha = idx[fsIdxLeafWord(leaf, 2u + a)];
            FsPatch pa = fsUnpack(surfels[ha]);
            if ((pa.flags & FS_FLAG_REMOVED) != 0u) continue;
            for (uint b = a + 1u; b < uint(FS_INDEX_LEAF_CAP); ++b) {
                if (b >= cnt) break;
                uint hb = idx[fsIdxLeafWord(leaf, 2u + b)];
                FsPatch pb = fsUnpack(surfels[hb]);
                if ((pb.flags & FS_FLAG_REMOVED) != 0u || !fsMergeable(pa, pb)) continue;
                FsSurfelEvidence ea = evidence[ha], eb = evidence[hb];
                bool aWins = fsSurvives(pa, ea, pb, eb);
                uint hs = aWins ? ha : hb, hd = aWins ? hb : ha;
                FsPatch ps = aWins ? pa : pb, pd = aWins ? pb : pa;
                FsSurfelEvidence es = aWins ? ea : eb, ed = aWins ? eb : ea;
                float ws = 1.0 / (ps.sigmaN * ps.sigmaN), wd = 1.0 / (pd.sigmaN * pd.sigmaN);
                vec3 delta = pd.p - ps.p; float d = dot(ps.n, delta);
                vec3 tv = delta - d * ps.n;
                FsPatch r = ps;
                r.p = ps.p + ps.n * (d * wd / (ws + wd)) + tv * (wd / (ws + wd));
                r.n = normalize(ps.n * ws + pd.n * wd);
                // union ellipse: combined second moments about the merged centre
                float sa, sb, sc; fsPatchMoment(ps, sa, sb, sc); float da, db, dc; fsPatchMoment(pd, da, db, dc);
                vec3 t1, t2; fsTangentFrame(r.n, t1, t2);
                vec2 os = vec2(dot(ps.p - r.p, t1), dot(ps.p - r.p, t2)), od = vec2(dot(pd.p - r.p, t1), dot(pd.p - r.p, t2));
                float cs = float(max(ps.flags & FS_EVIDENCE_COUNT_MASK, 1u)), cd = float(max(pd.flags & FS_EVIDENCE_COUNT_MASK, 1u));
                float ma = (cs * (sa + os.x * os.x) + cd * (da + od.x * od.x)) / (cs + cd);
                float mb = (cs * (sb + os.y * os.y) + cd * (db + od.y * od.y)) / (cs + cd);
                float mc = (cs * (sc + os.x * os.y) + cd * (dc + od.x * od.y)) / (cs + cd);
                float rM, rm, ang; fsMomentToEllipse(ma, mb, mc, rM, rm, ang);
                r.rM = clamp(rM, FS_RADIUS_MIN_M, FS_RADIUS_MAX_M); r.rm = clamp(rm, FS_RADIUS_MIN_M, r.rM); r.angle = ang;
                r.sigmaN = max(sqrt(1.0 / (ws + wd)), FS_SIGMA_N_FLOOR_M);
                r.flags = (ps.flags & ~FS_EVIDENCE_COUNT_MASK) | min((ps.flags & FS_EVIDENCE_COUNT_MASK) + (pd.flags & FS_EVIDENCE_COUNT_MASK), uint(FS_EVIDENCE_COUNT_MAX));
                vec3 bmin, bmax; fsCellBounds(cell, bmin, bmax); r.p = clamp(r.p, bmin + vec3(0.0005), bmax - vec3(0.0005));
                surfels[hs] = fsPack(r);
                fsSet_FsSurfelEvidence_staticEvidence(es, min(fsGet_FsSurfelEvidence_staticEvidence(es) + fsGet_FsSurfelEvidence_staticEvidence(ed), 65535u));
                evidence[hs] = es;
                FsSurfel dead = surfels[hd]; fsSet_FsSurfel_evidenceFlags(dead, fsGet_FsSurfel_evidenceFlags(dead) | FS_FLAG_REMOVED); surfels[hd] = dead;
                merges++;
                if (!aWins) break;                     // a is dead; the survivor b is visited by the outer loop
                pa = r;
            }
        }
        // ---- split plan (§8.4): executed after the leaf walk (insertion may restructure the subtree)
        for (uint k = 0u; k < uint(FS_INDEX_LEAF_CAP); ++k) {
            if (k >= cnt) break;
            uint h = idx[fsIdxLeafWord(leaf, 2u + k)];
            FsPatch q = fsUnpack(surfels[h]);
            if ((q.flags & FS_FLAG_REMOVED) != 0u || !fsSplitWanted(q, evidence[h]) || nPlan >= uint(FS_SPLITS_PER_CELL)) continue;
            splitPlan[nPlan++] = h;
        }
        // ---- compact the leaf: drop removed handles (their storage is a hole until slab compaction)
        uint w = 0u;
        for (uint k = 0u; k < uint(FS_INDEX_LEAF_CAP); ++k) {
            if (k >= cnt) break;
            uint h = idx[fsIdxLeafWord(leaf, 2u + k)];
            if ((fsGet_FsSurfel_evidenceFlags(surfels[h]) & FS_FLAG_REMOVED) != 0u) continue;
            idx[fsIdxLeafWord(leaf, 2u + w)] = h; w++;
        }
        idx[fsIdxLeafWord(leaf, 0u)] = w;
    }
    // ---- splits: two children along the major axis, deterministic ids, original retired from the index
    for (uint sIdx = 0u; sIdx < uint(FS_SPLITS_PER_CELL); ++sIdx) {
        if (sIdx >= nPlan) break;
        uint h = splitPlan[sIdx];
        FsPatch q = fsUnpack(surfels[h]);
        uint local0 = atomicAdd(pages[page].surfelCount, 2u);
        if (local0 + 1u >= capacity) { atomicAdd(pages[page].shortfall, 2u); continue; }
        vec3 tM, tm; fsPatchFrame(q, tM, tm);
        FsSurfelEvidence ev = evidence[h];
        FsSurfelEvidence halfEv = ev; fsSet_FsSurfelEvidence_staticEvidence(halfEv, max(fsGet_FsSurfelEvidence_staticEvidence(ev) / 2u, 1u));
        fsSet_FsSurfelEvidence_varianceQ(halfEv, fsEncodeLog(q.sigmaN * q.sigmaN, FS_SIGMA_BASE_M * FS_SIGMA_BASE_M));
        if (!fsIndexRemove(page, cell, q.p, h)) continue;
        FsSurfel dead = surfels[h]; fsSet_FsSurfel_evidenceFlags(dead, q.flags | FS_FLAG_REMOVED); surfels[h] = dead;
        for (uint c = 0u; c < 2u; ++c) {
            uint local = local0 + c;
            uint hn = slabDir[page * uint(FS_PAGE_MAX_SLABS) + (local / uint(FS_SLAB_SURFELS))] * uint(FS_SLAB_SURFELS) + (local % uint(FS_SLAB_SURFELS));
            FsPatch child = q;
            child.p = q.p + tM * (c == 0u ? -0.5 : 0.5) * q.rM;
            vec3 bmin, bmax; fsCellBounds(cell, bmin, bmax); child.p = clamp(child.p, bmin + vec3(0.0005), bmax - vec3(0.0005));
            child.rM = max(q.rM * 0.5, FS_RADIUS_MIN_M); child.rm = min(q.rm, child.rM);
            child.flags = (q.flags & ~FS_EVIDENCE_COUNT_MASK) | max((q.flags & FS_EVIDENCE_COUNT_MASK) / 2u, 1u);
            child.surfaceId = splitId + splits * 2u + c;
            surfels[hn] = fsPack(child); evidence[hn] = halfEv;
            fsIndexInsert(page, cell, child.p, hn);
        }
        splits++;
    }
    if (ghosts != 0u) atomicAdd(gctr[FS_GCTR_GHOSTS], ghosts);
    if (merges != 0u) atomicAdd(gctr[FS_GCTR_MERGES], merges);
    if (splits != 0u) atomicAdd(gctr[FS_GCTR_SPLITS], splits);
}
