#version 450
// F4b per dirty cell (single owner): E6R evidence lifecycle (hysteretic debt, SUSPECT / RETIRING / REMOVED), deterministic merges,
// leaf compaction. (C09R-E4.1C: the major-axis split is replaced by site insertion at the worst residual, sheet_refine.)
#extension GL_GOOGLE_include_directive : require
#define FS_USE_PAGES_RO
#define FS_USE_SURFELS
#define FS_USE_EVIDENCE
#define FS_USE_INDEX
#define FS_USE_GCTR
#define FS_USE_POOLS
#define FS_USE_DIRTY
#define FS_USE_RETIRE
#include "fs_world_blocks.glsl"
#include "fs_fusion.glsl"
#include "fs_index.glsl"
#include "fs_maint.glsl"
layout(local_size_x = FS_WG_SMALL) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= FS_TK(FS_T_DIRTY_COUNT)) return;
    uint entry = dirty[FS_DIRTY_LIST(0) + i];
    uint page = entry >> 15, cell = entry & 0x7FFFu;
    uint tick = FS_TK(FS_T_TICK), tick16 = tick & 0xFFFFu, stamp = 1u + (tick % 255u);
    uint leaves[FS_MAINT_LEAVES_MAX]; uint nl = fsCollectLeaves(page, cell, leaves);
    uint ghosts = 0u, merges = 0u;
    for (uint l = 0u; l < uint(FS_MAINT_LEAVES_MAX); ++l) {
        if (l >= nl) break;
        uint leaf = leaves[l];
        uint cnt = min(idx[fsIdxLeafWord(leaf, 0u)], uint(FS_INDEX_LEAF_CAP));
        // ---- E6R evidence lifecycle: candidates expire (TTL) or die after one debt unit; promoted surfels charge the free-space narrow-phase
        //      contradictions once per observation, become SUSPECT (still topology members), and are REMOVED only from RETIRING (set by the
        //      topology pass after view diversity, persistence and neighbourhood consistency) when the debt keeps growing without positives.
        for (uint k = 0u; k < uint(FS_INDEX_LEAF_CAP); ++k) {
            if (k >= cnt) break;
            uint h = idx[fsIdxLeafWord(leaf, 2u + k)];
            FsSurfel s = surfels[h]; uint flags = fsGet_FsSurfel_evidenceFlags(s);
            if ((flags & FS_FLAG_REMOVED) != 0u) continue;
            FsSurfelEvidence ev = evidence[h];
            bool promoted = (flags & FS_FLAG_PROMOTED) != 0u;
            if (!promoted && ((tick16 - fsGet_FsSurfelEvidence_lastSeenFrame(ev)) & 0xFFFFu) > uint(FS_TRANSIENT_TTL)) {
                fsSet_FsSurfel_evidenceFlags(s, flags | FS_FLAG_REMOVED); surfels[h] = s; ghosts++; continue;   // unpromoted: no FRONT change
            }
            if (!fsEvidenceCharge(ev)) { evidence[h] = ev; continue; }
            atomicAdd(gctr[FS_GCTR_CONTRADICTIONS], 1u);
            uint debt = fsGet_FsSurfelEvidence_contradictionDebt(ev), st = fsLifeState(ev);
            if (!promoted) {
                if (debt >= uint(FS_DEBT_TRANSIENT)) { fsSet_FsSurfel_evidenceFlags(s, flags | FS_FLAG_REMOVED); surfels[h] = s; ghosts++; }
            } else if (st == FS_LIFE_ACTIVE && debt >= uint(FS_DEBT_SUSPECT)) {
                fsLifeSet(ev, FS_LIFE_SUSPECT); fsSet_FsSurfelEvidence_suspectSince(ev, tick16);
                atomicAdd(gctr[FS_GCTR_SURFEL_SUSPECT], 1u);
            } else if (st == FS_LIFE_SUSPECT && debt >= uint(FS_DEBT_RETIRE)) {
                uint age = (tick16 - fsGet_FsSurfelEvidence_suspectSince(ev)) & 0xFFFFu;
                if (age >= uint(FS_SUSPECT_MIN_TICKS) &&
                    bitCount(fsGet_FsSurfelEvidence_contradictionViews(ev)) >= int(FS_RETIRE_MIN_VIEWS))   // contradicted from >= 2 view sectors
                    fsLifeSet(ev, FS_LIFE_RETIRING);
            } else if (st == FS_LIFE_RETIRING && debt >= uint(FS_DEBT_REMOVE)) {
                fsSet_FsSurfel_evidenceFlags(s, flags | FS_FLAG_REMOVED); surfels[h] = s; ghosts++;
                atomicAdd(gctr[FS_GCTR_PROMOTED_REMOVED], 1u);
                atomicAdd(gctr[FS_GCTR_SURFEL_RETIRED], 1u);
            }
            evidence[h] = ev;
        }
        // ---- merges (§8.4): pairs inside the leaf, survivor by deterministic priority
        for (uint a = 0u; a < uint(FS_INDEX_LEAF_CAP); ++a) {
            if (a >= cnt) break;
            uint ha = idx[fsIdxLeafWord(leaf, 2u + a)];
            FsPatch pa = fsUnpack(surfels[ha]);
            if ((pa.flags & FS_FLAG_REMOVED) != 0u) continue;
            for (uint b = a + 1u; b < uint(FS_INDEX_LEAF_CAP); ++b) {
                if (b >= cnt) break;
                uint hb = idx[fsIdxLeafWord(leaf, 2u + b)];
                FsPatch pb = fsUnpack(surfels[hb]);
                if ((pb.flags & FS_FLAG_REMOVED) != 0u || !fsMergeable(pa, pb)) continue;
                FsSurfelEvidence ea = evidence[ha], eb = evidence[hb];
                bool aWins = fsSurvives(pa, ea, pb, eb);
                uint hs = aWins ? ha : hb, hd = aWins ? hb : ha;
                FsPatch ps = aWins ? pa : pb, pd = aWins ? pb : pa;
                FsSurfelEvidence es = aWins ? ea : eb, ed = aWins ? eb : ea;
                FsPatch r = fsAbsorbPatch(ps, pd);
                // the index follows the geometry (C09R-E4): a merged centre outside the owner cell is relocated, never clamped
                r.p = fsPageRangeGuard(r.p);
                uint mergedCell = fsCellOf(r.p);
                if (mergedCell != cell && !fsPushRelocation(hs, page, fsCellOf(ps.p), mergedCell, surfels[hs])) r.p = ps.p;   // list full: keep the survivor centre
                surfels[hs] = fsPack(r);
                fsSet_FsSurfelEvidence_positiveSupport(es, min(fsGet_FsSurfelEvidence_positiveSupport(es) + fsGet_FsSurfelEvidence_positiveSupport(ed), 65535u));
                fsSet_FsSurfelEvidence_contradictionDebt(es, min(fsGet_FsSurfelEvidence_contradictionDebt(es), fsGet_FsSurfelEvidence_contradictionDebt(ed)));   // E6R: absorbed support never inherits the worse debt
                fsSet_FsSurfelEvidence_viewDiversity(es, fsGet_FsSurfelEvidence_viewDiversity(es) | fsGet_FsSurfelEvidence_viewDiversity(ed));
                evidence[hs] = es;
                FsSurfel dead = surfels[hd]; fsSet_FsSurfel_evidenceFlags(dead, fsGet_FsSurfel_evidenceFlags(dead) | FS_FLAG_REMOVED); surfels[hd] = dead;
                merges++; atomicAdd(gctr[FS_GCTR_PROMOTED_REMOVED], 1u);   // fsMergeable: both promoted
                if (!aWins) break;                     // a is dead; the survivor b is visited by the outer loop
                pa = r;
            }
        }
        // ---- compact the leaf: drop removed handles; E9: the handle leaves the index here, so its canonical slot returns to the page's
        //      recycle list (reusable after this job retired and the host merged it)
        uint w = 0u;
        for (uint k = 0u; k < uint(FS_INDEX_LEAF_CAP); ++k) {
            if (k >= cnt) break;
            uint h = idx[fsIdxLeafWord(leaf, 2u + k)];
            if ((fsGet_FsSurfel_evidenceFlags(surfels[h]) & FS_FLAG_REMOVED) != 0u) { fsRecycleFree(page, h); continue; }
            idx[fsIdxLeafWord(leaf, 2u + w)] = h; w++;
        }
        idx[fsIdxLeafWord(leaf, 0u)] = w;
    }
    if (ghosts != 0u) atomicAdd(gctr[FS_GCTR_GHOSTS], ghosts);
    if (merges != 0u) atomicAdd(gctr[FS_GCTR_MERGES], merges);
}
