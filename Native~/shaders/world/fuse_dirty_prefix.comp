#version 450
// Dirty-cell compaction 2/3: exclusive prefix over the page totals (<= 1024 pages, one workgroup of 256 with
// 4 entries per thread), total -> FS_T_DIRTY_COUNT and the indirect args of the per-cell passes.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_GCTR
#define FS_USE_DIRTY
#include "fs_world_blocks.glsl"
layout(local_size_x = 256) in;
layout(push_constant) uniform Push { uint pageCount; uint cap; } pc;
shared uint sV[256];
void main() {
    uint t = gl_LocalInvocationID.x;
    uint v = 0u; uint local[4];
    for (uint k = 0u; k < 4u; ++k) { uint p = t * 4u + k; local[k] = p < pc.pageCount ? dirty[FS_DIRTY_LIST(6) + p] : 0u; v += local[k]; }
    sV[t] = v;
    barrier();
    for (uint o = 1u; o < 256u; o <<= 1u) { uint u = t >= o ? sV[t - o] : 0u; barrier(); sV[t] += u; barrier(); }
    uint base = sV[t] - v;
    for (uint k = 0u; k < 4u; ++k) { uint p = t * 4u + k; if (p < pc.pageCount) { dirty[FS_DIRTY_LIST(6) + p] = base; base += local[k]; } }
    if (t == 255u) {
        uint capv = min(pc.cap, uint(FS_DIRTY_CELLS_MAX));
        uint total = min(sV[255], capv);
        if (sV[255] > capv) atomicAdd(gctr[FS_GCTR_DIRTY_OVERFLOW], sV[255] - total);   // sliced: the rest stays dirty
        FS_TK(FS_T_DIRTY_COUNT) = total;
        FS_TK(FS_T_ARGS_DIRTY + 0) = (total + uint(FS_WG_SMALL) - 1u) / uint(FS_WG_SMALL);
        atomicAdd(gctr[FS_GCTR_DIRTY_CELLS], total);
    }
}
