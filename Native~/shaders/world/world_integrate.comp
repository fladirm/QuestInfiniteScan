#version 450
// Fusion (contract §8.2 adaptive support, §8.3 multi-sheet, §8.5 precision-weighted update, §8.6 static/motion
// evidence + free space, §8.7 no invented geometry). One thread per measurement, bounded everywhere:
//   measurement -> page hash (anchor + floor(pos / 4 m)) -> slot -> cell (+ micro bucket) -> <= FS_CANDIDATE_MAX
//   candidates -> best compatible surfel by Mahalanobis distance in the surfel frame
//     compatible: |signed plane distance| <= gate * sqrt(sigmaN_s^2 + sigmaN_m^2), dot(n_s, n_m) >= FS_ASSOC_MIN_DOT,
//                 tangent distance <= k * (radius_s + footprint_m)          (an opposite-facing surfel is never
//                 compatible: the other side of a thin wall gets its own sheet)
//     update    : precision-weighted along the normal and in the tangent plane, normal blended by precision,
//                 support radius pulled toward the measured footprint, residual variance (Welford), evidence
//                 count / staticEvidence, transient -> promoted after FS_PROMOTE_STATIC consistent observations
//     motion    : outside the gate but within FS_MOTION_BAND_M with a compatible normal -> motionEvidence (§8.6)
//     otherwise : a new TRANSIENT candidate (second sheet allowed); a duplicate created by another lane in the same
//                 tick is retired immediately (bounded re-scan of the list head)
//   free space  : when the eye origin is known, the ray eye -> point marks the cells it crosses inside this page
//                 with the tick stamp (u8 arena); world_evidence.comp turns "seen through but not observed" into
//                 motion evidence and ghost removal.
// A surfel already updated in this tick (evidence.lastSeenFrame == tick) is not updated twice: the second
// observation carries no information (§7.6) and would race the first.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_MEAS
#define FS_USE_HASH
#define FS_USE_SLOTS
#define FS_USE_SURFELS
#define FS_USE_EVIDENCE
#define FS_USE_INDEX
#define FS_USE_GCTR
#include "fs_world_blocks.glsl"
layout(std430, set = 0, binding = FS_B_NODES) buffer FreeSpaceBlock { uint freeSpace[]; };   // u8 per cell packed 4 per word (binding 7)
layout(local_size_x = FS_WG_SMALL) in;
layout(push_constant) uniform Push {
    uint ringBase; uint count; uint ringMask; uint hashMask; int anchorId; uint tick; uint flags; uint pad;
    vec4 eye0; vec4 eye1;                  // anchor-local eye origins (xyz) for sourceFlags bit 16 = 0 / 1
} pc;

bool fsPageHashLookup(FsPageKey key, out uint slot) {
    uint i = fsHashPageKey(key) & pc.hashMask;
    for (uint d = 0u; d < FS_PAGE_HASH_MAX_PROBE; ++d) {
        FsPageHashEntry e = hash[i];
        if (e.slot == FS_INDEX_NONE) return false;
        if (e.probeDistance < d) return false;
        if (fsKeyEq(e.key, key)) { slot = e.slot; return true; }
        i = (i + 1u) & pc.hashMask;
    }
    return false;
}
// u8 free-space stamp write (4 stamps per u32 word): atomicAnd/atomicOr keep the neighbours intact.
void fsStampFree(FsSlotLayout l, uint cell, uint stamp) {
    uint byteIndex = l.freeSpaceBase + cell;
    uint word = byteIndex >> 2u, shift = (byteIndex & 3u) * 8u;
    atomicAnd(freeSpace[word], ~(0xFFu << shift));
    atomicOr(freeSpace[word], (stamp & 0xFFu) << shift);
}
// Marks the cells of this page crossed by the segment eye -> point (page-local), stopping one step short of
// the point so the observed surface itself is never free. Bounded by FS_FREE_WALK_MAX steps.
void fsFreeSpaceRay(FsSlotLayout l, vec3 eye, vec3 point, uint stamp) {
    vec3 dir = point - eye; float len = length(dir);
    if (len < FS_FREE_STEP_M * 2.0) return;
    dir /= len;
    float halfE = FS_PAGE_EXTENT_M * 0.5;
    // slab entry of the page cube (component-wise, no dynamic vector indexing: Adreno gate §15.6)
    vec3 safeDir = vec3(abs(dir.x) < 1e-9 ? 1e-9 : dir.x, abs(dir.y) < 1e-9 ? 1e-9 : dir.y, abs(dir.z) < 1e-9 ? 1e-9 : dir.z);
    if (abs(dir.x) < 1e-9 && abs(eye.x) > halfE) return;
    if (abs(dir.y) < 1e-9 && abs(eye.y) > halfE) return;
    if (abs(dir.z) < 1e-9 && abs(eye.z) > halfE) return;
    vec3 t0 = (vec3(-halfE) - eye) / safeDir, t1 = (vec3(halfE) - eye) / safeDir;
    vec3 tMin = min(t0, t1), tMax = max(t0, t1);
    if (abs(dir.x) < 1e-9) { tMin.x = 0.0; tMax.x = len; }
    if (abs(dir.y) < 1e-9) { tMin.y = 0.0; tMax.y = len; }
    if (abs(dir.z) < 1e-9) { tMin.z = 0.0; tMax.z = len; }
    float tEnter = max(0.0, max(tMin.x, max(tMin.y, tMin.z)));
    float tExit = min(len, min(tMax.x, min(tMax.y, tMax.z)));
    if (tExit <= tEnter) return;
    float tEnd = min(tExit, len - FS_FREE_STEP_M);
    uint lastCell = 0xFFFFFFFFu;
    for (uint i = 0u; i < uint(FS_FREE_WALK_MAX); ++i) {
        float t = tEnter + (float(i) + 0.5) * FS_FREE_STEP_M;
        if (t >= tEnd) break;
        uint cell = fsCellOf(eye + dir * t);
        if (cell != lastCell) { fsStampFree(l, cell, stamp); lastCell = cell; }
    }
}

void main() {
    uint t = gl_GlobalInvocationID.x;
    uint count = pc.count == FS_INTEGRATE_COUNT_FROM_GCTR ? gctr[FS_G_SCAN_COUNT] : pc.count;   // live frames: GPU-written count
    if (t >= count) return;
    FsSurfaceMeasurement m = meas[(pc.ringBase + t) & pc.ringMask];
    vec3 p = vec3(m.px, m.py, m.pz);
    vec3 n = normalize(vec3(m.nx, m.ny, m.nz));
    float sigmaNm = max(m.sigmaN, FS_SIGMA_N_FLOOR_M), sigmaTm = max(m.sigmaT, FS_SIGMA_T_FLOOR_M);
    float footprint = clamp(m.footprint, FS_RADIUS_MIN_M, FS_RADIUS_MAX_M);
    FsPageKey key; key.anchorId = pc.anchorId; key.x = fsPageCoord(p.x); key.y = fsPageCoord(p.y); key.z = fsPageCoord(p.z);
    atomicAdd(gctr[FS_GCTR_PAGE_LOOKUPS], 1u);
    uint slot;
    if (!fsPageHashLookup(key, slot)) { atomicAdd(gctr[FS_GCTR_PAGE_MISSES], 1u); return; }
    if ((gctr[FS_G_FLAGS + slot] & FS_SLOT_FLAG_REBUILD) != 0u) { atomicAdd(gctr[FS_GCTR_PAGE_MISSES], 1u); return; }   // index not built yet
    FsSlotLayout l = layouts[slot];
    vec3 origin = fsPageOrigin3(key);
    vec3 local = p - origin;
    if (any(greaterThan(abs(local), vec3(FS_PAGE_EXTENT_M * 0.5 + 0.001)))) { atomicAdd(gctr[FS_GCTR_MEAS_OUT_OF_RANGE], 1u); return; }
    uint cell = fsCellOf(local);
    uint headIdx = fsListHeadIndex(l, local, cell);
    atomicAdd(gctr[FS_GCTR_CELL_LOOKUPS], 1u);
    uint tick16 = pc.tick & 0xFFFFu;

    // ---- free-space evidence (§8.6): the ray from the eye to the point crossed empty space
    if ((pc.flags & FS_INTEGRATE_FLAG_FREE_SPACE) != 0u) {
        vec3 eye = ((m.sourceFlags & 0x10000u) != 0u ? pc.eye1.xyz : pc.eye0.xyz) - origin;
        fsFreeSpaceRay(l, eye, local, 1u + (pc.tick % 255u));      // stamp is never 0 (0 = never seen through)
    }

    // ---- bounded candidate scan: best compatible surfel, best motion-band surfel
    uint cur = idx[headIdx];
    uint best = FS_INDEX_NONE, motionBest = FS_INDEX_NONE; float bestScore = 1e30, motionScore = 1e30;
    float bestD = 0.0;
    for (uint k = 0u; k < uint(FS_CANDIDATE_MAX); ++k) {
        if (cur == FS_INDEX_NONE) break;
        if (cur < l.surfelBase || cur >= l.surfelBase + l.capacity) break;     // corrupt link guard
        FsSurfel s = surfels[cur];
        uint flags = fsGet_FsSurfel_evidenceFlags(s);
        if ((flags & FS_FLAG_REMOVED) == 0u) {
            vec3 sp = fsSurfelLocalPos(s); vec3 sn = fsSurfelNormal(s);
            float ndot = dot(sn, n);
            if (ndot >= FS_ASSOC_MIN_DOT) {
                vec3 delta = local - sp;
                float d = dot(sn, delta);
                vec3 tv = delta - d * sn; float tdist = length(tv);
                float sigmaNs = fsDecodeLogSigma(fsGet_FsSurfel_sigmaN(s));
                float rM = fsDecodeLogRadius(fsGet_FsSurfel_radiusMajor(s));
                float gate = FS_ASSOC_SIGMA_GATE * sqrt(sigmaNs * sigmaNs + sigmaNm * sigmaNm);
                float reach = FS_ASSOC_TANGENT_K * (rM + footprint);
                if (tdist <= reach) {
                    float score = (d * d) / max(gate * gate, 1e-12) + (tdist * tdist) / max(reach * reach, 1e-12);
                    if (abs(d) <= gate) { if (score < bestScore) { bestScore = score; best = cur; bestD = d; } }
                    else if (abs(d) <= gate + FS_MOTION_BAND_M && score < motionScore) { motionScore = score; motionBest = cur; }
                }
            }
        }
        cur = idx[fsLinkIndex(l, cur)];
        if (k == uint(FS_CANDIDATE_MAX) - 1u && cur != FS_INDEX_NONE) atomicAdd(gctr[FS_GCTR_CANDIDATE_OVERFLOW], 1u);
    }

    // ---- update the associated surfel (precision-weighted, §8.5)
    if (best != FS_INDEX_NONE) {
        FsSurfelEvidence ev = evidence[best];
        if (fsGet_FsSurfelEvidence_lastSeenFrame(ev) == tick16) { atomicAdd(gctr[FS_GCTR_DUPLICATE_OBS], 1u); return; }
        FsSurfel s = surfels[best];
        uint flags = fsGet_FsSurfel_evidenceFlags(s);
        vec3 sp = fsSurfelLocalPos(s); vec3 sn = fsSurfelNormal(s);
        float sigmaNs = fsDecodeLogSigma(fsGet_FsSurfel_sigmaN(s));
        float sigmaTs = fsDecodeLogSigma(fsGet_FsSurfel_sigmaTMajor(s));
        float rM = fsDecodeLogRadius(fsGet_FsSurfel_radiusMajor(s)), rm = fsDecodeLogRadius(fsGet_FsSurfel_radiusMinor(s));
        float wN = 1.0 / (sigmaNs * sigmaNs), wNm = 1.0 / (sigmaNm * sigmaNm);
        float wT = 1.0 / (sigmaTs * sigmaTs), wTm = 1.0 / (sigmaTm * sigmaTm);
        float aN = wNm / (wN + wNm), aT = wTm / (wT + wTm);
        vec3 delta = local - sp;
        vec3 tangential = delta - bestD * sn;
        vec3 np = sp + sn * (bestD * aN) + tangential * aT;
        vec3 nn = normalize(sn * wN + n * wNm);
        float newSigmaN = max(sqrt(1.0 / (wN + wNm)), FS_SIGMA_N_FLOOR_M);
        float newSigmaT = max(sqrt(1.0 / (wT + wTm)), FS_SIGMA_T_FLOOR_M);
        float newR = clamp(mix(rM, footprint, aN), FS_RADIUS_MIN_M, FS_RADIUS_MAX_M);
        float newRm = clamp(mix(rm, footprint, aN), FS_RADIUS_MIN_M, newR);
        uint cnt = flags & FS_EVIDENCE_COUNT_MASK;
        // residual variance (Welford over the support count)
        float var = fsDecodeLog(fsGet_FsSurfelEvidence_varianceQ(ev), FS_SIGMA_BASE_M * FS_SIGMA_BASE_M);
        var += (bestD * bestD - var) / float(cnt + 1u);
        uint stat = min(fsGet_FsSurfelEvidence_staticEvidence(ev) + 1u, 65535u);
        cnt = min(cnt + 1u, uint(FS_EVIDENCE_COUNT_MAX));
        if ((flags & FS_FLAG_TRANSIENT) != 0u && stat >= uint(FS_PROMOTE_STATIC)) { flags = (flags & ~FS_FLAG_TRANSIENT) | FS_FLAG_PROMOTED; }
        fsSet_FsSurfel_px(s, fsEncodePos(np.x)); fsSet_FsSurfel_py(s, fsEncodePos(np.y)); fsSet_FsSurfel_pz(s, fsEncodePos(np.z));
        uint o, oh; fsSplitOct32(fsEncodeOct32(nn), o, oh);
        fsSet_FsSurfel_normalOct(s, o); fsSet_FsSurfel_normalOctHi(s, oh);
        fsSet_FsSurfel_radiusMajor(s, fsEncodeLogRadius(newR)); fsSet_FsSurfel_radiusMinor(s, fsEncodeLogRadius(newRm));
        fsSet_FsSurfel_sigmaN(s, fsEncodeLogSigma(newSigmaN));
        fsSet_FsSurfel_sigmaTMajor(s, fsEncodeLogSigma(newSigmaT)); fsSet_FsSurfel_sigmaTMinor(s, fsEncodeLogSigma(newSigmaT));
        fsSet_FsSurfel_evidenceFlags(s, (flags & ~FS_EVIDENCE_COUNT_MASK) | cnt);
        surfels[best] = s;
        fsSet_FsSurfelEvidence_staticEvidence(ev, stat);
        fsSet_FsSurfelEvidence_varianceQ(ev, fsEncodeLog(var, FS_SIGMA_BASE_M * FS_SIGMA_BASE_M));
        fsSet_FsSurfelEvidence_lastSeenFrame(ev, tick16);
        evidence[best] = ev;
        atomicAdd(gctr[FS_GCTR_SURFEL_UPDATE], 1u);
        headers[slot].dirty = 1u; atomicOr(gctr[FS_G_FLAGS + slot], FS_SLOT_FLAG_DIRTY);
        return;
    }
    // ---- motion evidence on the nearest surfel of the same orientation just outside its sigma gate (§8.6)
    if (motionBest != FS_INDEX_NONE) {
        FsSurfelEvidence ev = evidence[motionBest];
        if (fsGet_FsSurfelEvidence_lastSeenFrame(ev) != tick16) {
            fsSet_FsSurfelEvidence_motionEvidence(ev, min(fsGet_FsSurfelEvidence_motionEvidence(ev) + 1u, 65535u));
            evidence[motionBest] = ev;
        }
    }
    // ---- allocate a new transient candidate in BACK (second sheet when the hypothesis differs, §8.3/§8.5)
    uint back = atomicAdd(headers[slot].backCount, 1u);
    if (back >= l.capacity) { atomicAdd(gctr[FS_GCTR_BACK_OVERFLOW], 1u); return; }
    uint g = l.surfelBase + back;
    FsSurfel s;
    s.px_py = 0u; s.pz_normalOct = 0u; s.normalOctHi_tangentAngle = 0u; s.radiusMajor_radiusMinor = 0u;
    s.sigmaN_sigmaTMajor = 0u; s.sigmaTMinor_evidenceFlags = 0u;
    fsSet_FsSurfel_px(s, fsEncodePos(local.x)); fsSet_FsSurfel_py(s, fsEncodePos(local.y)); fsSet_FsSurfel_pz(s, fsEncodePos(local.z));
    uint o, oh; fsSplitOct32(fsEncodeOct32(n), o, oh);
    fsSet_FsSurfel_normalOct(s, o); fsSet_FsSurfel_normalOctHi(s, oh);
    uint r = fsEncodeLogRadius(footprint);
    fsSet_FsSurfel_radiusMajor(s, r); fsSet_FsSurfel_radiusMinor(s, r);
    fsSet_FsSurfel_sigmaN(s, fsEncodeLogSigma(sigmaNm));
    fsSet_FsSurfel_sigmaTMajor(s, fsEncodeLogSigma(sigmaTm)); fsSet_FsSurfel_sigmaTMinor(s, fsEncodeLogSigma(sigmaTm));
    fsSet_FsSurfel_evidenceFlags(s, 1u | FS_FLAG_TRANSIENT | FS_FLAG_SIDED_A | ((m.sourceFlags & 0x100u) != 0u ? FS_FLAG_DETAIL : 0u));
    s.surfaceId = atomicAdd(gctr[FS_GCTR_NEXT_SURFACE_ID], 1u);        // stable id counter (never a physical slot, §9.3)
    s.appearanceHandle = fsPreviewColorFromNormal(n);
    surfels[g] = s;
    FsSurfelEvidence ev; ev.staticEvidence_motionEvidence = 1u; ev.varianceQ_lastSeenFrame = tick16 << 16;
    evidence[g] = ev;
    uint old = atomicExchange(idx[headIdx], g);
    idx[fsLinkIndex(l, g)] = old;
    // duplicate guard: another lane of this tick may have created the same candidate just before us
    uint scan = old;
    for (uint k = 0u; k < uint(FS_CANDIDATE_MAX); ++k) {
        if (scan == FS_INDEX_NONE || scan < l.surfelBase || scan >= l.surfelBase + l.capacity) break;
        FsSurfel q = surfels[scan];
        uint qf = fsGet_FsSurfel_evidenceFlags(q);
        if ((qf & (FS_FLAG_TRANSIENT | FS_FLAG_REMOVED)) == FS_FLAG_TRANSIENT && fsGet_FsSurfelEvidence_lastSeenFrame(evidence[scan]) == tick16 && (qf & FS_EVIDENCE_COUNT_MASK) == 1u) {
            vec3 qp = fsSurfelLocalPos(q); vec3 qn = fsSurfelNormal(q);
            float d = dot(qn, local - qp);
            if (dot(qn, n) >= FS_ASSOC_MIN_DOT && abs(d) <= FS_ASSOC_SIGMA_GATE * sigmaNm * 1.4142 && length((local - qp) - d * qn) <= FS_ASSOC_TANGENT_K * 2.0 * footprint) {
                fsSet_FsSurfel_evidenceFlags(s, (fsGet_FsSurfel_evidenceFlags(s) | FS_FLAG_REMOVED)); surfels[g] = s;
                atomicAdd(gctr[FS_GCTR_DUPLICATE_OBS], 1u);
                return;
            }
        }
        scan = idx[fsLinkIndex(l, scan)];
    }
    uint c = atomicAdd(idx[fsCountIndex(l, cell)], 1u) + 1u;
    if (c > uint(FS_CELL_OVERFLOW_THRESHOLD) && (idx[fsHeadIndex(l, cell)] & FS_CELL_HEAD_SUBDIV_BIT) == 0u) {
        atomicAdd(gctr[FS_GCTR_INDEX_OVERFLOW], 1u); atomicOr(gctr[FS_G_FLAGS + slot], FS_SLOT_FLAG_REBUILD);   // persists -> rebuild subdivides
    }
    atomicAdd(gctr[FS_GCTR_SURFEL_CREATE], 1u);
    headers[slot].dirty = 1u; atomicOr(gctr[FS_G_FLAGS + slot], FS_SLOT_FLAG_DIRTY);
}
