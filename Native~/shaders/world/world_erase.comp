#version 450
// ERASE (contract §18.3; C23 finalises the tool): one thread per (page, cell) of every resident page; cells
// intersecting the sphere mark their live surfels inside it REMOVED (canonical deletion authority) and become
// dirty so publication retires them. Bounded: 32768 cells per page, subtree walk bounded like maintenance.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_PAGES_RO
#define FS_USE_SURFELS
#define FS_USE_INDEX
#define FS_USE_GCTR
#define FS_USE_DIRTY
#include "fs_world_blocks.glsl"
#define FS_MAINT_LEAVES_MAX 64
#define FS_MAINT_STACK 32
layout(local_size_x = FS_WG_SMALL) in;
layout(push_constant) uniform Push { int anchorId; float cx; float cy; float cz; float radius; } pc;
uint fsCollectLeaves(uint page, uint cell, out uint leaves[FS_MAINT_LEAVES_MAX]) {
    uint n = 0u; uint stack[FS_MAINT_STACK]; uint sp = 0u;
    uint e = idx[fsIdxDirWord(page, cell)];
    if (e == 0u) return 0u;
    stack[sp++] = e;
    for (uint it = 0u; it < 256u; ++it) {
        if (sp == 0u) break;
        e = stack[--sp];
        if (fsEntryIsLeaf(e)) { uint leaf = fsEntryId(e); for (uint c = 0u; c < uint(FS_INDEX_CHAIN_MAX); ++c) { if (leaf == FS_INDEX_NONE || n >= uint(FS_MAINT_LEAVES_MAX)) break; leaves[n++] = leaf; leaf = idx[fsIdxLeafWord(leaf, 1u)]; } }
        else if (fsEntryIsNode(e)) for (int k = 7; k >= 0; --k) { uint ce = idx[fsIdxNodeWord(fsEntryId(e), uint(k))]; if (ce != 0u && sp < uint(FS_MAINT_STACK)) stack[sp++] = ce; }
    }
    return n;
}
void main() {
    uint page = gl_WorkGroupID.y, cell = gl_GlobalInvocationID.x;
    if (cell >= uint(FS_CELLS_PER_PAGE) || pages[page].generation == 0u || pages[page].key.anchorId != pc.anchorId) return;
    vec3 c = vec3(pc.cx, pc.cy, pc.cz) - fsPageOrigin3(pages[page].key);
    vec3 bmin, bmax; fsCellBounds(cell, bmin, bmax);
    vec3 q = clamp(c, bmin, bmax);
    if (dot(q - c, q - c) > pc.radius * pc.radius) return;
    uint leaves[FS_MAINT_LEAVES_MAX]; uint nl = fsCollectLeaves(page, cell, leaves);
    uint removed = 0u;
    for (uint l = 0u; l < uint(FS_MAINT_LEAVES_MAX); ++l) {
        if (l >= nl) break;
        uint cnt = min(idx[fsIdxLeafWord(leaves[l], 0u)], uint(FS_INDEX_LEAF_CAP)), w = 0u;
        for (uint k = 0u; k < uint(FS_INDEX_LEAF_CAP); ++k) {
            if (k >= cnt) break;
            uint h = idx[fsIdxLeafWord(leaves[l], 2u + k)];
            FsSurfel s = surfels[h]; uint flags = fsGet_FsSurfel_evidenceFlags(s);
            if ((flags & FS_FLAG_REMOVED) == 0u && distance(fsSurfelLocalPos(s), c) <= pc.radius) { fsSet_FsSurfel_evidenceFlags(s, flags | FS_FLAG_REMOVED); surfels[h] = s; removed++; continue; }
            if ((flags & FS_FLAG_REMOVED) != 0u) continue;
            idx[fsIdxLeafWord(leaves[l], 2u + w)] = h; w++;
        }
        idx[fsIdxLeafWord(leaves[l], 0u)] = w;
    }
    if (removed != 0u) { atomicAdd(gctr[FS_GCTR_GHOSTS], removed); fsMarkDirtyCell(page, cell); }
}
