#version 450
// ERASE 2/2 (contract §18.3 preview; C23 finalises): marks BACK surfels within `radius` of the
// anchor-local centre as removed and flags the page dirty. Bounded: one thread per BACK surfel, y = list index.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_SLOTS
#define FS_USE_SURFELS
#define FS_USE_GCTR
#include "fs_world_blocks.glsl"
layout(local_size_x = FS_WG_SMALL) in;
layout(push_constant) uniform Push { uint slotCount; int anchorId; float cx; float cy; float cz; float radius; uint maxCapGroups; } pc;
void main() {
    uint k = gl_WorkGroupID.y; if (k >= gctr[FS_G_ERASE_COUNT]) return;
    uint slot = gctr[FS_G_ERASE_LIST + k];
    FsSlotLayout l = layouts[slot];
    uint i = gl_GlobalInvocationID.x;
    if (i >= min(headers[slot].backCount, l.capacity)) return;
    uint g = l.surfelBase + i;
    FsSurfel s = surfels[g];
    uint flags = fsGet_FsSurfel_evidenceFlags(s);
    if ((flags & FS_FLAG_REMOVED) != 0u) return;
    vec3 local = vec3(pc.cx, pc.cy, pc.cz) - fsPageOrigin3(headers[slot].key);
    if (distance(fsSurfelLocalPos(s), local) > pc.radius) return;
    fsSet_FsSurfel_evidenceFlags(s, flags | FS_FLAG_REMOVED);
    surfels[g] = s;
    headers[slot].dirty = 1u; atomicOr(gctr[FS_G_FLAGS + slot], FS_SLOT_FLAG_DIRTY);
    atomicAdd(gctr[FS_GCTR_SURFEL_DELETE], 1u);
}
