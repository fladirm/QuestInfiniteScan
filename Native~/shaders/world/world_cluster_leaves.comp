#version 450
// ClusterTree build 1/3 (contract §13.4), batched over the publish list: thread = global leaf index,
// page found by its leaf base (<= 32 pages). Twin of fs::world::BuildLeaf over the Morton-sorted FRONT.
// ownError = repRadius (bounds half-diagonal); parentError written by the parent (or INF for 1-node trees).
#extension GL_GOOGLE_include_directive : require
#define FS_USE_SLOTS
#define FS_USE_SURFELS
#define FS_USE_ERRORS
#define FS_USE_GCTR
#define FS_USE_NODES
#include "fs_world_blocks.glsl"
layout(local_size_x = FS_WG_SMALL) in;
void main() {
    uint t = gl_GlobalInvocationID.x;
    uint n = min(gctr[FS_G_PUBLISH_COUNT], uint(FS_MAINT_MAX_PAGES));
    uint k = 0u;
    for (uint p = 1u; p < uint(FS_MAINT_MAX_PAGES); ++p) { if (p >= n) break; if (gctr[uint(FS_G_PUBLISH_INFO) + p * uint(FS_G_INFO_WORDS) + 6u] <= t) k = p; }
    if (n == 0u) return;
    uint info = uint(FS_G_PUBLISH_INFO) + k * uint(FS_G_INFO_WORDS);
    uint slot = gctr[info + 0], total = gctr[info + 1], shift = gctr[info + 2], parity = gctr[info + 3];
    uint j = t - gctr[info + 6];
    FsClusterLayout L = fsClusterLayout(total, shift);
    if (L.levels == 0u || j >= L.count[0]) return;
    FsSlotLayout l = layouts[slot];
    uint front = fsFrontOffset(l, parity);
    uint first = j * L.leafSize;
    uint cnt = min(L.leafSize, total - first);
    vec3 bmin = vec3(1e30), bmax = vec3(-1e30), nsum = vec3(0.0), csum = vec3(0.0), colsum = vec3(0.0);
    float rmax = 0.0; uint used = 0u;
    for (uint i = 0u; i < uint(FS_CLUSTER_LEAF_LOOP_MAX); ++i) {
        if (i >= cnt) break;
        FsSurfel s = surfels[front + first + i];
        vec3 p = fsSurfelLocalPos(s); vec3 nn = fsSurfelNormal(s);
        float rM = fsDecodeLogRadius(fsGet_FsSurfel_radiusMajor(s));
        bmin = min(bmin, p - vec3(rM)); bmax = max(bmax, p + vec3(rM)); csum += p; nsum += nn;
        colsum += vec3(float(s.appearanceHandle & 0xFFu), float((s.appearanceHandle >> 8) & 0xFFu), float((s.appearanceHandle >> 16) & 0xFFu));
        rmax = max(rmax, rM); used++;
    }
    if (used == 0u) { bmin = vec3(0.0); bmax = vec3(0.0); }
    float inv = used > 0u ? 1.0 / float(used) : 0.0;
    float nl = length(nsum);
    vec3 axis = vec3(0.0, 0.0, 1.0); float coneCos = -1.0;
    if (nl > 1e-6) {
        axis = nsum / nl; coneCos = 1.0;
        for (uint i = 0u; i < uint(FS_CLUSTER_LEAF_LOOP_MAX); ++i) { if (i >= used) break; coneCos = min(coneCos, dot(axis, fsSurfelNormal(surfels[front + first + i]))); }
    }
    FsClusterNode nd;
    nd.bmin[0] = bmin.x; nd.bmin[1] = bmin.y; nd.bmin[2] = bmin.z; nd.bmax[0] = bmax.x; nd.bmax[1] = bmax.y; nd.bmax[2] = bmax.z;
    nd.coneAxis[0] = axis.x; nd.coneAxis[1] = axis.y; nd.coneAxis[2] = axis.z; nd.coneCos = coneCos;
    vec3 c = csum * inv; nd.repCenter[0] = c.x; nd.repCenter[1] = c.y; nd.repCenter[2] = c.z;
    vec3 d = bmax - bmin; nd.repRadius = max(0.5 * length(d), rmax);
    nd.repNormalOct32 = fsEncodeOct32(axis);
    uvec3 col = uvec3(colsum * inv + vec3(0.5));
    nd.repColorOrHandle = (col.x & 0xFFu) | ((col.y & 0xFFu) << 8) | ((col.z & 0xFFu) << 16) | 0xFF000000u;
    // footprint ellipse + projected occupancy (coverage preserves gaps; twin of BuildLeaf)
    vec3 t1, t2; fsTangentFrame(axis, t1, t2);
    float fa, fb, fcx, fcy; fsFootprintOfAabb(bmin, bmax, t1, t2, fa, fb, fcx, fcy);
    fa = max(fa, rmax); fb = max(fb, rmax);
    uint occLo = 0u, occHi = 0u;
    for (uint i = 0u; i < uint(FS_CLUSTER_LEAF_LOOP_MAX); ++i) {
        if (i >= used) break;
        vec3 p = fsSurfelLocalPos(surfels[front + first + i]);
        float u = (dot(p, t1) - fcx) / fa, v = (dot(p, t2) - fcy) / fb;
        if (u * u + v * v > 1.0) continue;
        uint cx = uint(clamp(int(floor((u + 1.0) * 0.5 * float(FS_COVERAGE_GRID))), 0, FS_COVERAGE_GRID - 1));
        uint cy = uint(clamp(int(floor((v + 1.0) * 0.5 * float(FS_COVERAGE_GRID))), 0, FS_COVERAGE_GRID - 1));
        uint bit = cy * uint(FS_COVERAGE_GRID) + cx;
        if (bit < 32u) occLo |= 1u << bit; else occHi |= 1u << (bit - 32u);
    }
    uint occupied = 0u;
    for (uint cy = 0u; cy < uint(FS_COVERAGE_GRID); ++cy) for (uint cx = 0u; cx < uint(FS_COVERAGE_GRID); ++cx) {
        uint bit = cy * uint(FS_COVERAGE_GRID) + cx;
        bool set = bit < 32u ? ((occLo >> bit) & 1u) != 0u : ((occHi >> (bit - 32u)) & 1u) != 0u;
        if (set && fsCoverageCellInside(cx, cy)) occupied++;
    }
    float cov = used > 0u ? min(float(occupied) / float(FS_COVERAGE_INSIDE_CELLS), 1.0) : 0.0;
    nd.coverage_surfelCount = 0u;
    fsSet_FsClusterNode_coverage(nd, uint(cov * 65535.0 + 0.5)); fsSet_FsClusterNode_surfelCount(nd, min(used, 65535u));
    nd.firstChildOrSurfel = front + first;
    nd.childCount_leafSurfelCount = 0u;
    fsSet_FsClusterNode_childCount(nd, 0u); fsSet_FsClusterNode_leafSurfelCount(nd, min(cnt, 65535u));
    nd.reserved = fsPackFootprint(fa, fb);
    uint ni = l.nodeBase + parity * l.nodesPerSlot + L.offset[0] + j;
    nodes[ni] = nd;
    FsClusterError e; e.ownError = nd.repRadius; e.parentError = (L.levels == 1u) ? FS_CLUSTER_ERROR_INF : 0.0;
    errors[ni] = e;
}
