#version 450
// F4a per dirty cell: plan. Counts the splits the apply pass will perform (deterministic ids need a prefix)
// into SEGNEW[dirtyIndex]; reads only.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_SURFELS_RO
#define FS_USE_EVIDENCE_RO
#define FS_USE_INDEX_RO
#define FS_USE_GCTR
#define FS_USE_SORT
#define FS_USE_DIRTY_RO
#include "fs_world_blocks.glsl"
#include "fs_fusion.glsl"
#include "fs_maint.glsl"
layout(local_size_x = FS_WG_SMALL) in;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(FS_TICK_MEAS_MAX)) return;
    uint n = 0u;
    if (i < FS_TK(FS_T_DIRTY_COUNT)) {
        uint entry = dirty[FS_DIRTY_LIST(0) + i];
        uint page = entry >> 15, cell = entry & 0x7FFFu;
        uint leaves[FS_MAINT_LEAVES_MAX]; uint nl = fsCollectLeaves(page, cell, leaves);
        for (uint l = 0u; l < uint(FS_MAINT_LEAVES_MAX); ++l) {
            if (l >= nl) break;
            uint cnt = min(idx[fsIdxLeafWord(leaves[l], 0u)], uint(FS_INDEX_LEAF_CAP));
            for (uint k = 0u; k < uint(FS_INDEX_LEAF_CAP); ++k) {
                if (k >= cnt) break;
                uint h = idx[fsIdxLeafWord(leaves[l], 2u + k)];
                FsPatch q = fsUnpack(surfels[h]);
                if ((q.flags & FS_FLAG_REMOVED) == 0u && fsSplitWanted(q, evidence[h]) && n < uint(FS_SPLITS_PER_CELL)) n++;
            }
        }
    }
    sortw[FS_SORT_SEGNEW + i] = n;
}
