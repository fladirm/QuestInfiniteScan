#version 450
// E4.1R 3/3 apply (one dispatch over the batch): every surfel writes only itself and its own node. Flat sheet -> centre moved
// along the fitted normal by FS_SHEET_BLEND of the offset, normal blended toward the fit; the canonical radii are NOT touched
// (statistical support stays statistical). Node meta = mutual degree + derived coverage radius, component label. A centre that
// crossed its cell emits a relocation record; the cell is marked dirty for the next publication. Clears the graph-dirty bit.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_PAGES_RO
#define FS_USE_SURFELS
#define FS_USE_GCTR
#define FS_USE_SHEET
#define FS_USE_DIRTY
#include "fs_world_blocks.glsl"
#include "fs_fusion.glsl"
layout(local_size_x = FS_WG_SMALL) in;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= FS_TK(FS_T_SHEET_COUNT)) return;
    uint e = sheet[FS_TK(FS_T_SHEET_RING_BASE) + ((FS_TK(FS_T_SHEET_BEGIN) + i) & (uint(FS_SHEET_RING_CAP) - 1u))];
    uint page = e >> 22, h = e & 0x3FFFFFu;
    if (!fsSheetMarked(h)) return;
    atomicAnd(sheet[FS_TK(FS_T_SHEET_MASK_BASE) + (h >> 5u)], ~(1u << (h & 31u)));
    uint dw = fsSheetDeltaWord(i, 0u);
    uint flags = sheet[dw + 2u];
    sheet[fsSheetNodeWord(h, 6u)] = ((flags >> 4) & 15u) << 24 | (flags >> 16);
    sheet[fsSheetNodeWord(h, 7u)] = sheet[dw + 3u];
    if ((flags & 1u) == 0u) return;
    FsSurfel s = surfels[h];
    FsPatch a = fsUnpack(s);
    if ((a.flags & (FS_FLAG_REMOVED | FS_FLAG_TRANSIENT)) != 0u) return;
    uint oldCell = fsCellOf(a.p);
    vec3 nFit = fsDecodeOct32(sheet[dw + 1u]);
    a.p = fsPageRangeGuard(a.p + nFit * (uintBitsToFloat(sheet[dw]) * FS_SHEET_BLEND));
    a.n = normalize(mix(a.n, nFit, FS_SHEET_BLEND));
    uint newCell = fsCellOf(a.p);
    if (newCell != oldCell && !fsPushRelocation(h, page, oldCell, newCell, s)) return;   // list full: the fit waits
    surfels[h] = fsPack(a);
    fsMarkDirtyCell(page, oldCell);
    atomicAdd(gctr[FS_GCTR_SHEET_SMOOTHED], 1u);
}
