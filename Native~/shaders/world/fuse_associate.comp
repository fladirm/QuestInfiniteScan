#version 450
// F0 association (contract §8.3, §8.5; C09R-B): read-only against the epoch's immutable canonical/index
// generation. Per measurement: page hash lookup, owner cell, the 2x2x2 global-grid cell neighbourhood (drifted surfels near a
// boundary; E9: a neighbour cell beyond the page resolves through the page hash into the NEIGHBOURING logical page, so a surface
// crossing a 4 m page seam associates instead of being born again), bounded candidate scan through the leaf chains, best
// compatible surfel by the E9 Mahalanobis distance (fsAssocDistance: pose-aware normal residual with a source-specific hard
// bound, tangential ellipse term, normal angle). Output: FsAssociation with key = handle and pageSlot = the surfel's page
// (matched), or FS_ASSOC_KEY_UNMATCHED | pageSlot << 15 | cell of the measurement's own page, or FS_ASSOC_KEY_NONE.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_MEAS
#define FS_USE_HASH
#define FS_USE_PAGES_RO
#define FS_USE_SURFELS_RO
#define FS_USE_INDEX_RO
#define FS_USE_GCTR
#define FS_USE_ASSOC_A
#include "fs_world_blocks.glsl"
#include "fs_index.glsl"
#include "fs_fusion.glsl"
#include "fs_global_cell.glsl"
layout(local_size_x = FS_WG_SMALL) in;
layout(push_constant) uniform Push { uint hashMask; int anchorId; } pc;

void main() {
    uint t = gl_GlobalInvocationID.x;
    uint count = FS_TK(FS_T_COUNT);
    if (t >= count) return;
    FsSurfaceMeasurement m = meas[t];
    FsAssociation a; a.key = FS_ASSOC_KEY_NONE; a.meas = t; a.score = 0.0; a.pageSlot = FS_INDEX_NONE;
    vec3 p = vec3(m.px, m.py, m.pz);
    vec3 n = normalize(vec3(m.nx, m.ny, m.nz));
    float sigmaNm = max(m.sigmaN, FS_SIGMA_N_FLOOR_M);
    float footprint = clamp(m.footprint, FS_RADIUS_MIN_M, FS_RADIUS_MAX_M);
    FsPageKey key; key.anchorId = pc.anchorId; key.x = fsPageCoord(p.x); key.y = fsPageCoord(p.y); key.z = fsPageCoord(p.z);
    atomicAdd(gctr[FS_GCTR_PAGE_LOOKUPS], 1u);
    uint slot;
    if (!fsPageHashLookup(pc.hashMask, key, slot)) { atomicAdd(gctr[FS_GCTR_PAGE_MISSES], 1u); assocA[t] = a; return; }
    vec3 local = p - fsPageOrigin3(key);
    if (any(greaterThan(abs(local), vec3(FS_PAGE_EXTENT_M * 0.5 + 0.001)))) { atomicAdd(gctr[FS_GCTR_MEAS_OUT_OF_RANGE], 1u); assocA[t] = a; return; }
    uint cell = fsCellOf(local);
    a.pageSlot = slot;
    // 2x2x2 neighbourhood toward the nearer side of the cell centre, in global grid coordinates
    float halfE = FS_PAGE_EXTENT_M * 0.5;
    ivec3 c0 = ivec3(int(cell & 31u), int((cell >> 5) & 31u), int((cell >> 10) & 31u));
    vec3 f = (local + vec3(halfE)) / FS_CELL_EXTENT_M - vec3(c0);
    ivec3 dir = ivec3(f.x >= 0.5 ? 1 : -1, f.y >= 0.5 ? 1 : -1, f.z >= 0.5 ? 1 : -1);
    ivec3 g0 = ivec3(key.x, key.y, key.z) * 32 + c0;
    uint best = FS_INDEX_NONE, bestSlot = slot; float bestScore = 1e30; uint examined = 0u, gateRejects = 0u;
    for (uint k = 0u; k < uint(FS_ASSOC_NEIGHBOURHOOD); ++k) {
        ivec3 g = g0 + ivec3((k & 1u) != 0u ? dir.x : 0, (k & 2u) != 0u ? dir.y : 0, (k & 4u) != 0u ? dir.z : 0);
        uint cs, nc;
        if (!fsGlobalCell(pc.hashMask, g, slot, pc.anchorId, cs, nc)) continue;          // neighbouring page not resident
        // Never veto a whole cell from a broad free-space trace; per-surfel narrow-phase evidence handles disappearance.
        vec3 lc = p - fsPageOrigin3(pages[cs].key);                                      // measurement in the candidate page's frame
        uint leaf = fsIndexFindLeaf(cs, nc, lc);
        for (uint ch = 0u; ch < uint(FS_INDEX_CHAIN_MAX); ++ch) {
            if (leaf == FS_INDEX_NONE) break;
            uint cnt = min(idx[fsIdxLeafWord(leaf, 0u)], uint(FS_INDEX_LEAF_CAP));
            for (uint i = 0u; i < uint(FS_INDEX_LEAF_CAP); ++i) {
                if (i >= cnt) break;
                if (examined >= uint(FS_ASSOC_CANDIDATE_MAX)) { atomicAdd(gctr[FS_GCTR_CANDIDATE_OVERFLOW], 1u); break; }
                examined++;
                uint h = idx[fsIdxLeafWord(leaf, 2u + i)];
                FsSurfel s = surfels[h];
                if ((fsGet_FsSurfel_evidenceFlags(s) & FS_FLAG_REMOVED) != 0u) continue;
                float score; bool band;
                if (!fsAssocDistance(fsUnpack(s), lc, n, sigmaNm, footprint, m.sourceFlags, score, band)) { if (band) gateRejects++; continue; }
                if (score < bestScore || (score == bestScore && h < best)) { bestScore = score; best = h; bestSlot = cs; }
            }
            leaf = idx[fsIdxLeafWord(leaf, 1u)];
        }
    }
    if (gateRejects != 0u) atomicAdd(gctr[FS_GCTR_ASSOC_GATE_REJECT], gateRejects);
    atomicAdd(gctr[FS_GCTR_ASSOC_RECORDS], 1u);
    if (best != FS_INDEX_NONE) {
        a.key = best; a.score = bestScore; a.pageSlot = bestSlot; atomicAdd(gctr[FS_GCTR_ASSOC_MATCHED], 1u);
        if (bestSlot != slot) atomicAdd(gctr[FS_GCTR_ASSOC_CROSS_PAGE], 1u);
    }
    else { a.key = FS_ASSOC_KEY_UNMATCHED | (slot << 15) | cell; a.pageSlot = slot; atomicAdd(gctr[FS_GCTR_ASSOC_UNMATCHED], 1u); }
    assocA[t] = a;
}
