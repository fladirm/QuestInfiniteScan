#version 450
// Maintenance collect (GPU-driven, no CPU page enumeration): compacts flagged slots into a bounded list
// and writes the indirect dispatch args of the following passes. phase 0: slots with FS_SLOT_FLAG_REBUILD
// -> rebuild list (flag cleared). phase 1: slots with FS_SLOT_FLAG_DIRTY and no pending rebuild -> publish
// list (flag cleared). Slots beyond FS_MAINT_MAX_PAGES keep their flags for the next job. One workgroup.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_GCTR
#include "fs_world_blocks.glsl"
layout(local_size_x = FS_WG_SCAN) in;
layout(push_constant) uniform Push { uint slotCount; uint phase; uint maxCapGroups; } pc;
shared uint sCount;
void main() {
    uint t = gl_LocalInvocationID.x;
    if (t == 0u) sCount = 0u;
    barrier();
    uint want = pc.phase == 0u ? FS_SLOT_FLAG_REBUILD : FS_SLOT_FLAG_DIRTY;
    uint listBase = pc.phase == 0u ? uint(FS_G_REBUILD_LIST) : uint(FS_G_PUBLISH_LIST);
    for (uint i = 0u; i < uint(FS_MAX_SLOTS / FS_WG_SCAN); ++i) {
        uint slot = t + i * uint(FS_WG_SCAN);
        if (slot >= pc.slotCount) break;
        uint f = gctr[FS_G_FLAGS + slot];
        if ((f & want) == 0u) continue;
        if (pc.phase == 1u && (f & FS_SLOT_FLAG_REBUILD) != 0u) continue;      // index first, publish next job
        uint k = atomicAdd(sCount, 1u);
        if (k >= uint(FS_MAINT_MAX_PAGES)) continue;
        gctr[listBase + k] = slot;
        atomicAnd(gctr[FS_G_FLAGS + slot], ~want);
    }
    barrier();
    if (t != 0u) return;
    uint n = min(sCount, uint(FS_MAINT_MAX_PAGES));
    if (pc.phase == 0u) {
        gctr[FS_G_REBUILD_COUNT] = n;
        gctr[FS_G_REBUILD_ARGS_CELLS + 0] = uint(FS_CELLS_PER_PAGE / FS_WG_SMALL); gctr[FS_G_REBUILD_ARGS_CELLS + 1] = n; gctr[FS_G_REBUILD_ARGS_CELLS + 2] = 1u;
        gctr[FS_G_REBUILD_ARGS_SURF + 0] = pc.maxCapGroups; gctr[FS_G_REBUILD_ARGS_SURF + 1] = n; gctr[FS_G_REBUILD_ARGS_SURF + 2] = 1u;
    } else {
        gctr[FS_G_PUBLISH_COUNT] = n;
        gctr[FS_G_PUBLISH_ARGS_CELLS + 0] = uint(FS_CELLS_PER_PAGE / FS_WG_SMALL); gctr[FS_G_PUBLISH_ARGS_CELLS + 1] = n; gctr[FS_G_PUBLISH_ARGS_CELLS + 2] = 1u;
        gctr[FS_G_PUBLISH_ARGS_SCAN + 0] = n; gctr[FS_G_PUBLISH_ARGS_SCAN + 1] = 1u; gctr[FS_G_PUBLISH_ARGS_SCAN + 2] = 1u;
    }
}
