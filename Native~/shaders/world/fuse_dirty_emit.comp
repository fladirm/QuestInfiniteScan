#version 450
// Dirty-cell compaction 3/3: per page (one workgroup), emit (page << 15 | cell) entries in cell order at the
// page's prefix base, then clear the mask. The list order is a pure function of the mask (deterministic).
#extension GL_GOOGLE_include_directive : require
#define FS_USE_GCTR
#define FS_USE_DIRTY
#include "fs_world_blocks.glsl"
layout(local_size_x = 256) in;
shared uint sCnt[256];
void main() {
    uint page = gl_WorkGroupID.x, t = gl_LocalInvocationID.x;
    uint base = dirty[FS_DIRTY_LIST(6) + page];
    for (uint pass = 0u; pass < uint(FS_DIRTY_CELL_WORDS / 256); ++pass) {
        uint w = pass * 256u + t;
        uint m = dirty[FS_DIRTY_CELLMASK(page) + w];
        sCnt[t] = bitCount(m);
        barrier();
        for (uint o = 1u; o < 256u; o <<= 1u) { uint u = t >= o ? sCnt[t - o] : 0u; barrier(); sCnt[t] += u; barrier(); }
        uint off = base + sCnt[t] - bitCount(m);
        uint bits = m, keep = 0u;
        uint cap = FS_TK(FS_T_DIRTY_COUNT);
        for (uint k = 0u; k < 32u; ++k) {
            if (bits == 0u) break;
            uint bit = findLSB(bits); bits &= bits - 1u;
            uint idxOut = off++;
            if (idxOut < cap) dirty[FS_DIRTY_LIST(0) + idxOut] = (page << 15) | (w * 32u + bit);
            else keep |= 1u << bit;                                              // beyond the epoch cap: stays dirty (sliced)
        }
        dirty[FS_DIRTY_CELLMASK(page) + w] = keep;
        base += sCnt[255];
        barrier();
    }
}
