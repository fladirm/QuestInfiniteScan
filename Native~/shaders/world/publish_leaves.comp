#version 450
// C09R-C publication 1/2: per dirty cell (owner), build the cell's new immutable render subtree: live surfels
// of the cell subtree (deterministic order) copied into render blocks (<= 64 each), one leaf node per block,
// internal nodes over 8 blocks (<= 2 levels). The old cell subtree is retired (freed after graphics
// retirement). The cell's level-1 parent is marked dirty for publish_level. Unchanged cells keep their nodes.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_HASH
#define FS_USE_SURFELS_RO
#define FS_USE_INDEX_RO
#define FS_USE_GCTR
#define FS_USE_POOLS
#define FS_USE_DIRTY
#define FS_USE_RENDER
#define FS_USE_RBLOCKS
#define FS_USE_RDIR
#define FS_USE_RETIRE
#define FS_USE_PAGES_RO
#include "fs_world_blocks.glsl"
#include "fs_fusion.glsl"
#include "fs_render_agg.glsl"
#include "fs_sheet.glsl"          // fsFloorDiv32 (fs_global_cell.glsl requirement)
#include "fs_global_cell.glsl"
#define FS_MAINT_LEAVES_MAX 64
#define FS_MAINT_STACK 32
layout(local_size_x = FS_WG_SMALL) in;
// Sparse local remesh. Canonical surfels are the authority; this kernel derives a complete immutable cell render block.
// No persistent face/edge/sheet state is read or written.
layout(push_constant) uniform Push { uint offset; uint count; uint hashMask; uint pad; } pc;

uint fsCollectLeaves(uint page, uint cell, out uint leaves[FS_MAINT_LEAVES_MAX]) {
    uint n = 0u; uint stack[FS_MAINT_STACK]; uint sp = 0u;
    uint e = idx[fsIdxDirWord(page, cell)];
    if (e == 0u) return 0u;
    stack[sp++] = e;
    for (uint it = 0u; it < 256u; ++it) {
        if (sp == 0u) break;
        e = stack[--sp];
        if (fsEntryIsLeaf(e)) {
            uint leaf = fsEntryId(e);
            for (uint c = 0u; c < uint(FS_INDEX_CHAIN_MAX); ++c) { if (leaf == FS_INDEX_NONE || n >= uint(FS_MAINT_LEAVES_MAX)) break; leaves[n++] = leaf; leaf = idx[fsIdxLeafWord(leaf, 1u)]; }
        } else if (fsEntryIsNode(e)) {
            for (int k = 7; k >= 0; --k) { uint ce = idx[fsIdxNodeWord(fsEntryId(e), uint(k))]; if (ce != 0u && sp < uint(FS_MAINT_STACK)) stack[sp++] = ce; }
        }
    }
    return n;
}
void fsRetire(uint kind, uint id) { uint k = atomicAdd(FS_TK(FS_T_RETIRE_COUNT), 1u); if (k < uint(FS_RETIRE_MAX)) retire[k] = (kind << 30u) | id; }
// Retires an old cell subtree: node -> (children -> blocks). Bounded: <= 1 + 8 + 64 nodes.
void fsRetireSubtree(uint root) {
    if (root == FS_INDEX_NONE) return;
    FsRenderNode r = rnodes[root];
    if (fsGet_FsClusterNode_childCount(r.node) == 0u) { fsRetire(FS_RETIRE_KIND_RBLOCK, r.node.firstChildOrSurfel); fsRetire(FS_RETIRE_KIND_RNODE, root); return; }
    for (uint k = 0u; k < 8u; ++k) {
        uint c = r.child[k]; if (c == FS_INDEX_NONE) continue;
        FsRenderNode cn = rnodes[c];
        if (fsGet_FsClusterNode_childCount(cn.node) == 0u) { fsRetire(FS_RETIRE_KIND_RBLOCK, cn.node.firstChildOrSurfel); }
        else for (uint j = 0u; j < 8u; ++j) { uint g = cn.child[j]; if (g == FS_INDEX_NONE) continue; fsRetire(FS_RETIRE_KIND_RBLOCK, rnodes[g].node.firstChildOrSurfel); fsRetire(FS_RETIRE_KIND_RNODE, g); }
        fsRetire(FS_RETIRE_KIND_RNODE, c);
    }
    fsRetire(FS_RETIRE_KIND_RNODE, root);
}
// Allocates a leaf node over block `b` holding `n` surfels; FS_INDEX_NONE on pool exhaustion.
uint fsMakeLeafNode(uint b, uint n) {
    uint id = fsPoolAlloc(FS_POOL_RNODE);
    if (id == FS_INDEX_NONE) { atomicAdd(gctr[FS_GCTR_POOL_RNODE_EMPTY], 1u); return FS_INDEX_NONE; }
    FsRenderNode r; fsAggInit(r); fsAggLeaf(b * uint(FS_RENDER_BLOCK_SURFELS), n, b, r);
    rnodes[id] = r; return id;
}
uint fsMakeInternal(uint children[8]) {
    uint id = fsPoolAlloc(FS_POOL_RNODE);
    if (id == FS_INDEX_NONE) { atomicAdd(gctr[FS_GCTR_POOL_RNODE_EMPTY], 1u); return FS_INDEX_NONE; }
    FsRenderNode r; fsAggInit(r);
    for (uint k = 0u; k < 8u; ++k) r.child[k] = children[k];
    fsAggInternal(r);
    rnodes[id] = r; return id;
}

bool fsExtractCompatible(FsPatch a, vec3 pa, FsPatch b, vec3 pb) {
    float nd = dot(a.n, b.n);
    if (nd < FS_EXTRACT_MIN_DOT) return false;                          // front/back thin-wall sheets never join
    vec3 n = normalize(a.n + b.n);
    if (abs(dot(pb - pa, n)) > FS_EXTRACT_PLANE_MAX_M) return false;    // corner/depth discontinuity
    if (length(pb - pa) > FS_EXTRACT_LINK_R_M) return false;
    return true;
}

uint fsExtractRing(uint page, uint h, FsPatch a, out uint refs[FS_EXTRACT_K], out float ang[FS_EXTRACT_K]) {
    vec3 pa = fsPageOrigin3(pages[page].key) + a.p;
    ivec3 g0 = ivec3(floor((pa - vec3(FS_EXTRACT_LINK_R_M)) / FS_CELL_EXTENT_M));
    ivec3 g1 = ivec3(floor((pa + vec3(FS_EXTRACT_LINK_R_M)) / FS_CELL_EXTENT_M));
    int anchorId = pages[page].key.anchorId;
    uint best[FS_EXTRACT_K]; float bd[FS_EXTRACT_K]; uint n = 0u, examined = 0u;
    for (uint k=0u;k<uint(FS_EXTRACT_K);++k) { best[k]=FS_INDEX_NONE; bd[k]=1e30; }

    for (int z=g0.z; z<=g1.z; ++z)
    for (int y=g0.y; y<=g1.y; ++y)
    for (int x=g0.x; x<=g1.x; ++x) {
        uint slot, cell;
        if (!fsGlobalCell(pc.hashMask, ivec3(x,y,z), page, anchorId, slot, cell)) continue;
        uint ls[FS_MAINT_LEAVES_MAX]; uint nl = fsCollectLeaves(slot, cell, ls);
        vec3 org = fsPageOrigin3(pages[slot].key);
        for (uint li=0u; li<uint(FS_MAINT_LEAVES_MAX) && li<nl; ++li) {
            uint cnt=min(idx[fsIdxLeafWord(ls[li],0u)],uint(FS_INDEX_LEAF_CAP));
            for (uint j=0u;j<uint(FS_INDEX_LEAF_CAP) && j<cnt;++j) {
                uint hb=idx[fsIdxLeafWord(ls[li],2u+j)]; if (hb==h) continue;
                FsSurfel sb=surfels[hb]; uint fl=fsGet_FsSurfel_evidenceFlags(sb);
                if ((fl&(FS_FLAG_REMOVED|FS_FLAG_TRANSIENT))!=0u || (fl&FS_FLAG_PROMOTED)==0u) continue;
                if (++examined > uint(FS_EXTRACT_CAND_MAX)) continue;
                FsPatch b=fsUnpack(sb); vec3 pb=org+b.p;
                if (!fsExtractCompatible(a,pa,b,pb)) continue;
                float d=length(pb-pa); uint ref=(slot<<22)|hb;
                if (n==uint(FS_EXTRACT_K) && (d>bd[FS_EXTRACT_K-1] || (d==bd[FS_EXTRACT_K-1] && ref>=best[FS_EXTRACT_K-1]))) continue;
                uint pos=min(n,uint(FS_EXTRACT_K)-1u);
                while(pos>0u && (d<bd[pos-1u] || (d==bd[pos-1u] && ref<best[pos-1u]))) {
                    bd[pos]=bd[pos-1u]; best[pos]=best[pos-1u]; --pos;
                }
                bd[pos]=d; best[pos]=ref; if(n<uint(FS_EXTRACT_K)) ++n;
            }
        }
    }

    vec3 t1,t2; fsTangentFrame(a.n,t1,t2);
    for(uint k=0u;k<uint(FS_EXTRACT_K);++k) {
        refs[k]=k<n?best[k]:FS_INDEX_NONE;
        if(k<n) {
            uint r=best[k]; FsPatch b=fsUnpack(surfels[r&0x3FFFFFu]);
            vec3 d=fsPageOrigin3(pages[r>>22].key)+b.p-pa;
            ang[k]=atan(dot(d,t2),dot(d,t1));
        } else ang[k]=0.0;
    }
    // angle order gives a deterministic local fan; SurfaceID tie-breaking below gives unique face ownership.
    for(uint i=1u;i<uint(FS_EXTRACT_K) && i<n;++i) {
        uint rr=refs[i]; float aa=ang[i]; uint j=i;
        while(j>0u && (ang[j-1u]>aa || (ang[j-1u]==aa && surfels[refs[j-1u]&0x3FFFFFu].surfaceId>surfels[rr&0x3FFFFFu].surfaceId))) {
            refs[j]=refs[j-1u]; ang[j]=ang[j-1u]; --j;
        }
        refs[j]=rr; ang[j]=aa;
    }
    return n;
}

bool fsMakeTriangle(FsSurfel sa, uint pageA, uint bE, uint cE, out FsSurfel tri) {
    FsSurfel sb=surfels[bE&0x3FFFFFu], sc=surfels[cE&0x3FFFFFu];
    uint fa=fsGet_FsSurfel_evidenceFlags(sa), fb=fsGet_FsSurfel_evidenceFlags(sb), fc=fsGet_FsSurfel_evidenceFlags(sc);
    if (((fa|fb|fc)&(FS_FLAG_REMOVED|FS_FLAG_TRANSIENT))!=0u) return false;
    if (((fa&fb&fc)&FS_FLAG_PROMOTED)==0u) return false;
    if (sa.surfaceId>=sb.surfaceId || sa.surfaceId>=sc.surfaceId) return false; // exactly one owner

    FsPatch a=fsUnpack(sa), b=fsUnpack(sb), c=fsUnpack(sc);
    vec3 oa=fsPageOrigin3(pages[pageA].key);
    vec3 pa=oa+a.p, pb=fsPageOrigin3(pages[bE>>22].key)+b.p, pcw=fsPageOrigin3(pages[cE>>22].key)+c.p;
    if (!fsExtractCompatible(a,pa,b,pb) || !fsExtractCompatible(a,pa,c,pcw) || !fsExtractCompatible(b,pb,c,pcw)) return false;
    if (length(pb-pcw)>FS_EXTRACT_MAX_EDGE_M) return false;

    vec3 ob=pb-pa, oc=pcw-pa;
    if(any(greaterThan(abs(ob),vec3(FS_TRI_OFFSET_RANGE_M))) || any(greaterThan(abs(oc),vec3(FS_TRI_OFFSET_RANGE_M)))) return false;
    vec3 nf=cross(ob,oc); float nl=length(nf); if(nl<1e-7) return false;
    nf/=nl; if(dot(nf,a.n)<0.0) { vec3 tmp=ob; ob=oc; oc=tmp; nf=-nf; }
    if(dot(nf,a.n)<FS_EXTRACT_MIN_DOT || dot(nf,b.n)<FS_EXTRACT_MIN_DOT || dot(nf,c.n)<FS_EXTRACT_MIN_DOT) return false;

    tri=sa;
    uint o,oh; fsSplitOct32(fsEncodeOct32(nf),o,oh); fsSet_FsSurfel_normalOct(tri,o); fsSet_FsSurfel_normalOctHi(tri,oh);
    tri.radiusMajor_radiusMinor=fsTriOffsetEncode(ob);
    tri.sigmaN_sigmaTMajor=fsTriOffsetEncode(oc);
    fsSet_FsSurfel_sigmaTMinor(tri,FS_RENDER_TRI_MARK);

    uint ca=sa.appearanceHandle, cb=sb.appearanceHandle, cc=sc.appearanceHandle;
    uint obsMin=min(min(ca&FS_APPEARANCE_OBS_MASK,cb&FS_APPEARANCE_OBS_MASK),cc&FS_APPEARANCE_OBS_MASK);
    if((ca&cb&cc&FS_APPEARANCE_MEASURED)!=0u) {
        vec3 col=(vec3(float(ca&255u),float((ca>>8)&255u),float((ca>>16)&255u))+
                  vec3(float(cb&255u),float((cb>>8)&255u),float((cb>>16)&255u))+
                  vec3(float(cc&255u),float((cc>>8)&255u),float((cc>>16)&255u)))/3.0;
        uvec3 q=uvec3(clamp(col+0.5,vec3(0),vec3(255)));
        tri.appearanceHandle=FS_APPEARANCE_MEASURED|obsMin|q.x|(q.y<<8)|(q.z<<16);
    } else tri.appearanceHandle=sa.appearanceHandle&0x00FFFFFFu;
    return true;
}
void main() {
    if (gl_GlobalInvocationID.x >= pc.count) return;
    uint i = pc.offset + gl_GlobalInvocationID.x;
    if (i >= FS_TK(FS_T_DIRTY_COUNT)) return;
    uint entry = dirty[FS_DIRTY_LIST(0) + i];
    uint page = entry >> 15, cell = entry & 0x7FFFu;
    uint leaves[FS_MAINT_LEAVES_MAX]; uint nl = fsCollectLeaves(page, cell, leaves);
    // ---- copy live surfels into blocks
    uint blocks[FS_CELL_RENDER_MAX / FS_RENDER_BLOCK_SURFELS]; uint nb = 0u;
    uint curBlock = FS_INDEX_NONE, fill = 0u, total = 0u, overflow = 0u;
    for (uint l = 0u; l < uint(FS_MAINT_LEAVES_MAX); ++l) {
        if (l >= nl) break;
        uint cnt = min(idx[fsIdxLeafWord(leaves[l], 0u)], uint(FS_INDEX_LEAF_CAP));
        for (uint k = 0u; k < uint(FS_INDEX_LEAF_CAP); ++k) {
            if (k >= cnt) break;
            uint h = idx[fsIdxLeafWord(leaves[l], 2u + k)];
            FsSurfel s = surfels[h];
            // C09R-E4 authoritative FRONT: only PROMOTED geometry is published (it feeds the canonical prediction, the HZB and
            // persistence); transient candidates never reach the render tree, so a wrong depth pixel cannot confirm itself.
            if ((fsGet_FsSurfel_evidenceFlags(s) & (FS_FLAG_REMOVED | FS_FLAG_TRANSIENT)) != 0u) continue;
            // Stateless derived surface extraction. Canonical surfels remain the only persistent geometry.
            uint refs[FS_EXTRACT_K]; float angles[FS_EXTRACT_K];
            FsPatch a = fsUnpack(s);
            uint nr = fsExtractRing(page, h, a, refs, angles);

            float maxGap = 6.2831853;
            if (nr >= 2u) {
                maxGap = 0.0;
                for (uint k=0u;k<uint(FS_EXTRACT_K) && k<nr;++k) {
                    float next = k+1u<nr ? angles[k+1u] : angles[0]+6.2831853;
                    maxGap=max(maxGap,next-angles[k]);
                }
            }
            bool closed = nr>=3u && maxGap<=FS_EXTRACT_MAX_GAP_RAD;

            uint emitCount = 0u;
            FsSurfel records[1 + FS_EXTRACT_K];
            if (!closed || FS_EXTRACT_CELL_FALLBACK != 0) {
                // Boundary/unresolved surfels guarantee complete live readout while local remesh converges.
                // On a closed fan the fallback is omitted below after valid face generation.
                FsSurfel e0=s; fsSet_FsSurfel_sigmaTMinor(e0,0u);
                records[emitCount++]=e0;
            }

            uint faceCount=0u;
            if (nr>=2u) {
                for(uint k=0u;k<uint(FS_EXTRACT_K) && k<nr;++k) {
                    uint j=(k+1u)%nr;
                    float gap=(j==0u?angles[0]+6.2831853:angles[j])-angles[k];
                    if(gap>FS_EXTRACT_MAX_GAP_RAD) continue;
                    FsSurfel tri;
                    if(fsMakeTriangle(s,page,refs[k],refs[j],tri)) {
                        records[emitCount++]=tri; faceCount++;
                        if(emitCount>=1u+uint(FS_EXTRACT_K)) break;
                    }
                }
            }
            // A genuinely closed local fan is safe to render as mesh-only. Partial topology can never punch a hole.
            if(closed && faceCount>=2u && emitCount>0u && fsGet_FsSurfel_sigmaTMinor(records[0])!=FS_RENDER_TRI_MARK) {
                for(uint r=1u;r<emitCount;++r) records[r-1u]=records[r];
                emitCount--;
            }

            for (uint r = 0u; r < 1u + uint(FS_EXTRACT_K); ++r) {
                if (r >= emitCount) break;
                if (total >= uint(FS_CELL_RENDER_MAX)) { overflow++; continue; }
                if (curBlock == FS_INDEX_NONE || fill == uint(FS_RENDER_BLOCK_SURFELS)) {
                    if (curBlock != FS_INDEX_NONE) { uint ln = fsMakeLeafNode(curBlock, fill); if (ln == FS_INDEX_NONE) break; blocks[nb++] = ln; }
                    curBlock = fsPoolAlloc(FS_POOL_RBLOCK); fill = 0u;
                    if (curBlock == FS_INDEX_NONE) { atomicAdd(gctr[FS_GCTR_POOL_RBLOCK_EMPTY], 1u); break; }
                }
                rsurfels[curBlock * uint(FS_RENDER_BLOCK_SURFELS) + fill] = records[r]; fill++; total++;
            }
            if (curBlock == FS_INDEX_NONE) break;
        }
    }
    if (curBlock != FS_INDEX_NONE && fill != 0u) { uint ln = fsMakeLeafNode(curBlock, fill); if (ln != FS_INDEX_NONE) blocks[nb++] = ln; }
    if (overflow != 0u) atomicAdd(gctr[FS_GCTR_DIRTY_OVERFLOW], overflow);
    // ---- cell node: one leaf, or internal levels over 8 leaves
    uint cellNode = FS_INDEX_NONE;
    if (nb == 1u) cellNode = blocks[0];
    else if (nb > 1u && nb <= 8u) { uint ch[8]; for (uint k = 0u; k < 8u; ++k) ch[k] = k < nb ? blocks[k] : FS_INDEX_NONE; cellNode = fsMakeInternal(ch); }
    else if (nb > 8u) {
        uint groups[8]; uint ng = 0u;
        for (uint g = 0u; g < 8u; ++g) {
            uint ch[8]; bool any = false;
            for (uint k = 0u; k < 8u; ++k) { uint bi = g * 8u + k; ch[k] = bi < nb ? blocks[bi] : FS_INDEX_NONE; any = any || bi < nb; }
            groups[g] = any ? fsMakeInternal(ch) : FS_INDEX_NONE; if (any) ng++;
        }
        cellNode = fsMakeInternal(groups);
    }
    uint dirWord = page * FS_RDIR_WORDS + cell;
    uint old = rdir[dirWord];
    rdir[dirWord] = cellNode;
    fsRetireSubtree(old);
    atomicAdd(gctr[FS_GCTR_RENDER_BLOCKS], nb);
    // ---- mark the level-1 parent dirty (dedupe by bit, list append + indirect args)
    uint cx = cell & 31u, cy = (cell >> 5) & 31u, cz = (cell >> 10) & 31u;
    uint pidx = (cx >> 1) | ((cy >> 1) << 4) | ((cz >> 1) << 8);        // level 1: 16^3
    uint bit = pidx;                                                       // level 1 occupies bits [0, 4096)
    uint prev = atomicOr(dirty[FS_DIRTY_RNODEMASK(page) + (bit >> 5u)], 1u << (bit & 31u));
    if ((prev & (1u << (bit & 31u))) == 0u) {
        uint k = atomicAdd(FS_TK(FS_T_LEVEL_ARGS + 4 * 1 + 3), 1u);
        if (k < uint(FS_DIRTY_NODES_MAX)) { dirty[FS_DIRTY_LIST(1) + k] = (page << 15) | pidx; atomicMax(FS_TK(FS_T_LEVEL_ARGS + 4 * 1 + 0), (k + uint(FS_WG_SMALL)) / uint(FS_WG_SMALL)); }
    }
}
