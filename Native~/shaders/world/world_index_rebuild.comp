#version 450
// Page-local index rebuild, step 1/4 (contract §9.2, variant A), batched: y = rebuild-list index. Clears
// the slot's cell heads/counts, micro-bucket heads and pool cursor. One thread per cell (+ micro heads).
#extension GL_GOOGLE_include_directive : require
#define FS_USE_SLOTS
#define FS_USE_INDEX
#define FS_USE_GCTR
#include "fs_world_blocks.glsl"
layout(local_size_x = FS_WG_SMALL) in;
void main() {
    uint k = gl_WorkGroupID.y; if (k >= gctr[FS_G_REBUILD_COUNT]) return;
    uint slot = gctr[FS_G_REBUILD_LIST + k];
    uint i = gl_GlobalInvocationID.x;
    FsSlotLayout l = layouts[slot];
    if (i < uint(FS_CELLS_PER_PAGE)) { idx[fsHeadIndex(l, i)] = FS_INDEX_NONE; idx[fsCountIndex(l, i)] = 0u; }
    if (i < uint(FS_MICRO_BLOCKS_PER_SLOT) * 8u) idx[l.microBase + i] = FS_INDEX_NONE;
    if (i == 0u) idx[slot] = 0u;
}
