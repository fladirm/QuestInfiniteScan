#version 450
// F2 segmented fusion reduce (contract §8.2, §8.5, §8.6; C09R-B): one invocation per matched segment of the
// sorted association records = one existing surfel. Folds every contribution of the epoch (bounded by
// FS_SEG_REDUCE_MAX, the rest counted) into ONE robust observation estimate (Huber weights, the precision of a single
// measurement: the pixels of one depth frame are correlated) and applies it once per distinct observation (C09R-E4).
// Deterministic for a given sorted stream. The centre moves freely; crossing the index cell emits a relocation record.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_MEAS
#define FS_USE_PAGES_RO
#define FS_USE_SURFELS
#define FS_USE_EVIDENCE
#define FS_USE_GCTR
#define FS_USE_ASSOC_A_RO
#define FS_USE_DIRTY
#include "fs_world_blocks.glsl"
#include "fs_fusion.glsl"
layout(local_size_x = FS_WG_SMALL) in;
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint count = FS_TK(FS_T_COUNT);
    if (i >= count) return;
    uint key = assocA[i].key;
    if ((key & (FS_ASSOC_KEY_UNMATCHED | 0x40000000u)) != 0u) return;              // unmatched / rejected
    if (i > 0u && assocA[i - 1u].key == key) return;                                 // not a segment start
    uint h = key;
    FsSurfel s = surfels[h];
    FsPatch q = fsUnpack(s);
    if ((q.flags & FS_FLAG_REMOVED) != 0u) return;
    uint page = assocA[i].pageSlot;
    vec3 origin = fsPageOrigin3(pages[page].key);
    vec3 t1, t2; fsTangentFrame(q.n, t1, t2);
    FsAccum acc = fsAccumInit();
    uint overflow = 0u;
    for (uint k = 0u; k < uint(FS_SEG_REDUCE_MAX) + 1u; ++k) {
        uint j = i + k;
        if (j >= count || assocA[j].key != key) break;
        if (k == uint(FS_SEG_REDUCE_MAX)) { overflow = 1u; break; }
        FsSurfaceMeasurement m = meas[assocA[j].meas];
        vec3 pm = vec3(m.px, m.py, m.pz) - origin;
        vec3 nm = normalize(vec3(m.nx, m.ny, m.nz));
        fsAccumAdd(acc, q, t1, t2, pm, nm, max(m.sigmaN, FS_SIGMA_N_FLOOR_M), max(m.sigmaT, FS_SIGMA_T_FLOOR_M), clamp(m.footprint, FS_RADIUS_MIN_M, FS_RADIUS_MAX_M), m.reserved, m.sourceFlags, m.observationId);
    }
    if (acc.n == 0u || acc.h <= 0.0) return;
    if (overflow != 0u) atomicAdd(gctr[FS_GCTR_SEG_OVERFLOW], 1u);
    FsSurfelEvidence ev = evidence[h];
    // ---- one observation updates a surfel once (C09R-E4): a later slice of the same depth frame is not new evidence
    if (ev.lastObservationId == acc.obs && acc.obs != 0u) { atomicAdd(gctr[FS_GCTR_SEGMENTS_MATCHED], 1u); return; }
    // ---- SurfaceObservationEstimate: robust mean of the frame's contributions with the precision of ONE measurement
    const float nEff = acc.h;
    float wObsN = acc.wN / nEff, wObsT = acc.wT / nEff;
    float dMean = acc.dN / acc.wN;
    vec2 tMean = acc.tMean / acc.wT;
    vec3 nObs = normalize(acc.nSum);
    float spreadXX = max(acc.mxx / acc.wT - tMean.x * tMean.x, 0.0), spreadYY = max(acc.myy / acc.wT - tMean.y * tMean.y, 0.0), spreadXY = acc.mxy / acc.wT - tMean.x * tMean.y;
    // ---- precision-weighted update of the canonical surfel with the observation estimate
    float wNs = 1.0 / (q.sigmaN * q.sigmaN), wTs = 1.0 / (q.sigmaT * q.sigmaT);
    float aN = wObsN / (wNs + wObsN), aT = wObsT / (wTs + wObsT);
    vec3 np = q.p + q.n * (dMean * aN) + (t1 * tMean.x + t2 * tMean.y) * aT;
    vec3 nn = normalize(q.n * wNs + nObs * wObsN);
    float newSigmaN = max(sqrt(1.0 / (wNs + wObsN)), fsSigmaFloor(acc.srcAnd));
    float newSigmaT = max(sqrt(1.0 / (wTs + wObsT)), FS_SIGMA_T_FLOOR_M);
    // tangent ellipse: prior moment (distinct observations as weight) + the observation's spread (one observation)
    uint cnt = q.flags & FS_EVIDENCE_COUNT_MASK;
    float ma, mb, mc; fsPatchMoment(q, ma, mb, mc);
    float wPrior = float(max(cnt, 1u));
    float fa = (ma * wPrior + spreadXX) / (wPrior + 1.0), fb = (mb * wPrior + spreadYY) / (wPrior + 1.0), fc = (mc * wPrior + spreadXY) / (wPrior + 1.0);
    float rM, rm, ang; fsMomentToEllipse(fa, fb, fc, rM, rm, ang);
    rM = clamp(max(rM, acc.fp), FS_RADIUS_MIN_M, FS_RADIUS_MAX_M); rm = clamp(max(rm, FS_RADIUS_MIN_M), FS_RADIUS_MIN_M, rM);
    // ---- the index follows the geometry: no cell clamp; a centre that crossed its cell is relocated (SurfaceID kept)
    np = fsPageRangeGuard(np);
    uint cell = fsCellOf(q.p), newCell = fsCellOf(np);
    if (newCell != cell && !fsPushRelocation(h, page, cell, newCell, s)) np = q.p;   // list full: this observation refines everything but the centre
    // ---- evidence: one distinct observation
    // varianceQ = residual variance NORMALISED by the measurement sigma^2 (chi-square scale, E3b), averaged over observations.
    float var = fsDecodeLog(fsGet_FsSurfelEvidence_varianceQ(ev), FS_VAR_NORM_BASE);
    float meanD2 = (acc.d2 / nEff) / max(acc.s2 / nEff, 1e-12);
    var += (meanD2 - var) / float(cnt + 1u);
    uint stat = min(fsGet_FsSurfelEvidence_staticEvidence(ev) + 1u, 65535u);
    uint flags = q.flags;
    cnt = min(cnt + 1u, uint(FS_EVIDENCE_COUNT_MAX));
    if ((flags & FS_FLAG_TRANSIENT) != 0u && stat >= uint(FS_PROMOTE_STATIC)) flags = (flags & ~FS_FLAG_TRANSIENT) | FS_FLAG_PROMOTED;
    q.p = np; q.n = nn; q.angle = ang; q.rM = rM; q.rm = rm; q.sigmaN = newSigmaN; q.sigmaT = newSigmaT;
    q.flags = (flags & ~FS_EVIDENCE_COUNT_MASK) | cnt;
    if (acc.colW > 0.0) q.appearance = fsBlendAppearance(q.appearance, acc.col / acc.colW, wPrior, 1.0);
    surfels[h] = fsPack(q);
    fsSet_FsSurfelEvidence_staticEvidence(ev, stat);
    fsSet_FsSurfelEvidence_varianceQ(ev, fsEncodeLog(var, FS_VAR_NORM_BASE));
    fsSet_FsSurfelEvidence_lastSeenFrame(ev, FS_TK(FS_T_TICK) & 0xFFFFu);
    ev.lastObservationId = acc.obs;
    evidence[h] = ev;
    atomicAdd(gctr[FS_GCTR_SEGMENTS_MATCHED], 1u);
    atomicAdd(gctr[FS_GCTR_CONTRIBUTIONS], acc.n);
    fsMarkDirtyCell(page, cell);
}
