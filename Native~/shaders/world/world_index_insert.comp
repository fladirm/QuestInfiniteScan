#version 450
// Index rebuild, step 4/4 (batched): pushes each non-removed BACK surfel onto its coarse or micro list
// (atomicExchange, LIFO, no CAS loop).
#extension GL_GOOGLE_include_directive : require
#define FS_USE_SLOTS
#define FS_USE_SURFELS
#define FS_USE_INDEX
#define FS_USE_GCTR
#include "fs_world_blocks.glsl"
layout(local_size_x = FS_WG_SMALL) in;
void main() {
    uint k = gl_WorkGroupID.y; if (k >= gctr[FS_G_REBUILD_COUNT]) return;
    uint slot = gctr[FS_G_REBUILD_LIST + k];
    FsSlotLayout l = layouts[slot];
    uint i = gl_GlobalInvocationID.x;
    if (i >= min(headers[slot].backCount, l.capacity)) return;
    uint g = l.surfelBase + i;
    FsSurfel s = surfels[g];
    if ((fsGet_FsSurfel_evidenceFlags(s) & FS_FLAG_REMOVED) != 0u) return;
    vec3 local = fsSurfelLocalPos(s);
    uint headIdx = fsListHeadIndex(l, local, fsCellOf(local));
    uint old = atomicExchange(idx[headIdx], g);
    idx[fsLinkIndex(l, g)] = old;
}
