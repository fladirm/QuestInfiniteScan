#version 450
// ClusterTree build 2/3, batched: thread = global node index of `level` (>= 1) across the publish list;
// aggregates its <= 8 children built by the previous dispatch; twin of fs::world::BuildInternal. Writes
// ownError and every child's parentError (monotone: union bounds => parent half-diagonal >= child's).
#extension GL_GOOGLE_include_directive : require
#define FS_USE_SLOTS
#define FS_USE_ERRORS
#define FS_USE_GCTR
#define FS_USE_NODES
#include "fs_world_blocks.glsl"
layout(local_size_x = FS_WG_SMALL) in;
layout(push_constant) uniform Push { uint level; } pc;
void main() {
    uint t = gl_GlobalInvocationID.x;
    uint n = min(gctr[FS_G_PUBLISH_COUNT], uint(FS_MAINT_MAX_PAGES));
    uint k = 0u;
    for (uint p = 1u; p < uint(FS_MAINT_MAX_PAGES); ++p) { if (p >= n) break; if (gctr[uint(FS_G_PUBLISH_INFO) + p * uint(FS_G_INFO_WORDS) + 6u + pc.level] <= t) k = p; }
    if (n == 0u) return;
    uint info = uint(FS_G_PUBLISH_INFO) + k * uint(FS_G_INFO_WORDS);
    uint slot = gctr[info + 0], total = gctr[info + 1], shift = gctr[info + 2], parity = gctr[info + 3];
    uint j = t - gctr[info + 6 + pc.level];
    FsClusterLayout L = fsClusterLayout(total, shift);
    if (pc.level == 0u || pc.level >= L.levels || j >= L.count[pc.level]) return;
    FsSlotLayout l = layouts[slot];
    uint nb = l.nodeBase + parity * l.nodesPerSlot;
    uint firstChild = L.offset[pc.level - 1u] + j * uint(FS_CLUSTER_FANOUT);
    uint cc = min(uint(FS_CLUSTER_FANOUT), L.count[pc.level - 1u] - j * uint(FS_CLUSTER_FANOUT));
    vec3 bmin = vec3(1e30), bmax = vec3(-1e30), csum = vec3(0.0), asum = vec3(0.0), colsum = vec3(0.0);
    float areaSum = 0.0, wsum = 0.0; uint count = 0u; bool anyDir = false;
    for (uint i = 0u; i < uint(FS_CLUSTER_FANOUT); ++i) {
        if (i >= cc) break;
        FsClusterNode c = nodes[nb + firstChild + i];
        float w = max(float(fsGet_FsClusterNode_surfelCount(c)), 1.0);
        bmin = min(bmin, vec3(c.bmin[0], c.bmin[1], c.bmin[2])); bmax = max(bmax, vec3(c.bmax[0], c.bmax[1], c.bmax[2]));
        csum += vec3(c.repCenter[0], c.repCenter[1], c.repCenter[2]) * w;
        asum += vec3(c.coneAxis[0], c.coneAxis[1], c.coneAxis[2]) * w;
        colsum += vec3(float(c.repColorOrHandle & 0xFFu), float((c.repColorOrHandle >> 8) & 0xFFu), float((c.repColorOrHandle >> 16) & 0xFFu)) * w;
        areaSum += float(fsGet_FsClusterNode_coverage(c)) / 65535.0 * fsFootprintA(c.footprint) * fsFootprintB(c.footprint);   // covered footprint area / pi
        wsum += w; count += fsGet_FsClusterNode_surfelCount(c);
        if (c.coneCos <= -1.0) anyDir = true;
    }
    float inv = wsum > 0.0 ? 1.0 / wsum : 0.0;
    float al = length(asum);
    vec3 axis = vec3(0.0, 0.0, 1.0); float coneCos = -1.0;
    if (!anyDir && al > 1e-6) {
        axis = asum / al; float halfE = 0.0;
        for (uint i = 0u; i < uint(FS_CLUSTER_FANOUT); ++i) {
            if (i >= cc) break;
            FsClusterNode c = nodes[nb + firstChild + i];
            float d = clamp(dot(axis, vec3(c.coneAxis[0], c.coneAxis[1], c.coneAxis[2])), -1.0, 1.0);
            halfE = max(halfE, acos(d) + acos(clamp(c.coneCos, -1.0, 1.0)));
        }
        coneCos = halfE >= FS_PI ? -1.0 : cos(halfE);
    }
    FsClusterNode nd;
    nd.bmin[0] = bmin.x; nd.bmin[1] = bmin.y; nd.bmin[2] = bmin.z; nd.bmax[0] = bmax.x; nd.bmax[1] = bmax.y; nd.bmax[2] = bmax.z;
    nd.coneAxis[0] = axis.x; nd.coneAxis[1] = axis.y; nd.coneAxis[2] = axis.z; nd.coneCos = coneCos;
    vec3 c = csum * inv; nd.repCenter[0] = c.x; nd.repCenter[1] = c.y; nd.repCenter[2] = c.z;
    vec3 d = bmax - bmin; nd.repRadius = 0.5 * length(d);
    nd.repNormalOct32 = fsEncodeOct32(axis);
    uvec3 col = uvec3(colsum * inv + vec3(0.5));
    nd.repColorOrHandle = (col.x & 0xFFu) | ((col.y & 0xFFu) << 8) | ((col.z & 0xFFu) << 16) | 0xFF000000u;
    vec3 t1, t2; fsTangentFrame(axis, t1, t2);
    float fa, fb, fcx, fcy; fsFootprintOfAabb(bmin, bmax, t1, t2, fa, fb, fcx, fcy);
    float aggArea = fa * fb;
    float cov = clamp(aggArea > 0.0 ? areaSum / aggArea : 0.0, 0.0, 1.0);
    nd.coverage_surfelCount = 0u;
    fsSet_FsClusterNode_coverage(nd, uint(cov * 65535.0 + 0.5)); fsSet_FsClusterNode_surfelCount(nd, min(count, 65535u));
    nd.firstChildOrSurfel = firstChild;
    nd.childCount_leafSurfelCount = 0u;
    fsSet_FsClusterNode_childCount(nd, cc); fsSet_FsClusterNode_leafSurfelCount(nd, 0u);
    nd.footprint = fsPackFootprint(fa, fb);
    uint ni = nb + L.offset[pc.level] + j;
    nodes[ni] = nd;
    FsClusterError e; e.ownError = nd.repRadius; e.parentError = (pc.level + 1u == L.levels) ? FS_CLUSTER_ERROR_INF : 0.0;
    errors[ni] = e;
    for (uint i = 0u; i < uint(FS_CLUSTER_FANOUT); ++i) { if (i >= cc) break; errors[nb + firstChild + i].parentError = nd.repRadius; }
}
