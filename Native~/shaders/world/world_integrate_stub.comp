#version 450
// Integrate STUB (C12 replaces the fusion rule; contract §8.5, §9): measurement -> page hash lookup
// (anchor + floor(pos / 4 m)) -> slot -> cell (+ micro bucket) -> bounded candidate scan
// (<= FS_CANDIDATE_MAX): existing surfel within FS_ASSOC_DIST_M with normal dot > FS_ASSOC_MIN_DOT ->
// weighted update (support count as weight), else allocate in BACK (atomic per page, capacity bounded,
// overflow counted). Two measurements creating the same surfel in one job may duplicate (stub; C12).
#extension GL_GOOGLE_include_directive : require
#define FS_USE_MEAS
#define FS_USE_HASH
#define FS_USE_SLOTS
#define FS_USE_SURFELS
#define FS_USE_EVIDENCE
#define FS_USE_INDEX
#define FS_USE_GCTR
#include "fs_world_blocks.glsl"
layout(local_size_x = FS_WG_SMALL) in;
layout(push_constant) uniform Push { uint ringBase; uint count; uint ringMask; uint hashMask; int anchorId; uint tick; } pc;

bool fsPageHashLookup(FsPageKey key, out uint slot) {
    uint i = fsHashPageKey(key) & pc.hashMask;
    for (uint d = 0u; d < FS_PAGE_HASH_MAX_PROBE; ++d) {
        FsPageHashEntry e = hash[i];
        if (e.slot == FS_INDEX_NONE) return false;
        if (e.probeDistance < d) return false;
        if (fsKeyEq(e.key, key)) { slot = e.slot; return true; }
        i = (i + 1u) & pc.hashMask;
    }
    return false;
}

void main() {
    uint t = gl_GlobalInvocationID.x;
    uint count = pc.count == FS_INTEGRATE_COUNT_FROM_GCTR ? gctr[FS_G_SCAN_COUNT] : pc.count;   // live C09 frames: GPU-written count
    if (t >= count) return;
    FsSurfaceMeasurement m = meas[(pc.ringBase + t) & pc.ringMask];
    vec3 p = vec3(m.px, m.py, m.pz);
    vec3 n = normalize(vec3(m.nx, m.ny, m.nz));
    FsPageKey key; key.anchorId = pc.anchorId; key.x = fsPageCoord(p.x); key.y = fsPageCoord(p.y); key.z = fsPageCoord(p.z);
    atomicAdd(gctr[FS_GCTR_PAGE_LOOKUPS], 1u);
    uint slot;
    if (!fsPageHashLookup(key, slot)) { atomicAdd(gctr[FS_GCTR_PAGE_MISSES], 1u); return; }
    if ((gctr[FS_G_FLAGS + slot] & FS_SLOT_FLAG_REBUILD) != 0u) { atomicAdd(gctr[FS_GCTR_PAGE_MISSES], 1u); return; }   // index not built yet (fresh slot)
    FsSlotLayout l = layouts[slot];
    vec3 local = p - fsPageOrigin3(key);
    if (any(greaterThan(abs(local), vec3(FS_PAGE_EXTENT_M * 0.5 + 0.001)))) { atomicAdd(gctr[FS_GCTR_MEAS_OUT_OF_RANGE], 1u); return; }
    uint cell = fsCellOf(local);
    uint headIdx = fsListHeadIndex(l, local, cell);
    atomicAdd(gctr[FS_GCTR_CELL_LOOKUPS], 1u);
    // ---- bounded candidate scan
    uint cur = idx[headIdx];
    for (uint k = 0u; k < uint(FS_CANDIDATE_MAX); ++k) {
        if (cur == FS_INDEX_NONE) break;
        if (cur < l.surfelBase || cur >= l.surfelBase + l.capacity) break;     // corrupt link guard
        FsSurfel s = surfels[cur];
        uint flags = fsGet_FsSurfel_evidenceFlags(s);
        if ((flags & FS_FLAG_REMOVED) == 0u) {
            vec3 sp = fsSurfelLocalPos(s); vec3 sn = fsSurfelNormal(s);
            if (distance(sp, local) <= FS_ASSOC_DIST_M && dot(sn, n) > FS_ASSOC_MIN_DOT) {
                uint cnt = flags & FS_EVIDENCE_COUNT_MASK;
                float w = float(cnt) / float(cnt + 1u);
                vec3 np = mix(local, sp, w);
                vec3 nn = normalize(mix(n, sn, w));
                fsSet_FsSurfel_px(s, fsEncodePos(np.x)); fsSet_FsSurfel_py(s, fsEncodePos(np.y)); fsSet_FsSurfel_pz(s, fsEncodePos(np.z));
                uint o, oh; fsSplitOct32(fsEncodeOct32(nn), o, oh);
                fsSet_FsSurfel_normalOct(s, o); fsSet_FsSurfel_normalOctHi(s, oh);
                cnt = min(cnt + 1u, uint(FS_EVIDENCE_COUNT_MAX));
                fsSet_FsSurfel_evidenceFlags(s, (flags & ~FS_EVIDENCE_COUNT_MASK) | cnt);
                surfels[cur] = s;
                FsSurfelEvidence ev = evidence[cur];
                fsSet_FsSurfelEvidence_staticEvidence(ev, min(fsGet_FsSurfelEvidence_staticEvidence(ev) + 1u, 65535u));
                fsSet_FsSurfelEvidence_lastSeenFrame(ev, pc.tick & 0xFFFFu);
                evidence[cur] = ev;
                atomicAdd(gctr[FS_GCTR_SURFEL_UPDATE], 1u);
                headers[slot].dirty = 1u; atomicOr(gctr[FS_G_FLAGS + slot], FS_SLOT_FLAG_DIRTY);
                return;
            }
        }
        cur = idx[fsLinkIndex(l, cur)];
        if (k == uint(FS_CANDIDATE_MAX) - 1u && cur != FS_INDEX_NONE) atomicAdd(gctr[FS_GCTR_CANDIDATE_OVERFLOW], 1u);
    }
    // ---- allocate in BACK
    uint back = atomicAdd(headers[slot].backCount, 1u);
    if (back >= l.capacity) { atomicAdd(gctr[FS_GCTR_BACK_OVERFLOW], 1u); return; }
    uint g = l.surfelBase + back;
    FsSurfel s;
    s.px_py = 0u; s.pz_normalOct = 0u; s.normalOctHi_tangentAngle = 0u; s.radiusMajor_radiusMinor = 0u;
    s.sigmaN_sigmaTMajor = 0u; s.sigmaTMinor_evidenceFlags = 0u;
    fsSet_FsSurfel_px(s, fsEncodePos(local.x)); fsSet_FsSurfel_py(s, fsEncodePos(local.y)); fsSet_FsSurfel_pz(s, fsEncodePos(local.z));
    uint o, oh; fsSplitOct32(fsEncodeOct32(n), o, oh);
    fsSet_FsSurfel_normalOct(s, o); fsSet_FsSurfel_normalOctHi(s, oh);
    uint r = fsEncodeLogRadius(max(m.footprint, 0.002));
    fsSet_FsSurfel_radiusMajor(s, r); fsSet_FsSurfel_radiusMinor(s, r);
    fsSet_FsSurfel_sigmaN(s, fsEncodeLogSigma(max(m.sigmaN, 0.0001)));
    fsSet_FsSurfel_sigmaTMajor(s, fsEncodeLogSigma(max(m.sigmaT, 0.0001))); fsSet_FsSurfel_sigmaTMinor(s, fsEncodeLogSigma(max(m.sigmaT, 0.0001)));
    fsSet_FsSurfel_evidenceFlags(s, 1u | FS_FLAG_TRANSIENT);          // new candidates are transient (§8.6) until C12 promotes
    s.surfaceId = atomicAdd(gctr[FS_GCTR_NEXT_SURFACE_ID], 1u);        // stable id counter (never a physical slot, §9.3)
    s.appearanceHandle = fsPreviewColorFromNormal(n);
    surfels[g] = s;
    FsSurfelEvidence ev; ev.staticEvidence_motionEvidence = 1u; ev.varianceQ_lastSeenFrame = (pc.tick & 0xFFFFu) << 16;
    evidence[g] = ev;
    uint old = atomicExchange(idx[headIdx], g);
    idx[fsLinkIndex(l, g)] = old;
    uint c = atomicAdd(idx[fsCountIndex(l, cell)], 1u) + 1u;
    if (c > uint(FS_CELL_OVERFLOW_THRESHOLD) && (idx[fsHeadIndex(l, cell)] & FS_CELL_HEAD_SUBDIV_BIT) == 0u) {
        atomicAdd(gctr[FS_GCTR_INDEX_OVERFLOW], 1u); atomicOr(gctr[FS_G_FLAGS + slot], FS_SLOT_FLAG_REBUILD);   // persists -> rebuild subdivides
    }
    atomicAdd(gctr[FS_GCTR_SURFEL_CREATE], 1u);
    headers[slot].dirty = 1u; atomicOr(gctr[FS_G_FLAGS + slot], FS_SLOT_FLAG_DIRTY);
}
