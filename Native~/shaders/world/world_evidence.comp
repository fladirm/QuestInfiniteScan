#version 450
// Evidence pass (contract §8.6, batched over the publish list, one thread per BACK surfel): free-space
// contradiction and ghost removal. A surfel whose cell was seen through (free-space stamp == the stamp of a
// tick in which the surfel itself was NOT observed) accumulates motionEvidence; a candidate or weakly
// supported surfel is removed after FS_GHOST_MOTION_MIN contradictions, a well supported one after
// FS_GHOST_MOTION_MIN + staticEvidence / FS_GHOST_STATIC_K. Static evidence never decays by itself (§8.6:
// consistent -> canonical static). Thin surfaces survive a single miss by construction.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_SLOTS
#define FS_USE_SURFELS
#define FS_USE_EVIDENCE
#define FS_USE_GCTR
#include "fs_world_blocks.glsl"
layout(std430, set = 0, binding = FS_B_NODES) readonly buffer FreeSpaceBlock { uint freeSpace[]; };   // u8 stamps, 4 per word
layout(local_size_x = FS_WG_SMALL) in;
layout(push_constant) uniform Push { uint tick; } pc;
void main() {
    if (pc.tick == 0u) return;                                           // no scan tick since the last pass: nothing new to contradict
    uint k = gl_WorkGroupID.y; if (k >= gctr[FS_G_PUBLISH_COUNT]) return;
    uint slot = gctr[FS_G_PUBLISH_LIST + k];
    FsSlotLayout l = layouts[slot];
    uint i = gl_GlobalInvocationID.x;
    if (i >= min(headers[slot].backCount, l.capacity)) return;
    uint g = l.surfelBase + i;
    FsSurfel s = surfels[g];
    uint flags = fsGet_FsSurfel_evidenceFlags(s);
    if ((flags & FS_FLAG_REMOVED) != 0u) return;
    uint cell = fsCellOf(fsSurfelLocalPos(s));
    uint byteIndex = l.freeSpaceBase + cell;
    uint stamp = (freeSpace[byteIndex >> 2u] >> ((byteIndex & 3u) * 8u)) & 0xFFu;
    if (stamp != 1u + (pc.tick % 255u)) return;                          // not seen through in the latest scan tick
    FsSurfelEvidence ev = evidence[g];
    if (fsGet_FsSurfelEvidence_lastSeenFrame(ev) == (pc.tick & 0xFFFFu)) return;   // observed in that tick: consistent
    // seen through in the latest tick without being observed: contradiction (counted once per tick)
    uint motion = min(fsGet_FsSurfelEvidence_motionEvidence(ev) + 1u, 65535u);
    fsSet_FsSurfelEvidence_motionEvidence(ev, motion);
    uint stat = fsGet_FsSurfelEvidence_staticEvidence(ev);
    uint limit = uint(FS_GHOST_MOTION_MIN) + stat / uint(FS_GHOST_STATIC_K);
    if (motion >= limit) {
        fsSet_FsSurfel_evidenceFlags(s, flags | FS_FLAG_REMOVED);
        surfels[g] = s;
        atomicAdd(gctr[FS_GCTR_SURFEL_DELETE], 1u);
    }
    evidence[g] = ev;
}
