#version 450
// Index rebuild, step 2/4 (batched): per BACK surfel, count its cell (removed surfels are not indexed).
#extension GL_GOOGLE_include_directive : require
#define FS_USE_SLOTS
#define FS_USE_SURFELS
#define FS_USE_INDEX
#define FS_USE_GCTR
#include "fs_world_blocks.glsl"
layout(local_size_x = FS_WG_SMALL) in;
void main() {
    uint k = gl_WorkGroupID.y; if (k >= gctr[FS_G_REBUILD_COUNT]) return;
    uint slot = gctr[FS_G_REBUILD_LIST + k];
    FsSlotLayout l = layouts[slot];
    uint i = gl_GlobalInvocationID.x;
    if (i >= min(headers[slot].backCount, l.capacity)) return;
    FsSurfel s = surfels[l.surfelBase + i];
    if ((fsGet_FsSurfel_evidenceFlags(s) & FS_FLAG_REMOVED) != 0u) return;
    atomicAdd(idx[fsCountIndex(l, fsCellOf(fsSurfelLocalPos(s)))], 1u);
}
