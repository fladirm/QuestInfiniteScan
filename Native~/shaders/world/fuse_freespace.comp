#version 450
// F0b free-space evidence (contract §8.6; C09R §22): bounded page-aware ray walk from the eye to the measured point.
// IMPORTANT: a traversed 12.5 cm cell is NOT negative geometry evidence. Only an actual ray/ellipse intersection
// may contradict a surfel. The epoch evaluates a deterministic evenly-spaced subset of records so this stage has
// bounded GPU cost on the shared Quest graphics family.
// E6R narrow phase: a surfel of an occupied crossed cell is contradicted only when the ray
// actually crosses its support ellipse in front of the measured point (beyond the clearance and both sigmas, not grazing); the weighted
// hit goes to evidence.contradictionHits (atomic), the observation id to lastContradictionObs (idempotent), the ray sector to
// contradictionViews (atomic or). Maintenance charges the debt once per observation. Neighbouring layers, thin walls and leaves in the
// same 12.5 cm cell are no longer contradicted by a ray that passes beside them.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_MEAS
#define FS_USE_HASH
#define FS_USE_PAGES_RO
#define FS_USE_GCTR
#define FS_USE_FREESPACE
#define FS_USE_INDEX_RO
#define FS_USE_DIRTY
#define FS_USE_SURFELS_RO
#define FS_USE_EVIDENCE
#include "fs_world_blocks.glsl"
#include "fs_fusion.glsl"
#include "fs_maint.glsl"
layout(local_size_x = FS_WG_SMALL) in;
layout(push_constant) uniform Push { uint hashMask; int anchorId; uint flags; uint pad; vec4 eye0; vec4 eye1; } pc;

bool fsPageHashLookup(FsPageKey key, out uint slot) {
    uint i = fsHashPageKey(key) & pc.hashMask;
    for (uint d = 0u; d < FS_PAGE_HASH_MAX_PROBE; ++d) {
        FsPageHashEntry e = hash[i];
        if (e.slot == FS_INDEX_NONE) return false;
        if (e.probeDistance < d) return false;
        if (fsKeyEq(e.key, key)) { slot = e.slot; return true; }
        i = (i + 1u) & pc.hashMask;
    }
    return false;
}
void fsStamp(uint slot, uint cell, uint stamp) {
    uint byteIndex = pages[slot].freeSpaceBase + cell;
    uint word = byteIndex >> 2u, shift = (byteIndex & 3u) * 8u;
    uint cur = (freeSpace[word] >> shift) & 0xFFu;
    if (cur == stamp) return;
    atomicAnd(freeSpace[word], ~(0xFFu << shift));
    atomicOr(freeSpace[word], stamp << shift);
}
void main() {
    if ((pc.flags & FS_FUSE_FLAG_FREE_SPACE) == 0u) return;
    const uint count = FS_TK(FS_T_COUNT);
    const uint rays = min(count, uint(FS_FREE_RAYS_PER_EPOCH));
    const uint lane = gl_GlobalInvocationID.x;
    if (lane >= rays || count == 0u) return;
    // Evenly spaced over the stride-slice stream; no first-N spatial bias.
    const uint t = rays == count ? lane : min(count - 1u, (lane * count + rays / 2u) / rays);
    FsSurfaceMeasurement m = meas[t];
    vec3 p = vec3(m.px, m.py, m.pz);
    vec3 eye = (m.sourceFlags & 0x10000u) != 0u ? pc.eye1.xyz : pc.eye0.xyz;
    vec3 dir = p - eye; float len = length(dir);
    if (len < FS_FREE_STEP_M * 2.0 || len > FS_FREE_MAX_RANGE_M) return;
    dir /= len;
    float tEnd = len - FS_FREE_END_CLEARANCE_M;                       // no negative evidence near the measured hit
    uint hitCell = 0xFFFFFFFFu; int hitPageX = fsPageCoord(p.x), hitPageY = fsPageCoord(p.y), hitPageZ = fsPageCoord(p.z);
    { FsPageKey hk; hk.anchorId = pc.anchorId; hk.x = hitPageX; hk.y = hitPageY; hk.z = hitPageZ; hitCell = fsCellOf(p - fsPageOrigin3(hk)); }
    FsPageKey key; key.anchorId = pc.anchorId; key.x = 0x7FFFFFFF; key.y = 0; key.z = 0;
    uint slot = FS_INDEX_NONE; bool haveSlot = false; uint lastCell = 0xFFFFFFFFu; uint stamped = 0u, hops = 0u;
    for (uint i = 0u; i < uint(FS_FREE_WALK_MAX); ++i) {
        float tt = (float(i) + 0.5) * FS_FREE_STEP_M;
        if (tt >= tEnd) break;
        vec3 q = eye + dir * tt;
        int kx = fsPageCoord(q.x), ky = fsPageCoord(q.y), kz = fsPageCoord(q.z);
        if (kx != key.x || ky != key.y || kz != key.z) {
            if (hops >= uint(FS_FREE_PAGE_HOPS_MAX)) { atomicAdd(gctr[FS_GCTR_FREE_HOP_OVERFLOW], 1u); break; }   // hard bound (§22)
            hops++;
            key.x = kx; key.y = ky; key.z = kz;
            haveSlot = fsPageHashLookup(key, slot);
            lastCell = 0xFFFFFFFFu;
        }
        if (!haveSlot) continue;                                          // non-resident page: no evidence (C14 streams it)
        uint cell = fsCellOf(q - fsPageOrigin3(key));
        if (cell != lastCell) {
            lastCell = cell;
            if (cell == hitCell && kx == hitPageX && ky == hitPageY && kz == hitPageZ) continue;
            stamped++;     // legacy telemetry: walked unique resident cells; no cell stamp is written or trusted as geometry
            if (idx[fsIdxDirWord(slot, cell)] != 0u) {
                // narrow phase over the cell's surfels
                vec3 origin = fsPageOrigin3(key);
                uint leaves[FS_MAINT_LEAVES_MAX]; uint nl = fsCollectLeaves(slot, cell, leaves); uint hitsHere = 0u;
                for (uint l = 0u; l < uint(FS_MAINT_LEAVES_MAX); ++l) {
                    if (l >= nl) break;
                    uint cnt = min(idx[fsIdxLeafWord(leaves[l], 0u)], uint(FS_INDEX_LEAF_CAP));
                    for (uint k = 0u; k < uint(FS_INDEX_LEAF_CAP); ++k) {
                        if (k >= cnt) break;
                        uint h = idx[fsIdxLeafWord(leaves[l], 2u + k)];
                        FsPatch b = fsUnpack(surfels[h]);
                        if ((b.flags & FS_FLAG_REMOVED) != 0u) continue;
                        float dn = dot(b.n, dir);
                        if (abs(dn) < FS_FREE_GRAZE_COS) continue;
                        vec3 c = origin + b.p;
                        float th = dot(b.n, c - eye) / dn;
                        float guard = max(FS_FREE_END_CLEARANCE_M, 3.0 * sqrt(b.sigmaN * b.sigmaN + m.sigmaN * m.sigmaN));
                        if (th <= FS_FREE_STEP_M || th >= len - guard) continue;
                        vec3 hp = eye + dir * th - c;
                        vec3 tM, tm; fsPatchFrame(b, tM, tm);
                        float u = dot(hp, tM) / max(b.rM, 1e-4), v = dot(hp, tm) / max(b.rm, 1e-4);
                        if (u * u + v * v > 1.0) continue;
                        uint w = (m.sourceFlags & 3u) != 0u ? uint(FS_DEBT_W_PRECISE) : uint(FS_DEBT_W_PRIOR);
                        atomicAdd(evidence[h].contradictionHits, w);
                        evidence[h].lastContradictionObs = m.observationId;
                        atomicOr(evidence[h].viewDiversity_contradictionViews, fsViewSectorBit(b.n, -dir) << 16);
                        hitsHere++;
                    }
                }
                if (hitsHere != 0u) { fsMarkDirtyCell(slot, cell); atomicAdd(gctr[FS_GCTR_FREE_NARROW_HITS], hitsHere); }
            }
        }
    }
    if (stamped != 0u) atomicAdd(gctr[FS_GCTR_FREE_STAMPS], stamped);
}
