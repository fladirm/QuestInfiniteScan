#version 450
// C09R-C publication 2/2, one dispatch per render-tree level L = 1..5 (push constant): per dirty spatial node
// of the level, a new immutable node aggregates the current ids of its 8 spatial children (level L-1 rdir
// entries); the old node id is retired, the parent is marked dirty for level L+1. At the root level the page's
// pendingRoot / pendingCount are written and a PendingPublish entry appended (graphics applies it at FRAME_BEGIN).
#extension GL_GOOGLE_include_directive : require
#define FS_USE_PAGES
#define FS_USE_GCTR
#define FS_USE_POOLS
#define FS_USE_DIRTY
#define FS_USE_RENDER
#define FS_USE_RDIR
#define FS_USE_RETIRE
#define FS_USE_PENDING
#include "fs_world_blocks.glsl"
#include "fs_render_agg.glsl"
layout(local_size_x = FS_WG_SMALL) in;
layout(push_constant) uniform Push { uint level; } pc;
void fsRetire(uint kind, uint id) { uint k = atomicAdd(FS_TK(FS_T_RETIRE_COUNT), 1u); if (k < uint(FS_RETIRE_MAX)) retire[k] = (kind << 30u) | id; }
// bit index of spatial node (level L >= 1, index) in the page's rnode mask: levels packed 1..5
uint fsRnodeBit(uint level, uint index) { uint b = 0u, s = 16u; for (uint l = 1u; l < uint(FS_RENDER_TREE_DEPTH); ++l) { if (l >= level) break; b += s * s * s; s >>= 1u; } return b + index; }
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint L = pc.level;
    if (i >= FS_TK(FS_T_LEVEL_ARGS + 4u * L + 3u)) return;
    uint entry = dirty[FS_DIRTY_LIST(L) + i];
    uint page = entry >> 15, nidx = entry & 0x7FFFu;
    uint s = 32u >> L;                                                     // nodes per axis at this level
    uint nx = nidx % s, ny = (nidx / s) % s, nz = nidx / (s * s);
    uint sc = s * 2u;                                                      // children per axis
    uint ch[8]; bool any = false;
    for (uint k = 0u; k < 8u; ++k) {
        uint cxk = nx * 2u + (k & 1u), cyk = ny * 2u + ((k >> 1) & 1u), czk = nz * 2u + ((k >> 2) & 1u);
        uint cid = rdir[fsRdirIndex(page, L - 1u, cxk, cyk, czk)];
        ch[k] = cid; any = any || cid != FS_INDEX_NONE;
    }
    uint newId = FS_INDEX_NONE;
    if (any) {
        newId = fsPoolAlloc(FS_POOL_RNODE);
        if (newId == FS_INDEX_NONE) atomicAdd(gctr[FS_GCTR_POOL_RNODE_EMPTY], 1u);
        else { FsRenderNode r; fsAggInit(r); for (uint k = 0u; k < 8u; ++k) r.child[k] = ch[k]; fsAggInternal(r); rnodes[newId] = r; atomicAdd(gctr[FS_GCTR_COW_NODES], 1u); }
    }
    uint w = fsRdirIndex(page, L, nx, ny, nz);
    uint old = rdir[w];
    rdir[w] = newId;
    if (old != FS_INDEX_NONE) fsRetire(FS_RETIRE_KIND_RNODE, old);
    // clear this node's dirty bit (the mask is reused next epoch)
    uint bit = fsRnodeBit(L, nidx);
    atomicAnd(dirty[FS_DIRTY_RNODEMASK(page) + (bit >> 5u)], ~(1u << (bit & 31u)));
    if (L == uint(FS_RENDER_TREE_DEPTH)) {
        pages[page].pendingRoot = newId;
        pages[page].pendingCount = newId != FS_INDEX_NONE ? fsGet_FsClusterNode_surfelCount(rnodes[newId].node) : 0u;
        uint k = atomicAdd(FS_TK(FS_T_PENDING_COUNT), 1u);
        if (k < uint(FS_PENDING_PUBLISH_MAX)) { FsPendingPublish pp; pp.pageSlot = page; pp.root = newId; pp.count = pages[page].pendingCount; pp.generation = pages[page].generation; pending[k] = pp; }
        atomicAdd(gctr[FS_GCTR_ROOTS_PENDING], 1u);
        return;
    }
    uint ps = s >> 1;
    uint pidx = (nx >> 1) + (ny >> 1) * ps + (nz >> 1) * ps * ps;
    uint pbit = fsRnodeBit(L + 1u, pidx);
    uint prev = atomicOr(dirty[FS_DIRTY_RNODEMASK(page) + (pbit >> 5u)], 1u << (pbit & 31u));
    if ((prev & (1u << (pbit & 31u))) == 0u) {
        uint k = atomicAdd(FS_TK(FS_T_LEVEL_ARGS + 4u * (L + 1u) + 3u), 1u);
        if (k < uint(FS_DIRTY_NODES_MAX)) { dirty[FS_DIRTY_LIST(L + 1u) + k] = (page << 15) | pidx; atomicMax(FS_TK(FS_T_LEVEL_ARGS + 4u * (L + 1u) + 0u), (k + uint(FS_WG_SMALL)) / uint(FS_WG_SMALL)); }
    }
}
