#version 450
// Graphics-domain root publication (contract §11; C09R-C §14): recorded into Unity's command stream at
// FRAME_BEGIN after the scanner class timeline was acquired. Applies the pending root descriptors of retired
// publication jobs (list copied by the CPU into the frame ring slot) to the page table: this frame and every
// later frame read the complete new generation; no reader can observe a half-built state.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_PAGES
#include "fs_world_blocks.glsl"
layout(std430, set = 0, binding = FS_B_PENDING) readonly buffer PublishRing { FsPendingPublish ring[]; };   // FS_CULL_FRAME_RING x FS_MAX_PAGES
layout(local_size_x = FS_WG_SMALL) in;
layout(push_constant) uniform Push { uint frameSlot; uint count; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    FsPendingPublish pp = ring[pc.frameSlot * uint(FS_MAX_PAGES) + i];
    if (pages[pp.pageSlot].generation != pp.generation) return;            // the page was released meanwhile: stale publication
    pages[pp.pageSlot].renderRoot = pp.root;
    pages[pp.pageSlot].renderCount = pp.count;
}
