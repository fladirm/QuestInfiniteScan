#version 450
// Cull 2/3 (contract §13.4/§13.5): ONE indirect 2D dispatch (x = FS_CULL_NODE_GROUPS groups of 64 items,
// y = visible page) over every cluster node (or raw 64-surfel chunk of a tree-less page) of the visible
// pages; no dependent traversal, no per-thread emission loops. Per node: frustum (either eye), normal
// cone (backface), HZB BAND test (reject only when nearestDepth > occluder + margin; never inside the
// band; disabled in XRAY), then the LOD cut with monotone errors:
//   projected(parentError) <= tau        -> an ancestor represents this node: nothing
//   internal, projected(ownError) <= tau -> emit representative aggregate (coverage in alpha)
//   leaf, projected(ownError) > tau      -> append its surfel range to the leaf list (render_cull_emit)
//   leaf, projected(ownError) <= tau     -> emit representative aggregate
// tau = foveated threshold (eccentricity) x GPU-headroom bias. Aggregates go to a native scratch region;
// render_cull_compact.comp moves them right behind the opaque records (Unity derives their base from
// opaqueArgs.instanceCount / 2).
#extension GL_GOOGLE_include_directive : require
#define FS_USE_FRAME
#define FS_USE_RSLOTS
#define FS_USE_RNODES
#define FS_USE_RERRORS
#define FS_USE_WORK
#define FS_USE_HZB
#include "fs_render_common.glsl"
layout(std430, set = 0, binding = FS_RB_DRAW) writeonly buffer AggScratchBlock { FsDrawRecord aggScratch[]; };   // native scratch, compacted later
layout(local_size_x = FS_WG_SMALL) in;
layout(push_constant) uniform Push { uint frameSlot; uint aggBase; uint aggCapacity; uint opaqueCapacity; } pc;

bool fsProjectAabb(FsCullFrame F, vec3 wmin, vec3 wmax, out float nearest, out vec2 ndcMin, out vec2 ndcMax) {
    nearest = 1e30; ndcMin = vec2(1e30); ndcMax = vec2(-1e30);
    for (int i = 0; i < 8; ++i) {
        vec3 c = vec3((i & 1) != 0 ? wmax.x : wmin.x, (i & 2) != 0 ? wmax.y : wmin.y, (i & 4) != 0 ? wmax.z : wmin.z);
        nearest = min(nearest, -(F.centerView * vec4(c, 1.0)).z);
        vec4 cl = F.centerViewProj * vec4(c, 1.0);
        if (cl.w <= 1e-6) return false;
        vec2 n = cl.xy / cl.w; ndcMin = min(ndcMin, n); ndcMax = max(ndcMax, n);
    }
    return true;
}
float fsNearestDepth(FsCullFrame F, vec3 wmin, vec3 wmax) {
    float nearest = 1e30;
    for (int i = 0; i < 8; ++i) {
        vec3 c = vec3((i & 1) != 0 ? wmax.x : wmin.x, (i & 2) != 0 ? wmax.y : wmin.y, (i & 4) != 0 ? wmax.z : wmin.z);
        nearest = min(nearest, -(F.centerView * vec4(c, 1.0)).z);
    }
    return nearest;
}
void fsAppendLeafRange(uint first, uint count, uint slot) {
    uint k = atomicAdd(work[FS_WK_EMIT_ARGS], 1u);                        // indirect x of the emit pass
    if (k >= uint(FS_CULL_LEAF_LIST_CAPACITY)) { atomicAdd(work[FS_WK_STAT + FS_CSTAT_QUEUE_OVERFLOW], 1u); return; }
    work[FS_WK_LEAF_LIST + 4u * k + 0] = first; work[FS_WK_LEAF_LIST + 4u * k + 1] = count; work[FS_WK_LEAF_LIST + 4u * k + 2] = slot; work[FS_WK_LEAF_LIST + 4u * k + 3] = 0u;
    atomicAdd(work[FS_WK_STAT + FS_CSTAT_LEAVES], 1u);
    atomicAdd(work[FS_WK_STAT + FS_CSTAT_VISIBLE_SURFELS], count);
}
void fsEmitAggregate(mat4 A, vec3 origin, FsClusterNode nd) {
    uint i = atomicAdd(work[FS_WK_AGG], 1u);
    if (i >= pc.aggCapacity) { atomicAdd(work[FS_WK_STAT + FS_CSTAT_BUDGET_DROPPED], 1u); return; }
    vec3 w = (A * vec4(origin + vec3(nd.repCenter[0], nd.repCenter[1], nd.repCenter[2]), 1.0)).xyz;
    vec3 n = normalize(mat3(A) * fsDecodeOct32(nd.repNormalOct32));
    uint ra = fsRadius8FromLog16(nd.reserved & 0xFFFFu), rb = fsRadius8FromLog16(nd.reserved >> 16);   // footprint ellipse (canonical tangent frame)
    FsDrawRecord r;
    r.cx = w.x; r.cy = w.y; r.cz = w.z;
    r.normalOct32 = fsEncodeOct32(n);
    r.tangentAndRadii = (ra << 16) | (rb << 24);
    r.colorOrHandle = (nd.repColorOrHandle & 0x00FFFFFFu) | ((fsGet_FsClusterNode_coverage(nd) >> 8) << 24);
    r.surfaceId = 0u;
    r.flags = uint(FS_DRAW_FLAG_AGGREGATE);
    aggScratch[i] = r;
    atomicMax(work[FS_WK_COMPACT_ARGS], i / uint(FS_WG_SMALL) + 1u);      // indirect x of the compaction pass
    atomicAdd(work[FS_WK_STAT + FS_CSTAT_AGGREGATES], 1u);
}

void main() {
    uint k = gl_WorkGroupID.y;
    uint item = gl_WorkGroupID.x * uint(FS_WG_SMALL) + gl_LocalInvocationID.x;
    uint itemsWord = work[FS_WK_VIS_ITEMS + k];
    uint items = itemsWord & ~FS_WK_RAW_BIT;
    if (item >= items) return;
    uint slot = work[FS_WK_VIS_SLOT + k];
    FsCullFrame F = frames[pc.frameSlot];
    FsSlotLayout l = layouts[slot];
    uint root = roots[slot];
    FsPageHeader h = headers[slot];
    mat4 A = F.anchors[min(uint(max(h.key.anchorId, 0)), uint(FS_MAX_ANCHORS - 1))];
    vec3 origin = fsPageOrigin3(h.key);
    uint parity = fsRootParity(root);
    uint front = fsFrontOffset(l, parity);
    uint count = fsRootCount(root);
    atomicAdd(work[FS_WK_STAT + FS_CSTAT_NODES_VISITED], 1u);
    if ((itemsWord & FS_WK_RAW_BIT) != 0u) {                              // tree-less page: raw chunk
        uint first = item * uint(FS_CULL_RAW_CHUNK);
        if (first < count) fsAppendLeafRange(front + first, min(uint(FS_CULL_RAW_CHUNK), count - first), slot);
        return;
    }
    uint nb = l.nodeBase + parity * l.nodesPerSlot;
    FsClusterNode nd = nodes[nb + item];
    FsClusterError er = errors[nb + item];
    vec3 wmin, wmax;
    fsTransformAabb(A, origin + vec3(nd.bmin[0], nd.bmin[1], nd.bmin[2]), origin + vec3(nd.bmax[0], nd.bmax[1], nd.bmax[2]), wmin, wmax);
    float dist = length(0.5 * (wmin + wmax) - F.headPos_focal.xyz);
    float margin = dist * F.fwd_tanMargin.w;
    bool vis = fsAabbInFrustum6(F.planesL[0], F.planesL[1], F.planesL[2], F.planesL[3], F.planesL[4], F.planesL[5], wmin, wmax, margin) ||
               fsAabbInFrustum6(F.planesR[0], F.planesR[1], F.planesR[2], F.planesR[3], F.planesR[4], F.planesR[5], wmin, wmax, margin);
    if (!vis) { atomicAdd(work[FS_WK_STAT + FS_CSTAT_NODES_FRUSTUM], 1u); return; }
    vec3 centerW = (A * vec4(origin + vec3(nd.repCenter[0], nd.repCenter[1], nd.repCenter[2]), 1.0)).xyz;
    vec3 toHead = F.headPos_focal.xyz - centerW;
    // normal cone backface reject (not in PLAN mode): every direction in the cone faces away, with slack for the node extent
    if (F.misc.x != uint(FS_RENDER_MODE_PLAN) && nd.coneCos > -1.0) {
        vec3 axisW = normalize(mat3(A) * vec3(nd.coneAxis[0], nd.coneAxis[1], nd.coneAxis[2]));
        float sinHalf = sqrt(max(0.0, 1.0 - nd.coneCos * nd.coneCos));
        float slack = clamp(nd.repRadius / max(length(toHead), 1e-3), 0.0, 1.0);
        if (dot(axisW, normalize(toHead)) < -(sinHalf + slack)) { atomicAdd(work[FS_WK_STAT + FS_CSTAT_NODES_CONE], 1u); return; }
    }
    float nearest; vec2 ndcMin, ndcMax;
    bool projected = fsProjectAabb(F, wmin, wmax, nearest, ndcMin, ndcMax);
    if (projected && F.misc.x == uint(FS_RENDER_MODE_SCAN)) {              // HZB band test
        vec2 tMin = clamp((ndcMin * 0.5 + 0.5) * float(FS_HZB_SIZE), vec2(0.0), vec2(FS_HZB_SIZE - 1));
        vec2 tMax = clamp((ndcMax * 0.5 + 0.5) * float(FS_HZB_SIZE), vec2(0.0), vec2(FS_HZB_SIZE - 1));
        uint lv = fsHzbLevelForExtent(max(tMax.x - tMin.x, tMax.y - tMin.y));
        uint size = uint(FS_HZB_SIZE) >> lv, off = fsHzbLevelOffset(lv);
        uvec2 a = uvec2(tMin) >> lv, b = min(uvec2(tMax) >> lv, uvec2(size - 1u));
        b = min(b, a + uvec2(1u));
        float occ = 0.0, grad = 0.0;
        for (uint y = a.y; y <= b.y; ++y) for (uint x = a.x; x <= b.x; ++x) {
            occ = max(occ, uintBitsToFloat(hzb[uint(FS_HZB_OFF_COMB) + off + y * size + x]));
            grad = max(grad, uintBitsToFloat(hzb[uint(FS_HZB_OFF_CGRAD) + off + y * size + x]));
        }
        uint verdict = fsHzbTest(nearest, occ, 0.0, grad, F.misc.x);
        if (verdict == 2u) { atomicAdd(work[FS_WK_STAT + FS_CSTAT_NODES_HZB], 1u); return; }
        if (verdict == 1u) atomicAdd(work[FS_WK_STAT + FS_CSTAT_NODES_IN_BAND], 1u);
    }
    // LOD cut (monotone errors; the parent is evaluated with the parent's own nearest depth)
    float focal = F.headPos_focal.w;
    float depthN = projected ? max(nearest, 0.05) : max(length(toHead) - nd.repRadius, 0.05);
    float eN = fsProjectedPx(er.ownError, depthN, focal);
    float tau = fsFoveatedThresholdPx(F.lod.x, F.lod.y, fsEccentricityDeg(F.fwd_tanMargin.xyz, -toHead), F.lod.z);
    float eP = FS_CLUSTER_ERROR_INF;
    if (er.parentError < FS_CLUSTER_ERROR_INF) {
        FsClusterLayout L = fsClusterLayout(count, fsRootLeafShift(root));
        uint lvl = 0u;
        for (uint i = 0u; i < uint(FS_CLUSTER_MAX_LEVELS); ++i) { if (i + 1u >= L.levels) break; if (item >= L.offset[i] && item < L.offset[i] + L.count[i]) { lvl = i; break; } }
        uint parent = L.offset[lvl + 1u] + (item - L.offset[lvl]) / uint(FS_CLUSTER_FANOUT);
        FsClusterNode pn = nodes[nb + parent];
        vec3 pmin, pmax;
        fsTransformAabb(A, origin + vec3(pn.bmin[0], pn.bmin[1], pn.bmin[2]), origin + vec3(pn.bmax[0], pn.bmax[1], pn.bmax[2]), pmin, pmax);
        eP = fsProjectedPx(er.parentError, max(fsNearestDepth(F, pmin, pmax), 0.05), focal);
    }
    if (eP <= tau) return;                                              // an ancestor is in the cut
    uint childCount = fsGet_FsClusterNode_childCount(nd);
    if (childCount == 0u) {
        if (eN > tau) fsAppendLeafRange(nd.firstChildOrSurfel, fsGet_FsClusterNode_leafSurfelCount(nd), slot);
        else fsEmitAggregate(A, origin, nd);
    } else if (eN <= tau) fsEmitAggregate(A, origin, nd);
}
