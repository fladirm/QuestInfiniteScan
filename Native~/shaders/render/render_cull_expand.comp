#version 450
// Cull 2/4 (contract §13.4, §13.5; C09R-D §18): ONE indirect dispatch per frontier level (push: parity).
// Per frontier node: frustum (either eye, margin), normal cone (not in PLAN), HZB band test (fail-open:
// uncertain tiles keep), then the screen-space cut: projected(ownError) <= tau -> emit an aggregate (coverage
// LOD); leaf node -> emit its block; otherwise its children join the next frontier. Hidden or coarse branches
// never enumerate their subtree. tau = foveated threshold x GPU-headroom bias. Queues are bounded: a frontier
// overflow emits the node as an aggregate (fail-open LOD), never drops geometry.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_FRAME
#define FS_USE_RPAGES
#define FS_USE_RNODES_R
#define FS_USE_WORK
#define FS_USE_HZB
#include "fs_render_common.glsl"
layout(std430, set = 0, binding = FS_RB_DRAW) writeonly buffer AggScratchBlock { FsDrawRecord aggScratch[]; };   // native scratch, compacted later
layout(local_size_x = FS_WG_SMALL) in;
layout(push_constant) uniform Push { uint frameSlot; uint aggBase; uint aggCapacity; uint opaqueCapacity; uint parity; } pc;

#define F frames[pc.frameSlot]
bool fsProjectAabb(vec3 wmin, vec3 wmax, out float nearest, out vec2 ndcMin, out vec2 ndcMax) {
    nearest = 1e30; ndcMin = vec2(1e30); ndcMax = vec2(-1e30);
    for (int i = 0; i < 8; ++i) {
        vec3 c = vec3((i & 1) != 0 ? wmax.x : wmin.x, (i & 2) != 0 ? wmax.y : wmin.y, (i & 4) != 0 ? wmax.z : wmin.z);
        nearest = min(nearest, -(F.centerView * vec4(c, 1.0)).z);
        vec4 cl = F.centerViewProj * vec4(c, 1.0);
        if (cl.w <= 1e-6) return false;
        vec2 n = cl.xy / cl.w; ndcMin = min(ndcMin, n); ndcMax = max(ndcMax, n);
    }
    return true;
}
void fsEmitAggregate(mat4 A, vec3 origin, FsClusterNode nd) {
    uint i = atomicAdd(work[FS_WK_AGG], 1u);
    if (i >= pc.aggCapacity) { atomicAdd(work[FS_WK_STAT + FS_CSTAT_BUDGET_DROPPED], 1u); return; }
    vec3 w = (A * vec4(origin + vec3(nd.repCenter[0], nd.repCenter[1], nd.repCenter[2]), 1.0)).xyz;
    vec3 n = normalize(mat3(A) * fsDecodeOct32(nd.repNormalOct32));
    uint ra = fsRadius8FromLog16(nd.footprint & 0xFFFFu), rb = fsRadius8FromLog16(nd.footprint >> 16);
    FsDrawRecord r;
    r.cx = w.x; r.cy = w.y; r.cz = w.z;
    r.normalOct32 = fsEncodeOct32(n);
    r.tangentAndRadii = (ra << 16) | (rb << 24);
    r.colorOrHandle = (nd.repColorOrHandle & 0x00FFFFFFu) | ((fsGet_FsClusterNode_coverage(nd) >> 8) << 24);
    r.surfaceId = 0u;
    r.flags = uint(FS_DRAW_FLAG_AGGREGATE);
    aggScratch[i] = r;
    atomicMax(work[FS_WK_COMPACT_ARGS], i / uint(FS_WG_SMALL) + 1u);
    atomicAdd(work[FS_WK_STAT + FS_CSTAT_AGGREGATES], 1u);
    atomicAdd(work[FS_WK_STAT + FS_CSTAT_REPRESENTED], fsGet_FsClusterNode_surfelCount(nd));
}
void fsPushChild(uint node, uint slot, uint nextParity) {
    uint k = atomicAdd(work[FS_WK_EXPAND_ARGS + 4u * nextParity + 3u], 1u);
    if (k >= uint(FS_CULL_FRONTIER_CAP)) return;                            // caller handles overflow (aggregate)
    work[fsFrontierWord(nextParity, k) + 0u] = node; work[fsFrontierWord(nextParity, k) + 1u] = slot;
    atomicMax(work[FS_WK_EXPAND_ARGS + 4u * nextParity + 0u], (k + uint(FS_WG_SMALL)) / uint(FS_WG_SMALL));
}
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint parity = pc.parity, nextParity = parity ^ 1u;
    if (i >= work[FS_WK_EXPAND_ARGS + 4u * parity + 3u]) return;
    uint node = work[fsFrontierWord(parity, i) + 0u], slot = work[fsFrontierWord(parity, i) + 1u];
    if (node == FS_INDEX_NONE) return;
    FsPageDesc d = pages[slot];
    mat4 A = F.anchors[min(uint(max(d.key.anchorId, 0)), uint(FS_MAX_ANCHORS - 1))];
    vec3 origin = fsPageOrigin3(d.key);
    FsRenderNode rn = rnodes[node];
    FsClusterNode nd = rn.node;
    atomicAdd(work[FS_WK_STAT + FS_CSTAT_FRONTIER_NODES], 1u);
    vec3 wmin, wmax;
    fsTransformAabb(A, origin + vec3(nd.bmin[0], nd.bmin[1], nd.bmin[2]), origin + vec3(nd.bmax[0], nd.bmax[1], nd.bmax[2]), wmin, wmax);
    float dist = length(0.5 * (wmin + wmax) - F.headPos_focal.xyz);
    float margin = dist * F.fwd_tanMargin.w;
    bool vis = fsAabbInFrustum6(F.planesL[0], F.planesL[1], F.planesL[2], F.planesL[3], F.planesL[4], F.planesL[5], wmin, wmax, margin) ||
               fsAabbInFrustum6(F.planesR[0], F.planesR[1], F.planesR[2], F.planesR[3], F.planesR[4], F.planesR[5], wmin, wmax, margin);
    if (!vis) { atomicAdd(work[FS_WK_STAT + FS_CSTAT_NODES_FRUSTUM], 1u); return; }
    vec3 centerW = (A * vec4(origin + vec3(nd.repCenter[0], nd.repCenter[1], nd.repCenter[2]), 1.0)).xyz;
    vec3 toHead = F.headPos_focal.xyz - centerW;
    if (F.misc.x != uint(FS_RENDER_MODE_PLAN) && nd.coneCos > -1.0) {
        vec3 axisW = normalize(mat3(A) * vec3(nd.coneAxis[0], nd.coneAxis[1], nd.coneAxis[2]));
        float sinHalf = sqrt(max(0.0, 1.0 - nd.coneCos * nd.coneCos));
        float slack = clamp(nd.repRadius / max(length(toHead), 1e-3), 0.0, 1.0);
        if (dot(axisW, normalize(toHead)) < -(sinHalf + slack)) { atomicAdd(work[FS_WK_STAT + FS_CSTAT_NODES_CONE], 1u); return; }
    }
    float nearest; vec2 ndcMin, ndcMax;
    bool projected = fsProjectAabb(wmin, wmax, nearest, ndcMin, ndcMax);
    if (projected && F.misc.x == uint(FS_RENDER_MODE_SCAN)) {                 // HZB band test, fail-open
        vec2 tMin = clamp((ndcMin * 0.5 + 0.5) * float(FS_HZB_SIZE), vec2(0.0), vec2(FS_HZB_SIZE - 1));
        vec2 tMax = clamp((ndcMax * 0.5 + 0.5) * float(FS_HZB_SIZE), vec2(0.0), vec2(FS_HZB_SIZE - 1));
        uint lv = fsHzbLevelForExtent(max(tMax.x - tMin.x, tMax.y - tMin.y));
        uint size = uint(FS_HZB_SIZE) >> lv, off = fsHzbLevelOffset(lv);
        uvec2 a = uvec2(tMin) >> lv, b = min(uvec2(tMax) >> lv, uvec2(size - 1u));
        b = min(b, a + uvec2(1u));
        float occ = 0.0, grad = 0.0; bool unc = false; bool complete = true;
        for (uint y = a.y; y <= b.y; ++y) for (uint x = a.x; x <= b.x; ++x) {
            uint cw = hzb[uint(FS_HZB_OFF_COMB) + off + y * size + x];
            float o = uintBitsToFloat(cw & ~1u);
            if (o <= 0.0) complete = false;                                   // a tile without occluder: reprojection incomplete -> keep
            occ = max(occ, o); unc = unc || (cw & 1u) != 0u;
            grad = max(grad, uintBitsToFloat(hzb[uint(FS_HZB_OFF_CGRAD) + off + y * size + x]));
        }
        uint verdict = complete ? fsHzbTest(nearest, occ, unc, 0.0, grad, F.misc.x) : (occ > 0.0 ? 3u : 0u);
        if (verdict == 2u) { atomicAdd(work[FS_WK_STAT + FS_CSTAT_NODES_HZB], 1u); return; }
        if (verdict == 1u) atomicAdd(work[FS_WK_STAT + FS_CSTAT_NODES_IN_BAND], 1u);
        if (verdict == 3u) atomicAdd(work[FS_WK_STAT + FS_CSTAT_HZB_UNCERTAIN], 1u);
    }
    // ---- screen-space cut
    float focal = F.headPos_focal.w;
    float depthN = projected ? max(nearest, 0.05) : max(length(toHead) - nd.repRadius, 0.05);
    float eN = fsProjectedPx(rn.err.ownError, depthN, focal);
    float tau = fsFoveatedThresholdPx(F.lod.x, F.lod.y, fsEccentricityDeg(F.fwd_tanMargin.xyz, -toHead), F.lod.z);
    uint childCount = fsGet_FsClusterNode_childCount(nd);
    if (childCount == 0u) {                                                     // leaf: its block or, when tiny on screen, its aggregate
        if (eN > tau) {
            uint k = atomicAdd(work[FS_WK_BLOCKS], 1u);
            if (k < uint(FS_CULL_BLOCK_LIST_CAP)) {
                work[uint(FS_WK_BLOCK_LIST) + 2u * k + 0u] = node; work[uint(FS_WK_BLOCK_LIST) + 2u * k + 1u] = slot;
                atomicMax(work[FS_WK_EMIT_ARGS], k + 1u);
                atomicAdd(work[FS_WK_STAT + FS_CSTAT_BLOCKS], 1u);
                atomicAdd(work[FS_WK_STAT + FS_CSTAT_VISIBLE_SURFELS], fsGet_FsClusterNode_leafSurfelCount(nd));
                atomicAdd(work[FS_WK_STAT + FS_CSTAT_REPRESENTED], fsGet_FsClusterNode_leafSurfelCount(nd));
            } else { atomicAdd(work[FS_WK_STAT + FS_CSTAT_FRONTIER_OVERFLOW], 1u); fsEmitAggregate(A, origin, nd); }
        } else fsEmitAggregate(A, origin, nd);
        return;
    }
    if (eN <= tau) { fsEmitAggregate(A, origin, nd); return; }
    // expand: children join the next frontier; on overflow the node is drawn as an aggregate (fail-open LOD)
    uint need = childCount;
    uint base = atomicAdd(work[FS_WK_EXPAND_ARGS + 4u * nextParity + 3u], need);
    if (base + need > uint(FS_CULL_FRONTIER_CAP)) { atomicAdd(work[FS_WK_STAT + FS_CSTAT_FRONTIER_OVERFLOW], 1u); fsEmitAggregate(A, origin, nd); return; }
    uint wpos = base;
    for (uint c = 0u; c < 8u; ++c) {
        uint ch = rn.child[c];
        if (ch == FS_INDEX_NONE) continue;
        work[fsFrontierWord(nextParity, wpos) + 0u] = ch; work[fsFrontierWord(nextParity, wpos) + 1u] = slot; wpos++;
    }
    for (; wpos < base + need; ++wpos) { work[fsFrontierWord(nextParity, wpos) + 0u] = FS_INDEX_NONE; work[fsFrontierWord(nextParity, wpos) + 1u] = 0u; }
    atomicMax(work[FS_WK_EXPAND_ARGS + 4u * nextParity + 0u], (base + need + uint(FS_WG_SMALL) - 1u) / uint(FS_WG_SMALL));
}
