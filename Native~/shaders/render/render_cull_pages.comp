#version 450
// Cull 1/4 (contract §13.5, C09R-D): per resident page with a published render root, page AABB (anchor
// transform applied) vs the union of both eye frusta widened by the prediction margin. Temporal reuse: when the
// head moved less than the margin and the root is unchanged, a page cached OUTSIDE is skipped. Visible pages
// push their ROOT into frontier level 0; hidden pages never enumerate a node.
#extension GL_GOOGLE_include_directive : require
#define FS_USE_FRAME
#define FS_USE_RPAGES
#define FS_USE_WORK
#include "fs_render_common.glsl"
layout(local_size_x = FS_WG_SMALL) in;
layout(push_constant) uniform Push { uint frameSlot; uint pageCount; } pc;
void main() {
    uint slot = gl_GlobalInvocationID.x;
    if (slot >= pc.pageCount) return;
    FsPageDesc d = pages[slot];
    if (d.generation == 0u || d.renderRoot == FS_INDEX_NONE) return;
    // No by-value copy of the 4.7 KB frame block (64 anchors): every field is read in place from the SSBO (C09R closure defect R).
#define F frames[pc.frameSlot]
    atomicAdd(work[FS_WK_STAT + FS_CSTAT_PAGES_TESTED], 1u);
    if (F.misc.z == 1u && work[FS_WK_CACHE_ROOT + slot] == d.renderRoot && work[FS_WK_CACHE_STATE + slot] == FS_PAGE_STATE_OUTSIDE) {
        atomicAdd(work[FS_WK_STAT + FS_CSTAT_PAGES_REUSED], 1u); atomicAdd(work[FS_WK_STAT + FS_CSTAT_PAGES_CULLED], 1u); return;
    }
    mat4 A = F.anchors[min(uint(max(d.key.anchorId, 0)), uint(FS_MAX_ANCHORS - 1))];
    vec3 o = fsPageOrigin3(d.key);
    vec3 wmin, wmax; fsTransformAabb(A, o - vec3(FS_PAGE_EXTENT_M * 0.5), o + vec3(FS_PAGE_EXTENT_M * 0.5), wmin, wmax);
    float dist = length(0.5 * (wmin + wmax) - F.headPos_focal.xyz);
    float margin = dist * F.fwd_tanMargin.w;
    bool vis = fsAabbInFrustum6(F.planesL[0], F.planesL[1], F.planesL[2], F.planesL[3], F.planesL[4], F.planesL[5], wmin, wmax, margin) ||
               fsAabbInFrustum6(F.planesR[0], F.planesR[1], F.planesR[2], F.planesR[3], F.planesR[4], F.planesR[5], wmin, wmax, margin);
    work[FS_WK_CACHE_ROOT + slot] = d.renderRoot;
    work[FS_WK_CACHE_STATE + slot] = vis ? FS_PAGE_STATE_VISIBLE : FS_PAGE_STATE_OUTSIDE;
    if (!vis) { atomicAdd(work[FS_WK_STAT + FS_CSTAT_PAGES_CULLED], 1u); return; }
    uint k = atomicAdd(work[FS_WK_EXPAND_ARGS + 3], 1u);                // frontier level 0 count (parity 0)
    if (k >= uint(FS_CULL_FRONTIER_CAP)) { atomicAdd(work[FS_WK_STAT + FS_CSTAT_FRONTIER_OVERFLOW], 1u); return; }
    work[fsFrontierWord(0u, k) + 0u] = d.renderRoot; work[fsFrontierWord(0u, k) + 1u] = slot;
    atomicMax(work[FS_WK_EXPAND_ARGS + 0], (k + uint(FS_WG_SMALL)) / uint(FS_WG_SMALL));
    atomicAdd(work[FS_WK_STAT + FS_CSTAT_ROOTS_VISITED], 1u);
}
